# ARGUS WARDEN local scan cache
argus/.argus-warden-scan-memory/
contracts/zk/verifier/cache/
edu-landing/
data/.treasury_scanner_ref_key
# SKOPOS remediation runtime: the conductor's Ed25519 SIGNING KEY lives here, plus the A2A observer
# database and the deploy-order journal. The key signs DeployOrders a node agent acts on, so leaking
# it means anyone can order a redeploy. `data/*_signing_key` did not match it because of the extra
# directory level — found by listing every key in the tree and checking each against check-ignore,
# after a real key reached a public mirror this way once before.
data/remediation/

# A nested clone of alexar76/alien-monitor that used to be a committed gitlink with no
# .gitmodules — 176 of its 180 paths duplicate the top-level alien-monitor/, and no clone
# but the original laptop could resolve the pinned commit. Untracked; never re-add.
lottery/alien-monitor/

# ...except the ZK build directory itself: the hub image COPYs it, and a COPY of a
# missing path fails the build, which made `docker compose up` impossible from a
# clean clone. Only the marker is tracked; every artifact inside stays ignored.
!contracts/zk/build/
contracts/zk/build/*
!contracts/zk/build/.gitkeep

# Empty SQLite DBs the SKOPOS suite creates in whatever directory it is run from. They carry no
# rows and are not the deployed database, but they are untracked and one commit away from being
# mistaken for one.
skopos.sqlite3
skopos.sqlite3-shm
skopos.sqlite3-wal

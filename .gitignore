# ── Environment ──────────────────────────────────────────────────────────────
.env
.env.local
.env.production
argus/.env
data/state/config.json

# ── Lottery / Foundry / Solana (local UNI builds) ────────────────────────────
# solana-test-validator ledger (e.g. from manual `solana-test-validator` runs)
**/test-ledger/
lottery/contracts/test-ledger/
lottery/contracts/cache/
lottery/contracts/broadcast/
lottery/contracts/out/
contracts/solana/target/
contracts/solana/.anchor/
# Prebuilt SBF artifacts (rebuild via cargo-build-sbf on host / redeploy_uni)
contracts/solana/target/deploy/*.so
# Program/deploy keypairs — generated per-environment, NEVER committed (a committed
# program keypair lets anyone hijack the program id; it also leaks via the public mirror)
contracts/solana/keys/

# Runtime LLM / admin files (created or edited by the app; never commit secrets)
data/config/admin_config_overlay.yaml
data/config/model_providers.yaml
data/config/admin.json
data/config/admin_users.json
data/config/first_run_pipeline_mode.done

# ── SEO landings (generated — run scripts/build_ecosystem_landing.sh) ────────

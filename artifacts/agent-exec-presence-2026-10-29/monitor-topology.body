entai-hub","target_kind":"host","probe":"skopos:ports","category":"exposure","severity":"low","outcome":"finding","status":"raw","title":"Public port 8789 open","status_code":null,"signed":false},{"finding_id":"mom-94828919bc644c4a","target":"independentai-hub","target_kind":"host","probe":"skopos:ports","category":"exposure","severity":"low","outcome":"finding","status":"raw","title":"Public port 993 open","status_code":null,"signed":false},{"finding_id":"mom-1109da0fb5734c10","target":"independentai-hub","target_kind":"host","probe":"skopos:ports","category":"exposure","severity":"low","outcome":"finding","status":"raw","title":"Public port 587 open","status_code":null,"signed":false},{"finding_id":"mom-ce79a3de3c424d96","target":"metis","target_kind":"host","probe":"skopos:ports","category":"exposure","severity":"low","outcome":"finding","status":"raw","title":"Public port 993 open","status_code":null,"signed":false},{"finding_id":"mom-4a1480ad277c4062","target":"metis","target_kind":"host","probe":"skopos:ports","category":"exposure","severity":"low","outcome":"finding","status":"raw","title":"Public port 587 open","status_code":null,"signed":false},{"finding_id":"mom-56da48e9b5d247f9","target":"metis","target_kind":"host","probe":"skopos:ports","category":"exposure","severity":"low","outcome":"finding","status":"raw","title":"Public port 465 open","status_code":null,"signed":false}],"finding_counts":{"critical":0,"high":2,"medium":5,"low":13,"info":0},"intel":{"cards_total":45,"category_scores":{"authz":4.1713,"input-validation":4.1713,"dos":4.0439,"integrity":4.0269,"settlement":3.9063,"replay":3.9063,"injection":3.8713},"learned_pairs":22,"intel_enabled":true},"settlement":{"mode":"uni","reason":"UNI: simulated settlement in the universe — no value moves","simulated":true,"moves_real_value":false,"splitter":null,"chain":"base","reward_fallback":"sandbox","reward_fallback_reason":"sandbox: when a real rail cannot settle, the share is paid on the simulated UNI vault so the audit/repair loop keeps running — marked simulated, never redeemable as USDC","vault_attached":false,"vault_balance_usd":null,"gates_security":false},"corpus":{"backend":"sqlite","total_findings":821,"recurring":443,"by_severity":{"critical":10,"high":126,"low":114,"medium":571},"by_status":{"raw":821},"scans":31136}},"hub":{"id":"hub","label":"AIMarket Hub","url":"https://modelmarket.dev"}},{"id":"warden","label":"WARDEN","group":"security","icon":"shield","description":"The invoke-time MCP firewall, shipped as its own zero-dependency npm package `@aimarket/warden`. It is a LIBRARY, not a service: it runs in-process inside whatever MCP host loads it, so it has no port, no /health and no daemon — which is why this node is a LAYER, not a host. Every third-party MCP server is vetted before a single tool definition reaches the model: static scan of every advertised tool field — name, description, schemas, title, annotations (ruleset v12) → signed threat feed → origin (operator-declared vs remote catalog) → tool-def and launch-identity pinning. The verdict is allow/block plus a 0..1 composite score, a per-tool partition so one poisoned tool can be quarantined without severing the connection, and the exact rule table that produced it. It decides from LOCAL facts only: no oracle is consulted and no socket is opened while vetting, and the score is its own — NOT a LUMEN reputation score (that gate was removed). ARGUS is its reference host, so blocks surface as ARGUS telemetry; MOMUS is the reference publisher of its signed feed. THEMIS gates publication BEFORE a capability is listed; WARDEN gates the invoke.","metrics":{"feed_records":0,"builtin_floor":11,"gates":4},"status":"active","position":{"x":-10.0,"y":3.6,"z":0.0},"url":"https://warden.modelmarket.dev","links":{"landing":"https://warden.modelmarket.dev","github":"https://github.com/alexar76/warden","npm":"https://www.npmjs.com/package/@aimarket/warden","docs":"https://github.com/alexar76/warden/blob/main/docs/gates.md"},"hop":0,"warden_live":{"feed_url":"https://momus.modelmarket.dev/warden/threat-feed","records":0,"refused":500,"first_refusal":"target 'canary' is first-party — MOMUS publishes deny patterns about THIRD-PARTY surfaces only; a finding about our own component goes to SKOPOS for remediation","signed":true,"age_ms":128,"accepted_by_freshness":true,"publisher_key":"302a3005…216f9250","builtin_floor":11,"ruleset_version":"12","verified_by":"the consuming host, over RFC 8785 bytes against a pre-pinned key"},"hub":{"id":"hub","label":"AIMarket Hub","url":"https://modelmarket.dev"}},{"id":"histor","label":"HISTOR","group":"security","icon":"scroll","description":"Public transparency log of MCP tool definitions. Reads what every remote endpoint in the official MCP registry advertises (initialize + tools/list, never a tool call), signs it as MTL/1 labels on AWR/2, appends every label to an RFC 9162 Merkle log with signed tree heads, dates each change with a per-tool diff, and answers /check: is what a client received what was observed at that endpoint? Advertised text only — not the code, not behaviour, never a safety rating.","metrics":{"labels":1242911,"pinned":41719,"changes_7d":13722,"endpoints":35234},"status":"active","position":{"x":-15.5,"y":5.5,"z":1.0},"color":"#ffd58a","url":"https://histor.modelmarket.dev","links":{"desk":"https://histor.modelmarket.dev","log":"https://histor.modelmarket.dev/log","changes":"https://histor.modelmarket.dev/changes","feed":"https://histor.modelmarket.dev/feed.xml","github":"https://github.com/alexar76/histor","pages":"https://alexar76.github.io/histor/"},"hop":0,"histor_live":{"version":"0.4.2","store":"postgresql","crawl_running":false,"last_crawl_error":null,"tree_size":1242911,"root_hash":"46f9a0e61108fc9f","sth_at":"2026-10-29T14:23:23Z","last_run_finished":"2026-10-29T11:40:46Z","last_run_error":null,"registry_servers":51390,"registry_endpoints":35234,"attempted":7999,"answered_ok":6827,"auth_required":0,"pinned":41719,"block_tier":777,"changes":{"last24h":1793,"last7d":13722,"last30d":32616},"not":["a safety rating","the code","behaviour"]},"hub":{"id":"hub","label":"AIMarket Hub","url":"https://modelmarket.dev"}},{"id":"treasury","label":"Treasury","group":"security","icon":"vault","description":"The separate payer role for MOMUS red-team bounties. Holds the ONE key that can release a bounty — a key MOMUS never sees. It re-verifies every finding + verdict signature itself, requires an independent-verifier quorum (≥2 distinct keys for high/critical, one a registered external verifier like Metis), enforces a dedup replay-guard and an anti-griefing deposit, and fails closed when crypto is off. An optional DeepSeek-backed explainer narrates each decision — advisory only, never part of the authorization.","metrics":{"paid":1,"held":2,"refused":1},"status":"active","position":{"x":-13.5,"y":1.0,"z":-1.0},"url":"https://momus.modelmarket.dev/#treasury","links":{"landing":"https://momus.modelmarket.dev/#treasury","github":"https://github.com/alexar76/treasury","docs":"https://github.com/alexar76/treasury#readme"},"hop":0,"treasury_live":{"health_online":true,"version":"0.1.0","treasury_pubkey":"5pgHuxRbk7Lz7KgN/Wu/vFOU","crypto_enabled":false,"prod":true,"external_verifiers":1,"counts":{"paid":1,"held":2,"refused":1},"ledger":[{"kind":"decision","ts":"2026-08-08T14:55:57Z","finding_id":"mom-1a639e402537482a","dedup_key":"dedup-7bc2e5f5897f1ac00167643b","severity":"high","state":"held","amount_usd":50.0,"settlement":{"mode":"uni","settled":false,"simulated":true,"reason":"UNI vault refused the release — share $50.00 exceeds what is reserved for mom-1a639e402537482a ($0.00) — refusing rather than over-drawing","reference":"uni-112f853426d501c4","prepared_call":null},"reasons":["gates passed; not released — UNI vault refused the release — share $50.00 exceeds what is reserved for mom-1a639e402537482a ($0.00) — refusing rather than over-drawing"],"distinct_verifiers":["8NRt5lKD9aR21
+@pytest.mark.parametrize("peer", ["93.184.216.34", "127.0.0.1"])
+@pytest.mark.parametrize("failure", ["header-access", "header-lookup"])
+def test_header_errors_preserve_the_verified_connection_key(monkeypatch, peer, failure):
+    class BrokenHeaders:
+        def get(self, name):

+def test_spoofed_known_ip_cannot_avoid_pacing_or_switch_lockout_bucket(monkeypatch, tmp_path):
+    database = str(tmp_path / "auth.sqlite")
+    monkeypatch.setenv("SKOPOS_LOGIN_GLOBAL_MAX_ATTEMPTS", "12")

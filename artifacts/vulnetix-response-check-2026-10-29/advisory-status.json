            "version": "0.2.0",
            "versionType": "python"
          }
        ]
      }
    ],
    "solutions": [
      {
        "lang": "en",
        "value": "Set METIS_API_KEY whenever anything relays requests to the server. This is the only control that works in every affected version."
      }

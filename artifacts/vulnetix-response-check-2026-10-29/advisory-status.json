        "versions": [
          {
            "lessThanOrEqual": "0.1.3",
            "status": "affected",
            "version": "0.1.0",
            "versionType": "python"
          }
        ]
      }
    ],
    "solutions": [
      {
        "lang": "en",
        "value": "Set TREASURY_CLIENT_TOKEN on every deployment, and have every client send it as X-Treasury-Client. This is the only control that works in every affected version."
      }
    ],
    "url": "https://raw.githubusercontent.com/Vulnetix/advisory-database/main/cvelistv5/VULN-PYPI/2026/0xxx/GCVE-110-VULN-PYPI-2026-000642.json"
  },
  {
    "record": "GCVE-110-VULN-PYPI-2026-000643",
    "updated_at": "2026-10-28T01:49:28Z",
    "affected": [
      {
        "package": "aimarket-platon",
        "versions": [
          {
            "lessThanOrEqual": "0.1.5",
            "status": "affected",
            "version": "0.1.0",
            "versionType": "python"
          }
        ]
      }
    ],
    "solutions": [
      {
        "lang": "en",
        "value": "Set PLATON_STEER_TOKEN whenever anything relays requests to the server, and send it as X-Platon-Token from the clients allowed to write. This is the only control that works in every affected version."
      }
    ],
    "url": "https://raw.githubusercontent.com/Vulnetix/advisory-database/main/cvelistv5/VULN-PYPI/2026/0xxx/GCVE-110-VULN-PYPI-2026-000643.json"
  },
  {

        "package": "skopos-fleet",
        "versions": [
          {
            "status": "affected",
            "version": "0.2.1",
            "versionType": "python"
          }
        ]
      }
    ],
    "solutions": [
      {
        "lang": "en",
        "value": "No setting removes it in 0.2.1. SKOPOS_LOGIN_GLOBAL_MAX_ATTEMPTS (up to 500) only raises the number of failures an attacker must send, and SKOPOS_LOGIN_LOCKOUT_SECONDS (down to 60) shortens each lockout; with a long random dashboard password, a higher shared budget still leaves guessing impractical."
      }
    ],
    "url": "https://raw.githubusercontent.com/Vulnetix/advisory-database/main/cvelistv5/VULN-PYPI/2026/0xxx/GCVE-110-VULN-PYPI-2026-000644.json"

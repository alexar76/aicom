[
 {
  "name": "get_spot_prices",
  "title": "Spot metal prices",
  "description": "Current and previous-session spot prices for gold, silver, platinum, palladium, copper and nickel, in any supported currency and per troy ounce or gram.",
  "inputSchema": {
   "$schema": "https://json-schema.org/draft/2020-12/schema",
   "type": "object",
   "properties": {
    "base": {
     "description": "A currency code from the live catalog at /api/currencies (ISO 4217 fiat plus BTC and the metal codes). Defaults to USD.",
     "type": "string",
     "minLength": 1
    },
    "unit": {
     "description": "Price per troy ounce or per gram. Defaults to troy_oz.",
     "type": "string",
     "enum": [
      "troy_oz",
      "gram"
     ]
    },
    "metals": {
     "description": "Metal symbols to include (xau gold, xag silver, xpt platinum, xpd palladium, xcu copper, ni nickel). Omit for all six; Goldback is not a spot metal.",
     "minItems": 1,
     "maxItems": 6,
     "type": "array",
     "items": {
      "type": "string",
      "enum": [
       "xau",
       "xag",
       "xpt",
       "xpd",
       "xcu",
       "ni"
      ]
     }
    }
   },
   "additionalProperties": false
  },
  "outputSchema": {
   "$schema": "https://json-schema.org/draft/2020-12/schema",
   "type": "object",
   "properties": {
    "base": {
     "type": "string",
     "minLength": 1,
     "description": "Resolved uppercase currency code."
    },
    "unit": {
     "type": "string",
     "enum": [
      "troy_oz",
      "gram"
     ],
     "description": "Shared price denominator for every returned metal."
    },
    "asOf": {
     "type": "string",
     "format": "date-time",
     "description": "UTC source update instant."
    },
    "date": {
     "type": "string",
     "format": "date",
     "description": "Market or session date."
    },
    "metals": {
     "type": "object",
     "properties": {
      "xau": {
       "type": "object",
       "properties": {
        "open": {
         "type": "number",
         "description": "Opening price in the result's shared base and unit."
        },
        "high": {
         "type": "number",
         "description": "Session high in the result's shared base and unit."
        },
        "low": {
         "type": "number",
         "description": "Session low in the result's shared base and unit."
        },
        "close": {
         "type": "number",
         "description": "Latest or session-close price in the result's shared base and unit."
        }
       },
       "required": [
        "open",
        "high",
        "low",
        "close"
       ],
       "additionalProperties": false,
       "title": "Ohlc"
      },
      "xag": {
       "type": "object",
       "properties": {
        "open": {
         "type": "number",
         "description": "Opening price in the result's shared base and unit."
        },
        "high": {
         "type": "number",
         "description": "Session high in the result's shared base and unit."
        },
        "low": {
         "type": "number",
         "description": "Session low in the result's shared base and unit."
        },
        "close": {
         "type": "number",
         "description": "Latest or session-close price in the result's shared base and unit."
        }
       },
       "required": [
        "open",
        "high",
        "low",
        "close"
       ],
       "additionalProperties": false,
       "title": "Ohlc"
      },
      "xpt": {
       "type": "object",
       "properties": {
        "open": {
         "type": "number",
         "description": "Opening price in the result's shared base and unit."
        },
        "high": {
         "type": "number",
         "description": "Session high in the result's shared base and unit."
        },
        "low": {
         "type": "number",
         "description": "Session low in the result's shared base and unit."
        },
        "close": {
         "type": "number",
         "description": "Latest or session-close price in the result's shared base and unit."
        }
       },
       "required": [
        "open",
        "high",
        "low",
        "close"
       ],
       "additionalProperties": false,
       "title": "Ohlc"
      },
      "xpd": {
       "type": "object",
       "properties": {
        "open": {
         "type": "number",
         "description": "Opening price in the result's shared base and unit."
        },
        "high": {
         "type": "number",
         "description": "Session high in the result's shared base and unit."
        },
        "low": {
         "type": "number",
         "description": "Session low in the result's shared base and unit."
        },
        "close": {
         "type": "number",
         "description": "Latest or session-close price in the result's shared base and unit."
        }
       },
       "required": [
        "open",
        "high",
        "low",
        "close"
       ],
       "additionalProperties": false,
       "title": "Ohlc"
      },
      "xcu": {
       "type": "object",
       "properties": {
        "open": {
         "type": "number",
         "description": "Opening price in the result's shared base and unit."
        },
        "high": {
         "type": "number",
         "description": "Session high in the result's shared base and unit."
        },
        "low": {
         "type": "number",
         "description": "Session low in the result's shared base and unit."
        },
        "close": {
         "type": "number",
         "description": "Latest or session-close price in the result's shared base and unit."
        }
       },
       "required": [
        "open",
        "high",
        "low",
        "close"
       ],
       "additionalProperties": false,
       "title": "Ohlc"
      },
      "ni": {
       "type": "object",
       "properties": {
        "open": {
         "type": "number",
         "description": "Opening price in the result's shared base and unit."
        },
        "high": {
         "type": "number",
         "description": "Session high in the result's shared base and unit."
        },
        "low": {
         "type": "number",
         "description": "Session low in the result's shared base and unit."
        },
        "close": {
         "type": "number",
         "description": "Latest or session-close price in the result's shared base and unit."
        }
       },
       "required": [
        "open",
        "high",
        "low",
        "close"
       ],
       "additionalProperties": false,
       "title": "Ohlc"
      }
     },
     "additionalProperties": false,
     "title": "SpotMetals",
     "description": "Requested spot symbols only; Goldback is not a spot metal."
    }
   },
   "required": [
    "base",
    "unit",
    "asOf",
    "date",
    "metals"
   ],
   "additionalProperties": false
  },
  "annotations": {
   "title": "Spot metal prices",
   "readOnlyHint": true,
   "destructiveHint": false,
   "openWorldHint": true
  }

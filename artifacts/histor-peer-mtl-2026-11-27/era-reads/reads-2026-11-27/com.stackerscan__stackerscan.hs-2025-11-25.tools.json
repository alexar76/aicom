 {
  "name": "get_observed_premiums",
  "title": "Observed premiums over spot",
  "description": "Rolling fine-metal-weighted median asking premiums for silver, gold, platinum, palladium, copper, nickel and Goldback, observed from marketplace listings.",
  "inputSchema": {
   "$schema": "https://json-schema.org/draft/2020-12/schema",
   "type": "object",
   "properties": {
    "metal": {
     "type": "string",
     "enum": [
      "silver",
      "gold",
      "platinum",
      "palladium",
      "copper",
      "nickel",
      "goldback"
     ],
     "description": "Which metal's observed premiums to return."
    },
    "query": {
     "description": "Case-insensitive product label/canonical-key search.",
     "type": "string",
     "minLength": 1,
     "maxLength": 100
    },
    "limit": {
     "default": 10,
     "description": "Product page size. Without a query, pages browse the most-listed products.",
     "type": "integer",
     "minimum": 1,
     "maximum": 10
    },
    "cursor": {
     "description": "Opaque continuation token returned by the same tool with exactly the same filters.",
     "type": "string",
     "minLength": 1,
     "maxLength": 2048
    }
   },
   "required": [
    "metal"
   ],
   "additionalProperties": false
  },
  "outputSchema": {
   "$schema": "https://json-schema.org/draft/2020-12/schema",
   "type": "object",
   "properties": {
    "metal": {
     "type": "string",
     "enum": [
      "silver",
      "gold",
      "platinum",
      "palladium",
      "copper",
      "nickel",
      "goldback"
     ]
    },
    "asOf": {
     "type": "string",
     "format": "date-time",
     "description": "UTC latest observation instant."
    },
    "windowDays": {
     "type": "integer",
     "exclusiveMinimum": 0
    },
    "minimumListings": {
     "type": "integer",
     "exclusiveMinimum": 0
    },
    "productQuery": {
     "anyOf": [
      {
       "type": "string",
       "minLength": 1
      },
      {
       "type": "null"
      }
     ]
    },
    "productOrder": {
     "type": "string",
     "enum": [
      "search",
      "listing_count"
     ],
     "description": "How product rows were selected: search (query match, catalog order) or listing_count (browse, most-listed first). Empty products means no data."
    },
    "sourceUrl": {
     "type": "string",
     "format": "uri"
    },
    "overall": {
     "anyOf": [
      {
       "type": "object",
       "properties": {
        "medianPercent": {
         "type": "number"
        },
        "listingCount": {
         "type": "integer",
         "minimum": 0
        }
       },
       "required": [
        "medianPercent",
        "listingCount"
       ],
       "additionalProperties": false,
       "title": "PremiumSummary"
      },
      {
       "type": "null"
      }
     ]
    },
    "categories": {
     "type": "array",
     "items": {
      "type": "object",
      "properties": {
       "medianPercent": {
        "type": "number"
       },
       "listingCount": {
        "type": "integer",
        "minimum": 0
       },
       "key": {
        "type": "string"
       },
       "label": {
        "type": "string"
       }
      },
      "required": [
       "medianPercent",
       "listingCount",
       "key",
       "label"
      ],
      "additionalProperties": false,
      "title": "PremiumCategory"
     }
    },
    "products": {
     "maxItems": 10,
     "type": "array",
     "items": {
      "type": "object",
      "properties": {
       "medianPercent": {
        "type": "number"
       },
       "listingCount": {
        "type": "integer",
        "minimum": 0
       },
       "key": {
        "type": "string",
        "maxLength": 160
       },
       "label": {
        "type": "string",
        "maxLength": 200
       },
       "fineTroyOz": {
        "anyOf": [
         {
          "type": "number"
         },
         {
          "type": "null"
         }
        ]
       },
       "numistaUrl": {
        "anyOf": [
         {
          "type": "string",
          "maxLength": 2048,
          "format": "uri"
         },
         {
          "type": "null"
         }
        ]
       },
       "listingsUrl": {
        "type": "string",
        "maxLength": 2048,
        "format": "uri"
       }
      },
      "required": [
       "medianPercent",
       "listingCount",
       "key",
       "label",
       "fineTroyOz",
       "numistaUrl",
       "listingsUrl"
      ],
      "additionalProperties": false,
      "title": "PremiumProduct"
     }
    },
    "nextCursor": {
     "anyOf": [
      {
       "type": "string",
       "minLength": 1
      },
      {
       "type": "null"
      }
     ]
    }
   },
   "required": [
    "metal",
    "asOf",
    "windowDays",
    "minimumListings",
    "productQuery",
    "productOrder",
    "sourceUrl",
    "overall",
    "categories",
    "products",
    "nextCursor"
   ],
   "additionalProperties": false
  },
  "annotations": {
   "title": "Observed premiums over spot",
   "readOnlyHint": true,
   "destructiveHint": false,
   "openWorldHint": true
  }
 },
 {
  "name": "get_price_history",
  "title": "Historical price series",
  "description": "Daily historical series for charting — one metal or the Goldback.",
  "inputSchema": {
   "$schema": "https://json-schema.org/draft/2020-12/schema",
   "type": "object",
   "properties": {
    "metal": {
     "type": "string",
     "enum": [
      "gold",
      "silver",
      "platinum",
      "palladium",
      "copper",
      "nickel",
      "goldback"
     ],
     "description": "The metal (or Goldback) whose history to return."
    },
    "days": {
     "default": 90,
     "description": "How many trailing days of history to return.",
     "type": "integer",
     "minimum": 1,
     "maximum": 3650
    },
    "base": {
     "default": "USD",
     "description": "A currency code from the live catalog at /api/currencies (ISO 4217 fiat plus BTC and the metal codes). Defaults to USD.",
     "type": "string",
     "minLength": 1
    },
    "format": {
     "default": "line",
     "description": "ohlc returns open/high/low/close rows; line returns closes.",
     "type": "string",
     "enum": [
      "line",
      "ohlc"
     ]
    },
    "limit": {
     "default": 90,
     "type": "integer",
     "minimum": 1,
     "maximum": 100
    },
    "cursor": {
     "description": "Opaque continuation token returned by the same tool with exactly the same filters.",
     "type": "string",
     "minLength": 1,
     "maxLength": 2048
    }
   },
   "required": [
    "metal"
   ],
   "additionalProperties": false
  },
  "outputSchema": {
   "$schema": "https://json-schema.org/draft/2020-12/schema",
   "type": "object",
   "properties": {
    "result": {
     "$schema": "https://json-schema.org/draft/2020-12/schema",
     "oneOf": [
      {
       "type": "object",
       "properties": {
        "series": {
         "type": "object",
         "properties": {
          "kind": {
           "type": "string",
           "const": "metal"
          },
          "metal": {
           "type": "string",
           "enum": [
            "gold",
            "silver",
            "platinum",
            "palladium",
            "copper",
            "nickel",
            "goldback"
           ]
          }
         },
         "required": [
          "kind",
          "metal"
         ],
         "additionalProperties": false,
         "title": "MetalSeries"
        },
        "base": {
         "type": "string",
         "minLength": 1
        },
        "unit": {
         "type": "string",
         "enum": [
          "troy_oz",
          "goldback"
         ]
        },
        "requestedDays": {
         "type": "integer",
         "minimum": 1,
         "maximum": 3650
        },
        "startDate": {
         "type": "string",
         "format": "date"
        },
        "endDate": {
         "type": "string",
         "format": "date"
        },
        "nextCursor": {
         "anyOf": [
          {
           "type": "string",
           "minLength": 1
          },
          {
           "type": "null"
          }
         ]
        },
        "format": {
         "type": "string",
         "const": "line"
        },
        "points": {
         "maxItems": 100,
         "type": "array",
         "items": {
          "type": "object",
          "properties": {
           "date": {
            "type": "string",
            "format": "date"
           },
           "price": {
            "type": "number"
           }
          },
          "required": [
           "date",
           "price"
          ],
          "additionalProperties": false,
          "title": "LinePoint"
         }
        }
       },
       "required": [
        "series",
        "base",
        "unit",
        "requestedDays",
        "startDate",
        "endDate",
        "nextCursor",
        "format",
        "points"
       ],
       "additionalProperties": false
      },
      {
       "type": "object",
       "properties": {
        "series": {
         "type": "object",
         "properties": {
          "kind": {
           "type": "string",
           "const": "metal"
          },
          "metal": {
           "type": "string",
           "enum": [
            "gold",
            "silver",
            "platinum",
            "palladium",
            "copper",
            "nickel",
            "goldback"
           ]
          }
         },
         "required": [
          "kind",
          "metal"
         ],
         "additionalProperties": false,
         "title": "MetalSeries"
        },
        "base": {
         "type": "string",
         "minLength": 1
        },
        "unit": {
         "type": "string",
         "enum": [
          "troy_oz",
          "goldback"
         ]
        },
        "requestedDays": {
         "type": "integer",
         "minimum": 1,
         "maximum": 3650
        },
        "startDate": {
         "type": "string",
         "format": "date"
        },
        "endDate": {
         "type": "string",
         "format": "date"
        },
        "nextCursor": {
         "anyOf": [
          {
           "type": "string",
           "minLength": 1
          },
          {
           "type": "null"
          }
         ]
        },
        "format": {
         "type": "string",
         "const": "ohlc"
        },
        "points": {
         "maxItems": 100,
         "type": "array",
         "items": {
          "type": "object",
          "properties": {
           "open": {
            "type": "number",
            "description": "Opening price in the result's shared base and unit."
           },
           "high": {
            "type": "number",
            "description": "Session high in the result's shared base and unit."
           },
           "low": {
            "type": "number",
            "description": "Session low in the result's shared base and unit."
           },
           "close": {
            "type": "number",
            "description": "Latest or session-close price in the result's shared base and unit."
           },
           "date": {
            "type": "string",
            "format": "date"
           }
          },
          "required": [
           "open",
           "high",
           "low",
           "close",
           "date"
          ],
          "additionalProperties": false,
          "title": "OhlcPoint"
         }
        }
       },
       "required": [
        "series",
        "base",
        "unit",
        "requestedDays",
        "startDate",
        "endDate",
        "nextCursor",
        "format",
        "points"
       ],
       "additionalProperties": false
      }
     ]
    }
   },
   "required": [
    "result"
   ]
  },
  "annotations": {
   "title": "Historical price series",
   "readOnlyHint": true,
   "destructiveHint": false,
   "openWorldHint": true
  }

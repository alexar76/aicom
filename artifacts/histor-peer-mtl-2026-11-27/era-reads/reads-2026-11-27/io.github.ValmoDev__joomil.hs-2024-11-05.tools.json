[
 {
  "name": "suggest_filters",
  "title": "Suggest Filters",
  "description": "Suggest Joomil listing filters from a short free-text query about a category, place or budget. Returns filters, a category confidence score and warnings, not matching listings.",
  "inputSchema": {
   "$schema": "http://json-schema.org/draft-07/schema#",
   "type": "object",
   "properties": {
    "query": {
     "type": "string",
     "minLength": 1,
     "maxLength": 500,
     "description": "Natural-language search request, e.g. 'appartement 3 pièces à Sion' or 'Tesla Model 3 moins de 25000 CHF'."
    }
   },
   "required": [
    "query"
   ]
  },
  "annotations": {
   "title": "Suggest Filters",
   "readOnlyHint": true,
   "destructiveHint": false,
   "openWorldHint": true
  },
  "execution": {
   "taskSupport": "forbidden"
  },
  "outputSchema": {
   "$schema": "http://json-schema.org/draft-07/schema#",
   "type": "object",
   "properties": {
    "query": {
     "type": "string"
    },
    "filters": {
     "type": "object",
     "properties": {
      "q": {
       "type": [
        "string",
        "null"
       ]
      },
      "cat_id": {
       "type": [
        "number",
        "null"
       ]
      },
      "canton": {
       "anyOf": [
        {
         "type": "string",
         "enum": [
          "Geneve",
          "Vaud",
          "Valais",
          "Fribourg",
          "Neuchatel",
          "Jura",
          "Bern",
          "Argovie",
          "Zurich",
          "Lucerne",
          "Bale-Ville",
          "Etranger"
         ]
        },
        {
         "type": "null"
        }
       ]
      },
      "location": {
       "type": [
        "string",
        "null"
       ]
      },
      "price_min": {
       "type": [
        "number",
        "null"
       ]
      },
      "price_max": {
       "type": [
        "number",
        "null"
       ]
      },
      "sort": {
       "type": "string",
       "enum": [
        "recent",
        "price_asc",
        "price_desc",
        "views"
       ]
      },
      "limit": {
       "type": "number"
      }
     },
     "required": [
      "q",
      "cat_id",
      "canton",
      "location",
      "price_min",
      "price_max",
      "sort",
      "limit"
     ],
     "additionalProperties": false
    },
    "category": {
     "anyOf": [
      {
       "type": "object",
       "properties": {
        "id": {
         "type": "number"
        },
        "name": {
         "type": "string"
        },
        "url": {
         "type": "string"
        },
        "parent_id": {
         "type": "number"
        },
        "confidence": {
         "type": "number"
        },
        "reason": {
         "type": "string"
        }
       },
       "required": [
        "id",
        "name",
        "url",
        "parent_id",
        "confidence",
        "reason"
       ],
       "additionalProperties": false
      },
      {
       "type": "null"
      }
     ]
    },
    "confidence": {
     "type": "number"
    },
    "warnings": {
     "type": "array",
     "items": {
      "type": "string"
     }
    },
    "next_step": {
     "type": "string"
    }
   },
   "required": [
    "query",
    "filters",
    "category",
    "confidence",
    "warnings",
    "next_step"
   ],
   "additionalProperties": false

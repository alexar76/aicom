 {
  "name": "search_classifieds",
  "title": "Search Classifieds",
  "description": "Search public Joomil.ch classified ads by keyword, category, place or budget. Returns a paginated list with titles, short descriptions, prices in CHF, locations and listing URLs. With no filters, returns recent listings. No seller contact details or transactions.",
  "inputSchema": {
   "$schema": "http://json-schema.org/draft-07/schema#",
   "type": "object",
   "properties": {
    "q": {
     "description": "Full-text search query (searches title and description)",
     "type": [
      "string",
      "null"
     ]
    },
    "cat_id": {
     "description": "Category ID filter — includes subcategories automatically. Use get_categories to browse available categories.",
     "anyOf": [
      {
       "type": "integer",
       "exclusiveMinimum": 0,
       "maximum": 9007199254740991
      },
      {
       "type": "null"
      }
     ]
    },
    "canton": {
     "description": "Swiss canton filter — strict enum. Use get_cantons for the official list. WARNING: values are API-specific (e.g. 'Bern' not 'Berne', 'Geneve' not 'Genève'/'Geneva'). Supported: Geneve, Vaud, Valais, Fribourg, Neuchatel, Jura, Bern, Argovie, Zurich, Lucerne, Bale-Ville, Etranger.",
     "anyOf": [
      {
       "type": "string",
       "enum": [
        "Geneve",
        "Vaud",
        "Valais",
        "Fribourg",
        "Neuchatel",
        "Jura",
        "Bern",
        "Argovie",
        "Zurich",
        "Lucerne",
        "Bale-Ville",
        "Etranger"
       ]
      },
      {
       "type": "null"
      }
     ]
    },
    "location": {
     "description": "City name or postal code (NPA) — partial match",
     "type": [
      "string",
      "null"
     ]
    },
    "price_min": {
     "description": "Minimum price in CHF (inclusive)",
     "anyOf": [
      {
       "type": "number",
       "minimum": 0
      },
      {
       "type": "null"
      }
     ]
    },
    "price_max": {
     "description": "Maximum price in CHF (inclusive)",
     "anyOf": [
      {
       "type": "number",
       "minimum": 0
      },
      {
       "type": "null"
      }
     ]
    },
    "sort": {
     "description": "Sort order: recent (newest first, default), price_asc, price_desc, views",
     "type": "string",
     "enum": [
      "recent",
      "price_asc",
      "price_desc",
      "views"
     ]
    },
    "limit": {
     "description": "Results per page (1–50, default 20)",
     "type": "integer",
     "minimum": 1,
     "maximum": 50
    },
    "offset": {
     "description": "Pagination offset. Use next_offset from previous response to get next page.",
     "type": "integer",
     "minimum": 0,
     "maximum": 9007199254740991
    }
   }
  },
  "annotations": {
   "title": "Search Classifieds",
   "readOnlyHint": true,
   "destructiveHint": false,
   "openWorldHint": true
  },
  "execution": {
   "taskSupport": "forbidden"
  },
  "outputSchema": {
   "$schema": "http://json-schema.org/draft-07/schema#",
   "type": "object",
   "properties": {
    "results": {
     "type": "array",
     "items": {
      "type": "object",
      "properties": {
       "id": {
        "type": "number"
       },
       "title": {
        "type": "string"
       },
       "description": {
        "type": "string"
       },
       "price": {
        "type": "object",
        "properties": {
         "amount": {
          "type": [
           "number",
           "null"
          ]
         },
         "currency": {
          "type": "string",
          "const": "CHF"
         }
        },
        "required": [
         "amount",
         "currency"
        ],
        "additionalProperties": false
       },
       "location": {
        "type": "object",
        "properties": {
         "city": {
          "type": [
           "string",
           "null"
          ]
         },
         "postal_code": {
          "type": [
           "string",
           "null"
          ]
         },
         "canton": {
          "type": [
           "string",
           "null"
          ]
         },
         "country": {
          "type": [
           "string",
           "null"
          ]
         }
        },
        "required": [
         "city",
         "postal_code",
         "canton",
         "country"
        ],
        "additionalProperties": false
       },
       "category": {
        "anyOf": [
         {
          "type": "object",
          "properties": {
           "id": {
            "type": "number"
           },
           "name": {
            "type": "string"
           },
           "url": {
            "type": "string"
           }
          },
          "required": [
           "id",
           "name",
           "url"
          ],
          "additionalProperties": false
         },
         {
          "type": "null"
         }
        ]
       },
       "url": {
        "type": "string"
       },
       "created_at": {
        "type": [
         "string",
         "null"
        ]
       },
       "has_picture": {
        "type": "boolean"
       },
       "seller": {
        "type": "object",
        "properties": {
         "name": {
          "type": [
           "string",
           "null"
          ]
         },
         "certified": {
          "type": "boolean"
         }
        },
        "required": [
         "name",
         "certified"
        ],
        "additionalProperties": false
       }
      },
      "required": [
       "id",
       "title",
       "price",
       "location",
       "category",
       "url",
       "created_at",
       "has_picture",
       "seller"
      ],
      "additionalProperties": false
     }
    },
    "total": {
     "type": "number"
    },
    "limit": {
     "type": "number"
    },
    "offset": {
     "type": "number"
    },
    "has_more": {
     "type": "boolean"
    },
    "next_offset": {
     "type": [
      "number",
      "null"
     ]
    },
    "filtered_out": {
     "type": "number"
    }
   },
   "required": [
    "results",
    "total",
    "limit",
    "offset",
    "has_more",
    "next_offset",
    "filtered_out"
   ],
   "additionalProperties": false
  }
 },

>         # ARD + AID stale cases for outside clients (artifacts/aid-stale-cases-2026-11-22 in the monorepo),
>         # with the media types of the live manifest and card. A nested add_header replaces the parent's.
>         location ~ ^/interop/aid/([a-z-]+)/ard\.json$ {
>             alias /var/www/interop/aid/$1/ard.json;
>             types { }
>             default_type application/ard+json;
>             add_header Access-Control-Allow-Origin "*" always;
>             add_header Cache-Control "public, max-age=300" always;
>         }
>         location ~ ^/interop/aid/([a-z-]+)/server-card\.json$ {

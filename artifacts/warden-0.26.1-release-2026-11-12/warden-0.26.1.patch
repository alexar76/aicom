+    const target = physicalPath(found);
+    const targetDir = dirname(target);
+    return basename(target) === basename(found) &&
+      (SYSTEM_BIN_DIRS.includes(targetDir) || (process.platform === 'linux' && targetDir === UBUNTU_COREUTILS_DIR));
   });
 }
 

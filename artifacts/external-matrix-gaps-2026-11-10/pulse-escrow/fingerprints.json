      "request": "POST configured /sign, Authorization: Bearer <token>, application/json",
      "envelope": {
        "transaction_fields": [
          "to",
          "data",
          "chainId",
          "gas",
          "value"
        ]
      },
      "result_fields": [
        "tx_hash",
        "replayed"
      ],
      "hub_client_accepts": [
        "tx_hash",
        "transactionHash"
      ],
      "read_routes": [
        "GET /health",
        "GET /status",
        "GET /receipt/<receipt_id>"
      ],
      "server_header": "escrow-policy-signer",
      "user_agent": "escrow-policy-signer/0.1",

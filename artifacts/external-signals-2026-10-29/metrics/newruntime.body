const plausibleSrc = "";
const umamiWebsiteId = "";
const umamiSrc = "";
const cloudflareToken = "c46a177b7cf64a51baf7db41ab9ae0d6";

    (() => {
      const optOutKey = "nrAnalyticsOptOut";
      const optOutCookie = "nr_analytics_opt_out";

      function setCookie(enabled) {
        document.cookie = enabled
          ? optOutCookie + "=1; Max-Age=31536000; Path=/; SameSite=Lax"
          : optOutCookie + "=; Max-Age=0; Path=/; SameSite=Lax";
      }

      function updateOptOutFromUrl() {
        const params = new URLSearchParams(window.location.search);
        const value = params.get("nr_analytics");
        if (value === "off" || params.has("nr_noanalytics")) {
          window.localStorage.setItem(optOutKey, "1");
          setCookie(true);
        } else if (value === "on") {
          window.localStorage.removeItem(optOutKey);
          setCookie(false);
        }
      }

      function isOptedOut() {
        return (
          window.localStorage.getItem(optOutKey) === "1" ||
          document.cookie.split(";").some((item) => item.trim() === optOutCookie + "=1")
        );
      }

      function loadScript(src, attributes = {}) {
        const script = document.createElement("script");
        script.defer = true;
        script.src = src;
        for (const [key, value] of Object.entries(attributes)) {
          if (value !== undefined && value !== null && value !== "") script.setAttribute(key, value);
        }
        document.head.appendChild(script);
      }

      try {
        updateOptOutFromUrl();
        if (isOptedOut()) return;

        if (plausibleDomain) {
          loadScript(plausibleSrc, { "data-domain": plausibleDomain });
        }
        if (umamiWebsiteId && umamiSrc) {

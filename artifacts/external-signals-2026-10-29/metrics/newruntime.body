         beyond the log's own hashed visitor key; the analytics opt-out cookie keeps it out of the log. --><script>
      (() => {
        try {
          if (navigator.webdriver || !window.fetch) return;
          if (document.cookie.split(";").some((item) => item.trim() === "nr_analytics_opt_out=1")) return;
          let visibleMs = 0, lastTick = document.visibilityState === "visible" ? Date.now() : 0, scrolled = false, sent = false;
          const scrollable = () => document.documentElement.scrollHeight - window.innerHeight > 240;
          const onScroll = () => {
            const total = document.documentElement.scrollHeight - window.innerHeight;
            if (total <= 0 || window.scrollY / total >= 0.5) scrolled = true;
          };
          const settle = () => {
            if (lastTick) { visibleMs += Date.now() - lastTick; lastTick = document.visibilityState === "visible" ? Date.now() : 0; }
          };
          const maybeSend = () => {
            settle();
            if (sent || visibleMs < 10000 || (scrollable() && !scrolled)) return;
            sent = true;
            clearInterval(timer);
            fetch(location.pathname + "?e=1&t=" + Date.now(), { method: "HEAD", cache: "no-store", credentials: "omit", keepalive: true }).catch(() => {});
          };
          document.addEventListener("visibilitychange", () => { settle(); if (document.visibilityState === "visible") lastTick = Date.now(); maybeSend(); });
          window.addEventListener("scroll", () => { onScroll(); maybeSend(); }, { passive: true });
          // No scroll check at load: this runs in <head>, before the body has a height.
          const timer = setInterval(maybeSend, 2000);
        } catch {}
      })();

[{"type_of":"comment","id_code":"3i73h","created_at":"2026-10-18T16:52:45Z","ai_disclosure_level":"not_disclosed","ai_disclosure_label":"Not Disclosed","body_html":"\u003cp\u003eReally appreciate that you kept the Slack number (2 of 21) instead of tuning it away. From the UI side, the risk I’d worry about is approval fatigue: if a guard asks on 40% of tasks, people learn to click “allow” without reading, and the human check stops being a check. What helps is making the question carry its evidence. Something like “destination #general came from the list_channels result, not from your message,” or “this argument matches text from an outside tool result,” lets someone make a real decision in two seconds instead of rubber-stamping. Have you looked at what the prompt shows at the moment it asks, or at tracking how often asks get approved? A near-100% approval rate would be a useful early warning that the asks have turned into noise.\u003c/p\u003e\n\n","user":{"name":"Pushpendra Yadav","username":"pushpendra2011","twitter_username":null,"github_username":"tad-bit-better","user_id":4182491,"website_url":"https://www.pushpendra.dev","profile_image":"https://media2.dev.to/dynamic/image/width=640,height=640,fit=cover,gravity=auto,format=auto/https%3A%2F%2Fdev-to-uploads.s3.us-east-2.amazonaws.com%2Fuploads%2Fuser%2Fprofile_image%2F4182491%2F4ee13f37-a727-4120-aceb-9e645454a072.png","profile_image_90":"https://media2.dev.to/dynamic/image/width=90,height=90,fit=cover,gravity=auto,format=auto/https%3A%2F%2Fdev-to-uploads.s3.us-east-2.amazonaws.com%2Fuploads%2Fuser%2Fprofile_image%2F4182491%2F4ee13f37-a727-4120-aceb-9e645454a072.png"},"children":[{"type_of":"comment","id_code":"3i76a","created_at":"2026-10-18T17:44:44Z","ai_disclosure_level":"not_disclosed","ai_disclosure_label":"Not Disclosed","body_html":"\u003cp\u003eThanks — your comment prompted a concrete improvement. We’ve updated the approval message in our working tree to show the proposed tool, destination arguments such as channel=\"#general\", and the reason for asking. Recognized sensitive values are redacted.\u003cbr\u003e\nWe also corrected an attribution problem: fingerprint warnings could list recently read files without establishing which file matched. They now explicitly say when the matching source was not retained. Likewise, we don’t claim a channel came from list_channels without tracking that relationship.\u003cbr\u003e\nDecision logs now distinguish approval requests, proxy refusals, and audit-only decisions. Human approval remains “unknown”: a subsequent tool result does not prove someone clicked Allow. So we still cannot report an approval rate.\u003cbr\u003e\nThe build and 110 local tests pass. These changes are not released yet, and we haven’t measured whether they reduce approval fatigue. The historical 39/97 figure counts tasks triggering an ask, not human approvals.\u003c/p\u003e\n\n","user":{"name":"Alex","username":"alexar76","twitter_username":"build_ai_infra","github_username":null,"user_id":3927872,"website_url":"https://github.com/alexar76","profile_image":"https://media2.dev.to/dynamic/image/width=640,height=640,fit=cover,gravity=auto,format=auto/https%3A%2F%2Fdev-to-uploads.s3.us-east-2.amazonaws.com%2Fuploads%2Fuser%2Fprofile_image%2F3927872%2Fdf501cac-6862-47af-8b22-4e3067696337.jpeg","profile_image_90":"https://media2.dev.to/dynamic/image/width=90,height=90,fit=cover,gravity=auto,format=auto/https%3A%2F%2Fdev-to-uploads.s3.us-east-2.amazonaws.com%2Fuploads%2Fuser%2Fprofile_image%2F3927872%2Fdf501cac-6862-47af-8b22-4e3067696337.jpeg"},"children":[]}]}]
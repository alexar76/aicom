 """
 
 
+# YouTube's own limit for a description: the reviewer reads what will be published, all of it.
+# Until 2026-11-15 it read the first 500 characters; a 505-character description ending in
+# https://oracles.modelmarket.dev reached it as "https://oracles.modelmarke", and the video was
+# blocked for a truncated link that was never truncated.
+REVIEW_DESCRIPTION_MAX = 5000
+
+
+def description_for_review(desc: str) -> str:
+    """The description as the reviewer should see it: whole, or cut at a space and labelled as cut."""
+    if len(desc) <= REVIEW_DESCRIPTION_MAX:
+        return desc
+    head = desc[:REVIEW_DESCRIPTION_MAX].rsplit(None, 1)[0]
+    return head + " [description continues; shortened for this review, not in the video]"
+

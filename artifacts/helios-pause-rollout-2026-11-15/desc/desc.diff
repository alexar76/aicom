+def _cut_on_space(text: str, limit: int) -> str:
+    """At most `limit` characters, cut at whitespace so a link or word is never left half-written."""
+    if len(text) <= limit:
+        return text
+    return text[:limit + 1].rsplit(None, 1)[0].rstrip()
+

+from datetime import datetime, timedelta, timezone
 from pathlib import Path
 from typing import Any, Literal
 from uuid import uuid4
@@ -337,5 +337,25 @@ class QueueStore:
     def can_upload_today(self, max_per_day: int) -> bool:
         return self.daily_upload_count() < max_per_day
 
+    def pause_uploads(self, seconds: int, reason: str) -> str:
+        """Hold every render and upload until now + seconds (YouTube's channel upload cap)."""
+        until = (datetime.now(timezone.utc) + timedelta(seconds=seconds)).strftime("%Y-%m-%dT%H:%M:%SZ")
+        state = self.load_upload_state()
+        state["paused_until"] = until
+        state["paused_reason"] = reason[:300]
+        self.save_upload_state(state)
+        return until
+
+    def uploads_paused_until(self) -> str | None:
+        """The pause end while one is in force, else None (an unreadable value is no pause)."""
+        raw = self.load_upload_state().get("paused_until")
+        if not isinstance(raw, str) or not raw:
+            return None
+        try:
+            until = datetime.fromisoformat(raw.replace("Z", "+00:00"))
+        except ValueError:
+            return None
+        return raw if until > datetime.now(timezone.utc) else None
+
     def pending_count(self) -> int:
         return len([j for j in self.list_jobs() if j.status == "pending"])

xtrasDigest&quot;,&quot;dtype&quot;:&quot;string&quot;},{&quot;name&quot;:&quot;summaryJson&quot;,&quot;dtype&quot;:&quot;string&quot;}]},{&quot;config_name&quot;:&quot;package_observations&quot;,&quot;features&quot;:[{&quot;name&quot;:&quot;id&quot;,&quot;dtype&quot;:&quot;int64&quot;},{&quot;name&quot;:&quot;serverId&quot;,&quot;dtype&quot;:&quot;string&quot;},{&quot;name&quot;:&quot;observedAt&quot;,&quot;dtype&quot;:&quot;string&quot;},{&quot;name&quot;:&quot;status&quot;,&quot;dtype&quot;:&quot;string&quot;},{&quot;name&quot;:&quot;packageVersion&quot;,&quot;dtype&quot;:&quot;string&quot;},{&quot;name&quot;:&quot;toolSetDigest&quot;,&quot;dtype&quot;:&quot;string&quot;},{&quot;name&quot;:&quot;subjectDigest&quot;,&quot;dtype&quot;:&quot;string&quot;},{&quot;name&quot;:&quot;toolExtrasDigest&quot;,&quot;dtype&quot;:&quot;string&quot;},{&quot;name&quot;:&quot;toolCount&quot;,&quot;dtype&quot;:&quot;int64&quot;},{&quot;name&quot;:&quot;serverName&quot;,&quot;dtype&quot;:&quot;string&quot;},{&quot;name&quot;:&quot;serverVersion&quot;,&quot;dtype&quot;:&quot;string&quot;},{&quot;name&quot;:&quot;registryVersion&quot;,&quot;dtype&quot;:&quot;string&quot;},{&quot;name&quot;:&quot;launchJson&quot;,&quot;dtype&quot;:&quot;string&quot;},{&quot;name&quot;:&quot;protocolVersion&quot;,&quot;dtype&quot;:&quot;string&quot;}]}]},&quot;cardExists&quot;:true,&quot;createdAt&quot;:&quot;2026-10-20T20:39:21.000Z&quot;,&quot;description&quot;:&quot;\n\t\n\t\t\n\t\n\t\n\t\tHISTOR snapshot 2026-11-09: what MCP servers advertise, and when it changes\n\t\n\nHISTOR reads the tool list (tools/list) of every remote MCP server in the official MCP registry\non a polling schedule, and of npm/PyPI MCP packages run in a sandbox once per published version (new versions\nfirst, a few hundred a day). It records the exact tool definitions,\npins them by digest, and writes a signed label to a public RFC 9162 Merkle log whenever a tool set\nfirst appears, stays the same, or… See the full description on the dataset page: https://huggingface.co/datasets/alexar76/histor-mcp-tool-definitions.&quot;,&quot;downloads&quot;:295,&quot;downloadsAllTime&quot;:295,&quot;id&quot;:&quot;alexar76/histor-mcp-tool-definitions&quot;,&quot;isLikedByUser&quot;:false,&quot;lastModified&quot;:&quot;2026-11-09T18:43:19.000Z&quot;,&quot;likes&quot;:0,&quot;datasetsServerInfo&quot;:{&quot;viewer&quot;:&quot;viewer-partial&quot;,&quot;numRows&quot;:875344,&quot;libraries&quot;:[&quot;datasets&quot;,&quot;pandas&quot;,&quot;polars&quot;,&quot;mlcroissant&quot;],&quot;formats&quot;:[&quot;json&quot;],&quot;modalities&quot;:[&quot;tabular&quot;,&quot;text&quot;]},&quot;discussionsDisabled&quot;:false,&quot;discussionsSorting&quot;:&quot;recently-created&quot;,&quot;repoType&quot;:&quot;dataset&quot;,&quot;private&quot;:false,&quot;gated&quot;:false,&quot;tags&quot;:[&quot;task_categories:text-classification&quot;,&quot;task_ids:multi-label-classification&quot;,&quot;annotations_creators:machine-generated&quot;,&quot;multilinguality:monolingual&quot;,&quot;source_datasets:original&quot;,&quot;language:en&quot;,&quot;license:cc-by-4.0&quot;,&quot;size_categories:100K&lt;n&lt;1M&quot;,&quot;format:json&quot;,&quot;modality:tabular&quot;,&quot;modality:text&quot;,&quot;library:datasets&quot;,&quot;library:pandas&quot;,&quot;library:polars&quot;,&quot;library:mlcroissant&quot;,&quot;region:us&quot;,&quot;mcp&quot;,&quot;model-context-protocol&quot;,&quot;ai-security&quot;,&quot;prompt-injection&quot;,&quot;tool-poisoning&quot;,&quot;transparency-log&quot;,&quot;supply-chain-security&quot;,&quot;ai-agents&quot;],&quot;tag_objs&quot;:[{&quot;id&quot;:&quot;task_categories:text-classification&quot;,&quot;label&quot;:&quot;text-classification&quot;,&quot;type&quot;:&quot;task_categories&quot;,&quot;subType&quot;:&quot;nlp&quot;},{&quot;id&quot;:&quot;task_ids:multi-label-classification&quot;,&quot;label&quot;:&quot;multi-label-classification&quot;,&quot;type&quot;:&quot;task_ids&quot;},{&quot;id&q
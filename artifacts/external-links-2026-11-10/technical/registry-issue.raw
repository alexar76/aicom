users/goncalossilva/received_events","type":"User","user_view_type":"public","site_admin":false},"author_association":"MEMBER","issue_field_values":[],"type":null,"active_lock_reason":null,"sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"One potential benefit of a centralized registry is that we could have `server.json` submitters list out all the possible tools their server may ever invoke, fingerprint them, and store those fingerpoints for MCP client consumption.\n\nA third party vendor could scan and approve these fingerprints as devoid of security risks, like tool poisoning attacks.\n\nMCP clients could then use the fingerprints to avoid tool poisoning attacks that get surfaced due to hidden dynamic tool calls or supply chain attacks.","closed_by":null,"reactions":{"url":"https://api.github.com/repos/modelcontextprotocol/registry/issues/82/reactions","total_count":1,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/modelcontextprotocol/registry/issues/82/timeline","performed_via_github_app":null,"state_reason":null,"pinned_comment":null}
<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<title>MCP tool-change log: daily changes to public MCP server tools | ScraperWatch</title><meta name="description" content="A dated daily record of tools added, removed and changed on a fixed panel of public MCP servers, with neutral change flags and JSON/CSV downloads."><link rel="canonical" href="https://scraperwatch.com/mcp-changes/"><link rel="icon" href="/favicon.ico" sizes="48x48"><link rel="icon" href="/favicon.svg" type="image/svg+xml"><link rel="alternate" type="application/rss+xml" title="ScraperWatch" href="/feed.xml">
<style>
:root{--bg:#fbfaf7;--fg:#1d1d1b;--muted:#6b6a65;--line:#e4e1d8;--accent:#1f6f5c;--warn:#a3471d;--card:#fff}
@media (prefers-color-scheme:dark){:root{--bg:#141413;--fg:#ecebe6;--muted:#a09e96;--line:#2c2b28;--accent:#5fc3a6;--warn:#e38b5d;--card:#1b1b19}}
*{box-sizing:border-box}body{margin:0;background:var(--bg);color:var(--fg);font:16px/1.55 system-ui,-apple-system,Segoe UI,Roboto,sans-serif}
a{color:var(--accent)}header,main,footer{max-width:1080px;margin:0 auto;padding:0 16px}
header{display:flex;flex-wrap:wrap;gap:6px 16px;justify-content:space-between;align-items:baseline;padding-top:20px;padding-bottom:8px;border-bottom:1px solid var(--line)}header nav{display:flex;flex-wrap:wrap;gap:4px 14px}
header a.brand{font-weight:700;font-size:20px;color:var(--fg);text-decoration:none}header nav a{font-size:14px}
h1{font-size:28px;line-height:1.2;margin:28px 0 8px}h2{font-size:20px;margin:32px 0 8px}.lede{color:var(--muted);max-width:760px}
.wrap{overflow-x:auto;border:1px solid var(--line);border-radius:8px;background:var(--card)}
#api-daily-history table{min-width:650px}#api-daily-history th,#api-daily-history td{white-space:normal}
#api-daily-history th:first-child{min-width:160px}#api-daily-history summary{cursor:pointer;padding:8px 0}
table{border-collapse:collapse;width:100%;font-size:14px}th,td{padding:8px 10px;border-bottom:1px solid var(--line);text-align:right;white-space:nowrap}
th:first-child,td:first-child{text-align:left;white-space:normal;min-width:220px}.picks td{text-align:left;white-space:normal;min-width:180px}th{font-size:12px;text-transform:uppercase;letter-spacing:.04em;color:var(--muted);background:var(--bg)}
#store-history-excerpt table{min-width:680px}#store-history-excerpt thead th{white-space:normal}
#store-history-excerpt tbody th{text-transform:none;letter-spacing:normal;font-size:14px;color:inherit;background:transparent;font-weight:400;overflow-wrap:anywhere}
tr:last-child td{border-bottom:0}.muted{color:var(--muted)}.bad{color:var(--warn);font-weight:600}.tag{font-size:11px;border:1px solid var(--line);border-radius:4px;padding:1px 5px;margin-left:6px;color:var(--muted)}
.grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(220px,1fr));gap:10px;margin:12px 0}
.card{border:1px solid var(--line);border-radius:8px;padding:12px;background:var(--card);text-decoration:none;color:var(--fg)}.card b{display:block}.card span{font-size:13px;color:var(--muted)}
.note{font-size:13px;color:var(--muted);border-left:3px solid var(--line);padding:4px 12px;margin:16px 0}
.billing-unit{display:block;min-width:160px;max-width:220px;white-space:normal;overflow-wrap:anywhere;text-align:left;font-size:12px;color:var(--muted)}
.billing-unit summary{cursor:pointer}.billing-unit ul{margin:4px 0;padding-left:16px}
[hidden]{display:none!important}
.shortlist-choice{display:block;font-size:13px;margin-top:6px;cursor:pointer}
.shortlist-choice input{width:18px;height:18px;vertical-align:middle}
.shortlist-table{width:auto}.shortlist-table th,.shortlist-table td{text-align:left;white-space:normal;min-width:190px;max-width:260px;overflow-wrap:anywhere;vertical-align:top}
.shortlist-table th:first-child{min-width:125px;max-width:145px}
.shortlist-table button{display:block;margin-top:8px}button,input,select{font:inherit}button{cursor:pointer}
button:focus-visible,input:focus-visible,select:focus-visible,.wrap:focus-visible{outline:3px solid var(--accent);outline-offset:3px}
.target-filters{display:flex;flex-wrap:wrap;gap:12px;align-items:end;margin:16px 0}.target-filters label{display:flex;flex-direction:column;gap:4px;max-width:100%}.target-filters input,.target-filters select{max-width:100%;width:240px;padding:6px}.target-filters input[type="checkbox"]{width:20px;height:20px;align-self:flex-start}.target-filters button{padding:6px 12px}.target-filters p{flex-basis:100%;margin:0}
.target-finder{display:flex;flex-wrap:wrap;gap:12px;align-items:end;margin:20px 0}.target-finder label{display:flex;flex-direction:column;gap:4px;width:360px;max-width:100%;min-width:0}.target-finder input{width:100%;min-width:0;padding:8px}.target-finder button{padding:8px 12px;min-height:44px}.target-finder p{flex-basis:100%;margin:0}.target-az{display:flex;flex-wrap:wrap;gap:6px 18px;list-style:none;padding:0}.target-az li{max-width:100%;overflow-wrap:anywhere}
.target-jumps{display:flex;flex-wrap:wrap;gap:8px 18px;margin:16px 0}.target-jumps a{padding:6px 0}
.target-jumps a:focus-visible,[tabindex="-1"]:focus-visible{outline:3px solid var(--accent);outline-offset:3px}
.buying-paths a:focus-visible{outline:3px solid var(--accent);outline-offset:3px}
.target-sort-button{color:inherit;background:transparent;border:1px solid currentColor;border-radius:4px;padding:6px;text-align:inherit}.target-sort-button:focus-visible{outline:3px solid #1769aa;outline-offset:3px}
.pair-choice,.alternative-pair{display:block;margin-top:8px}.pair-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px}.pair-card{min-width:0;border:1px solid var(--muted);border-radius:6px;padding:12px;overflow-wrap:anywhere}.pair-card h3{margin-top:0}.pair-card dt{font-weight:bold;margin-top:10px}.pair-card dd{margin:3px 0}.pair-card a{white-space:normal}.pair-card dl{font-size:14px}
.trend{display:block;margin-left:auto;color:var(--accent)}
.quick-answer{border:1px solid var(--accent);border-radius:8px;padding:4px 16px 8px;margin:16px 0;background:var(--card)}.quick-answer h2{margin:12px 0 4px;font-size:18px}.quick-answer li{margin:6px 0}
#alt-answer{overflow-wrap:anywhere}#alt-answer p{margin:8px 0}#alt-answer .billing-unit{max-width:none}
.how-to-read,.filter-help{margin:12px 0}.how-to-read summary,.filter-help summary{cursor:pointer;font-weight:600}
.shortlist-share{width:100%;max-width:740px;font-size:14px}.shortlist-actions{margin:10px 0}
footer{margin-top:48px;padding-top:16px;padding-bottom:40px;border-top:1px solid var(--line);font-size:13px;color:var(--muted)}
</style></head><body>
<header><a class="brand" href="/">ScraperWatch</a><nav><a href="/apis/">API benchmark</a><a href="/serp/">SERP</a><a href="/rag/">RAG</a><a href="/proxies/">Proxies</a><a href="/picks/">Usage &amp; reliability picks</a><a href="/rising/">Rising</a><a href="/changes/">Changes</a><a href="/data/">Data</a><a href="/badges/">Badges</a><a href="/methodology/">Methodology</a><a href="/about/">About</a></nav></header>
<main><h1>MCP tool-change log</h1>
<p class="lede">A dated public record of how the tool definitions of public MCP servers change from day to day. Each day we ask the same panel of servers for their tool list and compare it with the day before.</p>
<p class="note"><b>7 daily comparisons so far; a change is not evidence of wrongdoing.</b></p>
<h2>What is tracked</h2>
<p>We track a fixed panel of <b>3,000</b> public remote MCP server endpoints, drawn once by seeded random sample from the 35,443 eligible endpoints in the official MCP Registry snapshot of 2026-10-30. On 2026-11-06, <b>1,528</b> of them answered <code>tools/list</code> without authentication. Of the panel, 205 endpoints (205 answering) sit on one host, <code>agent-observatory-sensor…workers.dev</code>, which registers about 2,365 near-identical endpoints in the registry; the change log shows them as a single row per day.</p><div class="wrap"><table><thead><tr><th>Latest run status</th><th>Endpoints</th></tr></thead><tbody><tr><td>ok</td><td>1,528</td></tr><tr><td>auth required</td><td>745</td></tr><tr><td>robots disallowed</td><td>464</td></tr><tr><td>error</td><td>232</td></tr><tr><td>timeout</td><td>25</td></tr><tr><td>rate limited</td><td>5</td></tr><tr><td>private ip skipped</td><td>1</td></tr></tbody></table></div>
<h2>Change log</h2>
<ul><li>2026-11-06: 674 tool-level changes on 44 endpoints; 28 status transitions, not flagged (20 involve a timeout or error, which may be temporary).</li><li>2026-11-05: 701 tool-level changes on 46 endpoints; 24 status transitions, not flagged (17 involve a timeout or error, which may be temporary).</li><li>2026-11-04: 640 tool-level changes on 44 endpoints; 24 status transitions, not flagged (19 involve a timeout or error, which may be temporary).</li><li>2026-11-03: 556 tool-level changes on 58 endpoints; 36 status transitions, not flagged (30 involve a timeout or error, which may be temporary).</li><li>2026-11-02: 219 tool-level changes on 48 endpoints; 33 status transitions, not flagged (25 involve a timeout or error, which may be temporary).</li><li>2026-11-01: 214 tool-level changes on 45 endpoints; 21 status transitions, not flagged (11 involve a timeout or error, which may be temporary).</li><li>2026-10-31: 160 tool-level changes on 36 endpoints; 11 status transitions, not flagged (8 involve a timeout or error, which may be temporary).</li></ul><div class="wrap" tabindex="0" aria-label="MCP tool change log"><table><thead><tr><th>Day (UTC)</th><th style="text-align:left">Server (registry name)</th><th style="text-align:left">Tool</th><th style="text-align:left">Change</th><th style="text-align:left">Flag</th></tr></thead><tbody><tr><td>2026-11-06</td><td style="text-align:left;white-space:normal;overflow-wrap:anywhere">ca.905trades/business-card</td><td style="text-align:left;white-space:normal;overflow-wrap:anywhere"><code>request_quote</code></td><td style="text-align:left;white-space:normal">Tool definition changed (description, inputSchema, title)</td><td style="text-align:left;white-space:normal">Description changed while the tool name stayed the same</td></tr><tr><td>2026-11-06</td><td style="text-align:left;white-space:normal;overflow-wrap:anywhere">ca.905trades/business-card</td><td style="text-align:left;white-space:normal;overflow-wrap:anywhere"><span class=muted>—</span></td><td style="text-align:left;white-space:normal">Server instructions changed</td><td style="text-align:left;white-space:normal"><span class="muted">—</span></td></tr><tr><td>2026-11-06</td><td style="text-align:left;white-space:normal;overflow-wrap:anywhere">io.github.minhtc/aifree</td><td style="text-align:left;white-space:normal;overflow-wrap:anywhere"><code>upcoming_deadlines</code></td><td style="text-align:left;white-space:normal">Tool added</td><td style="text-align:left;white-space:normal"><span class="muted">—</span></td></tr><tr><td>2026-11-06</td><td style="text-align:left;white-space:normal;overflow-wrap:anywhere">io.github.minhtc/aifree</td><td style="text-align:left;white-space:normal;overflow-wrap:anywhere"><span class=muted>—</span></td><td style="text-align:left;white-space:normal">Server instructions changed</td><td style="text-align:left;white-space:normal"><span class="muted">—</span></td></tr><tr><td>2026-11-06</td><td style="text-align:left;white-space:normal;overflow-wrap:anywhere">io.github.duvoai/duvo</td><td style="text-align:left;white-space:normal;overflow-wrap:anywhere"><code>approveAutomationProposal</code></td><td style="text-align:left;white-space:normal">Tool definition changed (description)</td><td style="text-align:left;white-space:normal">Description changed while the tool name stayed the same</td></tr><tr><td>2026-11-06</td><td style="text-align:left;white-space:normal;overflow-wrap:anywhere">io.github.duvoai/duvo</td><td style="text-align:left;white-space:normal;overflow-wrap:anywhere"><code>saveClarityProcessSnapshot</code></td><td style="text-align:left;white-space:normal">Tool definition changed (inputSchema)</td><td style="text-align:left;white-space:normal"><span class="muted">—</span></td></tr><tr><td>2026-11-06</td><td style="text-align:left;white-space:normal;overflow-wrap:anywhere">io.github.duvoai/duvo</td><td style="text-align:left;white-space:normal;overflow-wrap:anywhere"><code>sendClarit
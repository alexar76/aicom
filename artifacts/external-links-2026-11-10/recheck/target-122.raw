<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>AIMarket Widget — Theme Gallery</title>
<link href="fonts/fonts.css" rel="stylesheet" />
<link rel="stylesheet" href="themes.css">
<style>
  /* Page chrome mirrors modelmarket.dev (aimarket_hub/theme.py). It is duplicated here on
     purpose: this file also runs standalone out of the widget repo, where the hub's
     /assets/site.css does not exist. Only the frame is themed — the widget cards below keep
     their own six themes, which is the whole point of the page. */
  :root {
    --bg: #02030a; --panel: rgba(8,14,30,.72); --brd: rgba(80,130,200,.22);
    --ink: #cfe3ff; --muted: #7e9fd0; --faint: #56739f;
    --cyan: #38e0ff; --violet: #7b5cff;
    --mono: "JetBrains Mono", ui-monospace, monospace;
    --head: "Orbitron", system-ui, sans-serif;
    --body: "Rajdhani", system-ui, sans-serif;
  }
  * { box-sizing: border-box; margin: 0; padding: 0; }
  body {
    font-family: var(--body); background: var(--bg); color: var(--ink);
    min-height: 100vh; -webkit-font-smoothing: antialiased;
    background-image:
      radial-gradient(50vw 50vw at 10% -5%, rgba(56,224,255,.12), transparent 55%),
      radial-gradient(46vw 46vw at 95% 8%, rgba(123,92,255,.14), transparent 55%);
    background-attachment: fixed;
  }
  header { padding: 46px 20px 26px; text-align: center; }
  .brand {
    display: inline-flex; align-items: center; gap: 10px; margin-bottom: 22px;
    font-family: var(--head); font-weight: 900; letter-spacing: 2px; font-size: 13px;
    color: var(--muted); text-decoration: none;
  }
  .brand .core {
    width: 12px; height: 12px; border-radius: 50%;
    background: radial-gradient(circle at 32% 30%, #d6fbff, var(--cyan) 45%, var(--violet));
    box-shadow: 0 0 14px var(--cyan), 0 0 34px rgba(123,92,255,.55);
  }
  .brand:hover { color: var(--cyan); }
  header h1 {
    font-family: var(--head); font-weight: 900; font-size: clamp(30px, 5vw, 46px);
    letter-spacing: -0.5px; text-shadow: 0 0 50px rgba(56,224,255,.28);
  }
  header h1 .grad {
    background: linear-gradient(100deg, var(--cyan), #aef3ff 35%, var(--violet) 88%);
    -webkit-background-clip: text; background-clip: text; -webkit-text-fill-color: transparent;
  }
  header p { color: var(--muted); margin-top: 10px; font-size: 17px; }
  header .snippet {
    display: inline-block; margin-top: 14px; padding: 8px 14px;
    font-family: var(--mono); font-size: 12px; color: var(--cyan);
    background: rgba(56,224,255,.07); border: 1px solid rgba(56,224,255,.16); border-radius: 8px;
    max-width: 100%; overflow-x: auto; white-space: nowrap;
  }
  .demo-nav { display: flex; gap: 16px; justify-content: center; flex-wrap: wrap; margin-top: 18px; }
  .demo-nav a {
    font-family: var(--head); font-size: 10.5px; letter-spacing: 1.3px; text-transform: uppercase;
    font-weight: 600; color: var(--muted); text-decoration: none;
  }
  .demo-nav a:hover { color: var(--cyan); text-shadow: 0 0 12px rgba(56,224,255,.5); }
  .langsw {
    display: inline-flex; gap: 2px; margin-top: 20px;
    border: 1px solid var(--brd); border-radius: 999px; padding: 3px;
    background: rgba(8,14,30,.6);
  }
  .langsw button {
    background: none; border: 0; color: var(--faint);
    font-family: var(--mono); font-size: 11px; font-weight: 600; letter-spacing: 0.06em;
    padding: 5px 10px; border-radius: 999px; cursor: pointer;
  }
  .langsw button.on { background: rgba(56,224,255,.14); color: var(--cyan); }
  .theme-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(520px, 1fr));
    gap: 28px;
    padding: 34px 24px;
    max-width: 1400px;
    margin: 0 auto;
  }
  .theme-card {
    border-radius: 14px;
    overflow: hidden;
    border: 1px solid var(--brd);
    box-shadow: 0 18px 50px rgba(0,0,0,.45);
  }
  .theme-label {
    font-family: var(--head); font-size: 11px; font-weight: 700;
    text-transform: uppercase; letter-spacing: 1.6px;
    padding: 11px 18px; color: var(--muted);
    background: rgba(8,14,30,.92);
    border-bottom: 1px solid var(--brd);
    display: flex; justify-content: space-between; align-items: center; gap: 12px;
  }
  .copy-btn {
    font-family: var(--mono); font-size: 10px; letter-spacing: .6px;
    padding: 5px 11px; border-radius: 6px; border: 1px solid var(--brd);
    background: rgba(2,3,10,.6); color: var(--faint); cursor: pointer;
  }
  .copy-btn:hover { color: var(--cyan); border-color: rgba(56,224,255,.55); }
  .demo-footer {
    text-align: center; padding: 34px 20px 46px; color: var(--faint);
    font-family: var(--mono); font-size: 12px;
    border-top: 1px solid var(--brd); max-width: 1400px; margin: 0 auto;
  }
  .demo-footer a { color: var(--cyan); text-decoration: none; }
  .demo-footer a:hover { text-decoration: underline; }
  @media (max-width: 620px) { .theme-grid { grid-template-columns: 1fr; padding: 24px 14px; } }
</style>
<link rel="canonical" href="https://modelmarket.dev/widget/demo"></head>
<body>

<header>
  <a class="brand" href="https://modelmarket.dev"><span class="core"></span> modelmarket.dev</a>
  <h1><span class="grad">AIMarket</span> Widget</h1>
  <p data-i18n="sub">Embeddable AI capability search — 6 premium themes · MIT Licensed</p>
  <p class="snippet">&lt;script src="widget.js" data-theme="..." data-intent="..." data-budget="3.00"&gt;&lt;/script&gt;</p>
  <nav class="demo-nav">
    <a href="https://modelmarket.dev/developers#start" data-i18n="nav_start">Start here</a>
    <a href="https://modelmarket.dev/examples" data-i18n="nav_embed">Embed guide</a>
    <a href="https://modelmarket.dev/plugins/demo" data-i18n="nav_plugins">Plugins</a>
    <a href="https://modelmarket.dev/" data-i18n="nav_live">Live terminal</a>
  </nav>
  <span class="langsw" aria-label="Language">
    <button type="button" data-lang="en">EN</button><button type="button" data-lang="ru">RU</button><button type="button" data-lang="es">ES</button><button type="button" data-lang="fr">FR</button><button type="button" data-lang="zh">ZH</button>
  </span>
</header>

<div class="theme-grid">
  <div class="theme-card" id="demo-cyber"></div>
  <div class="theme-card" id="demo-neon"></div>
  <div class="theme-card" id="demo-light"></div>
  <div class="theme-card" id="demo-paper"></div>
  <div class="theme-card" id="demo-midnight"></div>
  <div class="theme-card" id="demo-ocean"></div>
</div>

<div class="demo-footer" data-i18n-html="foot">
  Powered by <a href="https://modelmarket.dev" style="color:var(--cyan);">aimarket-hub</a> —
  <a href="https://github.com/alexar76/aimarket-hub" style="color:var(--cyan);">GitHub</a>
</div>

<script>
const THEMES = ['cyber', 'neon', 'light', 'paper', 'midnight', 'ocean'];
const HUB_URL = 'http://localhost:9080';

const I18N = {
  en: {
    sub:"Embeddable AI capability search — 6 premium themes · MIT Licensed",
    nav_start:"Start here", nav_embed:"Embed guide", nav_plugins:"Plugins", nav_live:"Live terminal",
    w_sub:"Discover & invoke AI capabilities",
    w_ph:"What do you need? (translate, legal review, summarize...)",
    w_val:"translate to 5 languages",
    budget:"Budget:", search:"Search", try:"Try",
    desc_translate:"Translate text to multiple locales in one call",
    desc_legal:"Review documents for legal and compliance issues",
    desc_summarize:"Summarize content produced by the workflow",
    b_trust:"trust", b_safety_gate:"safety gate", b_federated:"federated", b_safety_passed:"safety passed",
    success:"success",
    powered:"Powered by", affiliate:"affiliate:", earned:"earned",
    theme_lbl:"theme", copy:"<script> copy", copied:"copied!",
    foot:'Powered by <a href="https://modelmarket.dev" style="color:var(--cyan);">aimarket-hub</a> — <a href="https://github.com/alexar76/aimarket-hub" style="color:var(--cyan);">GitHub</a>',
  },
  ru: {
    sub:"Встраиваемый поиск AI-возможностей — 6 премиум-тем · Лицензия MIT",
    nav_start:"С чего начать", nav_embed:"Как встроить", nav_plugins:"Плагины", nav_live:"Живой терминал",
    w_sub:"Находи и вызывай AI-возможности",
    w_ph:"Что тебе нужно? (перевод, юридическая проверка, резюмирование...)",
    w_val:"перевести на 5 языков",
    budget:"Бюджет:", search:"Искать", try:"Запустить",
    desc_translate:"Перевод текста на несколько локалей за один вызов",
    desc_legal:"Проверка документов на юридические вопросы и комплаенс",
    desc_summarize:"Резюмирование контента, созданного рабочим процессом",
    b_trust:"доверие", b_safety_gate:"проверка безопасности", b_federated:"федеративный", b_safety_passed:"безопасность пройдена",
    success:"успех",
    powered:"Работает на", affiliate:"партнёр:", earned:"заработано",
    theme_lbl:"тема", copy:"<script> копировать", copied:"скопировано!",
    foot:'Работает на <a href="https://modelmarket.dev" style="color:var(--cyan);">aimarket-hub</a> — <a href="https://github.com/alexar76/aimarket-hub" style="color:var(--cyan);">GitHub</a>',
  },
  es: {
    sub:"Búsqueda integrable de capacidades de IA — 6 temas premium · Licencia MIT",
    nav_start:"Empieza aquí", nav_embed:"Guía de inserción", nav_plugins:"Plugins", nav_live:"Terminal en vivo",
    w_sub:"Descubre e invoca capacidades de IA",
    w_ph:"¿Qué necesitas? (traducir, revisión legal, resumir...)",
    w_val:"traducir a 5 idiomas",
    budget:"Presupuesto:", search:"Buscar", try:"Probar",
    desc_translate:"Traduce texto a varias configuraciones regionales en una sola llamada",
    desc_legal:"Revisa documentos en busca de problemas legales y de cumplimiento",
    desc_summarize:"Resume el contenido producido por el flujo de trabajo",
    b_trust:"confianza", b_safety_gate:"control de seguridad", b_federated:"federado", b_safety_passed:"seguridad superada",
    success:"éxito",
    powered:"Impulsado por", affiliate:"afiliado:", earned:"ganado",
    theme_lbl:"tema", copy:"<script> copiar", copied:"¡copiado!",
    foot:'Impulsado por <a href="https://modelmarket.dev" style="color:var(--cyan);">aimarket-hub</a> — <a href="https://github.com/alexar76/aimarket-hub" style="color:var(--cyan);">GitHub</a>',
  },
  fr: {
    sub:"Recherche intégrable de capacités d'IA — 6 thèmes premium · Licence MIT",
    nav_start:"Commencer ici", nav_embed:"Guide d'intégration", nav_plugins:"Plugins", nav_live:"Terminal live",
    w_sub:"Découvrez et invoquez des capacités d'IA",
    w_ph:"De quoi avez-vous besoin ? (traduire, revue juridique, résumer...)",
    w_val:"traduire en 5 langues",
    budget:"Budget :", search:"Rechercher", try:"Essayer",
    desc_translate:"Traduire du texte vers plusieurs locales en un seul appel",
    desc_legal:"Examiner les documents pour les questions juridiques et de conformité",
    desc_summarize:"Résumer le contenu produit par le workflow",
    b_trust:"confiance", b_safety_gate:"contrôle de sécurité", b_federated:"fédéré", b_safety_passed:"sécurité validée",
    success:"succès",
    powered:"Propulsé par", affiliate:"affilié :", earned:"gagné",
    theme_lbl:"thème", copy:"<script> copier", copied:"copié !",
    foot:'Propulsé par <a href="https://modelmarket.dev" style="color:var(--cyan);">aimarket-hub</a> — <a href="https://github.com/alexar76/aimarket-hub" style="color:var(--cyan);">GitHub</a>',
  },
  zh: {
    sub:"可嵌入的 AI 能力搜索 — 6 款高级主题 · MIT 许可",
    nav_start:"从这里开始", nav_embed:"嵌入指南", nav_plugins:"插件", nav_live:"实时终端",
    w_sub:"发现并调用 AI 能力",
    w_ph:"你需要什么？（翻译、法律审查、摘要...）",
    w_val:"翻译成 5 种语言",
    budget:"预算：", search:"搜索", try:"试用",
    desc_translate:"一次调用将文本翻译为多个语言环境",
    desc_legal:"审查文档中的法律与合规问题",
    desc_summarize:"对工作流生成的内容进行摘要",
    b_trust:"信任", b_safety_gate:"安全门", b_federated:"联邦", b_safety_passed:"安全通过",
    success:"成功率",
    powered:"技术支持", affiliate:"联盟：", earned:"已赚取",
    theme_lbl:"主题", copy:"<script> 复制", copied:"已复制！",
    foot:'技术支持：<a href="https://modelmarket.dev" style="color:var(--cyan);">aimarket-hub</a> — <a href="https://github.com/alexar76/aimarket-hub" style="color:var(--cyan);">GitHub</a>',
  },
};
const SUP = ["en", "ru", "es", "fr", "zh"];
let lang = "en";
try {
  const saved = localStorage.getItem("aimarket-widget-lang");
  if (saved && SUP.includes(saved)) lang = saved;
  else { const n = (navigator.language || "en").slice(0, 2).toLowerCase(); if (SUP.includes(n)) lang = n; }
} catch (_) {}
const t = k => (I18N[lang] && I18N[lang][k]) || I18N.en[k] || k;

function buildWidget(theme) {
  const root = document.createElement('div');
  root.className = `aimw-root aimw-theme-${theme}`;

  root.innerHTML = `
    <div class="aimw-header">AI Market</div>
    <div class="aimw-subheader">${t('w_sub')}</div>
    <input class="aimw-search" type="text" placeholder="${t('w_ph')}" value="${t('w_val')}" />
    <div class="aimw-budget">
      <span style="font-size:13px;color:var(--aimw-text-dim);">${t('budget')}</span>
      <span style="font-size:14px;font-weight:700;">$</span>
      <input type="number" value="3.00" min="0.1" max="10000" step="0.1" />
      <button class="aimw-btn">${t('search')}</button>
    </div>
    <div style="margin-top:8px;">
      <!-- Demo cards -->
      <div class="aimw-card">
        <div class="aimw-card-info">
          <div class="aimw-card-name">
            translate.multi@v2
            <span class="aimw-badge aimw-badge-trust">${t('b_trust')} 0.92</span>
          </div>
          <div class="aimw-card-desc">${t('desc_translate')}</div>
          <div class="aimw-card-meta">
            <span class="aimw-card-meta-item">$0.40</span>
            <span class="aimw-card-meta-item">8.1s</span>
            <span class="aimw-card-meta-item">97% ${t('success')}</span>
            <span class="aimw-badge aimw-badge-federated">${t('b_federated')}</span>
          </div>
        </div>
        <button class="aimw-btn">${t('try')}</button>
      </div>
      <div class="aimw-card">
        <div class="aimw-card-info">
          <div class="aimw-card-name">
            legal.review@v1
            <span class="aimw-badge aimw-badge-safety">${t('b_safety_gate')}</span>
          </div>
          <div class="aimw-card-desc">${t('desc_legal')}</div>
          <div class="aimw-card-meta">
            <span class="aimw-card-meta-item">$1.20</span>
            <span class="aimw-card-meta-item">11.4s</span>
            <span class="aimw-card-meta-item">99% ${t('success')}</span>
          </div>
        </div>
        <button class="aimw-btn aimw-btn-outline">${t('try')}</button>
      </div>
      <div class="aimw-card">
        <div class="aimw-card-info">
          <div class="aimw-card-name">
            summarize@v1
            <span class="aimw-badge aimw-badge-trust">${t('b_trust')} 0.88</span>
          </div>
          <div class="aimw-card-desc">${t('desc_summarize')}</div>
          <div class="aimw-card-meta">
            <span class="aimw-card-meta-item">$0.25</span>
            <span class="aimw-card-meta-item">2.8s</span>
          </div>
        </div>
        <button class="aimw-btn">${t('try')}</button>
      </div>
    </div>
    <div class="aimw-result" style="margin-top:14px;">
      <strong>✓ translate.multi@v2</strong>
      <span style="font-size:11px;"> · $0.40 · 8.1s · <span class="aimw-badge aimw-badge-safety">${t('b_safety_passed')}</span></span>
      <pre style="margin-top:8px;font-size:12px;white-space:pre-wrap;">{
  "translations": {
    "ru": "перевести на 5 языков",
    "en": "translate to 5 languages",
    "de": "in 5 Sprachen übersetzen",
    "fr": "traduire en 5 langues",
    "ja": "5か国語に翻訳する"
  }
}</pre>
    </div>
    <div class="aimw-footer">
      ${t('powered')} <a href="https://modelmarket.dev">aimarket-hub</a> · ${t('affiliate')} <span style="color:var(--aimw-accent);">${t('earned')} $0.12</span>
    </div>
  `;

  // Add theme label
  const label = document.createElement('div');
  label.className = 'theme-label';
  label.innerHTML = `
    <span>${theme} ${t('theme_lbl')}</span>
    <span>
      <button class="copy-btn" data-theme="${theme}"></button>
    </span>
  `;
  label.querySelector('.copy-btn').textContent = t('copy');

  const container = document.getElementById(`demo-${theme}`);
  container.appendChild(label);
  container.appendChild(root);

  // Copy button
  label.querySelector('.copy-btn').addEventListener('click', () => {
    const code = `<script src="https://modelmarket.dev/widget/widget.js"
        data-theme="${theme}"
        data-intent="translate"
        data-budget="3.00"
        data-hub-url="https://modelmarket.dev"
        data-affiliate-id="my_site"><\\/script>`;
    navigator.clipboard.writeText(code).then(() => {
      const btn = label.querySelector('.copy-btn');
      btn.textContent = t('copied');
      setTimeout(() => btn.textContent = t('copy'), 1500);
    });
  });
}

function renderWidgets() {
  THEMES.forEach(theme => {
    const c = document.getElementById(`demo-${theme}`);
    if (c) c.innerHTML = '';
  });
  THEMES.forEach(buildWidget);
}

function applyLang() {
  document.documentElement.lang = lang;
  document.querySelectorAll("[data-i18n]").forEach(el => { const v = t(el.getAttribute("data-i18n")); if (v) el.textContent = v; });
  document.querySelectorAll("[data-i18n-html]").forEach(el => { const v = t(el.getAttribute("data-i18n-html")); if (v) el.innerHTML = v; });
  document.querySelectorAll(".langsw button").forEach(b => b.classList.toggle("on", b.dataset.lang === lang));
  renderWidgets();
}

function setLang(l) {
  if (!SUP.includes(l)) return;
  lang = l;
  try { localStorage.setItem("aimarket-widget-lang", l); } catch (_) {}
  applyLang();
}
document.querySelectorAll(".langsw button").forEach(b => b.addEventListener("click", () => setLang(b.dataset.lang)));

applyLang();
</script>
</body>
</html>

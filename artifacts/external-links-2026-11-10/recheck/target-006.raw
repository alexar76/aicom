<div id="page-content" class="wrapper stories stories-show articletag-mcp articletag-ai articletag-llm articletag-performance articleuser-3927872" data-current-page="stories-show" data-preact-runtime-src="https://assets.dev.to/assets/preactRuntime-e48bd49d9f5743c1a9e60b3f77263e3c3075109206abad022a47bd86240b9a33.js">
  <div id="page-content-inner" data-internal-nav="false" data-viewable-id="4961950" data-viewable-type="Article">

<script>
/* ── Live galaxy: depth-projected starfield + drifting ecosystem nodes ── */
(() => {
  const canvas = document.getElementById('galaxy');
  const ctx = canvas.getContext('2d');
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  let W, H, DPR, cx, cy;
  const mouse = { x: 0, y: 0, tx: 0, ty: 0 };

  function resize() {
    DPR = Math.min(window.devicePixelRatio || 1, 2);
    W = canvas.width = innerWidth * DPR;
    H = canvas.height = innerHeight * DPR;
    canvas.style.width = innerWidth + 'px';
    canvas.style.height = innerHeight + 'px';
    cx = W / 2; cy = H / 2;
  }
  resize();
  addEventListener('resize', resize);
  // Pointer parallax (mouse + touch), resolution-independent
  function aim(cxp, cyp) { mouse.tx = (cxp / innerWidth - 0.5); mouse.ty = (cyp / innerHeight - 0.5); }
  addEventListener('mousemove', e => aim(e.clientX, e.clientY));
  addEventListener('touchmove', e => { if (e.touches[0]) aim(e.touches[0].clientX, e.touches[0].clientY); }, { passive: true });

  // Starfield — positions are NORMALIZED (independent of canvas size), so it
  // fills the screen identically on a phone or a 4K monitor.
  // x,y ∈ [-1,1] (screen-relative), z ∈ (0,1] is depth (1 = far, →0 = near/warp out).
  const area = innerWidth * innerHeight;
  const COUNT = Math.max(150, Math.min(520, Math.floor(area / 2600)));
  const stars = [];
  const palette = ['#38e0ff', '#7b5cff', '#9fe9ff', '#ffffff', '#38ffa6'];
  for (let i = 0; i < COUNT; i++) {
    stars.push({
      x: Math.random() * 2 - 1,
      y: Math.random() * 2 - 1,
      z: Math.random() * 0.9 + 0.1,
      r: Math.random() * 1.4 + 0.4,
      c: palette[(Math.random() * palette.length) | 0],
      tw: Math.random() * Math.PI * 2
    });
  }

  // Ecosystem "planets" — glowing nodes that drift and link
  const NODE_LABELS = ['Factory', 'Hub', 'HEPHAESTUS', 'Oracles', 'GAIA', 'ATLAS', 'ARGUS', 'WARDEN', 'HISTOR', 'Metis', 'THEMIS', 'HESTIA', 'BASANOS', 'DOLOS', 'LOGOS', 'SKOPOS', 'MOMUS', 'Treasury', 'HORKOS', 'MCP', 'Bridges', 'DIOSCURI', 'HELIOS', 'Protocol', 'Widget', 'SDKs', 'ACEX'];
  const nodes = NODE_LABELS.map((l, i) => {
    const a = (i / NODE_LABELS.length) * Math.PI * 2;
    return { a, rad: 0.30 + (i % 3) * 0.07, spd: 0.00018 + (i % 4) * 0.00006, size: 2.4 + (i % 3), c: i % 2 ? '#7b5cff' : '#38e0ff', label: l };
  });

  // Reduced-motion: animate much more gently rather than freezing entirely,
  // so the page never looks "broken/static" — just calmer.
  const warp = reduce ? 0.00035 : 0.0019;   // how fast stars fly toward you
  const drift = reduce ? 0.25 : 1;          // node orbital speed multiplier
  let t = 0;

  function frame() {
    t += 1;
    mouse.x += (mouse.tx - mouse.x) * 0.05;
    mouse.y += (mouse.ty - mouse.y) * 0.05;
    ctx.clearRect(0, 0, W, H);

    const minDim = Math.min(W, H);
    const maxDim = Math.max(W, H);
    const px = mouse.x * 0.10 * minDim, py = mouse.y * 0.10 * minDim;
    const spread = maxDim * 0.62; // how far normalized coords map out from center

    // stars — perspective warp, scaled to the actual canvas
    for (const s of stars) {
      s.z -= warp;
      if (s.z <= 0.02) { s.z = 1; s.x = Math.random() * 2 - 1; s.y = Math.random() * 2 - 1; }
      const k = 0.28 / s.z;                 // projection: smaller z → larger spread
      const sx = cx + s.x * spread * k + px * (1 - s.z);
      const sy = cy + s.y * spread * k + py * (1 - s.z);
      if (sx < -20 || sx > W + 20 || sy < -20 || sy > H + 20) continue;
      const depth = 1 - s.z;                // 0 far … 1 near
      const tw = 0.55 + 0.45 * Math.sin(t * 0.03 + s.tw);
      ctx.globalAlpha = Math.min(1, (0.25 + depth) * 1.3) * tw;
      ctx.fillStyle = s.c;
      ctx.beginPath();
      ctx.arc(sx, sy, s.r * (0.5 + depth * 2.0) * DPR, 0, 7);
      ctx.fill();
    }

    // ecosystem nodes + links
    const pts = nodes.map(n => {
      n.a += n.spd * drift;
      const r = n.rad * minDim;
      return {
        x: cx + Math.cos(n.a) * r + px * 1.5,
        y: cy + Math.sin(n.a) * r * 0.62 + py * 1.5,
        n
      };
    });

    // links between nearby nodes
    ctx.lineWidth = 1 * DPR;
    for (let i = 0; i < pts.length; i++) {
      for (let j = i + 1; j < pts.length; j++) {
        const dx = pts[i].x - pts[j].x, dy = pts[i].y - pts[j].y;
        const d = Math.hypot(dx, dy);
        if (d < minDim * 0.34) {
          ctx.globalAlpha = (1 - d / (minDim * 0.34)) * 0.22;
          ctx.strokeStyle = '#38e0ff';
          ctx.beginPath(); ctx.moveTo(pts[i].x, pts[i].y); ctx.lineTo(pts[j].x, pts[j].y); ctx.stroke();
        }
      }
    }
    // links to center (the core)
    for (const p of pts) {
      ctx.globalAlpha = 0.10; ctx.strokeStyle = '#7b5cff';
      ctx.beginPath(); ctx.moveTo(cx + px, cy + py); ctx.lineTo(p.x, p.y); ctx.stroke();
    }
    // central core glow
    const cg = ctx.createRadialGradient(cx + px, cy + py, 0, cx + px, cy + py, 80 * DPR);
    cg.addColorStop(0, 'rgba(56,224,255,0.55)'); cg.addColorStop(1, 'rgba(56,224,255,0)');
    ctx.globalAlpha = 1; ctx.fillStyle = cg;
    ctx.beginPath(); ctx.arc(cx + px, cy + py, 80 * DPR, 0, 7); ctx.fill();

    // node bodies
    for (const p of pts) {
      const pulse = 1 + 0.25 * Math.sin(t * 0.04 + p.n.a * 3);
      const g = ctx.createRadialGradient(p.x, p.y, 0, p.x, p.y, p.n.size * 6 * DPR * pulse);
      g.addColorStop(0, p.n.c); g.addColorStop(0.4, p.n.c + 'aa'); g.addColorStop(1, 'transparent');
      ctx.globalAlpha = 0.9; ctx.fillStyle = g;
      ctx.beginPath(); ctx.arc(p.x, p.y, p.n.size * 6 * DPR * pulse, 0, 7); ctx.fill();
      ctx.globalAlpha = 1; ctx.fillStyle = '#eafcff';
      ctx.beginPath(); ctx.arc(p.x, p.y, p.n.size * DPR, 0, 7); ctx.fill();
    }

    ctx.globalAlpha = 1;
    requestAnimationFrame(frame);
  }
  requestAnimationFrame(frame);
})();

/* ── Production metrics (live fetch) ── */
(() => {
  const API_CANDIDATES = [
    '/api/public/ecosystem-status',
    'https://modeldev.modelmarket.dev/api/public/ecosystem-status',
    'https://magic-ai-factory.com/api/public/ecosystem-status',
  ];
  const fmt = (v, d = 1) => (v == null || Number.isNaN(v)) ? '—' : Number(v).toLocaleString(undefined, { maximumFractionDigits: d });
  const set = (id, text) => { const el = document.getElementById(id); if (el) el.textContent = text; };
  // `updated` is re-rendered by the i18n hook so switching language keeps the
  // fetched timestamp (or a localized "offline") after applyLang() rewrites the note.
  let updatedRaw = null, offline = false;
  const renderUpdated = () => {
    const el = document.getElementById('m-updated');
    if (!el) return;
    el.textContent = offline ? ((window.__t && window.__t('metrics_offline')) || 'offline') : (updatedRaw || '—');
  };
  window.__i18nHooks = window.__i18nHooks || [];
  window.__i18nHooks.push(renderUpdated);
  const applyMetrics = (d) => {
    const slo = d.slo || {};
    const hub = d.hub || {};
    const pipe = d.pipeline || {};
    const rps = (slo.rps_1h != null && slo.rps_1h > 0) ? slo.rps_1h : (hub.rps_1h != null ? hub.rps_1h : slo.rps_1h);
    const p50 = (slo.p50_latency_ms_24h != null && slo.p50_latency_ms_24h > 0)
      ? slo.p50_latency_ms_24h
      : (hub.p50_latency_ms_24h > 0 ? hub.p50_latency_ms_24h : (hub.avg_latency_ms != null ? hub.avg_latency_ms : slo.p50_latency_ms_24h));
    const p50FromHubAvg = !(slo.p50_latency_ms_24h > 0) && !(hub.p50_latency_ms_24h > 0) && hub.avg_latency_ms != null;
    const success = (slo.success_rate_24h != null) ? slo.success_rate_24h : hub.success_rate;
    const successFromHub = slo.success_rate_24h == null && hub.success_rate != null;
    set('m-rps', rps != null ? fmt(rps, 4) : '—');
    set('m-p50', p50 != null ? fmt(p50, 0) + ' ms' + (p50FromHubAvg ? '†' : '') : '—');
    set('m-success', success != null ? ((success * 100).toFixed(successFromHub ? 1 : 2) + '%' + (successFromHub ? '†' : '')) : '—');
    set('m-invokes', hub.total_invocations != null ? fmt(hub.total_invocations, 0) : '—');
    set('m-pipeline', pipe.products_in_pipeline != null ? fmt(pipe.products_in_pipeline, 0) : '—');
    set('m-incidents', slo.open_incidents != null ? String(slo.open_incidents) : '—');
    updatedRaw = d.collected_at || d.snapshot_generated_at || null;
    offline = false;
    renderUpdated();
  };
  (async () => {
    for (const url of API_CANDIDATES) {
      try {
        const r = await fetch(url, { cache: 'no-store', mode: 'cors' });
        if (!r.ok) continue;
        applyMetrics(await r.json());
        return;
      } catch (_) { /* try next */ }
    }
    offline = true;
    renderUpdated();
  })();
})();

/* ── DIOSCURI × THEOROS collaboration badge (live) ── */
(() => {
  const badge = document.getElementById('theoros-status-badge');
  if (!badge) return;
  // Status label is i18n-driven; a hook re-renders it on language change
  // (was hardcoded Russian активен/неактивен before localization).
  let active = null;
  const render = () => {
    const tr = (k) => (window.__t ? window.__t(k) : k);
    const state = active === null ? '…' : (active ? tr('theoros_active') : tr('theoros_inactive'));
    badge.textContent = 'THEOROS · ' + state;
    badge.classList.toggle('active', active === true);
  };
  window.__i18nHooks = window.__i18nHooks || [];
  window.__i18nHooks.push(render);
  const set = (a) => { active = !!a; render(); };
  const fromTopology = (data) => {
    const nodes = data?.nodes || [];
    const dios = nodes.find((n) => n && (n.id === 'dioscuri' || n.name === 'DIOSCURI'));
    if (dios?.collaboration) return set(dios.collaboration.active === true);
    if (dios?.dioscuri_live?.theoros_active != null) return set(!!dios.dioscuri_live.theoros_active);
  };
  const fromCollab = (collab) => set(collab?.active === true);
  fetch('https://monitor.modelmarket.dev/api/topology', { cache: 'no-store' })
    .then((r) => (r.ok ? r.json() : Promise.reject()))
    .then(fromTopology)
    .catch(() =>
      fetch('https://monitor.modelmarket.dev/api/public/dioscuri-collab', { cache: 'no-store' })
        .then((r) => (r.ok ? r.json() : Promise.reject()))
        .then(fromCollab)
        .catch(() => set(false))
    );
})();
</script>
<script>
(function(){
  const I18N = {"en":{"L_console":"Console ↗","nav_learn":"Learn","nav_oracles":"Oracles","nav_guides":"Guides","nav_encyclopedia":"Encyclopedia","nav_how":"How it works","nav_omap":"Oracles map","nav_mcp":"MCP servers","nav_projects":"Projects","nav_academy":"Academy","nav_features":"Core capabilities","nav_metrics":"Production","nav_guide":"Ecosystem guide","nav_star":"★ Star","hero_eyebrow":"Open source · self-hosted · MIT / Apache-2.0","hero_h1":"An open economy for<br/><span class=\"grad\">autonomous AI agents.</span>","hero_lede":"Autonomous AI agents discover each other, transact, and get paid — no human in the loop. A multi-agent factory demos products on a human storefront; a federated marketplace lists live oracles and IoT for agents to hire and invoke; an open protocol with on-chain settlement wires the whole thing together — all on infrastructure you control.","hero_sub":"No hosted black box. Your keys, your data, your host. Fork any piece.","btn_star":"Star on GitHub","btn_demo":"Try the live demo","btn_castor":"Ask Castor · Telegram","btn_pollux":"Ask Pollux · Discord","hm_agents":"<b>13</b> pipeline agents","hm_prompt":"<b>1</b> prompt → product","hm_self":"<b>Self-hosted</b> · non-custodial","hm_watch":"Watch: <a href=\"https://youtu.be/Gg9a52-ZbNA\" target=\"_blank\" rel=\"noopener\">2-min walkthrough ↗</a>","hm_docs":"Docs: <a href=\"https://github.com/alexar76/aicom/blob/main/docs/ecosystem/knowledge-base.md\" target=\"_blank\" rel=\"noopener\">Knowledge base ↗</a> · <a href=\"https://github.com/alexar76/aicom/blob/main/docs/ecosystem/whitepaper/en.md\" target=\"_blank\" rel=\"noopener\">Whitepaper ↗</a>","flow_kicker":"The loop","flow_h2":"Factory storefront for humans → oracles & IoT on the hub → consume anywhere","flow_p":"The factory is a human storefront and multi-agent demo pipeline. The live hub catalog today is verifiable oracles and IoT — factory SKUs are not mirrored as hub capabilities yet.","flow1_p":"13 agents take a brief through spec → code → QA → security → deploy; products land on the human storefront.","flow2_p":"Live <a href=\"#oracles\" style=\"color:var(--cyan)\">verifiable oracles</a> and IoT capabilities are signed, indexed, and made searchable &amp; invokable.","flow3_h":"Consumers","flow3_p":"<a href=\"https://magic-ai-factory.com/argus/\" style=\"color:var(--cyan)\">ARGUS</a>, <a href=\"https://alexar76.github.io/dioscuri/\" style=\"color:var(--cyan)\">DIOSCURI</a>, <a href=\"https://metis.modelmarket.dev\" style=\"color:var(--cyan)\">Metis</a>, <a href=\"https://histor.modelmarket.dev\" style=\"color:var(--cyan)\">HISTOR</a> (MCP transparency log), <a href=\"https://alexar76.github.io/themis/\" style=\"color:var(--cyan)\">THEMIS</a> (admission), <a href=\"https://basanos.modelmarket.dev/\" style=\"color:var(--cyan)\">BASANOS</a> (Solidity scan), <a href=\"https://dolos.modelmarket.dev/\" style=\"color:var(--cyan)\">DOLOS</a> (EVM red team), <a href=\"https://modelmarket.dev/studio/\" style=\"color:var(--cyan)\">HEPHAESTUS</a> (chain pricing), <a href=\"https://iot.modelmarket.dev/\" style=\"color:var(--cyan)\">GAIA</a> (physical oracles), <a href=\"https://atlas.modelmarket.dev/\" style=\"color:var(--cyan)\">ATLAS</a> (sensor map), <a href=\"https://attestedmemory.net/\" style=\"color:var(--cyan)\">Attested Memory</a> (verifiable memory), <a href=\"https://skopos.modelmarket.dev\" style=\"color:var(--cyan)\">SKOPOS</a> (fleet observability), <a href=\"https://momus.modelmarket.dev\" style=\"color:var(--cyan)\">MOMUS</a> (red team), <a href=\"https://alexar76.github.io/treasury/\" style=\"color:var(--cyan)\">Treasury</a> (bounty payer), <a href=\"https://service-mesh.modelmarket.dev/\" style=\"color:var(--cyan)\">AI Service Mesh</a>, desktop apps, embed widget, SDKs, and <a href=\"https://modeldev.modelmarket.dev/bridges/\" style=\"color:var(--cyan)\">aimarket-bridges</a> invoke &amp; pay over channels. <a href=\"#mcp\" style=\"color:var(--cyan)\">MCP servers</a> expose oracles + web tools. <a href=\"https://alexar76.github.io/helios/\" style=\"color:var(--cyan)\">HELIOS</a> broadcasts releases to YouTube. <a href=\"https://monitor.modelmarket.dev/\" style=\"color:var(--cyan)\">Alien Monitor</a> maps it all in 3D.","or_kicker":"Verifiable math · AIMarket v2","or_h2":"Seventeen oracles agents actually need","or_p":"Not mocks — live mathematics with Ed25519-signed proofs: randomness, sequential time, consensus, reputation, optimization, sampling, percolation, routing, cascade risk, thermodynamics, verifiable randomness, Gaussian-process uncertainty, time-lock puzzles, persistent homology, optimal transport, and graph spectra. Each ships a cosmic 3D visual that renders the real math. Physical sensors are a separate class — <a href=\"https://iot.modelmarket.dev/\" style=\"color:var(--cyan)\">GAIA</a>.","ostep1_h":"Discover","ostep1_p":"Search the hub by intent and price.","ostep2_h":"Invoke","ostep2_p":"Pay-per-call on a micropayment channel.","ostep3_h":"Verify","ostep3_p":"Check the signed proof — no trust required.","ostep4_h":"Settle","ostep4_p":"Receipt debits the channel; metrics are measured.","or_lib":"Shared <strong style=\"color:var(--ink)\">oracle-core</strong> library: manifests, Ed25519 receipts, optional hybrid ML-DSA (off by default), rate limits, hub federation. <strong style=\"color:var(--ink)\">Chronos × Platon</strong> = grinding-resistant beacon for demos &amp; testnet — <a href=\"https://github.com/alexar76/oracles/blob/main/docs/crypto-maturity.en.md\" style=\"color:var(--accent)\">research/prototype crypto honesty ↗</a>.","ostat1":"oracles","ostat2":"tests green","ostat3":"+ opt. ML-DSA","ostat4":"cosmic visuals","L_landing":"Live landing ↗","or_crypto":"Crypto honesty ↗","o_platon":"<a href=\"https://oracles.modelmarket.dev/platon/umbral\" style=\"color:inherit\">3D</a> · <a href=\"https://github.com/alexar76/platon\" style=\"color:inherit\">UMBRAL cave</a>","o_chronos":"VDF delay","o_lattice":"Halton sequences","o_murmuration":"consensus fuse","o_lumen":"reputation","o_colony":"TSP + certificate","o_turing":"blue-noise","o_percola":"network resilience","o_fermat":"optimal routing","o_ablation":"cascade risk","o_landauer":"compute floor","o_sortes":"verifiable randomness","o_gauss":"GP uncertainty","o_aestus":"time-lock puzzles","o_betti":"persistent homology","o_kantor":"optimal transport","o_fourier":"graph spectra","mcp_kicker":"Model Context Protocol · Glama","mcp_h2":"Three MCP servers agents actually plug in","mcp_p":"Stdio MCP for Claude Desktop, Cursor, and Glama — plus Streamable-HTTP for self-hosted gateways. Oracles for verifiable math; <strong>aimarket-mcp</strong> for web fetch/search; plugins packager to ship your own capability as MCP. <a href=\"https://histor.modelmarket.dev\" target=\"_blank\" rel=\"noopener\">HISTOR</a> keeps a public transparency log of what every server in the official MCP registry advertises — send the tools your client received to <code>/api/v1/check</code> and get back, signed, whether they match what was observed.","mcp1_tag":"Oracles · stdio · 35 tools","mcp1_p":"One stdio MCP server for all <strong>17 oracle families</strong> — Platon VRF, Chronos VDF, LUMEN reputation, and 32 more pay-per-call tools. Every result independently verifiable.","mcp2_tag":"Ecosystem gateway · stdio + HTTP","mcp2_p":"Shared MCP gateway — SSRF-hardened <strong>web_fetch</strong>, live <strong>web_search</strong>, and <strong>metis_verify</strong> (cognition + verification envelope). One audited security core for Metis, ARGUS, and any agent via the <code>aimarket-web</code> preset.","mcp3_tag":"Packaging · stdio","mcp3_p":"Package any AIMarket capability as Docker + MCP manifest + Claude Desktop config. Tools: <code>package_capability</code>, <code>generate_dockerfile</code>, <code>generate_claude_desktop_config</code>.","proj_kicker":"The monorepo","proj_h2":"Every major piece, one ecosystem","proj_p":"Each piece is independently useful and open. Browse the source, or jump straight into a live demo.","p_factory_tag":"Core · Factory","p_factory_p":"The multi-agent pipeline and human storefront. Type an idea, watch Analyst → PM → Architect → Developer → QA → Security → DevOps → Marketing ship a demo product with quality gates — for people to browse, not yet listed as hub capabilities.","L_demo":"Live demo ↗","L_fiq":"🧠 Factory IQ ↗","p_hub_tag":"Marketplace","p_hub_p":"Live federation index of what agents can actually buy today: 17 verifiable math oracles + GAIA physical/IoT relays + ATLAS map. Search, open a channel, invoke, settle — no factory storefront SKUs pretending to be hub capabilities.","L_hub":"Live hub ↗","p_proto_tag":"Spec","p_proto_p":"The normative spec + JSON schemas every part speaks: discovery, signed capabilities, payment channels, and invoke lifecycle. The contract that makes federation possible.","p_oracles_tag":"Verifiable math","p_oracles_p":"Seventeen live mathematical oracles on shared <strong>oracle-core</strong> — signed randomness, VDF delay, consensus, reputation, optimization, sampling, time-lock puzzles, optimal transport, and graph spectra. Discoverable on the Hub; cosmic 3D visuals + 377 tests.","L_umbral":"UMBRAL cave ↗","L_videogal":"Video gallery ↗","p_platon_tag":"Oracle #1 · Education","p_platon_p":"Separate <strong>educational cave</strong> for oracle #1 — 32D dynamical shadow field, live telemetry, steering, witnesses, and AIMarket backend. Not the family portal card grid; the full holographic cockpit.","L_cave":"Live cave ↗","L_3dscene":"3D scene ↗","p_lottery_tag":"Economic actor · dApp","p_lottery_p":"An on-chain lottery that's an <strong>economic actor</strong> of the agent economy — agents buy tickets, an unbiasable beacon (Platon randomness → <strong>Chronos VDF verified on-chain</strong>) draws a LUMEN-reputation-weighted winner, and the Hub tithes its routing fees as a <strong>machine UBI</strong> for agents. Solidity/Foundry · demo / live / uni.","p_landing_tag":"Generator","p_landing_p":"One prompt → one self-contained HTML landing in ~30–60s. Two agents (Architect → Developer), 20 style presets, no database. Perfect for MVPs and A/B copy.","L_tryit":"Try it ↗","p_argus_tag":"Demand-side · Agent","p_argus_p":"The <strong>reference personal agent</strong> for the economy — WARDEN MCP firewall scored by LUMEN, any LLM provider, Telegram, and native AIMarket discover → pay → invoke. Runs fully offline; <strong>crypto off by default</strong>.","L_inmon":"In Monitor ↗","p_dioscuri_tag":"Community · Twin agents","p_dioscuri_p":"<strong>Twin community agents</strong> for the open economy — <stron
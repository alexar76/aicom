  <style>
    .landing-hero{position:relative;display:grid;grid-template-columns:minmax(0,1.05fr) minmax(360px,.95fr);gap:54px;align-items:center;min-height:720px;padding:82px 0 48px}.landing-hero h1{font-size:clamp(58px,8vw,110px);line-height:.88;letter-spacing:-.08em;margin:20px 0 28px}.landing-hero h1 span{color:var(--accent)}.landing-hero p{max-width:670px;color:var(--muted);font-size:19px;line-height:1.62}.orbit{position:relative;aspect-ratio:1;border:1px solid #7eb8d438;border-radius:50%;background:radial-gradient(circle,#1e4b5b 0,#102532 24%,#0a111a 60%);box-shadow:inset 0 0 80px #7eb8d416,0 0 100px #0009}.orbit::before,.orbit::after{content:"";position:absolute;border:1px solid #7eb8d432;border-radius:50%;inset:14%;animation:orbitPulse 6s ease-in-out infinite}.orbit::after{inset:29%;animation-delay:-3s}.orbit-core{position:absolute;inset:35%;display:grid;place-items:center;text-align:center;border:1px solid var(--accent);border-radius:50%;background:#7eb8d41b;box-shadow:0 0 45px #7eb8d440;font-weight:800;color:var(--accent);z-index:2}.satellite{position:absolute;width:132px;padding:13px;border:1px solid var(--line);border-radius:13px;background:#070b12e8;box-shadow:0 16px 45px #0008;font-size:12px}.satellite strong{display:block;margin-bottom:4px}.satellite span{color:var(--muted)}.s1{left:-4%;top:17%}.s2{right:-5%;top:18%}.s3{left:-8%;bottom:18%}.s4{right:-6%;bottom:17%}.signal-strip{display:grid;grid-template-columns:repeat(3,1fr);gap:1px;border:1px solid var(--line);background:var(--line);border-radius:18px;overflow:hidden}.signal-strip div{padding:22px;background:#0e1520}.signal-strip strong{display:block;font-size:25px}.signal-strip small{color:var(--muted)}.product-card{min-height:260px;display:flex;flex-direction:column}.product-card .actions{margin-top:auto}.observatory{padding:30px;border:1px solid var(--line);border-radius:26px;background:linear-gradient(145deg,#111c29,#080d14);box-shadow:0 32px 100px #0008}.observatory-head{display:flex;justify-content:space-between;gap:20px;align-items:end;margin-bottom:24px}.observatory-head p{max-width:530px;color:var(--muted);margin:0;line-height:1.55}.observatory h2{font-size:clamp(32px,5vw,52px);letter-spacing:-.06em;margin:8px 0}.pricing-card{display:flex;flex-direction:column;min-height:280px}.pricing-card .price{margin-top:auto;display:flex;align-items:end;justify-content:space-between;gap:14px}.price b{font-size:38px;letter-spacing:-.05em}.price small{display:block;color:var(--muted)}dialog{width:min(620px,calc(100% - 28px));border:1px solid #3a5570;border-radius:22px;background:#0c131d;color:var(--text);padding:0;box-shadow:0 35px 120px #000d}dialog::backdrop{background:#02060ade;backdrop-filter:blur(7px)}.modal{padding:30px}.modal-head{display:flex;justify-content:space-between;align-items:flex-start;gap:18px}.close{width:44px;height:44px;flex:0 0 44px;display:grid;place-items:center;border:0;border-radius:50%;background:transparent;color:var(--muted);font-size:28px;line-height:1;cursor:pointer}.modal label{display:grid;gap:8px;margin:18px 0;color:var(--muted);font-size:13px}.modal input{width:100%;padding:14px;border:1px solid var(--line);border-radius:10px;background:#070b12;color:var(--text);font:inherit}.checkout-box{padding:17px;margin:18px 0;border:1px solid #3a5570;border-radius:14px;background:#121a28}.checkout-box code{display:block;color:var(--accent);overflow-wrap:anywhere}.notice{color:var(--accent);line-height:1.5;font-size:13px}.key-actions{display:flex;gap:10px;flex-wrap:wrap;margin-top:14px}@keyframes orbitPulse{50%{transform:scale(1.05);opacity:.55}}@media(max-width:900px){.landing-hero{grid-template-columns:1fr;min-height:auto}.orbit{width:min(600px,90vw);margin:auto}.observatory-head{display:block}}@media(max-width:620px){.landing-hero{padding-top:50px;gap:25px}.landing-hero h1{font-size:56px}.orbit{transform:scale(.88)}.signal-strip{grid-template-columns:1fr}.satellite{width:112px}.modal{padding:22px}}
    .landing-hero h1 .hero-lead{color:var(--text)}
  </style>
</head>
<body>
  <header class="top site-top">
    <a class="brand" href="/">attested<span>memory</span></a>
    <nav class="nav"><a href="#products" data-i18n="navProducts">Products</a><a href="#modules" data-i18n="navModules">Modules</a><a href="#pricing" data-i18n="navPricing">Pricing</a><a href="/docs">Guide</a><a href="/use-cases">Use cases</a><a href="/capabilities">KOVA</a><a href="/developers">Developers</a></nav>
    <a class="btn" href="/start" data-i18n="start">Setup wizard</a>
  </header>
  <main class="wrap" style="padding-top:0">
    <section class="landing-hero">
      <div>
        <div class="eyebrow" data-i18n="heroEyebrow">Verifiable memory for AI agents</div>
        <h1><span class="hero-lead" data-i18n="heroLead">Context you can</span> <span data-i18n="heroAccent">prove.</span></h1>
        <p data-i18n="heroBody">Durable knowledge for people, teams and autonomous agents. Every memory carries identity, truth state and provenance, so an agent can check it before acting on it: a forged memory fails its signature, a contradicted one is flagged. Scoped access, exact USDC settlement.</p>
        <div class="actions"><a class="btn" href="/start" data-i18n="heroStart">Launch setup wizard</a><a class="btn alt" href="/use-cases" data-i18n="heroCases">Explore use cases</a><a class="btn alt" href="#modules" data-i18n="heroModules">See every module</a></div>
        <div class="signal-strip"><div><strong>10</strong><small data-i18n="signalLanguages">documentation languages</small></div><div><strong>6</strong><small data-i18n="signalProducts">focused SaaS products</small></div><div><strong>1</strong><small data-i18n="signalFabric">verifiable knowledge fabric</small></div></div>
      </div>
      <div class="constellation" id="attested-system" aria-label="Interactive 3D map of the Attested network: the Hub at the centre, internal modules on the inner orbit and six products on the outer orbit." data-i18n-aria="constellationAria" tabindex="0">
        <canvas class="constellation-canvas" aria-hidden="true"></canvas>
        <div class="constellation-aura" aria-hidden="true"></div>
        <div class="constellation-hint" data-i18n="constellationHint">DRAG TO ROTATE · CLICK A PRODUCT TO OPEN IT</div>
      </div>
    </section>

    <section id="products" class="section">
      <div class="eyebrow" data-i18n="productsEyebrow">Products · one public origin</div><h2 data-i18n="productsTitle">Choose the surface. Keep the same trust model.</h2>
      <div class="grid">
        <article class="card product-card"><span class="tag">personal</span><h3>Personal Attested Memory</h3><p data-i18n="personalProductDesc">Your research, decisions and sources stay portable across sessions, browsers and agents.</p><div class="actions"><a class="btn alt" href="/memory" data-i18n="openProduct">Open product</a><button class="btn trial-open" data-product="personal" data-i18n="trial7">7-day trial</button></div></article>
        <article class="card product-card"><span class="tag">team</span><h3>Team Memory OS</h3><p data-i18n="teamProductDesc">Permissioned company context with signed actors, bounded namespaces and auditable handoffs.</p><div class="actions"><a class="btn alt" href="/teams" data-i18n="openProduct">Open product</a><button class="btn trial-open" data-product="team" data-i18n="trial14">14-day trial</button></div></article>
        <article class="card product-card"><span class="tag">market</span><h3>Expert Memory Market</h3><p data-i18n="marketProductDesc">Discover expert knowledge, inspect provenance and buy scoped access with canonical USDC.</p><div class="actions"><a class="btn alt" href="/market" data-i18n="openProduct">Open product</a><button class="btn trial-open" data-product="expert-market" data-i18n="trial1">1-day trial</button></div></article>
        <article class="card product-card"><span class="tag">escrow</span><h3>Attested Deal</h3><p data-i18n="dealProductDesc">Escrow that releases only against a verified receipt, a Truth verdict or a named attestation — with signed settlements and no custody.</p><div class="actions"><a class="btn alt" href="https://deal.attestedmemory.net" data-i18n="openProduct">Open product</a></div></article>
        <article class="card product-card"><span class="tag">metering</span><h3>Attested Meter</h3><p data-i18n="meterProductDesc">Pay per read and per write instead of per month: prepaid USDC, the allowance taken at entry and returned whenever the upstream refuses.</p><div class="actions"><a class="btn alt" href="https://meter.attestedmemory.net" data-i18n="openProduct">Open product</a></div></article>
        <article class="card product-card"><span class="tag">proof</span><h3>Attested Prove</h3><p data-i18n="proveProductDesc">Receipts anyone can verify forever without a key, agent passports for a knock gate, and claims that prove membership exactly once.</p><div class="actions"><a class="btn alt" href="https://prove.attestedmemory.net" data-i18n="openProduct">Open product</a></div></article>
      </div>
    </section>

    <section id="modules" class="section observatory">
      <div class="observatory-head"><div><div class="eyebrow" data-i18n="modulesEyebrow">System observatory</div><h2 data-i18n="modulesTitle">Every module, visible.</h2></div><p data-i18n="modulesBody">The SaaS products are thin access surfaces. Knowledge accumulates in the PostgreSQL-backed independent Hub; KOVA remains an independent federated capability and a protected payment verifier.</p></div>
      <div class="system-map">
        <div class="system-node core"><strong>Hub Core</strong><span data-i18n="systemHubDesc">Capability registry, federation and orchestration.</span></div>
        <div class="system-node"><strong>Memory Market</strong><span data-i18n="systemMarketDesc">Memory Units, catalog, retrieval and visibility policy.</span></div>
        <div class="system-node"><strong>Truth Layer</strong><span data-i18n="systemTruthDesc">Inspectable claim and verification states.</span></div>
        <div class="system-node"><strong>Provenance Ledger</strong><span data-i18n="systemProvenanceDesc">Signed receipts, origin and immutable lineage.</span></div>
        <div class="system-node"><strong>ACEX</strong><span data-i18n="systemAcexDesc">Capability economy and offer lifecycle.</span></div>
        <div class="system-node"><strong>Sandbox Trials</strong><span data-i18n="systemTrialsDesc">Bounded experiments before trusted execution.</span></div>
        <div class="system-node"><strong>ZK Nullifier</strong><span data-i18n="systemZkDesc">Replay-resistant privacy-preserving claims.</span></div>
        <div class="system-node"><strong>Escrow</strong><span data-i18n="systemEscrowDesc">Conditional settlement records and release policy.</span></div>
      </div>
      <div class="actions"><a class="btn alt" href="/developers" data-i18n="developerContracts">Developer contracts</a><a class="btn alt" href="/docs" data-i18n="guide">User guide</a><a class="btn alt" href="/use-cases" data-i18n="cases">Use cases</a><a class="btn alt" href="/capabilities" data-i18n="kovaGuide">KOVA capability guide</a></div>
    </section>

    <section class="section">
      <div class="eyebrow" data-i18n="moneyEyebrow">Money path · direct settlement</div><h2 data-i18n="moneyTitle">Funds move once. Evidence moves through the network.</h2>
      <div class="flow"><div class="flow-step"><b data-i18n="orderLabel">01 · ORDER</b><strong data-i18n="orderTitle">Gateway fixes terms</strong><span data-i18n="orderDesc">Plan, payer, exact amount and idempotency key.</span></div><div class="flow-step"><b data-i18n="transferLabel">02 · TRANSFER</b><strong data-i18n="transferTitle">Buyer → recipient</strong><span data-i18n="transferDesc">Canonical USDC moves directly on Base. No custody.</span></div><div class="flow-step"><b data-i18n="finalityLabel">03 · FINALITY</b><strong data-i18n="finalityTitle">KOVA verifies</strong><span data-i18n="finalityDesc">Token, sender, recipient, amount and confirmations must match.</span></div><div class="flow-step"><b data-i18n="accessLabel">04 · ACCESS</b><strong data-i18n="accessTitle">Gateway issues key</strong><span data-i18n="accessDesc">Product scope and expiry derive from the purchased plan.</span></div></div>
      <div class="note" style="margin-top:16px"><span data-i18n="moneyNote">KOVA capabilities remain visible to federated agents. Payment confirmation itself uses authenticated service-to-service calls so capability consumption cannot recursively trigger billing.</span> <a href="/capabilities" data-i18n="moneyLink">See both paths and their security boundary →</a></div>
    </section>

    <section id="protection" class="section">
      <div class="eyebrow" data-i18n="ecoEyebrow">Agent protection · part of the AIMarket ecosystem</div><h2 data-i18n="ecoTitle">Three things an agent should be able to check.</h2>
      <div class="flow flow-3"><a class="flow-step" href="https://warden.modelmarket.dev/"><b data-i18n="ecoToolsLabel">01 · TOOLS</b><strong data-i18n="ecoToolsTitle">WARDEN</strong><span data-i18n="ecoToolsDesc">Screens an MCP server’s tools before an agent may call them: injection, exfiltration, hidden instructions.</span></a><a class="flow-step" href="https://histor.modelmarket.dev/"><b data-i18n="ecoClaimsLabel">02 · TOOL CLAIMS</b><strong data-i18n="ecoClaimsTitle">HISTOR</strong><span data-i18n="ecoClaimsDesc">A public, signed log of what MCP servers advertise, so a quiet change to a tool becomes visible.</span></a><a class="flow-step" href="/memory"><b data-i18n="ecoMemoryLabel">03 · MEMORY</b><strong data-i18n="ecoMemoryTitle">Attested Memory</strong><span data-i18n="ecoMemoryDesc">Identity, truth state and provenance on every memory, so an agent can check what it remembers.</span></a></div>
      <div class="note" style="margin-top:16px"><span data-i18n="ecoNote">Attested Memory is part of the open AIMarket ecosystem; its Hub federates with modelmarket.dev.</span> <a href="https://modelmarket.dev/" data-i18n="ecoLink">Open modelmarket.dev →</a></div>
    </section>

    <section id="pricing" class="section pricing-section">
      <div class="eyebrow" data-i18n="pricingEyebrow">Pricing · trials convert without interruption</div><h2 data-i18n="pricingTitle">Start without payment. Upgrade with exact USDC.</h2>
      <div class="grid pricing-grid">
        <article class="card pricing-card"><span class="tag" data-i18n="freeTag">free</span><h3 data-i18n="personalTrialTitle">Personal Trial</h3><p data-i18n="personalTrialPriceDesc">Seven days, one verified actor, no wallet transaction.</p><div class="price"><div><b>$0</b><small data-i18n="days7">7 days</small></div><button class="btn trial-open" data-product="personal" data-i18n="claim">Claim</button></div></article>
        <article class="card pricing-card"><span class="tag">personal</span><h3>Personal Pro</h3><p data-i18n="personalProDesc">One month of personal memory for you and your agents.</p><div class="price"><div><b>$12</b><small data-i18n="perMonth">per month</small></div><button class="btn buy" data-plan="personal.pro.monthly" data-i18n="buy">Buy</button></div></article>
        <article class="card pricing-card"><span class="tag">team</span><h3>Team Standard</h3><p data-i18n="teamStandardDesc">One month of shared, permissioned team memory.</p><div class="price"><div><b>$49</b><small data-i18n="perMonth">per month</small></div><button class="btn buy" data-plan="team.standard.monthly" data-i18n="buy">Buy</button></div></article>
        <article class="card pricing-card"><span class="tag">market</span><h3>Expert Pass</h3><p data-i18n="expertPassDesc">Seven days of access to paid expert memory.</p><div class="price"><div><b>$29</b><small data-i18n="pass7">7-day pass</small></div><button class="btn buy" data-plan="expert.pass.7d" data-i18n="buy">Buy</button></div></article>
      </div>
    </section>
  </main>
  <footer class="footer"><span>Attested Memory · PostgreSQL production profile</span><span><a href="/docs">Guides in 10 languages</a> · <a href="/use-cases">Use cases</a> · <a href="/use-cases#agent-memory-handoff">Agent memory handoff</a> · <a href="/billing">Billing</a></span></footer>

  <dialog id="trial-dialog"><div class="modal"><div class="modal-head"><div><div class="eyebrow" data-i18n="trialEyebrow">Free trial · actor-bound</div><h2 id="trial-title" data-i18n="trialStart">Start free</h2></div><button class="close" data-close="trial-dialog" aria-label="Close" data-i18n-aria="closeAria">×</button></div><p id="trial-description" data-i18n="trialDefaultDesc">Your browser creates a cryptographic actor identity. Its private signing key remains in this browser.</p><button class="btn" id="claim-trial" data-i18n="trialClaim">Create trial key</button><p class="notice" id="trial-status" role="status"></p><div class="checkout-box" id="trial-keybox" hidden><strong data-i18n="trialKeyLabel">Trial access key</strong><code id="trial-key"></code><div class="key-actions"><button class="btn alt copy-key" data-target="trial-key" data-i18n="copyKey">Copy key</button><a class="btn alt" href="/docs" data-i18n="setupGuide">Setup guide</a></div></div></div></dialog>

  <dialog id="checkout-dialog"><div class="modal"><div class="modal-head"><div><div class="eyebrow" data-i18n="checkoutEyebrow">Protected checkout · Base</div><h2 id="checkout-title" data-i18n="checkoutBuy">Buy access</h2></div><button class="close" data-close="checkout-dialog" aria-label="Close" data-i18n-aria="closeAria">×</button></div><form id="order-form"><div class="field-label"><label for="payer" data-i18n="payerLabel">Your public wallet address</label><button class="info-tip" type="button" aria-label="Why a public wallet address?" data-i18n-aria="payerHelpAria">?<span role="tooltip" data-i18n="payerHelp">Public address only. We never ask for a seed phrase or private key.</span></button></div><input id="payer" required pattern="0x[0-9a-fA-F]{40}" placeholder="0x…" autocomplete="off"><button class="btn" type="submit" data-i18n="createInvoice">Create exact USDC invoice</button></form><div id="payment" hidden><div class="checkout-box"><p><span data-i18n="sendExactly">Send exactly</span> <strong id="amount"></strong> <span data-i18n="usdcBaseTo">USDC on Base to:</span></p><code id="recipient"></code><div class="key-actions"><a id="wallet" class="btn alt" target="_blank" rel="noreferrer" data-i18n="openWallet">Open wallet</a><button class="btn alt copy-key" data-target="recipient" data-i18n="copyAddress">Copy address</button></div><p class="notice"><span data-i18n="kovaCheckoutNote">KOVA checks the canonical token, payer, recipient, exact amount and finality. Never send a private key.</span> <a href="/capabilities" data-i18n="whySeparate">Why KOVA is separate →</a></p></div><div class="field-label"><label for="tx" data-i18n="txLabel">Transaction hash</label><button class="info-tip" type="button" aria-label="What is a transaction hash?" data-i18n-aria="txHelpAria">?<span role="tooltip" data-i18n="txHelp">A public transaction identifier. It is not a wallet secret and does not prove payment until verified.</span></button></div><input id="tx" placeholder="0x…" autocomplete="off"><button class="btn" id="confirm" type="button" data-i18n="verifyPayment">Verify payment</button><p class="notice" id="payment-status" role="status"></p></div><div class="checkout-box" id="paid-keybox" hidden><strong data-i18n="accessReady">Access ready</strong><code id="paid-key"></code><p class="notice" data-i18n="keyRecoveryNote">Recovery through this checkout is available for 48 hours. Store the key in a password manager or secret vault; it is not persisted by this page.</p><div class="key-actions"><button class="btn copy-key" data-target="paid-key" data-i18n="copyKey">Copy key</button><a class="btn alt" href="/docs" data-i18n="setupGuide">Setup guide</a></div></div></div></dialog>

  <script src="/app.js?v=20261009a"></script>
  <script src="/attested-3d.js?v=20260908f"></script>
  <script src="/system-map.js?v=20260908o"></script>
  <script src="/actor.js?v=20260909f"></script>
  <script src="/checkout.js?v=20260909a"></script>
</body>
</html>

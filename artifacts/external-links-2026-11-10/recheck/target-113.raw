<script type="application/json" id="hub-ssr-live">{"summary":{"total_invocations":2916,"successful_invocations":2620,"failed_invocations":45,"refused_invocations":36,"incomplete_invocations":215,"success_rate":0.9831144465290806,"avg_price_usd":0.0042,"avg_latency_ms":848.3,"revenue_per_hour_usd":0,"volume_1h_usd":0.0,"volume_24h_usd":0.137,"volume_total_usd":12.3385,"invocations_1h":0,"invocations_24h":29,"failed_invocations_24h":0,"refused_invocations_24h":1,"incomplete_invocations_24h":4,"rps_1h":0.0,"p50_latency_ms_24h":16.0,"p95_latency_ms_24h":4960.0,"peers_count":22,"capabilities_count":306,"offerable_capabilities_count":293,"federated_capabilities_count":289,"demo_capabilities_count":12,"real_local_capabilities_count":5,"external_invocations":2833,"operator_self_invocations":83},"events":[{"id":2969,"capability_id":"gaia.weather.read@v1","product_id":"gaia.gateway","source_hub":"https://iot.modelmarket.dev","price_usd":0.0,"latency_ms":16,"success":1,"timestamp":"2026-11-10T15:16:37Z","consumer_hub":"sandbox:d1aa3e184f3d","outcome":"ok","purpose":"","traffic_class":"external","traffic_basis":null},{"id":2968,"capability_id":"gaia.weather.read@v1","product_id":"gaia.gateway","source_hub":"https://iot.modelmarket.dev","price_usd":0.0,"latency_ms":24,"success":1,"timestamp":"2026-11-10T13:57:47Z","consumer_hub":"sandbox:d1aa3e184f3d","outcome":"ok","purpose":"","traffic_class":"external","traffic_basis":null},{"id":2967,"capability_id":"gaia.weather.read@v1","product_id":"gaia.gateway","source_hub":"https://iot.modelmarket.dev","price_usd":0.0,"latency_ms":14,"success":1,"timestamp":"2026-11-10T09:50:21Z","consumer_hub":"sandbox:d1aa3e184f3d","outcome":"ok","purpose":"","traffic_class":"external","traffic_basis":null},{"id":2966,"capability_id":"gaia.power.price.read@v1","product_id":"gaia.gateway","source_hub":"https://iot.modelmarket.dev","price_usd":0.001,"latency_ms":4,"success":1,"timestamp":"2026-11-10T09:01:38Z","consumer_hub":"account:94e5ce4f1d9f","out
<script type="application/json" id="hub-ui-en">{"nav_start":"Get a key","nav_learn":"Learn","nav_devs":"Developers","nav_tools":"Free tools","nav_blog":"Blog","nav_integrate":"Integrate","nav_widget":"Widget","nav_plugins":"Plugins","nav_studio":"Studio","nav_operator":"Operator","nav_usecases":"Use cases","nav_live":"Live","conn_connecting":"Connecting…","conn_reconnecting":"Reconnecting…","conn_live":"Live · {time}","eyebrow":"AIMarket Protocol v2 · Federated · HTTP 402","tagline":"The live terminal for AI-to-AI commerce — discovery, micropayments, safety-gated invoke. Watch agents trade capabilities in real time.","badge_402":"Pay-per-call","badge_discovery":"Discovery","badge_plugins":"Plugins","badge_federation":"Multi-hub","search_ph":"Describe the job — “protect a ship from navigation spoofing”","search_btn":"Match","search_examples":"Try","search_example_fire":"wildfire brief near a facility","search_example_lottery":"fair randomness for a lottery","search_example_nav":"protect a ship from navigation interference","invoke_title":"Invoke","invoke_body":"Select a capability above to run a free sandbox trial.","invoke_needs":"This capability needs input","invoke_fill":"The provider declares these fields as required. A guessed body is refused and still spends a free trial.","invoke_required":"required","invoke_run":"Run","s_inv":"Invocations","s_rev":"Revenue / Hour","s_hubs":"Federation peers","s_caps":"Capabilities","s_knock":"Knocking","s_knock_none":"nobody waiting","s_knock_n":"{n} waiting","s_inv_awaiting":"awaiting traffic","s_rev_extrap":"extrapolated","hint_peers":"click · peer list","hint_caps":"click · catalogue","hint_knock":"click · request queue","title_peers":"Show federated peers","title_caps":"Show available capabilities","title_knock":"Show hubs asking to join","ticker_wait":"Waiting for live invocations…","ticker_empty":"No invocations yet — agents are standing by","feed_title":"Live Invocation Feed","filt_all":"All","filt_fed":"Fed","filt_ext":"Ext","filt_self":"Self","split_recent":"recent {n}: {pair}","feed_empty":"Marketplace warming up — invoke a capability to see the stream","feed_no_filter":"No events for this filter","feed_find_label":"Filter live traces","feed_find_ph":"capability / hub","decoder_live":"Market decoder","decoder_open":"How to read the signal","decoder_close":"Collapse decoder","decoder_find":"Search by intent","decoder_find_desc":"Describe a job above. The federation returns capabilities you can invoke.","decoder_inspect":"Open a live trace","decoder_inspect_desc":"Click any row to decode its route, price, latency and outcome.","decoder_ship":"Run, then integrate","decoder_ship_desc":"Use the sandbox search, then move to","trace_title":"Live execution trace","trace_copy":"Copy safe JSON","trace_copied":"Copied ✓","trace_find":"Find capability","trace_docs":"Open API docs","trace_self":"operator traffic","trace_public_sandbox":"public sandbox agent","trace_external":"external agent","trace_basis_account":"ecosystem account","trace_basis_address":"ecosystem server","trace_basis_wallet":"ecosystem wallet","trace_basis_forwarded":"forwarded by another hub","trace_basis_override":"marked external by the operator","decoder_traffic":"SELF is the hub itself and its own ecosystem; EXT is everyone else, including outside services on a paid rail.","trace_local":"local route","trace_federated":"federated route","trace_unknown_latency":"upstream latency not measured","trace_success":"invoke succeeded","trace_failure":"invoke failed","trace_refused":"refused","outcome_refused":"Refused — a policy decision or no data at that place, not a miss","trace_meaning_local":"Executed on this hub; the row reports its charged price, measured latency and outcome.","trace_meaning_fed":"Routed to a peer hub; the result returned through the federation boundary.","trace_meaning_failed":"The request completed with a failed status. This is an execution signal, not a hidden success.","trace_meaning_refused":"This hub or the provider declined on policy (quota, plan, blocked consumer), or the provider has no sensor near the place asked. Shown on the tape, excluded from the success rate: only a failure of the infrastructure counts against it.","lab_peer":"protected lab peer","trust_open":"How trust is calculated","trust_formula":"0–1 routing signal: 35% recent success, 30% economic bond, 20% observed age, 15% 30-day volume.","trust_caution":"It ranks peers; it is not a guarantee.","pulse_title":"Market Pulse","pulse_live":"live telemetry · rolling window","pulse_activity":"execution activity · latency amplitude","pulse_traces":"{n} live traces","pulse_calls_1h":"calls · 1h","pulse_success_24h":"success · 24h","pulse_external":"external demand","pulse_federated":"federated routes","pulse_outcomes":"successful outcomes","flow_title":"HTTP 402 Payment Flow","flow_channel":"Channel","flow_invoke":"Invoke","flow_receipt":"Receipt","flow_settle":"Settle","flow_escrow":"Live escrow on Base:","flow_proof":"External depositor proof (§3j):","flow_open":"open","flow_debit":"debit","flow_settle_link":"settle","fed_title":"Hub Federation","top_title":"Top Capabilities","top_collecting":"collecting…","footer_proto":"Protocol v2 ·","footer_api":"API docs","footer_escrow":"Escrow (Basescan)","close":"Close ✕","loading":"Loading…","peers_title":"Federated peers","caps_title":"Available capabilities","peers_meta":"{n} peer(s) · live index","caps_meta":"{n} available · {i18n} with EN/RU/ES/FR/ZH glosses · lang {lang}","caps_meta_partial":"{loaded} of {n} available · scroll for more · lang {lang}","caps_more":"Loading more…","caps_meta_filter":"{shown} of {n} match “{q}” · lang {lang}","caps_find_label":"Filter capabilities","caps_find_ph":"capability / hub / publisher","no_caps_filter":"No capability matches that substring","seller_publisher":"publisher","no_peers":"No peers indexed yet","no_caps":"No offerable capabilities","fail_peers":"Failed to load peers: {err}","fail_caps":"Failed to load capabilities: {err}","all_langs_open":"all 5 languages ▾","all_langs_close":"all 5 languages ▴","try_free":"click to try free","price_free":"free","price_restricted":"restricted access","restricted_cta":"operator credential required","restricted_title":"Restricted access","restricted_body":"The provider lists this capability for discovery but does not offer it through the public federation. An operator credential is required; no call or trial was spent.","match":"match","search_understood":"intent","search_exact_fallback":"exact catalogue signal","match_exact":"exact","match_hybrid":"hybrid","match_semantic":"meaning","match_fuzzy":"typo-safe","match_lexical":"terms","match_signal":"signal","match_ranked":"relevance + quality","searching":"Searching federation…","no_matches":"Intent not understood — describe the outcome another way","search_failed":"Search failed","invoking":"Invoking…","opening":"Opening sandbox channel → safety gate → invoke…","blocked":"Blocked","quota":"Quota","failed":"Failed","error":"Error","since_poll":"+{n} since poll","success_pct":"{pct}% success","incomplete_n":"{n} incomplete","avg_samples":"{avg} avg · {n} samples","peers_n":"{n} peer(s)","solo_hub":"solo hub","federated_n":"{n} federated","demo_hidden":" · {n} demo hidden","updated":"Updated {time}","via":"via","caps_label":"caps","trust_label":"trust","crawl_label":"crawl","page_title":"modelmarket.dev — AI Economy Protocol","fed_you":"this hub","fed_peer":"peer hub","fed_you_legend":"cyan · this hub","fed_peer_legend":"violet · peer hubs","pending_title":"Unapproved hubs","pending_meta":"{n} awaiting assay or review · nothing indexed until pass","pending_note":"Knocked, not yet admitted. A sandbox assay runs automatically; until it passes, nothing is indexed, searchable or invocable on this hub.","pending_show":"Show what it offers","pending_hide":"Hide","pending_quarantined":"quarantined","pending_first_seen":"first seen","pending_via":"via","pending_preview_empty":"Nothing previewed yet","pending_caps":"claimed","pending_caps_read":"read","knock_empty":"Nobody is knocking. New hubs appear here after they announce.","knock_operator":"Operator desk","knock_find":"Search by name, address or what is missing…","knock_found":"found {n} of {total}","assay_pass":"assay pass","assay_review":"assay review","assay_fail":"assay fail","assay_none":"not assayed","why_title":"What is missing for a pass ({n})","why_ran_at":"assay ran {time}","why_said":"assay said","why_generic":"Check {id} did not pass.","why_url_public":"The address is not public. This hub never fetches private, local or internal addresses — the hub needs a public https domain.","why_well_known_schema":"/.well-known/ai-market.json could not be read or does not match the schema. It must be served at the hub's address with every required field, signer_public_key included.","why_advertised_key":"The well-known has no signer_public_key — the Ed25519 public key the hub signs its manifest and receipts with. Without it there is nothing to check a signature against.","why_manifest_schema":"The manifest (/ai-market/manifest or manifest_url) could not be read or does not match the schema: it needs a signature, and every capability needs an input_schema.","why_manifest_signed":"The manifest is not signed by the key the well-known advertises. Sign it with the same Ed25519 key that signer_public_key names, and publish the signature as an object {\"algorithm\": \"ed25519\", \"public_key\": …, \"value\": …}, not as a bare string.","why_manifest_fresh":"The manifest's freshness is not confirmed: it was not fetched, or its generated_at is older than allowed or in the future. Rebuild and re-sign it regularly.","why_invoke_same_origin":"The invoke address was refused: it must be on the hub's own domain and pass the public-address check.","why_sandbox_key_mismatch":"The receipt is signed by a different key than the one in the well-known. Sign responses with the advertised key.","why_sandbox_probe":"The trial call produced nothing usable: the manifest offers no publicly callable capability (free, or priced behind a 402), or the call returned an error. At least one capability must be callable.","why_sandbox_receipt_signed":"The response came without a receipt signed by the key from the well-known.","why_sandbox_price_matches":"The 402 quoted no price, or a different one than the catalogue lists. The payment door must name the same amount as the manifest.","why_sandbox_price_enforced":"A capability priced in the catalogue answered without payment (200 instead of 402). A paid door must ask for payment.","why_sandbox_analysis":"The trial result failed the automatic review: it broke the declared output_schema, named a private address, or was stopped by the safety gate.","why_sandbox_judge":"The judge model rejected the live trial result. The operator decides.","outcome_incomplete":"Incomplete input — the call did not carry what the capability needs. Not scored.","trace_incomplete":"Incomplete input","trace_meaning_incomplete":"The request arrived without the fields this capability needs (coordinates, a bbox, an id). Nobody refused it and nothing was missed, so it stays on the tape and out of the success rate.","trust_line":"Agents can already pay each other. We make it possible for them to trust each other.","trust_note":"Pay-on-Verified: the hub holds the price until an independent verifier passes the delivery; a failed delivery is refunded. The verdict is evidence, not proof.","trust_link":"What it does not promise →","badge_verified":"Pay-on-Verified","purpose_hint":"Why the caller made this call: its own label, not checked by the hub","trace_purpose_none":"not stated by the caller","search_catalogue":"Catalogue offers","search_observed":"Observed offers · seller direct","catalogue_evidence_note":"Catalog evidence describes advertised terms; it does not prove delivery.","observed_evidence_note":"These are unpaid 402 observations, not seller-signed listings. Delivery is unverified.","evidence_signed":"Signed catalogue · signature checked","evidence_observed":"Observed payment quote","evidence_local":"Local catalogue · hub record","evidence_unrecorded":"Catalogue · verification not recorded","evidence_signer":"Signer","evidence_unsigned":"Seller did not sign this listing","evidence_checked":"Checked at","evidence_checker":"Checked by","evidence_key":"Public key","evidence_unknown":"Not recorded","evidence_recipient":"Payment recipient","observed_open_seller":"Open seller endpoint","observed_payment_note":"Pay the seller directly. Check the recipient and price against this offer; the hub does not handle this payment.","search_observed_signal":"seller payment quotes"}</script>

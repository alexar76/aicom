}]}],&quot;capabilities&quot;:[0,{&quot;streaming&quot;:[0,false],&quot;pushNotifications&quot;:[0,true],&quot;stateTransitionHistory&quot;:[0,false],&quot;extensions&quot;:[1,[[0,{&quot;uri&quot;:[0,&quot;https://github.com/google-agentic-commerce/a2a-x402/blob/main/spec/v0.2&quot;],&quot;required&quot;:[0,false],&quot;description&quot;:[0,&quot;x402 payments on marketplace-invoke (standalone flow). Profile deviation: this hub verifies the transfer on chain and never settles, so x402.payment.payload must carry the settle txHash of a USDC transfer to the payTo it quoted.&quot;]}]]]}],&quot;defaultInputModes&quot;:[1,[[0,&quot;text/plain&quot;],[0,&quot;application/json&quot;]]],&quot;defaultOutputModes&quot;:[1,[[0,&quot;text/plain&quot;],[0,&quot;application/json&quot;]]],&quot;skills&quot;:[1,[[0,{&quot;id&quot;:[0,&quot;marketplace-search&quot;],&quot;name&quot;:[0,&quot;Search the AI capability market&quot;],&quot;description&quot;:[0,&quot;Find executable offers by natural-language intent and optional budget, latency, trust, hub and category filters.&quot;],&quot;tags&quot;:[1,[[0,&quot;ai-marketplace&quot;],[0,&quot;capability-discovery&quot;],[0,&quot;agent-tools&quot;],[0,&quot;pricing&quot;]]],&quot;examples&quot;:[1,[[0,&quot;Find a security audit capability under $0.10&quot;],[0,&quot;Найди проверяемый сервис памяти для AI-агента&quot;]]],&quot;inputModes&quot;:[1,[[0,&quot;text/plain&quot;],[0,&quot;application/json&quot;]]],&quot;outputModes&quot;:[1,[[0,&quot;text/plain&quot;],[0,&quot;application/json&quot;]]]}],[0,{&quot;id&quot;:[0,&quot;marketplace-invoke&quot;],&quot;name&quot;:[0,&quot;Buy and run a market capability&quot;],&quot;description&quot;:[0,&quot;Run one offer found by marketplace-search and return its result with a signed receipt, as a Task. Send a data part {\&quot;invoke\&quot;: {\&quot;product_id\&quot;, \&quot;capability_id\&quot;, \&quot;source_hub\&quot;, \&quot;input\&quot;, \&quot;max_price_usd\&quot;}}. Pay with a credit account (X-API-Key header), an owner&#39;s mandate (X-AIMarket-Mandate + X-AIMarket-Mandate-Proof headers; the invoke then goes in one raw application/json part holding the exact signed bytes) or x402 (a2a-x402 v0.2; the payload must include the settle txHash). The first few priced calls per caller are a free trial. A mandate may require its owner&#39;s approval above a threshold: the task then waits in TASK_STATE_AUTH_REQUIRED until the owner answers.&quot;],&quot;tags&quot;:[1,[[0,&quot;ai-marketplace&quot;],[0,&quot;paid-invoke&quot;],[0,&quot;x402&quot;],[0,&quot;receipts&quot;],[0,&quot;agent-mandates&quot;]]],&quot;examples&quot;:[1,[[0,&quot;{\&quot;invoke\&quot;: {\&quot;product_id\&quot;: \&quot;gaia.gateway\&quot;, \&quot;capability_id\&quot;: \&quot;gaia.weather.read@v1\&quot;, \&quot;source_hub\&quot;: \&quot;local\&quot;, \&quot;input\&quot;: {\&quot;device_id\&quot;: \&quot;om-wx-01\&quot;}, \&quot;max_price_usd\&quot;: 0.01}}&quot;]]],&quot;inputModes&quot;:[1,[[0,&quot;application/json&quot;]]],&quot;outputModes&quot;:[1,[[0,&quot;application/json&quot;],[0,&quot;text/plain&quot;]]]}]]],&quot;conformance&quot;:[0,true],&quot;conformance_errors&quot;:[0,null],&quot;homepage&quot;:[0,null],&quot;repository&quot;:[0,null],&quot;license&quot;:[0,null],&quot;pricing&quot;:[0,null],&quot;contact&quot;:[0,null],&quot;id&quot;:[0,&quot;841eea85-51d4-450c-b35a-086534dc08f6&quot;],&quot;created_at&quot;:[0,&quot;2026-10-23T00:05:33.948547Z&quot;],&quot;updated_at&quot;:[0,&quot;2026-11-10T17:47:42.643430Z&quot;],&quot;hidden&quot;:[0,false],&quot;flag_count&quot;:[0,0],&quot;maintainer_notes&quot;:[0,&quot;Verified working at registration. Agent responds to `message/send` correctly via the A2A SDK.&quot;],&quot;category&quot;:[0,&quot;agent-directories&quot;],&quot;category_secondary&quot;:[0,null],&quot;uptime_percentage&quot;:[0,100],&quot;avg_response_time_ms&quot;:[0,1181],&quot;last_health_check&quot;:[0,&quot;2026-11-10T17:47:42.441796Z&quot;],&quot;is_health
bsite\",\"og:type\",\"og:image:width\",\"og:image:height\",\"og:image\",\"og:description\",\"og:title\",\"href\",\"rel\",\"canonical\",\"tagName\",\"link\",\"Live weather and air quality (GAIA) - MCP Connector | Glama\",\"endedAt\",\"status\",\"pending\",{\"_465\":488,\"_467\":61,\"_121\":489,\"_137\":490,\"_470\":491,\"_472\":77,\"_150\":492,\"_64\":493,\"_475\":476},{\"_465\":481,\"_467\":61,\"_121\":482,\"_137\":483,\"_470\":484,\"_472\":77,\"_150\":485,\"_64\":486,\"_475\":487},{\"_465\":466,\"_467\":61,\"_121\":468,\"_137\":469,\"_470\":471,\"_472\":77,\"_150\":473,\"_64\":474,\"_475\":476},\"annotations\",{\"_477\":25,\"_478\":61,\"_479\":61,\"_480\":61},\"available\",\"Current weather at a place: temperature (°C), humidity (%), pressure (hPa) and wind (m/s) from the nearest live Open-Meteo relay within 75 km, with a signed receipt. Send latitude and longitude, or a city.\",\"weather_now\",\"scoringInputHash\",\"8a8cb1215b789799\",\"tier\",\"Current weather\",\"mxo48qxiw1\",\"schemaSummary\",\"Inputs: city, latitude, longitude.\",\"destructiveHint\",\"idempotentHint\",\"openWorldHint\",\"readOnlyHint\",{\"_477\":25,\"_478\":61,\"_479\":61,\"_480\":61},\"The nearest live public sensors to a point, one per layer asked for (weather, air, radiation, quake …), each with its reading, distance and source, and a signed receipt.\",\"nearby_sensors\",\"9478359d58d0d506\",\"Nearest live sensors\",\"yxc3blh3o8\",\"Inputs: latitude (required), longitude (required), layers, max_km.\",{\"_477\":25,\"_478\":61,\"_479\":61,\"_480\":61},\"Current air quality at a place: PM2.5 and PM10 (µg/m³), US and European AQI, from Copernicus CAMS via Open-Meteo, with a signed receipt. Send latitude and longitude, or a city.\",\"air_quality_now\",\"03b01bccf3e557e3\",\"Current air quality\",\"f288nk8if5\",\"challengeToken\",\"domains\",[502],\"endpoint\",{\"_500\":501,\"_155\":156},\"githubNamespaceLogin\",\"httpUrl\",\"https://modelmarket.dev/tools/mcp/weather/.well-known/glama.json\",{\"_
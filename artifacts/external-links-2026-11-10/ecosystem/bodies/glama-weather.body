,\"_87\":88,\"_89\":77,\"_90\":91,\"_92\":93,\"_94\":93,\"_95\":73},\"sponsoredCard\",{\"_54\":55,\"_56\":57,\"_58\":59,\"_60\":61,\"_62\":63,\"_64\":65,\"_66\":67,\"_68\":69},\"uptime\",{\"_51\":52,\"_53\":52},\"userProfilesByRemoteServer\",{},\"versions\",[],\"healthyCount\",23,\"testCount\",\"advertiserName\",\"Rayrun\",\"body\",\"Rayrun runs every MCP server behind one URL and holds the credentials. Each call is decided per client, tool, and argument, then recorded.\",\"destinationUrl\",\"https://ray.run/\",\"hasLogo\",true,\"headline\",\"One endpoint for every MCP tool\",\"uid\",\"d7xb9hma2u\",\"updatedAt\",\"2026-09-13T06:37:02.893477Z\",\"deliveryToken\",\"-evV2drE3BnzDFcE.XLueN7lToDg0OsDC1NiNwWuJua9D8dyh2S_wYpqVXHdmC1G6_DLXOOifTczXv9QqcqS-PhloNgf-VejYeSuXIIfR3I6NuGnLSoh5yjPyoBLtoZMdiXgzQ1Wb00R4OQtbjf_NEg0LV3o7MuBKDd9KSLCy6r35gx-upuG2XG6RA6ST6WUvlp1gUjD8Pig9s22lxwuzQfGpI94W772JLeh9XeO7zGBMzu5kku6bb-m_HdzMfId_eNXwJqMnZAyp31QhghLyuPwKV0kEdnb3avUKx7Q8dfDlHLpzZerL5gGUVjhYG9q-sVAlAaysg64AFUh0YJq16I8Yol-YPN3CptruOukDMbNqpSZ3IaoIWLxIeyWehlRaJDLU4kZQpoTq-9waZrdoG9DKt89Vk-4.4UdBWLaDEMC_I76ZtYQc0w\",\"coherenceJustifications\",{\"_78\":96,\"_82\":97,\"_98\":99,\"_100\":101},\"coherenceScore\",4,\"coherenceSummary\",\"A small, focused live-conditions server with three largely distinct tools covering current weather, air quality, and nearby sensor lookup. Naming is mostly consistent and the surface fits its scope, with only mild overlap between nearby_sensors and the two dedicated measurement tools.\",\"coherenceTier\",\"A\",\"completeness\",\"descriptionQualityScore\",3.7,\"descriptionQualityTier\",\"disambiguation\",\"meanTdqs\",\"minTdqs\",3.6,\"namingConsistency\",\"overallScore\",3.8,\"overallTier\",\"scoredAt\",\"2026-10-20T11:40:30.678894Z\",\"scoredToolCount\",3,\"toolCount\",\"toolCountAppropriateness\",{\"_102\":107,\"_104\":73},{\"_102\":106,\"_104\":73},\"naming_consistency\",{\"_102\":105,\"_104\":73},\"tool_count_appropriateness\",{\"_102\":103,\"_104\":73},\"justification\",\"Three tools is a tight but reasonable scope for a live weather and air-quality service. Each tool covers a distinct measurement need, though the surface is on the lean side with no forecasting or historical option.\",\"score\",\"air_quality_now and weather_now follow a consistent noun_now pattern, but nearby_sensors deviates from that convention. The deviation is minor and the name is still self-explanatory, so it is mostly consistent.\",\"weather_now and air_quality_now target clearly distinct measurements, so they are easy to tell apart. nearby_sensors partially overlaps with both since it can return weather or air readings per layer, creating mild ambiguity about when to use it versus the dedicated tools.\",\"The current/live domain is well covered: current weather, current air quality, and nearest sensors across layers. Forecasts and historical data are absent, but the server's stated purpose is live conditions, so the gap is minor.\",\"apiKeyHeaderName\",\"X-API-Key\",\"apiKeyLocation\",\"bearer_authentication\",\"apiKeySearchParameterName\",\"api_key\",\"authType\",\"none\",\"categoryAttributes\",[165,166,167],\"claimable\",\"deprecatedAt\",\"deprecationComment\",\"description\",\"Weather, air quality and nearest live sensors anywhere, each with a signed receipt. Free, no key.\",\"githubRepository\",{\"_159\":160,\"_161\":162,\"_163\":164},\"glamaMetadataIsSourceOfTruth\",\"healthy\",\"id\",8195018,\"isRegistryLinked\",\"isVerified\",\"lastTestedAt\",\"2026-11-10T17:22:41.199466Z\",\"lastVerifiedProtocolVersion\",\"2025-11-25\",\"linkedMcpServer\",\"mcpServerId\",\"name\",\"dev.modelmarket/weather\",\"namespace\",\"dev.modelmarket\",\"oauthRegistration\",{\"_157\":-5,\"_158\":-5},\"recentToolCallCount\",\"replacementConnector\",\"slug\",\"weather\",\"testMcpConnectionProfileId\",112293,\"thumbnailUpdatedAt\",\"title\",\"Live weather and air quality (GAIA)\",\"transportType\",\"Streamable HTTP\",\"e5blltydqi\",\"url\",\"https://modelmarket.
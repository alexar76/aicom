<!-- -->
<p align="center">
  <a href="https://github.com/alexar76/aimarket-plugins/actions/workflows/ci.yml" target="_blank" rel="noopener noreferrer nofollow"><img loading="lazy" src="https://github.com/alexar76/aimarket-plugins/actions/workflows/ci.yml/badge.svg" alt="CI"/></a>

import("/assets/entry.client-vgQx_Go7.js");</script><!--$--><script>window.__reactRouterContext.streamController.enqueue("[{\"_1\":2,\"_3\":-5,\"_4\":-5},\"loaderData\",{\"_5\":6,\"_7\":8},\"actionData\",\"errors\",\"root\",{\"_409\":410},\"routes/modules.$creator.$moduleId\",{\"_9\":10,\"_11\":12,\"_13\":14,\"_15\":16,\"_17\":18,\"_19\":20,\"_21\":-5,\"_22\":23,\"_24\":23},\"module\",{\"_15\":280,\"_281\":282,\"_283\":284,\"_285\":41,\"_286\":70,\"_287\":288,\"_289\":290,\"_291\":284,\"_292\":49,\"_293\":-5,\"_294\":-5,\"_295\":-5,\"_296\":297,\"_298\":60,\"_299\":300,\"_301\":302,\"_63\":303,\"_304\":305,\"_306\":307,\"_308\":23,\"_309\":-5,\"_310\":303,\"_311\":312,\"_313\":314,\"_315\":-5,\"_316\":-5,\"_317\":-5,\"_318\":-5,\"_319\":320,\"_321\":322,\"_323\":324,\"_325\":326,\"_327\":328,\"_329\":-5,\"_330\":-5,\"_331\":-5,\"_332\":333,\"_334\":-5,\"_335\":60,\"_42\":43,\"_336\":337,\"_338\":339,\"_340\":341,\"_342\":343,\"_344\":345,\"_346\":347,\"_348\":349},\"apiUrl\",\"https://odel.app/api\",\"creator\",\"alexar76\",\"moduleId\",\"aimarket-plugins\",\"topics\",[272,273],\"similar\",{\"_25\":26,\"_13\":27},\"tools\",\"creatorPage\",true,\"creatorLinked\",\"topic\",[130,131,132,133,134,135,136,137,138],[28,29,30,31,32,33,34],{\"_15\":122,\"_36\":123,\"_38\":124,\"_13\":14,\"_40\":41,\"_42\":43,\"_44\":45,\"_46\":47,\"_48\":49,\"_50\":125,\"_52\":126,\"_54\":55,\"_56\":127,\"_58\":-5,\"_59\":60,\"_61\":62,\"_63\":128,\"_65\":129,\"_67\":68},{\"_15\":115,\"_36\":116,\"_38\":117,\"_13\":14,\"_40\":41,\"_42\":43,\"_44\":45,\"_46\":47,\"_48\":49,\"_50\":-5,\"_52\":118,\"_54\":81,\"_56\":119,\"_58\":-5,\"_59\":60,\"_61\":60,\"_63\":120,\"_65\":121,\"_67\":68},{\"_15\":106,\"_36\":107,\"_38\":108,\"_13\":14,\"_40\":41,\"_42\":43,\"_44\":45,\"_46\":47,\"_48\":49,\"_50\":-5,\"_52\":109,\"_54\":110,\"_56\":111,\"_58\":-5,\"_59\":60,\"_61\":60,\"_63\":112,\"_65\":113,\"_67\":68},{\"_15\":96,\"_36\":97,\"_38\":98,\"_13\":14,\"_40\":41,\"_42\":43,\"_44\":45,\"_46\":47,\"_48\":49,\"_50\":-5,\"_52\":99,\"_54\":81,\"_56\":100,\"_58\":-5,\"_59\":60,\"_61\":60,\"_63\":101,\"_65\":102,\"_67\":68},{\"_15\":87,\"_36\":88,\"_38\":89,\"_13\":14,\"_40\":41,\"_42\":43,\"_44\":45,\"_46\":47,\"_48\":49,\"_50\":90,\"_52\":91,\"_54\":81,\"_56\":92,\"_58\":-5,\"_59\":60,\"_61\":62,\"_63\":93,\"_65\":94,\"_67\":68},{\"_15\":77,\"_36\":78,\"_38\":79,\"_13\":14,\"_40\":41,\"_42\":43,\"_44\":45,\"_46\":47,\"_48\":49,\"_50\":-5,\"_52\":80,\"_54\":81,\"_56\":82,\"_58\":-5,\"_59\":60,\"_61\":60,\"_63\":83,\"_65\":84,\"_67\":68},{\"_15\":35,\"_36\":37,\"_38\":39,\"_13\":14,\"_40\":41,\"_42\":43,\"_44\":45,\"_46\":47,\"_48\":49,\"_50\":51,\"_52\":53,\"_54\":55,\"_56\":57,\"_58\":-5,\"_59\":60,\"_61\":62,\"_63\":64,\"_65\":66,\"_67\":68},\"@alexar76/argus3\",\"name\",\"ARGUS-3 MCP Server\",\"description\",\"ARGUS-3 stdio MCP with WARDEN firewall: argus_ask, argus_status, argus_capabilities.\",\"iconUrl\",\"external/1f3a4b791c56636d541efbf12d9cc8a725035bfa6173551bb681e882281f1375.jpg\",\"iconType\",\"image\",\"iconSize\",460,\"kind\",\"server\",\"hosting\",\"external\",\"provenance\",{\"_46\":76},\"safety\",{\"_46\":73,\"_74\":75},\"capability\",\"reads\",\"access\",{\"_69\":70,\"_71\":72},\"contents\",\"priceMicro\",0,\"stars\",1,\"updatedAt\",\"2026-11-06T21:35:23.000Z\",\"problems\",[],\"nsfw\",0.01,\"via\",\"local\",\"registry\",\"npm\",\"scored\",\"malicious\",0.1,\"publisher\",\"@alexar76/aimarket-oracle-gateway\",\"AIMarket Oracle Gateway\",\"Stdio MCP: 17 verifiable AIMarket oracles, 35 pay-per-call tools for AI agents.\",{\"_46\":73,\"_74\":86},\"high\",{\"_69\":70,\"_71\":85},\"2026-11-05T15:19:43.000Z\",[],\"pypi\",0.07,\"@alexar76/aimarket-mcp\",\"AIMarket MCP Gateway\",\"Stdio + HTTP MCP gateway: SSRF-hardened web_fetch, web_search, metis_verify, market_search.\",{\"_46\":76},{\"_46\":73,\"_74\":95},{\"_69\":70,\"_71\":85},\"2026-11-06T14:37:34.000Z\",[],0.08,\"@alexar76/aimarket-hub\",\"AIMarket — live agent marketplace\",\"Search and invoke real AI capabilities on modelmarket.dev. Free trial, then a prepaid key.\",{\"_46\":73,\"_74\":95},{\"_69\":103,\"_104\":105},\"2026-11-08T10:19:27.000Z\",[],\"remote\",\"auth\",\"none\",\"@alexar76/warden\",\"WARDEN — MCP Security Firewall\",\"MCP security firewall: stdio wrap proxy or inspection tools; zero runtime dependencies.\",{\"_46\":73,\"_74\":114},\"writes\",{\"_69\":70,\"_71\":72},\"2026-11-10T04:26:55.000Z\",[],0.04,\"@alexar76/attested-memory\",\"Attested Memory Market\",\"Attestable memory, truth, provenance. Hybrid Ed25519 + ML-DSA-65 receipts; USDC settlement on Base.\",{\"_46\":73,\"_74\":95},{\"_69\":103,\"_104\":105},\"2026-11-05T15:31:30.000Z\",[],\"@alexar76/histor\",\"HISTOR — MCP tool-definition transparency log\",\"Check, diff and history of MCP tool definitions, from a public signed log of 88k+ servers.\",{\"_46\":76},{\"_46\":73,\"_74\":114},{\"_69\":70,\"_71\":85},\"2026-11-05T04:15:24.000Z\",[],{\"_15\":257,\"_36\":258,\"_38\":259,\"_13\":260,\"_40\":261,\"_42\":43,\"_44\":45,\"_145\":262,\"_46\":47,\"_48\":49,\"_50\":-5,\"_52\":263,\"_54\":55,\"_56\":264,\"_58\":-5,\"_59\":60,\"_61\":265,\"_63\":266,\"_65\":267,\"_67\":68},{\"_15\":245,\"_36\":246,\"_38\":247,\"_13\":248,\"_40\":249,\"_42\":194,\"_145\":250,\"_46\":47,\"_48\":49,\"_50\":-5,\"_52\":251,\"_54\":55,\"_56\":252,\"_58\":-5,\"_59\":60,\"_61\":253,\"_63\":254,\"_65\":255,\"_67\":68},{\"_15\":231,\"_36\":232,\"_38\":233,\"_13\":234,\"_40\":235,\"_42\":43,\"_44\":236,\"_145\":237,\"_46\":47,\"_48\":49,\"_50\":238,\"_52\":239,\"_54\":55,\"_56\":240,\"_58\":-5,\"_59\":60,\"_61\":241,\"_63\":242,\"_65\":243,\"_67\":68},{\"_15\":216,\"_36\":217,\"_38\":218,\"_13\":219,\"_40\":220,\"_42\":43,\"_44\":221,\"_145\":222,\"_46\":47,\"_48\":49,\"_50\":-5,\"_52\":223,\"_54\":55,\"_56\":224,\"_58\":-5,\"_59\":60,\"_61\":225,\"_63\":226,\"_65\":227,\"_67\":68},{\"_15\":205,\"_36\":206,\"_38\":207,\"_13\":208,\"_40\":209,\"_42\":43,\"_44\":45,\"_46\":47,\"_48\":49,\"_50\":-5,\"_52\":210,\"_54\":55,\"_56\":211,\"_58\":-5,\"_59\":60,\"_61\":212,\"_63\":213,\"_65\":214,\"_67\":68},{\"_15\":189,\"_36\":190,\"_38\":191,\"_13\":192,\"_40\":193,\"_42\":194,\"_145\":195,\"_46\":47,\"_48\":49,\"_50\":-5,\"_52\":196,\"_54\":81,\"_56\":197,\"_58\":-5,\"_59\":60,\"_61\":198,\"_63\":199,\"_65\":200,\"_67\":68},{\"_15\":175,\"_36\":176,\"_38\":177,\"_13\":178,\"_40\":179,\"_42\":43,\"_44\":174,\"_145\":180,\"_46\":47,\"_48\":49,\"_50\":-5,\"_52\":181,\"_54\":55,\"_56\":182,\"_58\":-5,\"_59\":60,\"_61\":183,\"_63\":184,\"_65\":185,\"_67\":68},{\"_15\":160,\"_36\":161,\"_38\":162,\"_13\":163,\"_40\":164,\"_42\":43,\"_44\":45,\"_145\":165,\"_46\":47,\"_48\":49,\"_50\":166,\"_52\":167,\"_54\":110,\"_56\":168,\"_58\":-5,\"_59\":60,\"_61\":169,\"_63\":170,\"_65\":171,\"_67\":68},{\"_15\":139,\"_36\":140,\"_38\":141,\"_13\":142,\"_40\":143,\"_42\":43,\"_44\":144,\"_145\":146,\"_46\":47,\"_48\":49,\"_50\":-5,\"_52\":147,\"_54\":81,\"_56\":148,\"_58\":-5,\"_59\":60,\"_61\":149,\"_63\":150,\"_65\":151,\"_67\":152},\"@mutonby/openshorts\",\"OpenShorts\",\"Turn long videos into viral vertical shorts and publish them to TikTok, Instagram and YouTube.\",\"mutonby\",\"external/4744e14fd09c804ebd97540b1fb8eb63dd11cd43a1afce05d021f0822992df48.png\",96,\"banner\",{\"_154\":155,\"_156\":157,\"_158\":159},{\"_46\":73,\"_74\":95},{\"_69\":103,\"_104\":153},7552,\"2026-11-07T19:48:52.000Z\",[],0.02,\"oauth\",\"url\",\"external/banner/51ef79c1e3e65fc02edfe0c570fe8e2a7d7e7f496e81a8b391dd683077c2bc1a.jpg\",\"width\",1280,\"height\",720,\"@usekaneo/kaneo\",\"Kaneo\",\"Official MCP server for Kaneo: manage tasks, projects, and labels from Claude and other MCP clients\",\"usekaneo\",\"external/ba0e41d7a159f8b111d8d026de24b987a3d4196a9f9c1f042d7976cc962bcd5d.png\",{\"_154\":172,\"_156\":173,\"_158\":174},{\"_46\":76},{\"_46\":73,\"_74\":114},{\"_69\":70,\"_71\":72},9755,\"2026-11-09T00:31:26.000Z\",[],\"external/banner/7be437e7d5a6e9edf8b269dc918dc04bd35079ee35a78a665495673343097daf.png\",976,512,\"@elie222/inbox-zero\",\"Inbox Zero\",\"Search Gmail and Outlook, save drafts, manage email rules, and view email stats.\",\"elie222\",\"external/11f6912ccb216e04f1dac6c8eabf28e1f29e4c7fc7c76b331a88b5baa66a1582.png\",{\"_154\":186,\"_156\":187,\"_158\":188},{\"_46\":73,\"_74\":95},{\"_69\":103,\"_104\":153},12894,\"2026-11-02T22:49:02.000Z\",[],\"external/banner/279756413568284ae3328baf025e029bb3ca2ff4ef8aa9b5c4c70be82bc8e6fe.jpg\",1200,630,\"@coder/coder\",\"Coder\",\"Manage Coder workspaces, templates, and cloud development environments\",\"coder\",\"external/e8a8aa752df0797f57afd2ab270024800b0bcdd09c587662994555c8e145a652.svg\",\"svg\",{\"_154\":203,\"_156\":157,\"_158\":204},{\"_46\":73,\"_74\":202},{\"_69\":70,\"_71\":201},17263,\"2026-11-04T05:15:35.000Z\",[],\"a package registry\",0.03,\"external/banner/272eb27c9ea66db5ecad2d4fe6c97264385adbfd6d6da90fa69ffe5e862d1b47.png\",640,\"@modelscope/funasr-mcp\",\"FunASR\",\"Transcribe local audio with FunASR and SenseVoice using private, on-device inference.\",\"modelscope\",\"external/e05276901d7ce134fa0f914f5f9f3fb7eff2224dfa0d0edc3b8d71b9f84d587c.png\",{\"_46\":73,\"_74\":202},{\"_69\":70,\"_71\":215},20927,\"2026-11-04T04:27:43.000Z\",[],\"oci\",\"@changedetection/mcp\",\"changedetection.io (official)\",\"Official changedetection.io MCP: web page change tracking, back-in-stock and price alerts.\",\"changedetection\",\"external/995469ed86e52ae0d2ede52d7e52f325a3a79724d617842af6a08d3fabcc4892.png\",256,{\"_154\":228,\"_156\":229,\"_158\":230},{\"_46\":73,\"_74\":202},{\"_69\":70,\"_71\":201},35571,\"2026-11-06T00:23:24.000Z\",[],\"external/banner/d5c169758f07364766d5f3966244ba0de3c1d25105865c98e91b0c8f8002a19e.png\",1148,571,\"@puter/mcp-server\",\"Puter MCP\",\"Puter MCP enables AI tools to interact with Puter: manage files, websites, workers, and more\",\"puter\",\"external/e2f9bf2f90a0c2a46587fa9703cf9898df38f9d38b32815c8531837b18f84bf8.png\",192,{\"_154\":244,\"_156\":157,\"_158\":204},{\"_46\":76},{\"_46\":73,\"_74\":86},{\"_69\":103,\"_104\":153},44069,\"2026-11-03T03:59:03.000Z\",[],\"external/banner/43627ea921fae80f36366870d796be71e659f897fb4301b752a71d61bcd2dccb.png\",\"@amruthpillai/reactive-resume\",\"Reactive Resume\",\"Free open-source resume builder with remote MCP tools for resumes and job applications.\",\"amruthpillai\",\"external/0fcdd5c3b49f5a54aaca24dba691d1ee50a927389fc28c1d531a584ec05a9bb5.svg\",{\"_154\":256,\"_156\":157,\"_158\":159},{\"_46\":73,\"_74\":114},{\"_69\":103,\"_104\":153},45299,\"2026-11-04T04:27:08.000Z\",[],\"external/banner/d2ae44e4c3a24f9654d03c662799af7072d87d2aa2775152efe62cbf2da21b7d.webp\",\"@netdata/mcp-server\",\"Netdata\",\"Real-time infrastructure monitoring with metrics, logs, alerts, and ML-based anomaly detection.\",\"netdata\",\"external/e698cb6f3b87cb7d60da39463db1beb853659fc3e3ae699ed5a12632e2e32e69.png\",{\"_154\":270,\"_156\":157,\"_158\":271},{\"_46\":73,\"_74\":269},{\"_69\":103,\"_104\":268},81279,\"2026-11-05T05:04:21.000Z\",[],\"key\",0.05,\"external/banner/b1593b14bea7300b9efa24203c8811dfa105afac205047c4339c3cbcc3419f21.webp\",725,{\"_274\":278,\"_276\":279},{\"_274\":275,\"_276\":277},\"slug\",\"mcp-gateways-and-tool-hubs\",\"label\",\"MCP gateways \u0026 tool hubs\",\"self-hosting-and-homelab\",\"Self-hosting \u0026 homelab\",\"@alexar76/aimarket-plugins\",\"displayName\",\"AIMarket MCP Packager\",\"tagline\",\"Stdio MCP packager: AIMarket hub plugins into self-hosted MCP server products.\",\"iconKey\",\"category\",\"status\",\"published\",\"visibility\",\"public\",\"metaDescription\",\"deploymentType\",\"workerName\",\"bindingName\",\"mcpConfig\",\"pricingModel\",\"free\",\"priceCredits\",\"creatorUserId\",\"system:external-import\",\"createdAt\",1783484636000,1793950906000,\"sourceRegistry\",\"official-mcp-registry\",\"sourceUrl\",\"https://registry.modelcontextprotocol.io/v0/servers?search=io.github.alexar76%2Faimarket-plugins\",\"sourceVerified\",\"sourceMissingSince\",\"importedAt\",\"upstreamStars\",2,\"upstreamUpdatedAt\",1793892063000,\"detectedTransport\",\"detectedAuthType\",\"probeStatus\",\"lastProbedAt\",\"githubRepoUrl\",\"https://github.com/alexar76/aimarket-plugins\",\"githubRepoFullName\",\"alexar76/aimarket-plugins\",\"releaseId\",\"ext-alexar76-aimarket-plugins\",\"version\",\"2.1.3\",\"descriptionMarkdown\",\"# AIMarket Hub Plugins\\n\\n\u003c!-- mcp-name: io.github.alexar76/aimarket-plugins --\u003e\\n\\n\u003c!-- aicom-readme-badges --\u003e\\n\u003cp align=\\\"center\\\"\u003e\\n  \u003ca href=\\\"https://github.com/alexar76/aimarket-plugins/actions/workflows/ci.yml\\\"\u003e\u003cimg src=\\\"https://github.com/alexar76/aimarket-plugins/actions/workflows/ci.yml/badge.svg\\\" alt=\\\"CI\\\" /\u003e\u003c/a\u003e\\n  \u003ca href=\\\"https://glama.ai/mcp/servers/alexar76/aimarket-plugins\\\"\u003e\u003cimg src=\\\"https://glama.ai/mcp/servers/alexar76/aimarket-plugins/badges/score.svg\\\" alt=\\\"aimarket-plugins MCP server\\\" /\u003e\u003c/a\u003e\\n  \u003ca href=\\\"https://raw.githubusercontent.com/alexar76/aimarket-plugins/refs/heads/main/docs/badges/coverage.svg\\\"\u003e\u003cimg src=\\\"https://raw.githubusercontent.com/alexar76/aimarket-plugins/refs/heads/main/docs/badges/coverage.svg\\\" alt=\\\"Test coverage\\\" /\u003e\u003c/a\u003e\\n  \u003ca href=\\\"https://github.com/alexar76/aimarket-plugins/blob/main/LICENSE\\\"\u003e\u003cimg src=\\\"https://raw.githubusercontent.com/alexar76/aimarket-plugins/refs/heads/main/docs/badges/license.svg\\\" alt=\\\"License: MIT AND Apache-2.0\\\" /\u003e\u003c/a\u003e\\n\u003c/p\u003e\\n\u003c!-- /aicom-readme-badges --\u003e\\n\\n\u003c!-- aicom-mirror-notice --\u003e\\n\u003e 🔄 Synced from the [AI-Factory monorepo](https://github.com/alexar76/aicom) (append-only history). **Pull requests are welcome** — merged PRs are imported back and re-synced here. [Issues](https://github.com/alexar76/aimarket-plugins/issues) · [Pull requests](https://github.com/alexar76/aimarket-plugins/pulls)\\n\\n\\n\u003e **Ecosystem:** [AICOM overview \u0026 live demos](https://ecosystem.modelmarket.dev/) · **Community:** [Discord · Pollux](https://discord.gg/JjWxGhW9pP) · [Telegram · Castor](https://t.me/just_for_agents)\\n\\n**15 protocol plugins** extend hub invoke, settlement, compliance, and data planes without forking core.\\n\\n**Verifiable math** lives in the separate **[oracles](https://github.com/alexar76/oracles)** monorepo (Platon, Chronos, Murmuration, Lumen, …) — listed on the hub like any capability. **`aimarket-reputation`** scores sellers; **Lumen** oracle supplies PageRank/EigenTrust-style trust artifacts agents can invoke and audit.\\n\\n## Install\\n\\n**PyPI:** [`docs/install.md`](https://github.com/alexar76/aimarket-plugins/blob/main/plugins/docs/install.md). All 15 protocol plugins are published; the\\nHub's `plugins` extra installs the five core plugins.\\n\\n| Package | PyPI status |\\n|---------|-------------|\\n| `aimarket-hub` | Published; Python 3.11+ |\\n| `aimarket-tee`, `aimarket-channels`, `aimarket-reputation`, `aimarket-safety`, `aimarket-mcp-packager` | Published; included in `pip install \\\"aimarket-hub[plugins]\\\"` |\\n| `aimarket-zk` and the remaining protocol plugins | Published; install individually — see the install guide |\\n\\n**Docker:** all 15 plugins ship in the production hub image — `./scripts/deploy_hub.sh` from the factory monorepo.\\n\\n**Source:** `pip install -e plugins/aimarket-tee` after cloning this repo.\\n\\n## TEE Escrow\\n\\n**Smart-contract escrow in a Trusted Execution Environment** — buyer funds stay held until attested invoke succeeds; seller is paid only on proof; failures refund on-channel.\\n\\n| | |\\n|---|---|\\n| **What** | `aimarket-tee` + provenance + safety → hold → invoke → release/refund |\\n| **Why** | Micropay scale with **both-side protection** — no human escrow desk |\\n| **Deep dive** | [docs/killer-feature-tee-escrow.md](https://github.com/alexar76/aimarket-plugins/blob/main/plugins/docs/killer-feature-tee-escrow.md) · [Ecosystem capabilities](https://github.com/alexar76/aicom/blob/main/docs/killer-features.md) |\\n\\n## MCP server — `aimarket-mcp-packager`\\n\\nOne of the 15 plugins is a full **[Model Context Protocol](https://modelcontextprotocol.io) server** — stdio transport, built on the official MCP Python SDK. [`aimarket-mcp-packager`](https://github.com/alexar76/aimarket-plugins/blob/main/plugins/aimarket-mcp-packager/) turns any AIMarket capability into a self-hosted MCP product (Docker image, MCP manifest, and a ready `claude_desktop_config.json`) that runs in Claude Desktop, Cursor, Glama, or any stdio MCP client.\\n\\n| | |\\n|---|---|\\n| **Run** | `python plugins/aimarket-mcp-packager/mcp_stdio_server.py` (stdio) · `docker build` from repo root |\\n| **Tools** | `package_capability` · `generate_dockerfile` · `generate_claude_desktop_config` |\\n| **Registry** | Listed on Glama (score badge above) — see [`aimarket-mcp-packager/`](https://github.com/alexar76/aimarket-plugins/blob/main/plugins/aimarket-mcp-packager/) for the server, `glama.json`, and Dockerfile |\\n\\n## MCP server — `aimarket-oracle-gateway` (standalone repo)\\n\\nA **second MCP server** ships as its own satellite repo [`alexar76/aimarket-oracle-gateway`](https://github.com/alexar76/aimarket-oracle-gateway) for Glama indexing. [`aimarket-oracle-gateway`](https://github.com/alexar76/aimarket-plugins/blob/main/plugins/aimarket-oracle-gateway/) exposes Platon randomness, Chronos VDF, and LUMEN reputation as agent-callable tools — pay-per-call over AIMarket, every result independently verifiable.\\n\\n| | |\\n|---|---|\\n| **Run** | `pip install aimarket-oracle-gateway`, then `aimarket-oracle-gateway`; configure `AIMARKET_HUB_URL` and the selected result's `AIMARKET_SOURCE_HUB` for federated oracles — see its README |\\n| **Tools** | `get_random` · `compute_vdf` · `get_reputation_scores` · `list_oracle_capabilities` · … |\\n| **Registry** | [![aimarket-oracle-gateway MCP server](https://glama.ai/mcp/servers/alexar76/aimarket-oracle-gateway/badges/score.svg)](https://glama.ai/mcp/servers/alexar76/aimarket-oracle-gateway) — [`glama.json`](https://github.com/alexar76/aimarket-plugins/blob/main/plugins/aimarket-oracle-gateway/glama.json) + [`Dockerfile`](https://github.com/alexar76/aicom/blob/main/Dockerfile) |\\n\\n## Plugin index\\n\\n| Plugin | Role |\\n|--------|------|\\n| [aimarket-safety](https://github.com/alexar76/aimarket-plugins/blob/main/plugins/aimarket-safety/) | Pre-invoke policy, signed reject |\\n| [aimarket-tee](https://github.com/alexar76/aimarket-plugins/blob/main/plugins/aimarket-tee/) | TEE attestation, escrow hooks |\\n| [aimarket-provenance](https://github.com/alexar76/aimarket-hub/tree/main/plugins/aimarket-provenance/) | W3C VC invoke receipts |\\n| [aimarket-reputation](https://github.com/alexar76/aimarket-plugins/blob/main/plugins/aimarket-reputation/) | Scores + stake bonds |\\n| [aimarket-channels](https://github.com/alexar76/aimarket-plugins/blob/main/plugins/aimarket-channels/) | USDT channel lifecycle |\\n| [aimarket-auction](https://github.com/alexar76/aimarket-plugins/blob/main/plugins/aimarket-auction/) | Price discovery |\\n| [aimarket-orchestrator](https://github.com/alexar76/aimarket-plugins/blob/main/plugins/aimarket-orchestrator/) | Multi-capability plans |\\n| [aimarket-data-cap](https://github.com/alexar76/aimarket-plugins/blob/main/plugins/aimarket-data-cap/) | Data-capability packaging |\\n| [aimarket-dataset](https://github.com/alexar76/aimarket-plugins/blob/main/plugins/aimarket-dataset/) | Dataset listings |\\n| [aimarket-mcp-packager](https://github.com/alexar76/aimarket-plugins/blob/main/plugins/aimarket-mcp-packager/) | **MCP server** (stdio) — package capabilities as Docker + MCP manifest + Claude Desktop config |\\n| [aimarket-nft](https://github.com/alexar76/aimarket-plugins/blob/main/plugins/aimarket-nft/) | Capability NFTs |\\n| [aimarket-personas](https://github.com/alexar76/aimarket-plugins/blob/main/plugins/aimarket-personas/) | Seller personas |\\n| [aimarket-promo](https://github.com/alexar76/aimarket-plugins/blob/main/plugins/aimarket-promo/) | Promotions |\\n| [aimarket-streaming](https://github.com/alexar76/aimarket-plugins/blob/main/plugins/aimarket-streaming/) | Streaming invoke |\\n| [aimarket-zk](https://github.com/alexar76/aimarket-plugins/blob/main/plugins/aimarket-zk/) | ZK cohort proofs |\\n\\nHub loads plugins from [`aimarket-hub/plugins/`](https://github.com/alexar76/aimarket-hub/tree/main/plugins/) at runtime. Monorepo copies under `plugins/` are the source-of-truth for docs and tests.\\n\\n## Demo\\n\\n- **Live:** https://modelmarket.dev/plugins/demo\\n- **Docs:** https://github.com/alexar76/aimarket-plugins/blob/main/docs/install.md\\n\\n## Related repos\\n\\n| Repo | Role |\\n|------|------|\\n| [aimarket-hub](https://github.com/alexar76/aimarket-hub) | Loads plugins at invoke time |\\n| [oracles](https://github.com/alexar76/oracles) | Verifiable math capabilities (separate repo) |\\n| [aicom](https://github.com/alexar76/aicom) | AI-Factory monorepo |\\n| [dioscuri](https://github.com/alexar76/dioscuri) | Twin community agents — MNEMOSYNE Q\u0026A |\\n\\n## Community\\n\\nThe [DIOSCURI](https://github.com/alexar76/dioscuri) twins answer questions from synced GitHub docs.\\n\\n| Channel | Twin | Best for |\\n|---------|------|----------|\\n| [Discord](https://discord.gg/JjWxGhW9pP) | Pollux | Help, ideas, show-and-tell |\\n| [Telegram](https://t.me/just_for_agents) | Castor | Releases, digests, quick news |\\n\\n**Ecosystem map:** [Alien Monitor](https://monitor.modelmarket.dev/) · [AICOM](https://magic-ai-factory.com)\\n\",\"changelogMarkdown\",\"videoKey\",\"requiredSecretsJson\",\"publishedAt\",1793216846000,\"priceCents\",\"trialDays\",\"upstream\",{\"_17\":392,\"_358\":359,\"_393\":394,\"_395\":396,\"_387\":388,\"_362\":397},\"requiredSecrets\",[],\"tags\",[278,275],\"assets\",[],\"stats\",{\"_390\":60,\"_391\":60},\"card\",{\"_15\":280,\"_36\":282,\"_38\":284,\"_13\":14,\"_40\":41,\"_42\":43,\"_44\":45,\"_46\":47,\"_48\":49,\"_50\":-5,\"_52\":352,\"_54\":110,\"_56\":353,\"_58\":-5,\"_59\":60,\"_61\":312,\"_63\":354,\"_65\":355,\"_67\":68,\"_356\":357},\"claim\",{\"_350\":351,\"_274\":14},\"state\",\"open\",{\"_46\":73,\"_74\":86},{\"_69\":70,\"_71\":85},\"2026-11-05T15:21:03.000Z\",[],\"details\",{\"_325\":326,\"_358\":359,\"_360\":361,\"_362\":363,\"_364\":60,\"_365\":60,\"_301\":366,\"_367\":368,\"_369\":370},\"license\",\"MIT\",\"links\",[383,384,385],\"packages\",[378],\"forks\",\"openIssues\",\"2026-05-22T17:43:11Z\",\"assessment\",{\"_74\":86,\"_371\":372,\"_54\":373,\"_67\":68,\"_374\":375},\"domainMatch\",false,\"firstParty\",0.8,{\"_55\":60,\"_110\":376,\"_81\":377},\"assessedAt\",\"2026-11-06T07:06:12.003Z\",0.86,0.14,{\"_71\":85,\"_36\":379,\"_325\":380,\"_381\":382,\"_50\":370},\"aimarket-mcp-packager\",\"2.1.2\",\"weeklyDownloads\",310,{\"_46\":389,\"_386\":320},{\"_46\":387,\"_386\":388},{\"_46\":71,\"_386\":307},\"href\",\"homepage\",\"https://alexar76.github.io/aicom/\",\"repo\",\"ratingAvg\",\"reviewCount\",[401,402,403,404,405,406,407,52,408],\"language\",\"Python\",\"registryName\",\"io.github.alexar76/aimarket-plugins\",[398],{\"_399\":85,\"_400\":379,\"_325\":380},\"registryType\",\"identifier\",\"ai-agents\",\"aimarket\",\"channels\",\"escrow\",\"plugins\",\"python\",\"reputation\",\"tee\",\"ENV\",{\"_411\":412,\"_413\":414,\"_415\":416,\"_417\":-7},\"ENVIRONMENT\",\"production\",\"TURNSTILE_SITE_KEY\",\"0x4AAAAAAB8-rEI2gNDf_QhU\",\"SENTRY_DSN\",\"https://45fd1229f78089d5c3ee78be128030e1@o4510583261757440.ingest.de.sentry.io/4510584253448272\",\"SENTRY_ENABLE_LOCAL\"]\n");</script><!--$--><script>window.__reactRouterContext.streamController.close();</script><!--/$--><!--/$--><script type="module" src="https://static.cloudflareinsights.com/beacon.min.js/vce701823e78c4301a35b7e07294d87301792088814092" integrity="sha512-UKNk8GbxkABxKcXYuLkO16EleLGUkcvJWtpSNmExE0Too3ZaFAxTscNWEc1OdA
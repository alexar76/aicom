rrentColor" stroke-width="3.4" stroke-linecap="round" stroke-linejoin="round"></path><path d="M25 8 H30 V32 H25" stroke="currentColor" stroke-width="3.4" stroke-linecap="round" stroke-linejoin="round"></path><rect x="15" y="18.2" width="10" height="3.6" rx="1.6" fill="var(--color-accent)"></rect></svg><span class="font-mono text-[15px] tracking-tight text-[var(--color-ink)]">mcpindex<span class="text-[var(--color-mute)]">.ai</span></span></a><nav aria-label="Primary" class="hidden md:flex items-center gap-6 lg:gap-7"><a class="font-mono text-[12.5px] tracking-tight text-[var(--color-mute)] transition-colors hover:text-[var(--color-ink)] focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-[var(--color-accent)]" href="/scan">Scan</a><a class="font-mono text-[12.5px] tracking-tight text-[var(--color-mute)] transition-colors hover:text-[var(--color-ink)] focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-[var(--color-accent)]" href="/search">Search</a><a class="font-mono text-[12.5px] tracking-tight text-[var(--color-mute)] transition-colors hover:text-[var(--color-ink)] focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-[var(--color-accent)]" href="/docs">Docs</a><a class="font-mono text-[12px] uppercase tracking-[0.14em] text-white bg-[var(--color-accent-strong)] px-4 py-2 transition-colors hover:bg-[var(--color-accent-deep)] focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[var(--color-accent)]" href="/install">Install</a></nav><div class="flex items-center gap-2"><a href="https://github.com/mcpindex-ai" target="_blank" rel="noreferrer" aria-label="GitHub" class="inline-flex h-11 w-11 items-center justify-center text-[var(--color-mute)] hover:text-[var(--color-ink)] focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[var(--color-accent)]"><svg width="16" height="16" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true"><path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z"></path></svg></a><div class="md:hidden"><button type="button" aria-label="Open menu" aria-expanded="false" class="inline-flex h-11 w-11 items-center justify-center text-[var(--color-ink)] focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[var(--color-accent)]"><svg width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true"><line x1="2.5" y1="5" x2="15.5" y2="5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"></line><line x1="2.5" y1="9" x2="15.5" y2="9" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"></line><line x1="2.5" y1="13" x2="15.5" y2="13" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"></line></svg></button></div></div></div></div></header><main id="main-content" class="flex-1"><script type="application/ld+json">{"@context":"https://schema.org","@type":"SoftwareSourceCode","name":"AIMarket — live agent marketplace","alternateName":"io.github.alexar76/aimarket-hub","description":"Search and invoke real AI capabilities on modelmarket.dev. Free trial, then a prepaid key.","codeRepository":"https://github.com/alexar76/aimarket-hub","softwareVersion":"3.15.21","url":"https://mcpindex.ai/server/io-github-alexar76-aimarket-hub","sameAs":["https://github.com/alexar76/aimarket-hub"],"isBasedOn":"https://registry.modelcontextprotocol.io","citation":"https://mcpindex.ai/methodology","creativeWorkStatus":"Advisory listing; semantic-only screen, not a safety verdict.","subjectOf":{"@type":"CreativeWork","name":"Verdict corpus anchor (OpenTimestamps / Bitcoin)","identifier":"sha256:ed14cadc16e8088fa2452e24c6f72e945ec896b1be2ba900e2ab9b63b85aa8dc","url":"https://mcpindex.ai/trust#anchor","dateCreated":"2026-11-10T04:22:41.464063Z"}}</script><div class="site-container pt-12 pb-24"><a class="font-mono text-[11px] uppercase tracking-[0.18em] text-[var(--color-mute)] hover:text-[var(--color-accent-strong)]" href="/leaderboard">← Index</a><div class="mt-6 grid lg:grid-cols-[minmax(0,1fr)_320px] gap-10 lg:gap-16 items-start"><main class="min-w-0"><h1 class="t-page-h1 font-medium text-[var(--color-ink)]">AIMarket — live agent marketplace</h1><div class="mt-3 font-mono text-[12px] text-[var(--color-mute)] flex flex-wrap items-center gap-x-3 gap-y-1"><span>io.github.alexar76/aimarket-hub</span><span aria-hidden="true" class="inline-block w-px h-3 bg-[var(--color-rule)]"></span><span>v<!-- -->3.15.21</span><span aria-hidden="true" class="inline-block w-px h-3 bg-[var(--color-rule)]"></span><a class="text-[var(--color-cite)] hover:text-[var(--color-accent-strong)]" href="/best/search">Search</a></div><p class="mt-6 text-[17px] leading-[1.55] text-[var(--color-cite)]">Search and invoke real AI capabilities on modelmarket.dev. Free trial, then a prepaid key.</p><p class="mt-6 text-[14px] leading-[1.6] text-[var(--color-cite)]">The current version, v3.15.21, was published to the official MCP registry on 2026-10-07.<!-- --> <!-- -->It is distributed as a hosted remote over streamable-http, filed under Search by this index.<!-- --> Removals and unreachable sources are measured across every server this index tracks, contract drift across the servers that answer in consecutive snapshots;<!-- --> <a class="underline decoration-[var(--color-rule)] underline-offset-4 hover:text-[var(--color-accent-strong)]" href="/stats">the index&#x27;s current counts</a> <!-- -->put this record in context.</p><section class="mt-10 rule-t rule-b rule-l rule-r border-[var(--color-accent)] bg-[var(--color-accent-soft)] p-4 sm:p-5" aria-labelledby="gate-install-bridge-heading"><div class="font-mono text-[11px] uppercase tracking-[0.22em] text-[var(--color-accent-strong)] mb-2 flex items-center gap-2"><svg width="12" height="12" viewBox="0 0 40 40" fill="none" aria-hidden="true" class="shrink-0"><path d="M15 8 H10 V32 H15" stroke="currentColor" stroke-width="3.4" stroke-linecap="round" stroke-linejoin="round"></path><path d="M25 8 H30 V32 H25" stroke="currentColor" stroke-width="3.4" stroke-linecap="round" stroke-linejoin="round"></path><rect x="15" y="18.2" width="10" height="3.6" rx="1.6" fill="var(--color-accent)"></rect></svg>In-path gate · all MCP tools</div><h2 id="gate-install-bridge-heading" class="text-[16px] sm:text-[17px] font-medium tracking-tight text-[var(--color-ink)] leading-snug">Using <!-- -->AIMarket — live agent marketplace<!-- --> in Claude, Cursor, Gemini CLI, Cline, or Zed?</h2><p class="mt-2 text-[13.5px] leading-[1.55] text-[var(--color-cite)]">MCP tool contracts can change remotely with no version bump. The mcpindex gate pins each contract and <strong>HOLDs the call</strong> when it drifts-before your agent acts. Zero credentials. This is not the package install for this server itself (use <strong>Install this server</strong> for that).</p><div class="mt-4"><div class="mt-3 first:mt-0"><div class="font-mono text-[10.5px] uppercase tracking-[0.16em] text-[var(--color-cite)] mb-1.5">Install the mcpindex gate (one command)</div><p class="text-[12px] leading-[1.5] text-[var(--color-mute)] mb-2">Rewrites your MCP host config so each server launches behind the gate. Inspect first: curl -fsSL https://mcpindex.ai/install.sh | less</p><div class="relative"><pre class="bg-[var(--color-ink)] text-zinc-100 pl-4 pr-14 py-3 font-mono text-[12px] overflow-x-auto leading-snug"><code>uv tool install mcpindex-gate &amp;&amp; mcpindex-config-wire</code></pre><button type="button" aria-label="Copy to clipboard" class="absolute top-2 right-2 font-mono text-[10px] uppercase tracking-[0.12em] border px-1.5 py-0.5 transition-colors focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-1 focus-visible:outline-[var(--color-accent)] text-zinc-400 hover:text-white border-zinc-700 hover:border-zinc-500">copy</button></div></div></div><div class="mt-3 flex flex-wrap items-center gap-x-5 gap-y-2 font-mono text-[11.5px] uppercase tracking-[0.12em]"><a class="text-[var(--color-cite)] underline decoration-[var(--color-rule)] underline-offset-4 hover:text-[var(--color-accent-strong)]" href="/docs#install-the-gate">Auditable install path →</a><a class="text-[var(--color-mute)] hover:text-[var(--color-accent-strong)]" href="/#demo">Watch it hold a drift →</a></div></section><section class="mt-10"><div class="font-mono text-[11px] uppercase tracking-[0.22em] text-[var(--color-mute)] mb-4">Trust verdict · v1 advisory · <a class="hover:text-[var(--color-accent-strong)]" href="/methodology">method</a></div><div class="rule-t rule-b rule-l rule-r p-5 bg-white border border-amber-300"><div class="flex flex-wrap items-baseline gap-x-4 gap-y-1"><span class="font-mono text-[14px] uppercase tracking-[0.18em] px-2.5 py-1 bg-amber-50 text-amber-900 border border-amber-300">REVIEW</span><span class="font-mono text-[11px] uppercase tracking-[0.16em] text-[var(--color-mute)]">status: <!-- -->PARTIAL</span><span class="font-mono text-[11px] text-[var(--color-mute)]">fresh until <!-- -->2026-11-17 17:53 UTC</span></div><div class="mt-2 flex flex-wrap gap-x-4 gap-y-1 font-mono text-[10.5px] uppercase tracking-[0.14em] text-[var(--color-mute)]"><span>screened 2026-10-08</span><span>tier: scanned</span><span>granularity: description-level</span><span>source: registry</span></div><p class="mt-3 text-[14.5px] leading-[1.55] text-[var(--color-ink)]">Semantic screen found no manipulation pattern in the description. Conformance probe not yet run.</p><div class="mt-4 rule-t"><div class="rule-b py-2.5 px-1"><div class="row-3up-tight"><code class="font-mono text-[12px] text-[var(--color-cite)] truncate">mcpindex.integrity.description</code><span class="font-mono text-[11px] uppercase tracking-[0.14em] text-[var(--color-ink)]">pass</span><span class="font-mono text-[11px] uppercase tracking-[0.14em] text-[var(--color-mute)]">INFO</span></div><p class="mt-1.5 text-[12.5px] leading-[1.5] text-[var(--color-cite)]"><span class="font-mono text-[10px] uppercase tracking-[0.14em] text-[var(--color-mute)] mr-2">evidence</span>“<!-- -->Normal capability description<!-- -->”<span class="ml-2 font-mono text-[10px] text-[var(--color-mute)]">via <!-- -->static_description</span></p></div></div><div class="mt-4 rule-t pt-3"><div class="font-mono text-[10px] uppercase tracking-[0.16em] text-[var(--color-mute)] mb-2">Limits of this verdict</div><ul class="space-y-1"><li class="text-[12.5px] leading-[1.5] text-[var(--color-cite)]">- <!-- -->Semantic screen only - the deterministic conformance probe has not run on this server</li><li class="text-[12.5px] leading-[1.5] text-[var(--color-cite)]">- <!-- -->Confidence is reported but not yet calibrated (v1)</li><li class="text-[12.5px] leading-[1.5] text-[var(--color-cite)]">- <!-- -->Screen reads the tool description, not the live behavior</li><li class="text-[12.5px] leading-[1.5] text-[var(--color-cite)]">- <!-- -->advisory</li><li class="text-[12.5px] leading-[1.5] text-[var(--color-cite)]">- <!-- -->registry description only no input schema</li><li class="text-[12.5px] leading-[1.5] text-[var(--color-cite)]">- <!-- -->screen model 8b</li><li class="text-[12.5px] leading-[1.5] text-[var(--color-cite)]">- <!-- -->Still current: the description we screened is unchanged, re-checked against the registry</li></ul></div><p class="mt-4 font-mono text-[10.5px] leading-[1.55] text-[var(--color-mute)]">Semantic screen: an LLM judge reads the tool description for hidden instructions (status PARTIAL). A pass means the description is not lying, not that the tool is safe: a high-capability tool with an honest description still warrants caution. The deterministic conformance probe has not been run on this server yet, so the screen here is semantic-only. Posture: advisory. Confidences are reported but not yet calibrated (calibrated=false at v1). Full verdict history is not shown on this page.</p></div><p class="mt-3 font-mono text-[11px] text-[var(--color-mute)]">Own this server?<!-- --> <a class="underline decoration-[var(--color-rule)] underline-offset-4 hover:text-[var(--color-accent-strong)]" href="/screen">Test a description on the public screen →</a> <!-- -->It is a separate check from the verdict above, so the two can differ.</p></section><section class="mt-8 rule-t pt-6" aria-labelledby="verdict-cta-heading"><h2 id="verdict-cta-heading" class="text-[15px] font-medium tracking-tight text-[var(--color-ink)]">That verdict was true at screening time<!-- --> (snapshot 2026-11-10)<!-- -->.</h2><p class="mt-2 text-[13.5px] leading-[1.55] text-[var(--color-cite)] max-w-2xl">Contracts can change after screening, with no version bump. The gate pins<!-- --> <!-- -->AIMarket — live agent marketplace<!-- -->’s tool contracts on first sight and holds any silent change before your agent acts - the check that keeps being true on Tuesday.</p><p class="mt-3"><a class="font-mono text-[12px] uppercase tracking-[0.16em] text-[var(--color-ink)] border border-[var(--color-rule)] px-3 py-1.5 hover:border-[var(--color-accent)] hover:text-[var(--color-accent-strong)] transition-colors" href="/guides/install-the-gate-first-hold">See your first HOLD in 2 minutes →</a></p><p class="mt-4 text-[13px] leading-[1.55] text-[var(--color-mute)] max-w-2xl">Related:<!-- --> <a class="underline decoration-[var(--color-rule)] underline-offset-4 hover:text-[var(--color-accent-strong)]" href="/guides/how-to-trust-an-mcp-server">how to trust an MCP server</a> · <a class="underline decoration-[var(--color-rule)] underline-offset-4 hover:text-[var(--color-accent-strong)]" href="/guides/screen-mcp-server-before-install">screen before install</a> · <a class="underline decoration-[var(--color-rule)] underline-offset-4 hover:text-[var(--color-accent-strong)]" href="/guides/mcp-silent-contract-drift">silent contract drift</a></p></section><section class="mt-14"><div class="font-mono text-[11px] uppercase tracking-[0.22em] text-[var(--color-mute)] mb-4">Contract drift · crawler-observed · <a class="hover:text-[var(--color-accent-strong)]" href="/ledger">ledger</a></div><div class="rule-t rule-b rule-l rule-r p-5 bg-white"><div class="flex flex-wrap items-baseline gap-x-4 gap-y-1"><span class="font-mono text-[14px] uppercase tracking-[0.18em] px-2.5 py-1 bg-[var(--color-accent-soft)] text-[var(--color-cite)] border border-[var(--color-rule)] tabular-nums">1<!-- --> contract change<!-- --> observed</span><span class="font-mono text-[11px] text-[var(--color-mute)]">most recent <!-- -->Mon, 28 Sep 2026 04:00:00 GMT</span></div><p class="mt-3 text-[13px] leading-[1.55] text-[var(--color-cite)]">1 change with a version change<!-- -->.</p><div class="mt-3 flex flex-wrap items-baseline gap-2"><span class="font-mono text-[10px] uppercase tracking-[0.16em] text-[var(--color-mute)]">what changed</span><span title="added-optional-param" class="text-[11px] px-2 py-0.5 border border-[var(--color-rule)] text-[var(--color-cite)]">new optional input</span></div><div class="mt-5 pt-4 border-t border-[var(--color-rule)]"><div class="flex flex-wrap items-baseline gap-x-4 gap-y-1"><span class="font-mono text-[14px] uppercase tracking-[0.18em] px-2.5 py-1 bg-[var(--color-accent-soft)] text-[var(--color-cite)] border border-[var(--color-rule)] tabular-nums">injected context changed</span><span class="font-mono text-[11px] text-[var(--color-mute)]">most recent <!-- -->Fri, 09 Oct 2026 18:00:00 GMT</span><span class="font-mono text-[10.5px] uppercase tracking-[0.14em] px-2 py-0.5 border border-[var(--color-cite)] text-[var(--color-cite)]">safety-relevant diff</span></div><div class="mt-3 flex flex-wrap items-baseline gap-2"><span class="font-mono text-[10px] uppercase tracking-[0.16em] text-[var(--color-mute)]">what changed</span><span title="instructions-added" class="text-[11px] px-2 py-0.5 border border-[var(--color-rule)] text-[var(--color-cite)]">server now injects instructions into agent context</span><span title="instructions-changed" class="text-[11px] px-2 py-0.5 border border-[var(--color-rule)] text-[var(--color-cite)]">injected server instructions changed</span></div><p class="mt-3 text-[13px] leading-[1.55] text-[var(--color-cite)]">Server-scoped, not a tool: this is text the server supplies for clients to inject into an agent’s context on connect (instructions or prompt metadata). It sits outside every tool contract hash, so this observation is its only drift signal.</p></div><p class="mt-4 font-mono text-[10.5px] leading-[1.55] text-[var(--color-mute)]">Observed by mcpindex’s crawler between daily registry snapshots - a contract diff, not a safety verdict, and not an in-path prevention (that is the gate). A “safety-relevant diff” touches a safety-relevant field; it is not a confirmed vulnerability. Shown at the server level; individual tools are not named. Absence is not a clean bill of health: only public-registry servers are crawled.</p></div></section><section class="mt-14"><div class="font-mono text-[11px] uppercase tracking-[0.22em] text-[var(--color-mute)] mb-4">Cite this record</div><p class="text-[13px] leading-[1.55] text-[var(--color-cite)] mb-3">People vet a server before wiring it in. One line on your project site or docs answers that with an independent record: screening verdict, registry provenance, contract drift history. It stays current as new screens and drift events land.</p><div class="mt-3 first:mt-0"><div class="font-mono text-[10.5px] uppercase tracking-[0.16em] text-[var(--color-cite)] mb-1.5">Markdown</div><div class="relative"><pre class="bg-[var(--color-ink)] text-zinc-100 pl-4 pr-14 py-3 font-mono text-[12px] overflow-x-auto leading-snug"><code>[Independent trust record for AIMarket — live agent marketplace](https://mcpindex.ai/server/io-github-alexar76-aimarket-hub) - screening verdict, registry provenance, and contract drift monitoring.</code></pre><button type="button" aria-label="Copy to clipboard" class="absolute top-2 right-2 font-mono text-[10px] uppercase tracking-[0.12em] border px-1.5 py-0.5 transition-colors focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-1 focus-visible:outline-[var(--color-accent)] text-zinc-400 hover:text-white border-zinc-700 hover:border-zinc-500">copy</button></div></div><div class="mt-3 first:mt-0"><div class="font-mono text-[10.5px] uppercase tracking-[0.16em] text-[var(--color-cite)] mb-1.5">HTML</div><div class="relative"><pre class="bg-[var(--color-ink)] text-zinc-100 pl-4 pr-14 py-3 font-mono text-[12px] overflow-x-auto leading-snug"><code>&lt;a href=&quot;https://mcpindex.ai/server/io-github-alexar76-aimarket-hub&quot;&gt;Independent trust record for AIMarket — live agent marketplace&lt;/a&gt; - screening verdict, registry provenance, and contract drift monitoring.</code></pre><button type="button" aria-label="Copy to clipboard" class="absolute top-2 right-2 font-mono text-[10px] uppercase tracking-[0.12em] border px-1.5 py-0.5 transition-colors focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-1 focus-visible:outline-[var(--color-accent)] text-zinc-400 hover:text-white border-zinc-700 hover:border-zinc-500">copy</button></div></div></section><section class="mt-14"><div class="font-mono text-[11px] uppercase tracking-[0.22em] text-[var(--color-mute)] mb-4">Embed this badge</div><p class="text-[13px] leading-[1.55] text-[var(--color-cite)] mb-3">A live verdict badge for your README or listing. It reflects the current screen, links back here, and updates when the verdict does.</p><div class="mt-3 first:mt-0"><div class="font-mono text-[10.5px] uppercase tracking-[0.16em] text-[var(--color-cite)] mb-1.5">Markdown</div><div class="relative"><pre class="bg-[var(--color-ink)] text-zinc-100 pl-4 pr-14 py-3 font-mono text-[12px] overflow-x-auto leading-snug"><code>[![mcpindex](https://mcpindex.ai/api/v1/badge/io-github-alexar76-aimarket-hub)](https://mcpindex.ai/server/io-github-alexar76-aimarket-hub)</code></pre><button type="button" aria-label="Copy to clipboard" class="absolute top-2 right-2 font-mono text-[10px] uppercase tracking-[0.12em] border px-1.5 py-0.5 transition-colors focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-1 focus-visible:outline-[var(--color-accent)] text-zinc-400 hover:text-white border-zinc-700 hover:border-zinc-500">copy</button></div></div><div class="mt-3 first:mt-0"><div class="font-mono text-[10.5px] uppercase tracking-[0.16em] text-[var(--color-cite)] mb-1.5">HTML</div><div class="relative"><pre class="bg-[var(--color-ink)] text-zinc-100 pl-4 pr-14 py-3 font-mono text-[12px] overflow-x-auto leading-snug"><code>&lt;a href=&quot;https://mcpindex.ai/server/io-github-alexar76-aimarket-hub&quot;&gt;&lt;img src=&quot;https://mcpindex.ai/api/v1/badge/io-github-alexar76-aimarket-hub&quot; alt=&quot;mcpindex verdict&quot; height=&quot;20&quot; /&gt;&lt;/a&gt;</code></pre><button type="button" aria-label="Copy to clipboard" class="absolute top-2 right-2 font-mono text-[10px] uppercase tracking-[0.12em] border px-1.5 py-0.5 transition-colors focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-1 focus-visible:outline-[var(--color-accent)] text-zinc-400 hover:text-white border-zinc-700 hover:border-zinc-500">copy</button></div></div></section><section class="mt-14"><div class="font-mono text-[11px] uppercase tracking-[0.22em] text-[var(--color-mute)] mb-4">MCP quality score · maturity, not trust · <a class="hover:text-[var(--color-accent-strong)]" href="/methodology">methodology</a></div><div class="rule-t"><div class="rule-b row-2up-end py-3 px-2"><div class="font-mono text-[12px] text-[var(--color-cite)] capitalize">freshness</div><div class="text-right font-mono tabular-nums text-[14px] text-[var(--color-ink)]">25</div></div><div class="rule-b row-2up-end py-3 px-2"><div class="font-mono text-[12px] text-[var(--color-cite)] capitalize">completeness</div><div class="text-right font-mono tabular-nums text-[14px] text-[var(--color-ink)]">15</div></div><div class="rule-b row-2up-end py-3 px-2"><div class="font-mono text-[12px] text-[var(--color-cite)] capitalize">installability</div><div class="text-right font-mono tabular-nums text-[14px] text-[var(--color-ink)]">25</div></div><div class="rule-b row-2up-end py-3 px-2"><div class="font-mono text-[12px] text-[var(--color-cite)] capitalize">documentation</div><div class="text-right font-mono tabular-nums text-[14px] text-[var(--color-ink)]">15</div></div><div class="rule-b row-2up-end py-3 px-2"><div class="font-mono text-[12px] text-[var(--color-cite)] capitalize">stability</div><div class="text-right font-mono tabular-nums text-[14px] text-[var(--color-ink)]">10</div></div></div></section><section class="mt-14"><div class="font-mono text-[11px] uppercase tracking-[0.22em] text-[var(--color-mute)] mb-4">Alternatives in <!-- -->Search</div><div class="rule-t"><a class="block rule-b py-4 px-2 hover:bg-[var(--color-accent-soft)]/40 transition-colors group" href="/server/ai-ankra-docs"><div class="font-medium text-[15px] text-[var(--color-ink)] group-hover:text-[var(--color-accent-strong)]">Ankra Docs</div><div class="mt-0.5 font-mono text-[11px] text-[var(--color-mute)]">ai.ankra/docs</div><p class="mt-1.5 text-[13px] text-[var(--color-cite)] line-clamp-2">Search the Ankra documentation: clusters, stacks, GitOps, CI/CD and the CLI. No account needed.</p></a><a class="block rule-b py-4 px-2 hover:bg-[var(--color-accent-soft)]/40 transition-colors group" href="/server/ai-bumblebox-mail"><div class="font-medium text-[15px] text-[var(--color-ink)] group-hover:text-[var(--color-accent-strong)]">BumbleBox</div><div class="mt-0.5 font-mono text-[11px] text-[var(--color-mute)]">ai.bumblebox/mail</div><p class="mt-1.5 text-[13px] text-[var(--color-cite)] line-clamp-2">Search and triage all your mailboxes; draft replies and campaigns; send only as you allow.</p></a><a class="block rule-b py-4 px-2 hover:bg-[var(--color-accent-soft)]/40 transition-colors group" href="/server/io-github-alexar76-aimarket-mcp"><div class="font-medium text-[15px] text-[var(--color-ink)] group-hover:text-[var(--color-accent-strong)]">AIMarket MCP Gateway</div><div class="mt-0.5 font-mono text-[11px] text-[var(--color-mute)]">io.github.alexar76/aimarket-mcp</div><p class="mt-1.5 text-[13px] text-[var(--color-cite)] line-clamp-2">Stdio + HTTP MCP gateway: SSRF-hardened web_fetch, web_search, metis_verify, market_search.</p></a></div></section></main><aside class="lg:sticky lg:top-20 space-y-9"><div><div class="font-mono text-[10.5px] uppercase tracking-[0.18em] text-[var(--color-mute)] mb-3">Install this server</div><div class="mt-3 first:mt-0"><div class="font-mono text-[10.5px] uppercase tracking-[0.16em] text-[var(--color-cite)] mb-1.5">Remote endpoint</div><p class="text-[12px] leading-[1.5] text-[var(--color-mute)] mb-2">Streamable HTTP / SSE endpoint. Add to any MCP client that supports remote servers.</p><div class="relative"><pre class="bg-[var(--color-ink)] text-zinc-100 pl-4 pr-14 py-3 font-mono text-[12px] overflow-x-auto leading-snug"><code>https://modelmarket.dev/mcp</code></pre><button type="button" aria-label="Copy to clipboard" class="absolute top-2 right-2 font-mono text-[10px] uppercase tracking-[0.12em] border px-1.5 py-0.5 transition-colors focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-1 focus-visible:outline-[var(--color-accent)] text-zinc-400 hover:text-white border-zinc-700 hover:border-zinc-500">copy</button></div></div></div><div><div class="font-mono text-[10.5px] uppercase tracking-[0.18em] text-[var(--color-mute)] mb-3">Verdict API</div><div class="mt-3 first:mt-0"><div class="relative"><pre class="bg-[var(--color-ink)] text-zinc-100 pl-4 pr-14 py-3 font-mono text-[12px] overflow-x-auto leading-snug"><code>curl -s mcpindex.ai/api/v1/trust/server/io-github-alexar76-aimarket-hub</code></pre><button type="button" aria-label="Copy to clipboard" class="absolute top-2 right-2 font-mono text-[10px] uppercase tracking-[0.12em] border px-1.5 py-0.5 transition-colors focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-1 focus-visible:outline-[var(--color-accent)] text-zinc-400 hover:text-white border-zinc-700 hover:border-zinc-500">copy</button></div></div><p class="mt-2 text-[12px] leading-[1.5] text-[var(--color-mute)]">Free-tier verdict as JSON: decision + dimensions + severity. Call it from your agent before it invokes a tool it just discovered.</p></div><div><div class="font-mono text-[10.5px] uppercase tracking-[0.18em] text-[var(--color-mute)] mb-3">Details</div><dl class="rule-t font-mono text-[12px]"><div class="rule-b row-kv-auto py-2.5"><dt class="text-[var(--color-mute)] uppercase tracking-[0.12em] text-[10.5px]">version</dt><dd class="text-right text-[var(--color-ink)] truncate">v3.15.21</dd></div><div class="rule-b row-kv-auto py-2.5"><dt class="text-[var(--color-mute)] uppercase tracking-[0.12em] text-[10.5px]">category</dt><dd class="text-right text-[var(--color-ink)] truncate"><a class="hover:text-[var(--color-accent-strong)]" href="/best/search">Search</a></dd></div><div class="rule-b row-kv-auto py-2.5"><dt class="text-[var(--color-mute)] uppercase tracking-[0.12em] text-[10.5px]">verdict expires</dt><dd class="text-right text-[var(--color-ink)] truncate">2026-11-17</dd></div><div class="rule-b row-kv-auto py-2.5"><dt class="text-[var(--color-mute)] uppercase tracking-[0.12em] text-[10.5px]">quality</dt><dd class="text-right text-[var(--color-ink)] truncate">90 / 100</dd></div><div class="rule-b row-kv-auto py-2.5"><dt class="text-[var(--color-mute)] uppercase tracking-[0.12em] text-[10.5px]">operator</dt><dd class="text-right text-[var(--color-ink)] truncate">alexar76</dd></div></dl></div><div><div class="font-mono text-[10.5px] uppercase tracking-[0.18em] text-[var(--color-mute)] mb-3">Listing</div><p class="text-[12px] leading-[1.55] text-[var(--color-cite)]">Listed from the official MCP registry.<!-- --> <!-- -->Unclaimed by its maintainer.<!-- --> <!-- -->Maintainer?<!-- --> <a class="underline decoration-[var(--color-rule)] underline-offset-4 hover:text-[var(--color-accent-strong)]" href="/claim?server=io-github-alexar76-aimarket-hub">Verify it →</a> <!-- -->·<!-- --> <a href="mailto:hello@mcpindex.ai?subject=Claim%20listing%3A%20io-github-alexar76-aimarket-hub" class="underline decoration-[var(--color-rule)] underline-offset-4 hover:text-[var(--color-accent-strong)]">or email us →</a></p></div><div><div class="font-mono text-[10.5px] uppercase tracking-[0.18em] text-[var(--color-mute)] mb-3">Provenance</div><p class="text-[12px] leading-[1.55] text-[var(--color-cite)]">Each verdict is bound to a hash of the exact description it judged, so a re-crawl that changes the text produces a new record rather than silently inheriting this one. <!-- -->Verdict history is hash-chained and anchored to Bitcoin via OpenTimestamps (latest confirmed at block 975,257).<!-- --> <a class="underline decoration-[var(--color-rule)] underline-offset-4 hover:text-[var(--color-accent-strong)]" href="/trust#anchor">Verify it yourself</a>.</p></div><div id="source" class="scroll-mt-8"><div class="font-mono text-[10.5px] uppercase tracking-[0.18em] text-[var(--color-mute)] mb-3">Links</div><div class="flex flex-col gap-2 font-mono text-[11px] uppercase tracking-[0.16em]"><a href="https://github.com/alexar76/aimarket-hub" target="_blank" rel="nofollow noreferrer" class="text-[var(--color-cite)] hover:text-[var(--color-accent-strong)]">Repository →</a></div></div><div><div class="font-mono text-[10.5px] uppercase tracking-[0.18em] text-[var(--color-mute)] mb-3">Remote endpoint</div><div class="mt-3 first:mt-0"><div class="relative"><pre class="bg-[var(--color-ink)] text-zinc-100 pl-4 pr-14 py-3 font-mono text-[12px] overflow-x-auto leading-snug"><code>https://modelmarket.dev/mcp</code></pre><button type="button" aria-label="Copy to clipboard" class="absolute top-2 right-2 font-mono text-[10px] uppercase tracking-[0.12em] border px-1.5 py-0.5 transition-colors focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-1 focus-visible:outline-[var(--color-accent)] text-zinc-400 hover:text-white border-zinc-700 hover:border-zinc-500">copy</button></div></div></div></aside></div></div><!--$--><!--/$--></main><footer class="rule-t mt-32" role="contentinfo"><div class="site-container py-16"><div class="grid grid-cols-2 md:grid-cols-6 gap-10"><div class="col-span-2 md:col-span-1 max-w-[260px]"><div class="flex items-center gap-2 text-[var(--color-ink)]"><svg width="18" height="18" viewBox="0 0 40 40" fill="none" aria-hidden="true" class="shrink-0"><path d="M15 8 H10 V32 H15" stroke="currentColor" stroke-width="3.4" stroke-linecap="round" stroke-linejoin="round"></path><path d="M25 8 H30 V32 H25" stroke="currentColor" stroke-width="3.4" stroke-linecap="round" stroke-linejoin="round"></path><rect x="15" y="18.2" width="10" height="3.6" rx="1.6" fill="var(--color-accent)"></rect></svg><span class="font-mono text-[14px] tracking-tight">mcpindex<span class="text-[var(--color-mute)]">.ai</span></span></div><p class="mt-3 text-[12.5px] leading-[1.55] text-[var(--color-mute)]">The in-path trust gate for agent tool calls. It pins each MCP tool’s contract and HOLDs a call when the contract silently changes - before your agent acts.</p><p class="mt-4 font-mono text-[10.5px] uppercase tracking-[
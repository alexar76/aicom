<!DOCTYPE html><html data-dpl-id="dpl_ZhB8bwZVBDJjHRhEypEmPip27bnp" lang="en" class="geistsans_50d476d-module__CLs6DG__variable geistmono_db5c1741-module__n59ThG__variable antialiased"><head><meta charSet="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><link rel="stylesheet" href="/_next/static/chunks/103zu702qb0hb.css?dpl=dpl_ZhB8bwZVBDJjHRhEypEmPip27bnp" data-precedence="next"/><link rel="preload" as="script" fetchPriority="low" href="/_next/static/chunks/0xzyipb4cwgaz.js?dpl=dpl_ZhB8bwZVBDJjHRhEypEmPip27bnp"/><script src="/_next/static/chunks/0pqt~8bl3ukh4.js?dpl=dpl_ZhB8bwZVBDJjHRhEypEmPip27bnp" async=""></script><script src="/_next/static/chunks/0~9k~t7c89ak2.js?dpl=dpl_ZhB8bwZVBDJjHRhEypEmPip27bnp" async=""></script><script src="/_next/static/chunks/0xtbq60tn~sap.js?dpl=dpl_ZhB8bwZVBDJjHRhEypEmPip27bnp" async=""></script><script src="/_next/static/chunks/turbopack-175of_68hkeh5.js?dpl=dpl_ZhB8bwZVBDJjHRhEypEmPip27bnp" async=""></script><script src="/_next/static/chunks/0zjhc5tc._8_a.js?dpl=dpl_ZhB8bwZVBDJjHRhEypEmPip27bnp" async=""></script><script src="/_next/static/chunks/0644ajmebtrgu.js?dpl=dpl_ZhB8bwZVBDJjHRhEypEmPip27bnp" async=""></script><script src="/_next/static/chunks/01xlw8hd842-c.js?dpl=dpl_ZhB8bwZVBDJjHRhEypEmPip27bnp" async=""></script><script src="/_next/static/chunks/0ctsxqkhwvm8s.js?dpl=dpl_ZhB8bwZVBDJjHRhEypEmPip27bnp" async=""></script><meta name="next-size-adjust" content=""/><meta name="theme-color" content="#ea580c"/><title>AIMarket — live agent marketplace - io.github.alexar76/aimarket-hub · mcpindex.ai</title><meta name="description" content="Search and invoke real AI capabilities on modelmarket.dev. Free trial, then a prepaid key. mcpindex.ai listing: description-screen status and MCP Quality Score."/><link rel="manifest" href="/manifest.webmanifest"/><meta name="robots" content="index, follow"/><link rel="canonical" href="https://mcpindex.ai/server/io-github-alexar76-aimarket-hub"/><meta property="og:tit
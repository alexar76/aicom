<body>
<header>
    <div class="container">
        <div class="menu">
            <a class="logo" href="/">
                <div class="text"><strong>MCP</strong> <span>Repository</span></div>
            </a>
            <div class="search-box">
                <form onsubmit="handleSearch(event)">
                    <svg xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink" aria-hidden="true" focusable="false" role="img" width="1em" height="1em" preserveAspectRatio="xMidYMid meet" viewBox="0 0 32 32"><path d="M30 28.59L22.45 21A11 11 0 1 0 21 22.45L28.59 30zM5 14a9 9 0 1 1 9 9a9 9 0 0 1-9-9z" fill="currentColor"></path></svg>
                    <input value="" id="search" autocomplete="off" type="search" name="q" placeholder="Search MCP servers..." aria-label="Search MCP servers..."
                           autocapitalize="off" spellcheck="false" required />
                    <div style="position: absolute; right: 0; top: 0; height: 100%">
                        <button class="h-8 px-5 text-white rounded bg-primary hover:bg-opacity-90 focus:outline-none text-sm">Search</button>
                    </div>
                </form>
            </div>
            <div class="link-items">
                <a class="link" href="/submit" title="Submit MCP Server">
                    <svg viewBox="0 0 24 24" width="22" height="22" fill="currentColor"><path d="M5 4v2h14V4zm0 10h4v6h6v-6h4l-7-7z"></path></svg>
                    <span>Submit</span>
                </a>
            </div>
        </div>
    </div>
</header>

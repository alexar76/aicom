}</style><link nonce="" rel="stylesheet" href="/client/assets/root-C2mjYXgJ.b-gIrmRH.css"/><script type="application/ld+json">{"@context":"https://schema.org","@graph":[{"@context":"https://schema.org","@type":"Organization","founder":{"@type":"Person","name":"Frank Fiegel","url":"https://github.com/punkpeye"},"knowsAbout":["Model Context Protocol","MCP server registry","MCP Gateway","Tool Definition Quality Score","AI developer tools","Large language model tool calling"],"logo":"https://glama.ai/logo.png","name":"Glama","sameAs":["https://github.com/glama-ai","https://discord.gg/C3eCXhYWtJ","https://reddit.com/r/glama","https://x.com/glama_ai","https://www.linkedin.com/company/glama-ai/"],"url":"https://glama.ai/"},{"@context":"https://schema.org","@type":"BreadcrumbList","itemListElement":[{"@type":"ListItem","item":"https://glama.ai/","name":"Glama","position":1},{"@type":"ListItem","item":"https://glama.ai/mcp","name":"MCP","position":2},{"@type":"ListItem","item":"https://glama.ai/mcp/servers","name":"Servers","position":3},{"@type":"ListItem","item":"https://glama.ai/mcp/servers/alexar76/aimarket-mcp","name":"aimarket-mcp","position":4}]},{"@context":"https://schema.org","@type":"SoftwareApplication","applicationCategory":"DeveloperApplication","author":{"@type":"Organization","image":"/avatars/alexar76.avif","name":"alexar76","sameAs":"https://github.com/alexar76","url":"https://glama.ai/mcp/servers?query=author%3Aalexar76"},"description":"Discover and invoke AI services on AIMarket with prices and signed receipts. Also fetch public web pages, search the web, and request Metis verification. Five tools over stdio or self-hosted HTTP; marketplace search needs no API key.","license":"MIT License","name":"aimarket-mcp","operatingSystem":"Cross-platform","url":"https://glama.ai/mcp/servers/alexar76/aimarket-mcp"},{"@context":"https://schema.org","@type":"FAQPage","mainEntity":[{"@type":"Question","acceptedAnswer":{"@type":"Answer","text":"This MCP gateway provides hardened web access, Metis verification, and AIMarket capability discovery/invocation.\n\n* Fetch a public web page by URL and return its main text, with SSRF protections and \u003cuntrusted\u003e wrapping.\n* Search the live web via DuckDuckGo and get top result snippets.\n* Run Metis cognition + verification on an input, returning an answer with verify_score/verified metadata and selectable route.\n* Search an AIMarket hub for priced capabilities by intent, category, limit, and max price without a wallet or key.\n* Invoke a discovered capability on the hub's free trial tier, returning output plus a signed receipt nonce and reporting 402 when trial allowance is exhausted."},"name":"What can you do with this server?"},{"@type":"Question","acceptedAnswer":{"@type":"Answer","text":"Provides live web search via DuckDuckGo, returning top snippets."},"name":"Which integrations are available for this server?"},{"@type":"Question","acceptedAnswer":{"@type":"Answer","text":"1. Click on \"Deploy Server\".\n2. Wait a few minutes for the server to deploy. Once ready, it will show a \"Started\" state.\n3. In the chat, type @ followed by the MCP server name and your instructions, e.g., \"@aimarket-mcp search for recent breakthroughs in AI\"\n\nThat's it! The server will respond to your query, and you can continue using it as needed.\n\nHere is a step-by-step guide with screenshots."},"name":"How do I use aimarket-mcp?"}]}]}</script><script nonce="0c9b2f9a64d68193dae09b3beff33d81">

101,\"_102\":24},\"tools\",[53,54,55,56,57],\"undiscoveredMcpServers\",[],\"visitorSession\",{\"_51\":24,\"_52\":-5},\"hasSubscription\",\"userAccount\",{\"_58\":-5,\"_59\":87,\"_61\":88,\"_63\":89,\"_65\":66,\"_67\":-5,\"_68\":90,\"_70\":91},{\"_58\":-5,\"_59\":82,\"_61\":83,\"_63\":84,\"_65\":66,\"_67\":-5,\"_68\":85,\"_70\":86},{\"_58\":-5,\"_59\":77,\"_61\":78,\"_63\":79,\"_65\":66,\"_67\":-5,\"_68\":80,\"_70\":81},{\"_58\":-5,\"_59\":72,\"_61\":73,\"_63\":74,\"_65\":66,\"_67\":-5,\"_68\":75,\"_70\":76},{\"_58\":-5,\"_59\":60,\"_61\":62,\"_63\":64,\"_65\":66,\"_67\":-5,\"_68\":69,\"_70\":71},\"annotations\",\"description\",\"Search the web for current facts and return the top result snippets.\\n\\nUses DuckDuckGo HTML results. Output is sanitized and wrapped `\u003cuntrusted\u003e` like web_fetch.\\nPrefer this over guessing when the answer depends on recent events or documentation.\\n\",\"name\",\"web_search_tool\",\"scoringInputHash\",\"5fab86402009ae5d\",\"tier\",\"A\",\"title\",\"uid\",\"r2dn0fg0a3\",\"schemaSummary\",\"Inputs: query (required). Returns: result\",\"Fetch a web page by URL and return its main text content.\\n\\nSSRF-hardened (scheme allow-list, private-IP block, per-redirect re-validation, size cap).\\nOutput is sanitized, role-marker stripped, and wrapped in `\u003cuntrusted\u003e…\u003c/untrusted\u003e` before\\nit can reach a model — safe for agent consumption with explicit untrusted marking.\\n\",\"web_fetch_tool\",\"5faf8db846a1e691\",\"dy432oghi3\",\"Inputs: url (required), max_chars. Returns: result\",\"Run Metis cognition + verification on an input; returns answer plus verify_score/verified.\\n\\nCalls the Metis `/v1/verify` API. Response includes machine-readable metadata\\n`[verify_score=… status=… route=… verified=…]` so agents can fail-closed when confidence\\nis insufficient. Configure AIMARKET_METIS_URL and optional AIMARKET_METIS_KEY.\\n\",\"metis_verify_tool\",\"c0dba5d643d90a69\",\"n5d2swc72c\",\"Inputs: input (required), route. Returns: result\",\"Discover paid AI capabilities listed on an AIMarket hub, with prices.\\n\\nFree — no wallet, key or payment channel. Returns capability_id, product_id, price per\\ncall in USD and a trust score; pass both ids to market_invoke to run one. The hub lists\\nonly capabilities it can actually execute, so an empty result means it genuinely does\\nnot sell that. Set AIMARKET_HUB_URL to point at a different hub.\\n\",\"market_search_tool\",\"8b3f978f1fddff25\",\"qldyulpf37\",\"Inputs: intent (required), limit, category, max_price_usd. Returns: result\",\"Run one capability from market_search on the hub's free trial tier.\\n\\nReturns the capability's output plus the nonce of the hub-signed receipt, so the result\\nis verifiable against the hub's published key rather than trusted on faith. A few trial\\ninvokes are granted per installation; after that the hub answers 402 and this reports\\nthat instead of fabricating a result. Paid access needs an on-chain escrow deposit,\\nwhich is an operator action and deliberately not available here.\\n\",\"market_invoke_tool\",\"adb8735272783ef2\",\"iucec5qz0m\",\"Inputs: capability_id (required), input, product_id, source_hub. Returns: result\",\"maintenanceHealth\",{\"_154\":155,\"_156\":157,\"_158\":159,\"_160\":18,\"_161\":110,\"_162\":163},\"mcpServerComparisons\",[],\"serverQualityScore\",{\"_118\":119,\"_120\":121,\"_122\":123,\"_124\":66,\"_125\":126,\"_127\":121,\"_128\":66,\"_129\":126,\"_130\":121,\"_131\":132,\"_133\":134,\"_135\":121,\"_136\":66,\"_137\":138,\"_139\":134,\"_140\":134,\"_141\":126},\"setCookieHeader\",\"_glama_ad=7f836424-3f79-4f10-bb5a-9ee32761cbb3; Path=/; Max-Age=1800; HttpOnly; SameSite=Lax; Secure\",\"sponsoredCard\",{\"_103\":104,\"_105\":106,\"_107\":108,\"_109\":110,\"_111\":112,\"_68\":113,\"_114\":115,\"_116\":117},\"visitorHasKeptMcpServerInstance\",\"advertiserName\",\"Rayrun\",\"body\",\"Rayrun runs every MCP server behind one URL and holds the credentials. Each call is decided per client, tool, and argument, then recorded.\",\"destinationUrl\",\"https://ray.run/\",\"hasLogo\",true,\"headline\",\"One endpoint for every MCP tool\",\"d7xb9hma2u\",\"updatedAt\",\"2026-09-13T06:37:02.893477Z\",\"deliveryToken\",\"PjGxQQhdZXENSVgy.KrBHUP9pube6mmPcJbo6cqJ7WYwmJBs7XpJ83rWuOaSfAYcTAq5a7tjVgABNYE-4iMShGUoyLvbFuFpnfCopxaItWdZYz9p78mHxDhjk4ZNWGApUaHYJ9aJA3gOCC1sS3igxi4tlWGftxXg6gtJV3Vr3Pxch9ERS7WweUaFc0L6Sw8nSwAgcBB6-3dVKuqmn-qfxwBjOkUeaR628RBT_jaEgXAgTPZ1-e2Uih_3NLiC6OTmE6Z-bCKl6nxIFJCPTA9-eIUyZfGuIz8pgS9xG4-wRzuNgHyLW0Pq-gTnSES95IG7nyqhtCuy3-pP6BGhVJoYiMzlslJ5ZAifgJfIhAUG4rR-98tEF9E3yR2lNhhPx5MOZuLK4yPVVBIrZRxspsH4s._7q4s5ahNdRv579J3O4BVw\",\"coherenceJustifications\",{\"_125\":142,\"_129\":143,\"_144\":145,\"_146\":147},\"coherenceScore\",4.3,\"coherenceSummary\",\"aimarket-mcp is a coherent, well-scoped 5-tool server with distinct web, market, and verification functions and a uniformly consistent naming scheme. The main friction points are the thin tool surface (no quota/status introspection) and the conceptual proximity between market_invoke and metis_verify, but descriptions disambiguate them adequately.\",\"coherenceTier\",\"completeness\",4,\"descriptionQualityScore\",\"descriptionQualityTier\",\"disambiguation\",\"meanTdqs\",\"minTdqs\",4.2,\"namingConsistency\",5,\"overallScore\",\"overallTier\",\"scoredAt\",\"2026-10-20T10:30:21.033163Z\",\"scoredToolCount\",\"toolCount\",\"toolCountAppropriateness\",{\"_148\":153,\"_150\":126},{\"_148\":152,\"_150\":126},\"naming_consistency\",{\"_148\":151,\"_150\":134},\"tool_count_appropriateness\",{\"_148\":149,\"_150\":126},\"justification\",\"Five tools is a lean but reasonable set covering search, fetch, market discovery, invocation, and verification. It is on the thin side for a market/hub server since no tool exposes trial quota, hub config, or errors-as-state beyond what invoke returns, but nothing feels padded.\",\"score\",\"All five tools follow the same {domain}_{verb}_tool snake_case convention (web_search_tool, market_invoke_tool, market_search_tool, metis_verify_tool, web_fetch_tool). The redundant '_tool' suffix is unnecessary but applied uniformly, so it remains fully predictable.\",\"Each tool has a fairly distinct purpose: web_search vs web_fetch (find vs retrieve), market_search vs market_invoke (discover vs execute), and metis_verify is a standalone verification endpoint. The only slight overlap is that market_invoke can run arbitrary hub capabilities while metis_verify runs a specific one, which could raise 'which do I call?' questions, but the descriptions clarify the difference.\",\"The core loop is covered: discover capabilities (market_search), run one (market_invoke), verify output (metis_verify), plus web search/fetch for grounding. Minor gaps exist (no tool to inspect remaining trial invokes or hub status), and paid escrow is intentionally excluded, but agents can work around these.\",\"activitySeries\",[189,190,191,192,193,194,195,196,197,198,199,200],\"issueResponsiveness\",{\"_175\":18,\"_176\":18,\"_177\":178,\"_179\":180,\"_181\":24,\"_182\":18,\"_183\":-5,\"_184\":-5,\"_185\":18,\"_186\":24,\"_187\":24,\"_188\":18},\"issueSeries\",[172],\"maintainerCount\",\"releaseDataAvailable\",\"releaseSeries\",[164,165],{\"_166\":170,\"_168\":171},{\"_166\":167,\"_168\":169},\"month\",\"2026-08\",\"releaseCount\",1,\"2026-07\",6,{\"_173\":134,\"_166\":170,\"_174\":134},\"closedCount\",\"openedCount\",\"answeredCount\",\"closedWithoutReplyCount\",\"collectedAt\",\"2026-11-10T05:17:39.056152Z\",\"collectionStatus\",\"successful\",\"dataPending\",\"handledCount\",\"medianResponseHours\",\"oldestUnansweredDays\",\"overdueCount\",\"replyDataPending\",\"stale\",\"totalCount\",{\"_201\":18,\"_202\":215},{\"_201\":18,\"_202\":214},{\"_201\":18,\"_202\":213},{\"_201\":18,\"_202\":212},{\"_201\":18,\"_202\":211},{\"_201\":18,\"_202\":210},{\"_201\":169,\"_202\":209},{\"_201\":169,\"_202\":208},{\"_201\":171,\"_202\":207},{\"_201\":126,\"_202\":206},{\"_201\":204,\"_202\":205},{\"_201\":169,\"_202\":203},\"commitCount\",\"week\",\"2026-11-08\",3,\"2026-11-01\",\"2026-10-25\",\"2026-10-18\",\"2026-10-11\",\"2026-10-04\",\"2026-09-27\",\"2026-09-20\",\"2026-09-13\",\"2026-09-06\",\"2026-08-30\",\"2026-08-23\",{\"_220\":465,\"_222\":18,\"_223\":466,\"_225\":467,\"_227\":467,\"_228\":257,\"_230\":468,\"_232\":24,\"_233\":469,\"_235\":470,\"_237\":-5,\"_239\":18,\"_240\":471,\"_242\":24,\"_243\":472,\"_245\":-5,\"_246\":468,\"_140\":18,\"_68\":473,\"_114\":474,\"_251\":-5,\"_252\":-5,\"_253\":-5,\"_254\":24,\"_255\":-5},{\"_220\":433,\"_222\":18,\"_223\":434,\"_225\":435,\"_227\":435,\"_228\":18,\"_230\":436,\"_232\":24,\"_233\":437,\"_235\":438,\"_237\":-5,\"_239\":18,\"_240\":439,\"_242\":24,\"_243\":440,\"_245\":-5,\"_246\":441,\"_140\":18,\"_68\":442,\"_114\":443,\"_251\":-5,\"_252\":-5,\"_253\":-5,\"_254\":24,\"_255\":-5},{\"_220\":312,\"_222\":18,\"_223\":313,\"_225\":314,\"_227\":314,\"_228\":257,\"_230\":315,\"_232\":24,\"_233\":316,\"_235\":317,\"_237\":-5,\"_239\":18,\"_240\":318,\"_242\":24,\"_243\":319,\"_245\":-5,\"_246\":320,\"_140\":18,\"_68\":321,\"_114\":322,\"_251\":-5,\"_252\":-5,\"_253\":-5,\"_254\":24,\"_255\":-5},{\"_220\":221,\"_222\":18,\"_223\":224,\"_225\":226,\"_227\":226,\"_228\":229,\"_230\":231,\"_232\":24,\"_233\":234,\"_235\":236,\"_237\":238,\"_239\":18,\"_240\":241,\"_242\":24,\"_243\":244,\"_245\":-5,\"_246\":247,\"_140\":248,\"_68\":249,\"_114\":250,\"_251\":-5,\"_252\":-5,\"_253\":-5,\"_254\":24,\"_255\":-5},\"addedAt\",\"2026-10-29T11:28:51.757000Z\",\"appCount\",\"attributes\",[308,309,310,311],\"descriptionMarkdown\",\"Enables MCP clients and agents to run structured web searches and fetch web pages as Markdown through a search/fetch API, with rate limiting, retry/backoff, request deadlines, and private-address blocking for safer agent use.\",\"descriptionPlainText\",\"discoverabilityScore\",300,\"displayName\",\"deepseek-search\",\"hasApps\",\"id\",125229,\"namespace\",{\"_246\":297},\"qualityScore\",4.4,\"recentUsage\",\"repository\",{\"_262\":263,\"_264\":265,\"_266\":-5,\"_256\":267,\"_268\":269,\"_270\":-5,\"_271\":272},\"repositoryPrivate\",\"scores\",{\"_256\":257,\"_258\":259,\"_260\":66,\"_261\":257},\"simpleIcon\",\"slug\",\"deepseek-search-fetch-mcp\",2,\"nm9y8y40b0\",\"2026-11-05T11:35:11.005069Z\",\"deprecatedAt\",\"deprecationComment\",\"replacementServer\",\"isBoosted\",\"thumbnailUpdatedAt\",\"license\",100,\"maintenance\",\"B\",\"quality\",\"security\",\"environmentVariablesJsonSchema\",{\"_298\":299,\"_300\":301,\"_302\":303},\"githubRepository\",{\"_281\":282,\"_283\":284,\"_61\":247,\"_285\":286,\"_287\":288,\"_289\":18,\"_290\":291,\"_292\":18},\"glamaJson\",{\"_61\":278,\"_279\":280},\"npmPackage\",{\"_61\":247,\"_276\":277},\"pypiPackage\",\"supportedPlatforms\",[273,274,275],\"WINDOWS\",\"LINUX\",\"MACOS\",\"weeklyDownloads\",877,\"MIT License\",\"source\",\"github\",\"fullName\",\"BryleXia/deepseek-search-fetch-mcp\",\"language\",\"JavaScript\",\"owner\",{\"_233\":295,\"_296\":297},\"pushedAt\",\"2026-10-29T10:48:08.000000Z\",\"recentStargazers\",\"spdxLicense\",{\"_61\":278,\"_293\":294},\"stargazers\",\"url\",\"https://spdx.org/licenses/MIT.json\",16710188,\"login\",\"BryleXia\",\"properties\",{\"_304\":305},\"required\",[304],\"type\",\"object\",\"DEEPSEEK_API_KEY\",{\"_59\":306,\"_302\":307},\"Your DeepSeek API key, used by the server to authenticate requests.\",\"string\",\"category:search\",\"category:browser-automation\",\"environment:network\",\"hosting:remote-capable\",\"2026-10-28T05:20:58.636582Z\",[309,431,310,432],\"Enables AI chat backends to fetch public webpages and obtain cleaned readable text, Markdown, article content, metadata, and summary-ready prompts through MCP tools.\",\"Website Reader MCP\",124477,{\"_246\":333},{\"_262\":324,\"_264\":325,\"_266\":-5,\"_256\":326,\"_268\":-5,\"_270\":-5,\"_271\":-5},{\"_256\":257,\"_258\":323,\"_260\":-5,\"_261\":-5},\"website-reader-mcp\",\"mlkhegylad\",\"2026-11-04T05:30:08.812022Z\",\"C\",{\"_298\":334,\"_300\":335,\"_302\":303},{\"_281\":327,\"_283\":328,\"_61\":320,\"_285\":329,\"_287\":330,\"_289\":18,\"_290\":331,\"_292\":18},{\"_61\":278,\"_279\":280},\"AlwIkigai/website-reader-mcp\",\"Python\",{\"_233\":332,\"_296\":333},\"2026-10-28T04:07:34.000000Z\",{\"_61\":278,\"_293\":294},16582549,\"AlwIkigai\",{\"_337\":338,\"_339\":340,\"_341\":342,\"_343\":344,\"_345\":346,\"_336\":347,\"_348\":349,\"_350\":351,\"_352\":353,\"_354\":355,\"_356\":357,\"_358\":359,\"_360\":361,\"_362\":363,\"_364\":365,\"_366\":367,\"_368\":369,\"_370\":371,\"_372\":373,\"_374\":375,\"_376\":377,\"_378\":379,\"_380\":381,\"_382\":383,\"_384\":385},[336],\"MCP_API_KEY\",\"HOST\",{\"_386\":429,\"_59\":430,\"_302\":307},\"PORT\",{\"_386\":427,\"_59\":428,\"_302\":307},\"APP_ENV\",{\"_386\":425,\"_59\":426,\"_302\":307},\"DEV_HTTPS\",{\"_386\":387,\"_59\":424,\"_302\":307},\"REDIS_URL\",{\"_386\":397,\"_59\":423,\"_302\":307},{\"_59\":422,\"_302\":307},\"SSL_KEYFILE\",{\"_386\":420,\"_59\":421,\"_302\":307},\"SSL_CERTFILE\",{\"_386\":418,\"_59\":419,\"_302\":307},\"CACHE_BACKEND\",{\"_386\":403,\"_59\":417,\"_302\":307},\"CACHE_ENABLED\",{\"_386\":401,\"_59\":416,\"_302\":307},\"MAX_HTML_BYTES\",{\"_386\":414,\"_59\":415,\"_302\":307},\"ALLOWED_SCHEMES\",{\"_386\":412,\"_59\":413,\"_302\":307},\"CACHE_MAX_ENTRIES\",{\"_386\":410,\"_59\":411,\"_302\":307},\"CACHE_TTL_SECONDS\",{\"_386\":408,\"_59\":409,\"_302\":307},\"MCP_ALLOWED_HOSTS\",{\"_386\":397,\"_59\":407,\"_302\":307},\"MAX_RESPONSE_CHARS\",{\"_386\":405,\"_59\":406,\"_302\":307},\"RATE_LIMIT_BACKEND\",{\"_386\":403,\"_59\":404,\"_302\":307},\"RATE_LIMIT_ENABLED\",{\"_386\":401,\"_59\":402,\"_302\":307},\"SSRF_DNS_RESOLVERS\",{\"_386\":399,\"_59\":400,\"_302\":307},\"MCP_ALLOWED_ORIGINS\",{\"_386\":397,\"_59\":398,\"_302\":307},\"RATE_LIMIT_PER_HOUR\",{\"_386\":395,\"_59\":396,\"_302\":307},\"RATE_LIMIT_PER_MINUTE\",{\"_386\":393,\"_59\":394,\"_302\":307},\"REQUEST_TIMEOUT_SECONDS\",{\"_386\":391,\"_59\":392,\"_302\":307},\"SSRF_DNS_TIMEOUT_SECONDS\",{\"_386\":389,\"_59\":390,\"_302\":307},\"SSRF_DNS_VALIDATION_ENABLED\",{\"_386\":387,\"_59\":388,\"_302\":307},\"default\",\"true\",\"Enable DNS resolution, IP validation and connection pinning to protect against SSRF and DNS rebinding.\",\"2\",\"Per-query DNS timeout in seconds; resolvers are queried concurrently.\",\"12\",\"Timeout in seconds for outbound URL fetches.\",\"15\",\"Maximum URL fetches per client per minute (burst protection).\",\"120\",\"Maximum URL fetches per client per hour (sustained cap).\",\"\",\"Optional restriction on browser Origin headers for /mcp requests. Empty disables the check.\",\"system,1.1.1.1,1.0.0.1,8.8.8.8,8.8.4.4\",\"Comma-separated DNS resolvers used for validation. 'system' uses /etc/resolv.conf; others are public resolver IPs.\",\"false\",\"Enable or disable per-client rate limiting on outbound URL fetches. Only cache misses count toward limits.\",\"memory\",\"Rate limit backend: 'memory' for local/single-instance or 'redis' for shared limits on Vercel.\",\"12000\",\"Maximum number of characters returned in tool output (overridable per call via max_chars).\",\"Optional allowlist of Host header values permitted to access /mcp. Empty disables the check. Use '*' to allow any host, exact hosts, subdomain wildcards like *.example.com, or port wildcards like localhost:*.\",\"300\",\"How long cached URL fetch responses are kept, in seconds.\",\"100\",\"Maximum number of in-memory cache entries (ignored for Redis).\",\"https,http\",\"Comma-separated URL schemes allowed for fetching (only http and https are allowed).\",\"2000000\",\"Maximum number of bytes downloaded while fetching a page.\",\"Enable or disable caching of successful URL fetches at the fetch layer (shared by all tools).\",\"Cache backend: 'memory' for local/single-instance or 'redis' for a shared cache on Vercel.\",\"certs/localhost.pem\",\"Path to the local dev TLS certificate file.\",\"certs/localhost-key.pem\",\"Path to the local dev TLS private key file.\",\"API key required to authenticate requests to the MCP endpoint (sent via Authorization: Bearer or X-API-Key header). Set a real value; the .env.example default is 'change-me'.\",\"Redis connection URL (e.g. Upstash). Required when CACHE_BACKEND=redis or RATE_LIMIT_BACKEND=redis.\",\"Whether to run the local dev server over HTTPS.\",\"local\",\"Application environment name.\",\"8001\",\"Port for the local uvicorn server.\",\"0.0.0.0\",\"Host interface for the local uvicorn server to bind to.\",\"category:web-scraping\",\"hosting:hybrid\",\"2026-08-23T16:22:11.342718Z\",[308,309,431,464,310,432],\"Enables AI agents to perform unified web research through a single MCP server, including search, page fetching, recursive crawling, document parsing, YouTube transcript extraction, and deep multi-query research.\",\"MyWebSearch MCP\",87075,{\"_246\":451},{\"_262\":444,\"_264\":445,\"_266\":-5,\"_256\":-5,\"_268\":-5,\"_270\":-5,\"_271\":446},{\"_256\":18,\"_258\":323,\"_260\":-5,\"_261\":-5},\"websearch-forge-mcp\",\"og6vz1222o\",\"2026-11-06T11:50:16.780560Z\",{\"_298\":452,\"_300\":453,\"_302\":303},{\"_281\":447,\"_283\":328,\"_61\":441,\"_285\":448,\"_287\":449,\"_289\":18,\"_290\":-5,\"_292\":204},[273],\"iuiu-py/websearch-forge-mcp\",{\"_233\":450,\"_296\":451},\"2026-08-23T16:36:05.000000Z\",8838637,\"iuiu-py\",{\"_454\":455,\"_456\":457,\"_458\":459},[],\"CACHE_TTL\",{\"_386\":408,\"_59\":463,\"_302\":307},\"PROXY_URL\",{\"_59\":462,\"_302\":307},\"SEARXNG_URL\",{\"_386\":460,\"_59\":461,\"_302\":307},\"http://127.0.0.1:8080\",\"The URL of the SearXNG server. Defaults to http://127.0.0.1:8080.\",\"Explicit proxy URL to use when needed, bypassing machine-wide proxy settings for loopback traffic.\",\"TTL for the SQLite cache in seconds. Defaults to 300.\",\"environment:local\",\"2026-07-28T14:21:45.365508Z\",[308,500,501,310,502],\"Enables AI agents to perform web searches with full content retrieval and multi-engine provenance, including trust scoring and local corpus persistence, via MCP integration.\",\"qsearch\",70801,{\"_246\":488},{\"_262\":475,\"_264\":476,\"_266\":-5,\"_256\":477,\"_268\":478,\"_270\":-5,\"_271\":479},{\"_256\":257,\"_258\":259,\"_260\":-5,\"_261\":-5},\"caq2j9kn6f\",\"2026-11-06T02:30:19.128918Z\",{\"_298\":489,\"_300\":490,\"_302\":303},{\"_281\":482,\"_283\":284,\"_61\":468,\"_285\":483,\"_287\":484,\"_289\":169,\"_290\":485,\"_292\":126},{\"_61\":481,\"_279\":280},{\"_61\":468,\"_276\":480},[275,273],8,\"Apache 2.0\",\"theYahia/qsearch\",{\"_233\":487,\"_296\":488},\"2026-09-03T04:54:08.000000Z\",{\"_61\":481,\"_293\":486},\"https://spdx.org/licenses/Apache-2.0.json\",578288,\"theYahia\",{\"_458\":492,\"_491\":493,\"_494\":495},[491],\"BRAVE_API_KEY\",{\"_59\":499,\"_302\":307},{\"_59\":498,\"_302\":307},\"OLLAMA_CLEAN_MODEL\",{\"_386\":496,\"_59\":497,\"_302\":307},\"qwen2.5:7b-instruct\",\"Ollama model for page cleaning (optional)\",\"Your Brave Search API key (required for primary search and some MCP tools)\",\"URL of your SearXNG instance for multi-engine attribution (optional, default not set)\",\"category:rag-systems\",\"category:knowledge-and-memory\",\"hosting:local-only\",{\"_507\":508,\"_509\":541,\"_251\":-5,\"_59\":542,\"_512\":-5,\"_513\":24,\"_233\":543,\"_254\":24,\"_515\":24,\"_61\":544,\"_235\":545,\"_136\":66,\"_246\":546,\"_255\":-5,\"_67\":547,\"_140\":18,\"_521\":169,\"_293\":548},{\"_507\":531,\"_509\":532,\"_251\":-5,\"_59\":533,\"_512\":-5,\"_513\":24,\"_233\":534,\"_254\":24,\"_515\":24,\"_61\":535,\"_235\":536,\"_136\":-5,\"_246\":537,\"_255\":-5,\"_67\":538,\"_140\":18,\"_521\":169,\"_293\":539},{\"_507\":508,\"_509\":523,\"_251\":-5,\"_59\":524,\"_512\":18,\"_513\":24,\"_233\":525,\"_254\":24,\"_515\":24,\"_61\":526,\"_235\":527,\"_136\":66,\"_246\":528,\"_255\":-5,\"_67\":529,\"_140\":18,\"_521\":248,\"_293\":530},{\"_507\":508,\"_509\":510,\"_251\":-5,\"_59\":511,\"_512\":126,\"_513\":110,\"_233\":514
_302\":611},{\"_613\":1791,\"_611\":1221,\"_302\":611},{\"_611\":1790,\"_302\":611},{\"_613\":1789,\"_611\":1162,\"_302\":611},{\"_611\":1788,\"_302\":611},{\"_613\":1783,\"_611\":1784,\"_302\":611},[647,1785],\"docs/hosted-mcp-endpoint.md\",{\"_603\":1786,\"_302\":617},{\"_618\":-5,\"_619\":1787,\"_621\":622,\"_623\":624},\"https://github.com/alexar76/aicom/blob/main/docs/hosted-mcp-endpoint.md\",\" against the live hub, with a few free trial invokes per caller and a\\nsigned receipt for each — no wallet, no key, no install.\\n→ \",[647],\"\\nand \",[647],\" into your MCP client and you have \",[647,635],\"https://modelmarket.dev/mcp\",\"Paste \",{\"_731\":204},[1798],{\"_611\":1799,\"_302\":611},\"🟢 Just want to try the marketplace? Install nothing.\",[1801],{\"_549\":1802,\"_302\":609},[1803,1804,1805,1806,1807,1808,1809,1810,1811,1812,1813,1814],{\"_611\":1843,\"_302\":611},{\"_611\":1841,\"_302\":611,\"_613\":1842},{\"_611\":1820,\"_302\":611},{\"_611\":1836,\"_302\":611,\"_613\":1837},{\"_611\":1820,\"_302\":611},{\"_611\":1831,\"_302\":611,\"_613\":1832},{\"_611\":1820,\"_302\":611},{\"_611\":1826,\"_302\":611,\"_613\":1827},{\"_611\":1820,\"_302\":611},{\"_611\":1821,\"_302\":611,\"_613\":1822},{\"_611\":1820,\"_302\":611},{\"_611\":1815,\"_302\":611,\"_613\":1816},\"Glossary\",[1817],{\"_603\":1818,\"_302\":617},{\"_618\":-5,\"_619\":1819,\"_621\":622,\"_623\":624},\"https://github.com/alexar76/aicom/blob/main/docs/localization-glossary.md\",\" · \",\"中文\",[1823],{\"_603\":1824,\"_302\":617},{\"_618\":-5,\"_619\":1825,\"_621\":622,\"_623\":624},\"https://github.com/alexar76/aimarket-mcp/blob/main/docs/README.zh.md\",\"Français\",[1828],{\"_603\":1829,\"_302\":617},{\"_618\":-5,\"_619\":1830,\"_621\":622,\"_623\":624},\"https://github.com/alexar76/aimarket-mcp/blob/main/docs/README.fr.md\",\"Español\",[1833],{\"_603\":1834,\"_302\":617},{\"_618\":-5,\"_619\":1835,\"_621\":622,\"_623\":624},\"https://github.com/alexar76/aimarket-mcp/blob/main/docs/README.es.md\",\"Русский\",[1838],{\"_603\":1839,\"_302\":617},{\"_618\":-5,\"_619\":1840,\"_621\":622,\"_623\":624},\"https://github.com/alexar76/aimarket-mcp/blob/main/docs/README.ru.md\",\"English\",[635],\"🌐 \",[1845],{\"_549\":1846,\"_302\":609},[1847,1848,1849,1850,1851,1852,1853,1854],{\"_611\":1874,\"_302\":611},{\"_611\":1869,\"_302\":611,\"_613\":1870},{\"_611\":1868,\"_302\":611},{\"_611\":1866,\"_302\":611,\"_613\":1867},{\"_611\":1865,\"_302\":611},{\"_611\":1860,\"_302\":611,\"_613\":1861},{\"_611\":1820,\"_302\":611},{\"_611\":1855,\"_302\":611,\"_613\":1856},\"Pull requests\",[1857],{\"_603\":1858,\"_302\":617},{\"_618\":-5,\"_619\":1859,\"_621\":622,\"_623\":624},\"https://github.com/alexar76/aimarket-mcp/pulls\",\"Issues\",[1862],{\"_603\":1863,\"_302\":617},{\"_618\":-5,\"_619\":1864,\"_621\":622,\"_623\":624},\"https://github.com/alexar76/aimarket-mcp/issues\",\" — merged PRs are imported back and re-synced here. \",\"Pull requests are welcome\",[635],\" (append-only history). \",\"AI-Factory monorepo\",[1871],{\"_603\":1872,\"_302\":617},{\"_618\":-5,\"_619\":1873,\"_621\":622,\"_623\":624},\"https://github.com/alexar76/aicom\",\"🔄 Synced from the \",{\"_731\":169},[1877],{\"_611\":1878,\"_302\":611},\"aimarket-mcp — ecosystem MCP gateway\",{\"_67\":2006},{\"_549\":1984,\"_61\":59},{\"_619\":692,\"_621\":2004,\"_2005\":617},{\"_549\":1986,\"_1993\":2003},{\"_549\":1984,\"_1993\":2002},{\"_549\":1982,\"_1993\":2001},{\"_549\":1980,\"_1993\":2000},{\"_549\":1978,\"_1993\":1999},{\"_549\":1997,\"_1993\":1998},{\"_549\":692,\"_1993\":1996},{\"_549\":698,\"_1993\":1995},{\"_549\":1992,\"_1993\":1994},{\"_549\":1990,\"_61\":1991},{\"_549\":1988,\"_61\":1989},{\"_549\":1986,\"_61\":1987},{\"_549\":1984,\"_61\":1985},{\"_549\":1982,\"_61\":1983},{\"_549\":1980,\"_61\":1981},{\"_549\":1978,\"_61\":1979},{\"_1899\":1900},\"script:ld+json\",{\"_1901\":1902,\"_1903\":1904},\"@context\",\"https://schema.org\",\"@graph\",[1905,1906,1907,1908],{\"_1901\":1902,\"_1909\":1936,\"_1958\":1959,\"_1960\":1961,\"_1962\":1963,\"_61\":698,\"_1940\":1964,\"_293\":1957},{\"_1901\":1902,\"_1909\":1943,\"_1944\":1945},{\"_1901\":1902,\"_1909\":1928,\"_1929\":1930,\"_1931\":1932,\"_59\":1933,\"_256\":278,\"_61\":896,\"_1934\":1935,\"_293\":692},{\"_1901\":1902,\"_1909\":1910,\"_1911\":1912},\"@type\",\"FAQPage\",\"mainEntity\",[1913,1914,1915],{\"_1909\":1916,\"_1917\":1925,\"_61\":1926},{\"_1909\":1916,\"_1917\":1922,\"_61\":1923},{\"_1909\":1916,\"_1917\":1918,\"_61\":1919},\"Question\",\"acceptedAnswer\",{\"_1909\":1920,\"_611\":1921},\"How do I use aimarket-mcp?\",\"Answer\",\"1. Click on \\\"Deploy Server\\\".\\n2. Wait a few minutes for the server to deploy. Once ready, it will show a \\\"Started\\\" state.\\n3. In the chat, type @ followed by the MCP server name and your instructions, e.g., \\\"@aimarket-mcp search for recent breakthroughs in AI\\\"\\n\\nThat's it! The server will respond to your query, and you can continue using it as needed.\\n\\nHere is a step-by-step guide with screenshots.\",{\"_1909\":1920,\"_611\":1924},\"Which integrations are available for this server?\",\"Provides live web search via DuckDuckGo, returning top snippets.\",{\"_1909\":1920,\"_611\":1927},\"What can you do with this server?\",\"This MCP gateway provides hardened web access, Metis verification, and AIMarket capability discovery/invocation.\\n\\n* Fetch a public web page by URL and return its main text, with SSRF protections and \u003cuntrusted\u003e wrapping.\\n* Search the live web via DuckDuckGo and get top result snippets.\\n* Run Metis cognition + verification on an input, returning an answer with verify_score/verified metadata and selectable route.\\n* Search an AIMarket hub for priced capabilities by intent, category, limit, and max price without a wallet or key.\\n* Invoke a discovered capability on the hub's free trial tier, returning output plus a signed receipt nonce and reporting 402 when trial allowance is exhausted.\",\"SoftwareApplication\",\"applicationCategory\",\"DeveloperApplication\",\"author\",{\"_1909\":1936,\"_1937\":1938,\"_61\":1939,\"_1940\":1941,\"_293\":1942},\"Discover and invoke AI services on AIMarket with prices and signed receipts. Also fetch public web pages, search the web, and request Metis verification. Five tools over stdio or self-hosted HTTP; marketplace search needs no API key.\",\"operatingSystem\",\"Cross-platform\",\"Organization\",\"image\",\"/avatars/alexar76.avif\",\"alexar76\",\"sameAs\",\"https://github.com/alexar76\",\"https://glama.ai/mcp/servers?query=author%3Aalexar76\",\"BreadcrumbList\",\"itemListElement\",[1946,1947,1948,1949],{\"_1909\":1950,\"_1951\":1957,\"_61\":698,\"_1952\":169},{\"_1909\":1950,\"_1951\":1955,\"_61\":1956,\"_1952\":248},{\"_1909\":1950,\"_1951\":1953,\"_61\":1954,\"_1952\":204},{\"_1909\":1950,\"_1951\":692,\"_61\":896,\"_1952\":126},\"ListItem\",\"item\",\"position\",\"https://glama.ai/mcp/servers\",\"Servers\",\"https://glama.ai/mcp\",\"MCP\",\"https://glama.ai/\",\"founder\",{\"_1909\":1975,\"_61\":1976,\"_293\":1977},\"knowsAbout\",[1738,1970,1971,1972,1973,1974],\"logo\",\"https://glama.ai/logo.png\",[1965,1966,1967,1968,1969],\"https://github.com/glama-ai\",\"https://discord.gg/C3eCXhYWtJ\",\"https://reddit.com/r/glama\",\"https://x.com/glama_ai\",\"https://www.linkedin.com/company/glama-ai/\",\"MCP server registry\",\"MCP Gateway\",\"Tool Definition Quality Score\",\"AI developer tools\",\"Large language model tool calling\",\"Person\",\"Frank Fiegel\",\"https://github.com/punkpeye\",\"1200\",\"twitter:image:width\",\"630\",\"twitter:image:height\",\"https://glama.ai/mcp/servers/alexar76/aimarket-mcp/og-image\",\"twitter:image\",\"Discover and invoke AI services on AIMarket with prices and signed receipts. Also fetch public web pages, search the web, and request Metis verification.\",\"twitter:description\",\"aimarket-mcp by alexar76\",\"twitter:title\",\"@glama_ai\",\"twitter:site\",\"summary_large_image\",\"twitter:card\",\"en_US\",\"property\",\"og:locale\",\"og:site_name\",\"og:url\",\"website\",\"og:type\",\"og:image:width\",\"og:image:height\",\"og:image\",\"og:description\",\"og:title\",\"canonical\",\"tagName\",\"aimarket-mcp by alexar76 | Glama\",\"2026-07-11T21:06:41.234044Z\",[540,309,308,310,311,2080,2081,2082,2083,2084],\"deprecation\",{\"_251\":-5,\"_252\":-5,\"_253\":-5},60535,\"integrations\",[2072],\"invocationExample\",\"search for recent breakthroughs in AI\",{\"_285\":2069,\"_246\":1939},\"redditPostExternalId\",\"removed\",{\"_2024\":2025,\"_2026\":2027,\"_264\":2028,\"_266\":2029,\"_2030\":110,\"_2031\":2032,\"_256\":2033,\"_268\":-5,\"_270\":2034,\"_271\":2035},{\"_256\":257,\"_258\":259,\"_260\":66},\"vx7q8jy310\",\"2026-11-10T05:20:15.370255Z\",\"readmeMarkdown\",\"argumentsJsonSchema\",{\"_298\":2053,\"_300\":2054,\"_302\":303},\"githubProject\",{\"_2051\":110,\"_293\":2052},{\"_2042\":2043,\"_281\":2044,\"_2045\":2046,\"_233\":2047,\"_283\":328,\"_61\":896,\"_285\":2048,\"_289\":18,\"_290\":2049,\"_292\":169},{\"_2040\":2041},\"inspectable\",\"latestRelease\",{\"_2038\":2039},{\"_61\":278,\"_279\":280},{\"_2036\":-5,\"_61\":896,\"_276\":2037},[275,273,274],\"licenseExpression\",112,\"version\",\"0.4.1\",\"maintainers\",[1939],\"defaultBranch\",\"main\",\"alexar76/aimarket-mcp\",\"githubTreeId\",57850522,1689680,{\"_296\":1939,\"_68\":2050},{\"_61\":278},\"k8otpw4wwy\",\"hasReadme\",\"https://github.com/alexar76/aimarket-mcp\",{\"_1021\":2055,\"_990\":2056,\"_1006\":2057,\"_1261\":2058,\"_1281\":2059,\"_1245\":2060,\"_1032\":2061},[],{\"_59\":2068,\"_302\":307},{\"_59\":2067,\"_302\":307},{\"_59\":2066,\"_302\":307},{\"_59\":2065,\"_302\":307},{\"_59\":2064,\"_302\":307},{\"_59\":2063,\"_302\":307},{\"_59\":2062,\"_302\":307},\"Set to '1' to enable production mode, which requires AIMARKET_MCP_KEY.\",\"URL for the search service (required for web_search tool).\",\"URL for the Metis verification service (required for metis_verify tool).\",\"API key for the Metis verification service.\",\"Rate limit per key/IP (default: 120/min).\",\"Port to listen on (default: 9090).\",\"Optional bearer token for authentication. Required if AIMARKET_MCP_PRODUCTION is set to 1.\",{\"_2070\":2071},\"githubAccount\",{\"_296\":1939},{\"_2073\":2074,\"_59\":1924,\"_68\":2075},\"brand\",{\"_2076\":2077,\"_61\":2078,\"_246\":2079},\"zfsnrt6yud\",\"logoSvgPath\",\"M12 0C5.373 0 0 5.373 0 12s5.373 12 12 12 12-5.373 12-12S18.627 0 12 0zm0 23C5.925 23 1 18.074 1 12S5.926 1 12 1s11 4.925 11 11-4.925 11-11 11zm10.219-11c0 4.805-3.317 8.833-7.786 9.925-.27-.521-.53-1.017-.749-1.438.645.249 1.93.718 2.208.615.376-.144.282-3.149-.14-3.245-.338-.075-1.632.837-2.141 1.209l.034.156c.078.397.144.993.03 1.247-.001.004-.002.01-.004.013a.218.218 0 0 1-.068.088c-.284.188-1.081.284-1.503.188a.516.516 0 0 1-.064-.02c-.694.396-2.01 1.109-2.25.971-.329-.188-.377-2.676-.329-3.288.035-.46 1.653.286 2.442.679.174-.163.602-.272.98-.31-.57-1.389-.99-2.977-.733-4.105 0 .002.002.002.002.002.356.248 2.73 1.05 3.91 1.027 1.18-.024 3.114-.743 2.903-1.323-.212-.58-2.135.51-4.142.324-1.486-.138-1.748-.804-1.42-1.29.414-.611 1.168.116 2.411-.256 1.245-.371 2.987-1.035 3.632-1.397 1.494-.833-.625-1.177-1.125-.947-.474.22-2.123.637-2.889.82.428-1.516-.603-4.149-1.757-5.3-.376-.376-.951-.612-1.603-.736-.25-.344-.654-.671-1.225-.977a5.772 5.772 0 0 0-3.595-.584l-.024.004-.034.004.004.002c-.148.028-.237.08-.357.098.148.016.705.276 1.057.418-.174.068-.412.108-.596.184a.828.828 0 0 0-.204.056c-.173.08-.303.375-.3.515.84-.086 2.082-.026 2.991.246-.644.09-1.235.258-1.661.482-.016.008-.03.018-.048.028-.054.02-.106.042-.152.066-1.367.72-1.971 2.405-1.611 4.424.323 1.824 1.665 8.088 2.29 11.064-3.973-1.4-6.822-5.186-6.822-9.639C1.781 6.356 6.356 1.781 12 1.781S22.219 6.356 22.219 12zM9.095 9.581a.758.758 0 1 0 0 1.516.758.758 0 0 0 0-1.516zm.338.702a.196.196 0 1 1 0-.392.196.196 0 0 1 0 .392zm4.724-1.043a.65.65 0 1 0 0 1.299.65.65 0 0 0 0-1.3zm.29.601a.168.168 0 1 1 0-.336.168.168 0 0 1 0 .336zM9.313 8.146s-.571-.26-1.125.09c-.554.348-.534.704-.534.704s-.294-.656.49-.978c.786-.32 1.17.184 1.17.184zm5.236-.052s-.41-.234-.73-.23c-.654.008-.831.296-.831.296s.11-.688.945-.55a.84.84 0 0 1 .616.484z\",\"DuckDuckGo\",\"duckduckgo\",\"language:python\",\"maintenance_grade:b\",\"quality_grade:a\",\"license_grade:a\",\"author:claimed\",\"tag\",\"en-US\",{\"_731\":248,\"_246\":45,\"_67\":1564},{\"_731\":204,\"_246\":2105,\"_67\":1374},{\"_731\":248,\"_246\":2104,\"_67\":1300},{\"_731\":248,\"_246\":2103,\"_67\":958},{\"_731\":248,\"_246\":2102,\"_67\":921},{\"_731\":204,\"_246\":2101,\"_67\":913},{\"_731\":248,\"_246\":2100,\"_67\":904},{\"_731\":248,\"_246\":2099,\"_67\":796},{\"_731\":248,\"_246\":2098,\"_67\":741},{\"_731\":248,\"_246\":2097,\"_67\":730},\"registries\",\"test\",\"consumers\",\"publish-on-glama\",\"cursor-claude-streamable-http\",\"run-http-self-host\",\"run-stdio-glama-claude-desktop\",\"configure-env\",\"example-buy-a-gaia-open-meteo-reading\",{\"_2109\":2114,\"_2112\":1926},{\"_2109\":2113,\"_2112\":1923},{\"_2109\":2110,\"_2111\":110,\"_2112\":1919},\"answer\",\"1. Click on \\\"Deploy Server\\\".\\n2. Wait a few minutes for the server to deploy. Once ready, it will show a \\\"Started\\\" state.\\n3. In the chat, type `@` followed by the MCP server name and your instructions, e.g., \\\"\\\\@aimarket\\\\-mcp search for recent breakthroughs in AI\\\"\\n\\nThat's it! The server will respond to your query, and you can continue using it as needed.\\n\\nHere is a [step-by-step guide with screenshots](https://glama.ai/blog/2025-07-08-how-to-install-and-use-mcp-servers).\",\"followInternalLinks\",\"question\",\"Provides live web search via [DuckDuckGo](/mcp/servers/integrations/duckduckgo), returning top snippets.\",\"This MCP gateway provides hardened web access, Metis verification, and AIMarket capability discovery/invocation.\\n\\n* Fetch a public web page by URL and return its main text, with SSRF protections and `\u003cuntrusted\u003e` wrapping.\\n* Search the live web via DuckDuckGo and get top result snippets.\\n* Run Metis cognition + verification on an input, returning an answer with `verify_score`/`verified` metadata and selectable route.\\n* Search an AIMarket hub for priced capabilities by intent, category, limit, and max price without a wallet or key.\\n* Invoke a discovered capability on the hub's free trial tier, returning output plus a signed receipt nonce and reporting 402 when trial allowance is exhausted.\",\"favoriteCount\",\"githubUser\",\"hasSourceTree\",\"isFavorited\",{\"_223\":2008,\"_2009\":2010,\"_230\":896,\"_235\":2122,\"_242\":24,\"_246\":896,\"_255\":-5,\"_68\":2021},\"navWarnings\",\"visitorIsMaintainer\",{\"_285\":2123,\"_246\":1939},{\"_2070\":2124},{\"_296\":1939},\"pageSessionReferenceId\",\"01a1c6a4-feff-756c-8a74-35c63b94aa84\",\"renderedAt\",1794334064382,\"toasts\",[],\"visitor\",{\"_2133\":2134,\"_49\":2135},\"viewportWidth\",1280,{\"_223\":2136,\"_2137\":24,\"_233\":-5,\"_2138\":-5,\"_2139\":2140,\"_2141\":18,\"_52\":-5},[],\"hasRecentReleaseNote\",\"membership\",\"referenceId\",\"01a1c6a4-fe9d-7289-b057-9eb42e0332c8\",\"unreadReleaseNotesCount\"]\n");</script><!--$?--><template id="B:1"></template><!--/$--></div><script nonce="0c9b2f9a64d68193dae09b3beff33d81">$RB=[];$RV=function(a){$RT=performance.now();for(var b=0;b<a.length;b+=2){var c=a[b],e=a[b+1];null!==e.parentNode&&e.parentNode.removeChild(e);var f=c.parentNode;if(f){var g=c.previousSibling,h=0;do{if(c&&8===c.nodeType){var d=c.data;if("/$"===d||"/&"===d)if(0===h)break;else h--;else"$"!==d&&"$?"!==d&&"$~"!==d&&"$!"!==d&&"&"!==d||h++}d=c.nextSibling;f.removeChild(c);c=d}while(c);for(;e.firstChild;)f.insertBefore(e.firstChild,c);g.data="$";g._reactRetry&&requestAnimationFrame(g._reactRetry)}}a.length=0};
$RC=function(a,b){if(b=document.getElementById(b))(a=document.getElementById(a))?(a.previousSibling.data="$~",$RB.push(a,b),2===$RB.length&&("number"!==typeof $RT?requestAnimationFrame($RV.bind(null,$RB)):(a=performance.now(),setTimeout($RV.bind(null,$RB),2300>a&&2E3<a?2300-a:$RT+300-a)))):b.parentNode.removeChild(b)};$RC("B:0","S:0")</script><div hidden id="S:1"><script nonce="0c9b2f9a64d68193dae09b3beff33d81">window.__reactRouterContext.streamController.close();</script></div><script nonce="0c9b2f9a64d68193dae09b3beff33d81">$RC("B:1","S:1")</script></body></html>
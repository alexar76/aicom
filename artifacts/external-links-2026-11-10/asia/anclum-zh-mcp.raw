<script type="application/ld+json">{"@context": "https://schema.org", "@graph": [{"@type": "Organization", "@id": "https://anclum.com/#org", "name": "Anclum", "alternateName": ["Anclum", "技能潮", "anclum.com"], "url": "https://anclum.com/", "logo": {"@type": "ImageObject", "url": "https://anclum.com/favicon-192.png", "width": 192, "height": 192}, "description": "面向开发者与 AI Agent 的独立索引：MCP 服务、Agent 技能与开源 AI 工具。", "sameAs": ["https://github.com/wdfdaivd/skilltide-mcp"]}, {"@type": "WebSite", "name": "Anclum", "alternateName": ["Anclum", "技能潮"], "url": "https://anclum.com/", "description": "面向开发者与 AI Agent 的独立索引：MCP 服务、Agent 技能与开源 AI 工具。", "publisher": {"@id": "https://anclum.com/#org"}, "inLanguage": ["en", "zh"], "potentialAction": {"@type": "SearchAction", "target": {"@type": "EntryPoint", "urlTemplate": "https://anclum.com/zh/?q={search_term_string}"}, "query-input": "required name=search_term_string"}}]}</script><script async src="https://www.googletagmanager.com/gtag/js?id=G-WNKGF1WB1T"></script><script>window.dataLayer=window.dataLayer||[];function gtag(){dataLayer.push(arguments);}gtag("js",new Date());gtag("config","G-WNKGF1WB1T",{anonymize_ip:true});</script><!-- cmp-5c-injected --><style>
html.has-cmp body{padding-bottom:92px}
.cmpbtn{flex:none;display:inline-flex;align-items:center;gap:5px;font:inherit;font-size:11.5px;line-height:1;padding:6px 9px;border-radius:7px;border:1px solid var(--line);background:transparent;color:var(--muted);cursor:pointer;white-space:nowrap;transition:color .15s,border-color .15s,background .15s}
.rows.cards .row .lead .cmpbtn{grid-row:3;grid-column:2;justify-self:start}
/* 2026-11-04 stage2c: site.css 的 .rows.cards .row .lead .fav{display:none} 把收藏星藏了。
   这里用同权重+!important 覆盖（不动 site.css / build-frontend.py），
   并把星放进第 3 行第 1 列，与第 2 列的 Compare 按钮同行不重叠。 */
.rows.cards .row .lead .fav{display:inline-flex!important;align-items:center;justify-content:center;grid-row:3;grid-column:1;justify-self:start;width:26px;height:26px;padding:0;border:1px solid var(--line);border-radius:7px;background:transparent;color:var(--muted)}
.rows.cards .row .lead .fav:hover{color:var(--star);border-color:var(--star);background:var(--soft)}
.rows.cards .row .lead .fav.on{color:var(--star);border-color:var(--star)}
.rows.cards .row .lead .fav svg{width:13px;height:13px}
.cmpbtn:hover{border-color:var(--accent);color:var(--accent)}
.cmpbtn .cmpmark{display:inline-block;width:11px;height:11px;border:1px solid currentColor;border-radius:3px;font-size:9px;line-height:9px;text-align:center;font-weight:700;box-sizing:border-box}
.cmpbtn[aria-pressed="true"]{border-color:var(--accent);background:var(--accent-soft);color:var(--accent);font-weight:650}
.cmpbtn[aria-pressed="true"] .cmpmark{background:var(--accent);color:var(--card);border-color:var(--accent)}
.cmpbtn[aria-pressed="true"] .cmpmark::before{content:"\2713"}
.cmp-tray{position:fixed;left:0;right:0;bottom:0;z-index:60;background:var(--hdr);border-top:1px solid var(--line);box-shadow:0 -8px 22px rgba(15,42,36,.10);-webkit-backdrop-filter:blur(12px);backdrop-filter:blur(12px);padding:10px 16px calc(10px + env(safe-area-inset-bottom))}
.cmp-tray[hidden]{display:none}
.cmp-trayin{max-width:1080px;margin:0 auto;display:flex;align-items:center;gap:12px}
.cmp-count{flex:none;font-size:12px;font-weight:650;color:var(--fg2)}
.cmp-names{flex:1 1 auto;min-width:0;font-size:12px;color:var(--muted);white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.cmp-go{flex:none;font:inherit;font-size:12.5px;font-weight:650;padding:8px 14px;border:1px solid var(--accent);border-radius:8px;background:var(--accent);color:#fff;cursor:pointer}
.cmp-go:hover{background:var(--brand)}
.cmp-clear{flex:none;font:inherit;font-size:12px;padding:7px 11px;border:1px solid var(--line);border-radius:8px;background:transparent;color:var(--muted);cursor:pointer}
.cmp-clear:hover{color:var(--fg2);border-color:var(--muted)}
.cmp-toast{position:fixed;left:50%;bottom:96px;transform:translateX(-50%) translateY(6px);z-index:70;background:var(--fg2);color:var(--bg);font-size:12.5px;padding:8px 14px;border-radius:8px;opacity:0;pointer-events:none;transition:opacity .18s,transform .18s}
.cmp-toast.show{opacity:1;transform:translateX(-50%) translateY(0)}
/* 2026-11-04 stage2c: 页脚附近一行收藏页入口（族内注入，不动 nav） */
.cmp-savelink{margin:0;padding:2px 0 18px;font-size:11.5px;color:var(--muted);text-align:center}
.cmp-savelink a{color:var(--muted);text-decoration:none;border-bottom:1px dotted rgba(148,163,184,.6)}
.cmp-savelink a:hover{color:var(--accent);border-bottom-color:var(--accent)}
@media(max-width:640px){html.has-cmp body{padding-bottom:156px}.cmp-tray{bottom:66px;padding:8px 12px}.cmp-trayin{flex-wrap:wrap;gap:8px}.cmp-names{flex:1 1 100%;order:3;white-space:normal;display:-webkit-box;-webkit-line-clamp:1;-webkit-box-orient:vertical;overflow:hidden}.cmp-go,.cmp-clear{padding:7px 11px}.cmp-toast{bottom:150px}}
</style>

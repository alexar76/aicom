(function(){var d=document.documentElement,b=document.getElementById('tgl');
if(!b)return;
function sys(){return (window.matchMedia&&matchMedia('(prefers-color-scheme:dark)').matches)?'dark':'light';}
function eff(){var t=d.getAttribute('data-theme');return (t==='dark'||t==='light')?t:sys();}
function paint(m){d.setAttribute('data-mode',m);b.setAttribute('aria-pressed',m==='dark'?'true':'false');
 b.setAttribute('title',m==='dark'?b.dataset.light:b.dataset.dark);}
// The click sets an explicit choice. Clicking always lands on the opposite of what is on screen,
// including when the screen is dark because the OS is dark.
b.addEventListener('click',function(){var n=eff()==='dark'?'light':'dark';
 d.setAttribute('data-theme',n);
 try{localStorage.setItem('theme',n);document.cookie='theme='+n+';path=/;max-age=31536000;SameSite=Lax';}catch(e){}
 paint(n);});
paint(eff());
// With no explicit choice the page follows the OS, so the icon has to follow it too - otherwise
// the button shows a moon while the page is already dark.
if(window.matchMedia&&matchMedia('(prefers-color-scheme:dark)').addEventListener){
 matchMedia('(prefers-color-scheme:dark)').addEventListener('change',function(){
  if(!d.getAttribute('data-theme'))paint(sys());});}
})();

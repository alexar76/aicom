ex text-sm font-semibold text-[#1d4ed8]\",\"children\":\"GitHub\"}],[\"$\",\"p\",null,{\"className\":\"mt-2 text-xs text-[#5c6570]\",\"children\":[[[\"$\",\"span\",\"langgraph\",{\"children\":[\"\",[\"$\",\"$L8\",null,{\"href\":\"/stack/langgraph\",\"className\":\"font-semibold text-[#12151c]\",\"children\":\"LangGraph\"}]]}],[\"$\",\"span\",\"mcp\",{\"children\":[\", \",[\"$\",\"$L8\",null,{\"href\":\"/stack/mcp\",\"className\":\"font-semibold text-[#12151c]\",\"children\":\"MCP\"}]]}],[\"$\",\"span\",\"python\",{\"children\":[\", \",[\"$\",\"$L8\",null,{\"href\":\"/stack/python\",\"className\":\"font-semibold text-[#12151c]\",\"children\":\"Python\"}]]}]],\"\"]}]]}]\n39:[\"$\",\"li\",\"ff22d8fe-f841-4f73-9963-df5181053538\",{\"className\":\"px-4 py-4\",\"children\":[[\"$\",\"div\",null,{\"className\":\"flex flex-wrap items-center gap-2 text-xs font-semibold uppercase tracking-wide text-[#5c6570]\",\"children\":[null,null,null,null,[\"$\",\"time\",null,{\"dateTime\":\"2026-11-02T01:15:44.000Z\",\"children\":\"2026-11-02\"}],null]}],[\"$\",\"h2\",null,{\"className\":\"mt-2 text-xl font-semibold tracking-tight text-[#12151c]\",\"children\":[\"$\",\"$L8\",null,{\"href\":\"/l/show-hn-echochain-to-see-what-happens-when-llms-play-telephone\",\"className\":\"hover:text-[#1d4ed8]\",\"children\":\"Show HN: EchoChain to see what happens when LLMs play telephone\"}]}],[\"$\",\"p\",null,{\"className\":\"mt-1 text-sm leading-6 text-[#5c6570]\",\"children\":\"Hey HN Community! I created `echoChain` to explore the following phenomenon: how much data retained after LLMs exchange responses multiple times? Imagine the game of telephone but with AIs. Each model converts the response into a question, which is then answered. After several rounds, facts get mutated, details get stripped, and the answer is far removed from the initial one. `echoChain` is an OSS Python CLI that helps measure this process. It allows for multi-model testing, model rotation, trac\"}],[\"$\",\"a\",null,{\"hre
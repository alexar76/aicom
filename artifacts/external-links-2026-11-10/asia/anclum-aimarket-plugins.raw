<header><div class="wrap hd">
  <a class="brand" href="/zh/"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 32 32">
<defs>
<linearGradient id="g" x1="0" y1="0" x2="0" y2="1">
<stop offset="0" stop-color="#193e35"/>
<stop offset="1" stop-color="#4c1d95"/>
</linearGradient>
</defs>
<circle cx="16" cy="16" r="15" fill="url(#g)"/>
<path d="M6.5 21.5c2.2-4.2 5.6-5.8 9-4.7 2.5.8 4.3.1 6.3-2" fill="none" stroke="#eef4e4" stroke-width="2.8" stroke-linecap="round"/>

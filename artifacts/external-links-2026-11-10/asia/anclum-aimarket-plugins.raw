<script>
(function(){
  var MSG = {"ph": "搜索全站 9,759 条条目", "recent": "最近看过", "jump": "快捷跳转", "none": "没有对得上的条目", "hint": "换个工具名、领域名，或去领域页翻", "of": "共", "items": "条", "nav": "选择", "open": "打开", "toggle": "唤起", "save": "收藏", "saved": "已收藏"};
  var FAVK = 'anclum-fav', RECK = 'anclum-recent';
  function favs(){ try { return JSON.parse(localStorage.getItem(FAVK) || '[]'); } catch(e){ return []; } }
  function recent(){ try { return JSON.parse(localStorage.getItem(RECK) || '[]'); } catch(e){ return []; } }
  function paint(){
    document.querySelectorAll('[data-fav]').forEach(function(b){
      var on = favs().indexOf(b.getAttribute('data-fav')) >= 0;
      b.classList.toggle('on', on);
      if (b.hasAttribute('data-fav-label')) b.innerHTML = (on ? '\u2605 ' : '\u2606 ') + (on ? MSG.saved : MSG.save);
    });
  }
  document.addEventListener('click', function(e){
    var b = e.target && e.target.closest ? e.target.closest('[data-fav]') : null;
    if (!b) return;
    var s = b.getAttribute('data-fav'), a = favs(), i = a.indexOf(s);
    if (i >= 0) a.splice(i, 1); else a.push(s);
    try { localStorage.setItem(FAVK, JSON.stringify(a)); } catch(err){}
    paint();
  });
  paint();

  // ---- command palette ----
  var box = document.getElementById('cmdk'), input = document.getElementById('cmdq'),
      list = document.getElementById('cmdlist'), index = null, sel = 0, rows = [];

  function esc(s){ var d = document.createElement('div'); d.textContent = s; return d.innerHTML; }
  // ★ 2026-10-23: 多词检索。旧版把整串查询当一个子串去 indexOf ——
  //   "pdf table sql" 必须是连着的三个词才命中，所以自然语言查询 0 结果，而单个词能搜到，
  //   看起来"能用"。现在: 每个词都必须命中(AND)，名字命中权重最高，整串命中额外加分。
  // ★ 2026-10-23 v2: 两档检索。
  //   ① 每个词都命中（AND）→ 按"名字命中 > 词首命中 > 整串命中"打分；
  //   ② 一条 AND 都没有时，退一档：按"命中了几个词"排序（至少 2 个词，或 1 个词的查询命中 1 个）。
  //   为什么要 ②: 索引里的说明只存前 80 字，用户写一句自然语言时 AND 必然太严 ——
  //   实测"pdf table sql"在 ① 档 0 条，而库里明明有 PDF 工具。退一档比空结果诚实，也比放宽成 OR 更少噪音。
  //   停用词只去【纯英文】的功能词（a/to/and/how…）；中文不分词，整串当一个 token，
  //   所以绝不对中文做停用词处理 —— 把"做"去掉会让"做PPT"搜不到。
  // ★ 2026-10-23 v3: 三档检索（每档都要能单独解释清楚，不靠玄学权重）。
  //   ① 严格档：每个词都命中（AND）—— 名字命中 > 词首命中 > 整串命中，按分排序；
  //   ② 退让档：一条 AND 都没有时，按"命中了几个词"排序（至少 2 个词）；
  //   ③ 中文切分档：中文没有空格，"视频剪辑"在库里是"视频"和"剪辑"分散出现的，
  //      整串必然搜不到。所以中文串长度 ≥3 时切成 2 字片段（视频/频剪/剪辑），
  //      命中 ≥2 个片段就算候选。这是补召回，不是补发明 —— 只对库里确有这些字串的条目排序。
  //   为什么要②③: 旧版把整串当一个子串 indexOf，实测"pdf table sql""screenshot website"
  //   在 8k 条里全是 0 条，而库里明明有这些工具 —— 看起来能用，其实只会单词检索。
  var STOP = {a:1,an:1,the:1,to:1,for:1,of:1,in:1,on:1,at:1,with:1,and:1,or:1,that:1,
              this:1,it:1,is:1,are:1,be:1,i:1,my:1,me:1,we:1,you:1,your:1,need:1,want:1,
              find:1,looking:1,how:1,what:1,which:1,can:1,some:1,any:1,from:1,into:1,do:1,
              make:1,using:1,use:1,tool:1,tools:1,best:1,good:1};
  // 中文只在【词首】剥掉这些动词/客套词（"做ppt"→"ppt"）；不从中间删，
  // 因为"做"出现在"做法"里时不能动。中文不分词、不整体当停用词。
  var CJPRE = ['帮我找', '帮我', '我要', '我想', '求推荐', '推荐', '怎么', '如何', '有没有', '做', '用', '找', '要'];
  function stripCjk(t){
    for (var guard = 0; guard < 4; guard++){
      var cut = false;
      for (var i = 0; i < CJPRE.length; i++){
        var p = CJPRE[i];
        if (t.length > p.length && t.indexOf(p) === 0){ t = t.slice(p.length); cut = true; break; }
      }
      if (!cut) break;
    }
    return t;
  }
  function grams(t){
    if (t.length >= 3 && /[一-鿿]/.test(t)) {
      var g = [];
      for (var i = 0; i + 2 <= t.length; i++) g.push(t.slice(i, i + 2));
      return g;
    }
    return [t];
  }
  function rank(idx, q, cap){
    if (!idx) return [];
    var raw = (q || '').trim().toLowerCase();
    var CJ1 = {'做':1,'用':1,'要':1,'找':1,'的':1,'了':1,'和':1,'与':1,'或':1,'个':1,'些':1};
    var orig = raw.split(/\s+/).filter(Boolean);
    var toks = orig.filter(function(t){
                 return !(STOP[t] === 1) && !(t.length === 1 && CJ1[t] === 1);
               }).map(stripCjk).filter(Boolean).slice(0, 8);
    if (!toks.length) toks = orig.slice(0, 8);
    if (!toks.length) return [];
    var strict = [], loose = [], weak = [], allg = [];
    // 最弱一档只对中文开: 中文没有空格，切分错是常态；英文查询走弱档只会变噪音。
    var hasCjk = /[一-鿿]/.test(raw);
    for (var k = 0; k < toks.length; k++){
      var gg = grams(toks[k]);
      for (var m = 0; m < gg.length; m++) allg.push(gg[m]);
    }
    var needStrict = toks.length, needLoose = toks.length > 1 ? 2 : 1;
    for (var i = 0; i < idx.length; i++){
      var x = idx[i], nm = (x.n || '').toLowerCase();
      var hay = (nm + ' ' + (x.d || '') + ' ' + (x.f || '')).toLowerCase();
      var sc = 0, hit = 0, ghit = 0;
      for (var t = 0; t < toks.length; t++){
        var at = hay.indexOf(toks[t]);
        if (at < 0) continue;
        hit++; sc += 10;
        if (nm.indexOf(toks[t]) >= 0) sc += 12;
        if (at === 0 || hay.charAt(at - 1) === ' ') sc += 4;
      }
      for (var u = 0; u < allg.length; u++){
        if (hay.indexOf(allg[u]) >= 0) ghit++;
      }
      if (hit === needStrict){
        if (hay.indexOf(raw) >= 0) sc += 30;
        strict.push([sc, ghit, i, x]);
      } else if (hit >= needLoose){
        loose.push([hit * 100 + sc, ghit, i, x]);
      } else if (allg.length > 1 && ghit >= 2){
        loose.push([ghit * 50 + sc, ghit, i, x]);
      } else if (hasCjk && ghit >= 1){
        weak.push([ghit * 10 + sc, ghit, i, x]);
      }
    }
    var res = strict.length ? strict : (loose.length ? loose : weak);
    res.sort(function(a, b){ return b[0] - a[0] || b[1] - a[1] || a[2] - b[2]; });
    return res.slice(0, cap).map(function(p){ return p[3]; });
  }
  window.anclumRank = rank;
  function load(){
    if (index) return index;
    list.innerHTML = '<div class="grp">\u2026</div>';
    fetch('/search-index.json', {cache: 'force-cache'}).then(function(r){ return r.json(); })
      .then(function(j){ index = j; render(input.value); })
      .catch(function(){ list.innerHTML = '<div class="grp">' + esc(MSG.hint) + '</div>'; });
    return null;
  }
  function item(it){
    return '<div class="it" data-slug="' + esc(it.s) + '">' +
      '<div class="t"><div class="n">' + esc(it.n) + '</div><div class="d">' + esc(it.d || '') + '</div></div>' +
      '<div class="r"><span class="tag">' + esc(it.f || '') + '</span>' + esc(it.s || '') + '</div></div>';
  }
  function jumpRow(u, t){
    return '<div class="it" data-jump="' + esc(u) + '"><div class="t"><div class="n">' + esc(t) +
           '</div></div><div class="r">\u21b5</div></div>';
  }
  var JUMPS = [["/zh/f/mcp/", "MCP 服务"], ["/zh/r/new/", "最近收录"], ["/zh/r/stars/", "GitHub Star 榜"], ["/zh/", "按领域浏览"]];
  function render(q){
    q = (q || '').trim().toLowerCase();
    var html = '';
    if (!q){
      var rec = recent();
      if (rec.length){
        html += '<div class="grp">' + esc(MSG.recent) + '</div>';
        rec.slice(0, 5).forEach(function(s){
          var it = index && index.find(function(x){ return x.s === s; });
          if (it) html += item(it);
        });
      }
      html += '<div class="grp">' + esc(MSG.jump) + '</div>';
      JUMPS.forEach(function(j){ html += jumpRow(j[0], j[1]); });
      rows = [];
    } else {
      var hits = rank(index, q, 8);
      html += '<div class="grp">' + hits.length + ' ' + esc(MSG.of) + ' ' + (index ? index.length : 0) + ' ' + esc(MSG.items) + '</div>';
      if (!hits.length && index) html += '<div class="it"><div class="t"><div class="n">' + esc(MSG.none) + '</div><div class="d">' + esc(MSG.hint) + '</div></div></div>';
      hits.forEach(function(it){ html += item(it); });
      rows = hits;
    }
    list.innerHTML = html;
    sel = 0; mark();
  }
  function mark(){
    var its = list.querySelectorAll('.it');
    its.forEach(function(el, i){ el.classList.toggle('sel', i === sel); });
    if (its[sel]) its[sel].scrollIntoView({block: 'nearest'});
  }
  function go(el){
    if (!el) return;
    var s = el.getAttribute('data-slug'), u = el.getAttribute('data-jump');
    if (s){
      var r = recent().filter(function(x){ return x !== s; });
      r.unshift(s);
      try { localStorage.setItem(RECK, JSON.stringify(r.slice(0, 10))); } catch(e){}
      location.href = '/zh/s/' + s + '/';
    } else if (u){
      location.href = u;
    }
  }
  list.addEventListener('click', function(e){
    var el = e.target && e.target.closest ? e.target.closest('.it') : null;
    if (el) go(el);
  });
  input.addEventListener('input', function(){ if (index) render(input.value); });
  document.addEventListener('keydown', function(e){
    if ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === 'k'){
      e.preventDefault(); box.classList.contains('open') ? close() : open();
    } else if (e.key === 'Escape'){ close(); }
    else if (box.classList.contains('open') && (e.key === 'ArrowDown' || e.key === 'ArrowUp')){
      e.preventDefault();
      var n = list.querySelectorAll('.it').length;
      if (n){ sel = (sel + (e.key === 'ArrowDown' ? 1 : -1) + n) % n; mark(); }
    } else if (box.classList.contains('open') && e.key === 'Enter'){
      e.preventDefault();
      var its = list.querySelectorAll('.it');
      if (its[sel]) go(its[sel]);
    }
  });
  // ★ 2026-10-17 首页减法 ①: open(v) 接受首页大搜索框交来的查询词。
  //   不传 = 原来的行为（清空并显示最近/跳转），所以导航栏那个搜索图标一个字没变。
  function open(v){ box.classList.add('open'); input.value = v || ''; load(); render(input.value); setTimeout(function(){ input.focus(); }, 30); }
  function close(){ box.classList.remove('open'); }
  box.addEventListener('click', function(e){ if (e.target === box) close(); });
  // 2026-10-20 mobile bar "More" sheet: <details> does not close on outside click or
  // Esc, so without this it stays open and covers the bar it lives in.
  function closeTabMore(){
    document.querySelectorAll('.tabbar details.tabmore[open]').forEach(function(d){
      d.removeAttribute('open');
    });
  }
  document.addEventListener('click', function(e){
    var tg = e.target;
    if (!tg || !tg.closest || !tg.closest('.tabbar details.tabmore')) closeTabMore();
  });
  document.addEventListener('keydown', function(e){
    if (e.key === 'Escape') closeTabMore();
  });
  window.anclumCmdk = { open: open, close: close };
})();
</script>

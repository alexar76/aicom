<script type="application/ld+json">{"@context": "https://schema.org", "@graph": [{"@type": "Organization", "@id": "https://anclum.com/#org", "name": "Anclum", "alternateName": ["Anclum", "技能潮", "anclum.com"], "url": "https://anclum.com/", "logo": {"@type": "ImageObject", "url": "https://anclum.com/favicon-192.png", "width": 192, "height": 192}, "description": "面向开发者与 AI Agent 的独立索引：MCP 服务、Agent 技能与开源 AI 工具。", "sameAs": ["https://github.com/wdfdaivd/skilltide-mcp"]}, {"@type": "WebSite", "name": "Anclum", "alternateName": ["Anclum", "技能潮"], "url": "https://anclum.com/", "description": "面向开发者与 AI Agent 的独立索引：MCP 服务、Agent 技能与开源 AI 工具。", "publisher": {"@id": "https://anclum.com/#org"}, "inLanguage": ["en", "zh"], "potentialAction": {"@type": "SearchAction", "target": {"@type": "EntryPoint", "urlTemplate": "https://anclum.com/zh/?q={search_term_string}"}, "query-input": "required name=search_term_string"}}]}</script><script async src="https://www.googletagmanager.com/gtag/js?id=G-WNKGF1WB1T"></script><script>window.dataLayer=window.dataLayer||[];function gtag(){dataLayer.push(arguments);}gtag("js",new Date());gtag("config","G-WNKGF1WB1T",{anonymize_ip:true});</script><meta name="robots" content="noindex,follow"></head><body>

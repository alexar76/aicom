# Memory Market <-> Provenance Ledger, once an hour (timer beside this file):
#  1. attest units whose write-time receipt never landed (a ledger outage leaves them unattested);
#  2. --check: every attested unit's recorded receipt must still be in its ledger chain with the
#     chain root the ledger returned, and must verify. A mismatch fails this unit (exit 2) and is
#     printed to the journal: journalctl -u attested-provenance-reconcile
# Install: copy both files to /etc/systemd/system, then systemctl enable --now attested-provenance-reconcile.timer
[Unit]
Description=Attested Memory: reconcile and cross-check provenance receipts
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
WorkingDirectory=/opt/aicom/attested/attested-memory-hub
# A failed attest (ledger down) must not skip the check, hence the leading '-'.
ExecStart=-/usr/bin/docker compose exec -T memory-market python -m memory_market.reconcile_provenance
ExecStart=/usr/bin/docker compose exec -T memory-market python -m memory_market.reconcile_provenance --check

0-17T09:11:55","upload_time_iso_8601":"2026-10-17T09:11:55.773008Z","url":"https://files.pythonhosted.org/packages/3c/03/d09309364c563c99d73e0b98ac04ce3708dbaad8338e3e8a6e1d81e79e0c/aimarket_signal_hunt-0.1.1-py3-none-any.whl","yanked":false,"yanked_reason":null},{"comment_text":null,"core-metadata":false,"digests":{"blake2b_256":"16b20e10f98a6ec89cddbf5c762966b4b750389fddc4efd09f4736b4eaf943c2","md5":"9d495ebd4c55dff951276e1736b639e4","sha256":"e66af23426e8b6379ed46dc0badf0032f73c6e0571f06d3d8ebc93abb377eaa9"},"downloads":-1,"filename":"aimarket_signal_hunt-0.1.1.tar.gz","has_sig":false,"md5_digest":"9d495ebd4c55dff951276e1736b639e4","packagetype":"sdist","python_version":"source","requires_python":">=3.11","size":52814,"upload_time":"2026-10-17T09:11:56","upload_time_iso_8601":"2026-10-17T09:11:56.946110Z","url":"https://files.pythonhosted.org/packages/16/b2/0e10f98a6ec89cddbf5c762966b4b750389fddc4efd09f4736b4eaf943c2/aimarket_signal_hunt-0.1.1.tar.gz","yanked":false,"yanked_reason":null}],"0.1.2":[{"comment_text":null,"core-metadata":{"sha256":"a8e678217d5573814cb1a519d6964038ae479c0662ce2015a802cd9f5abf118b"},"digests":{"blake2b_256":"5c7b547a3bef9909398ffae65339ca53c0dfbfd5d46a4af80b61b118f50a3f22","md5":"b26fadb4345d5c4203b449051a38f430","sha256":"19c98f86dccd2e24298871c1e935c938ce9be3a4e6097e190e13b562ac388a5a"},"downloads":-1,"filename":"aimarket_signal_hunt-0.1.2-py3-none-any.whl","has_sig":false,"md5_digest":"b26fadb4345d5c4203b449051a38f430","packagetype":"bdist_wheel","python_version":"py3","requires_python":">=3.11","size":47181,"upload_time":"2026-10-24T18:00:33","upload_time_iso_8601":"2026-10-24T18:00:33.336706Z","url":"https://files.pythonhosted.org/packages/5c/7b/547a3bef9909398ffae65339ca53c0dfbfd5d46a4af80b61b118f50a3f22/aimarket_signal_hunt-0.1.2-py3-none-any.whl","yanked":false,"yanked_reason":null},{"comment_text":null,"core-metadata":false,"digests":{"blake2b_256":"c5ec0b339c93db491519324fb93f6ea3233dde00cd07d98e36b5ca2fc73d5adb","md5":"152ec4f5f18f74d859eddf9e40dd82fd","sha256":"178dd38909e11cd7b7bbbec3e6f72f290e5d5fb95f3b8314f529db280090b3aa"},"downloads":-1,"filename":"aimarket_signal_hunt-0.1.2.tar.gz","has_sig":false,"md5_digest":"152ec4f5f18f74d859eddf9e40dd82fd","packagetype":"sdist","python_version":"source","requires_python":">=3.11","size":54787,"upload_time":"2026-10-24T18:00:34","upload_time_iso_8601":"2026-10-24T18:00:34.605188Z","url":"https://files.pythonhosted.org/packages/c5/ec/0b339c93db491519324fb93f6ea3233dde00cd07d98e36b5ca2fc73d5adb/aimarket_signal_hunt-0.1.2.tar.gz","yanked":false,"yanked_reason":null}]},"urls":[{"comment_text":null,"core-metadata":{"sha256":"a8e678217d5573814cb1a519d6964038ae479c0662ce2015a802cd9f5abf118b"},"digests":{"blake2b_256":"5c7b547a3bef9909398ffae65339ca53c0dfbfd5d46a4af80b61b118f50a3f22","md5":"b26fadb4345d5c4203b449051a38f430","sha256":"19c98f86dccd2e24298871c1e935c938ce9be3a4e6097e190e13b562ac388a5a"},"downloads":-1,"filename":"aimarket_signal_hunt-0.1.2-py3-none-any.whl","has_sig":false,"md5_digest":"b26fadb4345d5c4203b449051a38f430","packagetype":"bdist_wheel","python_version":"py3","requires_python":">=3.11","size":47181,"upload_time":"2026-10-24T18:00:33","upload_time_iso_8601":"2026-10-24T18:00:33.336706Z","url":"https://files.pythonhosted.org/packages/5c/7b/547a3bef9909398ffae65339ca53c0dfbfd5d46a4af80b61b118f50a3f22/aimarket_signal_hunt-0.1.2-py3-none-any.whl","yanked":false,"yanked_reason":null},{"comment_text":null,"core-metadata":false,"digests":{"blake2b_256":"c5ec0b339c93db491519324fb93f6ea3233dde00cd07d98e36b5ca2fc73d5adb","md5":"152ec4f5f18f74d859eddf9e40dd82fd","sha256":"178dd38909e11cd7b7bbbec3e6f72f290e5d5fb95f3b8314f529db280090b3aa"},"downloads":-1,"filename":"aimarket_signal_hunt-0.1.2.tar.gz","has_sig":false,"md5_digest":"152ec4f5f18f74d859eddf9e40dd82fd","packagetype":"sdist","python_version":"source","requires_python":">=3.11","size":54787,"upload_time":"2026-10-24T18:00:34","upload_time_iso_8601":"2026-10-24T18:00:34.605188Z","url":"https://files.pythonhosted.org/packages/c5/ec/0b339c93db491519324fb93f6ea3233dde00cd07d98e36b5ca2fc73d5adb/aimarket_signal_hunt-0.1.2.tar.gz","yanked":false,"yanked_reason":null}],"vulnerabilities":[]}

py3","requires_python":">=3.11","size":69835,"upload_time":"2026-10-25T13:59:21","upload_time_iso_8601":"2026-10-25T13:59:21.277762Z","url":"https://files.pythonhosted.org/packages/4f/87/32367eb80f54f46f46ea0ed6b0a28d08463f5ad615b99e44bd55ab7a86c8/helios_broadcast-0.2.1-py3-none-any.whl","yanked":false,"yanked_reason":null},{"comment_text":null,"core-metadata":false,"digests":{"blake2b_256":"2d9a124dfcc2441aa5a3e9a47e2979fdaa9564623f449a46377af33a3d8f7a01","md5":"f30bceec742ff1edd361e96301a8a608","sha256":"28b7e3b9706ae111879374e6c227fa4db7c059b37e89fe567830f7db633ba5ac"},"downloads":-1,"filename":"helios_broadcast-0.2.1.tar.gz","has_sig":false,"md5_digest":"f30bceec742ff1edd361e96301a8a608","packagetype":"sdist","python_version":"source","requires_python":">=3.11","size":73752,"upload_time":"2026-10-25T13:59:22","upload_time_iso_8601":"2026-10-25T13:59:22.764423Z","url":"https://files.pythonhosted.org/packages/2d/9a/124dfcc2441aa5a3e9a47e2979fdaa9564623f449a46377af33a3d8f7a01/helios_broadcast-0.2.1.tar.gz","yanked":false,"yanked_reason":null}],"0.2.2":[{"comment_text":null,"core-metadata":{"sha256":"62fe0c03b176e7ead1ccf58659bf95a7f36bafaa205031f0ad15ca35870d27bb"},"digests":{"blake2b_256":"a6753c7eee3b7408c7cfbbb276ae61a1ad60e9c182a9c80c5db7c9e028ecf7d5","md5":"ffc6057abc3b36dfe911db16c3fe5ddd","sha256":"42f32f768d0b25cfe01ec731c84f0f5a9f84923dde5dc9a5af3c43c70ddc7d1a"},"downloads":-1,"filename":"helios_broadcast-0.2.2-py3-none-any.whl","has_sig":false,"md5_digest":"ffc6057abc3b36dfe911db16c3fe5ddd","packagetype":"bdist_wheel","python_version":"py3","requires_python":">=3.11","size":71154,"upload_time":"2026-11-08T15:06:51","upload_time_iso_8601":"2026-11-08T15:06:51.215448Z","url":"https://files.pythonhosted.org/packages/a6/75/3c7eee3b7408c7cfbbb276ae61a1ad60e9c182a9c80c5db7c9e028ecf7d5/helios_broadcast-0.2.2-py3-none-any.whl","yanked":false,"yanked_reason":null},{"comment_text":null,"core-metadata":false,"digests":{"blake2b_256":"77c0c63d1b6227c8801d7179910dc4d3
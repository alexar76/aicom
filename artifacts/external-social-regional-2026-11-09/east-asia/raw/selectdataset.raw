4.672L494.592 874.624a29.12 29.12 0 0 1-41.728 0 30.59 30.59 0 0 1 0-42.752L764.736 512 452.864 192a30.59 30.59 0 0 1 0-42.688m-256 0a29.12 29.12 0 0 1 41.728.064L570.24 489.664a32 32 0 0 1 0 44.672L238.592 874.624a29.12 29.12 0 0 1-41.728 0 30.59 30.59 0 0 1 0-42.752L508.736 512 196.864 192a30.59 30.59 0 0 1 0-42.688"></path></svg><!--]--></i><div class="qr-body" data-v-96f850f4><div class="qr-code" data-v-96f850f4><img src="/_nuxt/the_copyright_qrcode_1.CawCJ2DB.png" alt="二维码" class="qr-image" data-v-96f850f4></div><div class="qr-title" data-v-96f850f4>社区交流群</div><!----></div><div class="qr-divider" data-v-96f850f4></div><div class="qr-body" data-v-96f850f4><div class="qr-code" data-v-96f850f4><img src="/_nuxt/the_copyright_qrcode_2.pbjWW3Y0.png" alt="二维码" class="qr-image" data-v-96f850f4></div><div class="qr-title" data-v-96f850f4>科研交流群</div><!----></div><section class="business-mini" style="background-image:url(/_nuxt/dataset_side_business_panel_mini_bg.DP9UqLr1.png);" aria-label="商业服务入口" data-v-96f850f4><div class="business-mini__title" data-v-96f850f4>商业服务</div><!--[--><button type="button" class="business-mini__item--primary business-mini__item" data-v-96f850f4><span class="business-mini__media" data-v-96f850f4><img class="business-mini__icon--source business-mini__icon" src="/_nuxt/dataset_side_business_source_icon.ObpUHXaW.png" alt="数据资源寻源服务" data-v-96f850f4><span class="business-mini__icon-shadow" aria-hidden="true" data-v-96f850f4></span></span><span class="business-mini__content" data-v-96f850f4><span class="business-mini__name" data-v-96f850f4>数据资源</span><span class="business-mini__name" data-v-96f850f4>寻源服务</span></span><img class="business-mini__arrow" src="/_nuxt/icon_arrow.1vQhkJ-k.png" alt="" aria-hidden="true" data-v-96f850f4></button><button type="button" class="business-mini__item" data-v-96f850f4><span class="business-mini__media" data-v-96f850f4><img class="business-mini__icon" src="/_nuxt/dataset_side_business_collection_label_icon.CbsoLrMd.png" alt="数据采集标注服务" data-v-96f850f4><span class="business-mini__icon-shadow" aria-hidden="true" data-v-96f850f4></span></span><span class="business-mini__content" data-v-96f850f4><span class="business-mini__name" data-v-96f850f4>数据采集</span><span class="business-mini__name" data-v-96f850f4>标注服务</span></span><img class="business-mini__arrow" src="/_nuxt/icon_arrow.1vQhkJ-k.png" alt="" aria-hidden="true" data-v-96f850f4></button><button type="button" class="business-mini__item" data-v-96f850f4><span class="business-mini__media" data-v-96f850f4><img class="business-mini__icon" src="/_nuxt/dataset_side_business_agency_icon.BYQfWeF5.png" alt="数据产品代理销售" data-v-96f850f4><span class="business-mini__icon-shadow" aria-hidden="true" data-v-96f850f4></span></span><span class="business-mini__content" data-v-96f850f4><span class="business-mini__name" data-v-96f850f4>数据产品</span><span class="business-mini__name" data-v-96f850f4>代理销售</span></span><img class="business-mini__arrow" src="/_nuxt/icon_arrow.1vQhkJ-k.png" alt="" aria-hidden="true" data-v-96f850f4></button><button type="button" class="business-mini__item" data-v-96f850f4><span class="business-mini__media" data-v-96f850f4><img class="business-mini__icon" src="/_nuxt/dataset_side_business_registration_icon.C8wlUKMu.png" alt="数据领域凭证登记" data-v-96f850f4><span class="business-mini__icon-shadow" aria-hidden="true" data-v-96f850f4></span></span><span class="business-mini__content" data-v-96f850f4><span class="business-mini__name" data-v-96f850f4>数据领域</span><span class="business-mini__name" data-v-96f850f4>凭证登记</span></span><img class="business-mini__arrow" src="/_nuxt/icon_arrow.1vQhkJ-k.png" alt="" aria-hidden="true" data-v-96f850f4></button><button type="button" class="business-mini__item" data-v-96f850f4><span class="business-mini__media" data-v-96f850f4><img class="business-mini__icon" src="/_nuxt/dataset_side_business_promotion_icon.zOdy9op0.png" alt="数据产品介绍推广" data-v-96f850f4><span class="business-mini__icon-shadow" aria-hidden="true" data-v-96f850f4></span></span><span class="business-mini__content" data-v-96f850f4><span class="business-mini__name" data-v-96f850f4>数据产品</span><span class="business-mini__name" data-v-96f850f4>介绍推广</span></span><img class="business-mini__arrow" src="/_nuxt/icon_arrow.1vQhkJ-k.png" alt="" aria-hidden="true" data-v-96f850f4></button><!--]--></section></div></div><!--[--><div class="login-user2" data-v-11f03726><!--teleport start--><!--teleport end--></div><!----><!--]--><!----></div><!--]--></div><div id="teleports"></div><script src="https://zz.bdstatic.com/linksubmit/push.js" async defer data-hid="baidu-linksubmit-push"></script><script src="https://lf1-cdn-tos.bytegoofy.com/goofy/ttzz/push.js?48d4a22d95c2e49cf28a5f3dd2e465e79dc913e18ae18650fa368e1ee03e25108a24d2f724c31ebe20c1e4e6fba6d91caf576100b02a2870c72f38fc574066fef065d152c73bf1cbb2ebad3b5b5265d8" id="ttzz" async defer data-hid="toutiao-ttzz-push"></script><script type="application/json" data-nuxt-data="nuxt-app" data-ssr="true" id="__NUXT_DATA__">[["ShallowReactive",1],{"data":2,"state":56,"once":66,"_errors":67,"serverRendered":36,"path":69},["ShallowReactive",3],{"71xFqTUMSp-0tNHhYQsaCrT_4yN6jW0y-BYjmdhk6e8":4,"da8JU-Xwd35tYbYNQ6LYkQJA-3AIs_AG-S861mkY9Vo":11,"related-dataset-d595b7ffd78438a48b6efa42e0861151-1":37,"JTvUHMWVZn75f0FBf1u3bQAejMI_598R1ynOyiFR8pQ":43,"related-dataset-detail-d595b7ffd78438a48b6efa42e0861151":49},{"code":5,"message":6,"data":7,"timestamp":8,"requestTime":8,"executeTime":9,"success":10},400,"参数[start_ts]为必填项",null,1794251067341,0,false,{"code":12,"message":13,"data":14,"timestamp":34,"requestTime":8,"executeTime":35,"success":36},200,"success",{"took":9,"search_result":15,"total":9,"search_error":10},{"date_dataset_update":16,"desc_translation":17,"ext_extended_field1":18,"download_status":9,"date_index_create":19,"id":20,"del_flag":9,"ext_host_name_short":21,"ext_extended_field2":7,"ext_host_name":21,"ext_extended_field3":7,"ext_org_name":17,"date_index_update":22,"date_dataset_create":23,"markdown_desc":24,"dataset_visibility":25,"ext_host_type":26,"compliance_status":7,"dataset_desc":27,"dataset_name":28,"topic_list":29,"dataset_url":32,"visit_count":25,"data_product_list":33},"2026-10-26 21:52:53","","999","2026-10-27 04:50:00","d595b7ffd78438a48b6efa42e0861151","Hugging Face","2026-10-27 16:20:01","2026-10-21 04:39:21","# HISTOR snapshot 2026-10-26: what MCP servers advertise, and when it changes\n\n## 基本信息\n\n- 数据集地址：https://huggingface.co/datasets/alexar76/histor-mcp-tool-definitions\n- pretty_name：HISTOR — MCP tool definitions and how they change\n- license：cc-by-4.0\n- language：en\n- tags：mcp、model-context-protocol、ai-security、prompt-injection、tool-poisoning、transparency-log\n- size_categories：10K\u003Cn\u003C100K\n- configs：\n  - servers：servers.jsonl.gz\n  - toolsets：toolsets.jsonl.gz\n  - changes：changes.jsonl.gz\n  - scans：scans.jsonl.gz\n  - classifications：classifications.jsonl.gz\n  - tool_extras：tool_extras.jsonl.gz\n  - extras_changes：extras_changes.jsonl.gz\n  - package_observations：package_observations.jsonl.gz\n\n## 数据集概述\n\nHISTOR 按轮询计划读取官方 MCP registry 中每个远程 MCP 服务器的工具列表（`tools/list`），并对 npm/PyPI MCP 包在沙箱中按已发布版本运行，新版本优先，每天数百个。它记录精确工具定义，按摘要固定，并在工具集首次出现、保持不变或发生变化时，将签名标签写入公共 RFC 9162 Merkle log。该快照为记录文件。\n\n- 85,913 个列出的服务器：34,171 个远程端点，51,742 个包；另有 3,364 个已下架\n- 40,738 个有记录的 tool set；11,528 个至少变更一次\n- 31,660 个记录变更，2026-09-24 至 2026-10-26\n- 66,649 个不同 tool sets，包括当前及每次变更替换的每个\n- 752 个服务器有 block-tier WARDEN pattern match，15,273 个 advise-only\n- 实时视图和每服务器页面：https://histor.modelmarket.dev\n- 代码：https://github.com/alexar76/histor\n\n## 文件\n\n| File | Rows | Size | SHA-256 |\n| --- | ---: | ---: | --- |\n| `servers.jsonl.gz` | 89,277 | 19 MB | `0c86bcf338ecb959…` |\n| `toolsets.jsonl.gz` | 66,649 | 454 MB | `88d6f4edee1b69bd…` |\n| `changes.jsonl.gz` | 31,660 | 39 MB | `f2f71dfaa9c89cef…` |\n| `scans.jsonl.gz` | 36,775 | 2 MB | `a76b9368dccd5d78…` |\n| `classifications.jsonl.gz` | 4,197 | 234 kB | `aff254e31a921157…` |\n| `tool_extras.jsonl.gz` | 31,855 | 15 MB | `edc6203dc5a8054b…` |\n| `extras_changes.jsonl.gz` | 5,502 | 764 kB | `237cc036e67f8621…` |\n| `package_observations.jsonl.gz` | 115,897 | 9 MB | `cb04627856d9eee0…` |\n| `pattern-set.json` | — | 19 kB | `867dbd7a52e2d6f5…` |\n| `record-set.json` | — | 2 kB | `f9224e8d2d6ade76…` |\n\n`manifest.json` 持有完整 hashes 和 counts，由日志密钥 `did:key:z6Mkw1CVxsPj9utYp7VXWEbuuGM9Ev47itwKu1UfKd5ByxR9` 签名，type 为 `histor.dataset/v1`，Ed25519 over RFC 8785 JSON。它还携带导出开始时的签名 tree head，tree size 为 1,074,932，因此任何 label id 都可通过 `GET https://histor.modelmarket.dev/api/v1/labels/\u003Cid>/proof` 对 live log 校验。\n\n## 字段说明\n\n字段形状在服务器之间变化的为 JSON 文本（`*Json`），因此每个文件加载为平面表。Digests 是 SRI strings（`sha256-…`），基于值的 RFC 8785 形式。\n\n- `servers`：`id`（按 name+endpoint 稳定）、`name`、`title`、`description`、`endpoint`（`https://…` 或用于包的 `npm:`/`pypi:`）、`transport`、`registry`、`version`、`repository`、`firstListed`/`lastListed`、`delisted`、`skipReason`、`lastStatus`、`lastDetail`、`lastObserved`、`toolCount`、`toolSetDigest`、`firstPinned`、`unchangedSince`、`attempts`、`observations`、`changes`、`blockMatches`/`adviseMatches`/`recordMatches`、`classifierFlags`、`chainLabel`、`page`\n- `toolsets`：`digest`、`toolsJson`；每个工具包含 digest 覆盖的四个成员，按服务提供：`name`、`description`、`inputSchema`，以及发送时的 `outputSchema`\n- `tool_extras`：`digest`、`extrasJson`；格式为 `{\"tools\": {name: {member: value}}}`，包含每个工具在四个成员之外携带的所有成员：`annotations`、`_meta`、`title`、`icons`、`execution`、vendor fields；仅针对携带这些成员的工具。从 `servers.toolExtrasDigest` 连接：其中 `\"\"` 表示观察到没有，null 表示自 HISTOR 保留它们（2026-10-22）以来未观察到。不属于 MTL/1 digest 或任何 label；其 digest 是 SHA-256 over sorted-key JSON，不是 RFC 8785，`_meta` 中的价格为 fractions\n- `extras_changes`：`serverId`、`observedAt`、`fromExtrasDigest` → `toExtrasDigest`、`summaryJson`；每个工具中每个移动的 annotation 为 `[before, after]`，以及每个其他成员添加、移除或更改；`escalations` 命名停止说 `readOnlyHint: true` 或开始说 `destructiveHint: true` 的工具\n- `changes`：`serverId`、`observedAt`、`fromToolSetDigest` → `toToolSetDigest`、`summaryJson`、`labelId`；对于包，`fromPackageVersion` → `toPackageVersion`，即最后一个提供旧列表的版本和提供新列表的版本，远程服务器和 2026-10-26 之前为 null\n- `scans`：`toolSetDigest`、`patternSet`、`matchesJson`；规则在 `pattern-set.json`。匹配是值得查看的模式命中，不是裁决\n- `classifications`：`toolSetDigest`、`model`、`verdictJson`；LLM 对工具集的建议性解读。不可复现，因此从不进入签名日志\n- `package_observations`：npm/PyPI 包的每次运行，包括失败的，最旧优先；`serverId`、`observedAt`、`status`、`packageVersion`、`toolSetDigest`、`subjectDigest`、`toolExtrasDigest`、`toolCount`、`serverName`/`serverVersion`。`packageVersion` 自 2026-10-26 记录，更旧行为 null。远程服务器不在此文件中，其记录在 `changes`\n\n## 变更如何计数\n\n- 比较内容：每个工具在 `toolsets` 中的成员：`name`、`description`、`inputSchema`，以及服务器发送时的 `outputSchema`。工具按名称排序，集合以其 RFC 8785 形式哈希，因此工具顺序、对象键顺序和 JSON 空白不会造成变更。字符串按发送比较，schema 内数组顺序也按发送比较，例如 `required`、`enum`。其他成员如 `title`、`annotations`、`_meta`、`icons` 不在 digest 中，保存在 `tool_extras`，其变更在 `extras_changes`\n- 何时：变更是成功读取的 digest 与服务器前一次成功读取不同。远程轮询节奏取决于观察者配置和可用容量；包按每个已发布版本读取一次。轮询之间的状态可能被错过。每个记录变更都被记录，包括回到服务器以前显示的列表的变更\n- 失败读取：超时、HTTP 错误、要求凭据的服务器或 HISTOR 不拨号的服务器从不是变更；服务器保留其最后列表，`lastStatus` 说明最后一次尝试如何。从未在无凭据下回答的服务器没有 tool set\n- 一个客户端：HISTOR 无凭据，从一台主机读取。因用户、账户或区域而异的列表不会被看到；因会话而异的列表显示为在两个 digest 之间交替的变更\n- 移动内容：在 `summaryJson` 中，修改的工具命名移动的成员：`description` 为词差异，`inputSchema`/`outputSchema` 为 JSON 路径，参数描述是以 `\"description\"` 结尾的路径。重命名的工具是移除加添加。当一侧无法 digest 时，`detail` 为 `names-only`，该变更只比较名称\n\n## 加载方式\n\n- 使用 pandas 按行读取 `servers.jsonl.gz` 和 `changes.jsonl.gz`\n- 提供 DuckDB 查询示例，包括按服务器名称统计 changes 数量并排序，以及筛选仅工具描述发生变更的 changes\n- 代码仓库中的脚本 `scripts/change_kinds.py` 按变更触及的字段对每次变更排序\n\n## 它不是什么\n\n- 工具列表是服务器当天向匿名客户端宣传的内容。需要凭据或拒绝 HISTOR 的服务器没有 tool set，`lastStatus`、`skipReason` 说明原因\n- Pattern matches 和 classifier flags 指向值得阅读的文本；它们不说明服务器是恶意\n- 变更是定义的变化，不是对其的判断。大多数是普通发布\n\n## 引用\n\nArtamokhov, A. (2026). *HISTOR snapshot 2026-10-26: MCP tool definitions and how they change* [Data set]. Zenodo. https://doi.org/10.5281/zenodo.23512759\n\n这是每个快照的 DOI，解析到最新；每个在记录上有自己的版本 DOI：https://doi.org/10.5281/zenodo.23512759\n\n也在 Hugging Face：https://huggingface.co/datasets/alexar76/histor-mcp-tool-definitions，tag 为 `snapshot-2026-10-26`\n\n## 许可与权利\n\n- 汇编、digests、labels、scans 和 verdicts 为 CC-BY-4.0\n- 工具名称、描述和 schema 按各服务器发布时复制；权利归其作者\n- 包含这些定义以便研究和检查\n- 想要退出的服务器运营者：在 https://github.com/alexar76/histor 提交 issue，附 endpoint 或 host。已退出服务器从每个后续快照中排除",1,"社区数据","HISTOR snapshot 2026-10-26 是一个关于 MCP（Model Context Protocol）服务器所公布工具定义及其变化的数据集。HISTOR 按轮询计划读取官方 MCP 注册表中每个远程 MCP 服务器的工具列表（tools/list），并对 npm/PyPI 上 MCP 包在沙箱中按已发布版本各运行一次（新版本优先，每天数百个）。它记录精确的工具定义，通过摘要固定，并在工具集首次出现、保持不变或发生变化时向公开的 RFC 9162 Merkle 日志写入签名标签；本快照即该记录以文件形式保存的结果。数据集涵盖 85,913 个已列出服务器（34,171 个远程端点、51,742 个包），另有 3,364 个已下架；其中 40,738 个有记录的工具集，11,528 个至少变化一次。变化记录共 31,660 条，时间范围为 2026-09-24 至 2026-10-26；不同工具集 66,649 个（当前及每次变化替换掉的）；752 个服务器命中 block-tier WARDEN 模式，15,273 个为 advise-only。文件包括 servers.jsonl.gz（89,277 行，19 MB）、toolsets.jsonl.gz（66,649 行，454 MB）、changes.jsonl.gz（31,660 行，39 MB）、scans.jsonl.gz（36,775 行，2 MB）、classifications.jsonl.gz（4,197 行，234 kB）、tool_extras.jsonl.gz（31,855 行，15 MB）、extras_changes.jsonl.gz（5,502 行，764 kB）、package_observations.jsonl.gz（115,897 行，9 MB）、pattern-set.json（19 kB）和 record-set.json（2 kB）。manifest.json 保存完整哈希和计数，由日志密钥 did:key:z6Mkw1CVxsPj9utYp7VXWEbuuGM9Ev47itwKu1UfKd5ByxR9 签名（类型 histor.dataset/v1，对 RFC 8785 JSON 做 Ed25519 签名），并包含导出开始时的已签名树头（树大小 1,074,932），因此可通过 GET https://histor.modelmarket.dev/api/v1/labels/\u003Cid>/proof 对标签 id 与实时日志核验。字段方面，形状因服务器而异的内容以 JSON 文本字段（*Json）保存，使每个文件都可作为扁平表加载。摘要为 SRI 字符串（sha256-…），基于值的 RFC 8785 形式。servers 包含 id、name、title、description、endpoint、transport、registry、version、repository、firstListed/lastListed、delisted、skipReason、lastStatus/lastDetail、lastObserved、toolCount、toolSetDigest、firstPinned、unchangedSince、attempts、observations、changes、blockMatches/adviseMatches/recordMatches、classifierFlags、chainLabel、page 等。toolsets 包含 digest 与 toolsJson，后者按工具记录摘要覆盖的四个成员（name、description、inputSchema，以及服务器发送时的 outputSchema）。tool_extras 包含 digest 与 extrasJson，记录工具在这四个成员之外携带的所有成员（annotations、_meta、title、icons、execution、供应商字段等），仅针对携带这些成员的工具；可通过 servers.toolExtrasDigest 连接，空字符串表示观察到但没有额外成员，null 表示自 2026-10-22 起未观察到；它不属于 MTL/1 摘要或任何标签，其摘要为基于排序键 JSON 的 SHA-256，而非 RFC 8785。extras_changes 包含 serverId、observedAt、fromExtrasDigest 到 toExtrasDigest、summaryJson，按工具记录移动的注解及其他成员的增删改，escalations 列出不再声明 readOnlyHint true 或开始声明 destructiveHint true 的工具。changes 包含 serverId、observedAt、fromToolSetDigest 到 toToolSetDigest、summaryJson（增加、删除、修改的工具及移动字段）、labelId。对包还包含 fromPackageVersion 到 toPackageVersion（最后一个服务旧列表的版本与服务新列表的版本；远程服务器和 2026-10-26 前为 null）。scans 包含 toolSetDigest、patternSet、matchesJson（规则代码、层级、严重性、工具、位置），规则在 pattern-set.json 中；匹配只是值得查看的模式命中，不是判定。classifications 包含 toolSetDigest、model、verdictJson，是 LLM 对工具集的建议性解读，不可复现，因此不进入签名日志。package_observations 记录 npm/PyPI 包的每次运行（包括失败），按从旧到新排列，包含 serverId、observedAt、status、packageVersion、toolSetDigest、subjectDigest、toolExtrasDigest、toolCount、serverName/serverVersion 等；远程服务器不在该文件中，其记录是 changes。变化计数规则：比较每个工具在 toolsets 中的 name、description、inputSchema，以及服务器发送时的 outputSchema。工具按名称排序，并以 RFC 8785 形式哈希，因此工具顺序、对象键顺序和 JSON 空白不会造成变化；字符串按发送原样比较（描述仅多一个空格也算变化），schema 内数组顺序（required、enum）同样比较。其他成员（title、annotations、_meta、icons）不进入摘要，保存在 tool_extras，其变化保存在 extras_changes。变化定义为成功读取的摘要与服务器上一次成功读取不同；远程轮询频率取决于观察者配置和容量，包按每个发布版本读取一次；轮询之间的状态可能错过。每个记录的变化都会记录，包括回到之前列表的情况。超时、HTTP 错误、要求凭据或 HISTOR 不拨号的服务器不会被计为变化：服务器保留最后列表，lastStatus 说明最近尝试结果；从未在无凭据下响应的服务器没有工具集。HISTOR 以单客户端、无凭据、从一台主机读取，因此因用户、账户或区域而异的列表不会被看到；因会话而异的列表会表现为在两个摘要之间交替的变化。summaryJson 中，修改的工具会列出移动的成员：description 为词级差异，inputSchema/outputSchema 为 JSON 路径（参数描述是结尾为 description 的路径）；重命名工具视为删除加新增；当一侧无法摘要时 detail 为 names-only，仅比较名称。使用方式：可用 pandas 以 lines=True 读取 JSONL.GZ，或用 DuckDB 查询。仓库中的 scripts/change_kinds.py 可按变化触及字段排序所有变化。适用场景包括 MCP 工具定义透明性、工具清单变化监测、AI 安全与 prompt injection/tool poisoning 相关研究、模式扫描和分类结果分析、包版本观察和服务器行为审计等。需要注意：工具列表是服务器当天向匿名客户端公布的内容；需要凭据或拒绝 HISTOR 的服务器没有工具集（lastStatus、skipReason 说明原因）；模式匹配和分类器标记指向值得阅读的文本，不表示服务器恶意；变化是定义变化，不是对变化的判断，大多数为普通发布。许可与权利：汇编、摘要、标签、扫描和判定采用 CC-BY-4.0。工具名称、描述和 schema 按各服务器发布原样再现，权利归各自作者；包含这些内容是为了研究和核验定义。服务器运营者若想退出，可在 https://github.com/alexar76/histor 提交 issue 并附端点或主机；已退出的服务器会从之后所有快照中移除。引用：Artamokhov, A. (2026). HISTOR snapshot 2026-10-26: MCP tool definitions and how they change [Data set]. Zenodo. https://doi.org/10.5281/zenodo.23512759。该 DOI 解析到最新快照，每条记录有版本 DOI。也可在 Hugging Face 获取，标签 snapshot-2026-10-26。","histor-mcp-tool-definitions",[30,31],"MCP工具定义变更监测","MCP工具供应链安全审计","https://huggingface.co/datasets/alexar76/histor-mcp-tool-definitions",[],1794251067346,5,true,{"code":12,"message":13,"data":38,"timestamp":41,"requestTime":8,"executeTime":42,"success":36},{"took":39,"search_result":40,"total":9,"error":17,"search_error":10},6,[],1794251067352,11,{"code":12,"message":13,"data":44,"timestamp":46,"requestTime":47,"executeTime":48,"success":36},{"ai_content":45},"{\n  \"background_and_challenge\" : {\n    \"background\" : \"模型上下文协议（MCP）正成为连接大语言模型与外部工具的关键接口，其工具定义的安全性、可追溯性与演化过程直接关系到AI代理生态的可信治理。HISTOR快照2026-10-26由Artamokhov, A.构建并发布，通过轮询官方MCP注册表中远程服务器及在沙箱中运行npm/PyPI包，记录tools/list返回的工具名称、描述与输入输出模式，并以摘要和RFC 9162 Merkle日志签名标签固化其首次出现、保持不变或变更。该数据集核心研究问题在于揭示MCP服务器工具定义何时变化、如何变化，并为提示注入、工具投毒与供应链审计提供可验证的透明性记录，对MCP安全研究与生态监测具有基础设施意义。\",\n    \"challenge\" : \"在AI供应链安全与工具投毒防御的语境下，该数据集所对应的领域问题在于持续追踪MCP工具定义的可变表面，以识别可能影响代理行为的定义漂移、隐藏指令与恶意模式。构建过程中，HISTOR须应对大规模轮询与沙箱执行带来的异构性：覆盖数万远程端点和包，无凭据读取导致部分服务器不可见，轮询间隔可能遗漏中间状态，单客户端视角无法捕捉按用户或区域变化的列表。规范化与签名环节要求RFC 8785摘要、SRI校验及Merkle日志标签，同时须区分失败读取与真实变更，避免将模式匹配或LLM分类视为最终裁决。数据权属、退出机制与额外工具元数据不计入摘要，也构成持续维护的复杂挑战。\"\n  },\n  \"introduction\" : {\n    \"construct_method\" : \"伴随模型上下文协议（MCP）在智能体工具调用生态中的广泛部署，工具定义的透明记录成为安全审计与生态观测的关键基础设施。HISTOR 快照 2026-10-26 的构建遵循持续观测与签名留痕思路：按轮询计划读取官方 MCP 注册表中每个远程服务器的 tools/list，并将 npm/PyPI MCP 包置于沙箱中按已发布版本运行，新版本优先且每日处理数百个。系统记录精确工具定义，以摘要固定工具集，每当工具集首次出现、保持不变或发生变化，即向公共 RFC 9162 Merkle 日志写入签名标签。快照文件由这些记录导出，包含 servers、toolsets、changes 等配置，并附 manifest 哈希与签名信息，形成可核验透明日志。\",\n    \"feature\" : \"立足于 MCP 工具供应链安全与提示注入风险研究的需要，该数据集以工具定义及其变化轨迹为核心特征。快照覆盖 85,913 个列出服务器，其中 40,738 个具有记录工具集，31,660 条记录变更发生于 2026 年 9 月 24 日至 10 月 26 日，并包含 66,649 个不同工具集。数据字段区分 servers、toolsets、tool_extras、changes、scans、classifications 与 package_observations，既保留 name、description、inputSchema、outputSchema 等摘要成员，也收录额外注解、规则匹配和模型分类。变更比较采用 RFC 8785 规范形式，排除工具顺序、键序与空白噪声；签名标签可由 Merkle 证明核验，模式匹配与分类仅作线索而非定论。\",\n    \"use_method\" : \"面向经验研究、安全审计与生态监测任务，该数据集提供 gzip 压缩的 JSONL 文件，可按行加载并连接分析。使用者能够以 pandas.read_json(..., lines=True) 读取 servers、changes 等表，也可在 DuckDB 中直接查询，通过 servers.id 关联 changes.serverId、以工具集摘要连接 toolsets 与 scans，进而统计变更类型、服务器活跃度或工具描述漂移。若需验证记录连续性，可依据 changes.labelId 或 servers.chainLabel 调用 GET https://histor.modelmarket.dev/api/v1/labels/\u003Cid>/proof 获取 Merkle 证明；pattern-set.json 与仓库脚本 scripts/change_kinds.py 可辅助规则匹配和变更归类。工具内容按原发布者文本复现，编译、摘要、标签、扫描与判定采用 CC-BY-4.0。\",\n    \"main_image_url\" : \"https://cdn.5radar.com/image/news/822a9b1aee0759f1ae9e2be93645aa59.png\"\n  },\n  \"development_history\" : {\n    \"time_related\" : \"\",\n    \"milestone\" : \"\",\n    \"development\" : \"\",\n    \"timeline\" : [ ]\n  },\n  \"common_scenario\" : {\n    \"classic_useage\" : \"在模型上下文协议快速成为智能体工具调用基础设施的背景下，MCP服务器与npm/PyPI包通过tools/list公开工具名称、描述、输入输出模式，这些定义直接左右智能体行为。HISTOR以轮询与沙箱运行持续捕获上述声明，按摘要固定工具集，并在首次出现、保持不变或发生变化时向RFC 9162 Merkle日志写入签名标签。其最经典用法是追踪工具定义漂移：比较新增、删除与修改的工具，定位仅描述、参数模式或输出模式发生的细微改动，复盘readOnlyHint、destructiveHint等注解的语义迁移。研究者可借公开证明校验某次变更确曾发生，从而审计MCP服务器从可信到可疑的演化轨迹。\",\n    \"solve_academic_problem\" : \"针对MCP工具生态缺乏纵向、可验证观测数据的困境，该数据集回应了工具投毒、提示注入与供应链更新难以量化的问题。它提供带Ed25519签名与Merkle日志证明的快照，使工具集首次出现、保持与变化的记录可复核，弥补了普通网页抓取无法证明历史状态、跨版本比较缺乏统一摘要、远程端点与包管理器观测异构等空白。其意义在于将工具描述与模式提升为可审计的AI安全研究对象，支持分析注解语义变化、WARDEN规则命中、LLM分类判断与真实变更之间的关系，并为代理供应链风险建立可重复的实证基础。\",\n    \"practical_application\" : \"面向MCP注册表、客户端、企业AI网关与安全运营场景，HISTOR可直接支撑工具供应链监控与风险响应。运营方读取servers、toolsets、changes、scans与classifications，可对工具schema突变、破坏性提示新增、描述中夹带指令、包版本更新引入高风险工具等事件设置告警。安全团队可借助标签证明完成取证与合规核查，开发者可在发布前比对历史版本，防止无意中扩大权限或暴露敏感操作。市场与网关也可据此建立准入、评分与回滚策略，降低代理误调用恶意或脆弱工具的概率。\",\n    \"derivative_related_work\" : \"以HISTOR的透明日志与签名快照为基座，相关经典工作延展出WARDEN模式匹配规则集、change_kinds.py变更类型分析脚本、LLM建议性分类器以及基于RFC 9162的标签证明接口。这些工作把原始工具定义转化为可检索、可验证、可比较的安全情报，并推动后续快照、Zenodo DOI版本化记录与MCP工具投毒检测基准的发展。围绕工具注释迁移、描述词差与JSON路径变更的研究，亦为透明度日志、代理供应链审计和提示注入防御提供了可复用的数据与方法参照。\"\n  },\n  \"recent_research\" : {\n    \"research_direction\" : \"置身于模型上下文协议加速渗透智能体生态与工具投毒风险持续外溢的语境中，histor-mcp-tool-definitions 将前沿研究引向 MCP 工具定义的动态可验证观测：依托 RFC 9162 Merkle 日志、SRI 摘要与签名标签，追踪远程端点及 npm/PyPI 包中 tools/list 的首次出现、稳定与变更，并关联 WARDEN 模式匹配、LLM 辅助分类及 readOnlyHint/destructiveHint 等注释迁移。该方向回应工具投毒、提示注入与供应链攻击等热点，为智能体工具治理、透明审计和风险预警提供可复核的数据基础，其影响延伸至协议生态的可观测性、安全基准构建与责任追溯。\",\n    \"research_paper\" : [ ]\n  }\n}",1794251067364,1794251067362,2,{"code":12,"message":13,"data":50,"timestamp":54,"requestTime":46,"executeTime":55,"success":36},{"took":9,"search_result":51,"total":9,"search_error":10},{"date_dataset_update":16,"desc_translation":17,"ext_extended_field1":18,"download_status":9,"date_index_create":19,"id":20,"del_flag":9,"ext_host_name_short":21,"ext_extended_field2":7,"ext_host_name":21,"ext_extended_field3":7,"ext_org_name":17,"date_index_update":22,"date_dataset_create":23,"markdown_desc":24,"dataset_visibility":25,"ext_host_type":26,"compliance_status":7,"dataset_desc":27,"dataset_name":28,"topic_list":52,"dataset_url":32,"visit_count":25,"data_product_list":53},[30,31],[],1794251067368,4,["Reactive",57],{"$sglobal-login-visible":10,"$sglobal-login-update-visible":10,"$sglobal-login-type":58,"$sglobal-login-github-key":17,"$suser_info":7,"$shot-search-visible":10,"$shot-search-keyword":17,"$suserMess":59,"$ssiteColor":60,"$sorganization-link-resolver-cache":61,"$ssite-config":62},"quick",{},{},{},{"env":63,"name":64,"url":65},"production","nuxt-app","https://www.selectdataset.com",["Set"],["ShallowReactive",68],{"da8JU-Xwd35tYbYNQ6LYkQJA-3AIs_AG-S861mkY9Vo":-1,"related-dataset-d595b7ffd78438a48b6efa42e0861151-1":-1,"71xFqTUMSp-0tNHhYQsaCrT_4yN6jW0y-BYjmdhk6e8":-1,"JTvUHMWVZn75f0FBf1u3bQAejMI_598R1ynOyiFR8pQ":-1,"related-dataset-detail-d595b7ffd78438a48b6efa42e0861151":-1},"/dataset/d595b7ffd78438a48b6efa42e0861151/histor-mcp-tool-definitions"]</script><script>window.__NUXT__={};window.__NUXT__.config={public:{VITE_PACK_ENV:"production",VITE_BAIDU_HM_ID:"bbb312c3954f1a500bb78d8989ed3574",VITE_API_HOST:"https://www.selectdataset.com",VITE_INTERNAL_API_HOST:"https://www.selectdataset.com",VITE_CODE_IMG:"/internal-api/sys/common/static/",VITE_CDN_URL:"",VITE_SITE_PC_HOST:"https://www.selectdataset.com",VITE_SITE_MARKETPLACE_PC_HOST:"https://marketplace.selectdataset.com",VITE_SFK_OFFICIAL_SITE_URL:"https://www.sfktec.com",VITE_SFK_PROPERTY_REGIST_URL:"https://www.sfktec.com/property-regist",VITE_SFK_DPR_URL:"https://dpr.sfktec.com.cn/",baiduHmId:"bbb312c3954f1a500bb78d8989ed3574",cdnUrl:""},app:{baseURL:"/",buildId:"6d222e02-0627-4706-8967-36f91de0f99a",buildAssetsDir:"/_nuxt/",cdnURL:""}}</script></body></html>
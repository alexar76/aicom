      <!-- begin article -->
      <article class="tm-article tm-page-article__content tm-page-article__content_narrow">
        <div class="tm-user-meta">
          <a href="/users/vyacheslav-startsev/posts" class="tm-user-info">
            <div class="tm-user-info__userpic">
              
              <amp-img class="tm-entity-image" src="//habrastorage.org/getpro/habr/avatars/260/df7/be0/260df7be08a1a7658454ad9e5f766efb.png" width="24px" height="24px"
                layout="fixed">

        <div class="tm-user-card__info">
          <div class="tm-user-card__title">
            <span class="tm-user-card__name">Вячеслав Старцев</span>
            <a href="/users/vyacheslav-startsev/posts/" class="tm-user-card__nickname">
              @vyacheslav-startsev
            </a>
          </div>
          <p class="tm-user-card__short-info">
            <span>
              Эксперт по ИИ-агентам, разработчик
            </span>
          </p>
        </div>
      </div>

      <amp-list layout="fixed-height" src="https://habr.com/ru/amp/api/post-info/1076614" height="56">
        <template type="amp-mustache">
          <a href="/post/1076614/comments/" class="tm-article-comments" id="comments-link">
            <svg class="tm-article-comments__icon" id="counter-comments" viewBox="0 0 32 32" width="100%" height="100%">
              <path
                d="M18 24v8l-10-8h-6c-1.105 0-2-.895-2-2v-20c0-1.105.895-2 2-2h28c1.105 0 2 .895 2 2v20c0 1.105-.895 2-2 2h-12z">
              </path>
            </svg>
            Комментарии {{ commentsCount }}
          </a>
        </template>
        <a href="/post/1076614/comments/" class="tm-article-comments tm-article-comments_fallback" id="comments-link" fallback>
          <svg class="tm-article-comments__icon" id="counter-comments" viewBox="0 0 32 32" width="100%" height="100%">
            <path
              d="M18 24v8l-10-8h-6c-1.105 0-2-.895-2-2v-20c0-1.105.895-2 2-2h28c1.105 0 2 .895 2 2v20c0 1.105-.895 2-2 2h-12z">
            </path>
          </svg>
          Комментарии
        </a>
      </amp-list>

      <template type="amp-mustache" id="dateTime">
        {{ day }}
        {{ monthNameShort }}
        {{ year }}, {{ hour }}:{{ minuteTwoDigit }}
      </template>

      <div class="tm-article-list-block">
        <amp-list layout="fixed-height" src="https://habr.com/ru/amp/api/1076614/similar/" height="1" [height]="items.length * 130">
          <div class="tm-article-list-block__header">
            <div class="tm-article-list-block__title">
                Похожие публикации
            </div>
          </div>
          <template type="amp-mustache">
              <article class="tm-article-similar tm-article-similar_preview">
                <div class="tm-article-similar__block">
                  <div class="tm-article-similar__date">
                    <amp-date-display
                      locale="ru"
                      layout="fixed-height"
                      height="24px"
                      template="dateTime"
                      datetime="{{ timePublished }}"
                    >
                    </amp-date-display>
                  </div>
                <h2 class="tm-article-title tm-article-similar-title_preview tm-article-title_preview">
                  <a href="/post/{{ id }}/" class="tm-article-title__link" id="similar-link">
                    {{ titleHtml }}
                  </a>
                </h2>
              </div>
            </article>
          </template>
        </amp-list>
      </div>

      <div class="tm-article-list-block">
          <amp-list layout="fixed-height" src="https://habr.com/ru/amp/api/top/" height="1" [height]="items.length * 130">
            <div class="tm-article-list-block__header">
              <div class="tm-article-list-block__title">
                Лучшие за сутки
              </div>
            </div>
            <template type="amp-mustache">
              <article class="tm-article-similar tm-article-similar_preview">
                <div class="tm-article-similar__block">
                  <div class="tm-article-similar__date">
                    <amp-date-display
                      locale="ru"
                      layout="fixed-height"
                      height="24px"
                      template="dateTime"
                      datetime="{{ timePublished }}"
                    >
                    </amp-date-display>
                  </div>
                <h2 class="tm-article-title tm-article-similar-title_preview tm-article-title_preview">
                  <a href="/post/{{ id }}/" class="tm-article-title__link" id="top-link">
                    {{ titleHtml }}
                  </a>
                </h2>
              </div>
            </article>
            </template>
          </amp-list>
        </div>
  </main>
  <div class="tm-footer">
    <div class="tm-footer__container">
      <div class="tm-footer__title">
        <a href="/" class="tm-svg-icon__wrapper tm-footer__title-link">
          <svg height="16" width="16" class="tm-svg-img tm-svg-icon">
            <use xlink:href="https://habr.com/img/habr-logo-ru.svg#logo"></use>
          </svg>
        </a>
      </div>
      <a href="https://habr.com/ru/post/1076614/" class="tm-footer__link">
        <span>Полная версия</span>
      </a>
      <div class="tm-footer-copyright">
        <span class="tm-copyright">
          <span class="tm-copyright__years">© 2006–2026</span>
          <span class="tm-copyright__name">
            «<a href="https://company.habr.com/" target="_blank" class="tm-copyright__link">Habr</a>»
          </span>
        </span>
      </div>
    </div>
  </div>
</body>
</html>

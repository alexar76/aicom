<details class="trust-badge trust-Contributor trust-user-agent cimp">
  <summary class="cimp-summary trust-rank-trigger" aria-label="Rank: Contributor">
  <svg class="trust-rail" viewBox="0 0 92 28" width="72" height="22" aria-hidden="true" focusable="false">
    <rect class="trust-rail-housing" x="1" y="2" width="90" height="24" rx="12"/>
    <path class="trust-rail-guide" d="M14 14h63"/>
    
    <circle class="trust-rail-pip trust-rail-full" cx="14" cy="14" r="5"/>
    
    
    <circle class="trust-rail-pip trust-rail-open" cx="35" cy="14" r="5"/>
    
    
    <circle class="trust-rail-pip trust-rail-off" cx="56" cy="14" r="5"/>
    
    
    <circle class="trust-rail-pip trust-rail-off" cx="77" cy="14" r="5"/>
    
    

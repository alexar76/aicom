    "title": "Anyone who reaches the login page can lock the operator out of the skopos-fleet dashboard",
    "affected": [
      {
        "collectionURL": "https://pypi.org",
        "defaultStatus": "unknown",
        "modules": [
          "skopos.auth_store"
        ],
        "packageName": "skopos-fleet",
        "product": "skopos-fleet",
        "programFiles": [
          "skopos/auth_store.py"
        ],
        "programRoutines": [
          {
            "name": "skopos.auth_store.register_failed_login"
          },
          {
            "name": "skopos.auth_store.login_lockout_remaining_seconds"
          }
        ],
        "vendor": "pypi",
        "versions": [
          {
            "status": "affected",
            "version": "0.2.1",
            "versionType": "python"
          }
        ]
      }
    ],
    "solutions": [
      {
        "lang": "en",
        "value": "No setting removes it in 0.2.1. SKOPOS_LOGIN_GLOBAL_MAX_ATTEMPTS (up to 500) only raises the number of failures an attacker must send, and SKOPOS_LOGIN_LOCKOUT_SECONDS (down to 60) shortens each lockout; with a long random dashboard password, a higher shared budget still leaves guessing impractical."
      }
    ]
  },

    "affected": [
      {
        "collectionURL": "https://pypi.org",
        "defaultStatus": "unknown",
        "modules": [
          "logos.app",
          "logos.main"
        ],
        "packageName": "aimarket-logos",
        "product": "aimarket-logos",
        "programFiles": [
          "logos/app.py",
          "logos/main.py"
        ],
        "programRoutines": [
          {
            "name": "logos.app._from_local_proxy"
          },
          {
            "name": "logos.app._client_key"
          },
          {
            "name": "logos.main.main"
          }
        ],
        "vendor": "pypi",
        "versions": [
          {
            "lessThanOrEqual": "0.2.1",
            "status": "affected",
            "version": "0.1.0",
            "versionType": "python"
          }
        ]
      }
    ],
    "solutions": [
      {
        "lang": "en",
        "value": "Start the app on loopback, for example uvicorn logos.main:app --host 127.0.0.1 --port <LOGOS_PORT>, instead of the logos entry point, and reach it only through a reverse proxy on the same host."
      }
    ]
  },

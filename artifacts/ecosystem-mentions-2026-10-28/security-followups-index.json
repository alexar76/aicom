    "title": "Oracle client address and paid tier can be forged by hosts on the same private network in aimarket-oracle-core",
    "affected": [
      {
        "collectionURL": "https://pypi.org",
        "defaultStatus": "unknown",
        "modules": [
          "oracle_core.app",
          "oracle_core.tiers"
        ],
        "packageName": "aimarket-oracle-core",
        "product": "aimarket-oracle-core",
        "programFiles": [
          "oracle_core/app.py",
          "oracle_core/tiers.py"
        ],
        "programRoutines": [
          {
            "name": "oracle_core.app.peer_is_local_proxy"
          },
          {
            "name": "oracle_core.app.client_key"
          },
          {
            "name": "oracle_core.tiers.PaidTierPolicy.is_paid"
          }
        ],
        "vendor": "pypi",
        "versions": [
          {
            "lessThanOrEqual": "0.6.2",
            "status": "affected",
            "version": "0.2.0",
            "versionType": "python"
          }
        ]
      }
    ],
    "solutions": [
      {
        "lang": "en",
        "value": "If you do not sell the paid tier through a hub, leave ORACLE_TRUSTED_PAYMENT_PROXIES unset: no caller is then lifted above the free ceiling. ORACLE_PAID_TIER_SECRET does not replace it for hub traffic, because aimarket-hub (through 3.16.0) never sends the X-AIMarket-Paid-Tier header."
      },
      {
        "lang": "en",
        "value": "Bind the oracle to the loopback interface and reach it only through a reverse proxy on the same host."
      }
    ]
  },

    "title": "Platon rate limit key can be forged by hosts on the same private network in aimarket-platon",
    "affected": [
      {
        "collectionURL": "https://pypi.org",
        "defaultStatus": "unknown",
        "modules": [
          "platon.main"
        ],
        "packageName": "aimarket-platon",
        "product": "aimarket-platon",
        "programFiles": [
          "platon/main.py"
        ],
        "programRoutines": [
          {
            "name": "platon.main._from_local_proxy"
          },
          {
            "name": "platon.main._key_from"
          },
          {
            "name": "platon.main._client_key"
          },
          {
            "name": "platon.main._ws_client_key"
          }
        ],
        "vendor": "pypi",
        "versions": [
          {
            "lessThanOrEqual": "0.1.5",
            "status": "affected",
            "version": "0.1.0",
            "versionType": "python"
          }
        ]
      }
    ],
    "solutions": [
      {
        "lang": "en",
        "value": "Bind the server to the loopback interface (PLATON_HOST=127.0.0.1) and reach it only through a reverse proxy on the same host."
      }
    ]
  },

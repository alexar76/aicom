    "title": "SSH host key not checked when skopos-fleet pushes remediation commits to a single-label remote",
    "affected": [
      {
        "collectionURL": "https://pypi.org",
        "defaultStatus": "unknown",
        "modules": [
          "skopos.remediation.git_push"
        ],
        "packageName": "skopos-fleet",
        "product": "skopos-fleet",
        "programFiles": [
          "skopos/remediation/git_push.py"
        ],
        "programRoutines": [
          {
            "name": "skopos.remediation.git_push.ssh_remote_is_local"
          },
          {
            "name": "skopos.remediation.git_push.GitPusher._git"
          }
        ],
        "vendor": "pypi",
        "versions": [
          {
            "lessThanOrEqual": "0.2.1",
            "status": "affected",
            "version": "0.2.0",
            "versionType": "python"
          }
        ]
      }
    ],
    "solutions": [
      {
        "lang": "en",
        "value": "Name the git server by a fully qualified name in SKOPOS_AGENT_REPO_URL, and add its host key, checked out of band, to SKOPOS's known_hosts (SKOPOS_KNOWN_HOSTS): in 0.2.1 such a remote is verified."
      },
      {
        "lang": "en",
        "value": "Or push over HTTPS: an https:// SKOPOS_AGENT_REPO_URL with SKOPOS_GIT_TOKEN set and SKOPOS_GIT_SSH_KEY unset."
      },
      {
        "lang": "en",
        "value": "Where SKOPOS runs on the host itself, a loopback remote such as a Gitea port published on 127.0.0.1 is not reachable by a neighbour."
      }
    ]
  },

      /* ------------------------------------------------------------------
         Masthead — three shallow mega-menus (Browse / Artifacts / Signals)
         replacing the single 26-link "More" column (2026-07-28). Menus are
         built from _data/nav.yml by _includes/nav.html; `columns:` there maps
         to .nav-mega-N here.
         Breakpoint is XL (1200px), not LG: eight top-level items plus the
         search field and the CTA don't fit at 992px.
      ------------------------------------------------------------------ */
      .navbar-search { min-width: 15rem; }
      .navbar-cta { white-space: nowrap; }

      @media (min-width: 1200px) {
        .navbar-search { margin-right: 0.5rem; }
        .navbar .dropdown-menu { padding: 0.75rem 0.25rem; border: 0; box-shadow: 0 8px 24px rgba(0,0,0,0.18); }
        .navbar .dropdown-header { font-size: 0.7rem; text-transform: uppercase; letter-spacing: 0.5px; color: #6c757d; padding: 0.15rem 1rem 0.35rem; }
        .navbar .dropdown-item { font-size: 0.9rem; padding: 0.3rem 1rem; }
        .navbar .dropdown-item.active, .navbar .dropdown-item:active { background-color: #0d6efd; color: #fff; }

        /* Multi-column menus: groups lay out side by side as flex children.
           Bootstrap's dropdown JS only cares about .dropdown-toggle /
           .dropdown-menu / .dropdown-item, all of which survive the nesting,
           so keyboard navigation still works. */
        .nav-mega { display: none; }
        .nav-mega.show { display: flex; flex-wrap: wrap; }
        .nav-mega-1 { min-width: 13rem; }
        .nav-mega-2 { min-width: 26rem; }
        .nav-mega-3 { min-width: 39rem; }
        .nav-mega-group { flex: 1 1 12rem; min-width: 12rem; padding-bottom: 0.35rem; }
        .nav-mega-list { list-style: none; margin: 0; padding: 0; }

        /* Right-align the last menu so a wide 3-column panel can't push the
           page into a horizontal scrollbar. */
        .navbar-nav > .nav-item.dropdown:last-of-type .nav-mega { right: 0; left: auto; }
      }

      /* Collapsed navbar: render menus inline (no light popover card floating
         over the dark bar) and match the dark styling so the whole drawer
         reads as one list. */
      @media (max-width: 1199px) {
        .navbar-collapse { padding: 0.5rem 0 0.25rem; }
        .navbar-nav .nav-link { padding: 0.6rem 0 !important; }
        .navbar .dropdown-menu {
          position: static; float: none; display: block;
          background-color: transparent; border: 0; box-shadow: none;
          padding: 0.25rem 0 0.5rem 0.75rem;
          margin: 0; width: auto;
        }
        .navbar .dropdown-toggle::after { display: none; }
        .nav-mega-list { list-style: none; margin: 0; padding: 0; }
        .navbar .dropdown-header {
          color: rgba(255,255,255,0.55);
          font-size: 0.7rem; text-transform: uppercase; letter-spacing: 0.6px;
          padding: 0.75rem 0 0.25rem; font-weight: 600;
        }
        .navbar-dark .dropdown-menu .dropdown-item {
          color: rgba(255,255,255,0.85);
          padding: 0.5rem 0; font-size: 0.95rem;
        }
        .navbar-dark .dropdown-menu .dropdown-item:hover,
        .navbar-dark .dropdown-menu .dropdown-item:focus {
          color: #fff; background-color: rgba(255,255,255,0.06); border-radius: 4px;
          padding-left: 0.5rem; padding-right: 0.5rem;
        }
        .navbar-dark .dropdown-menu .dropdown-item.active {
          color: #fff; background-color: rgba(13,110,253,0.6); border-radius: 4px;
          padding-left: 0.5rem; padding-right: 0.5rem;
        }
        .navbar-search { margin-top: 0.5rem; min-width: 0; }
        .navbar-cta { margin-top: 0.6rem; align-self: flex-start; }
      }
    </style>
    <script>
      // Collapsed navbar: expand every menu automatically when the drawer is
      // opened, so Browse / Artifacts / Signals are visible without a second
      // tap. Boundary must match the CSS above (1199px).
      document.addEventListener('DOMContentLoaded', function () {
        var collapseEl = document.getElementById('navbarSupportedContent');
        if (!collapseEl) return;
        collapseEl.addEventListener('show.bs.collapse', function () {
          if (window.matchMedia('(max-width: 1199px)').matches) {
            collapseEl.querySelectorAll('.dropdown-menu').forEach(function (m) {
              m.classList.add('show');
            });
          }
        });
        collapseEl.addEventListener('hidden.bs.collapse', function () {
          collapseEl.querySelectorAll('.dropdown-menu.show').forEach(function (m) {
            m.classList.remove('show');
          });
        });
      });
    </script>

    <!-- First-touch source (2026-10-19). Records HOW someone first reached APIs.io — the
         referring HOST (never the full URL), utm_source/medium/campaign, the landing path,
         the date — in a first-party cookie, ONCE, never overwritten. The sign-in Lambda copies
         it onto a new account as `signup_source` so signups can be counted by channel. No IDs,
         nothing sent anywhere else; internal navigation and our own sites are not a source. -->
    <script>
      (function () {
        try {
          if (document.cookie.indexOf('apisio_src=') !== -1) return;
          var ref = '';
          try { ref = document.referrer ? new URL(document.referrer).hostname : ''; } catch (e) {}
          if (/(^|\.)(apis\.io|apievangelist\.com|apis\.how|apicommons\.org|apisjson\.org)$/.test(ref)) ref = '';
          var q = new URLSearchParams(location.search), utm = [q.get('utm_source'), q.get('utm_medium'), q.get('utm_campaign')]
            .map(function (v) { return (v || '').replace(/[^\w.\-+ ]/g, '').slice(0, 40); }).join('/').replace(/\/+$/, '');
          if (!ref && !utm) return;   // direct / internal: leave it unset; the Lambda records direct/unknown
          var v = 'ref=' + ref + '|utm=' + utm + '|land=' + location.pathname.replace(/[^\w.\-\/]/g, '').slice(0, 80) +
                  '|d=' + new Date().toISOString().slice(0, 10);
          document.cookie = 'apisio_src=' + encodeURIComponent(v) + '; Domain=apis.io; Path=/; Max-Age=7776000; SameSite=Lax; Secure';
        } catch (e) {}
      })();
    </script>

    <!-- Google tag (gtag.js) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-6H4KFSEF6P"></script>
    <script>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-6H4KFSEF6P');

      function getQueryVariable(variable) {
          var query = window.location.search.substring(1);
          var vars = query.split('&');
          for (var i = 0; i < vars.length; i++) {
              var pair = vars[i].split('=');
              if (decodeURIComponent(pair[0]) == variable) {
                  return decodeURIComponent(pair[1]);
              }
          }
      }
    </script><script>
(function () {
  'use strict';

  var BEACON_URL = '/webmcp/beacon';
  // Sampling rate for the NEGATIVE case (browser has no modelContext). Positives
  // are always sent. Keep in sync with the scale-up factor in QUERIES.md.
  var NEGATIVE_SAMPLE_RATE = 0.01;

  var registered = [];   // every tool registered on this page, across surfaces
  var surfaces = {};     // surface -> true, so a double register() is a no-op
  var ctx = null;        // the live modelContext object
  var flavor = null;     // 'document' (current spec) | 'navigator' (<= Chrome 149)

  // --- capability detection ------------------------------------------------
  // Document first: that is where the spec put it. Navigator is the deprecated
  // fallback, kept only while Chrome 149 is still in the field.
  try {
    if (typeof document !== 'undefined' && document.modelContext &&
        typeof document.modelContext.registerTool === 'function') {
      ctx = document.modelContext;
      flavor = 'document';
    } else if (typeof navigator !== 'undefined' && navigator.modelContext &&
               typeof navigator.modelContext.provideContext === 'function') {
      ctx = navigator.modelContext;
      flavor = 'navigator';
    }
  } catch (err) {
    ctx = null;
    flavor = null;
  }

  // --- measurement ---------------------------------------------------------
  function beacon(payload) {
    try {
      payload.flavor = flavor || 'none';
      payload.path = (location && location.pathname) || '';
      var body = JSON.stringify(payload);
      if (navigator && typeof navigator.sendBeacon === 'function') {
        navigator.sendBeacon(BEACON_URL, new Blob([body], { type: 'application/json' }));
      } else if (typeof fetch === 'function') {
        fetch(BEACON_URL, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: body,
          keepalive: true
        }).catch(function () {});
      }
    } catch (err) {
      // Telemetry must never break a page or a tool call.
    }
  }

  // --- return-shape normalization -----------------------------------------
  function toContent(value) {
    if (value && typeof value === 'object' && Array.isArray(value.content)) return value;
    var text;
    try {
      text = (typeof value === 'string') ? value : JSON.stringify(value, null, 2);
    } catch (err) {
      text = String(value);
    }
    return { content: [{ type: 'text', text: text }] };
  }

  function wrapExecute(surface, tool) {
    var fn = tool.execute;
    return function (args) {
      var started = (typeof performance !== 'undefined' && performance.now)
        ? performance.now() : Date.now();
      function done(ok) {
        var ms = ((typeof performance !== 'undefined' && performance.now)
          ? performance.now() : Date.now()) - started;
        beacon({ event: 'call', surface: surface, tool: tool.name, ok: ok, ms: Math.round(ms) });
      }
      var out;
      try {
        out = fn.apply(this, arguments);
      } catch (err) {
        done(false);
        throw err;
      }
      return Promise.resolve(out).then(function (value) {
        done(true);
        return toContent(value);
      }, function (err) {
        done(false);
        throw err;
      });
    };
  }

  // --- registration --------------------------------------------------------
  function pushToBrowser(tools) {
    if (flavor === 'document') {
      for (var i = 0; i < tools.length; i++) ctx.registerTool(tools[i]);
    } else {
      // Legacy provideContext replaces the entire set, so always send the
      // accumulated list rather than just this surface's slice.
      ctx.provideContext({ tools: registered });
    }
  }

  function register(surface, tools) {
    surface = String(surface || 'unknown');
    if (!ctx || !Array.isArray(tools) || !tools.length) return false;
    if (surfaces[surface]) return false;
    surfaces[surface] = true;

    var prepared = [];
    for (var i = 0; i < tools.length; i++) {
      var t = tools[i];
      if (!t || !t.name || typeof t.execute !== 'function') continue;
      prepared.push({
        name: t.name,
        description: t.description || '',
        inputSchema: t.inputSchema || { type: 'object', properties: {} },
        execute: wrapExecute(surface, t)
      });
    }
    if (!prepared.length) return false;

    registered = registered.concat(prepared);
    try {
      pushToBrowser(prepared);
    } catch (err) {
      // The API surface is a moving draft — a failed registration must not take
      // the page down with it. Record it, because a spike here is the signal
      // that the spec moved under us again.
      if (typeof console !== 'undefined') console.warn('WebMCP registration failed', err);
      beacon({ event: 'error', surface: surface, tool: '', ok: false, ms: 0 });
      return false;
    }
    beacon({ event: 'register', surface: surface, tool: '', ok: true, ms: prepared.length });
    return true;
  }

  window.apisioWebMCP = {
    get available() { return !!ctx; },
    get flavor() { return flavor; },
    get tools() { return registered.map(function (t) { return t.name; }); },
    register: register
  };

  // Capability census — one beacon per pageview. Always when a modelContext
  // exists (rare, and the whole point); sampled when it does not, so the
  // denominator is measurable without a write per pageview.
  if (ctx) {
    beacon({ event: 'capability', surface: 'page', tool: '', ok: true, ms: 0 });
  } else if (Math.random() < NEGATIVE_SAMPLE_RATE) {
    beacon({ event: 'capability', surface: 'page', tool: '', ok: false, ms: 0, sampled: 1 });
  }
})();
</script>


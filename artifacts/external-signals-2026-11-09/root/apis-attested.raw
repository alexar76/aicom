    <tbody>
      <tr><td style="padding:.35rem;border-bottom:1px solid #f3f4f6;vertical-align:top">Personal</td>
          <td style="padding:.35rem;border-bottom:1px solid #f3f4f6">$12/ month</td></tr>
      <tr><td style="padding:.35rem;border-bottom:1px solid #f3f4f6;vertical-align:top">Teams</td>
          <td style="padding:.35rem;border-bottom:1px solid #f3f4f6">$49/ month</td></tr>
      <tr><td style="padding:.35rem;border-bottom:1px solid #f3f4f6;vertical-align:top">Market</td>

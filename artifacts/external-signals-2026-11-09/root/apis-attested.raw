                    </li><li class="nav-mega-group">
                      <h6 class="dropdown-header">APIs.io</h6>
                      <ul class="nav-mega-list"><li><a class="dropdown-item" href="https://apis.io/about/">About</a></li><li><a class="dropdown-item" href="https://apis.io/on-premise/">On-Premise</a></li><li><a class="dropdown-item" href="https://usecommune.com/n/apisio">Newsletter</a></li><li><a class="dropdown-item" href="https://apis.io/support/">Support</a></li><li><a class="dropdown-item" href="https://github.com/api-search">GitHub</a></li></ul>
                    </li></ul>
              </li><li class="nav-item">
                <a class="nav-link" href="https://apis.io/blog/">Blog</a>
              </li></ul><form class="d-flex navbar-search" role="search" action="https://apis.io/" method="get">
        <input class="form-control form-control-sm" type="search" name="search" placeholder="Search APIs, providers, capabilities…" aria-label="Search APIs">
      </form><a class="btn btn-sm btn-outline-light navbar-cta" href="https://apis.io/add/">Add your API</a></div>
  </div>
</nav>

    
    <!-- Laneworks ad network (ads.laneworks.net) -->
    <script async src="https://ads.laneworks.net/embed.js"></script>
    <div data-laneworks-ad="top-banner"></div>
    <main class="container mt-2 mb-5" role="main">
      <style>
  .provider-hero { background: linear-gradient(135deg, #f8f9fb 0%, #eef2f7 100%); border: 1px solid #e3e7ee; border-radius: 12px; padding: 2rem; margin-bottom: 1.5rem; }
  /* Screenshot banner. With no screenshot (or a load failure) the dark apis.io
     wordmark background shows through as the fallback card. */
  .provider-banner { display: block; width: 100%; aspect-ratio: 16 / 6; background: #14161d url('/assets/branding/apisio-wordmark-white.png') center / 200px auto no-repeat; border: 1px solid #e3e7ee; border-radius: 12px; overflow: hidden; margin-bottom: 1.5rem; }
  .provider-banner img { width: 100%; height: 100%; object-fit: cover; object-position: top center; display: block; }
  /* Deprecated providers stay listed but carry a banner here and a badge on the card. */
  .deprecated-banner { display: flex; gap: 0.6rem; align-items: baseline; background: #fff4e5; border: 1px solid #ffd9a8; color: #8a4b00; border-radius: 10px; padding: 0.75rem 1rem; margin-bottom: 1.5rem; font-size: 0.95rem; line-height: 1.5; }
  .deprecated-banner strong { white-space: nowrap; }
  .provider-title { font-size: 2rem; font-weight: 700; margin-bottom: 0.5rem; color: #1a1a2e; }
  .provider-desc { color: #4a5568; line-height: 1.6; font-size: 1.05rem; margin-bottom: 1rem; }
  .provider-overview { color: #4a5568; line-height: 1.65; font-size: 0.95rem; margin: 0 0 1rem; }
  .provider-overview p { margin: 0 0 0.6rem; }
  .provider-overview a { color: #0d6efd; text-decoration: none; }
  .provider-overview a:hover { text-decoration: underline; }
  .stat-badges { display: flex; gap: 0.75rem; flex-wrap: wrap; margin-bottom: 1rem; }
  .stat-badge { background: white; border: 1px solid #e3e7ee; border-radius: 8px; padding: 0.5rem 1rem; font-size: 0.85rem; }
  .stat-badge strong { color: #0d6efd; }
  .provider-links { display: flex; flex-wrap: wrap; gap: 0.5rem; margin-bottom: 1rem; }
  .provider-link { display: inline-flex; align-items: center; gap: 0.35rem; padding: 0.4rem 0.85rem; background: #0d6efd; color: #fff; border-radius: 8px; font-size: 0.85rem; font-weight: 600; text-decoration: none; }
  .provider-link:hover { background: #0b5ed7; color: #fff; }
  .provider-link.secondary { background: #fff; color: #1a1a2e; border: 1px solid #cdd6e4; }
  .provider-link.secondary:hover { background: #f1f4f9; color: #1a1a2e; }

  /* Rating header — the at-a-glance headline in the hero. Band pill colors are the
     same ladder used by the search-result pills on apis.io and the bands on
     /rating/ — green/blue/yellow/orange/red/gray, descending. Keep the three in
     sync; a provider seeing `strong` blue in search and something else here reads
     as two different systems. */
  .score-header { display: flex; align-items: center; gap: 0.75rem; flex-wrap: wrap; margin-bottom: 1rem; padding: 0.75rem 1rem; background: white; border: 1px solid #e3e7ee; border-radius: 10px; }
  /* The K'in sun. Fixed box so the header doesn't reflow when the script
     swaps the empty placeholder for the drawn mark. */
  .score-glyph { flex: 0 0 auto; width: 72px; height: 72px; display: block; line-height: 0; }
  .score-glyph svg { display: block; width: 100%; height: 100%; }
  .score-composite { font-size: 1.5rem; font-weight: 700; color: #1a1a2e; font-variant-numeric: tabular-nums; line-height: 1; }
  .score-composite span { font-size: 0.85rem; font-weight: 500; color: #8a94a6; }
  .band-pill { display: inline-block; padding: 0.25em 0.75em; border-radius: 999px; font-size: 0.78rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.04em; }
  .band-exemplar   { background: #d1f7e0; color: #0f5132; }
  .band-strong     { background: #cfe2ff; color: #0a3d91; }
  .band-developing { background: #fff3cd; color: #664d03; }
  .band-thin       { background: #ffe0c2; color: #7a3e07; }
  .band-emerging   { background: #f8d7da; color: #842029; }
  .band-minimal    { background: #e9ecef; color: #495057; }
  .score-trend { font-size: 0.8rem; font-weight: 600; font-variant-numeric: tabular-nums; }
  .trend-rising  { color: #0f5132; }
  .trend-falling { color: #842029; }
  .trend-flat    { color: #8a94a6; }
  .score-meta { margin-left: auto; font-size: 0.78rem; color: #8a94a6; text-align: right; }
  .score-meta a { color: #0d6efd; text-decoration: none; }
  /* Access model — how a developer gets in (pricing + onboarding), derived from
     plans/finops/authentication into apis.yml's accessModel block. Same pill ladder
     as the rating bands: green = easiest/cheapest, blue = self-serve, gray = paid,
     orange = gated. */
  .access-header { display: flex; align-items: center; gap: 0.5rem; flex-wrap: wrap; margin-bottom: 1rem; }
  .access-header .ax-caption { font-size: 0.72rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.05em; color: #8a94a6; margin-right: 0.15rem; }
  .access-pill { display: inline-block; padding: 0.25em 0.75em; border-radius: 999px; font-size: 0.78rem; font-weight: 600; }
  .ax-free, .ax-freemium, .ax-open, .ax-try { background: #d1f7e0; color: #0f5132; }
  .ax-self-serve { background: #cfe2ff; color: #0a3d91; }
  .ax-free-trial { background: #cff4e4; color: #0f5132; }
  .ax-paid { background: #e9ecef; color: #495057; }
  .ax-enterprise, .ax-approval { background: #ffe0c2; color: #7a3e07; }
  .ax-gated-partner { background: #ffe0c2; color: #7a3e07; }
  .ax-gated-private { background: #f8d7da; color: #842029; }
  .score-meta a:hover { text-decoration: underline; }
  @media (max-width: 560px) { .score-meta { margin-left: 0; text-align: left; width: 100%; } }
  /* Agent readiness — a SEPARATE axis from the composite, so its own divider,
     label, and pill palette (teal/agent family) rather than the composite ladder. */
  .score-divider { width: 1px; align-self: stretch; background: #e3e7ee; margin: 0 0.35rem; }
  .agent-label { font-size: 0.7rem; text-transform: uppercase; letter-spacing: 0.05em; color: #8a94a6; font-weight: 700; }
  .agent-score { font-size: 1.25rem; font-weight: 700; color: #1a1a2e; font-variant-numeric: tabular-nums; line-height: 1; }
  .agent-score span { font-size: 0.8rem; font-weight: 500; color: #8a94a6; }
  .band-agent-native { background: #cff4e6; color: #0b6b4f; }
  .band-agent-ready  { background: #d7ebff; color: #0a4b8c; }
  .band-agent-aware  { background: #fff0d4; color: #7a5200; }
  .band-human-only   { background: #eceef1; color: #5a6472; }

  /* Front Door AI — a third, OPTIONAL axis beside the composite and agent
     readiness. It counts AI vocabulary on the provider's home page: what the
     company SAYS, not what it ships. Deliberately not part of the composite and
     never coloured as good/bad — the ramp is one neutral hue getting stronger,
     because saying a lot about AI is a fact about a home page, not a failing.
     Stamped into frontmatter by build.py's _stamp_front_door_ai() from
     signals/_data/front-door-ai/providers-latest.json. */
  .fdai-label { font-size: 0.7rem; text-transform: uppercase; letter-spacing: 0.05em; color: #8a94a6; font-weight: 700; }
  .fdai-score { font-size: 1.25rem; font-weight: 700; color: #1a1a2e; font-variant-numeric: tabular-nums; line-height: 1; }
  .fdai-score span { font-size: 0.8rem; font-weight: 500; color: #8a94a6; }
  .fdai-1 { background: #eceef1; color: #5a6472; }
  .fdai-2 { background: #eef2fb; color: #4a5a7a; }
  .fdai-3 { background: #e0e9f9; color: #3c5488; }
  .fdai-4 { background: #d2e0f6; color: #2f4a8c; }
  .fdai-5 { background: #c2d6f3; color: #24408a; }
  .fdai-6 { background: #b0caf0; color: #1b3680; }

  /* Heartbeat — a SECONDARY axis beside Front Door AI: is the provider still
     making noise (blog, press, GitHub), and is that noise fading? The 90-day
     window against the 90 before it. Not part of the composite. Neutral greys
     except going_silent, which is the one reading the index exists to raise.
     Stamped by build.py's _stamp_heartbeat() from
     signals/_data/heartbeat/providers-latest.json. */
  .hb-alive        { background: #d2e0f6; color: #2f4a8c; }
  .hb-slowing      { background: #eef2fb; color: #4a5a7a; }
  .hb-going_silent { background: #fff0d4; color: #7a5200; }
  .hb-dormant      { background: #eceef1; color: #5a6472; }

  /* On-page contents nav — chips that jump to the sections this provider actually
     has. Makes the depth of data navigable instead of an endless scroll. */
  .toc-nav { display: flex; flex-wrap: wrap; gap: 0.4rem; margin: 0 0 2rem; padding: 0.9rem 1rem; background: #fbfcfe; border: 1px solid #e3e7ee; border-radius: 10px; }
  .toc-nav .toc-label { font-size: 0.7rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em; color: #8a94a6; align-self: center; margin-right: 0.25rem; }
  .toc-chip { display: inline-flex; align-items: center; gap: 0.35rem; padding: 0.3rem 0.7rem; background: #fff; border: 1px solid #dbe2ec; border-radius: 999px; font-size: 0.8rem; font-weight: 500; color: #2d3748; text-decoration: none; transition: all 0.12s; }
  .toc-chip:hover { border-color: #0d6efd; color: #0d6efd; box-shadow: 0 1px 4px rgba(13,110,253,0.12); }
  .toc-chip .toc-count { font-variant-numeric: tabular-nums; font-weight: 700; color: #8a94a6; font-size: 0.75rem; }
  .toc-chip:hover .toc-count { color: #0d6efd; }
  .std-implements { display: grid; gap: 0.6rem; margin-bottom: 1.5rem; }
  .std-impl-row { border: 1px solid #e3e7ee; border-radius: 10px; padding: 0.85rem 1rem; background: #fff; }
  .std-impl-main { display: flex; align-items: center; gap: 0.55rem; flex-wrap: wrap; margin-bottom: 0.3rem; }
  .std-impl-name { font-weight: 700; color: #1a1a2e; text-decoration: none; font-size: 1rem; }
  .std-impl-name:hover { color: #0d6efd; }
  .std-impl-tier { font-family: monospace; font-size: 0.7rem; text-transform: uppercase; letter-spacing: 0.05em; padding: 0.12rem 0.45rem; border-radius: 4px; }
  .std-impl-tier.tier-core { background: #dcebe8; color: #0e6e62; }
  .std-impl-tier.tier-extended { background: #f3e8d2; color: #8a5e12; }
  .std-impl-ver { font-family: monospace; font-size: 0.72rem; color: #6c757d; background: #f4f6f8; border: 1px solid #e3e7ee; border-radius: 4px; padding: 0.1rem 0.4rem; }
  .std-impl-ev { font-size: 0.85rem; color: #4a5568; }
  .std-impl-ev strong { color: #1a1a2e; }
  .std-impl-meta { font-size: 0.78rem; color: #8a94a6; margin-top: 0.3rem; }
  .std-impl-meta a { color: #8a94a6; }

  /* Delivery-model pill — sits with the score because it says what the score
     measured. Muted next to the band pill: it is context, not a verdict. */
  .delivery-pill{display:inline-flex;align-items:center;gap:.3rem;padding:.15rem .5rem;
    border:1px solid rgba(0,0,0,.15);border-radius:999px;font-size:.72rem;
    text-transform:capitalize;letter-spacing:.01em;white-space:nowrap;opacity:.9}
  .dm-saas{background:#eef4ff;border-color:#c7d8ff;color:#22407a}
  .dm-self-hosted{background:#eefaf1;border-color:#c3e8d0;color:#1d5b34}
  .dm-open-core{background:#fdf3e7;border-color:#f0d6ae;color:#7a4b12}
  .dm-library{background:#f4f0fb;border-color:#ddd0f2;color:#4c2f7a}
  /* Kin Score brand mark — the API Evangelist rating system, an API Evangelist product
     licensed by apis.io. Kin icon + wordmark, links to the rating page. */
  .ae-rating-mark { display: flex; align-items: center; gap: 0.4rem; text-decoration: none; }
  .ae-rating-mark img { height: 30px; width: auto; }
  .ae-rating-mark span { font-size: 0.72rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.04em; color: #0a3d91; }
  .ae-rating-mark:hover span { text-decoration: underline; }

  /* Inline rating panel — the full score breakdown, rendered on the page (no popup).
     Green fill = points applied, red track = points possible, so every bar reads as
     earned-vs-possible at a glance. Rendered from site.data.scoring (mirrored from
     signals/_data/scoring.yml) + the frontmatter score. */
  .rating-panel { background: #fff; border: 1px solid #e3e7ee; border-radius: 12px; padding: 1.5rem; }
  .rp-topline { display: flex; align-items: center; gap: 1rem; flex-wrap: wrap; margin-bottom: 1.25rem; padding-bottom: 1.1rem; border-bottom: 1px solid #eef1f5; }
  .rp-topline .ae-rating-mark { margin-right: auto; }
  .rp-scored { font-size: 0.75rem; color: #8a94a6; text-align: right; }
  .rp-scored a { color: #0d6efd; text-decoration: none; }
  .rp-scored a:hover { text-decoration: underline; }
  /* Every facet and dimension label links to its own page under /rating/. The
     label was already the one piece of the panel a reader wants to interrogate —
     "what IS Contract Quality, and who is good at it" — and until 2026-09-01 the
     only answer was /rating/, which documents all 141 checks at once. Absolute
     apis.io URLs on purpose: this layout also renders on providers.apis.io, where
     a root-relative /rating/ path resolves to nothing. */
  .rd-label a { color: inherit; text-decoration: none; border-bottom: 1px dotted #b9c6dd; }
  .rd-label a:hover { color: #0a3d91; border-bottom-color: #0a3d91; }
  .rd-label a abbr { text-decoration: none; }
  /* Diagram — one vertical bar per facet + agent readiness, the at-a-glance picture. */
  .rd-diagram { display: flex; align-items: flex-end; gap: 8px; height: 110px; padding: 0.3rem 0 1.5rem; border-bottom: 1px solid #eef1f5; margin-bottom: 1.25rem; }
  .rd-col { flex: 1; display: flex; flex-direction: column; align-items: center; height: 100%; position: relative; }
  .rd-vbar { width: 100%; max-width: 40px; height: 100%; background: #fbe0e3; border-radius: 5px; display: flex; align-items: flex-end; overflow: hidden; }
  .rd-vfill { width: 100%; background: linear-gradient(180deg, #16a34a, #0b6b4f); border-radius: 0 0 5px 5px; }
  .rd-col-agent .rd-vbar { background: #eef2f8; }
  .rd-col-agent .rd-vfill { background: linear-gradient(180deg, #2f7fd6, #0a4b8c); }
  .rd-vnum { position: absolute; top: -1.15rem; font-size: 0.72rem; font-weight: 700; color: #4a5568; font-variant-numeric: tabular-nums; }
  .rd-vlabel { position: absolute; bottom: -1.35rem; font-size: 0.62rem; color: #6c757d; white-space: nowrap; text-align: center; max-width: 6rem; overflow: hidden; text-overflow: ellipsis; }
  /* Two-column breakdown: composite facets on the left, agent readiness on the right. */
  .rd-cols { display: grid; grid-template-columns: 1fr 1fr; gap: 1.5rem 2rem; }
  @media (max-width: 640px) { .rd-cols { grid-template-columns: 1fr; } }
  .rd-section-title { font-size: 0.82rem; font-weight: 700; color: #1a1a2e; margin: 0 0 0.6rem; padding-bottom: 0.35rem; border-bottom: 1px solid #f0f2f5; }
  .rd-section-title .rd-band { font-weight: 600; color: #6c757d; text-transform: capitalize; }
  .rd-row { display: grid; grid-template-columns: 1fr 84px 58px; align-items: center; gap: 0.5rem; padding: 0.28rem 0; font-size: 0.83rem; }
  .rd-label { color: #2d3748; display: flex; align-items: center; gap: 0.35rem; }
  .rd-label abbr { text-decoration: none; border-bottom: 1px dotted #b6c0d0; cursor: help; }
  .rd-dot { width: 9px; height: 9px; border-radius: 50%; flex-shrink: 0; }
  .rd-dot.on { background: #16a34a; } .rd-dot.off { background: #dc3545; }
  .rd-track { height: 8px; background: #fbe0e3; border-radius: 999px; overflow: hidden; }
  .rd-fill { display: block; height: 100%; background: linear-gradient(90deg, #16a34a, #0b6b4f); border-radius: 999px; }
  .rd-col-agent-rows .rd-track { background: #e6edf7; }
  .rd-col-agent-rows .rd-fill { background: linear-gradient(90deg, #2f7fd6, #0a4b8c); }
  .rd-pts { text-align: right; font-variant-numeric: tabular-nums; font-size: 0.78rem; color: #4a5568; white-space: nowrap; }
  .rd-pts b { color: #0b6b4f; } .rd-pts.miss b { color: #dc3545; }
  .rd-col-agent-rows .rd-pts b { color: #0a4b8c; }
  .rd-foot { margin-top: 1.25rem; padding-top: 1rem; border-top: 1px solid #eef1f5; font-size: 0.85rem; color: #4a5568; line-height: 1.55; }
  .rd-foot a { color: #0a3d91; font-weight: 600; text-decoration: none; }
  .rd-foot a:hover { text-decoration: underline; }
  .rd-foot .rd-price { display: inline-block; margin-top: 0.5rem; margin-right: 1.25rem; font-weight: 700; color: #0a3d91; }

  .section-anchor { font-size: 1.25rem; font-weight: 700; color: #1a1a2e; margin: 2.5rem 0 1rem; padding-bottom: 0.5rem; border-bottom: 2px solid #e3e7ee; scroll-margin-top: 1rem; }
  .section-anchor a { color: inherit; text-decoration: none; }
  .section-anchor a:hover { color: #0d6efd; }
  /* Box header count + one-line summary — every artifact box carries both, so the
     depth of data is legible before the cards even load. Rendered by
     _includes/provider-box.html (the single source for every box). */
  .section-anchor .section-count { font-size: 0.9rem; font-weight: 700; color: #8a94a6; font-variant-numeric: tabular-nums; margin-left: 0.15rem; }
  .section-blurb { color: #8a94a6; font-size: 0.85rem; line-height: 1.5; margin: -0.4rem 0 1rem; }
  .card-meta { font-size: 0.8rem; color: #666; margin: 0 0 0.5rem; }
  .card-badge { display: inline-block; padding: 0.15em 0.5em; border-radius: 4px; font-size: 0.7rem; font-weight: 700; color: #fff; }
  .card-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(340px, 1fr)); gap: 1rem; margin-bottom: 2rem; }
  .item-card { background: white; border: 1px solid #e3e7ee; border-radius: 10px; padding: 1.25rem; transition: all 0.15s; }
  .item-card:hover { border-color: #0d6efd; box-shadow: 0 2px 8px rgba(13,110,253,0.1); transform: translateY(-1px); }
  .item-card h4 { font-size: 1rem; font-weight: 600; margin-bottom: 0.25rem; }
  .item-card h4 a { color: #1a1a2e; text-decoration: none; }
  .item-card h4 a:hover { color: #0d6efd; }
  .item-card p { font-size: 0.85rem; color: #666; margin-bottom: 0.5rem; }
  .item-card .tags { display: flex; flex-wrap: wrap; gap: 0.3rem; }
  .tag-sm { display: inline-block; padding: 0.2em 0.6em; background: #eef2f7; color: #4a5568; border-radius: 999px; font-size: 0.75rem; text-decoration: none; }
  a.tag-sm:hover { background: #dde5ef; color: #1f2d3d; }
  .resource-link { display: flex; align-items: center; gap: 0.5rem; padding: 0.6rem 0; border-bottom: 1px solid #f0f2f5; font-size: 0.9rem; }
  .resource-link:last-child { border-bottom: none; }
  .resource-link a { color: #0d6efd; text-decoration: none; }
  .resource-link a:hover { text-decoration: underline; }
  .resource-type { font-size: 0.75rem; font-weight: 600; color: #6c757d; text-transform: uppercase; min-width: 120px; }
  .feature-item { padding: 0.75rem 0; border-bottom: 1px solid #f0f2f5; }
  .feature-item:last-child { border-bottom: none; }
  .feature-item strong { color: #1a1a2e; }
  .feature-item p { margin: 0.25rem 0 0; font-size: 0.85rem; color: #666; }

  /* Scroll pane — artifact lists that routinely run to dozens of entries
     (examples, JSON Schema, JSON Structure, schemas, scopes) are capped at
     roughly two card rows and scroll internally, so one prolific provider
     can't push the rest of the page kilometres down. Height is expressed in
     rem so it tracks the card's own type scale. */
  .scroll-pane { max-height: 17.5rem; overflow-y: auto; overscroll-behavior: contain;
                 padding: 0.75rem; margin-bottom: 0.35rem;
                 background: #fbfcfe; border: 1px solid #e8ecf3; border-radius: 10px; }
  .scroll-pane::-webkit-scrollbar { width: 10px; }
  .scroll-pane::-webkit-scrollbar-track { background: transparent; }
  .scroll-pane::-webkit-scrollbar-thumb { background: #cdd6e4; border-radius: 999px;
                                          border: 3px solid #fbfcfe; }
  .scroll-pane::-webkit-scrollbar-thumb:hover { background: #aab6c8; }
  .scroll-pane { scrollbar-width: thin; scrollbar-color: #cdd6e4 transparent; }
  /* The grid inside a pane loses the outer bottom margin — the pane owns spacing. */
  .card-grid.scroll-pane { margin-bottom: 0.35rem; }
  .scroll-hint { font-size: 0.75rem; color: #8a94a6; margin: 0 0 2rem; }

  /* Resource groups — same visual logic as the rating panel's facet sections:
     a titled band with a count, a one-line explanation of what the group is
     for, then the items. */
  .res-group { margin-bottom: 1.75rem; }
  .res-group-head { margin-bottom: 0.75rem; }

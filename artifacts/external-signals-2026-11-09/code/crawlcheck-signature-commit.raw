0Z\",\"nbf\":1791655245}]}\n\\ No newline at end of file"},{"sha":"636433a376eb8030e89cb0a9eb2be114456b1e43","filename":"sdk/test/fixtures/lock-signed-noparts.json","status":"added","additions":1,"deletions":0,"changes":1,"blob_url":"https://github.com/emmanuelorta/crawlcheck-core/blob/c634f497bd5873c2b2bd9f3ca9a26b188e08ac2a/sdk%2Ftest%2Ffixtures%2Flock-signed-noparts.json","raw_url":"https://github.com/emmanuelorta/crawlcheck-core/raw/c634f497bd5873c2b2bd9f3ca9a26b188e08ac2a/sdk%2Ftest%2Ffixtures%2Flock-signed-noparts.json","contents_url":"https://api.github.com/repos/emmanuelorta/crawlcheck-core/contents/sdk%2Ftest%2Ffixtures%2Flock-signed-noparts.json?ref=c634f497bd5873c2b2bd9f3ca9a26b188e08ac2a","patch":"@@ -0,0 +1 @@\n+{\"kind\":\"crawlcheck-mcp-lock\",\"v\":1,\"spec\":\"https://crawlcheck.io/spec/mcp-lockfile\",\"server\":{\"url\":\"https://crawlcheck.io/mcp\",\"protocol_version\":\"2025-06-18\",\"info\":{\"name\":\"crawlcheck\",\"version\":\"1.2.1\"}},\"approved_at\":\"2026-11-07T18:37:56.164Z\",\"hash\":\"sha256 of the canonical JSON (sorted keys, no whitespace) of {name, description, inputSchema, annotations} per tool; tools_sha256 = sha256 of the per-tool hashes sorted and joined by \\\\n\",\"tools_sha256\":\"b12c0d6a5dc1a55943cd19351118aae36ebe73268f7bd8c975fa571a62a6d251\",\"count\":28,\"tools\":[{\"name\":\"best_source\",\"sha256\":\"afe85219a2adcc1356f23be4cd619dd9bbac59440e892fb2d89efafb3e62864d\"},{\"name\":\"check_site_safety\",\"sha256\":\"bc49e8cd00051b0a9a198142cf16b943ac72ad7e4db7f9e6967578d898d296c1\"},{\"name\":\"corpus_state\",\"sha256\":\"ffe4fb58f5e15fc6b10077fed0d27d894571b7c4e1235bba1507383e4f9f3a8c\"},{\"name\":\"crawler_path\",\"sha256\":\"e2b5d97e809e8bfce6cffc37603b0b0a790f3e2498fbb3cb67b1fb96c5deb19c\"},{\"name\":\"draft_llms\",\"sha256\":\"17d64680429bddb9ab0e6dbf73841ca5c4a5c1ad85cc19e7986936694a116595\"},{\"name\":\"explain_finding\",\"sha256\":\"20c1a55d78912193564306da035207f2ec5d5826efeb53317699f225748097dc\"},{\"name\":\"fiel
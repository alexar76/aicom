{"sha":"c634f497bd5873c2b2bd9f3ca9a26b188e08ac2a","node_id":"C_kwDOUMx3jtoAKGM2MzRmNDk3YmQ1ODczYzJiMmJkOWYzY2E5YTI2YjE4OGUwOGFjMmE","commit":{"author":{"name":"Claude","email":"noreply@anthropic.com","date":"2026-11-07T18:58:51Z"},"committer":{"name":"Claude","email":"noreply@anthropic.com","date":"2026-11-07T18:58:51Z"},"message":"SDK 1.13.0 (JS) / 1.14.0 (Python): signed baseline - the lockfile's signature is verified at gate creation\n\nMirror of emmanuelorta/crawlcheck 1c0279f6 (sdk/, sdk-python/).\n\nCo-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>\nClaude-Session: https://claude.ai/code/session_01VJdbLNJj6mqbaamz9u9jtj","tree":{"sha":"67f8a752ea83fe185c110fab636b8f2355ad7a37","url":"https://api.github.com/repos/emmanuelorta/crawlcheck-core/git/trees/67f8a752ea83fe185c110fab636b8f2355ad7a37"},"url":"https://api.github.com/repos/emmanuelorta/crawlcheck-core/git/commits/c634f497bd5873c2b2bd9f3ca9a26b188e08ac2a","comment_count":0,"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN SSH SIGNATURE-----\nU1NIU0lHAAAAAQAAADMAAAALc3NoLWVkMjU1MTkAAAAgrLzsfFISF4by8Q+FKz27YpkK1USsBB+m\namu1QkJnbDsAAAADZ2l0AAAAAAAAAAZzaGE1MTIAAABTAAAAC3NzaC1lZDI1NTE5AAAAQJMDl0aw\nnui4oQa0+wStmfIhQRDtLBJ1W/f5No52fl3B11dbLpMATwQ5dAaxuMkpkz8macdua4az8DvheM4p\n0gU=\n-----END SSH SIGNATURE-----","payload":"tree 67f8a752ea83fe185c110fab636b8f2355ad7a37\nparent c6bc96fcacbcd17dfded7791d9cd50a8b8dffa36\nauthor Claude <noreply@anthropic.com> 1794077931 -0700\ncommitter Claude <noreply@anthropic.com> 1794077931 -0700\n\nSDK 1.13.0 (JS) / 1.14.0 (Python): signed baseline - the lockfile's signature is verified at gate creation\n\nMirror of emmanuelorta/crawlcheck 1c0279f6 (sdk/, sdk-python/).\n\nCo-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>\nClaude-Session: https://claude.ai/code/session_01VJdbLNJj6mqbaamz9u9jtj\n","verified_at":"2026-11-07T18:58:54Z"}},"url":"https://api.github.com/repos/emmanuelorta/crawlcheck-core/commits/c634f497bd5873c2b2bd9f3ca9a26b188e08ac2a","html_url":"https://github.com/emmanuelorta/crawlcheck-core/commit/c634f497bd5873c2b2bd9f3ca9a26b188e08ac2a","comments_url":"https://api.github.com/repos/emmanuelorta/crawlcheck-core/commits/c634f497bd5873c2b2bd9f3ca9a26b188e08ac2a/comments","author":{"login":"claude","id":81847,"node_id":"MDQ6VXNlcjgxODQ3","avatar_url":"https://avatars.githubusercontent.com/u/81847?v=4","gravatar_id":"","url":"https://api.github.com/users/claude","html_url":"https://github.com/claude","followers_url":"https://api.github.com/users/claude/followers","following_url":"https://api.github.com/users/claude/following{/other_user}","gists_url":"https://api.github.com/users/claude/gists{/gist_id}","starred_url":"https://api.github.com/users/claude/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/claude/subscriptions","organizations_url":"https://api.github.com/users/claude/orgs","repos_url":"https://api.github.com/users/claude/repos","events_url":"https://api.github.com/users/claude/events{/privacy}","received_events_url":"https://api.github.com/users/claude/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"claude","id":81847,"node_id":"MDQ6VXNlcjgxODQ3","avatar_url":"https://avatars.githubusercontent.com/u/81847?v=4","gravatar_id":"","url":"https://api.github.com/users/claude","html_url":"https://github.com/claude","followers_url":"https://api.github.com/users/claude/followers","following_url":"https://api.github.com/users/claude/following{/other_user}","gists_url":"https://api.github.com/users/claude/gists{/gist_id}","starred_url":"https://api.github.com/users/claude/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/claude/subscriptions","organizations_url":"https://api.github.com/users/claude/orgs","repos_url":"https://api.github.com/users/claude/repos","events_url":"https://api.github.com/users/claude/events{/privacy}","received_events_url":"https://api.github.com/users/claude/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"c6bc96fcacbcd17dfded7791d9cd50a8b8dffa36","url":"https://api.github.com/repos/emmanuelorta/crawlcheck-core/commits/c6bc96fcacbcd17dfded7791d9cd50a8b8dffa36","html_url":"https://github.com/emmanuelorta/crawlcheck-core/commit/c6bc96fcacbcd17dfded7791d9cd50a8b8dffa36"}],"stats":{"total":12398,"additions":12064,"deletions":334},"files":[{"sha":"924d7eeda7bf122711108c7a235a9cf812f6f2dd","filename":"sdk-python/README.md","status":"modified","additions":27,"deletions":0,"changes":27,"blob_url":"https://github.com/emmanuelorta/crawlcheck-core/blob/c634f497bd5873c2b2bd9f3ca9a26b188e08ac2a/sdk-python%2FREADME.md","raw_url":"https://github.com/emmanuelorta/crawlcheck-core/raw/c634f497bd5873c2b2bd9f3ca9a26b188e08ac2a/sdk-python%2FREADME.md","contents_url":"https://api.github.com/repos/emmanuelorta/crawlcheck-core/contents/sdk-python%2FREADME.md?ref=c634f497bd5873c2b2bd9f3ca9a26b188e08ac2a","patch":"@@ -122,6 +122,33 @@ with with_continuity(MCPServerAdapter(server_params), lock, mode=\"observe\") as t\n \n 1.13.0 also fixes `with_preflight` continuity with the MCP Python SDK: a real `mcp.types.Tool` was hashed with its annotations' unset keys, so every annotated tool read as changed against a lockfile built from the server's JSON.\n \n+### Check the baseline before trusting it (1.14.0)\n+\n+Whoever can edit your approved lockfile can approve their own tools. So every gate (`McpPreflight` / `with_preflight` with `lock=`, `ContinuityGate` and the three framework adapters) checks the lockfile's signature once, when it is constructed, before it compares anything against it:\n+\n+| `baseline[\"trust\"]` | meaning |\n+|---|---|\n+| `verified` | signed by CrawlCheck (`cc.mcp_lock(url)` / `GET /api/v1/mcp/lock`) with a CrawlCheck key. The package ships the published key ids (`CRAWLCHECK_LOCK_KIDS`); pass `key_policy=key_policy_from(directory)` to follow a key rotation. These lockfiles carry `parts` inside the signature; `parts` added afterwards are not used. |\n+| `operator_signed` | you signed it with `sign_lock` and passed your public key in `operator_keys`. Use this when you edit a lockfile yourself, for example to drop a tool. |\n+| `unsigned` | no signature. Accepted unless `require_signed_baseline=True` (on by default once you pass `operator_keys`). |\n+| `invalid` | the signature does not verify, the file was changed after signing, or the key is neither CrawlCheck's nor one of yours. |\n+\n+`invalid`, or `unsigned` when a signed one is required, is the failure class `baseline_untrusted`: in `enforce` and `review` the constructor raises (`ContinuityRefused` / `McpPreflightRefused`), so the agent fails at startup; `observe` records it and goes on. Every record names the result in `baseline.trust`. Nothing is verified per call. The adapters take the options as `baseline={\"operator_keys\": [...], \"require_signed_baseline\": True}`; `McpPreflight` takes them in `continuity={...}` or as keyword arguments.\n+\n+Sign your own lockfile, with no command line:\n+\n+```python\n+from crawlcheck import new_operator_key, sign_lock\n+from crawlcheck.continuity_gate import ContinuityGate\n+\n+key = new_operator_key()                       # once; store key[\"private_key\"] where the agent cannot read it\n+signed = sign_lock(lock, key[\"private_key\"])   # after you review (or edit) the lockfile; save signed\n+# at startup, with only the public key:\n+gate = ContinuityGate(signed, mode=\"enforce\", operator_keys=[key[\"public_key\"]])\n+```\n+\n+`verify_lock_baseline(lock, ...)` runs the same check on its own. The signature is Ed25519 over `\"crawlcheck-lock-operator-v1\\n\" + sha256(canonical JSON of the lockfile without operator_signature)`, the same bytes the JS SDK signs; signing is pure Python and not constant-time, so sign on a machine you control.\n+\n ## Catch a split view\n \n Every Resolve answer carries its place in CrawlCheck's transparency log. The client keeps every signed tree head it sees in `client.log` (plain JSON; persist it and pass it back as `log_store=`) and treats two heads for one batch, or a head that does not chain to the one before, as a fork with both signed heads as proof. `guard()` returns `False` while the client holds one."},{"sha":"5979c25b0e8c0aee82e42ffdc560d6813f20e39d","filename":"sdk-python/crawlcheck/__init__.py","status":"modified","additions":3,"deletions":2,"changes":5,"blob_url":"https://github.com/emmanuelorta/crawlcheck-core/blob/c634f497bd5873c2b2bd9f3ca9a26b188e08ac2a/sdk-python%2Fcrawlcheck%2F__init__.py","raw_url":"https://github.com/emmanuelorta/crawlcheck-core/raw/c634f497bd5873c2b2bd9f3ca9a26b188e08ac2a/sdk-python%2Fcrawlcheck%2F__init__.py","contents_url":"https://api.github.com/repos/emmanuelorta/crawlcheck-core/contents/sdk-python%2Fcrawlcheck%2F__init__.py?ref=c634f497bd5873c2b2bd9f3ca9a26b188e08ac2a","patch":"@@ -3,7 +3,8 @@\n from .verify import verify_document, canon, key_id, KEY_POLICY, key_policy_from, key_policy_check, apply_key_policy\n from .lock import lock_tool_hash, lock_from_tools, check_lock\n from .continuity import (continuity_check, continuity_failure, continuity_policy, acceptance_of, lock_parts, lock_tool_parts,\n-                         CONTINUITY_DEFAULT_POLICY, CONTINUITY_CHANGE_CLASSES, CONTINUITY_FAILURE_CLASSES)\n+                         CONTINUITY_DEFAULT_POLICY, CONTINUITY_CHANGE_CLASSES, CONTINUITY_FAILURE_CLASSES,\n+                         verify_lock_baseline, sign_lock, new_operator_key, CRAWLCHECK_LOCK_KIDS)\n from .staple import parse_staple, staple_check, staple_from_headers\n from .mcp import McpPreflight, McpPreflightRefused, with_preflight\n from .continuity_gate import ContinuityGate, ContinuityRefused\n@@ -12,4 +13,4 @@\n from .log import new_log_store, log_observe, log_observe_answer, log_heads, log_gossip, log_check, verify_witness_token\n \n __version__ = VERSION\n-__all__ = [\"CrawlCheck\", \"CrawlCheckError\", \"verify_document\", \"canon\", \"key_id\", \"KEY_POLICY\", \"key_policy_from\", \"key_policy_check\", \"apply_key_policy\", \"ACTIONS\", \"RECEIPT_HEADER\", \"normalize_domain\", \"receipt_header\", \"check_decision\", \"decision_scope\", \"continuity_check\", \"continuity_failure\", \"continuity_policy\", \"acceptance_of\", \"lock_parts\", \"lock_tool_parts\", \"CONTINUITY_DEFAULT_POLICY\", \"CONTINUITY_CHANGE_CLASSES\", \"CONTINUITY_FAILURE_CLASSES\", \"tool_operation\", \"ACTION_MAX_LIFETIME_S\", \"MAX_CLOCK_SKEW_S\", \"lock_tool_hash\", \"lock_from_tools\", \"check_lock\", \"new_log_store\", \"log_observe\", \"log_observe_answer\", \"log_heads\", \"log_gossip\", \"log_check\", \"verify_witness_token\", \"parse_staple\", \"staple_check\", \"staple_from_headers\", \"new_revocation_store\", \"apply_revocations\", \"revoked_for\", \"McpPreflight\", \"McpPreflightRefused\", \"ContinuityGate\", \"ContinuityRefused\", \"with_preflight\", \"agent_tools\", \"tools_for\", \"__version__\"]\n+__all__ = [\"CrawlCheck\", \"CrawlCheckError\", \"verify_document\", \"canon\", \"key_id\", \"KEY_POLICY\", \"key_policy_from\", \"key_policy_check\", \"apply_key_policy\", \"ACTIONS\", \"RECEIPT_HEADER\", \"normalize_domain\", \"receipt_header\", \"check_decision\", \"decision_scope\", \"continuity_check\", \"continuity_failure\", \"continuity_policy\", \"acceptance_of\", \"lock_parts\", \"lock_tool_parts\", \"CONTINUITY_DEFAULT_POLICY\", \"CONTINUITY_CHANGE_CLASSES\", \"CONTINUITY_FAILURE_CLASSES\", \"verify_lock_baseline\", \"sign_lock\", \"new_operator_key\", \"CRAWLCHECK_LOCK_KIDS\", \"tool_operation\", \"ACTION_MAX_LIFETIME_S\", \"MAX_CLOCK_SKEW_S\", \"lock_tool_hash\", \"lock_from_tools\", \"check_lock\", \"new_log_store\", \"log_observe\", \"log_observe_answer\", \"log_heads\", \"log_gossip\", \"log_check\", \"verify_witness_token\", \"parse_staple\", \"staple_check\", \"staple_from_headers\", \"new_revocation_store\", \"apply_revocations\", \"revoked_for\", \"McpPreflight\", \"McpPreflightRefused\", \"ContinuityGate\", \"ContinuityRefused\", \"with_preflight\", \"agent_tools\", \"tools_for\", \"__version__\"]"},{"sha":"dd69b4a62ff8bccdccd9baedb3fff2419912537a","filename":"sdk-python/crawlcheck/_ed25519.py","status":"modified","additions":33,"deletions":1,"changes":34,"blob_url":"https://github.com/emmanuelorta/crawlcheck-core/blob/c634f497bd5873c2b2bd9f3ca9a26b188e08ac2a/sdk-python%2Fcrawlcheck%2F_ed25519.py","raw_url":"https://github.com/emmanuelorta/crawlcheck-core/raw/c634f497bd5873c2b2bd9f3ca9a26b188e08ac2a/sdk-python%2Fcrawlcheck%2F_ed25519.py","contents_url":"https://api.github.com/repos/emmanuelorta/crawlcheck-core/contents/sdk-python%2Fcrawlcheck%2F_ed25519.py?ref=c634f497bd5873c2b2bd9f3ca9a26b188e08ac2a","patch":"@@ -1,4 +1,6 @@\n-\"\"\"Pure-Python Ed25519 signature verification (RFC 8032, section 5.1.7). Verify only; no secret keys are handled.\"\"\"\n+\"\"\"Pure-Python Ed25519 (RFC 8032): verification (section 5.1.7) and, for sign_lock() since 1.14.0, signing (5.1.6).\n+Signing is not constant-time: use it to sign configuration such as a lockfile on a machine you control, not as a\n+general-purpose signing service.\"\"\"\n import hashlib\n \n _p = 2 ** 255 - 19\n@@ -82,3 +84,33 @@ def verify(public: bytes, msg: bytes, sig: bytes) -> bool:\n         return False\n     h = int.from_bytes(hashlib.sha512(Rs + public + msg).digest(), \"little\") % _q\n     return _equal(_mul(s, _G), _add(R, _mul(h, A)))\n+\n+\n+def _compress(P):\n+    zi = _inv(P[2])\n+    x, y = P[0] * zi % _p, P[1] * zi % _p\n+    return int.to_bytes(y | ((x & 1) << 255), 32, \"little\")\n+\n+\n+def _expand(seed):\n+    if len(seed) != 32:\n+        raise ValueError(\"an Ed25519 private key (seed) is 32 bytes\")\n+    h = hashlib.sha512(seed).digest()\n+    a = int.from_bytes(h[:32], \"little\")\n+    a &= (1 << 254) - 8\n+    a |= 1 << 254\n+    return a, h[32:]\n+\n+\n+def public_key(seed: bytes) -> bytes:\n+    a, _ = _expand(seed)\n+    return _compress(_mul(a, _G))\n+\n+\n+def sign(seed: bytes, msg: bytes) -> bytes:\n+    a, prefix = _expand(seed)\n+    A = _compress(_mul(a, _G))\n+    r = int.from_bytes(hashlib.sha512(prefix + msg).digest(), \"little\") % _q\n+    R = _compress(_mul(r, _G))\n+    h = int.from_bytes(hashlib.sha512(R + A + msg).digest(), \"little\") % _q\n+    return R + int.to_bytes((r + h * a) % _q, 32, \"little\")"},{"sha":"8946ffb2f0c593a204b3c0f8b95f28a18e37debb","filename":"sdk-python/crawlcheck/client.py","status":"modified","additions":1,"deletions":1,"changes":2,"blob_url":"https://github.com/emmanuelorta/crawlcheck-core/blob/c634f497bd5873c2b2bd9f3ca9a26b188e08ac2a/sdk-python%2Fcrawlcheck%2Fclient.py","raw_url":"https://github.com/emmanuelorta/crawlcheck-core/raw/c634f497bd5873c2b2bd9f3ca9a26b188e08ac2a/sdk-python%2Fcrawlcheck%2Fclient.py","contents_url":"https://api.github.com/repos/emmanuelorta/crawlcheck-core/contents/sdk-python%2Fcrawlcheck%2Fclient.py?ref=c634f497bd5873c2b2bd9f3ca9a26b188e08ac2a","patch":"@@ -14,7 +14,7 @@\n from .staple import staple_check, staple_from_headers\n from .revocations import new_revocation_store, apply_revocations, revoked_for\n \n-VERSION = \"1.13.0\"\n+VERSION = \"1.14.0\"\n ACTIONS = (\"read\", \"cite\", \"connect\", \"transact\", \"administer\")\n \n "},{"sha":"44b6dc3911c4b2dfa4a27f56f847234a58090f90","filename":"sdk-python/crawlcheck/continuity.py","status":"modified","additions":155,"deletions":5,"changes":160,"blob_url":"https://github.com/emmanuelorta/crawlcheck-core/blob/c634f497bd5873c2b2bd9f3ca9a26b188e08ac2a/sdk-python%2Fcrawlcheck%2Fcontinuity.py","raw_url":"https://github.com/emmanuelorta/crawlcheck-core/raw/c634f497bd5873c2b2bd9f3ca9a26b188e08ac2a/sdk-python%2Fcrawlcheck%2Fcontinuity.py","contents_url":"https://api.github.com/repos/emmanuelorta/crawlcheck-core/contents/sdk-python%2Fcrawlcheck%2Fcontinuity.py?ref=c634f497bd5873c2b2bd9f3ca9a26b188e08ac2a","patch":"@@ -14,23 +14,27 @@\n deny), enforce (the policy applies). Effects, weakest to strongest: proceed, proceed_recorded, refresh, pause_tool, pause, deny.\n \"\"\"\n import hashlib\n+import json\n import math\n+import os\n from datetime import datetime, timezone\n \n-from .verify import canon\n+from . import _ed25519\n+from .verify import canon, key_policy_check, _b64u, _b64u_decode\n \n CONTINUITY_EFFECTS = [\"proceed\", \"proceed_recorded\", \"refresh\", \"pause_tool\", \"pause\", \"deny\"]\n CONTINUITY_CHANGE_CLASSES = [\"tool_added\", \"tool_removed\", \"description_changed\", \"schema_changed\", \"annotations_changed\", \"tool_changed\"]\n CONTINUITY_FAILURE_CLASSES = [\"evidence_expired\", \"signature_invalid\", \"key_unknown\", \"key_retired\", \"server_identity_mismatch\", \"server_unavailable\",\n-                              \"tool_list_truncated\", \"response_malformed\", \"baseline_stale\", \"policy_version_mismatch\", \"check_timeout\", \"service_unavailable\", \"decision_refused\"]\n-_INTEGRITY = [\"signature_invalid\", \"key_unknown\", \"key_retired\", \"server_identity_mismatch\"]\n+                              \"tool_list_truncated\", \"response_malformed\", \"baseline_stale\", \"policy_version_mismatch\", \"check_timeout\", \"service_unavailable\", \"decision_refused\", \"baseline_untrusted\"]\n+_INTEGRITY = [\"signature_invalid\", \"key_unknown\", \"key_retired\", \"server_identity_mismatch\", \"baseline_untrusted\"]\n CONTINUITY_DEFAULT_POLICY = {\n     \"v\": 1, \"id\": \"crawlcheck-continuity-default\", \"max_baseline_age_days\": 90,\n     \"effects\": {\n         \"unchanged\": \"proceed\", \"tool_added\": \"pause_tool\", \"tool_removed\": \"proceed\", \"description_changed\": \"pause_tool\", \"schema_changed\": \"pause_tool\",\n         \"annotations_changed\": \"pause_tool\", \"tool_changed\": \"pause_tool\", \"evidence_expired\": \"refresh\", \"signature_invalid\": \"deny\", \"key_unknown\": \"deny\",\n         \"key_retired\": \"deny\", \"server_identity_mismatch\": \"deny\", \"server_unavailable\": \"pause\", \"tool_list_truncated\": \"pause\", \"response_malformed\": \"pause\",\n         \"baseline_stale\": \"pause\", \"policy_version_mismatch\": \"pause\", \"check_timeout\": \"pause\", \"service_unavailable\": \"pause\", \"decision_refused\": \"deny\",\n+        \"baseline_untrusted\": \"deny\",\n     },\n }\n _WHY = {\n@@ -44,6 +48,7 @@\n     \"baseline_stale\": \"the approved baseline is older than the policy allows\", \"policy_version_mismatch\": \"the policy in force is not the version the deployment expects\",\n     \"check_timeout\": \"the check did not finish in time\", \"service_unavailable\": \"the verification service could not be reached; the local fallback applies\",\n     \"decision_refused\": \"CrawlCheck's signed decision for the server's host did not allow the connection\",\n+    \"baseline_untrusted\": \"the approved baseline is not trusted: its signature does not verify, its key is neither CrawlCheck's nor a given operator key, or it is unsigned where a signed one is required\",\n }\n _CLAIMS = \"interface continuity at this check point: the offered tool definitions were compared with the approved baseline. Not code attestation, not a judgement that any tool is harmless, not user authorisation.\"\n \n@@ -188,7 +193,7 @@ def _strip(u):\n     return str(u).rstrip(\"/\")\n \n \n-def continuity_check(lock, tools, mode=\"enforce\", policy=None, exceptions=None, complete=True, server=None, server_identity=None, expect_policy_sha256=None, now=None):\n+def continuity_check(lock, tools, mode=\"enforce\", policy=None, exceptions=None, complete=True, server=None, server_identity=None, expect_policy_sha256=None, now=None, baseline_trust=None):\n     \"\"\"Compare the offered tools with the approved baseline and apply the policy. complete=False when tools/list returned a\n     nextCursor you did not follow. server: the URL checked; server_identity: the URL the baseline was approved for.\"\"\"\n     if mode not in (\"observe\", \"review\", \"enforce\"):\n@@ -210,7 +215,7 @@ def continuity_check(lock, tools, mode=\"enforce\", policy=None, exceptions=None,\n     appr = _ms(lock.get(\"approved_at\"))\n     srv = (lock.get(\"server\") or {}).get(\"url\") if isinstance(lock.get(\"server\"), dict) else None\n     rec[\"baseline\"] = {\"tools_sha256\": lock.get(\"tools_sha256\"), \"approved_at\": lock.get(\"approved_at\"), \"age_days\": int(math.floor((now - appr) / 864e5)) if appr is not None else None,\n-                       \"server\": srv, \"per_part\": bool(lock.get(\"parts\"))}\n+                       \"server\": srv, \"per_part\": bool(lock.get(\"parts\")), \"trust\": baseline_trust}\n     rec[\"observed\"] = {\"tools_sha256\": list_hash, \"count\": len(rows), \"complete\": complete is not False}\n     if expect_policy_sha256 and expect_policy_sha256 != pol[\"sha256\"]:\n         _ev(rec, pol, mode, \"policy_version_mismatch\", None, exceptions, now, \"expected %s, in force %s\" % (expect_policy_sha256, pol[\"sha256\"]))\n@@ -340,3 +345,148 @@ def continuity_class_of(proceed, receipt, acceptance, why):\n         if not A.get(\"subject_matches\") or A.get(\"operation_matches\") is False or A.get(\"replay_safe\") is False:\n             return \"server_identity_mismatch\"\n     return \"decision_refused\"\n+\n+\n+# -- signed baseline (1.14.0) ---------------------------------------------------------------------------------------------\n+# Whoever can edit the approved lockfile can approve their own tools. So the baseline's signature is checked once, when a\n+# gate is created (startup), before anything is compared against it. Same contract as the JS SDK's verifyLockBaseline:\n+#   verified         signed by CrawlCheck (/api/v1/mcp/lock, kind crawlcheck-mcp-lock, scheme crawlcheck-data-v1) with a\n+#                    CrawlCheck key: the pinned ids below, published_kids, or key_policy (key_policy_from(directory)).\n+#                    lock[\"parts\"] added after signing is not covered, so it is dropped.\n+#   operator_signed  signed with sign_lock() by a key in operator_keys (the operator's Ed25519 public keys).\n+#   unsigned         no signature. Accepted unless require_signed_baseline (default: on when operator_keys are given).\n+#   invalid          a signature that does not verify, a changed lockfile, or a key that is neither: baseline_untrusted.\n+CRAWLCHECK_LOCK_KIDS = (\"1hHmE3fo1rg5Ig70wuFtJ5wBc7G-sUTgUJkxyPWFRps\", \"hcIAczGf-8EFBnkunmZlvFWnD2nHHeHeC9cM4BTiBVo\")\n+_DATA_PREFIX = \"crawlcheck-data-v1\\n\"\n+_OP_PREFIX = \"crawlcheck-lock-operator-v1\\n\"\n+\n+\n+def _thumb(x):\n+    return _b64u(hashlib.sha256(json.dumps({\"crv\": \"Ed25519\", \"kty\": \"OKP\", \"x\": str(x)}, separators=(\",\", \":\")).encode()).digest())\n+\n+\n+def _ed_ok(x, msg, sig):\n+    try:\n+        return _ed25519.verify(_b64u_decode(x), msg.encode(\"utf-8\"), _b64u_decode(sig))\n+    except Exception:  # noqa: BLE001 - a malformed key or signature is a signature that does not verify\n+        return False\n+\n+\n+def _without(o, keys):\n+    return {k: v for k, v in o.items() if k not in keys}\n+\n+\n+def _x_of(k):\n+    if isinstance(k, str):\n+        return k\n+    if isinstance(k, dict) and isinstance(k.get(\"x\"), str):\n+        return k[\"x\"]\n+    return None\n+\n+\n+def _seed_of(private_key):\n+    if isinstance(private_key, (bytes, bytearray)):\n+        return bytes(private_key)\n+    if isinstance(private_key, dict) and isinstance(private_key.get(\"d\"), str):\n+        return _b64u_decode(private_key[\"d\"])\n+    raise ValueError(\"private_key must be an Ed25519 private JWK with d (see new_operator_key) or the 32-byte seed\")\n+\n+\n+def new_operator_key():\n+    \"\"\"A new operator signing key: {\"private_key\": JWK (keep it away from the agent), \"public_key\": {kty, crv, x} (pass it\n+    in operator_keys), \"kid\"}.\"\"\"\n+    seed = os.urandom(32)\n+    x = _b64u(_ed25519.public_key(seed))\n+    return {\"private_key\": {\"kty\": \"OKP\", \"crv\": \"Ed25519\", \"x\": x, \"d\": _b64u(seed)}, \"public_key\": {\"kty\": \"OKP\", \"crv\": \"Ed25519\", \"x\": x}, \"kid\": _thumb(x)}\n+\n+\n+def sign_lock(lock, private_key):\n+    \"\"\"The operator's signature over the canonical lockfile (every field but operator_signature). Returns a copy with\n+    lock[\"operator_signature\"]. private_key: an Ed25519 private JWK ({kty, crv, x, d}) or the 32-byte seed.\"\"\"\n+    if not isinstance(lock, dict) or not isinstance(lock.get(\"tools\"), list):\n+        raise ValueError(\"lock must be an mcp-lockfile (a dict with a tools list)\")\n+    seed = _seed_of(private_key)\n+    x = _b64u(_ed25519.public_key(seed))\n+    if isinstance(private_key, dict) and private_key.get(\"x\") not in (None, x):\n+        raise ValueError(\"private_key: x is not the public key of d\")\n+    body = _without(lock, (\"operator_signature\",))\n+    message = _OP_PREFIX + _h(canon(body))\n+    out = dict(body)\n+    out[\"operator_signature\"] = {\"v\": 1, \"alg\": \"Ed25519\", \"kid\": _thumb(x), \"message\": message, \"sig\": _b64u(_ed25519.sign(seed, message.encode(\"utf-8\")))}\n+    return out\n+\n+\n+def _has_parts(L):\n+    return isinstance(L, dict) and isinstance(L.get(\"parts\"), dict) and len(L[\"parts\"]) > 0\n+\n+\n+def verify_lock_baseline(lock, operator_keys=None, key_policy=None, published_kids=None, trusted_kids=None):\n+    \"\"\"Is this baseline the one CrawlCheck or the operator signed? Returns {\"trust\": verified | operator_signed | unsigned |\n+    invalid, \"signer\", \"kid\", \"why\", \"parts_used\", \"lock\"}; lock is the baseline to compare against (unsigned parts\n+    removed). Offline; no network.\"\"\"\n+    def R(trust, signer, kid, why, L):\n+        return {\"trust\": trust, \"signer\": signer, \"kid\": kid, \"why\": why, \"parts_used\": _has_parts(L), \"lock\": L if L is not None else lock}\n+    if not isinstance(lock, dict) or not isinstance(lock.get(\"tools\"), list):\n+        return R(\"invalid\", None, None, \"the baseline is not an mcp-lockfile (an object with a tools array)\", None)\n+    op = lock.get(\"operator_signature\")\n+    okeys = [x for x in (_x_of(k) for k in (operator_keys or [])) if x]\n+    if op is not None and (okeys or lock.get(\"signature\") is None):\n+        if not okeys:\n+            return R(\"invalid\", None, None, \"the baseline carries an operator signature, but no operator key was given to check it\", None)\n+        if not isinstance(op, dict) or op.get(\"alg\") != \"Ed25519\" or not all(isinstance(op.get(k), str) for k in (\"kid\", \"sig\", \"message\")):\n+            return R(\"invalid\", None, None, \"the operator signature is malformed\", None)\n+        x = None\n+        for k in okeys:\n+            if _thumb(k) == op[\"kid\"]:\n+                x = k\n+        if not x:\n+            return R(\"invalid\", None, op[\"kid\"], \"the operator signature is by key %s, which is not one of the operator keys given\" % op[\"kid\"], None)\n+        sha = _h(canon(_without(lock, (\"operator_signature\",))))\n+        if op[\"message\"] != _OP_PREFIX + sha:\n+            return R(\"invalid\", \"operator\", op[\"kid\"], \"the baseline was changed after the operator signed it (it hashes to %s)\" % sha, None)\n+        if not _ed_ok(x, op[\"message\"], op[\"sig\"]):\n+            return R(\"invalid\", \"operator\", op[\"kid\"], \"the operator signature does not verify\", None)\n+        return R(\"operator_signed\", \"operator\", op[\"kid\"], \"signed by operator key \" + op[\"kid\"], lock)\n+    s = lock.get(\"signature\")\n+    if s is None:\n+        return R(\"unsigned\", None, None, \"the baseline carries no signature\", lock)\n+    if lock.get(\"kind\") != \"crawlcheck-mcp-lock\" or not isinstance(s, dict) or not str(s.get(\"message\") or \"\").startswith(_DATA_PREFIX):\n+        return R(\"invalid\", None, None, \"the signature is not a CrawlCheck lockfile signature (kind crawlcheck-mcp-lock, scheme crawlcheck-data-v1)\", None)\n+    kid = s.get(\"kid\") if isinstance(s.get(\"kid\"), str) else None\n+    L, stated = lock, lock.get(\"sha256\")\n+    sha = _h(canon(_without(lock, (\"sha256\", \"signature\", \"operator_signature\"))))\n+    if sha != stated and \"parts\" in lock:\n+        sha2 = _h(canon(_without(lock, (\"sha256\", \"signature\", \"operator_signature\", \"parts\"))))\n+        if sha2 == stated:\n+            sha, L = sha2, _without(lock, (\"parts\",))\n+    if sha != stated:\n+        return R(\"invalid\", \"crawlcheck\", kid, \"the baseline was changed after it was signed (it hashes to %s, the signature covers %s)\" % (sha, \"null\" if stated is None else str(stated)), None)\n+    if s.get(\"message\") != _DATA_PREFIX + str(stated):\n+        return R(\"invalid\", \"crawlcheck\", kid, \"the signature does not cover this baseline's digest\", None)\n+    jx = ((s.get(\"key\") or {}).get(\"jwk\") or {}).get(\"x\") if isinstance(s.get(\"key\"), dict) else None\n+    if not isinstance(jx, str):\n+        return R(\"invalid\", \"crawlcheck\", kid, \"the signature carries no key\", None)\n+    if _thumb(jx) != kid:\n+        return R(\"invalid\", \"crawlcheck\", kid, \"the signing key's thumbprint is not its stated key id\", None)\n+    if not _ed_ok(jx, s[\"message\"], s.get(\"sig\") or \"\"):\n+        return R(\"invalid\", \"crawlcheck\", kid, \"the signature does not verify\", None)\n+    if key_policy is not None:\n+        kp = key_policy_check(lock, key_policy)\n+        if kp.get(\"ok\") is not True:\n+            return R(\"invalid\", \"crawlcheck\", kid, \"the key policy rejects the signing key: \" + str(kp.get(\"why\")), None)\n+    else:\n+        ids = published_kids if published_kids is not None else trusted_kids if trusted_kids is not None else CRAWLCHECK_LOCK_KIDS\n+        if kid not in ids:\n+            return R(\"invalid\", \"crawlcheck\", kid, \"the baseline is signed by key %s, which is not a CrawlCheck key\" % kid, None)\n+    return R(\"verified\", \"crawlcheck\", kid, \"signed by CrawlCheck key \" + kid + (\"; lock.parts was added after signing and is not used\" if L is not lock else \"\"), L)\n+\n+\n+def baseline_refusal(b, require_signed):\n+    \"\"\"Why a baseline is refused (None when it is accepted).\"\"\"\n+    if not b:\n+        return \"the baseline was not checked\"\n+    if b[\"trust\"] == \"invalid\":\n+        return b[\"why\"]\n+    if b[\"trust\"] == \"unsigned\" and require_signed:\n+        return \"the baseline is unsigned and a signed one is required\"\n+    return None"},{"sha":"a52bf375629471c30ac44685235b75cbd6823023","filename":"sdk-python/crawlcheck/continuity_gate.py","status":"modified","additions":27,"deletions":4,"changes":31,"blob_url":"https://github.com/emmanuelorta/crawlcheck-core/blob/c634f497bd5873c2b2bd9f3ca9a26b188e08ac2a/sdk-python%2Fcrawlcheck%2Fcontinuity_gate.py","raw_url":"https://github.com/emmanuelorta/crawlcheck-core/raw/c634f497bd5873c2b2bd9f3ca9a26b188e08ac2a/sdk-python%2Fcrawlcheck%2Fcontinuity_gate.py","contents_url":"https://api.github.com/repos/emmanuelorta/crawlcheck-core/contents/sdk-python%2Fcrawlcheck%2Fcontinuity_gate.py?ref=c634f497bd5873c2b2bd9f3ca9a26b188e08ac2a","patch":"@@ -13,14 +13,20 @@\n \n confirm(request) may be sync or async. request is {\"continuity\": record} for the server, or {\"tool\": name,\n \"continuity\": record} for one tool. A yes is remembered for that exact tool definition (or tool list), so a framework\n-that lists tools on every turn does not ask twice. No network, no key: the comparison is local.\"\"\"\n+that lists tools on every turn does not ask twice. No network, no key: the comparison is local.\n+\n+1.14.0 signed baseline: the constructor checks the lockfile's signature (verify_lock_baseline) before trusting it:\n+operator_keys, key_policy, published_kids, trusted_kids, require_signed_baseline (default: on when operator_keys are\n+given). A bad or forged signature, or an unsigned lockfile when one is required, is recorded as baseline_untrusted; in\n+review and enforce the constructor raises ContinuityRefused (a startup failure), in observe it records and goes on.\n+gate.baseline is the result; every record names it in baseline.trust.\"\"\"\n import asyncio\n import inspect\n import json\n import logging\n import threading\n \n-from .continuity import continuity_check, continuity_failure, _tool_hash\n+from .continuity import continuity_check, continuity_failure, _tool_hash, verify_lock_baseline, baseline_refusal\n \n log = logging.getLogger(\"crawlcheck.continuity\")\n \n@@ -82,7 +88,8 @@ async def _maybe(v):\n \n class ContinuityGate:\n     def __init__(self, lock, mode=\"observe\", policy=None, exceptions=None, server=None, server_identity=None,\n-                 expect_policy_sha256=None, confirm=None, on_record=None, log_path=None, keep=50):\n+                 expect_policy_sha256=None, confirm=None, on_record=None, log_path=None, keep=50, operator_keys=None,\n+                 key_policy=None, published_kids=None, trusted_kids=None, require_signed_baseline=None):\n         if mode not in (\"observe\", \"review\", \"enforce\"):\n             raise ValueError(\"mode must be observe, review or enforce\")\n         if not isinstance(lock, dict) or not isinstance(lock.get(\"tools\"), list):\n@@ -92,6 +99,22 @@ def __init__(self, lock, mode=\"observe\", policy=None, exceptions=None, server=No\n         self.confirm, self.on_record, self.log_path, self.keep = confirm, on_record, log_path, keep\n         self.records, self.record, self.paused = [], None, set()\n         self._ok_tools, self._ok_lists, self._last = set(), set(), None\n+        # startup: the baseline is checked once, before anything is compared against it\n+        try:\n+            b = verify_lock_baseline(lock, operator_keys=operator_keys, key_policy=key_policy, published_kids=published_kids, trusted_kids=trusted_kids)\n+        except Exception as e:  # noqa: BLE001\n+            b = {\"trust\": \"invalid\", \"signer\": None, \"kid\": None, \"why\": \"the baseline could not be checked: %s\" % e, \"parts_used\": False, \"lock\": lock}\n+        self._base = b.get(\"lock\") or lock\n+        self.baseline = {k: b[k] for k in (\"trust\", \"signer\", \"kid\", \"why\", \"parts_used\")}\n+        req = require_signed_baseline if require_signed_baseline is not None else bool(operator_keys)\n+        bad = baseline_refusal(b, req)\n+        self.refused = None\n+        if bad:\n+            rec = continuity_failure(\"baseline_untrusted\", mode=self.mode, policy=self.policy, exceptions=self.exceptions, server=self.server, detail=str(bad)[:300])\n+            _run_sync(self._keep(rec))\n+            if self.mode != \"observe\" and rec[\"outcome\"] != \"proceed\":\n+                self.refused = ContinuityRefused(\"; \".join(rec[\"why\"]) + \": \" + bad, rec)\n+                raise self.refused\n \n     # -- records ---------------------------------------------------------------------------------------------------\n     async def _keep(self, rec):\n@@ -126,7 +149,7 @@ async def _ask(self, req):\n     async def acheck(self, tools, complete=True):\n         \"\"\"Compare the offered tools with the lock and apply the mode. Returns the record; raises ContinuityRefused.\"\"\"\n         rows = [tool_dict(t) for t in (tools or [])] if isinstance(tools, list) else tools\n-        rec = continuity_check(self.lock, rows, mode=self.mode, policy=self.policy, exceptions=self.exceptions, complete=complete,\n+        rec = continuity_check(self._base, rows, baseline_trust=self.baseline[\"trust\"], mode=self.mode, policy=self.policy, exceptions=self.exceptions, complete=complete,\n                                server=self.server, server_identity=self.server_identity, expect_policy_sha256=self.expect_policy_sha256)\n         key = ((rec.get(\"observed\") or {}).get(\"tools_sha256\"), complete is not False)\n         if self._last and self._last[0] == key and self.record:   # same list as last time: no new record, same verdict"},{"sha":"28365159933b24571c62e417dbcc51737d8155c0","filename":"sdk-python/crawlcheck/crewai.py","status":"modified","additions":2,"deletions":2,"changes":4,"blob_url":"https://github.com/emmanuelorta/crawlcheck-core/blob/c634f497bd5873c2b2bd9f3ca9a26b188e08ac2a/sdk-python%2Fcrawlcheck%2Fcrewai.py","raw_url":"https://github.com/emmanuelorta/crawlcheck-core/raw/c634f497bd5873c2b2bd9f3ca9a26b188e08ac2a/sdk-python%2Fcrawlcheck%2Fcrewai.py","contents_url":"https://api.github.com/repos/emmanuelorta/crawlcheck-core/contents/sdk-python%2Fcrawlcheck%2Fcrewai.py?ref=c634f497bd5873c2b2bd9f3ca9a26b188e08ac2a","patch":"@@ -131,13 +131,13 @@ def __exit__(self, *exc):\n \n \n def with_continuity(adapter, lock, mode=\"observe\", policy=None, exceptions=None, confirm=None, on_record=None, log_path=None,\n-                    server_url=None, server_identity=None, expect_policy_sha256=None, gate=None):\n+                    server_url=None, server_identity=None, expect_policy_sha256=None, gate=None, baseline=None):\n     \"\"\"Wrap a crewai_tools.MCPServerAdapter (not yet started) so its tools are checked against lock. The returned object\n     has .tools, .start(), .stop(), works as a context manager, and keeps the records at .gate.records. server_url\n     defaults to the adapter's serverparams[\"url\"] (HTTP transports).\"\"\"\n     from .continuity_gate import ContinuityGate\n     sp = getattr(adapter, \"_serverparams\", None)\n     url = server_url or (sp.get(\"url\") if isinstance(sp, dict) else None)\n     g = gate or ContinuityGate(lock, mode=mode, policy=policy, exceptions=exceptions, server=url, server_identity=server_identity,\n-                               expect_policy_sha256=expect_policy_sha256, confirm=confirm, on_record=on_record, log_path=log_path)\n+                               expect_policy_sha256=expect_policy_sha256, confirm=confirm, on_record=on_record, log_path=log_path, **(baseline or {}))\n     return _Guarded(adapter, g)"},{"sha":"dc277cd5ac3bef48cfe0664c82b3c18eca79b756","filename":"sdk-python/crawlcheck/langchain.py","status":"modified","additions":2,"deletions":2,"changes":4,"blob_url":"https://github.com/emmanuelorta/crawlcheck-core/blob/c634f497bd5873c2b2bd9f3ca9a26b188e08ac2a/sdk-python%2Fcrawlcheck%2Flangchain.py","raw_url":"https://github.com/emmanuelorta/crawlcheck-core/raw/c634f497bd5873c2b2bd9f3ca9a26b188e08ac2a/sdk-python%2Fcrawlcheck%2Flangchain.py","contents_url":"https://api.github.com/repos/emmanuelorta/crawlcheck-core/contents/sdk-python%2Fcrawlcheck%2Flangchain.py?ref=c634f497bd5873c2b2bd9f3ca9a26b188e08ac2a","patch":"@@ -57,7 +57,7 @@ async def _all_tools(session):\n \n async def load_mcp_tools_with_continuity(source, lock, server_name=None, mode=\"observe\", policy=None, exceptions=None, confirm=None,\n                                          on_record=None, log_path=None, server_url=None, server_identity=None, expect_policy_sha256=None,\n-                                         gate=None, **load_kwargs):\n+                                         gate=None, baseline=None, **load_kwargs):\n     \"\"\"load_mcp_tools with the continuity check. source: a MultiServerMCPClient (server_name required when it has more\n     than one server) or an initialised mcp ClientSession. load_kwargs go to convert_mcp_tool_to_langchain_tool\n     (callbacks, tool_interceptors, tool_name_prefix, handle_tool_errors). Pass gate= (a ContinuityGate) to keep the\n@@ -81,7 +81,7 @@ async def load_mcp_tools_with_continuity(source, lock, server_name=None, mode=\"o\n                 load_kwargs[k] = getattr(source, k)\n     url = server_url or (connection.get(\"url\") if isinstance(connection, dict) else None)\n     g = gate or ContinuityGate(lock, mode=mode, policy=policy, exceptions=exceptions, server=url, server_identity=server_identity,\n-                               expect_policy_sha256=expect_policy_sha256, confirm=confirm, on_record=on_record, log_path=log_path)\n+                               expect_policy_sha256=expect_policy_sha256, confirm=confirm, on_record=on_record, log_path=log_path, **(baseline or {}))\n     try:\n         if connection is not None:\n             async with source.session(server_name) as s:"},{"sha":"2093a18f855b884a44199905c06327e7a83645bf","filename":"sdk-python/crawlcheck/mcp.py","status":"modified","additions":32,"deletions":4,"changes":36,"blob_url":"https://github.com/emmanuelorta/crawlcheck-core/blob/c634f497bd5873c2b2bd9f3ca9a26b188e08ac2a/sdk-python%2Fcrawlcheck%2Fmcp.py","raw_url":"https://github.com/emmanuelorta/crawlcheck-core/raw/c634f497bd5873c2b2bd9f3ca9a26b188e08ac2a/sdk-python%2Fcrawlcheck%2Fmcp.py","contents_url":"https://api.github.com/repos/emmanuelorta/crawlcheck-core/contents/sdk-python%2Fcrawlcheck%2Fmcp.py?ref=c634f497bd5873c2b2bd9f3ca9a26b188e08ac2a","patch":"@@ -30,7 +30,7 @@\n \n from .client import normalize_domain\n from .lock import check_lock\n-from .continuity import continuity_check, continuity_failure, continuity_class_of\n+from .continuity import continuity_check, continuity_failure, continuity_class_of, verify_lock_baseline, baseline_refusal\n \n \n class McpPreflightRefused(Exception):\n@@ -67,7 +67,8 @@ class McpPreflight:\n     \"\"\"The hooks, for any client stack: before_connect(url), after_connect(tools), before_tool_call(name, annotations).\"\"\"\n \n     def __init__(self, cc, template=\"safe_mcp_tool\", policy=None, agent=None, confirm=None, allow_warn=False, lock=None,\n-                 confirm_destructive=False, max_age_s=None, local=\"allow\", tool_receipts=\"write\", scopes=None, continuity=None):\n+                 confirm_destructive=False, max_age_s=None, local=\"allow\", tool_receipts=\"write\", scopes=None, continuity=None,\n+                 operator_keys=None, key_policy=None, published_kids=None, trusted_kids=None, require_signed_baseline=None):\n         self.cc, self.template, self.policy, self.agent = cc, template, policy, agent\n         self.confirm, self.allow_warn, self.lock, self.confirm_destructive = confirm, allow_warn, lock, confirm_destructive\n         self.max_age_s, self.local = max_age_s, local\n@@ -79,6 +80,32 @@ def __init__(self, cc, template=\"safe_mcp_tool\", policy=None, agent=None, confir\n         self.co = continuity\n         self._acc = None\n         self.records, self.continuity, self.paused_tools = [], None, None\n+        # 1.14.0 signed baseline: the lockfile's signature is checked once, here, before anything is compared against it.\n+        # Options in continuity={...} or as keyword arguments: operator_keys, key_policy, published_kids, trusted_kids,\n+        # require_signed_baseline. A bad or forged signature (or an unsigned lockfile when one is required) raises\n+        # McpPreflightRefused now, outside observe; observe records baseline_untrusted and goes on.\n+        self.baseline, self._base = None, lock\n+        if lock is not None:\n+            c = self.co or {}\n+            pick = lambda k, v: c.get(k) if c.get(k) is not None else v   # noqa: E731\n+            okeys = pick(\"operator_keys\", operator_keys)\n+            try:\n+                b = verify_lock_baseline(lock, operator_keys=okeys, key_policy=pick(\"key_policy\", key_policy),\n+                                         published_kids=pick(\"published_kids\", published_kids), trusted_kids=pick(\"trusted_kids\", trusted_kids))\n+            except Exception as e:  # noqa: BLE001\n+                b = {\"trust\": \"invalid\", \"signer\": None, \"kid\": None, \"why\": \"the baseline could not be checked: %s\" % e, \"parts_used\": False, \"lock\": lock}\n+            self._base = b.get(\"lock\") or lock\n+            self.baseline = {k: b[k] for k in (\"trust\", \"signer\", \"kid\", \"why\", \"parts_used\")}\n+            req = pick(\"require_signed_baseline\", require_signed_baseline)\n+            bad = baseline_refusal(b, req if req is not None else bool(okeys))\n+            if bad and self.co:\n+                from .continuity_gate import _run_sync\n+                o = self._co()\n+                rec = _run_sync(self._keep(continuity_failure(\"baseline_untrusted\", mode=o[\"mode\"], policy=o[\"policy\"], exceptions=o[\"exceptions\"], server=None, detail=str(bad)[:300])))\n+                if rec[\"outcome\"] != \"proceed\":\n+                    raise McpPreflightRefused(\"connect\", \"; \".join(rec[\"why\"]) + \": \" + bad, None, rec)\n+            elif bad:\n+                raise McpPreflightRefused(\"connect\", \"the approved lockfile is not trusted: \" + bad)\n \n     async def _keep(self, rec):\n         self.continuity = rec\n@@ -185,7 +212,8 @@ async def before_connect(self, url):\n     async def after_connect(self, tools, next_cursor=None):\n         if self.co and self.lock:   # 1.12.0: classify, apply the operator's policy, keep the record\n             o = self._co()\n-            rec = await self._keep(continuity_check(self.lock, tools, mode=o[\"mode\"], policy=o[\"policy\"], exceptions=o[\"exceptions\"], server=o[\"server\"], complete=not next_cursor))\n+            rec = await self._keep(continuity_check(self._base, tools, mode=o[\"mode\"], policy=o[\"policy\"], exceptions=o[\"exceptions\"], server=o[\"server\"], complete=not next_cursor,\n+                                                     baseline_trust=(self.baseline or {}).get(\"trust\")))\n             self.lock_check, self.approved, self.paused_tools = rec, None, set(rec[\"paused_tools\"])\n             if rec[\"outcome\"] == \"deny\":\n                 raise McpPreflightRefused(\"connect\", \"; \".join(rec[\"why\"]), self.receipt, rec)\n@@ -198,7 +226,7 @@ async def after_connect(self, tools, next_cursor=None):\n         if not self.lock:\n             self.approved = None\n             return None\n-        lc = check_lock(self.lock, tools or [])\n+        lc = check_lock(self._base, tools or [])\n         self.lock_check = lc\n         self.approved = set(t.get(\"name\") for t in self.lock.get(\"tools\", []))\n         if lc[\"decision\"] != \"connect\":"},{"sha":"2faf518c8cd87f4dd8d7a8de73beefb8e2fc9f1e","filename":"sdk-python/crawlcheck/openai_agents.py","status":"modified","additions":2,"deletions":2,"changes":4,"blob_url":"https://github.com/emmanuelorta/crawlcheck-core/blob/c634f497bd5873c2b2bd9f3ca9a26b188e08ac2a/sdk-python%2Fcrawlcheck%2Fopenai_agents.py","raw_url":"https://github.com/emmanuelorta/crawlcheck-core/raw/c634f497bd5873c2b2bd9f3ca9a26b188e08ac2a/sdk-python%2Fcrawlcheck%2Fopenai_agents.py","contents_url":"https://api.github.com/repos/emmanuelorta/crawlcheck-core/contents/sdk-python%2Fcrawlcheck%2Fopenai_agents.py?ref=c634f497bd5873c2b2bd9f3ca9a26b188e08ac2a","patch":"@@ -147,12 +147,12 @@ def _server_url(server):\n \n \n def with_continuity(server, lock, mode=\"observe\", policy=None, exceptions=None, confirm=None, on_record=None, log_path=None,\n-                    server_url=None, server_identity=None, expect_policy_sha256=None, gate=None):\n+                    server_url=None, server_identity=None, expect_policy_sha256=None, gate=None, baseline=None):\n     \"\"\"Wrap an agents.mcp server (MCPServerStdio, MCPServerSse, MCPServerStreamableHttp or your own) so every tool-list\n     fetch runs continuity_check against lock. server_url defaults to the server's params[\"url\"] (HTTP transports); the\n     lock's server.url must match it or the check reports server_identity_mismatch (deny outside observe).\"\"\"\n     from .continuity_gate import ContinuityGate\n     g = gate or ContinuityGate(lock, mode=mode, policy=policy, exceptions=exceptions, server=server_url or _server_url(server),\n                                server_identity=server_identity, expect_policy_sha256=expect_policy_sha256, confirm=confirm,\n-                               on_record=on_record, log_path=log_path)\n+                               on_record=on_record, log_path=log_path, **(baseline or {}))\n     return _server_class()(server, g)"},{"sha":"ada4bead65b0290c4d8c8a19d8ae2e5744e858d3","filename":"sdk-python/pyproject.toml","status":"modified","additions":1,"deletions":1,"changes":2,"blob_url":"https://github.com/emmanuelorta/crawlcheck-core/blob/c634f497bd5873c2b2bd9f3ca9a26b188e08ac2a/sdk-python%2Fpyproject.toml","raw_url":"https://github.com/emmanuelorta/crawlcheck-core/raw/c634f497bd5873c2b2bd9f3ca9a26b188e08ac2a/sdk-python%2Fpyproject.toml","contents_url":"https://api.github.com/repos/emmanuelorta/crawlcheck-core/contents/sdk-python%2Fpyproject.toml?ref=c634f497bd5873c2b2bd9f3ca9a26b188e08ac2a","patch":"@@ -4,7 +4,7 @@ build-backend = \"setuptools.build_meta\"\n \n [project]\n name = \"crawlcheck\"\n-version = \"1.13.0\"\n+version = \"1.14.0\"\n description = \"CrawlCheck client: resolve a domain, get a signed decision for an agent action, verify CrawlCheck evidence offline. No dependencies.\"\n readme = \"README.md\"\n requires-python = \">=3.8\""},{"sha":"1da5570142d594601e0f2fffaf8044dbbd0f13b9","filename":"sdk-python/tests/fixtures/continuity.json","status":"modified","additions":5451,"deletions":131,"changes":5582,"blob_url":"https://github.com/emmanuelorta/crawlcheck-core/blob/c634f497bd5873c2b2bd9f3ca9a26b188e08ac2a/sdk-python%2Ftests%2Ffixtures%2Fcontinuity.json","raw_url":"https://github.com/emmanuelorta/crawlcheck-core/raw/c634f497bd5873c2b2bd9f3ca9a26b188e08ac2a/sdk-python%2Ftests%2Ffixtures%2Fcontinuity.json","contents_url":"https://api.github.com/repos/emmanuelorta/crawlcheck-core/contents/sdk-python%2Ftests%2Ffixtures%2Fcontinuity.json?ref=c634f497bd5873c2b2bd9f3ca9a26b188e08ac2a"},{"sha":"f6c25e1935b689cb2aa301fbcc6bb992dcf1711c","filename":"sdk-python/tests/test_baseline.py","status":"added","additions":142,"deletions":0,"changes":142,"blob_url":"https://github.com/emmanuelorta/crawlcheck-core/blob/c634f497bd5873c2b2bd9f3ca9a26b188e08ac2a/sdk-python%2Ftests%2Ftest_baseline.py","raw_url":"https://github.com/emmanuelorta/crawlcheck-core/raw/c634f497bd5873c2b2bd9f3ca9a26b188e08ac2a/sdk-python%2Ftests%2Ftest_baseline.py","contents_url":"https://api.github.com/repos/emmanuelorta/crawlcheck-core/contents/sdk-python%2Ftests%2Ftest_baseline.py?ref=c634f497bd5873c2b2bd9f3ca9a26b188e08ac2a","patch":"@@ -0,0 +1,142 @@\n+\"\"\"Signed baseline (1.14.0): the lockfile's signature is checked once, when a gate is created, before anything is compared\n+against it. The cases are the shared golden file's baseline_cases, generated by the JS SDK; this SDK reproduces each one.\"\"\"\n+import copy\n+import hashlib\n+import json\n+import os\n+import unittest\n+from unittest import mock\n+\n+from crawlcheck import _ed25519\n+from crawlcheck.continuity import (CONTINUITY_DEFAULT_POLICY, CONTINUITY_FAILURE_CLASSES, new_operator_key, sign_lock,\n+                                   verify_lock_baseline)\n+from crawlcheck.continuity_gate import ContinuityGate, ContinuityRefused\n+from crawlcheck.mcp import McpPreflightRefused, with_preflight\n+from crawlcheck.verify import canon, key_policy_from\n+from tests.test_mcp import Session, cc, run\n+\n+G = json.load(open(os.path.join(os.path.dirname(__file__), \"fixtures\", \"continuity.json\"), encoding=\"utf-8\"))\n+URL = \"https://mcp.example.com/mcp\"\n+OP = G[\"operator\"]\n+\n+\n+def B(n):\n+    return next(c for c in G[\"baseline_cases\"] if c[\"name\"] == n)\n+\n+\n+def _kw(o):\n+    m = {\"operatorKeys\": \"operator_keys\", \"publishedKids\": \"published_kids\", \"trustedKids\": \"trusted_kids\"}\n+    k = {m[a]: v for a, v in o.items() if a in m}\n+    if o.get(\"keyPolicyDirectory\"):\n+        k[\"key_policy\"] = key_policy_from(G[\"key_directory\"])\n+    return k\n+\n+\n+class Golden(unittest.TestCase):\n+    def test_baseline_cases(self):\n+        for c in G[\"baseline_cases\"]:\n+            with self.subTest(c[\"name\"]):\n+                r = verify_lock_baseline(c[\"lock\"], **_kw(c[\"opts\"]))\n+                used = r.pop(\"lock\")\n+                self.assertEqual(r, c[\"expect\"])\n+                self.assertEqual(hashlib.sha256(canon(used).encode(\"utf-8\")).hexdigest(), c[\"used_sha256\"])\n+\n+    def test_sign_lock_matches_js_byte_for_byte(self):\n+        self.assertEqual(sign_lock(G[\"lock\"], OP[\"privateKey\"]), OP[\"signed_lock\"])\n+        self.assertEqual(sign_lock(G[\"lock\"], bytes.fromhex(OP[\"seed_hex\"])), OP[\"signed_lock\"])\n+\n+    def test_signing_matches_rfc8032_test_vector_1(self):\n+        seed = bytes.fromhex(\"9d61b19deffd5a60ba844af492ec2cc44449c5697b326919703bac031cae7f60\")\n+        self.assertEqual(_ed25519.public_key(seed).hex(), \"d75a980182b10ab7d54bfed3c964073a0ee172f3daa62325af021a68f707511a\")\n+        self.assertEqual(_ed25519.sign(seed, b\"\").hex(), \"e5564300c360ac729086e2cc806e828a84877f1eb8e5d974d873e065224901555fb8821590a33bacc61e39701cf9b46bd25bf5f0595bbe24655141438e7a100b\")\n+\n+    def test_new_class(self):\n+        self.assertEqual(len(CONTINUITY_FAILURE_CLASSES), 14)\n+        self.assertEqual(CONTINUITY_DEFAULT_POLICY[\"effects\"][\"baseline_untrusted\"], \"deny\")\n+\n+\n+class Gate(unittest.TestCase):\n+    def test_enforce_edited_after_signing_fails_at_construction(self):\n+        with self.assertRaises(ContinuityRefused) as e:\n+            ContinuityGate(B(\"edited_after_signing\")[\"lock\"], mode=\"enforce\")\n+        self.assertEqual(e.exception.record[\"events\"][0][\"class\"], \"baseline_untrusted\")\n+        with self.assertRaises(ContinuityRefused):\n+            ContinuityGate(B(\"forged_foreign_key\")[\"lock\"], mode=\"review\")\n+\n+    def test_observe_records_and_passes(self):\n+        recs = []\n+        g = ContinuityGate(B(\"edited_after_signing\")[\"lock\"], mode=\"observe\", on_record=recs.append)\n+        self.assertEqual(g.baseline[\"trust\"], \"invalid\")\n+        self.assertEqual([r[\"events\"][0][\"class\"] for r in recs], [\"baseline_untrusted\"])\n+        self.assertEqual(recs[0][\"outcome\"], \"proceed\")\n+        self.assertEqual(g.check([])[\"baseline\"][\"trust\"], \"invalid\")\n+\n+    def test_verified_and_named_in_records(self):\n+        g = ContinuityGate(B(\"crawlcheck_signed\")[\"lock\"], mode=\"enforce\")\n+        self.assertEqual(g.baseline[\"trust\"], \"verified\")\n+        self.assertEqual(g.records, [])\n+        r = g.check([])\n+        self.assertEqual((r[\"baseline\"][\"trust\"], r[\"baseline\"][\"per_part\"]), (\"verified\", True))\n+\n+    def test_parts_added_after_signing_are_not_used(self):\n+        g = ContinuityGate(B(\"parts_added_after_signing\")[\"lock\"], mode=\"enforce\")\n+        self.assertEqual((g.baseline[\"trust\"], g.baseline[\"parts_used\"]), (\"verified\", False))\n+        self.assertFalse(g.check([])[\"baseline\"][\"per_part\"])\n+\n+    def test_unsigned_and_require_signed(self):\n+        self.assertEqual(ContinuityGate(G[\"lock\"], mode=\"enforce\").baseline[\"trust\"], \"unsigned\")\n+        with self.assertRaisesRegex(ContinuityRefused, \"unsigned and a signed one is required\"):\n+            ContinuityGate(G[\"lock\"], mode=\"enforce\", require_signed_baseline=True)\n+        with self.assertRaisesRegex(ContinuityRefused, \"unsigned\"):\n+            ContinuityGate(G[\"lock\"], mode=\"enforce\", operator_keys=[OP[\"publicKey\"]])\n+        ContinuityGate(G[\"lock\"], mode=\"enforce\", operator_keys=[OP[\"publicKey\"]], require_signed_baseline=False)\n+\n+    def test_operator_signed(self):\n+        g = ContinuityGate(OP[\"signed_lock\"], mode=\"enforce\", operator_keys=[OP[\"publicKey\"]])\n+        self.assertEqual(g.baseline[\"trust\"], \"operator_signed\")\n+        r = g.check(G[\"tools_v1\"])\n+        self.assertEqual((r[\"outcome\"], r[\"baseline\"][\"trust\"]), (\"proceed\", \"operator_signed\"))\n+        with self.assertRaisesRegex(ContinuityRefused, \"not one of the operator keys\"):\n+            ContinuityGate(OP[\"signed_lock\"], mode=\"enforce\", operator_keys=[OP[\"other_publicKey\"]])\n+\n+    def test_attacker_edit_of_operator_baseline(self):\n+        L = copy.deepcopy(OP[\"signed_lock\"]); L[\"tools\"].append({\"name\": \"export\", \"sha256\": \"e\" * 64})\n+        with self.assertRaisesRegex(ContinuityRefused, \"changed after the operator signed it\"):\n+            ContinuityGate(L, mode=\"enforce\", operator_keys=[OP[\"publicKey\"]])\n+        del L[\"operator_signature\"]\n+        with self.assertRaisesRegex(ContinuityRefused, \"unsigned\"):\n+            ContinuityGate(L, mode=\"enforce\", operator_keys=[OP[\"publicKey\"]])\n+\n+    def test_verified_once_not_per_call(self):\n+        g = ContinuityGate(B(\"crawlcheck_signed\")[\"lock\"], mode=\"enforce\")\n+        with mock.patch.object(_ed25519, \"verify\", side_effect=AssertionError(\"verified again\")):\n+            for _ in range(3):\n+                g.check([])\n+\n+    def test_new_key_round_trip(self):\n+        k = new_operator_key()\n+        s = sign_lock(G[\"lock\"], k[\"private_key\"])\n+        self.assertEqual(verify_lock_baseline(s, operator_keys=[k[\"public_key\"]])[\"trust\"], \"operator_signed\")\n+        self.assertEqual(s[\"operator_signature\"][\"kid\"], k[\"kid\"])\n+\n+\n+class Mcp(unittest.TestCase):\n+    def test_untrusted_baseline_refused_at_construction(self):\n+        s = Session(G[\"tools_v1\"])\n+        with self.assertRaisesRegex(McpPreflightRefused, \"baseline\"):\n+            with_preflight(s, cc({\"mcp.example.com\": \"allow\"}), server_url=URL, lock=B(\"edited_after_signing\")[\"lock\"], tool_receipts=\"none\", continuity={\"mode\": \"enforce\"})\n+        with self.assertRaisesRegex(McpPreflightRefused, \"lockfile is not trusted\"):\n+            with_preflight(s, cc({\"mcp.example.com\": \"allow\"}), server_url=URL, lock=B(\"forged_foreign_key\")[\"lock\"], tool_receipts=\"none\")\n+        self.assertEqual(s.sent, [])\n+\n+    def test_operator_signed_connects(self):\n+        s = Session(G[\"tools_v1\"])\n+        w = with_preflight(s, cc({\"mcp.example.com\": \"allow\"}), server_url=URL, lock=OP[\"signed_lock\"], tool_receipts=\"none\",\n+                           continuity={\"mode\": \"enforce\", \"operator_keys\": [OP[\"publicKey\"]]})\n+        run(w.initialize())\n+        self.assertEqual(w.preflight.baseline[\"trust\"], \"operator_signed\")\n+        self.assertEqual(w.preflight.continuity[\"baseline\"][\"trust\"], \"operator_signed\")\n+\n+\n+if __name__ == \"__main__\":\n+    unittest.main()"},{"sha":"1bcc8faae7e666177f5aab20d4c0f06e81e45d1f","filename":"sdk-python/tests/test_continuity.py","status":"modified","additions":1,"deletions":1,"changes":2,"blob_url":"https://github.com/emmanuelorta/crawlcheck-core/blob/c634f497bd5873c2b2bd9f3ca9a26b188e08ac2a/sdk-python%2Ftests%2Ftest_continuity.py","raw_url":"https://github.com/emmanuelorta/crawlcheck-core/raw/c634f497bd5873c2b2bd9f3ca9a26b188e08ac2a/sdk-python%2Ftests%2Ftest_continuity.py","contents_url":"https://api.github.com/repos/emmanuelorta/crawlcheck-core/contents/sdk-python%2Ftests%2Ftest_continuity.py?ref=c634f497bd5873c2b2bd9f3ca9a26b188e08ac2a","patch":"@@ -13,7 +13,7 @@\n \n def _kw(o):\n     m = {\"mode\": \"mode\", \"policy\": \"policy\", \"exceptions\": \"exceptions\", \"complete\": \"complete\", \"server\": \"server\",\n-         \"serverIdentity\": \"server_identity\", \"expectPolicySha256\": \"expect_policy_sha256\", \"now\": \"now\"}\n+         \"serverIdentity\": \"server_identity\", \"expectPolicySha256\": \"expect_policy_sha256\", \"now\": \"now\", \"baselineTrust\": \"baseline_trust\"}\n     return {m[k]: v for k, v in o.items() if k in m}\n \n "},{"sha":"787bd66abb2b69c46b220efd0b01a73e26379f17","filename":"sdk/README.md","status":"modified","additions":26,"deletions":0,"changes":26,"blob_url":"https://github.com/emmanuelorta/crawlcheck-core/blob/c634f497bd5873c2b2bd9f3ca9a26b188e08ac2a/sdk%2FREADME.md","raw_url":"https://github.com/emmanuelorta/crawlcheck-core/raw/c634f497bd5873c2b2bd9f3ca9a26b188e08ac2a/sdk%2FREADME.md","contents_url":"https://api.github.com/repos/emmanuelorta/crawlcheck-core/contents/sdk%2FREADME.md?ref=c634f497bd5873c2b2bd9f3ca9a26b188e08ac2a","patch":"@@ -179,6 +179,32 @@ const tools = await loadMcpToolsWithContinuity(\"shop\", client, lock, { mode: \"ob\n \n `observe` records every difference (`console.warn`, `onRecord`, `server.continuity.records` / `tools.continuity.records`) and passes the tools through. `review` pauses the whole server on any change until `confirm` says yes. `enforce` applies the policy: a changed or new tool is withheld from the agent, and a call to it is refused, until `confirm({ tool, continuity })` re-approves it; the rest stay usable. A refusal throws `ContinuityRefused` (with `.record`). A yes is remembered for that exact definition, so a framework that lists tools every turn does not ask twice. For CrewAI, use the Python package (`crawlcheck.crewai.with_continuity`).\n \n+### Check the baseline before trusting it (1.13.0)\n+\n+Whoever can edit your approved lockfile can approve their own tools. So every gate (`withPreflight` with `lock`, `continuityGate`, `withContinuity`, `loadMcpToolsWithContinuity`) checks the lockfile's signature once, when it is created, before it compares anything against it:\n+\n+| `baseline.trust` | meaning |\n+|---|---|\n+| `verified` | signed by CrawlCheck (`cc.mcpLock(url)` / `GET /api/v1/mcp/lock`) with a CrawlCheck key. The package ships the published key ids (`CRAWLCHECK_LOCK_KIDS`); pass `keyPolicy: await cc.publishedKeyPolicy()` to follow a key rotation. These lockfiles carry `parts` inside the signature; `parts` added afterwards are not used. |\n+| `operator_signed` | you signed it with `signLock` and passed your public key in `operatorKeys`. Use this when you edit a lockfile yourself, for example to drop a tool. |\n+| `unsigned` | no signature. Accepted unless `requireSignedBaseline` (on by default once you pass `operatorKeys`). |\n+| `invalid` | the signature does not verify, the file was changed after signing, or the key is neither CrawlCheck's nor one of yours. |\n+\n+`invalid`, or `unsigned` when a signed one is required, is the failure class `baseline_untrusted`: `enforce` and `review` refuse (`ContinuityRefused` / `McpPreflightRefused`), `observe` records it and goes on. `openContinuityGate(lock, opts)` throws at startup; `continuityGate` exposes `gate.ready` and `gate.baseline`. Every record names the result in `baseline.trust`. Nothing is verified per call.\n+\n+Sign your own lockfile, with no command line:\n+\n+```js\n+import { newOperatorKey, signLock, openContinuityGate } from \"@crawlcheck/sdk\";\n+\n+const key = await newOperatorKey();                 // once; store key.privateKey where the agent cannot read it\n+const signed = await signLock(lock, key.privateKey); // after you review (or edit) the lockfile; save signed\n+// at startup, with only the public key:\n+const gate = await openContinuityGate(signed, { mode: \"enforce\", operatorKeys: [key.publicKey] });\n+```\n+\n+`verifyLockBaseline(lock, opts)` runs the same check on its own. The signature is Ed25519 over `\"crawlcheck-lock-operator-v1\\n\" + sha256(canonical JSON of the lockfile without operator_signature)`; the Python package signs and verifies byte for byte the same.\n+\n ## Do not trust the API: check the evidence yourself\n \n ```js"},{"sha":"cb003ce772f9cb664081d1edd24db809c98bf751","filename":"sdk/dist/continuity.d.ts","status":"modified","additions":44,"deletions":0,"changes":44,"blob_url":"https://github.com/emmanuelorta/crawlcheck-core/blob/c634f497bd5873c2b2bd9f3ca9a26b188e08ac2a/sdk%2Fdist%2Fcontinuity.d.ts","raw_url":"https://github.com/emmanuelorta/crawlcheck-core/raw/c634f497bd5873c2b2bd9f3ca9a26b188e08ac2a/sdk%2Fdist%2Fcontinuity.d.ts","contents_url":"https://api.github.com/repos/emmanuelorta/crawlcheck-core/contents/sdk%2Fdist%2Fcontinuity.d.ts?ref=c634f497bd5873c2b2bd9f3ca9a26b188e08ac2a","patch":"@@ -27,6 +27,7 @@ export declare const CONTINUITY_DEFAULT_POLICY: Readonly<{\n         check_timeout: \"pause\";\n         service_unavailable: \"pause\";\n         decision_refused: \"deny\";\n+        baseline_untrusted: \"deny\";\n     }>;\n }>;\n /** Per-part hashes of one tool, so a change can be named (description, schema, annotations). */\n@@ -63,6 +64,7 @@ export declare function continuityPolicy(p: any): Promise<{\n         check_timeout: \"pause\";\n         service_unavailable: \"pause\";\n         decision_refused: \"deny\";\n+        baseline_untrusted: \"deny\";\n     }>;\n     allow_integrity_override: boolean;\n } & {\n@@ -103,3 +105,45 @@ export declare function acceptanceOf(receipt: any, verification: any, scope: any\n };\n /** Which failure class a refused guard() result is (for continuityFailure). */\n export declare function continuityClassOf(g: any): \"check_timeout\" | \"decision_refused\" | \"evidence_expired\" | \"key_retired\" | \"key_unknown\" | \"response_malformed\" | \"server_identity_mismatch\" | \"service_unavailable\" | \"signature_invalid\";\n+/** CrawlCheck's lockfile signing keys (RFC 7638 thumbprints), as published at /.well-known/http-message-signatures-directory on 2026-11-07. */\n+export declare const CRAWLCHECK_LOCK_KIDS: readonly string[];\n+/** The operator's signature over the canonical lockfile (every field but operator_signature). privateKey: an Ed25519 private JWK ({kty, crv, x, d}). */\n+export declare function signLock(lock: any, privateKey: any): Promise<{\n+    operator_signature: {\n+        v: number;\n+        alg: string;\n+        kid: string;\n+        message: string;\n+        sig: string;\n+    };\n+}>;\n+/** A new operator signing key: { privateKey (JWK, keep it out of the agent's reach), publicKey ({kty, crv, x}: pass it as operatorKeys) }. */\n+export declare function newOperatorKey(): Promise<{\n+    privateKey: {\n+        kty: string;\n+        crv: string;\n+        x: string | undefined;\n+        d: string | undefined;\n+    };\n+    publicKey: {\n+        kty: string;\n+        crv: string;\n+        x: string | undefined;\n+    };\n+    kid: string;\n+}>;\n+/**\n+ * Is this baseline the one CrawlCheck or the operator signed? opts: operatorKeys (public JWKs or their x), keyPolicy,\n+ * publishedKids, trustedKids. Returns { trust: verified | operator_signed | unsigned | invalid, signer, kid, why, parts_used,\n+ * lock } where lock is the baseline to compare against (without unsigned parts). Offline; no network.\n+ */\n+export declare function verifyLockBaseline(lock: any, opts?: {}): Promise<{\n+    trust: any;\n+    signer: any;\n+    kid: any;\n+    why: any;\n+    parts_used: boolean;\n+    lock: any;\n+}>;\n+/** Why a baseline is refused (null when it is accepted). */\n+export declare function baselineRefusal(b: any, requireSigned: any): any;"},{"sha":"2868f223ee6e9a4c1884f5f7c666ab079ac81d0a","filename":"sdk/dist/continuity.js","status":"modified","additions":136,"deletions":6,"changes":142,"blob_url":"https://github.com/emmanuelorta/crawlcheck-core/blob/c634f497bd5873c2b2bd9f3ca9a26b188e08ac2a/sdk%2Fdist%2Fcontinuity.js","raw_url":"https://github.com/emmanuelorta/crawlcheck-core/raw/c634f497bd5873c2b2bd9f3ca9a26b188e08ac2a/sdk%2Fdist%2Fcontinuity.js","contents_url":"https://api.github.com/repos/emmanuelorta/crawlcheck-core/contents/sdk%2Fdist%2Fcontinuity.js?ref=c634f497bd5873c2b2bd9f3ca9a26b188e08ac2a","patch":"@@ -15,23 +15,28 @@\n //   enforce   the policy's effects apply as written\n // Effects, weakest to strongest: proceed, proceed_recorded (an approved exception), refresh, pause_tool, pause, deny.\n // A failed exact comparison is never overridden by an interpretive assessment: nothing here reads descriptions for intent.\n-import { canon } from \"./verify.js\";\n+import { canon, keyPolicyCheck } from \"./verify.js\";\n const subtle = globalThis.crypto && globalThis.crypto.subtle;\n const enc = new TextEncoder();\n const hex = (u8) => Array.from(u8, (b) => b.toString(16).padStart(2, \"0\")).join(\"\");\n async function sha256Hex(s) { return hex(new Uint8Array(await subtle.digest(\"SHA-256\", enc.encode(s)))); }\n+const b64d = (s) => { const t = String(s || \"\").replace(/-/g, \"+\").replace(/_/g, \"/\"); const bin = atob(t.padEnd(Math.ceil(t.length / 4) * 4, \"=\")); const o = new Uint8Array(bin.length); for (let i = 0; i < bin.length; i++)\n+    o[i] = bin.charCodeAt(i); return o; };\n+const b64e = (u8) => { let s = \"\"; for (const b of u8)\n+    s += String.fromCharCode(b); return btoa(s).replace(/\\+/g, \"-\").replace(/\\//g, \"_\").replace(/=+$/, \"\"); };\n export const CONTINUITY_EFFECTS = [\"proceed\", \"proceed_recorded\", \"refresh\", \"pause_tool\", \"pause\", \"deny\"];\n export const CONTINUITY_CHANGE_CLASSES = [\"tool_added\", \"tool_removed\", \"description_changed\", \"schema_changed\", \"annotations_changed\", \"tool_changed\"];\n-export const CONTINUITY_FAILURE_CLASSES = [\"evidence_expired\", \"signature_invalid\", \"key_unknown\", \"key_retired\", \"server_identity_mismatch\", \"server_unavailable\", \"tool_list_truncated\", \"response_malformed\", \"baseline_stale\", \"policy_version_mismatch\", \"check_timeout\", \"service_unavailable\", \"decision_refused\"];\n-const INTEGRITY = [\"signature_invalid\", \"key_unknown\", \"key_retired\", \"server_identity_mismatch\"];\n+export const CONTINUITY_FAILURE_CLASSES = [\"evidence_expired\", \"signature_invalid\", \"key_unknown\", \"key_retired\", \"server_identity_mismatch\", \"server_unavailable\", \"tool_list_truncated\", \"response_malformed\", \"baseline_stale\", \"policy_version_mismatch\", \"check_timeout\", \"service_unavailable\", \"decision_refused\", \"baseline_untrusted\"];\n+const INTEGRITY = [\"signature_invalid\", \"key_unknown\", \"key_retired\", \"server_identity_mismatch\", \"baseline_untrusted\"];\n /** The default operator policy. Every value can be overridden; the record names the policy's sha256, so what decided is attributable. */\n export const CONTINUITY_DEFAULT_POLICY = Object.freeze({\n     v: 1, id: \"crawlcheck-continuity-default\", max_baseline_age_days: 90,\n     effects: Object.freeze({\n         unchanged: \"proceed\", tool_added: \"pause_tool\", tool_removed: \"proceed\", description_changed: \"pause_tool\", schema_changed: \"pause_tool\",\n         annotations_changed: \"pause_tool\", tool_changed: \"pause_tool\", evidence_expired: \"refresh\", signature_invalid: \"deny\", key_unknown: \"deny\",\n         key_retired: \"deny\", server_identity_mismatch: \"deny\", server_unavailable: \"pause\", tool_list_truncated: \"pause\", response_malformed: \"pause\",\n-        baseline_stale: \"pause\", policy_version_mismatch: \"pause\", check_timeout: \"pause\", service_unavailable: \"pause\", decision_refused: \"deny\"\n+        baseline_stale: \"pause\", policy_version_mismatch: \"pause\", check_timeout: \"pause\", service_unavailable: \"pause\", decision_refused: \"deny\",\n+        baseline_untrusted: \"deny\"\n     })\n });\n const WHY = {\n@@ -44,7 +49,8 @@ const WHY = {\n     tool_list_truncated: \"the tool list is incomplete (a further page was not read)\", response_malformed: \"the tool list could not be parsed\",\n     baseline_stale: \"the approved baseline is older than the policy allows\", policy_version_mismatch: \"the policy in force is not the version the deployment expects\",\n     check_timeout: \"the check did not finish in time\", service_unavailable: \"the verification service could not be reached; the local fallback applies\",\n-    decision_refused: \"CrawlCheck's signed decision for the server's host did not allow the connection\"\n+    decision_refused: \"CrawlCheck's signed decision for the server's host did not allow the connection\",\n+    baseline_untrusted: \"the approved baseline is not trusted: its signature does not verify, its key is neither CrawlCheck's nor a given operator key, or it is unsigned where a signed one is required\"\n };\n /** Per-part hashes of one tool, so a change can be named (description, schema, annotations). */\n export async function lockToolParts(t) {\n@@ -138,7 +144,7 @@ export async function continuityCheck(lock, tools, opts = {}) {\n     const was = {};\n     (lock?.tools ?? []).forEach((r) => { was[r.name] = r.sha256; });\n     const approvedAt = Date.parse(lock?.approved_at ?? \"\");\n-    rec.baseline = { tools_sha256: lock?.tools_sha256 ?? null, approved_at: lock?.approved_at ?? null, age_days: isFinite(approvedAt) ? Math.floor((now - approvedAt) / 864e5) : null, server: lock?.server?.url ?? null, per_part: !!(lock && lock.parts) };\n+    rec.baseline = { tools_sha256: lock?.tools_sha256 ?? null, approved_at: lock?.approved_at ?? null, age_days: isFinite(approvedAt) ? Math.floor((now - approvedAt) / 864e5) : null, server: lock?.server?.url ?? null, per_part: !!(lock && lock.parts), trust: opts.baselineTrust ?? null };\n     rec.observed = { tools_sha256: listHash, count: rows.length, complete: opts.complete !== false };\n     if (opts.expectPolicySha256 && opts.expectPolicySha256 !== pol.sha256)\n         ev(rec, pol, mode, \"policy_version_mismatch\", null, X, now, \"expected \" + opts.expectPolicySha256 + \", in force \" + pol.sha256);\n@@ -282,3 +288,127 @@ export function continuityClassOf(g) {\n         return \"response_malformed\";\n     return \"decision_refused\";\n }\n+// ── signed baseline (1.13.0) ───────────────────────────────────────────────────────────────────────────────────────\n+// Whoever can edit the approved lockfile can approve their own tools. So the baseline's signature is checked once, when a\n+// gate is created (startup), before anything is compared against it:\n+//   verified         signed by CrawlCheck (/api/v1/mcp/lock, kind crawlcheck-mcp-lock, scheme crawlcheck-data-v1) with a\n+//                    CrawlCheck key: the pinned ids below, opts.publishedKids, or opts.keyPolicy (keyPolicyFrom /\n+//                    publishedKeyPolicy, which follows rotation). lock.parts added after signing is not covered: dropped.\n+//   operator_signed  signed with signLock() by a key in opts.operatorKeys (the operator's Ed25519 public keys).\n+//   unsigned         no signature. Accepted unless requireSignedBaseline (default: on when operatorKeys are given).\n+//   invalid          a signature that does not verify, a changed lockfile, or a key that is neither: baseline_untrusted.\n+/** CrawlCheck's lockfile signing keys (RFC 7638 thumbprints), as published at /.well-known/http-message-signatures-directory on 2026-11-07. */\n+export const CRAWLCHECK_LOCK_KIDS = Object.freeze([\"1hHmE3fo1rg5Ig70wuFtJ5wBc7G-sUTgUJkxyPWFRps\", \"hcIAczGf-8EFBnkunmZlvFWnD2nHHeHeC9cM4BTiBVo\"]);\n+const DATA_PREFIX = \"crawlcheck-data-v1\\n\", OP_PREFIX = \"crawlcheck-lock-operator-v1\\n\";\n+async function thumbOf(x) { return b64e(new Uint8Array(await subtle.digest(\"SHA-256\", enc.encode(JSON.stringify({ crv: \"Ed25519\", kty: \"OKP\", x: String(x) }))))); }\n+async function edVerify(x, msg, sig) {\n+    try {\n+        const k = await subtle.importKey(\"jwk\", { kty: \"OKP\", crv: \"Ed25519\", x: String(x) }, { name: \"Ed25519\" }, false, [\"verify\"]);\n+        return await subtle.verify({ name: \"Ed25519\" }, k, b64d(sig), enc.encode(msg));\n+    }\n+    catch (e) {\n+        return /not supported|unrecognized|unknown algorithm|NotSupported/i.test(String(e && (e.name + \" \" + e.message))) ? null : false;\n+    }\n+}\n+const without = (o, keys) => { const b = {}; for (const k of Object.keys(o))\n+    if (keys.indexOf(k) < 0)\n+        b[k] = o[k]; return b; };\n+const xOf = (k) => (typeof k === \"string\" ? k : k && typeof k.x === \"string\" ? k.x : null);\n+/** The operator's signature over the canonical lockfile (every field but operator_signature). privateKey: an Ed25519 private JWK ({kty, crv, x, d}). */\n+export async function signLock(lock, privateKey) {\n+    if (!lock || typeof lock !== \"object\" || !Array.isArray(lock.tools))\n+        throw new Error(\"lock must be an mcp-lockfile (an object with a tools array)\");\n+    const j = privateKey || {};\n+    if (typeof j.d !== \"string\" || typeof j.x !== \"string\")\n+        throw new Error(\"privateKey must be an Ed25519 private JWK with d and x (see newOperatorKey)\");\n+    const body = without(lock, [\"operator_signature\"]), message = OP_PREFIX + (await sha256Hex(canon(body)));\n+    const k = await subtle.importKey(\"jwk\", { kty: \"OKP\", crv: \"Ed25519\", x: j.x, d: j.d }, { name: \"Ed25519\" }, false, [\"sign\"]);\n+    const sig = b64e(new Uint8Array(await subtle.sign({ name: \"Ed25519\" }, k, enc.encode(message))));\n+    return Object.assign(body, { operator_signature: { v: 1, alg: \"Ed25519\", kid: await thumbOf(j.x), message, sig } });\n+}\n+/** A new operator signing key: { privateKey (JWK, keep it out of the agent's reach), publicKey ({kty, crv, x}: pass it as operatorKeys) }. */\n+export async function newOperatorKey() {\n+    const kp = await subtle.generateKey({ name: \"Ed25519\" }, true, [\"sign\", \"verify\"]), j = await subtle.exportKey(\"jwk\", kp.privateKey);\n+    return { privateKey: { kty: \"OKP\", crv: \"Ed25519\", x: j.x, d: j.d }, publicKey: { kty: \"OKP\", crv: \"Ed25519\", x: j.x }, kid: await thumbOf(j.x) };\n+}\n+/**\n+ * Is this baseline the one CrawlCheck or the operator signed? opts: operatorKeys (public JWKs or their x), keyPolicy,\n+ * publishedKids, trustedKids. Returns { trust: verified | operator_signed | unsigned | invalid, signer, kid, why, parts_used,\n+ * lock } where lock is the baseline to compare against (without unsigned parts). Offline; no network.\n+ */\n+export async function verifyLockBaseline(lock, opts = {}) {\n+    const R = (trust, signer, kid, why, L) => ({ trust, signer, kid, why, parts_used: !!(L && L.parts && typeof L.parts === \"object\" && !Array.isArray(L.parts) && Object.keys(L.parts).length > 0), lock: L || lock });\n+    if (!lock || typeof lock !== \"object\" || !Array.isArray(lock.tools))\n+        return R(\"invalid\", null, null, \"the baseline is not an mcp-lockfile (an object with a tools array)\", null);\n+    const op = lock.operator_signature, okeys = (opts.operatorKeys || []).map(xOf).filter(Boolean);\n+    if (op !== undefined && op !== null && (okeys.length || !lock.signature)) {\n+        if (!okeys.length)\n+            return R(\"invalid\", null, null, \"the baseline carries an operator signature, but no operator key was given to check it\", null);\n+        if (!op || typeof op !== \"object\" || op.alg !== \"Ed25519\" || typeof op.kid !== \"string\" || typeof op.sig !== \"string\" || typeof op.message !== \"string\")\n+            return R(\"invalid\", null, null, \"the operator signature is malformed\", null);\n+        let x = null;\n+        for (const k of okeys)\n+            if ((await thumbOf(k)) === op.kid)\n+                x = k;\n+        if (!x)\n+            return R(\"invalid\", null, op.kid, \"the operator signature is by key \" + op.kid + \", which is not one of the operator keys given\", null);\n+        const sha = await sha256Hex(canon(without(lock, [\"operator_signature\"])));\n+        if (op.message !== OP_PREFIX + sha)\n+            return R(\"invalid\", \"operator\", op.kid, \"the baseline was changed after the operator signed it (it hashes to \" + sha + \")\", null);\n+        const ok = await edVerify(x, op.message, op.sig);\n+        if (ok === null)\n+            return R(\"invalid\", \"operator\", op.kid, \"this runtime cannot verify Ed25519\", null);\n+        if (!ok)\n+            return R(\"invalid\", \"operator\", op.kid, \"the operator signature does not verify\", null);\n+        return R(\"operator_signed\", \"operator\", op.kid, \"signed by operator key \" + op.kid, lock);\n+    }\n+    const s = lock.signature;\n+    if (s === undefined || s === null)\n+        return R(\"unsigned\", null, null, \"the baseline carries no signature\", lock);\n+    if (lock.kind !== \"crawlcheck-mcp-lock\" || typeof s !== \"object\" || String(s.message || \"\").indexOf(DATA_PREFIX) !== 0)\n+        return R(\"invalid\", null, null, \"the signature is not a CrawlCheck lockfile signature (kind crawlcheck-mcp-lock, scheme crawlcheck-data-v1)\", null);\n+    const kid = typeof s.kid === \"string\" ? s.kid : null;\n+    let L = lock, sha = await sha256Hex(canon(without(lock, [\"sha256\", \"signature\", \"operator_signature\"])));\n+    if (sha !== lock.sha256 && lock.parts !== undefined) {\n+        const sha2 = await sha256Hex(canon(without(lock, [\"sha256\", \"signature\", \"operator_signature\", \"parts\"])));\n+        if (sha2 === lock.sha256) {\n+            sha = sha2;\n+            L = without(lock, [\"parts\"]);\n+        }\n+    }\n+    if (sha !== lock.sha256)\n+        return R(\"invalid\", \"crawlcheck\", kid, \"the baseline was changed after it was signed (it hashes to \" + sha + \", the signature covers \" + (lock.sha256 == null ? \"null\" : String(lock.sha256)) + \")\", null);\n+    if (s.message !== DATA_PREFIX + lock.sha256)\n+        return R(\"invalid\", \"crawlcheck\", kid, \"the signature does not cover this baseline's digest\", null);\n+    const jx = s.key && s.key.jwk && s.key.jwk.x;\n+    if (typeof jx !== \"string\")\n+        return R(\"invalid\", \"crawlcheck\", kid, \"the signature carries no key\", null);\n+    if ((await thumbOf(jx)) !== kid)\n+        return R(\"invalid\", \"crawlcheck\", kid, \"the signing key's thumbprint is not its stated key id\", null);\n+    const ok = await edVerify(jx, s.message, s.sig);\n+    if (ok === null)\n+        return R(\"invalid\", \"crawlcheck\", kid, \"this runtime cannot verify Ed25519\", null);\n+    if (!ok)\n+        return R(\"invalid\", \"crawlcheck\", kid, \"the signature does not verify\", null);\n+    if (opts.keyPolicy != null) {\n+        const kp = keyPolicyCheck(lock, opts.keyPolicy);\n+        if (kp.ok !== true)\n+            return R(\"invalid\", \"crawlcheck\", kid, \"the key policy rejects the signing key: \" + kp.why, null);\n+    }\n+    else {\n+        const ids = opts.publishedKids ?? opts.trustedKids ?? CRAWLCHECK_LOCK_KIDS;\n+        if (ids.indexOf(kid) < 0)\n+            return R(\"invalid\", \"crawlcheck\", kid, \"the baseline is signed by key \" + kid + \", which is not a CrawlCheck key\", null);\n+    }\n+    return R(\"verified\", \"crawlcheck\", kid, \"signed by CrawlCheck key \" + kid + (L !== lock ? \"; lock.parts was added after signing and is not used\" : \"\"), L);\n+}\n+/** Why a baseline is refused (null when it is accepted). */\n+export function baselineRefusal(b, requireSigned) {\n+    if (!b)\n+        return \"the baseline was not checked\";\n+    if (b.trust === \"invalid\")\n+        return b.why;\n+    if (b.trust === \"unsigned\" && requireSigned)\n+        return \"the baseline is unsigned and a signed one is required\";\n+    return null;\n+}"},{"sha":"e2c2541dde15fe17bd73f93ec470a899f7c828c0","filename":"sdk/dist/frameworks.d.ts","status":"modified","additions":23,"deletions":0,"changes":23,"blob_url":"https://github.com/emmanuelorta/crawlcheck-core/blob/c634f497bd5873c2b2bd9f3ca9a26b188e08ac2a/sdk%2Fdist%2Fframeworks.d.ts","raw_url":"https://github.com/emmanuelorta/crawlcheck-core/raw/c634f497bd5873c2b2bd9f3ca9a26b188e08ac2a/sdk%2Fdist%2Fframeworks.d.ts","contents_url":"https://api.github.com/repos/emmanuelorta/crawlcheck-core/contents/sdk%2Fdist%2Fframeworks.d.ts?ref=c634f497bd5873c2b2bd9f3ca9a26b188e08ac2a","patch":"@@ -10,6 +10,9 @@ export declare function continuityGate(lock: any, opts?: {}): {\n     records: never[];\n     record: null;\n     paused: Set<any>;\n+    baseline: null;\n+    ready: null;\n+    readonly refused: any;\n     keepRecord(rec: any): Promise<any>;\n     ask(req: any): Promise<boolean>;\n     /** Compare the offered tools with the lock and apply the mode. Returns the record; throws ContinuityRefused. */\n@@ -21,6 +24,26 @@ export declare function continuityGate(lock: any, opts?: {}): {\n     /** Refuse a call to a paused tool (a framework that cached an earlier list could still try it). */\n     callOk(name: any): boolean;\n };\n+/** continuityGate, checked at startup: resolves to the gate once the baseline verifies, throws ContinuityRefused when it does not (outside observe). */\n+export declare function openContinuityGate(lock: any, opts?: {}): Promise<{\n+    mode: any;\n+    records: never[];\n+    record: null;\n+    paused: Set<any>;\n+    baseline: null;\n+    ready: null;\n+    readonly refused: any;\n+    keepRecord(rec: any): Promise<any>;\n+    ask(req: any): Promise<boolean>;\n+    /** Compare the offered tools with the lock and apply the mode. Returns the record; throws ContinuityRefused. */\n+    check(tools: any, meta?: {}): Promise<any>;\n+    /** Record a check that could not compare anything. Throws ContinuityRefused outside observe. */\n+    fail(cls: any, detail: any): Promise<any>;\n+    /** The tools the agent may see: all of them in observe mode, else without the paused ones. */\n+    allowed(tools: any, nameOf?: (t: any) => any): any;\n+    /** Refuse a call to a paused tool (a framework that cached an earlier list could still try it). */\n+    callOk(name: any): boolean;\n+}>;\n /**\n  * OpenAI Agents SDK (@openai/agents): wrap an MCP server (MCPServerStdio, MCPServerStreamableHttp, MCPServerSSE or your\n  * own MCPServer) so every listTools() the SDK makes is checked against lock. Everything else is the server's own."},{"sha":"57df9928ed344555ff34c407250638aa9ceeea77","filename":"sdk/dist/frameworks.js","status":"modified","additions":47,"deletions":4,"changes":51,"blob_url":"https://github.com/emmanuelorta/crawlcheck-core/blob/c634f497bd5873c2b2bd9f3ca9a26b188e08ac2a/sdk%2Fdist%2Fframeworks.js","raw_url":"https://github.com/emmanuelorta/crawlcheck-core/raw/c634f497bd5873c2b2bd9f3ca9a26b188e08ac2a/sdk%2Fdist%2Fframeworks.js","contents_url":"https://api.github.com/repos/emmanuelorta/crawlcheck-core/contents/sdk%2Fdist%2Fframeworks.js?ref=c634f497bd5873c2b2bd9f3ca9a26b188e08ac2a","patch":"@@ -10,7 +10,11 @@\n // confirm(request) may return a promise; request is { continuity: record } for the server or { tool, continuity } for one\n // tool. A yes is remembered for that exact definition, so a framework that lists tools every turn does not ask twice.\n // No framework is a dependency of this package: each adapter imports its framework only when called.\n-import { continuityCheck, continuityFailure } from \"./continuity.js\";\n+// 1.13.0 signed baseline: when the gate is created it checks the lockfile's signature (verifyLockBaseline) before trusting\n+// it. opts.operatorKeys, keyPolicy, publishedKids, trustedKids, requireSignedBaseline. A bad or forged signature, or an\n+// unsigned lockfile when requireSignedBaseline, is recorded as baseline_untrusted; outside observe every check then throws.\n+// await gate.ready (or use openContinuityGate) to fail at startup.\n+import { continuityCheck, continuityFailure, verifyLockBaseline, baselineRefusal } from \"./continuity.js\";\n import { canon } from \"./verify.js\";\n export class ContinuityRefused extends Error {\n     constructor(why, record = null, tool = null) {\n@@ -30,10 +34,12 @@ export function continuityGate(lock, opts = {}) {\n     if (!lock || !Array.isArray(lock.tools))\n         throw new Error(\"lock must be an approved mcp-lockfile (an object with a tools array); see https://crawlcheck.io/spec/mcp-lockfile\");\n     const keep = opts.keep ?? 50, okTools = new Set(), okLists = new Set();\n-    let lastKey = null;\n+    let lastKey = null, base = lock, refused = null;\n     const co = { mode, policy: opts.policy, exceptions: opts.exceptions, server: opts.server ?? undefined, serverIdentity: opts.serverIdentity, expectPolicySha256: opts.expectPolicySha256 };\n+    const requireSigned = opts.requireSignedBaseline ?? !!(opts.operatorKeys && opts.operatorKeys.length);\n     const gate = {\n-        mode, records: [], record: null, paused: new Set(),\n+        mode, records: [], record: null, paused: new Set(), baseline: null, ready: null,\n+        get refused() { return refused; },\n         async keepRecord(rec) {\n             gate.record = rec;\n             gate.records = gate.records.concat([rec]).slice(-keep);\n@@ -60,9 +66,12 @@ export function continuityGate(lock, opts = {}) {\n         },\n         /** Compare the offered tools with the lock and apply the mode. Returns the record; throws ContinuityRefused. */\n         async check(tools, meta = {}) {\n+            await gate.ready;\n+            if (refused)\n+                throw refused;\n             const complete = meta.complete !== false;\n             const rows = Array.isArray(tools) ? tools.map(pick) : tools;\n-            let rec = await continuityCheck(lock, rows, Object.assign({}, co, { complete }));\n+            let rec = await continuityCheck(base, rows, Object.assign({}, co, { complete, baselineTrust: gate.baseline && gate.baseline.trust }));\n             const key = (rec.observed?.tools_sha256 ?? \"\") + \"|\" + complete;\n             if (lastKey === key && gate.record)\n                 rec = gate.record;\n@@ -101,6 +110,9 @@ export function continuityGate(lock, opts = {}) {\n         },\n         /** Record a check that could not compare anything. Throws ContinuityRefused outside observe. */\n         async fail(cls, detail) {\n+            await gate.ready;\n+            if (refused)\n+                throw refused;\n             const rec = await continuityFailure(cls, Object.assign({}, co, { detail: detail ? String(detail).slice(0, 300) : undefined }));\n             lastKey = null;\n             await gate.keepRecord(rec);\n@@ -114,8 +126,36 @@ export function continuityGate(lock, opts = {}) {\n         callOk(name) { if (mode !== \"observe\" && gate.paused.has(name))\n             throw new ContinuityRefused(\"tool \" + name + \" changed since it was approved (or is new) and no person re-approved it\", gate.record, name); return true; },\n     };\n+    gate.ready = (async () => {\n+        let b;\n+        try {\n+            b = await verifyLockBaseline(lock, opts);\n+        }\n+        catch (e) {\n+            b = { trust: \"invalid\", signer: null, kid: null, why: \"the baseline could not be checked: \" + (e && e.message || e), parts_used: false, lock };\n+        }\n+        gate.baseline = { trust: b.trust, signer: b.signer, kid: b.kid, why: b.why, parts_used: b.parts_used };\n+        base = b.lock || lock;\n+        const bad = baselineRefusal(b, requireSigned);\n+        if (bad) {\n+            const rec = await continuityFailure(\"baseline_untrusted\", Object.assign({}, co, { detail: String(bad).slice(0, 300) }));\n+            await gate.keepRecord(rec);\n+            if (mode !== \"observe\" && rec.outcome !== \"proceed\")\n+                refused = new ContinuityRefused(rec.why.join(\"; \") + \": \" + bad, rec);\n+        }\n+        return gate.baseline;\n+    })();\n+    gate.ready.catch(() => { }); // a bad policy is thrown by check(), which awaits ready\n     return gate;\n }\n+/** continuityGate, checked at startup: resolves to the gate once the baseline verifies, throws ContinuityRefused when it does not (outside observe). */\n+export async function openContinuityGate(lock, opts = {}) {\n+    const g = continuityGate(lock, opts);\n+    await g.ready;\n+    if (g.refused)\n+        throw g.refused;\n+    return g;\n+}\n const urlOf = (s) => {\n     for (const p of [s && s.params, s && s.underlying && s.underlying.params, s && s.options])\n         if (p && typeof p.url === \"string\" && p.url)\n@@ -198,6 +238,9 @@ export async function loadMcpToolsWithContinuity(serverName, client, lock, opts\n         conn = null;\n     }\n     const gate = opts.gate || continuityGate(lock, Object.assign({ server: opts.serverUrl ?? (conn && conn.url) ?? undefined }, opts));\n+    await gate.ready;\n+    if (gate.refused)\n+        throw gate.refused; // 1.13.0: an untrusted baseline fails before the server is read\n     let listed;\n     try {\n         listed = await listAll(mcp);"},{"sha":"db7bf298b9ce6d9987f30d599463984d26411d66","filename":"sdk/dist/index.d.ts","status":"modified","additions":75,"deletions":7,"changes":82,"blob_url":"https://github.com/emmanuelorta/crawlcheck-core/blob/c634f497bd5873c2b2bd9f3ca9a26b188e08ac2a/sdk%2Fdist%2Findex.d.ts","raw_url":"https://github.com/emmanuelorta/crawlcheck-core/raw/c634f497bd5873c2b2bd9f3ca9a26b188e08ac2a/sdk%2Fdist%2Findex.d.ts","contents_url":"https://api.github.com/repos/emmanuelorta/crawlcheck-core/contents/sdk%2Fdist%2Findex.d.ts?ref=c634f497bd5873c2b2bd9f3ca9a26b188e08ac2a","patch":"@@ -63,7 +63,8 @@ export interface ContinuityRecord {\n         approved_at: string | null;\n         age_days: number | null;\n         server: string | null;\n-        per_part: boolean;\n+        per_part: boolean; /** 1.13.0: verified | operator_signed | unsigned | invalid (null when the caller did not check). */\n+        trust: BaselineTrust[\"trust\"] | null;\n     } | null;\n     observed: {\n         tools_sha256: string;\n@@ -87,7 +88,8 @@ export interface ContinuityOptions {\n     serverIdentity?: string;\n     expectPolicySha256?: string;\n     now?: number;\n-    detail?: string;\n+    detail?: string; /** 1.13.0: the result of verifyLockBaseline, named in record.baseline.trust. */\n+    baselineTrust?: BaselineTrust[\"trust\"];\n }\n export declare const CONTINUITY_DEFAULT_POLICY: {\n     v: 1;\n@@ -126,7 +128,66 @@ export declare const acceptanceOf: (receipt: unknown, verification: unknown, sco\n     confirmed?: boolean | null;\n     lock?: unknown;\n }) => Acceptance;\n-export interface ContinuityGateOptions extends ContinuityOptions {\n+/** An Ed25519 public key ({kty: \"OKP\", crv: \"Ed25519\", x}) or its x. */\n+export type OperatorKey = {\n+    kty?: \"OKP\";\n+    crv?: \"Ed25519\";\n+    x: string;\n+} | string;\n+export interface BaselineOptions {\n+    /** The operator's Ed25519 public keys; a lockfile signed with signLock by one of them is operator_signed. */\n+    operatorKeys?: OperatorKey[];\n+    /** keyPolicyFrom(directory) / publishedKeyPolicy(): CrawlCheck's keys with purposes and rotation, instead of the pinned ids. */\n+    keyPolicy?: unknown;\n+    /** CrawlCheck key ids to accept instead of the pinned CRAWLCHECK_LOCK_KIDS (publishedKeyIds()). */\n+    publishedKids?: string[];\n+    trustedKids?: string[];\n+    /** Refuse an unsigned lockfile (default: true when operatorKeys are given). */\n+    requireSignedBaseline?: boolean;\n+}\n+export interface BaselineTrust {\n+    trust: \"verified\" | \"operator_signed\" | \"unsigned\" | \"invalid\";\n+    signer: \"crawlcheck\" | \"operator\" | null;\n+    kid: string | null;\n+    why: string;\n+    parts_used: boolean;\n+}\n+export declare const CRAWLCHECK_LOCK_KIDS: readonly string[];\n+/** Is this the lockfile CrawlCheck or the operator signed? Offline. lock is the baseline to compare against (unsigned parts removed). */\n+export declare const verifyLockBaseline: (lock: unknown, opts?: BaselineOptions) => Promise<BaselineTrust & {\n+    lock: McpLock;\n+}>;\n+/** Sign a lockfile you approved (or edited) with your own Ed25519 key, over its canonical JSON. Returns a copy with operator_signature. */\n+export declare const signLock: <T extends McpLock>(lock: T, privateKey: {\n+    kty?: \"OKP\";\n+    crv?: \"Ed25519\";\n+    x: string;\n+    d: string;\n+}) => Promise<T & {\n+    operator_signature: {\n+        v: 1;\n+        alg: \"Ed25519\";\n+        kid: string;\n+        message: string;\n+        sig: string;\n+    };\n+}>;\n+/** A new operator key: keep privateKey away from the agent; pass publicKey in operatorKeys. */\n+export declare const newOperatorKey: () => Promise<{\n+    privateKey: {\n+        kty: \"OKP\";\n+        crv: \"Ed25519\";\n+        x: string;\n+        d: string;\n+    };\n+    publicKey: {\n+        kty: \"OKP\";\n+        crv: \"Ed25519\";\n+        x: string;\n+    };\n+    kid: string;\n+}>;\n+export interface ContinuityGateOptions extends ContinuityOptions, BaselineOptions {\n     /** A person's re-approval: { continuity } for the server, { tool, continuity } for one tool. Remembered per definition. */\n     confirm?: (request: {\n         tool?: string;\n@@ -143,7 +204,10 @@ export interface ContinuityGate {\n     mode: \"observe\" | \"review\" | \"enforce\";\n     records: ContinuityRecord[];\n     record: ContinuityRecord | null;\n-    paused: Set<string>;\n+    paused: Set<string>; /** 1.13.0: the startup check of the lockfile's signature. */\n+    ready: Promise<BaselineTrust>;\n+    baseline: BaselineTrust | null;\n+    readonly refused: Error | null;\n     check(tools: McpTool[], meta?: {\n         complete?: boolean;\n     }): Promise<ContinuityRecord>;\n@@ -159,6 +223,8 @@ export declare const ContinuityRefused: new (why: string, record?: ContinuityRec\n };\n /** The shared gate behind the framework adapters. Default mode observe. */\n export declare const continuityGate: (lock: McpLock, opts?: ContinuityGateOptions) => ContinuityGate;\n+/** 1.13.0: continuityGate that fails at startup: throws ContinuityRefused when the baseline is untrusted (outside observe). */\n+export declare const openContinuityGate: (lock: McpLock, opts?: ContinuityGateOptions) => Promise<ContinuityGate>;\n /** @openai/agents: wrap an MCP server so every listTools() is checked against lock. Records at server.continuity. */\n export declare const withContinuity: <S extends {\n     listTools: (...a: any[]) => Promise<any[]>;\n@@ -707,7 +773,7 @@ export declare const applyRevocations: (store: RevocationStore, doc: unknown, no\n export declare const revokedFor: (store: RevocationStore, domain: string, action?: string) => (RevokedEntry & {\n     domain: string;\n }) | null;\n-export interface McpPreflightOptions extends PreflightOptions {\n+export interface McpPreflightOptions extends PreflightOptions, BaselineOptions {\n     /** Proceed on warn too (default false). */\n     allowWarn?: boolean;\n     /** Called on require_confirmation (and, with confirmDestructive, before a destructive tool call); the connect or call proceeds only if it resolves true. */\n@@ -726,7 +792,7 @@ export interface McpPreflightOptions extends PreflightOptions {\n     /** The server URL when the transport does not expose it. */\n     serverUrl?: string;\n     /** 1.11.0: tool-interface continuity with lock. mode observe (record only), review (changes go to confirm), enforce (the policy applies). Every check is kept in state.records and passed to onRecord. https://crawlcheck.io/spec/continuity */\n-    continuity?: ContinuityOptions & {\n+    continuity?: ContinuityOptions & BaselineOptions & {\n         onRecord?: (record: ContinuityRecord) => unknown;\n     };\n     onlineKeys?: boolean;\n@@ -741,7 +807,9 @@ export interface McpPreflightState {\n     approved: Set<string> | null;\n     continuity: ContinuityRecord | null;\n     records: ContinuityRecord[];\n-    pausedTools: Set<string> | null;\n+    pausedTools: Set<string> | null; /** 1.13.0 */\n+    baseline: BaselineTrust | null;\n+    ready: Promise<BaselineTrust | null>;\n }\n export interface McpPreflightHooks {\n     state: McpPreflightState;"},{"sha":"51bd33cb7b30f909f24b4c97e241dd15f36fbcbd","filename":"sdk/dist/index.js","status":"modified","additions":9,"deletions":0,"changes":9,"blob_url":"https://github.com/emmanuelorta/crawlcheck-core/blob/c634f497bd5873c2b2bd9f3ca9a26b188e08ac2a/sdk%2Fdist%2Findex.js","raw_url":"https://github.com/emmanuelorta/crawlcheck-core/raw/c634f497bd5873c2b2bd9f3ca9a26b188e08ac2a/sdk%2Fdist%2Findex.js","contents_url":"https://api.github.com/repos/emmanuelorta/crawlcheck-core/contents/sdk%2Fdist%2Findex.js?ref=c634f497bd5873c2b2bd9f3ca9a26b188e08ac2a","patch":"@@ -21,10 +21,19 @@ export const lockParts = C.lockParts;\n /** Which continuity failure class a refused guard() result is. */\n export const continuityClassOf = C.continuityClassOf;\n export const acceptanceOf = C.acceptanceOf;\n+export const CRAWLCHECK_LOCK_KIDS = C.CRAWLCHECK_LOCK_KIDS;\n+/** Is this the lockfile CrawlCheck or the operator signed? Offline. lock is the baseline to compare against (unsigned parts removed). */\n+export const verifyLockBaseline = C.verifyLockBaseline;\n+/** Sign a lockfile you approved (or edited) with your own Ed25519 key, over its canonical JSON. Returns a copy with operator_signature. */\n+export const signLock = C.signLock;\n+/** A new operator key: keep privateKey away from the agent; pass publicKey in operatorKeys. */\n+export const newOperatorKey = C.newOperatorKey;\n /** Thrown in review/enforce when a record's outcome is pause, refresh or deny and nobody re-approved (or a paused tool is called). */\n export const ContinuityRefused = F.ContinuityRefused;\n /** The shared gate behind the framework adapters. Default mode observe. */\n export const continuityGate = F.continuityGate;\n+/** 1.13.0: continuityGate that fails at startup: throws ContinuityRefused when the baseline is untrusted (outside observe). */\n+export const openContinuityGate = F.openContinuityGate;\n /** @openai/agents: wrap an MCP server so every listTools() is checked against lock. Records at server.continuity. */\n export const withContinuity = F.withContinuity;\n /** @langchain/mcp-adapters: loadMcpTools with the check. client: a MultiServerMCPClient or a connected MCP SDK Client. */"},{"sha":"b434e2741a6f57564937f95560e23770fb627050","filename":"sdk/dist/mcp.js","status":"modified","additions":36,"deletions":3,"changes":39,"blob_url":"https://github.com/emmanuelorta/crawlcheck-core/blob/c634f497bd5873c2b2bd9f3ca9a26b188e08ac2a/sdk%2Fdist%2Fmcp.js","raw_url":"https://github.com/emmanuelorta/crawlcheck-core/raw/c634f497bd5873c2b2bd9f3ca9a26b188e08ac2a/sdk%2Fdist%2Fmcp.js","contents_url":"https://api.github.com/repos/emmanuelorta/crawlcheck-core/contents/sdk%2Fdist%2Fmcp.js?ref=c634f497bd5873c2b2bd9f3ca9a26b188e08ac2a","patch":"@@ -17,7 +17,7 @@\n // request is never sent.\n import { normalizeDomain } from \"./index.js\";\n import { checkLock, toolOperation } from \"./index.js\";\n-import { continuityCheck, continuityFailure, continuityClassOf } from \"./continuity.js\";\n+import { continuityCheck, continuityFailure, continuityClassOf, verifyLockBaseline, baselineRefusal } from \"./continuity.js\";\n export class McpPreflightRefused extends Error {\n     constructor(stage, why, detail) { super(\"MCP preflight refused \" + stage + \": \" + why); this.name = \"McpPreflightRefused\"; this.stage = stage; this.why = why; this.receipt = detail && detail.receipt || null; this.lock = detail && detail.lock || null; this.verification = detail && detail.verification || null; }\n }\n@@ -62,6 +62,36 @@ export function mcpPreflight(cc, opts = {}) {\n         catch (e) { }\n     } return rec; };\n     const coOpts = function (extra) { return Object.assign({ mode: CO.mode, policy: CO.policy, exceptions: CO.exceptions, server: state.url }, extra || {}); };\n+    // 1.13.0 signed baseline: the lockfile's signature is checked once, now, before anything is compared against it. Options\n+    // (in opts.continuity, or top level without continuity): operatorKeys, keyPolicy, publishedKids, trustedKids,\n+    // requireSignedBaseline. A bad or forged signature (or an unsigned lockfile when one is required) refuses the connect\n+    // outside observe; observe records baseline_untrusted and goes on.\n+    let baseLock = opts.lock || null, baseRefused = null;\n+    state.baseline = null;\n+    state.ready = !opts.lock ? Promise.resolve(null) : (async () => {\n+        const bo = Object.assign({}, opts, CO || {}), req = bo.requireSignedBaseline ?? !!(bo.operatorKeys && bo.operatorKeys.length);\n+        let b;\n+        try {\n+            b = await verifyLockBaseline(opts.lock, bo);\n+        }\n+        catch (e) {\n+            b = { trust: \"invalid\", signer: null, kid: null, why: \"the baseline could not be checked: \" + (e && e.message || e), parts_used: false, lock: opts.lock };\n+        }\n+        state.baseline = { trust: b.trust, signer: b.signer, kid: b.kid, why: b.why, parts_used: b.parts_used };\n+        baseLock = b.lock || opts.lock;\n+        const bad = baselineRefusal(b, req);\n+        if (bad && CO) {\n+            const rec = await keep(await continuityFailure(\"baseline_untrusted\", coOpts({ detail: String(bad).slice(0, 300) })));\n+            if (rec.outcome !== \"proceed\")\n+                baseRefused = new McpPreflightRefused(\"connect\", rec.why.join(\"; \") + \": \" + bad, { lock: rec });\n+        }\n+        else if (bad)\n+            baseRefused = new McpPreflightRefused(\"connect\", \"the approved lockfile is not trusted: \" + bad);\n+        return state.baseline;\n+    })();\n+    state.ready.catch(function () { });\n+    const baseOk = async function () { await state.ready; if (baseRefused)\n+        throw baseRefused; };\n     const fresh = function () {\n         if (!state.receipt)\n             return false;\n@@ -110,6 +140,7 @@ export function mcpPreflight(cc, opts = {}) {\n         state,\n         /** Before initialize. url: the server URL (a stdio/local server has none and is not decided; pass opts.local = \"allow\" | \"refuse\", default allow). */\n         async beforeConnect(url) {\n+            await baseOk();\n             if (!url) {\n                 if (opts.local === \"refuse\")\n                     throw new McpPreflightRefused(\"connect\", \"a local (stdio) server cannot be resolved and opts.local is refuse\");\n@@ -127,8 +158,9 @@ export function mcpPreflight(cc, opts = {}) {\n         },\n         /** After initialize, with the tools the server lists. Refuses (and the wrapper closes the client) when they differ from the approved lockfile. */\n         async afterConnect(tools, meta) {\n+            await baseOk();\n             if (CO && opts.lock) { // 1.11.0: classify, apply the operator's policy, keep the record\n-                const rec = await keep(await continuityCheck(opts.lock, tools, coOpts({ complete: !(meta && meta.nextCursor) })));\n+                const rec = await keep(await continuityCheck(baseLock, tools, coOpts({ complete: !(meta && meta.nextCursor), baselineTrust: state.baseline && state.baseline.trust })));\n                 state.lockCheck = rec;\n                 state.approved = null;\n                 state.pausedTools = new Set(rec.paused_tools);\n@@ -154,7 +186,7 @@ export function mcpPreflight(cc, opts = {}) {\n                 state.approved = null;\n                 return null;\n             }\n-            const lc = await checkLock(opts.lock, tools || []);\n+            const lc = await checkLock(baseLock, tools || []);\n             state.lockCheck = lc;\n             state.approved = new Set((opts.lock.tools || []).map(function (t) { return t.name; }));\n             if (lc.decision !== \"connect\")\n@@ -163,6 +195,7 @@ export function mcpPreflight(cc, opts = {}) {\n         },\n         /** Before tools/call. */\n         async beforeToolCall(name, annotations, tool) {\n+            await baseOk();\n             if (state.host && !fresh())\n                 await decide(state.host);\n             if (state.pausedTools && state.pausedTools.has(name)) { // 1.11.0: a changed or new tool waits for a person; the others stay usable"},{"sha":"98e4609beea8cd78a245832f40032ef448b22166","filename":"sdk/package.json","status":"modified","additions":1,"deletions":1,"changes":2,"blob_url":"https://github.com/emmanuelorta/crawlcheck-core/blob/c634f497bd5873c2b2bd9f3ca9a26b188e08ac2a/sdk%2Fpackage.json","raw_url":"https://github.com/emmanuelorta/crawlcheck-core/raw/c634f497bd5873c2b2bd9f3ca9a26b188e08ac2a/sdk%2Fpackage.json","contents_url":"https://api.github.com/repos/emmanuelorta/crawlcheck-core/contents/sdk%2Fpackage.json?ref=c634f497bd5873c2b2bd9f3ca9a26b188e08ac2a","patch":"@@ -1,6 +1,6 @@\n {\n   \"name\": \"@crawlcheck/sdk\",\n-  \"version\": \"1.12.0\",\n+  \"version\": \"1.13.0\",\n   \"description\": \"Typed client for the CrawlCheck API (generated from its OpenAPI document) and the zero-dependency offline verifier for evidence bundles and remediation receipts.\",\n   \"type\": \"module\",\n   \"main\": \"./dist/index.js\","},{"sha":"054cdfb49f018274fb3d681ec1c5b7e5f1e46a53","filename":"sdk/src/continuity.js","status":"modified","additions":96,"deletions":6,"changes":102,"blob_url":"https://github.com/emmanuelorta/crawlcheck-core/blob/c634f497bd5873c2b2bd9f3ca9a26b188e08ac2a/sdk%2Fsrc%2Fcontinuity.js","raw_url":"https://github.com/emmanuelorta/crawlcheck-core/raw/c634f497bd5873c2b2bd9f3ca9a26b188e08ac2a/sdk%2Fsrc%2Fcontinuity.js","contents_url":"https://api.github.com/repos/emmanuelorta/crawlcheck-core/contents/sdk%2Fsrc%2Fcontinuity.js?ref=c634f497bd5873c2b2bd9f3ca9a26b188e08ac2a","patch":"@@ -15,25 +15,28 @@\n //   enforce   the policy's effects apply as written\n // Effects, weakest to strongest: proceed, proceed_recorded (an approved exception), refresh, pause_tool, pause, deny.\n // A failed exact comparison is never overridden by an interpretive assessment: nothing here reads descriptions for intent.\n-import { canon } from \"./verify.js\";\n+import { canon, keyPolicyCheck } from \"./verify.js\";\n \n const subtle = globalThis.crypto && globalThis.crypto.subtle;\n const enc = new TextEncoder();\n const hex = (u8) => Array.from(u8, (b) => b.toString(16).padStart(2, \"0\")).join(\"\");\n async function sha256Hex(s) { return hex(new Uint8Array(await subtle.digest(\"SHA-256\", enc.encode(s)))); }\n+const b64d = (s) => { const t = String(s || \"\").replace(/-/g, \"+\").replace(/_/g, \"/\"); const bin = atob(t.padEnd(Math.ceil(t.length / 4) * 4, \"=\")); const o = new Uint8Array(bin.length); for (let i = 0; i < bin.length; i++) o[i] = bin.charCodeAt(i); return o; };\n+const b64e = (u8) => { let s = \"\"; for (const b of u8) s += String.fromCharCode(b); return btoa(s).replace(/\\+/g, \"-\").replace(/\\//g, \"_\").replace(/=+$/, \"\"); };\n \n export const CONTINUITY_EFFECTS = [\"proceed\", \"proceed_recorded\", \"refresh\", \"pause_tool\", \"pause\", \"deny\"];\n export const CONTINUITY_CHANGE_CLASSES = [\"tool_added\", \"tool_removed\", \"description_changed\", \"schema_changed\", \"annotations_changed\", \"tool_changed\"];\n-export const CONTINUITY_FAILURE_CLASSES = [\"evidence_expired\", \"signature_invalid\", \"key_unknown\", \"key_retired\", \"server_identity_mismatch\", \"server_unavailable\", \"tool_list_truncated\", \"response_malformed\", \"baseline_stale\", \"policy_version_mismatch\", \"check_timeout\", \"service_unavailable\", \"decision_refused\"];\n-const INTEGRITY = [\"signature_invalid\", \"key_unknown\", \"key_retired\", \"server_identity_mismatch\"];\n+export const CONTINUITY_FAILURE_CLASSES = [\"evidence_expired\", \"signature_invalid\", \"key_unknown\", \"key_retired\", \"server_identity_mismatch\", \"server_unavailable\", \"tool_list_truncated\", \"response_malformed\", \"baseline_stale\", \"policy_version_mismatch\", \"check_timeout\", \"service_unavailable\", \"decision_refused\", \"baseline_untrusted\"];\n+const INTEGRITY = [\"signature_invalid\", \"key_unknown\", \"key_retired\", \"server_identity_mismatch\", \"baseline_untrusted\"];\n /** The default operator policy. Every value can be overridden; the record names the policy's sha256, so what decided is attributable. */\n export const CONTINUITY_DEFAULT_POLICY = Object.freeze({\n   v: 1, id: \"crawlcheck-continuity-default\", max_baseline_age_days: 90,\n   effects: Object.freeze({\n     unchanged: \"proceed\", tool_added: \"pause_tool\", tool_removed: \"proceed\", description_changed: \"pause_tool\", schema_changed: \"pause_tool\",\n     annotations_changed: \"pause_tool\", tool_changed: \"pause_tool\", evidence_expired: \"refresh\", signature_invalid: \"deny\", key_unknown: \"deny\",\n     key_retired: \"deny\", server_identity_mismatch: \"deny\", server_unavailable: \"pause\", tool_list_truncated: \"pause\", response_malformed: \"pause\",\n-    baseline_stale: \"pause\", policy_version_mismatch: \"pause\", check_timeout: \"pause\", service_unavailable: \"pause\", decision_refused: \"deny\"\n+    baseline_stale: \"pause\", policy_version_mismatch: \"pause\", check_timeout: \"pause\", service_unavailable: \"pause\", decision_refused: \"deny\",\n+    baseline_untrusted: \"deny\"\n   })\n });\n const WHY = {\n@@ -46,7 +49,8 @@ const WHY = {\n   tool_list_truncated: \"the tool list is incomplete (a further page was not read)\", response_malformed: \"the tool list could not be parsed\",\n   baseline_stale: \"the approved baseline is older than the policy allows\", policy_version_mismatch: \"the policy in force is not the version the deployment expects\",\n   check_timeout: \"the check did not finish in time\", service_unavailable: \"the verification service could not be reached; the local fallback applies\",\n-  decision_refused: \"CrawlCheck's signed decision for the server's host did not allow the connection\"\n+  decision_refused: \"CrawlCheck's signed decision for the server's host did not allow the connection\",\n+  baseline_untrusted: \"the approved baseline is not trusted: its signature does not verify, its key is neither CrawlCheck's nor a given operator key, or it is unsigned where a signed one is required\"\n };\n \n /** Per-part hashes of one tool, so a change can be named (description, schema, annotations). */\n@@ -118,7 +122,7 @@ export async function continuityCheck(lock, tools, opts = {}) {\n   const listHash = await sha256Hex(rows.map((r) => r.sha256).sort().join(\"\\n\"));\n   const was = {}; (lock?.tools ?? []).forEach((r) => { was[r.name] = r.sha256; });\n   const approvedAt = Date.parse(lock?.approved_at ?? \"\");\n-  rec.baseline = { tools_sha256: lock?.tools_sha256 ?? null, approved_at: lock?.approved_at ?? null, age_days: isFinite(approvedAt) ? Math.floor((now - approvedAt) / 864e5) : null, server: lock?.server?.url ?? null, per_part: !!(lock && lock.parts) };\n+  rec.baseline = { tools_sha256: lock?.tools_sha256 ?? null, approved_at: lock?.approved_at ?? null, age_days: isFinite(approvedAt) ? Math.floor((now - approvedAt) / 864e5) : null, server: lock?.server?.url ?? null, per_part: !!(lock && lock.parts), trust: opts.baselineTrust ?? null };\n   rec.observed = { tools_sha256: listHash, count: rows.length, complete: opts.complete !== false };\n   if (opts.expectPolicySha256 && opts.expectPolicySha256 !== pol.sha256) ev(rec, pol, mode, \"policy_version_mismatch\", null, X, now, \"expected \" + opts.expectPolicySha256 + \", in force \" + pol.sha256);\n   const want = opts.serverIdentity ?? lock?.server?.url ?? null;\n@@ -198,3 +202,89 @@ export function continuityClassOf(g) {\n   else if (g.verification === null) return \"response_malformed\";\n   return \"decision_refused\";\n }\n+\n+// ── signed baseline (1.13.0) ───────────────────────────────────────────────────────────────────────────────────────\n+// Whoever can edit the approved lockfile can approve their own tools. So the baseline's signature is checked once, when a\n+// gate is created (startup), before anything is compared against it:\n+//   verified         signed by CrawlCheck (/api/v1/mcp/lock, kind crawlcheck-mcp-lock, scheme crawlcheck-data-v1) with a\n+//                    CrawlCheck key: the pinned ids below, opts.publishedKids, or opts.keyPolicy (keyPolicyFrom /\n+//                    publishedKeyPolicy, which follows rotation). lock.parts added after signing is not covered: dropped.\n+//   operator_signed  signed with signLock() by a key in opts.operatorKeys (the operator's Ed25519 public keys).\n+//   unsigned         no signature. Accepted unless requireSignedBaseline (default: on when operatorKeys are given).\n+//   invalid          a signature that does not verify, a changed lockfile, or a key that is neither: baseline_untrusted.\n+/** CrawlCheck's lockfile signing keys (RFC 7638 thumbprints), as published at /.well-known/http-message-signatures-directory on 2026-11-07. */\n+export const CRAWLCHECK_LOCK_KIDS = Object.freeze([\"1hHmE3fo1rg5Ig70wuFtJ5wBc7G-sUTgUJkxyPWFRps\", \"hcIAczGf-8EFBnkunmZlvFWnD2nHHeHeC9cM4BTiBVo\"]);\n+const DATA_PREFIX = \"crawlcheck-data-v1\\n\", OP_PREFIX = \"crawlcheck-lock-operator-v1\\n\";\n+async function thumbOf(x) { return b64e(new Uint8Array(await subtle.digest(\"SHA-256\", enc.encode(JSON.stringify({ crv: \"Ed25519\", kty: \"OKP\", x: String(x) }))))); }\n+async function edVerify(x, msg, sig) {\n+  try { const k = await subtle.importKey(\"jwk\", { kty: \"OKP\", crv: \"Ed25519\", x: String(x) }, { name: \"Ed25519\" }, false, [\"verify\"]); return await subtle.verify({ name: \"Ed25519\" }, k, b64d(sig), enc.encode(msg)); }\n+  catch (e) { return /not supported|unrecognized|unknown algorithm|NotSupported/i.test(String(e && (e.name + \" \" + e.message))) ? null : false; }\n+}\n+const without = (o, keys) => { const b = {}; for (const k of Object.keys(o)) if (keys.indexOf(k) < 0) b[k] = o[k]; return b; };\n+const xOf = (k) => (typeof k === \"string\" ? k : k && typeof k.x === \"string\" ? k.x : null);\n+\n+/** The operator's signature over the canonical lockfile (every field but operator_signature). privateKey: an Ed25519 private JWK ({kty, crv, x, d}). */\n+export async function signLock(lock, privateKey) {\n+  if (!lock || typeof lock !== \"object\" || !Array.isArray(lock.tools)) throw new Error(\"lock must be an mcp-lockfile (an object with a tools array)\");\n+  const j = privateKey || {};\n+  if (typeof j.d !== \"string\" || typeof j.x !== \"string\") throw new Error(\"privateKey must be an Ed25519 private JWK with d and x (see newOperatorKey)\");\n+  const body = without(lock, [\"operator_signature\"]), message = OP_PREFIX + (await sha256Hex(canon(body)));\n+  const k = await subtle.importKey(\"jwk\", { kty: \"OKP\", crv: \"Ed25519\", x: j.x, d: j.d }, { name: \"Ed25519\" }, false, [\"sign\"]);\n+  const sig = b64e(new Uint8Array(await subtle.sign({ name: \"Ed25519\" }, k, enc.encode(message))));\n+  return Object.assign(body, { operator_signature: { v: 1, alg: \"Ed25519\", kid: await thumbOf(j.x), message, sig } });\n+}\n+/** A new operator signing key: { privateKey (JWK, keep it out of the agent's reach), publicKey ({kty, crv, x}: pass it as operatorKeys) }. */\n+export async function newOperatorKey() {\n+  const kp = await subtle.generateKey({ name: \"Ed25519\" }, true, [\"sign\", \"verify\"]), j = await subtle.exportKey(\"jwk\", kp.privateKey);\n+  return { privateKey: { kty: \"OKP\", crv: \"Ed25519\", x: j.x, d: j.d }, publicKey: { kty: \"OKP\", crv: \"Ed25519\", x: j.x }, kid: await thumbOf(j.x) };\n+}\n+\n+/**\n+ * Is this baseline the one CrawlCheck or the operator signed? opts: operatorKeys (public JWKs or their x), keyPolicy,\n+ * publishedKids, trustedKids. Returns { trust: verified | operator_signed | unsigned | invalid, signer, kid, why, parts_used,\n+ * lock } where lock is the baseline to compare against (without unsigned parts). Offline; no network.\n+ */\n+export async function verifyLockBaseline(lock, opts = {}) {\n+  const R = (trust, signer, kid, why, L) => ({ trust, signer, kid, why, parts_used: !!(L && L.parts && typeof L.parts === \"object\" && !Array.isArray(L.parts) && Object.keys(L.parts).length > 0), lock: L || lock });\n+  if (!lock || typeof lock !== \"object\" || !Array.isArray(lock.tools)) return R(\"invalid\", null, null, \"the baseline is not an mcp-lockfile (an object with a tools array)\", null);\n+  const op = lock.operator_signature, okeys = (opts.operatorKeys || []).map(xOf).filter(Boolean);\n+  if (op !== undefined && op !== null && (okeys.length || !lock.signature)) {\n+    if (!okeys.length) return R(\"invalid\", null, null, \"the baseline carries an operator signature, but no operator key was given to check it\", null);\n+    if (!op || typeof op !== \"object\" || op.alg !== \"Ed25519\" || typeof op.kid !== \"string\" || typeof op.sig !== \"string\" || typeof op.message !== \"string\") return R(\"invalid\", null, null, \"the operator signature is malformed\", null);\n+    let x = null; for (const k of okeys) if ((await thumbOf(k)) === op.kid) x = k;\n+    if (!x) return R(\"invalid\", null, op.kid, \"the operator signature is by key \" + op.kid + \", which is not one of the operator keys given\", null);\n+    const sha = await sha256Hex(canon(without(lock, [\"operator_signature\"])));\n+    if (op.message !== OP_PREFIX + sha) return R(\"invalid\", \"operator\", op.kid, \"the baseline was changed after the operator signed it (it hashes to \" + sha + \")\", null);\n+    const ok = await edVerify(x, op.message, op.sig);\n+    if (ok === null) return R(\"invalid\", \"operator\", op.kid, \"this runtime cannot verify Ed25519\", null);\n+    if (!ok) return R(\"invalid\", \"operator\", op.kid, \"the operator signature does not verify\", null);\n+    return R(\"operator_signed\", \"operator\", op.kid, \"signed by operator key \" + op.kid, lock);\n+  }\n+  const s = lock.signature;\n+  if (s === undefined || s === null) return R(\"unsigned\", null, null, \"the baseline carries no signature\", lock);\n+  if (lock.kind !== \"crawlcheck-mcp-lock\" || typeof s !== \"object\" || String(s.message || \"\").indexOf(DATA_PREFIX) !== 0) return R(\"invalid\", null, null, \"the signature is not a CrawlCheck lockfile signature (kind crawlcheck-mcp-lock, scheme crawlcheck-data-v1)\", null);\n+  const kid = typeof s.kid === \"string\" ? s.kid : null;\n+  let L = lock, sha = await sha256Hex(canon(without(lock, [\"sha256\", \"signature\", \"operator_signature\"])));\n+  if (sha !== lock.sha256 && lock.parts !== undefined) {\n+    const sha2 = await sha256Hex(canon(without(lock, [\"sha256\", \"signature\", \"operator_signature\", \"parts\"])));\n+    if (sha2 === lock.sha256) { sha = sha2; L = without(lock, [\"parts\"]); }\n+  }\n+  if (sha !== lock.sha256) return R(\"invalid\", \"crawlcheck\", kid, \"the baseline was changed after it was signed (it hashes to \" + sha + \", the signature covers \" + (lock.sha256 == null ? \"null\" : String(lock.sha256)) + \")\", null);\n+  if (s.message !== DATA_PREFIX + lock.sha256) return R(\"invalid\", \"crawlcheck\", kid, \"the signature does not cover this baseline's digest\", null);\n+  const jx = s.key && s.key.jwk && s.key.jwk.x;\n+  if (typeof jx !== \"string\") return R(\"invalid\", \"crawlcheck\", kid, \"the signature carries no key\", null);\n+  if ((await thumbOf(jx)) !== kid) return R(\"invalid\", \"crawlcheck\", kid, \"the signing key's thumbprint is not its stated key id\", null);\n+  const ok = await edVerify(jx, s.message, s.sig);\n+  if (ok === null) return R(\"invalid\", \"crawlcheck\", kid, \"this runtime cannot verify Ed25519\", null);\n+  if (!ok) return R(\"invalid\", \"crawlcheck\", kid, \"the signature does not verify\", null);\n+  if (opts.keyPolicy != null) { const kp = keyPolicyCheck(lock, opts.keyPolicy); if (kp.ok !== true) return R(\"invalid\", \"crawlcheck\", kid, \"the key policy rejects the signing key: \" + kp.why, null); }\n+  else { const ids = opts.publishedKids ?? opts.trustedKids ?? CRAWLCHECK_LOCK_KIDS; if (ids.indexOf(kid) < 0) return R(\"invalid\", \"crawlcheck\", kid, \"the baseline is signed by key \" + kid + \", which is not a CrawlCheck key\", null); }\n+  return R(\"verified\", \"crawlcheck\", kid, \"signed by CrawlCheck key \" + kid + (L !== lock ? \"; lock.parts was added after signing and is not used\" : \"\"), L);\n+}\n+/** Why a baseline is refused (null when it is accepted). */\n+export function baselineRefusal(b, requireSigned) {\n+  if (!b) return \"the baseline was not checked\";\n+  if (b.trust === \"invalid\") return b.why;\n+  if (b.trust === \"unsigned\" && requireSigned) return \"the baseline is unsigned and a signed one is required\";\n+  return null;\n+}"},{"sha":"d6c8e2798aabbc48a59a2842dad6dd382f81c1d6","filename":"sdk/src/frameworks.js","status":"modified","additions":33,"deletions":4,"changes":37,"blob_url":"https://github.com/emmanuelorta/crawlcheck-core/blob/c634f497bd5873c2b2bd9f3ca9a26b188e08ac2a/sdk%2Fsrc%2Fframeworks.js","raw_url":"https://github.com/emmanuelorta/crawlcheck-core/raw/c634f497bd5873c2b2bd9f3ca9a26b188e08ac2a/sdk%2Fsrc%2Fframeworks.js","contents_url":"https://api.github.com/repos/emmanuelorta/crawlcheck-core/contents/sdk%2Fsrc%2Fframeworks.js?ref=c634f497bd5873c2b2bd9f3ca9a26b188e08ac2a","patch":"@@ -10,7 +10,11 @@\n // confirm(request) may return a promise; request is { continuity: record } for the server or { tool, continuity } for one\n // tool. A yes is remembered for that exact definition, so a framework that lists tools every turn does not ask twice.\n // No framework is a dependency of this package: each adapter imports its framework only when called.\n-import { continuityCheck, continuityFailure } from \"./continuity.js\";\n+// 1.13.0 signed baseline: when the gate is created it checks the lockfile's signature (verifyLockBaseline) before trusting\n+// it. opts.operatorKeys, keyPolicy, publishedKids, trustedKids, requireSignedBaseline. A bad or forged signature, or an\n+// unsigned lockfile when requireSignedBaseline, is recorded as baseline_untrusted; outside observe every check then throws.\n+// await gate.ready (or use openContinuityGate) to fail at startup.\n+import { continuityCheck, continuityFailure, verifyLockBaseline, baselineRefusal } from \"./continuity.js\";\n import { canon } from \"./verify.js\";\n \n export class ContinuityRefused extends Error {\n@@ -28,10 +32,12 @@ export function continuityGate(lock, opts = {}) {\n   if ([\"observe\", \"review\", \"enforce\"].indexOf(mode) < 0) throw new Error(\"mode must be observe, review or enforce\");\n   if (!lock || !Array.isArray(lock.tools)) throw new Error(\"lock must be an approved mcp-lockfile (an object with a tools array); see https://crawlcheck.io/spec/mcp-lockfile\");\n   const keep = opts.keep ?? 50, okTools = new Set(), okLists = new Set();\n-  let lastKey = null;\n+  let lastKey = null, base = lock, refused = null;\n   const co = { mode, policy: opts.policy, exceptions: opts.exceptions, server: opts.server ?? undefined, serverIdentity: opts.serverIdentity, expectPolicySha256: opts.expectPolicySha256 };\n+  const requireSigned = opts.requireSignedBaseline ?? !!(opts.operatorKeys && opts.operatorKeys.length);\n   const gate = {\n-    mode, records: [], record: null, paused: new Set(),\n+    mode, records: [], record: null, paused: new Set(), baseline: null, ready: null,\n+    get refused() { return refused; },\n     async keepRecord(rec) {\n       gate.record = rec; gate.records = gate.records.concat([rec]).slice(-keep);\n       const changed = rec.events.some((e) => e.class !== \"unchanged\");\n@@ -45,9 +51,10 @@ export function continuityGate(lock, opts = {}) {\n     },\n     /** Compare the offered tools with the lock and apply the mode. Returns the record; throws ContinuityRefused. */\n     async check(tools, meta = {}) {\n+      await gate.ready; if (refused) throw refused;\n       const complete = meta.complete !== false;\n       const rows = Array.isArray(tools) ? tools.map(pick) : tools;\n-      let rec = await continuityCheck(lock, rows, Object.assign({}, co, { complete }));\n+      let rec = await continuityCheck(base, rows, Object.assign({}, co, { complete, baselineTrust: gate.baseline && gate.baseline.trust }));\n       const key = (rec.observed?.tools_sha256 ?? \"\") + \"|\" + complete;\n       if (lastKey === key && gate.record) rec = gate.record; else { lastKey = key; await gate.keepRecord(rec); }\n       if (mode === \"observe\") { gate.paused = new Set(); return rec; }\n@@ -66,6 +73,7 @@ export function continuityGate(lock, opts = {}) {\n     },\n     /** Record a check that could not compare anything. Throws ContinuityRefused outside observe. */\n     async fail(cls, detail) {\n+      await gate.ready; if (refused) throw refused;\n       const rec = await continuityFailure(cls, Object.assign({}, co, { detail: detail ? String(detail).slice(0, 300) : undefined }));\n       lastKey = null; await gate.keepRecord(rec);\n       if (mode !== \"observe\" && rec.outcome !== \"proceed\") throw new ContinuityRefused(rec.why.join(\"; \"), rec);\n@@ -76,9 +84,29 @@ export function continuityGate(lock, opts = {}) {\n     /** Refuse a call to a paused tool (a framework that cached an earlier list could still try it). */\n     callOk(name) { if (mode !== \"observe\" && gate.paused.has(name)) throw new ContinuityRefused(\"tool \" + name + \" changed since it was approved (or is new) and no person re-approved it\", gate.record, name); return true; },\n   };\n+  gate.ready = (async () => {   // startup: the baseline is checked once, before anything is compared against it\n+    let b;\n+    try { b = await verifyLockBaseline(lock, opts); } catch (e) { b = { trust: \"invalid\", signer: null, kid: null, why: \"the baseline could not be checked: \" + (e && e.message || e), parts_used: false, lock }; }\n+    gate.baseline = { trust: b.trust, signer: b.signer, kid: b.kid, why: b.why, parts_used: b.parts_used }; base = b.lock || lock;\n+    const bad = baselineRefusal(b, requireSigned);\n+    if (bad) {\n+      const rec = await continuityFailure(\"baseline_untrusted\", Object.assign({}, co, { detail: String(bad).slice(0, 300) }));\n+      await gate.keepRecord(rec);\n+      if (mode !== \"observe\" && rec.outcome !== \"proceed\") refused = new ContinuityRefused(rec.why.join(\"; \") + \": \" + bad, rec);\n+    }\n+    return gate.baseline;\n+  })();\n+  gate.ready.catch(() => { });   // a bad policy is thrown by check(), which awaits ready\n   return gate;\n }\n \n+/** continuityGate, checked at startup: resolves to the gate once the baseline verifies, throws ContinuityRefused when it does not (outside observe). */\n+export async function openContinuityGate(lock, opts = {}) {\n+  const g = continuityGate(lock, opts); await g.ready;\n+  if (g.refused) throw g.refused;\n+  return g;\n+}\n+\n const urlOf = (s) => {\n   for (const p of [s && s.params, s && s.underlying && s.underlying.params, s && s.options]) if (p && typeof p.url === \"string\" && p.url) return p.url;\n   return null;\n@@ -142,6 +170,7 @@ export async function loadMcpToolsWithContinuity(serverName, client, lock, opts\n   let conn = null;\n   try { const c = client && client !== mcp ? client.config : null; conn = c ? ((c.servers || c.mcpServers || {})[serverName] ?? null) : null; } catch { conn = null; }\n   const gate = opts.gate || continuityGate(lock, Object.assign({ server: opts.serverUrl ?? (conn && conn.url) ?? undefined }, opts));\n+  await gate.ready; if (gate.refused) throw gate.refused;   // 1.13.0: an untrusted baseline fails before the server is read\n   let listed;\n   try { listed = await listAll(mcp); } catch (e) { await gate.fail(\"server_unavailable\", e && e.message); throw e; }\n   await gate.check(structuredClone(listed.tools), { complete: listed.complete });"},{"sha":"24dedec1b1d9a059e46595d75ac342b74bc0c03d","filename":"sdk/src/index.ts","status":"modified","additions":33,"deletions":9,"changes":42,"blob_url":"https://github.com/emmanuelorta/crawlcheck-core/blob/c634f497bd5873c2b2bd9f3ca9a26b188e08ac2a/sdk%2Fsrc%2Findex.ts","raw_url":"https://github.com/emmanuelorta/crawlcheck-core/raw/c634f497bd5873c2b2bd9f3ca9a26b188e08ac2a/sdk%2Fsrc%2Findex.ts","contents_url":"https://api.github.com/repos/emmanuelorta/crawlcheck-core/contents/sdk%2Fsrc%2Findex.ts?ref=c634f497bd5873c2b2bd9f3ca9a26b188e08ac2a","patch":"@@ -18,8 +18,8 @@ export type ContinuityEffect = \"proceed\" | \"proceed_recorded\" | \"refresh\" | \"pau\n export interface ContinuityPolicy { v?: 1; id?: string; max_baseline_age_days?: number; effects?: Partial<Record<string, ContinuityEffect>>; allow_integrity_override?: boolean }\n export interface ContinuityException { tool?: string; class: string; until?: string; by?: string; reason?: string }\n export interface ContinuityEvent { class: string; tool: string | null; why: string; policy_effect: ContinuityEffect; effect: ContinuityEffect; exception?: { by: string | null; reason: string | null; until: string | null }; detail?: string }\n-export interface ContinuityRecord { kind: \"crawlcheck-continuity-record\"; v: 1; checked_at: string; mode: \"observe\" | \"review\" | \"enforce\"; server: string | null; policy: { id: string; sha256: string; integrity_override: boolean }; claims: string; baseline: { tools_sha256: string | null; approved_at: string | null; age_days: number | null; server: string | null; per_part: boolean } | null; observed: { tools_sha256: string; count: number; complete: boolean } | null; events: ContinuityEvent[]; would: ContinuityEffect; enforced: boolean; outcome: \"proceed\" | \"refresh\" | \"pause\" | \"deny\"; paused_tools: string[]; why: string[]; record_sha256: string }\n-export interface ContinuityOptions { mode?: \"observe\" | \"review\" | \"enforce\"; policy?: ContinuityPolicy; exceptions?: ContinuityException[]; complete?: boolean; server?: string; serverIdentity?: string; expectPolicySha256?: string; now?: number; detail?: string }\n+export interface ContinuityRecord { kind: \"crawlcheck-continuity-record\"; v: 1; checked_at: string; mode: \"observe\" | \"review\" | \"enforce\"; server: string | null; policy: { id: string; sha256: string; integrity_override: boolean }; claims: string; baseline: { tools_sha256: string | null; approved_at: string | null; age_days: number | null; server: string | null; per_part: boolean; /** 1.13.0: verified | operator_signed | unsigned | invalid (null when the caller did not check). */ trust: BaselineTrust[\"trust\"] | null } | null; observed: { tools_sha256: string; count: number; complete: boolean } | null; events: ContinuityEvent[]; would: ContinuityEffect; enforced: boolean; outcome: \"proceed\" | \"refresh\" | \"pause\" | \"deny\"; paused_tools: string[]; why: string[]; record_sha256: string }\n+export interface ContinuityOptions { mode?: \"observe\" | \"review\" | \"enforce\"; policy?: ContinuityPolicy; exceptions?: ContinuityException[]; complete?: boolean; server?: string; serverIdentity?: string; expectPolicySha256?: string; now?: number; detail?: string; /** 1.13.0: the result of verifyLockBaseline, named in record.baseline.trust. */ baselineTrust?: BaselineTrust[\"trust\"] }\n export const CONTINUITY_DEFAULT_POLICY = C.CONTINUITY_DEFAULT_POLICY as { v: 1; id: string; max_baseline_age_days: number; effects: Record<string, ContinuityEffect> };\n export const CONTINUITY_CHANGE_CLASSES = C.CONTINUITY_CHANGE_CLASSES as string[];\n export const CONTINUITY_FAILURE_CLASSES = C.CONTINUITY_FAILURE_CLASSES as string[];\n@@ -37,19 +37,43 @@ export const lockParts = C.lockParts as (tools: McpTool[]) => Promise<Record<str\n export const continuityClassOf = (C as any).continuityClassOf as (g: GuardResult | null) => string;\n export const acceptanceOf = C.acceptanceOf as (receipt: unknown, verification: unknown, scope: { fields?: unknown } | null, opts?: { allowWarn?: boolean; confirmed?: boolean | null; lock?: unknown }) => Acceptance;\n \n+// ── signed baseline (1.13.0): the lockfile's signature is checked before it is trusted ──\n+/** An Ed25519 public key ({kty: \"OKP\", crv: \"Ed25519\", x}) or its x. */\n+export type OperatorKey = { kty?: \"OKP\"; crv?: \"Ed25519\"; x: string } | string;\n+export interface BaselineOptions {\n+  /** The operator's Ed25519 public keys; a lockfile signed with signLock by one of them is operator_signed. */\n+  operatorKeys?: OperatorKey[];\n+  /** keyPolicyFrom(directory) / publishedKeyPolicy(): CrawlCheck's keys with purposes and rotation, instead of the pinned ids. */\n+  keyPolicy?: unknown;\n+  /** CrawlCheck key ids to accept instead of the pinned CRAWLCHECK_LOCK_KIDS (publishedKeyIds()). */\n+  publishedKids?: string[]; trustedKids?: string[];\n+  /** Refuse an unsigned lockfile (default: true when operatorKeys are given). */\n+  requireSignedBaseline?: boolean;\n+}\n+export interface BaselineTrust { trust: \"verified\" | \"operator_signed\" | \"unsigned\" | \"invalid\"; signer: \"crawlcheck\" | \"operator\" | null; kid: string | null; why: string; parts_used: boolean }\n+export const CRAWLCHECK_LOCK_KIDS = C.CRAWLCHECK_LOCK_KIDS as readonly string[];\n+/** Is this the lockfile CrawlCheck or the operator signed? Offline. lock is the baseline to compare against (unsigned parts removed). */\n+export const verifyLockBaseline = C.verifyLockBaseline as (lock: unknown, opts?: BaselineOptions) => Promise<BaselineTrust & { lock: McpLock }>;\n+/** Sign a lockfile you approved (or edited) with your own Ed25519 key, over its canonical JSON. Returns a copy with operator_signature. */\n+export const signLock = C.signLock as <T extends McpLock>(lock: T, privateKey: { kty?: \"OKP\"; crv?: \"Ed25519\"; x: string; d: string }) => Promise<T & { operator_signature: { v: 1; alg: \"Ed25519\"; kid: string; message: string; sig: string } }>;\n+/** A new operator key: keep privateKey away from the agent; pass publicKey in operatorKeys. */\n+export const newOperatorKey = C.newOperatorKey as () => Promise<{ privateKey: { kty: \"OKP\"; crv: \"Ed25519\"; x: string; d: string }; publicKey: { kty: \"OKP\"; crv: \"Ed25519\"; x: string }; kid: string }>;\n+\n // ── continuity at the framework's tool-list fetch (1.12.0): @openai/agents and @langchain/mcp-adapters, no dependency ──\n-export interface ContinuityGateOptions extends ContinuityOptions {\n+export interface ContinuityGateOptions extends ContinuityOptions, BaselineOptions {\n   /** A person's re-approval: { continuity } for the server, { tool, continuity } for one tool. Remembered per definition. */\n   confirm?: (request: { tool?: string; continuity: ContinuityRecord }) => boolean | Promise<boolean>;\n   onRecord?: (record: ContinuityRecord) => unknown;\n   /** false: no console.warn on a change. */ log?: boolean; logger?: { warn: (msg: string) => unknown };\n   /** Records kept in gate.records (default 50). */ keep?: number;\n }\n-export interface ContinuityGate { mode: \"observe\" | \"review\" | \"enforce\"; records: ContinuityRecord[]; record: ContinuityRecord | null; paused: Set<string>; check(tools: McpTool[], meta?: { complete?: boolean }): Promise<ContinuityRecord>; fail(cls: string, detail?: string): Promise<ContinuityRecord>; allowed<T>(tools: T[], nameOf?: (t: T) => string): T[]; callOk(name: string): true }\n+export interface ContinuityGate { mode: \"observe\" | \"review\" | \"enforce\"; records: ContinuityRecord[]; record: ContinuityRecord | null; paused: Set<string>; /** 1.13.0: the startup check of the lockfile's signature. */ ready: Promise<BaselineTrust>; baseline: BaselineTrust | null; readonly refused: Error | null; check(tools: McpTool[], meta?: { complete?: boolean }): Promise<ContinuityRecord>; fail(cls: string, detail?: string): Promise<ContinuityRecord>; allowed<T>(tools: T[], nameOf?: (t: T) => string): T[]; callOk(name: string): true }\n /** Thrown in review/enforce when a record's outcome is pause, refresh or deny and nobody re-approved (or a paused tool is called). */\n export const ContinuityRefused = F.ContinuityRefused as unknown as new (why: string, record?: ContinuityRecord | null, tool?: string | null) => Error & { why: string; record: ContinuityRecord | null; tool: string | null };\n /** The shared gate behind the framework adapters. Default mode observe. */\n-export const continuityGate = F.continuityGate as (lock: McpLock, opts?: ContinuityGateOptions) => ContinuityGate;\n+export const continuityGate = F.continuityGate as unknown as (lock: McpLock, opts?: ContinuityGateOptions) => ContinuityGate;\n+/** 1.13.0: continuityGate that fails at startup: throws ContinuityRefused when the baseline is untrusted (outside observe). */\n+export const openContinuityGate = F.openContinuityGate as unknown as (lock: McpLock, opts?: ContinuityGateOptions) => Promise<ContinuityGate>;\n /** @openai/agents: wrap an MCP server so every listTools() is checked against lock. Records at server.continuity. */\n export const withContinuity = F.withContinuity as <S extends { listTools: (...a: any[]) => Promise<any[]>; callTool: (...a: any[]) => Promise<any> }>(server: S, lock: McpLock, opts?: ContinuityGateOptions & { serverUrl?: string; gate?: ContinuityGate }) => S & { continuity: ContinuityGate };\n /** @langchain/mcp-adapters: loadMcpTools with the check. client: a MultiServerMCPClient or a connected MCP SDK Client. */\n@@ -272,7 +296,7 @@ export const applyRevocations = R.applyRevocations as (store: RevocationStore, d\n export const revokedFor = R.revokedFor as (store: RevocationStore, domain: string, action?: string) => (RevokedEntry & { domain: string }) | null;\n \n // ── preflight as an MCP client extension (https://crawlcheck.io/spec/mcp-preflight) ──\n-export interface McpPreflightOptions extends PreflightOptions {\n+export interface McpPreflightOptions extends PreflightOptions, BaselineOptions {\n   /** Proceed on warn too (default false). */\n   allowWarn?: boolean;\n   /** Called on require_confirmation (and, with confirmDestructive, before a destructive tool call); the connect or call proceeds only if it resolves true. */\n@@ -288,10 +312,10 @@ export interface McpPreflightOptions extends PreflightOptions {\n   /** The server URL when the transport does not expose it. */\n   serverUrl?: string;\n   /** 1.11.0: tool-interface continuity with lock. mode observe (record only), review (changes go to confirm), enforce (the policy applies). Every check is kept in state.records and passed to onRecord. https://crawlcheck.io/spec/continuity */\n-  continuity?: ContinuityOptions & { onRecord?: (record: ContinuityRecord) => unknown };\n+  continuity?: ContinuityOptions & BaselineOptions & { onRecord?: (record: ContinuityRecord) => unknown };\n   onlineKeys?: boolean;\n }\n-export interface McpPreflightState { url: string | null; host: string | null; receipt: DecisionReceipt | null; verification: (DocumentVerification & Trust) | null; decidedAt: number; lockCheck: McpLockCheck | ContinuityRecord | null; approved: Set<string> | null; continuity: ContinuityRecord | null; records: ContinuityRecord[]; pausedTools: Set<string> | null }\n+export interface McpPreflightState { url: string | null; host: string | null; receipt: DecisionReceipt | null; verification: (DocumentVerification & Trust) | null; decidedAt: number; lockCheck: McpLockCheck | ContinuityRecord | null; approved: Set<string> | null; continuity: ContinuityRecord | null; records: ContinuityRecord[]; pausedTools: Set<string> | null; /** 1.13.0 */ baseline: BaselineTrust | null; ready: Promise<BaselineTrust | null> }\n export interface McpPreflightHooks {\n   state: McpPreflightState;\n   beforeConnect(url: string | null | undefined): Promise<{ local: boolean; host?: string; receipt: DecisionReceipt | null; verification?: DocumentVerification & Trust }>;\n@@ -301,7 +325,7 @@ export interface McpPreflightHooks {\n /** Thrown by the hooks when a connect or tools/call is refused; the request was never sent. */\n export const McpPreflightRefused = M.McpPreflightRefused as unknown as new (stage: \"connect\" | \"tools/call\", why: string, detail?: { receipt?: DecisionReceipt | null; lock?: McpLockCheck | null; verification?: unknown }) => Error & { stage: \"connect\" | \"tools/call\"; why: string; receipt: DecisionReceipt | null; lock: McpLockCheck | null; verification: unknown };\n /** The two hooks (beforeConnect, beforeToolCall) plus afterConnect for lockfiles, for any MCP client stack. */\n-export const mcpPreflight = M.mcpPreflight as (cc: CrawlCheck, opts?: McpPreflightOptions) => McpPreflightHooks;\n+export const mcpPreflight = M.mcpPreflight as unknown as (cc: CrawlCheck, opts?: McpPreflightOptions) => McpPreflightHooks;\n /** Wrap an MCP client (the official @modelcontextprotocol/sdk Client, or anything with connect(transport) and callTool(params)) so both run the preflight first. Returns the same client with client.preflight set. */\n export const withPreflight = M.withPreflight as <C extends { connect: (...a: any[]) => Promise<any>; callTool: (...a: any[]) => Promise<any> }>(client: C, cc: CrawlCheck, opts?: McpPreflightOptions) => C & { preflight: McpPreflightHooks };\n /** The server URL a transport will talk to, if it exposes one (Streamable HTTP and SSE transports do). */"},{"sha":"95eb0322295943f942d389c35c8afe61b988910d","filename":"sdk/src/mcp.js","status":"modified","additions":25,"deletions":3,"changes":28,"blob_url":"https://github.com/emmanuelorta/crawlcheck-core/blob/c634f497bd5873c2b2bd9f3ca9a26b188e08ac2a/sdk%2Fsrc%2Fmcp.js","raw_url":"https://github.com/emmanuelorta/crawlcheck-core/raw/c634f497bd5873c2b2bd9f3ca9a26b188e08ac2a/sdk%2Fsrc%2Fmcp.js","contents_url":"https://api.github.com/repos/emmanuelorta/crawlcheck-core/contents/sdk%2Fsrc%2Fmcp.js?ref=c634f497bd5873c2b2bd9f3ca9a26b188e08ac2a","patch":"@@ -17,7 +17,7 @@\n // request is never sent.\n import { normalizeDomain } from \"./index.js\";\n import { checkLock, toolOperation } from \"./index.js\";\n-import { continuityCheck, continuityFailure, continuityClassOf } from \"./continuity.js\";\n+import { continuityCheck, continuityFailure, continuityClassOf, verifyLockBaseline, baselineRefusal } from \"./continuity.js\";\n \n export class McpPreflightRefused extends Error {\n   constructor(stage, why, detail) { super(\"MCP preflight refused \" + stage + \": \" + why); this.name = \"McpPreflightRefused\"; this.stage = stage; this.why = why; this.receipt = detail && detail.receipt || null; this.lock = detail && detail.lock || null; this.verification = detail && detail.verification || null; }\n@@ -45,6 +45,25 @@ export function mcpPreflight(cc, opts = {}) {\n   const CO = opts.continuity || null;\n   const keep = async function (rec) { state.continuity = rec; state.records.push(rec); if (state.records.length > 50) state.records.shift(); if (CO && typeof CO.onRecord === \"function\") { try { await CO.onRecord(rec); } catch (e) { } } return rec; };\n   const coOpts = function (extra) { return Object.assign({ mode: CO.mode, policy: CO.policy, exceptions: CO.exceptions, server: state.url }, extra || {}); };\n+  // 1.13.0 signed baseline: the lockfile's signature is checked once, now, before anything is compared against it. Options\n+  // (in opts.continuity, or top level without continuity): operatorKeys, keyPolicy, publishedKids, trustedKids,\n+  // requireSignedBaseline. A bad or forged signature (or an unsigned lockfile when one is required) refuses the connect\n+  // outside observe; observe records baseline_untrusted and goes on.\n+  let baseLock = opts.lock || null, baseRefused = null;\n+  state.baseline = null;\n+  state.ready = !opts.lock ? Promise.resolve(null) : (async () => {\n+    const bo = Object.assign({}, opts, CO || {}), req = bo.requireSignedBaseline ?? !!(bo.operatorKeys && bo.operatorKeys.length);\n+    let b; try { b = await verifyLockBaseline(opts.lock, bo); } catch (e) { b = { trust: \"invalid\", signer: null, kid: null, why: \"the baseline could not be checked: \" + (e && e.message || e), parts_used: false, lock: opts.lock }; }\n+    state.baseline = { trust: b.trust, signer: b.signer, kid: b.kid, why: b.why, parts_used: b.parts_used }; baseLock = b.lock || opts.lock;\n+    const bad = baselineRefusal(b, req);\n+    if (bad && CO) {\n+      const rec = await keep(await continuityFailure(\"baseline_untrusted\", coOpts({ detail: String(bad).slice(0, 300) })));\n+      if (rec.outcome !== \"proceed\") baseRefused = new McpPreflightRefused(\"connect\", rec.why.join(\"; \") + \": \" + bad, { lock: rec });\n+    } else if (bad) baseRefused = new McpPreflightRefused(\"connect\", \"the approved lockfile is not trusted: \" + bad);\n+    return state.baseline;\n+  })();\n+  state.ready.catch(function () { });\n+  const baseOk = async function () { await state.ready; if (baseRefused) throw baseRefused; };\n   const fresh = function () {\n     if (!state.receipt) return false;\n     const exp = Date.parse(state.receipt.expires_at || \"\");\n@@ -76,6 +95,7 @@ export function mcpPreflight(cc, opts = {}) {\n     state,\n     /** Before initialize. url: the server URL (a stdio/local server has none and is not decided; pass opts.local = \"allow\" | \"refuse\", default allow). */\n     async beforeConnect(url) {\n+      await baseOk();\n       if (!url) { if (opts.local === \"refuse\") throw new McpPreflightRefused(\"connect\", \"a local (stdio) server cannot be resolved and opts.local is refuse\"); state.url = null; state.host = null; return { local: true, receipt: null }; }\n       const host = hostOf(url); if (!host) throw new McpPreflightRefused(\"connect\", \"not a server URL: \" + url);\n       state.url = url; state.host = host;\n@@ -84,8 +104,9 @@ export function mcpPreflight(cc, opts = {}) {\n     },\n     /** After initialize, with the tools the server lists. Refuses (and the wrapper closes the client) when they differ from the approved lockfile. */\n     async afterConnect(tools, meta) {\n+      await baseOk();\n       if (CO && opts.lock) {   // 1.11.0: classify, apply the operator's policy, keep the record\n-        const rec = await keep(await continuityCheck(opts.lock, tools, coOpts({ complete: !(meta && meta.nextCursor) })));\n+        const rec = await keep(await continuityCheck(baseLock, tools, coOpts({ complete: !(meta && meta.nextCursor), baselineTrust: state.baseline && state.baseline.trust })));\n         state.lockCheck = rec; state.approved = null; state.pausedTools = new Set(rec.paused_tools);\n         if (rec.outcome === \"deny\") throw new McpPreflightRefused(\"connect\", rec.why.join(\"; \"), { lock: rec, receipt: state.receipt });\n         if (rec.outcome === \"pause\" || rec.outcome === \"refresh\") {\n@@ -96,13 +117,14 @@ export function mcpPreflight(cc, opts = {}) {\n         return rec;\n       }\n       if (!opts.lock) { state.approved = null; return null; }\n-      const lc = await checkLock(opts.lock, tools || []);\n+      const lc = await checkLock(baseLock, tools || []);\n       state.lockCheck = lc; state.approved = new Set((opts.lock.tools || []).map(function (t) { return t.name; }));\n       if (lc.decision !== \"connect\") throw new McpPreflightRefused(\"connect\", \"the server's tools differ from the approved lockfile (added \" + lc.added.length + \", removed \" + lc.removed.length + \", modified \" + lc.modified.length + \")\", { lock: lc });\n       return lc;\n     },\n     /** Before tools/call. */\n     async beforeToolCall(name, annotations, tool) {\n+      await baseOk();\n       if (state.host && !fresh()) await decide(state.host);\n       if (state.pausedTools && state.pausedTools.has(name)) {   // 1.11.0: a changed or new tool waits for a person; the others stay usable\n         let ok = false; if (opts.confirm) { try { ok = (await opts.confirm(Object.assign({}, state.receipt || {}, { tool: name, continuity: state.continuity }))) === true; } catch (e) { ok = false; } }"},{"sha":"5539e56e276339859a69c3d5a05428cf69f39ad2","filename":"sdk/test/baseline.test.js","status":"added","additions":93,"deletions":0,"changes":93,"blob_url":"https://github.com/emmanuelorta/crawlcheck-core/blob/c634f497bd5873c2b2bd9f3ca9a26b188e08ac2a/sdk%2Ftest%2Fbaseline.test.js","raw_url":"https://github.com/emmanuelorta/crawlcheck-core/raw/c634f497bd5873c2b2bd9f3ca9a26b188e08ac2a/sdk%2Ftest%2Fbaseline.test.js","contents_url":"https://api.github.com/repos/emmanuelorta/crawlcheck-core/contents/sdk%2Ftest%2Fbaseline.test.js?ref=c634f497bd5873c2b2bd9f3ca9a26b188e08ac2a","patch":"@@ -0,0 +1,93 @@\n+// Signed baseline (1.13.0): the lockfile's signature is checked once, when a gate is created, before anything is compared\n+// against it. The cases are in the shared golden file (baseline_cases); the Python SDK must reproduce each one exactly.\n+import test from \"node:test\"; import assert from \"node:assert/strict\";\n+import fs from \"node:fs\";\n+import { verifyLockBaseline, signLock, newOperatorKey, keyPolicyFrom, continuityGate, openContinuityGate, ContinuityRefused, withPreflight, McpPreflightRefused, CONTINUITY_FAILURE_CLASSES, CONTINUITY_DEFAULT_POLICY, canon } from \"../dist/index.js\";\n+const G = JSON.parse(fs.readFileSync(new URL(\"./fixtures/continuity.json\", import.meta.url), \"utf8\"));\n+const keyDir = G.key_directory;\n+const sha = async (s) => Buffer.from(await crypto.subtle.digest(\"SHA-256\", new TextEncoder().encode(s))).toString(\"hex\");\n+const B = (n) => G.baseline_cases.find((c) => c.name === n);\n+const quiet = { log: false };\n+const opts = async (o) => { const x = Object.assign({}, o); if (x.keyPolicyDirectory) { delete x.keyPolicyDirectory; x.keyPolicy = await keyPolicyFrom(keyDir); } return x; };\n+\n+for (const c of G.baseline_cases) test(\"golden baseline: \" + c.name, async () => {\n+  const r = await verifyLockBaseline(c.lock, await opts(c.opts)); const { lock, ...rest } = r;\n+  assert.deepEqual(rest, c.expect); assert.equal(await sha(canon(lock)), c.used_sha256);\n+});\n+test(\"golden: signLock is deterministic and matches the fixture\", async () => {\n+  assert.deepEqual(await signLock(G.lock, G.operator.privateKey), G.operator.signed_lock);\n+});\n+test(\"baseline_untrusted is the 14th failure class, deny by default, and an integrity class\", async () => {\n+  assert.equal(CONTINUITY_FAILURE_CLASSES.length, 14); assert.equal(CONTINUITY_FAILURE_CLASSES[13], \"baseline_untrusted\");\n+  assert.equal(CONTINUITY_DEFAULT_POLICY.effects.baseline_untrusted, \"deny\");\n+  for (const m of [\"review\", \"enforce\"]) assert.equal(G.failures.find((f) => f.cls === \"baseline_untrusted\" && f.opts.mode === m).expect.outcome, \"deny\");\n+  assert.equal(G.failures.find((f) => f.cls === \"baseline_untrusted\" && f.opts.mode === \"observe\").expect.outcome, \"proceed\");\n+});\n+\n+test(\"gate, enforce: a lockfile edited after CrawlCheck signed it fails at startup\", async () => {\n+  const L = B(\"edited_after_signing\").lock;\n+  await assert.rejects(() => openContinuityGate(L, Object.assign({ mode: \"enforce\" }, quiet)), (e) => e instanceof ContinuityRefused && /baseline_untrusted|not trusted/.test(e.message) && e.record.events[0].class === \"baseline_untrusted\");\n+  const g = continuityGate(L, Object.assign({ mode: \"enforce\" }, quiet)); await g.ready;\n+  assert.equal(g.baseline.trust, \"invalid\"); assert.equal(g.records.length, 1);\n+  await assert.rejects(() => g.check(G.tools_v1), ContinuityRefused);\n+});\n+test(\"gate, enforce: a lockfile re-signed with a foreign key fails at startup\", async () => {\n+  await assert.rejects(() => openContinuityGate(B(\"forged_foreign_key\").lock, Object.assign({ mode: \"enforce\" }, quiet)), /not a CrawlCheck key/);\n+});\n+test(\"gate, observe: an untrusted baseline is recorded and passes\", async () => {\n+  const g = await openContinuityGate(B(\"edited_after_signing\").lock, Object.assign({ mode: \"observe\" }, quiet));\n+  assert.equal(g.records[0].events[0].class, \"baseline_untrusted\"); assert.equal(g.records[0].outcome, \"proceed\");\n+  const r = await g.check([]); assert.equal(r.outcome, \"proceed\"); assert.equal(r.baseline.trust, \"invalid\");\n+});\n+test(\"gate: a CrawlCheck-signed lockfile is verified and named in every record\", async () => {\n+  const L = B(\"crawlcheck_signed\").lock;\n+  const g = await openContinuityGate(L, Object.assign({ mode: \"enforce\" }, quiet));\n+  assert.equal(g.baseline.trust, \"verified\"); assert.equal(g.records.length, 0);\n+  const r = await g.check([]); assert.equal(r.baseline.trust, \"verified\"); assert.equal(r.baseline.per_part, true);\n+});\n+test(\"gate: parts added after signing are not used for the comparison\", async () => {\n+  const g = await openContinuityGate(B(\"parts_added_after_signing\").lock, Object.assign({ mode: \"enforce\" }, quiet));\n+  assert.equal(g.baseline.trust, \"verified\"); assert.equal(g.baseline.parts_used, false);\n+  const r = await g.check([]); assert.equal(r.baseline.per_part, false);\n+});\n+test(\"gate: unsigned passes unless a signed baseline is required; operator keys require one by default\", async () => {\n+  const g = await openContinuityGate(G.lock, Object.assign({ mode: \"enforce\" }, quiet)); assert.equal(g.baseline.trust, \"unsigned\");\n+  await assert.rejects(() => openContinuityGate(G.lock, Object.assign({ mode: \"enforce\", requireSignedBaseline: true }, quiet)), /unsigned and a signed one is required/);\n+  await assert.rejects(() => openContinuityGate(G.lock, Object.assign({ mode: \"enforce\", operatorKeys: [G.operator.publicKey] }, quiet)), /unsigned/);\n+  await openContinuityGate(G.lock, Object.assign({ mode: \"enforce\", operatorKeys: [G.operator.publicKey], requireSignedBaseline: false }, quiet));\n+});\n+test(\"gate: an operator-signed lockfile with the operator key is operator_signed; with another key it is refused\", async () => {\n+  const g = await openContinuityGate(G.operator.signed_lock, Object.assign({ mode: \"enforce\", operatorKeys: [G.operator.publicKey] }, quiet));\n+  assert.equal(g.baseline.trust, \"operator_signed\"); const r = await g.check(G.tools_v1); assert.equal(r.outcome, \"proceed\"); assert.equal(r.baseline.trust, \"operator_signed\");\n+  await assert.rejects(() => openContinuityGate(G.operator.signed_lock, Object.assign({ mode: \"enforce\", operatorKeys: [G.operator.other_publicKey] }, quiet)), /not one of the operator keys/);\n+});\n+test(\"gate: an attacker who edits the operator-signed baseline to approve a new tool is refused at startup\", async () => {\n+  const L = structuredClone(G.operator.signed_lock); L.tools.push({ name: \"export\", sha256: \"e\".repeat(64) });\n+  await assert.rejects(() => openContinuityGate(L, Object.assign({ mode: \"enforce\", operatorKeys: [G.operator.publicKey] }, quiet)), /changed after the operator signed it/);\n+  const R = structuredClone(L); delete R.operator_signature;   // stripping the signature instead: unsigned, refused because a key is configured\n+  await assert.rejects(() => openContinuityGate(R, Object.assign({ mode: \"enforce\", operatorKeys: [G.operator.publicKey] }, quiet)), /unsigned/);\n+});\n+test(\"verified at startup, not per call: check() does not verify again\", async () => {\n+  let calls = 0; const g = continuityGate(B(\"crawlcheck_signed\").lock, Object.assign({ mode: \"enforce\" }, quiet)); await g.ready;\n+  const orig = crypto.subtle.verify; crypto.subtle.verify = async (...a) => { calls++; return orig.apply(crypto.subtle, a); };\n+  try { for (let i = 0; i < 3; i++) await g.check([]); } finally { crypto.subtle.verify = orig; }\n+  assert.equal(calls, 0);\n+});\n+test(\"newOperatorKey + signLock round trip\", async () => {\n+  const k = await newOperatorKey(); const s = await signLock(G.lock, k.privateKey);\n+  assert.equal((await verifyLockBaseline(s, { operatorKeys: [k.publicKey] })).trust, \"operator_signed\");\n+  assert.equal(s.operator_signature.kid, k.kid);\n+});\n+function cc() { return { async guard(host, action) { return { proceed: true, receipt: { kind: \"crawlcheck-decision\", decision: \"allow\", expires_at: new Date(Date.now() + 3600e3).toISOString() }, verification: { verified: true }, why: [] }; } }; }\n+test(\"withPreflight: an untrusted baseline refuses the connect before a byte is sent\", async () => {\n+  const sent = []; const c = { async connect() { sent.push(\"initialize\"); }, async listTools() { return { tools: G.tools_v1 }; }, async callTool() { sent.push(\"call\"); } };\n+  withPreflight(c, cc(), { lock: B(\"edited_after_signing\").lock, continuity: { mode: \"enforce\" } });\n+  await assert.rejects(() => c.connect({ url: \"https://mcp.example.com/mcp\" }), (e) => e instanceof McpPreflightRefused && /baseline/.test(e.message));\n+  assert.deepEqual(sent, []);\n+  const c2 = { async connect() { sent.push(\"initialize\"); }, async listTools() { return { tools: G.tools_v1 }; }, async callTool() { } };\n+  withPreflight(c2, cc(), { lock: B(\"forged_foreign_key\").lock });   // without continuity too\n+  await assert.rejects(() => c2.connect({ url: \"https://mcp.example.com/mcp\" }), /lockfile is not trusted/);\n+  const c3 = { async connect() { sent.push(\"initialize\"); }, async listTools() { return { tools: G.tools_v1 }; }, async callTool() { } };\n+  withPreflight(c3, cc(), { lock: G.operator.signed_lock, continuity: { mode: \"enforce\", operatorKeys: [G.operator.publicKey] }, toolReceipts: \"none\" });\n+  await c3.connect({ url: \"https://mcp.example.com/mcp\" }); assert.equal(c3.preflight.state.baseline.trust, \"operator_signed\");\n+});"},{"sha":"7db97e41d4f232feead3994cf3d6748149fa4e32","filename":"sdk/test/fixtures/continuity-gen.mjs","status":"modified","additions":54,"deletions":4,"changes":58,"blob_url":"https://github.com/emmanuelorta/crawlcheck-core/blob/c634f497bd5873c2b2bd9f3ca9a26b188e08ac2a/sdk%2Ftest%2Ffixtures%2Fcontinuity-gen.mjs","raw_url":"https://github.com/emmanuelorta/crawlcheck-core/raw/c634f497bd5873c2b2bd9f3ca9a26b188e08ac2a/sdk%2Ftest%2Ffixtures%2Fcontinuity-gen.mjs","contents_url":"https://api.github.com/repos/emmanuelorta/crawlcheck-core/contents/sdk%2Ftest%2Ffixtures%2Fcontinuity-gen.mjs?ref=c634f497bd5873c2b2bd9f3ca9a26b188e08ac2a","patch":"@@ -2,7 +2,9 @@\n // Both SDKs must reproduce every expected field, including record_sha256, byte for byte.\n import fs from \"node:fs\";\n import * as C from \"../../dist/continuity.js\";\n-import { lockFromTools } from \"../../dist/index.js\";\n+import { canon } from \"../../dist/verify.js\";\n+import { lockFromTools, keyPolicyFrom } from \"../../dist/index.js\";\n+const rd = (f) => JSON.parse(fs.readFileSync(new URL(\"./\" + f, import.meta.url), \"utf8\"));\n const NOW = Date.parse(\"2026-11-07T16:00:00Z\");\n const v1 = [\n   { name: \"search\", description: \"Search the catalogue.\", inputSchema: { type: \"object\", properties: { q: { type: \"string\" } }, required: [\"q\"] }, annotations: { readOnlyHint: true } },\n@@ -36,11 +38,58 @@ const cases = [\n   [\"review_mode_change\", lock, schemaChanged, { mode: \"review\" }],\n   [\"approved_exception\", lock, descChanged, { exceptions: [{ tool: \"search\", class: \"description_changed\", by: \"ops@example.com\", reason: \"vendor release 2.4 reviewed\", until: \"2026-12-01T00:00:00Z\" }] }],\n   [\"expired_exception\", lock, descChanged, { exceptions: [{ tool: \"search\", class: \"description_changed\", by: \"ops@example.com\", reason: \"old\", until: \"2026-11-01T00:00:00Z\" }] }],\n-  [\"operator_policy_blocks_additions\", lock, added, { policy: { id: \"acme-strict\", effects: { tool_added: \"deny\" } } }]\n+  [\"operator_policy_blocks_additions\", lock, added, { policy: { id: \"acme-strict\", effects: { tool_added: \"deny\" } } }],\n+  [\"baseline_trust_named\", lock, v1, { baselineTrust: \"operator_signed\" }]\n ].map(([name, L, tools, o]) => ({ name, lock: L, tools, opts: Object.assign({ now: NOW, server: S }, o) }));\n for (const c of cases) c.expect = await C.continuityCheck(c.lock, c.tools, c.opts);\n const failures = [];\n for (const cls of C.CONTINUITY_FAILURE_CLASSES) for (const mode of [\"observe\", \"review\", \"enforce\"]) { const o = { now: NOW, server: S, mode }; failures.push({ cls, opts: o, expect: await C.continuityFailure(cls, o) }); }\n+// 1.13.0 signed baseline. Real CrawlCheck-signed lockfiles (GET /api/v1/mcp/lock?url=https://crawlcheck.io/mcp on 2026-11-07,\n+// one before and one after the signed lockfile gained parts), the key directory read the same day, and a TEST operator key\n+// derived from a public seed (never use it for anything real).\n+const signed = rd(\"lock-signed.json\"), signedNoParts = rd(\"lock-signed-noparts.json\"), keyDir = rd(\"key-directory-20261107.json\");\n+const b64e = (u8) => Buffer.from(u8).toString(\"base64url\");\n+const seedKey = async (label) => {\n+  const seed = new Uint8Array(await crypto.subtle.digest(\"SHA-256\", new TextEncoder().encode(label)));\n+  const pk = await crypto.subtle.importKey(\"pkcs8\", Buffer.concat([Buffer.from(\"302e020100300506032b657004220420\", \"hex\"), Buffer.from(seed)]), { name: \"Ed25519\" }, true, [\"sign\"]);\n+  const j = await crypto.subtle.exportKey(\"jwk\", pk); return { seed_hex: Buffer.from(seed).toString(\"hex\"), privateKey: { kty: \"OKP\", crv: \"Ed25519\", x: j.x, d: j.d }, publicKey: { kty: \"OKP\", crv: \"Ed25519\", x: j.x }, key: pk };\n+};\n+const opKey = await seedKey(\"crawlcheck continuity fixture: TEST operator key, public, never use\"), otherKey = await seedKey(\"crawlcheck continuity fixture: TEST other operator key\"), forger = await seedKey(\"crawlcheck continuity fixture: TEST forger key\");\n+const sha = async (s) => Buffer.from(await crypto.subtle.digest(\"SHA-256\", new TextEncoder().encode(s))).toString(\"hex\");\n+const forged = clone(signed); forged.tools[0].sha256 = \"f\".repeat(64);\n+{ const body = {}; for (const k of Object.keys(forged)) if (k !== \"sha256\" && k !== \"signature\") body[k] = forged[k];\n+  const d = await sha(canon(body)), msg = \"crawlcheck-data-v1\\n\" + d, kid = b64e(new Uint8Array(await crypto.subtle.digest(\"SHA-256\", new TextEncoder().encode(JSON.stringify({ crv: \"Ed25519\", kty: \"OKP\", x: forger.publicKey.x })))));\n+  forged.sha256 = d; forged.signature = Object.assign({}, forged.signature, { kid, message: msg, sig: b64e(new Uint8Array(await crypto.subtle.sign({ name: \"Ed25519\" }, forger.key, new TextEncoder().encode(msg)))), key: Object.assign({}, forged.signature.key, { kid, jwk: forger.publicKey }) }); }\n+const opSigned = await C.signLock(lock, opKey.privateKey), opOverCc = await C.signLock(signed, opKey.privateKey);\n+const edited = (L, f) => { const x = clone(L); f(x); return x; };\n+const OK = [opKey.publicKey];\n+const baselines = [\n+  [\"crawlcheck_signed\", signed, {}],\n+  [\"crawlcheck_signed_key_policy\", signed, { keyPolicyDirectory: true }],\n+  [\"crawlcheck_signed_other_trusted_kids\", signed, { trustedKids: [\"not-a-crawlcheck-key\"] }],\n+  [\"edited_after_signing\", edited(signed, (x) => { x.tools[0].sha256 = \"0\".repeat(64); }), {}],\n+  [\"parts_edited_after_signing\", edited(signed, (x) => { x.parts[Object.keys(x.parts)[0]].description_sha256 = \"0\".repeat(64); }), {}],\n+  [\"parts_added_after_signing\", Object.assign(clone(signedNoParts), { parts: { best_source: { description_sha256: \"0\".repeat(64), schema_sha256: \"0\".repeat(64), annotations_sha256: \"0\".repeat(64) } } }), {}],\n+  [\"forged_foreign_key\", forged, {}],\n+  [\"foreign_scheme\", Object.assign(clone(lock), { signature: { kid: \"x\", message: \"something-else\\n00\", sig: \"AA\" } }), {}],\n+  [\"operator_signed\", opSigned, { operatorKeys: OK }],\n+  [\"operator_signed_key_as_x\", opSigned, { operatorKeys: [opKey.publicKey.x] }],\n+  [\"operator_wrong_key\", opSigned, { operatorKeys: [otherKey.publicKey] }],\n+  [\"operator_edited_after_signing\", edited(opSigned, (x) => { x.tools.pop(); }), { operatorKeys: OK }],\n+  [\"operator_bad_signature\", edited(opSigned, (x) => { x.operator_signature.sig = opOverCc.operator_signature.sig; }), { operatorKeys: OK }],\n+  [\"operator_no_key_given\", opSigned, {}],\n+  [\"operator_over_crawlcheck_no_key_given\", opOverCc, {}],\n+  [\"operator_over_crawlcheck\", opOverCc, { operatorKeys: OK }],\n+  [\"unsigned\", lock, {}],\n+  [\"not_a_lockfile\", { tools_sha256: \"x\" }, {}]\n+];\n+const baselineCases = [];\n+for (const [name, L, o] of baselines) {\n+  const oo = Object.assign({}, o); if (oo.keyPolicyDirectory) { delete oo.keyPolicyDirectory; oo.keyPolicy = await keyPolicyFrom(keyDir); }\n+  const r = await C.verifyLockBaseline(L, oo); const { lock: used, ...expect } = r;\n+  baselineCases.push({ name, lock: L, opts: o, expect, used_sha256: await sha(canon(used)) });\n+}\n+const operator = { warning: \"TEST KEY derived from a public seed. Never use it for anything real.\", seed_hex: opKey.seed_hex, privateKey: opKey.privateKey, publicKey: opKey.publicKey, other_publicKey: otherKey.publicKey, signed_lock: opSigned };\n // acceptance: the split for one receipt\n const F = { kind_ok: true, domain_matches: true, action_matches: true, times_present: true, not_expired: true, not_future: true, lifetime_ok: true, decision_known: true, resolve_bound: true };\n const V = { integrity_valid: true, issuer_trusted: true, key_policy_valid: true, unavailable: [] };\n@@ -63,6 +112,7 @@ const acc = [\n   [\"baseline_changed_in_receipt\", R(\"allow\", { assessed: { expected_tools_sha256: \"b\".repeat(64), tools_sha256: \"c\".repeat(64), matches: false } }), V, F, {}],\n   [\"partial_assessment\", R(\"allow\", { resolve: { sha256: \"a\".repeat(64), status: \"partial\" } }), Object.assign({}, V, { unavailable: [\"ots_attestations\"] }), F, {}]\n ].map(([name, receipt, verification, fields, opts]) => ({ name, receipt, verification, scope: { fields }, opts, expect: C.acceptanceOf(receipt, verification, { fields }, opts) }));\n-const out = { v: 1, generated_by: \"sdk/test/fixtures/continuity-gen.mjs\", now: NOW, default_policy_sha256: (await C.continuityPolicy()).sha256, lock, tools_v1: v1, cases, failures, acceptance: acc };\n+const out = { v: 1, generated_by: \"sdk/test/fixtures/continuity-gen.mjs\", now: NOW, default_policy_sha256: (await C.continuityPolicy()).sha256, lock, tools_v1: v1, cases, failures, acceptance: acc, baseline_cases: baselineCases, operator, key_directory: keyDir };\n fs.writeFileSync(new URL(\"./continuity.json\", import.meta.url), JSON.stringify(out, null, 1) + \"\\n\");\n-console.log(\"cases\", cases.length, \"failures\", failures.length, \"acceptance\", acc.length);\n+console.log(\"cases\", cases.length, \"failures\", failures.length, \"acceptance\", acc.length, \"baseline\", baselineCases.length);\n+for (const b of baselineCases) console.log(\" \", b.name.padEnd(40), b.expect.trust.padEnd(16), b.expect.why.slice(0, 90));"},{"sha":"1da5570142d594601e0f2fffaf8044dbbd0f13b9","filename":"sdk/test/fixtures/continuity.json","status":"modified","additions":5451,"deletions":131,"changes":5582,"blob_url":"https://github.com/emmanuelorta/crawlcheck-core/blob/c634f497bd5873c2b2bd9f3ca9a26b188e08ac2a/sdk%2Ftest%2Ffixtures%2Fcontinuity.json","raw_url":"https://github.com/emmanuelorta
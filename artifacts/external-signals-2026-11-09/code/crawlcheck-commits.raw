github.com/users/claude/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"claude","id":81847,"node_id":"MDQ6VXNlcjgxODQ3","avatar_url":"https://avatars.githubusercontent.com/u/81847?v=4","gravatar_id":"","url":"https://api.github.com/users/claude","html_url":"https://github.com/claude","followers_url":"https://api.github.com/users/claude/followers","following_url":"https://api.github.com/users/claude/following{/other_user}","gists_url":"https://api.github.com/users/claude/gists{/gist_id}","starred_url":"https://api.github.com/users/claude/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/claude/subscriptions","organizations_url":"https://api.github.com/users/claude/orgs","repos_url":"https://api.github.com/users/claude/repos","events_url":"https://api.github.com/users/claude/events{/privacy}","received_events_url":"https://api.github.com/users/claude/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"64189c0b4dafe00eaefdfa442d614683b66c0189","url":"https://api.github.com/repos/emmanuelorta/crawlcheck-core/commits/64189c0b4dafe00eaefdfa442d614683b66c0189","html_url":"https://github.com/emmanuelorta/crawlcheck-core/commit/64189c0b4dafe00eaefdfa442d614683b66c0189"}]},{"sha":"64189c0b4dafe00eaefdfa442d614683b66c0189","node_id":"C_kwDOUMx3jtoAKDY0MTg5YzBiNGRhZmUwMGVhZWZkZmE0NDJkNjE0NjgzYjY2YzAxODk","commit":{"author":{"name":"Claude","email":"noreply@anthropic.com","date":"2026-11-07T15:25:23Z"},"committer":{"name":"Claude","email":"noreply@anthropic.com","date":"2026-11-07T15:25:23Z"},"message":"SDK 1.11.0 (JS) / 1.12.0 (Python): acceptance split and tool-interface continuity\n\nguard() returns acceptance: integrity, issuer, key policy, freshness, subject,\noperation, replay, baseline, completeness, policy_source, evidence_level and\npolicy_result (proceed | pause | deny), so signature-valid is never read as\nsafe-to-proceed. continuityCheck/continuity_check classify tool changes\n(description, schema, annotations, added, removed) against a lockfile with\nper-part hashes, apply the operator's policy in observe, review or enforce\nmode, and return a hashed record. Twelve failure states are pinned; a shared\ngolden file makes both SDKs reproduce every record byte for byte.\n\nCo-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>\nClaude-Session: https://claude.ai/code/session_01VJdbLNJj6mqbaamz9u9jtj","tree":{"sha":"8566e258a4d4fa70b4308c12c24bd00af4c1c3dc","url":"https://api.github.com/repos/emmanuelorta/crawlcheck-core/git/trees/8566e258a4d4fa70b4308c12c24bd00af4c1c3dc"},"url":"https://api.github.com/repos/emmanuelorta/crawlcheck-core/git/commits/64189c0b4dafe00eaefdfa442d614683b66c0189","comment_count":0,"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN SSH SIGNATURE-----\nU1NIU0lHAAAAAQAAADMAAAALc3NoLWVkMjU1MTkAAAAgrLzsfFISF4by8Q+FKz27YpkK1USsBB+m\namu1QkJnbDsAAAADZ2l0AAAAAAAAAAZzaGE1MTIAAABTAAAAC3NzaC1lZDI1NTE5AAAAQFvStJDK\nJ3yrplDrlhrvsh7WpjK5PA5qfxasWI+ur13Chi6cJnJpoyk5qfa4yF7/ELI1VPJOLYtxduX2Ib1f\nMA8=\n-----END SSH SIGNATURE-----","payload":"tree 8566e258a4d4fa70b4308c12c24bd00af4c1c3dc\nparent b175ee142de94e694755f0af668a5c714a52bdd8\nauthor Claude <noreply@anthropic.com> 1794065123 -0700\ncommitter Claude <noreply@anthropic.com> 1794065123 -0700\n\nSDK 1.11.0 (JS) / 1.12.0 (Python): acceptance split and tool-interface continuity\n\nguard() returns acceptance: integrity, issuer, key policy, freshness, subject,\noperation, replay, baseline, completeness, policy_source, evidence_level and\npolicy_result (proceed | pause | deny), so signature-valid is never read as\nsafe-to-proceed. continuityCheck/continuity_check classify tool changes\n(description, schema, annotations, added, removed) against a lockfile with\nper-part hashes, apply the operator's policy in observe, review or enforce\nmode, and return a hashed record. Twelve failure states are pinned; a shared\ngolden file makes both SDKs reproduce every record byte for byte.\n\nCo-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>\nClaude-Session: https://claude.ai/code/session_01VJdbLNJj6mqbaamz9u9jtj\n","verified_at":"2026-11-07T15:25:25Z"}},"url":"https://api.github.com/repos/emmanuelorta/crawlcheck-core/commits/64189c0b4dafe00eaefdfa442d614683b66c0189","html_url":"https://github.com/emmanuelorta/crawlcheck-core/commit/64189c0b4dafe00eaefdfa442d614683b66c0189","comments_url":"https://api.github.com/repos/emmanuelorta/crawlcheck-core/commits/64189c0b4dafe00eaefdfa442d614683b66c0189/comments","author":{"login":"claude","id":81847,"node_id":"MDQ6VXNlcjgxODQ3","avatar_url":"https://avatars.githubusercontent.com/u/81847?v=4","gravatar_id":"","url":"https://api.github.com/users/claude","html_url":"https://github.com/claude","followers_url":"https://api.github.com/users/claude/followers","following_url":"https://api.github.com/users/claude/following{/other_user}","gists_url":"https://api.github.com/users/claude/gists{/gist_id}","starred_url":"https://api.github.com/users/claude/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/claude/subscriptions","organizations_url":"https://api.github.com/users/claude/orgs","repos_url":"https://api.github.com/users/claude/repos","events_url":"https://api.github.com/users/claude/events{/privacy}","received_events_url":"https://api.github.com/users/claude/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"claude","id":81847,"node_id":"MDQ6VXNlcjgxODQ3","avatar_url":"https://avatars.githubusercontent.com/u/81847?v=4","gravatar_id":"","url":"https://api.github.com/users/claude","html_url":"https://github.com/claude","followers_url":"https://api.github.com/users/claude/followers","following_url":"https://api.github.com/users/claude/following{/other_user}","gists_url":"https://api.github.com/users/claude/gists{/gist_id}","starred_url":"https://api.github.com/users/claude/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/claude/subscriptions","organizations_url":"https://api.github.com/users/claude/orgs","repos_url":"https://api.github.com/users/claude/repos","events_url":"https://api.github.com/users/claude/events{/privacy}","received_events_url":"https://api.github.com/users/claude/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"b175ee142de94e694755f0af668a5c714a52bdd8","url":"https://api.github.com/repos/emmanuelorta/crawlcheck-core/commits/b175ee142de94e694755f0af668a5c714a52bdd8","html_url":"https://github.com/emmanuelorta/crawlcheck-core/commit/b175ee142de94e694755f0af668a5c714a52bdd8"}]}]
[{"sha":"dd4e97c882d7fd7d7f9fd871e0db1dfb7bf34a7f","node_id":"C_kwDOS3Cu2doAKGRkNGU5N2M4ODJkN2ZkN2Q3ZjlmZDg3MWUwZGIxZGZiN2JmMzRhN2Y","commit":{"author":{"name":"mikeypetrillo","email":"22065635+MikeyPetrillo@users.noreply.github.com","date":"2026-09-29T06:32:52Z"},"committer":{"name":"mikeypetrillo","email":"22065635+MikeyPetrillo@users.noreply.github.com","date":"2026-09-29T06:32:52Z"},"message":"[test] Block windows and ledger dates read from block timestamps\n\nThe leaderboard window, its seller-funding windows and the revenue\nledger's new-cursor start and undated-row dates assumed 2 s Base blocks.\nThey are now found by block timestamp (src/block-clock.js), so they\nstay correct when the block time changes and across the change.\n\nCo-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>","tree":{"sha":"cf6135aab276e0a7653b69f615bf4d2e7144431a","url":"https://api.github.com/repos/MikeyPetrillo/Agent402/git/trees/cf6135aab276e0a7653b69f615bf4d2e7144431a"},"url":"https://api.github.com/repos/MikeyPetrillo/Agent402/git/commits/dd4e97c882d7fd7d7f9fd871e0db1dfb7bf34a7f","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/MikeyPetrillo/Agent402/commits/dd4e97c882d7fd7d7f9fd871e0db1dfb7bf34a7f","html_url":"https://github.com/MikeyPetrillo/Agent402/commit/dd4e97c882d7fd7d7f9fd871e0db1dfb7bf34a7f","comments_url":"https://api.github.com/repos/MikeyPetrillo/Agent402/commits/dd4e97c882d7fd7d7f9fd871e0db1dfb7bf34a7f/comments","author":{"login":"MikeyPetrillo","id":22065635,"node_id":"MDQ6VXNlcjIyMDY1NjM1","avatar_url":"https://avatars.githubusercontent.com/u/22065635?v=4","gravatar_id":"","url":"https://api.github.com/users/MikeyPetrillo","html_url":"https://github.com/MikeyPetrillo","followers_url":"https://api.github.com/users/MikeyPetrillo/followers","following_url":"https://api.github.com/users/MikeyPetrillo/following{/other_user}","gists_url":"https://api.github.c
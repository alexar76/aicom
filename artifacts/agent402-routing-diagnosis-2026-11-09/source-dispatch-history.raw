rl":"https://github.com/MikeyPetrillo/Agent402/commit/d6821220fff7591bda81037befb55bc96db49cf6"}]},{"sha":"63658d19b50dd1d628ce6b3c23ac89be268f113a","node_id":"C_kwDOS3Cu2doAKDYzNjU4ZDE5YjUwZGQxZDYyOGNlNmIzYzIzYWM4OWJlMjY4ZjExM2E","commit":{"author":{"name":"mikeypetrillo","email":"22065635+MikeyPetrillo@users.noreply.github.com","date":"2026-10-29T03:22:11Z"},"committer":{"name":"mikeypetrillo","email":"22065635+MikeyPetrillo@users.noreply.github.com","date":"2026-10-29T03:22:11Z"},"message":"[test] Dispatch legend reports settlementNetting; history legend widened\n\nThe dispatch legend on /api/index, the seller detail and /api/route carries\nsettlementNetting: \"on\" or \"off\", read from the seller-funding switch (env\nor operator), and the self-funded reason says it is given only while that\nis on. The seller detail's historyLegend now describes every write of a 1:\na parsed manifest or a route list read from OpenAPI, agents.json or\nllms.txt. CLAUDE.md says the meter markup lives in the private table and is\nnot printed, rather than that it is secret.\n\nCo-Authored-By: Claude Fable 5.1 <noreply@anthropic.com>\nClaude-Session: https://claude.ai/code/session_01MJsJ3ZoEbJJk6ft8CPDQAS","tree":{"sha":"9490969c64d7de03965ab79b20b540f446c308c0","url":"https://api.github.com/repos/MikeyPetrillo/Agent402/git/trees/9490969c64d7de03965ab79b20b540f446c308c0"},"url":"https://api.github.com/repos/MikeyPetrillo/Agent402/git/commits/63658d19b50dd1d628ce6b3c23ac89be268f113a","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/MikeyPetrillo/Agent402/commits/63658d19b50dd1d628ce6b3c23ac89be268f113a","html_url":"https://github.com/MikeyPetrillo/Agent402/commit/63658d19b50dd1d628ce6b3c23ac89be268f113a","comments_url":"https://api.github.com/repos/MikeyPetrillo/Agent402/commits/63658d19b50dd1d628ce6b3c23ac89be268f113a/comments","author":{"login":"MikeyPetrillo","id":22065635,"node_id":"MDQ6VXNlcjIyMDY1NjM1","avatar_url":"https://avatars.githubusercontent.com/u/22065635?v=4","gravatar_id":"","url":"https://api.github.com/users/MikeyPetrillo","html_url":"https://github.com/MikeyPetrillo","followers_url":"https://api.github.com/users/MikeyPetrillo/followers","following_url":"https://api.github.com/users/MikeyPetrillo/following{/other_user}","gists_url":"https://api.github.com/users/MikeyPetrillo/gists{/gist_id}","starred_url":"https://api.github.com/users/MikeyPetrillo/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/MikeyPetrillo/subscriptions","organizations_url":"https://api.github.com/users/MikeyPetrillo/orgs","repos_url":"https://api.github.com/users/MikeyPetrillo/repos","events_url":"https://api.github.com/users/MikeyPetrillo/events{/privacy}","received_events_url":"https://api.github.com/users/MikeyPetrillo/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"MikeyPetrillo","id":22065635,"node_id":"MDQ6VXNlcjIyMDY1NjM1","avatar_url":"https://avatars.githubusercontent.com/u/22065635?v=4","gravatar_id":"","url":"https://api.github.com/users/MikeyPetrillo","html_url":"https://github.com/MikeyPetrillo","followers_url":"https://api.github.com/users/MikeyPetrillo/followers","following_url":"https://api.github.com/users/MikeyPetrillo/following{/other_user}","gists_url":"https://api.github.com/users/MikeyPetrillo/gists{/gist_id}","starred_url":"https://api.github.com/users/MikeyPetrillo/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/MikeyPetrillo/subscriptions","organizations_url":"https://api.github.com/users/MikeyPetrillo/orgs","repos_url":"https://api.github.com/users/MikeyPetrillo/repos","events_url":"https://api.github.com/users/MikeyPetrillo/events{/privacy}","received_events_url":"https://api.github.com/users/MikeyPetrillo/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"b82a5851a9fbb5696ff17d4268a83c6c42984513","url":"https://api.github.com/repos/MikeyPetrillo/Agent402/commits/b82a5851a9fbb5696ff17d4268a83c6c42984513","html_url":"https://github.com/MikeyPetrillo/Agent402/commit/b82a5851a9fbb5696ff17d4268a83c6c42984513"}]},{"sha":"a077bb21a5e6bc5eb549021b5995b495b8fab8e2","node_id":"C_kwDOS3Cu2doAKGEwNzdiYjIxYTVlNmJjNWViNTQ5MDIxYjU5OTViNDk1YjhmYWI4ZTI","commit":{"author":{"name":"mikeypetrillo","email":"22065635+MikeyPetrillo@users.noreply.github.com","date":"2026-10-29T01:35:17Z"},"committer":{"name":"mikeypetrillo","email":"22065635+MikeyPetrillo@users.noreply.github.com","date":"2026-10-29T01:35:17Z"},"message":"[test] Advertise Algorand mainnet as its 32-character CAIP-2 id\n\nCAIP-2 limits a reference to 32 characters of [-_a-zA-Z0-9], and the\nAlgorand namespace profile takes the first 32 characters of the base64\ngenesis hash. The full-hash id this server advertised (44 characters,\ntrailing \"=\") fails a strict parser, and the Bazaar validator now parses\nevery accept with that grammar, so each 402 that offered Algorand was\ndropped from discovery.\n\nsrc/avm-network.js holds both spellings and the fold between them. Every\n402, rail, chain page, guide, manifest and package table now carries the\nCAIP-2 id, which the facilitator we settle through lists beside the old\none on /supported. A payment whose echoed accept still names the full\nhash is folded to the CAIP-2 id before the paywall (the same pre-paywall\ntranslation that renames a v1 price field: the Algorand signature covers\nthe transaction group, not that block, and the facilitator reads both\nspellings as one chain), so it matches, verifies and settles. Seller\nrows, the router's spending-chain map, the buyer's accept pin, the stats\nchain names, refund intake and the client's network preference read\neither spelling.\n\nTests: every offered id and every 402 accept is strict CAIP-2\n(test-rails, test-bazaar-contracts); a full-hash payment settles on the\nAlgorand rail against a stub facilitator and a non-alias id still never\nreaches it (test-x402-v1-accepts); a seller advertising the full hash is\nstill payable and routable (test-algorand-router); the known-assets\ncopies price both spellings alike (test-known-assets); a debt booked\nunder the full hash is still verified (test-refund-run-self-funding);\nthe client's algorand preference matches both (client/test.js).\n\nCo-Authored-By: Claude Fable 5.1 <noreply@anthropic.com>\nClaude-Session: https://claude.ai/code/session_01MJsJ3ZoEbJJk6ft8CPDQAS","tree":{"sha":"098a61f4780117501c3f8d8d9ff9a7f7d146e27c","url":"https://api.github.com/repos/MikeyPetrillo/Agent402/git/trees/098a61f4780117501c3f8d8d9ff9a7f7d146e27c"},"url":"https://api.github.com/repos/MikeyPetrillo/Agent402/git/commits/a077bb21a5e6bc5eb549021b5995b495b8fab8e2","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/MikeyPetrillo/Agent402/commits/a077bb21a5e6bc5eb549021b5995b495b8fab8e2","html_url":"https://github.com/MikeyPetrillo/Agent402/commit/a077bb21a5e6bc5eb549021b5995b495b8fab8e2","comments_url":"https://api.github.com/repos/MikeyPetrillo/Agent402/commits/a077bb21a5e6bc5eb549021b5995b495b8fab8e2/comments","author":{"login":"MikeyPetrillo","id":22065635,"node_id":"MDQ6VXNlcjIyMDY1NjM1","avatar_url":"https://avatars.githubusercontent.com/u/22065635?v=4","gravatar_id":"","url":"https://api.github.com/users/MikeyPetrillo","html_url":"https://github.com/MikeyPetrillo","followers_url":"https://api.github.com/users/MikeyPetrillo/followers","following_url":"https://api.github.com/users/MikeyPetrillo/following{/other_user}","gists_url":"https://api.github.com/users/MikeyPetrillo/gists{/gist_id}","starred_url":"https://api.github.com/users/MikeyPetrillo/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/MikeyPetrillo/subscriptions","organizations_url":"https://api.github.com/users/MikeyPetrillo/orgs","repos_url":"https://api.github.com/users/MikeyPetrillo/repos","events_url":"https://api.github.com/users/MikeyPetrillo/events{/privacy}","received_events_url":"https://api.github.com/users/MikeyPetrillo/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"MikeyPetrillo","id":22065635,"node_id":"MDQ6VXNlcjIyMDY1NjM1","avatar_url":"https://avatars.githubusercontent.com/u/22065635?v=4","gravatar_id":"","url":"https://api.github.com/users/MikeyPetrillo","html_url":"https://github.com/MikeyPetrillo","followers_url":"https://api.github.com/users/MikeyPetrillo/followers","following_url":"https://api.github.com/users/MikeyPetrillo/following{/other_user}","gists_url":"https://api.github.com/users/MikeyPetrillo/gists{/gist_id}","starred_url":"https://api.github.com/users/MikeyPetrillo/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/MikeyPetrillo/subscriptions","organizations_url":"https://api.github.com/users/MikeyPetrillo/orgs","repos_url":"https://api.github.com/users/MikeyPetrillo/repos","events_url":"https://api.github.com/users/MikeyPetrillo/events{/privacy}","received_events_url":"https://api.github.com/users/MikeyPetrillo/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"b5d9f2cd8d4e19dfcea7a75df6419c8e22d58fea","url":"https://api.github.com/repos/MikeyPetrillo/Agent402/commits/b5d9f2cd8d4e19dfcea7a75df6419c8e22d58fea","html_url":"https://github.com/MikeyPetrillo/Agent402/commit/b5d9f2cd8d4e19dfcea7a75df6419c8e22d58fea"}]}]
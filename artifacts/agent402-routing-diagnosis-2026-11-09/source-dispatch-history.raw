[{"sha":"c42bcfe00a7527aff4be8546cde8b1f20f699bab","node_id":"C_kwDOS3Cu2doAKGM0MmJjZmUwMGE3NTI3YWZmNGJlODU0NmNkZThiMWYyMGY2OTliYWI","commit":{"author":{"name":"mikeypetrillo","email":"22065635+MikeyPetrillo@users.noreply.github.com","date":"2026-11-09T00:45:50Z"},"committer":{"name":"mikeypetrillo","email":"22065635+MikeyPetrillo@users.noreply.github.com","date":"2026-11-09T00:47:59Z"},"message":"[test] Algorand sellers are paid only at the proof's address\n\nEvery Algorand router candidate now carries the address its settlement\nproof was counted at: the crawled payTo when our crawl saw the route,\nelse the receiving address the facilitator records for the route or its\nmerchant. The resolver and payX402 hold the live 402's payTo to it with\nan exact compare. A row with no address to bind, or whose crawl and\nfacilitator addresses disagree, is not dispatched and is counted by\nreason in the router's drop counts (algorandProofBinding).\n\nCo-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>","tree":{"sha":"c199c4b7128737e5f33671efcad8b27d975f431a","url":"https://api.github.com/repos/MikeyPetrillo/Agent402/git/trees/c199c4b7128737e5f33671efcad8b27d975f431a"},"url":"https://api.github.com/repos/MikeyPetrillo/Agent402/git/commits/c42bcfe00a7527aff4be8546cde8b1f20f699bab","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/MikeyPetrillo/Agent402/commits/c42bcfe00a7527aff4be8546cde8b1f20f699bab","html_url":"https://github.com/MikeyPetrillo/Agent402/commit/c42bcfe00a7527aff4be8546cde8b1f20f699bab","comments_url":"https://api.github.com/repos/MikeyPetrillo/Agent402/commits/c42bcfe00a7527aff4be8546cde8b1f20f699bab/comments","author":{"login":"MikeyPetrillo","id":22065635,"node_id":"MDQ6VXNlcjIyMDY1NjM1","avatar_url":"https://avatars.githubusercontent.com/u/22065635?v=4","gravatar_id":"","url":"https://api.github.com/users/MikeyPetrillo","html_url":"https://github.com/MikeyPetrillo","followers_url":"https://api.github.com/users/MikeyPetrillo/followers","following_url":"https://api.github.com/users/MikeyPetrillo/following{/other_user}","gists_url":"https://api.github.com/users/MikeyPetrillo/gists{/gist_id}","starred_url":"https://api.github.com/users/MikeyPetrillo/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/MikeyPetrillo/subscriptions","organizations_url":"https://api.github.com/users/MikeyPetrillo/orgs","repos_url":"https://api.github.com/users/MikeyPetrillo/repos","events_url":"https://api.github.com/users/MikeyPetrillo/events{/privacy}","received_events_url":"https://api.github.com/users/MikeyPetrillo/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"MikeyPetrillo","id":22065635,"node_id":"MDQ6VXNlcjIyMDY1NjM1","avatar_url":"https://avatars.githubusercontent.com/u/22065635?v=4","gravatar_id":"","url":"https://api.github.com/users/MikeyPetrillo","html_url":"https://github.com/MikeyPetrillo","followers_url":"https://api.github.com/users/MikeyPetrillo/followers","following_url":"https://api.github.com/users/MikeyPetrillo/following{/other_user}","gists_url":"https://api.github.com/users/MikeyPetrillo/gists{/gist_id}","starred_url":"https://api.github.com/users/MikeyPetrillo/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/MikeyPetrillo/subscriptions","organizations_url":"https://api.github.com/users/MikeyPetrillo/orgs","repos_url":"https://api.github.com/users/MikeyPetrillo/repos","events_url":"https://api.github.com/users/MikeyPetrillo/events{/privacy}","received_events_url":"https://api.github.com/users/MikeyPetrillo/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"f5b3f5692711bb6ddfa256b9f0cc9870772c4005","url":"https://api.github.com/repos/MikeyPetrillo/Agent402/commits/f5b3f5692711bb6ddfa256b9f0cc9870772c4005","html_url":"https://github.com/MikeyPetrillo/Agent402/commit/f5b3f5692711bb6ddfa256b9f0cc9870772c4005"}]},{"sha":"3a67f9d5f8b789e039f3c1db98995c58d0f3825c","node_id":"C_kwDOS3Cu2doAKDNhNjdmOWQ1ZjhiNzg5ZTAzOWYzYzFkYjk4OTk1YzU4ZDBmMzgyNWM","commit":{"author":{"name":"mikeypetrillo","email":"22065635+MikeyPetrillo@users.noreply.github.com","date":"2026-11-06T16:01:44Z"},"committer":{"name":"mikeypetrillo","email":"22065635+MikeyPetrillo@users.noreply.github.com","date":"2026-11-06T16:01:44Z"},"message":"[test] Router buys on listed EVM chains with Base's guards\n\nThe x402 buyer pays sellers on Arc, Celo, Polygon, Arbitrum and Robinhood\nfrom the same spending wallet, each chain read from one table (asset,\ndecimals, EIP-712 domain) and dispatched only while SOR_EVM_CHAINS lists it.\nEvery listed chain gets the domain check, split-price refusal, evidence\nwallets, capped validity, signed-amount assert, chain-truth refusal read,\nits own 24 h wallet ceiling and low-balance refusal; upstreamBuyerEvm\nreports one word per chain. The unproven tier stays Base only.\n\nCo-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>\nClaude-Session: https://claude.ai/code/session_01MJsJ3X7Eyba5aAYMD5CSsc","tree":{"sha":"e162b6e55bc0033602a16ea345b263342f36b77c","url":"https://api.github.com/repos/MikeyPetrillo/Agent402/git/trees/e162b6e55bc0033602a16ea345b263342f36b77c"},"url":"https://api.github.com/repos/MikeyPetrillo/Agent402/git/commits/3a67f9d5f8b789e039f3c1db98995c58d0f3825c","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/MikeyPetrillo/Agent402/commits/3a67f9d5f8b789e039f3c1db98995c58d0f3825c","html_url":"https://github.com/MikeyPetrillo/Agent402/commit/3a67f9d5f8b789e039f3c1db98995c58d0f3825c","comments_url":"https://api.github.com/repos/MikeyPetrillo/Agent402/commits/3a67f9d5f8b789e039f3c1db98995c58d0f3825c/comments","author":{"login":"MikeyPetrillo","id":22065635,"node_id":"MDQ6VXNlcjIyMDY1NjM1","avatar_url":"https://avatars.githubusercontent.com/u/22065635?v=4","gravatar_id":"","url":"https://api.github.com/users/MikeyPetrillo","html_url":"https://github.com/MikeyPetrillo","followers_url":"https://api.github.com/users/MikeyPetrillo/followers","following_url":"https://api.github.com/users/MikeyPetrillo/following{/other_user}","gists_url":"https://api.github.com/users/MikeyPetrillo/gists{/gist_id}","starred_url":"https://api.github.com/users/MikeyPetrillo/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/MikeyPetrillo/subscriptions","organizations_url":"https://api.github.com/users/MikeyPetrillo/orgs","repos_url":"https://api.github.com/users/MikeyPetrillo/repos","events_url":"https://api.github.com/users/MikeyPetrillo/events{/privacy}","received_events_url":"https://api.github.com/users/MikeyPetrillo/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"MikeyPetrillo","id":22065635,"node_id":"MDQ6VXNlcjIyMDY1NjM1","avatar_url":"https://avatars.githubusercontent.com/u/22065635?v=4","gravatar_id":"","url":"https://api.github.com/users/MikeyPetrillo","html_url":"https://github.com/MikeyPetrillo","followers_url":"https://api.github.com/users/MikeyPetrillo/followers","following_url":"https://api.github.com/users/MikeyPetrillo/following{/other_user}","gists_url":"https://api.github.com/users/MikeyPetrillo/gists{/gist_id}","starred_url":"https://api.github.com/users/MikeyPetrillo/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/MikeyPetrillo/subscriptions","organizations_url":"https://api.github.com/users/MikeyPetrillo/orgs","repos_url":"https://api.github.com/users/MikeyPetrillo/repos","events_url":"https://api.github.com/users/MikeyPetrillo/events{/privacy}","received_events_url":"https://api.github.com/users/MikeyPetrillo/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"b3eb480c894e174b38373db83b800d6cd8f561da","url":"https://api.github.com/repos/MikeyPetrillo/Agent402/commits/b3eb480c894e174b38373db83b800d6cd8f561da","html_url":"https://github.com/MikeyPetrillo/Agent402/commit/b3eb480c894e174b38373db83b800d6cd8f561da"}]},{"sha":"a2371c5f401e5ef02b0a5f8ca90534daecd6c737","node_id":"C_kwDOS3Cu2doAKGEyMzcxYzVmNDAxZTVlZjAyYjBhNWY4Y2E5MDUzNGRhZWNkNmM3Mzc","commit":{"author":{"name":"mikeypetrillo","email":"22065635+MikeyPetrillo@users.noreply.github.com","date":"2026-11-05T14:47:22Z"},"committer":{"name":"mikeypetrillo","email":"22065635+MikeyPetrillo@users.noreply.github.com","date":"2026-11-05T14:47:22Z"},"message":"[test] Unproven lane terms name only the daily caps that are on\n\nunprovenLaneTerms() replaces the constant and names the per-seller cap and the lane total each only while it is on, as routingProofSentence does; the legend and the lane note read it. Lane figures print through one usdFigure rule ($5.00) on the note, the routing sentence and the README. The seller-trust and seller-dossier examples build their unproven lane and flag through routerLanes under the shipped defaults.\n\nCo-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>\nClaude-Session: https://claude.ai/code/session_01MJsJ3YYiw9xvy1VAAsZPiQ","tree":{"sha":"5d7e41e7f5a1bdb76959aa7a7c300ee6afdbec1b","url":"https://api.github.com/repos/MikeyPetrillo/Agent402/git/trees/5d7e41e7f5a1bdb76959aa7a7c300ee6afdbec1b"},"url":"https://api.github.com/repos/MikeyPetrillo/Agent402/git/commits/a2371c5f401e5ef02b0a5f8ca90534daecd6c737","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/MikeyPetrillo/Agent402/commits/a2371c5f401e5ef02b0a5f8ca90534daecd6c737","html_url":"https://github.com/MikeyPetrillo/Agent402/commit/a2371c5f401e5ef02b0a5f8ca90534daecd6c737","comments_url":"https://api.github.com/repos/MikeyPetrillo/Agent402/commits/a2371c5f401e5ef02b0a5f8ca90534daecd6c737/comments","author":{"login":"MikeyPetrillo","id":22065635,"node_id":"MDQ6VXNlcjIyMDY1NjM1","avatar_url":"https://avatars.githubusercontent.com/u/22065635?v=4","gravatar_id":"","url":"https://api.github.com/users/MikeyPetrillo","html_url":"https://github.com/MikeyPetrillo","followers_url":"https://api.github.com/users/MikeyPetrillo/followers","following_url":"https://api.github.com/users/MikeyPetrillo/following{/other_user}","gists_url":"https://api.github.com/users/MikeyPetrillo/gists{/gist_id}","starred_url":"https://api.github.com/users/MikeyPetrillo/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/MikeyPetrillo/subscriptions","organizations_url":"https://api.github.com/users/MikeyPetrillo/orgs","repos_url":"https://api.github.com/users/MikeyPetrillo/repos","events_url":"https://api.github.com/users/MikeyPetrillo/events{/privacy}","received_events_url":"https://api.github.com/users/MikeyPetrillo/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"MikeyPetrillo","id":22065635,"node_id":"MDQ6VXNlcjIyMDY1NjM1","avatar_url":"https://avatars.githubusercontent.com/u/22065635?v=4","gravatar_id":"","url":"https://api.github.com/users/MikeyPetrillo","html_url":"https://github.com/MikeyPetrillo","followers_url":"https://api.github.com/users/MikeyPetrillo/followers","following_url":"https://api.github.com/users/MikeyPetrillo/following{/other_user}","gists_url":"https://api.github.com/users/MikeyPetrillo/gists{/gist_id}","starred_url":"https://api.github.com/users/MikeyPetrillo/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/MikeyPetrillo/subscriptions","organizations_url":"https://api.github.com/users/MikeyPetrillo/orgs","repos_url":"https://api.github.com/users/MikeyPetrillo/repos","events_url":"https://api.github.com/users/MikeyPetrillo/events{/privacy}","received_events_url":"https://api.github.com/users/MikeyPetrillo/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"a670249839b7b8e7509b1206e9961ed5fd4389fb","url":"https://api.github.com/repos/MikeyPetrillo/Agent402/commits/a670249839b7b8e7509b1206e9961ed5fd4389fb","html_url":"https://github.com/MikeyPetrillo/Agent402/commit/a670249839b7b8e7509b1206e9961ed5fd4389fb"}]},{"sha":"c57d76d3544ed4768b492fac90afadcf332a5edb","node_id":"C_kwDOS3Cu2doAKGM1N2Q3NmQzNTQ0ZWQ0NzY4YjQ5MmZhYzkwYWZhZGNmMzMyYTVlZGI","commit":{"author":{"name":"mikeypetrillo","email":"22065635+MikeyPetrillo@users.noreply.github.com","date":"2026-11-05T13:07:24Z"},"committer":{"name":"mikeypetrillo","email":"22065635+MikeyPetrillo@users.noreply.github.com","date":"2026-11-05T13:07:24Z"},"message":"[test] Copy names the unproven lane's daily total beside its caps\n\nThe routing-proof sentence, the lane note and terms, the README and the\nchangelog state the lane-wide daily cap with the per-call and per-seller\nones, each read from its env; the copy suite pins the README figure.\n\nCo-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>\nClaude-Session: https://claude.ai/code/session_01MJsJ3YYiw9xvy1VAAsZPiQ","tree":{"sha":"90ed4f413574ab7bb6699081441e09dde3e54668","url":"https://api.github.com/repos/MikeyPetrillo/Agent402/git/trees/90ed4f413574ab7bb6699081441e09dde3e54668"},"url":"https://api.github.com/repos/MikeyPetrillo/Agent402/git/commits/c57d76d3544ed4768b492fac90afadcf332a5edb","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/MikeyPetrillo/Agent402/commits/c57d76d3544ed4768b492fac90afadcf332a5edb","html_url":"https://github.com/MikeyPetrillo/Agent402/commit/c57d76d3544ed4768b492fac90afadcf332a5edb","comments_url":"https://api.github.com/repos/MikeyPetrillo/Agent402/commits/c57d76d3544ed4768b492fac90afadcf332a5edb/comments","author":{"login":"MikeyPetrillo","id":22065635,"node_id":"MDQ6VXNlcjIyMDY1NjM1","avatar_url":"https://avatars.githubusercontent.com/u/22065635?v=4","gravatar_id":"","url":"https://api.github.com/users/MikeyPetrillo","html_url":"https://github.com/MikeyPetrillo","followers_url":"https://api.github.com/users/MikeyPetrillo/followers","following_url":"https://api.github.com/users/MikeyPetrillo/following{/other_user}","gists_url":"https://api.github.com/users/MikeyPetrillo/gists{/gist_id}","starred_url":"https://api.github.com/users/MikeyPetrillo/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/MikeyPetrillo/subscriptions","organizations_url":"https://api.github.com/users/MikeyPetrillo/orgs","repos_url":"https://api.github.com/users/MikeyPetrillo/repos","events_url":"https://api.github.com/users/MikeyPetrillo/events{/privacy}","received_events_url":"https://api.github.com/users/MikeyPetrillo/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"MikeyPetrillo","id":22065635,"node_id":"MDQ6VXNlcjIyMDY1NjM1","avatar_url":"https://avatars.githubusercontent.com/u/22065635?v=4","gravatar_id":"","url":"https://api.github.com/users/MikeyPetrillo","html_url":"https://github.com/MikeyPetrillo","followers_url":"https://api.github.com/users/MikeyPetrillo/followers","following_url":"https://api.github.com/users/MikeyPetrillo/following{/other_user}","gists_url":"https://api.github.com/users/MikeyPetrillo/gists{/gist_id}","starred_url":"https://api.github.com/users/MikeyPetrillo/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/MikeyPetrillo/subscriptions","organizations_url":"https://api.github.com/users/MikeyPetrillo/orgs","repos_url":"https://api.github.com/users/MikeyPetrillo/repos","events_url":"https://api.github.com/users/MikeyPetrillo/events{/privacy}","received_events_url":"https://api.github.com/users/MikeyPetrillo/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"95e1bb7305d52f1ad11fa7f001cc1a32ff13d21c","url":"https://api.github.com/repos/MikeyPetrillo/Agent402/commits/95e1bb7305d52f1ad11fa7f001cc1a32ff13d21c","html_url":"https://github.com/MikeyPetrillo/Agent402/commit/95e1bb7305d52f1ad11fa7f001cc1a32ff13d21c"}]},{"sha":"346b7a5bfa0e198c9abbe92bf3e530ba51e49bb3","node_id":"C_kwDOS3Cu2doAKDM0NmI3YTViZmEwZTE5OGM5YWJiZTkyYmYzZTUzMGJhNTFlNDliYjM","commit":{"author":{"name":"mikeypetrillo","email":"22065635+MikeyPetrillo@users.noreply.github.com","date":"2026-11-05T12:28:24Z"},"committer":{"name":"mikeypetrillo","email":"22065635+MikeyPetrillo@users.noreply.github.com","date":"2026-11-05T12:28:24Z"},"message":"[test] Base unproven ceiling $0.05 with a per-seller daily cap\n\nSOR_BASE_UNPROVEN_MAX_USD defaults to $0.05. New SOR_BASE_UNPROVEN_SELLER_DAILY_USD\n(default $0.25) bounds what the unproven lane pays one seller (payTo and origin\nhost) over a rolling 24 h: reserved before signing on the shared-limits window\n(one Redis script across replicas), kept once the payment may have moved, given\nback when nothing moved. Copy that states the ceiling reads the same values.\n\nCo-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>\nClaude-Session: https://claude.ai/code/session_01MJsJ3YYiw9xvy1VAAsZPiQ","tree":{"sha":"695812a63c63142d2709495e7fa0f1485d7ce138","url":"https://api.github.com/repos/MikeyPetrillo/Agent402/git/trees/695812a63c63142d2709495e7fa0f1485d7ce138"},"url":"https://api.github.com/repos/MikeyPetrillo/Agent402/git/commits/346b7a5bfa0e198c9abbe92bf3e530ba51e49bb3","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/MikeyPetrillo/Agent402/commits/346b7a5bfa0e198c9abbe92bf3e530ba51e49bb3","html_url":"https://github.com/MikeyPetrillo/Agent402/commit/346b7a5bfa0e198c9abbe92bf3e530ba51e49bb3","comments_url":"https://api.github.com/repos/MikeyPetrillo/Agent402/commits/346b7a5bfa0e198c9abbe92bf3e530ba51e49bb3/comments","author":{"login":"MikeyPetrillo","id":22065635,"node_id":"MDQ6VXNlcjIyMDY1NjM1","avatar_url":"https://avatars.githubusercontent.com/u/22065635?v=4","gravatar_id":"","url":"https://api.g
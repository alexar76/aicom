0-20\",\n     \"src/tools/mcp-package-kit.js\": \"2026-11-06\",\n@@ -163,29 +163,29 @@\n     \"src/tools/prediction-market-kit.js\": \"2026-11-04\",\n     \"src/tools/price-feed-kit.js\": \"2026-10-29\",\n     \"src/tools/provenance.js\": \"2026-07-18\",\n-    \"src/tools/recall-report-kit.js\": \"2026-10-29\",\n+    \"src/tools/recall-report-kit.js\": \"2026-11-08\",\n     \"src/tools/redact.js\": \"2026-11-04\",\n     \"src/tools/regex-worker.js\": \"2026-06-11\",\n     \"src/tools/render.js\": \"2026-11-04\",\n-    \"src/tools/research-deep-kit.js\": \"2026-10-29\",\n-    \"src/tools/route-execute.js\": \"2026-11-06\",\n+    \"src/tools/research-deep-kit.js\": \"2026-11-08\",\n+    \"src/tools/route-execute.js\": \"2026-11-08\",\n     \"src/tools/safe-regex.js\": \"2026-10-21\",\n     \"src/tools/sanctions-core.js\": \"2026-10-14\",\n     \"src/tools/sanctions-kit.js\": \"2026-10-14\",\n-    \"src/tools/search.js\": \"2026-11-02\",\n+    \"src/tools/search.js\": \"2026-11-08\",\n     \"src/tools/seller-dossier.js\": \"2026-11-05\",\n     \"src/tools/seller-payability-kit.js\": \"2026-10-28\",\n     \"src/tools/seller-trust.js\": \"2026-11-05\",\n-    \"src/tools/skill-runner.js\": \"2026-10-29\",\n+    \"src/tools/skill-runner.js\": \"2026-11-08\",\n     \"src/tools/solana-intel-kit.js\": \"2026-11-07\",\n     \"src/tools/sql-guard-kit.js\": \"2026-10-19\",\n     \"src/tools/sql-guard.js\": \"2026-08-27\",\n     \"src/tools/stats-kit.js\": \"2026-10-29\",\n-    \"src/tools/stt-kit.js\": \"2026-10-21\",\n+    \"src/tools/stt-kit.js\": \"2026-11-08\",\n     \"src/tools/text-analysis-kit.js\": \"2026-10-29\",\n-    \"src/tools/ticker-pack-kit.js\": \"2026-10-29\",\n+    \"src/tools/ticker-pack-kit.js\": \"2026-11-08\",\n     \"src/tools/token-brief-kit.js\": \"2026-10-29\",\n-    \"src/tools/token-risk-kit.js\": \"2026-10-29\",\n+    \"src/tools/token-risk-kit.js\": \"2026-11-08\",\n     \"src/tools/token-safety-kit.js\": \"2026-10-19\",\n     \"src/tools/tool-namespaces.js\": \"2026-09-10\",\n     \"src/tools/ttl-dedupe.js\": \"2026-10-14\","},{"sha":"69f03f6ce74291c6b21c47cfe357d504e359dc50","filename":"src/guides.js","status":"modified","additions":681,"deletions":0,"changes":681,"blob_url":"https://github.com/MikeyPetrillo/Agent402/blob/81a674d1a3cf7fdbbcc04f4da366c144ccd393f7/src%2Fguides.js","raw_url":"https://github.com/MikeyPetrillo/Agent402/raw/81a674d1a3cf7fdbbcc04f4da366c144ccd393f7/src%2Fguides.js","contents_url":"https://api.github.com/repos/MikeyPetrillo/Agent402/contents/src%2Fguides.js?ref=81a674d1a3cf7fdbbcc04f4da366c144ccd393f7","patch":"@@ -24,6 +24,38 @@ import { FLAGSHIP_SLUGS, FLAGSHIP_MCP_NAMES } from \"./mcp-flagship.js\";\n import { creditsSalesEnabled, creditsPrepaymentPhrase } from \"./credits-sales.js\";\n import { TYPICAL_PRICE_RANGE } from \"./typical-price-range.js\";\n import { meteredRoutesInline, meteredFromPrice, meteredQuoteSentence, meteredDefaultModel, flatTiersLine } from \"./metered-lead.js\";\n+// The buying-at-volume guide quotes each limit from the code that enforces it.\n+import { unpaidQuoteBudgetPerHour, METERED_UNPAID_QUOTES_PER_MIN, METERED_UNPAID_QUOTES_PER_HOUR, PAID_CLIENT_QUOTE_MULTIPLIER, PAID_CLIENT_METERED_QUOTES_PER_MIN, PAID_CLIENT_METERED_QUOTES_PER_HOUR } from \"./unpaid-quote-budget.js\";\n+import { PAID_QUOTE_TRUST_MINUTES, METERED_QUOTE_CREDITS_PER_CALL } from \"./paid-quote-trust.js\";\n+import { MAX_FAILS as SETTLE_BREAKER_MAX_FAILS, WINDOW_MS as SETTLE_BREAKER_WINDOW_MS, HARD_MAX_FAILS as SETTLE_BREAKER_HARD_MAX } from \"./gateway-settle-breaker.js\";\n+import { ASYNC_JOBS_PER_CLIENT } from \"./async-jobs.js\";\n+import { IDEM_TTL_MS } from \"./idempotency-store.js\";\n+import { IDEM_MAX_BODY_LABEL } from \"./idempotency-limits.js\";\n+import { LATE_SETTLE_EXCEPTION } from \"./front-door.js\";\n+import { AGENT402_MCP_VERSION } from \"./mcp-flagship.js\";\n+import { OCR_LARGE_PIXELS } from \"./tools/ocr-kit.js\";\n+import { asyncProfileOf } from \"./slow-routes.js\";\n+import { needsAsyncOrWait } from \"./slow-sync-window.js\";\n+import { COMPOSITE_GUARD_LIMITS, isLongRunningSlug } from \"./composite-spend-guard.js\";\n+import { UNPAID_BODY_MAX_BYTES, UNPAID_LIMITS as LARGE_BODY_UNPAID } from \"./large-body-gate.js\";\n+// The report and media routes' per-buyer guard, read from the module that\n+// enforces it (its env overrides included).\n+const COMPOSITE_GUARD = COMPOSITE_GUARD_LIMITS;\n+/** A failure share in prose: 0.5 reads \"half\", so the guide says \"more than half\"\n+ *  from the limit itself (other shares read as a percentage). */\n+export function failShareWords(share) {\n+  const words = { 0.25: \"a quarter\", 0.5: \"half\", 0.75: \"three quarters\" };\n+  return words[share] ?? `${Math.round(share * 100)} percent`;\n+}\n+// The large-body gate's unpaid limiter (server.js \"large-body-unpaid\") reads the\n+// same export; it is keyed on the client address alone and has no paid-address raise.\n+const LARGE_BODY_UNPAID_PER_MIN = LARGE_BODY_UNPAID.PER_MIN;\n+const LARGE_BODY_UNPAID_PER_HOUR = LARGE_BODY_UNPAID.PER_HOUR;\n+// The content-pipeline guide reads the speech and transcription caps from their kits.\n+import { TTS_TIERS, VOICES as TTS_VOICES, FORMATS as TTS_FORMATS, LITE_FORMATS as TTS_LITE_FORMATS } from \"./tools/tts-kit.js\";\n+import { STT_TIERS, MAX_AUDIO_BYTES as STT_MAX_AUDIO_BYTES } from \"./tools/stt-kit.js\";\n+/** Where the buying-at-volume guide lives (the metered quote limiter's 429 links it). */\n+export const BUYING_AT_VOLUME_PATH = \"/guides/buying-at-volume\";\n // Whether prepaid credits are sold now. Copy that tells a reader to buy a pack\n // is only true while they are; read once at module load, like the env it reads.\n const CREDITS_ON = creditsSalesEnabled();\n@@ -37,6 +69,15 @@ const CREDITS_ON = creditsSalesEnabled();\n // /api/pricing.\n const priceUsd = (p) => Number(String(p ?? \"\").replace(/[^0-9.]/g, \"\"));\n const fmtUsd = (n) => `$${n.toFixed(n < 0.01 ? 3 : 2)}`;\n+/** The long-running routes among `slugs`, as \"`a`, `b` and `c`\". */\n+export function evmOnlyStagesText(slugs) {\n+  const longOnes = slugs.filter((s) => isLongRunningSlug(s)).map((s) => `\\`${s}\\``);\n+  if (!longOnes.length) throw new Error(`guide token {{evmOnly:${slugs.join(\",\")}}} names no long-running route`);\n+  return longOnes.length === 1 ? longOnes[0] : `${longOnes.slice(0, -1).join(\", \")} and ${longOnes[longOnes.length - 1]}`;\n+}\n+// Every content-pipeline stage, in the order of its stage table.\n+export const PIPELINE_STAGE_SLUGS = [\"answer\", \"research\", \"v1-chat-metered\", \"tts-lite\", \"tts\", \"tts-hd\", \"v1-images-fast\", \"v1-images-pro\", \"v1-images-edit\", \"transcribe\", \"transcribe-pro\", \"srt-convert\", \"skill-subtitle-pipeline\", \"dub\", \"media-info\", \"audio-convert\", \"audio-normalize\"];\n+const PIPELINE_TOKEN = `{{evmOnly:${PIPELINE_STAGE_SLUGS.join(\",\")}}}`;\n function resolveGuideTokens(text, catalog) {\n   const bySlug = catalog ? new Map(Object.values(catalog).filter((d) => d && d.slug).map((d) => [d.slug, d])) : null;\n   const def = (slug) => {\n@@ -47,6 +88,24 @@ function resolveGuideTokens(text, catalog) {\n   return resolveRailCountTokens(String(text))\n     .replace(/\\{\\{price:([a-z0-9-]+)\\}\\}/g, (_, slug) => (bySlug ? def(slug).price : \"(price on /api/pricing)\"))\n     .replace(/\\{\\{amount:([a-z0-9-]+)\\}\\}/g, (_, slug) => (bySlug ? String(Math.round(priceUsd(def(slug).price) * 1e6)) : \"<amount>\"))\n+    // {{jobs:<slug>[,<slug>]}}: whether a route runs as a job, read from the\n+    // async profile the catalog carries (src/slow-routes.js) and the slow-sync\n+    // window (SLOW_SYNC_WINDOW_SECONDS): \"yes, required\" when a paid call\n+    // without Prefer: respond-async (or a long enough Prefer: wait) is refused,\n+    // \"on request\" when the route takes the header, \"no\" otherwise. The slugs\n+    // on one row must agree.\n+    .replace(/\\{\\{jobs:([a-z0-9,-]+)\\}\\}/g, (_, list) => {\n+      const answers = [...new Set(list.split(\",\").map((slug) => {\n+        const profile = asyncProfileOf(bySlug ? def(slug) : { slug });\n+        return !profile ? \"no\" : needsAsyncOrWait(profile) ? \"yes, required\" : \"on request\";\n+      }))];\n+      if (answers.length !== 1) throw new Error(`guide token {{jobs:${list}}} names routes that run differently`);\n+      return answers[0];\n+    })\n+    // {{evmOnly:<slug>,...}}: of the routes named, the long-running ones\n+    // (isLongRunningSlug), which take x402 exact on EVM chains only, as a\n+    // code-formatted list. A list with none of them is an error.\n+    .replace(/\\{\\{evmOnly:([a-z0-9,-]+)\\}\\}/g, (_, list) => evmOnlyStagesText(list.split(\",\")))\n     .replace(/\\{\\{routerTiers\\}\\}/g, () => {\n       if (!bySlug) return \"The tiers and their prices are listed at [/api/pricing](https://agent402.tools/api/pricing).\";\n       const rows = [...bySlug.values()]\n@@ -232,6 +291,628 @@ the moment it discovers it needs them - and the seller can prove every cent of\n revenue on-chain. Every claim in this guide is verifiable: the server is\n [open source](${REPO_URL}) and settled calls land\n at a [public wallet](https://agent402.tools/api/stats).\n+`,\n+  },\n+  {\n+    slug: \"buying-at-volume\",\n+    title: \"Buying at volume: limits, retries and spend caps for AI agents\",\n+    seoTitle: \"Buying at volume from an AI agent\",\n+    description:\n+      \"Run hundreds or thousands of paid calls in a burst: the limits and their Retry-After, retries that never pay twice, spend caps, job links and the errors to handle.\",\n+    md: `\n+An agent that buys a thousand calls in an hour needs what a buyer of one call\n+needs, at a larger scale: a price it can check before it pays, a retry that\n+never pays twice, a ceiling on what it spends, and limits it can plan around.\n+The limits on this page are rendered from the code that enforces them.\n+\n+## Before the burst: read the prices\n+\n+Every route and its list price is in [/api/pricing](https://agent402.tools/api/pricing)\n+(free). Each row also names the chains it takes (\\`networks\\`, null for every\n+offered chain) and, on a route that runs as a job, its \\`async\\` block. Read it\n+at the start of each burst rather than from memory: list prices change, and\n+each change is on the [changelog](https://agent402.tools/changelog).\n+\n+\\`\\`\\`bash\n+curl -s https://agent402.tools/api/pricing \\\\\n+  | jq -c '.endpoints[] | select(.slug==\"onchain-sql\") | {path, price, networks}'\n+\\`\\`\\`\n+\n+The 402 is the quote for the request in hand: each \\`accepts\\` entry carries\n+the amount in the asset's smallest unit on that chain, with any settlement\n+premium or price floor of the chain included (\\`/api/pricing\\` lists them under\n+\\`payment.premiumUsdByNetwork\\` and \\`payment.minPriceUsdByNetwork\\` for the chains\n+that have one). On the metered model routes the quote is computed from the\n+request body, and the paid retry is priced again from its own body, so send the\n+paid retry with the body you were quoted for. Compare the quote with your\n+ceiling before you sign; the clients below do that on their own.\n+\n+## Throughput limits\n+\n+There is no per-wallet rate limit on paid calls. The limits below bound unpaid reads,\n+failed settlements and concurrent heavy runs. Each one answers\n+before any payment is taken, and the last column says how long to wait.\n+\n+| What is counted | Limit | Answer |\n+|---|---|---|\n+| Unpaid price checks (a request with no payment) to priced catalog routes | ${unpaidQuoteBudgetPerHour().toLocaleString(\"en-US\")} an hour per client address; ${(unpaidQuoteBudgetPerHour() * PAID_CLIENT_QUOTE_MULTIPLIER).toLocaleString(\"en-US\")} an hour for the rest of the clock hour once that address settles a payment, and for ${PAID_QUOTE_TRUST_MINUTES} minutes after each paid call | 429, \\`Retry-After\\` until the hour turns |\n+| Unpaid quotes on \\`/v1/metered\\` | ${METERED_UNPAID_QUOTES_PER_MIN} a minute and ${METERED_UNPAID_QUOTES_PER_HOUR.toLocaleString(\"en-US\")} an hour per client address; past that, ${METERED_QUOTE_CREDITS_PER_CALL} more for each paid \\`/v1/metered\\` call from that address, used within ${PAID_QUOTE_TRUST_MINUTES} minutes, up to ${PAID_CLIENT_METERED_QUOTES_PER_MIN} a minute and ${PAID_CLIENT_METERED_QUOTES_PER_HOUR.toLocaleString(\"en-US\")} an hour | 429, \\`Retry-After: 60\\` |\n+| Refused payment credentials on \\`/v1/metered\\` | the same figures, counted once a credential is refused | 429, \\`Retry-After: 60\\` |\n+| Payments that verified and then failed to settle, per wallet | refused at ${SETTLE_BREAKER_MAX_FAILS} in ${Math.round(SETTLE_BREAKER_WINDOW_MS / 60_000)} minutes while they are more than half of the wallet's outcomes there, or at ${SETTLE_BREAKER_HARD_MAX} whatever it settled | 429 naming when it lifts |\n+| Report and media runs that failed to settle or failed after the run, per buyer | blocked for ${Math.round(COMPOSITE_GUARD.BLOCK_MS / 60_000)} minutes at ${COMPOSITE_GUARD.MAX_FAILS} in ${Math.round(COMPOSITE_GUARD.WINDOW_MS / 60_000)} minutes while they are more than ${failShareWords(COMPOSITE_GUARD.MIN_FAIL_SHARE)} of the buyer's outcomes there, or at ${COMPOSITE_GUARD.HARD_MAX_FAILS} whatever it settled | 429 without \\`Retry-After\\`; the block lifts on its own |\n+| Unpaid requests with a body over ${Math.round(UNPAID_BODY_MAX_BYTES / 1024)} KB to a route that reads its price from the body | ${LARGE_BODY_UNPAID_PER_MIN} a minute and ${LARGE_BODY_UNPAID_PER_HOUR.toLocaleString(\"en-US\")} an hour per client address, the same once that address has paid | 429, \\`Retry-After: 60\\` |\n+| Concurrent runs of the report and media routes from one wallet | the wallet's balance covers every run in flight plus the new one | 429, \\`Retry-After: 30\\` |\n+| Jobs per client address | ${ASYNC_JOBS_PER_CLIENT} running at once | 429, \\`Retry-After: 30\\` |\n+\n+An IPv6 /64 is one address. A request carrying a payment, a credits key or a\n+proof-of-work solution is never counted as an unpaid price check. The report\n+and media guard keys a buyer by its signed payer, its verified Tempo sender,\n+its credits key or, for any other payment, its address. Once an\n+address has paid (a final 200 that settled on any rail, or a credits debit), its\n+unpaid price checks read against ${PAID_CLIENT_QUOTE_MULTIPLIER} times the figure for the rest of that clock hour\n+and for ${PAID_QUOTE_TRUST_MINUTES} minutes after each paid call. A \\`/v1/metered\\` quote reads the whole\n+body, so past its plain figure each paid \\`/v1/metered\\` call earns ${METERED_QUOTE_CREDITS_PER_CALL} more quotes (its own\n+and one retry), used within ${PAID_QUOTE_TRUST_MINUTES} minutes. A payment credential that is refused still counts. \\`Retry-After: 60\\` on a \\`/v1/metered\\` 429 is the\n+minute window; an address past the hourly figure waits until its oldest quote in\n+the last hour ages out, so a retry loop backs off further after repeated 429s.\n+\n+How to plan a burst around them:\n+\n+- A stock x402 client reads the 402 and then sends the paid retry, so each\n+  call is one unpaid read plus one paid request, and only the unpaid read is\n+  counted. On \\`/v1/metered\\` an address gets ${METERED_UNPAID_QUOTES_PER_MIN} quotes a minute, plus\n+  ${METERED_QUOTE_CREDITS_PER_CALL} for each paid \\`/v1/metered\\` call, so a steady buyer is paced by its own\n+  paid calls, up to ${PAID_CLIENT_METERED_QUOTES_PER_MIN} a minute.\n+- Keep the paying wallet funded above everything in flight. Each payment is\n+  verified on its own; a wallet that runs dry partway through a burst turns its\n+  later calls into failed settlements, which is what the per-wallet limit counts.\n+- On a 429 or a 503, wait \\`Retry-After\\` (or the block named above) and send\n+  the call again.\n+\n+## Retries that never pay twice\n+\n+On x402 a response of 400 or above is not settled, so a retry after one costs\n+nothing extra. For a call that may have succeeded (a timeout, a dropped\n+connection), use the replay rules:\n+\n+- **Send an \\`Idempotency-Key\\`.** The same key with the same credential (the\n+  same signed payment), route, query and body returns the first 200 answer (up\n+  to ${IDEM_MAX_BODY_LABEL}, kept ${Math.round(IDEM_TTL_MS / 60_000)} minutes) with\n+  \\`X-Idempotent-Replay: true\\`: the tool does not run again and nothing settles\n+  again. A copy that arrives while the first is still running gets 409\n+  \\`idempotent_request_in_flight\\` with \\`Retry-After: 2\\`; on x402 it is not charged.\n+- **On an EVM payment the signed payment is the key.** Send the same request\n+  again with the same payment header within ${Math.round(IDEM_TTL_MS / 60_000)} minutes\n+  and the first answer comes back marked \\`X-Replayed-Answer: 1\\`, with no\n+  second settlement (identity-bound routes, routes with a lasting effect and\n+  streamed calls excepted).\n+- **On Solana, send the key yourself.** A Solana payment has no implicit key,\n+  so pair an \\`Idempotency-Key\\` with the exact payment header that went out the\n+  first time.\n+- **A fresh signature is a new payment.** Sign again only after an answer of\n+  400 or above.\n+\n+Each answer says whether it settled:\n+\n+- No \\`PAYMENT-RESPONSE\\` header: nothing settled.\n+- \\`PAYMENT-RESPONSE\\` whose receipt reads \\`success: false\\`: settlement was\n+  refused, nothing moved.\n+- \\`PAYMENT-RESPONSE\\` with a status under 400: charged and served.\n+\n+${LATE_SETTLE_EXCEPTION}\n+\n+## Long or slow calls: take a job link\n+\n+Every route whose \\`/api/pricing\\` row has an \\`async\\` block runs as a job: the\n+report products, video, the premium image tier, the router's execute tiers and\n+the rest the rows mark. Send the paid call with \\`Prefer: respond-async\\` and it\n+answers 202 at once with a \\`Location\\` job link. Poll \\`GET /api/jobs/{id}\\`\n+(free), waiting \\`Retry-After\\` between polls, until \\`status\\` is \\`completed\\` or\n+\\`failed\\`; \\`state\\`, \\`stage\\`, \\`progress\\` and \\`etaSeconds\\` say where it is. The\n+payment settles only when the result is ready, and on x402 a failed run is not\n+charged. A row whose block carries \\`preferWait\\` also takes\n+\\`Prefer: wait=<maxSeconds>\\` to wait on the connection, and a paid call there\n+with neither header is answered 400 before any payment.\n+\n+With ${ASYNC_JOBS_PER_CLIENT} jobs per client address at once, a burst of slow\n+calls is a queue on your side: collect a finished job before you start the\n+next. agent402-client and agent402-mcp switch to jobs on their own.\n+\n+## Spend caps in the clients\n+\n+Every cap below is checked before a payment is signed, so a quote above it is\n+refused with nothing sent.\n+\n+**agent402-client.** The caps are constructor options, held in the client\n+instance's memory; give each worker its own instance with its own share.\n+\n+\\`\\`\\`js\n+import { Agent402 } from \"agent402-client\";\n+import { wrapFetchWithPayment } from \"@x402/fetch\";\n+import { x402Client } from \"@x402/core/client\";\n+import { registerExactEvmScheme } from \"@x402/evm/exact/client\";\n+import { privateKeyToAccount } from \"viem/accounts\";\n+\n+const client = new x402Client();\n+client.setSpendControls?.(false); // the caps below replace the library default\n+registerExactEvmScheme(client, { signer: privateKeyToAccount(process.env.AGENT_KEY) });\n+const payFetch = wrapFetchWithPayment(fetch, client);\n+\n+const a = new Agent402({\n+  fetch: payFetch,\n+  x402Client: client,   // the caps are checked on the payment that is signed\n+  maxPerCallUsd: 0.05,  // refuse any single quote above this\n+  dailyLimitUsd: 25,    // rolling 24 hours, this instance\n+  maxPerHostUsd: 10,    // rolling 24 hours, per seller host\n+});\n+const out = await a.call(\"extract\", { url: \"https://example.com/article\" });\n+\\`\\`\\`\n+\n+A refused call throws \\`SpendingLimitError\\` naming the cap, the quote and the\n+list price. A payment that was sent and answered with an error counts as held\n+until its authorization can no longer settle.\n+\n+**agent402-mcp.** The per-call cap is on by default (\\`off\\` removes it); the\n+session budget is opt-in.\n+\n+\\`\\`\\`bash\n+export AGENT_KEY=0x...                # or SOLANA_AGENT_KEY for a Solana wallet\n+export AGENT402_MAX_PER_CALL=0.10     # USD per call\n+export AGENT402_BUDGET=20             # USD for the whole session\n+export AGENT402_NETWORKS=solana       # pay only on these chains, in this order\n+npx -y agent402-mcp@${AGENT402_MCP_VERSION}\n+\\`\\`\\`\n+\n+**agent402-openclaw.** \\`maxPerCallUsd\\` in the plugin config, or\n+\\`AGENT402_MAX_PER_CALL_USD\\`, defaults to the metered per-call cap below;\n+\\`off\\` removes it only beside \\`allowUncappedPayments: true\\`.\n+\n+All three refuse an accept that asks for a signing validity longer than a day,\n+and refuse to send a payload signed past it.\n+\n+## Choosing a rail for volume\n+\n+| Rail | When it settles | When the call fails |\n+|---|---|---|\n+| x402 exact on an EVM chain | after the tool answers, only for a response under 400 | not charged; the signed payment is its own replay key |\n+| x402 exact on Solana | after the tool answers, only for a response under 400 | not charged; send an \\`Idempotency-Key\\` for replays |\n+| x402 exact on Stellar | after the tool answers, only for a response under 400 | not charged |\n+| x402 exact on Algorand | after the tool answers, only for a response under 400 | not charged |\n+| x402 exact, Gateway batched (where offered; paid from a Circle Gateway deposit) | settled off chain by Circle Gateway after the tool answers, only for a response under 400 | not charged |\n+| MPP \\`evm\\` charge | the same x402 settlement underneath | not charged |\n+| MPP Tempo pull (a signed transaction the relay broadcasts) | broadcast after the tool answers, only for a response under 400 | not charged |\n+| MPP Tempo push (a transfer you already sent) | final before the call runs | booked as a refund owed to the paying wallet, repaid after on-chain proof |\n+\n+On the EVM chains and Tempo pull, a settlement whose outcome is not known when\n+the call is answered is read on chain again; one that lands after a failed\n+answer is booked as a refund owed and repaid after on-chain proof.\n+\n+- The report products and other long routes take x402 exact on EVM chains\n+  only: their run outlives a Solana payment's recent blockhash, an Algorand\n+  transaction's rounds and a Tempo credential. Tempo is also not offered on the\n+  identity-bound routes.\n+- A Solana payment embeds a recent blockhash that lives about a minute, so sign\n+  each payment right before you send it rather than signing a batch ahead.\n+- A Solana payment refused for a missing USDC account or too little USDC\n+  answers with \\`retry: \"fund-wallet\"\\` and a \\`Retry-After\\`; fund the wallet\n+  before the next call.\n+- MPP methods appear in the 402 while this instance offers them;\n+  [/.well-known/x402](https://agent402.tools/.well-known/x402) lists them.\n+- On the metered routes, a 402 carrying an \\`upto\\` accept lets a wallet with a\n+  one-time Permit2 approval for USDC sign the quote as a ceiling and settle\n+  actual usage under it.\n+\n+## Metered chat at volume\n+\n+- **Model ids.** \\`GET /v1/models\\` lists every id; send one verbatim. An id the\n+  upstream does not list is refused with a 400 before any payment, carrying\n+  \\`suggestions\\` (the closest served ids, at most three) and a \\`howToCall\\`\n+  retried with the first. A version written with a hyphen (\\`v4-1\\`) is served\n+  as the dotted id when that exact id is listed.\n+- **Input size.** Every model takes ${TIERS[\"v1-chat-metered\"].maxInputChars.toLocaleString(\"en-US\")} input characters,\n+  and a model with a larger context window takes three characters per window\n+  token, up to ${METERED_MAX_INPUT_CHARS_CEILING.toLocaleString(\"en-US\")}. \\`/v1/models\\` publishes each model's\n+  own figure as \\`x402.meteredMaxInputChars\\`. A body over it is refused before\n+  payment with code \\`input_too_large\\`, \\`maxInputChars\\`, \\`inputChars\\`,\n+  \\`hint: \"trim-input\"\\` and \\`suggestions\\` of models whose window takes it.\n+- **Per-call cap.** A request quoting above $${METERED_MAX_QUOTE_USD} is refused\n+  with a 400 before any upstream call: lower \\`max_tokens\\` or the input. On\n+  x402 it is not charged.\n+\n+\\`\\`\\`bash\n+curl -s https://agent402.tools/v1/models \\\\\n+  | jq -c '.data[] | select(.x402.meteredMaxInputChars) | {id, maxInputChars: .x402.meteredMaxInputChars}'\n+\\`\\`\\`\n+\n+## Errors to handle\n+\n+| Status | What it means | What to do |\n+|---|---|---|\n+| 400 | the input was refused before the tool ran; the body carries \\`expected\\`, \\`required\\`, \\`example\\` and \\`howToCall\\` (method, URL and a ready body) | fix the request from \\`howToCall\\`; not charged on x402 |\n+| 402 | the quote, or a refused payment; the first-contact 402 body carries the offer, \\`howToCall\\` and, on a job route, \\`async\\` | pay, or fund the wallet the refusal names |\n+| 409 | the same keyed call is still running | wait \\`Retry-After\\`, then resend the same key with the same payment header to get its answer |\n+| 422 | the tool cannot serve this input (an image too large to read, a body that is not an image) | read \\`error\\` and the \\`howToCall\\` note; not charged on x402 |\n+| 429 | one of the limits above | wait \\`Retry-After\\` |\n+| 503 | busy or briefly paused; image-ocr reading another image over ${OCR_LARGE_PIXELS / 1e6} megapixels answers \\`hint: \"large-image-busy\"\\` | wait \\`Retry-After\\`, or send a smaller image, which is read at once |\n+| 502, 504 with \\`attribution: \"upstream\"\\` | a source the tool reads failed (a host timed out or refused the connection) | not your input: retry later or pick another source; not charged on x402 |\n+\n+A loop that honors all of it, shown with plain \\`fetch\\` (pass your payment\n+\\`fetch\\` in its place):\n+\n+\\`\\`\\`js\n+const BASE = process.env.AGENT402_URL || \"https://agent402.tools\";\n+const sleep = (ms) => new Promise((r) => setTimeout(r, ms));\n+\n+async function call(path, body, { pay = fetch, tries = 5 } = {}) {\n+  // The key replays a stored answer only with the same signed payment; a payment\n+  // client signs afresh on each retry, so each retry here is its own paid call.\n+  // This loop retries only answers that are not charged on x402.\n+  const key = crypto.randomUUID();\n+  for (let i = 0; i < tries; i++) {\n+    const res = await pay(BASE + path, {\n+      method: \"POST\",\n+      headers: { \"Content-Type\": \"application/json\", \"Idempotency-Key\": key },\n+      body: JSON.stringify(body),\n+    });\n+    if (res.ok) return res.json();\n+    if (![409, 429, 502, 503, 504].includes(res.status)) throw new Error(JSON.stringify(await res.json()));\n+    const wait = Number(res.headers.get(\"retry-after\")) || 2 ** i;\n+    await sleep(wait * 1000);\n+  }\n+  throw new Error(\"gave up after \" + tries + \" tries\");\n+}\n+\n+console.log(await call(\"/api/hash\", { text: \"hello world\" }));\n+\\`\\`\\`\n+\n+The recovery contract in brief is at [/agents.md](https://agent402.tools/agents.md),\n+and the whole service at [/llms.txt](https://agent402.tools/llms.txt). A worked\n+chain of paid stages, from research to subtitles, is in\n+[content pipelines](/guides/content-pipeline).\n+`,\n+  },\n+  {\n+    slug: \"content-pipeline\",\n+    title: \"Content pipelines: research, script, voice, images and subtitles from one wallet\",\n+    seoTitle: \"A content pipeline for AI agents, paid per call\",\n+    description:\n+      \"A recipe for podcast, short-video and voiceover pipelines: research, script, speech, images, transcripts, subtitles, dubbing and media checks, each stage one paid call from one wallet, no API keys.\",\n+    md: `\n+A content pipeline turns a topic into a finished piece: find the facts, write\n+the script, voice it, illustrate it, transcribe it, subtitle it, dub it and\n+check the files. Here each stage is one paid call to the same service, paid\n+from one wallet over x402 or MPP, with no API key and no account to open.\n+\n+Most stages are model-backed: a model answers, writes, speaks, draws, listens\n+or translates. Subtitle conversion and the media checks are deterministic code.\n+\n+## The stages\n+\n+| Stage | Slug | Price | Model-backed | Runs as a job |\n+|---|---|---|---|---|\n+| Answer with citations | \\`answer\\` | {{price:answer}} | yes | {{jobs:answer}} |\n+| Research report | \\`research\\` | {{price:research}} | yes | {{jobs:research}} |\n+| Script | \\`v1-chat-metered\\` | quoted per request, from {{price:v1-chat-metered}} | yes | {{jobs:v1-chat-metered}} |\n+| Voiceover | \\`tts-lite\\` | {{price:tts-lite}} | yes | {{jobs:tts-lite}} |\n+| Voiceover | \\`tts\\`, \\`tts-hd\\` | quoted from the text, from {{price:tts}} and {{price:tts-hd}} | yes | {{jobs:tts,tts-hd}} |\n+| Images | \\`v1-images-fast\\`, \\`v1-images-pro\\` | {{price:v1-images-fast}}, {{price:v1-images-pro}} | yes | {{jobs:v1-images-fast,v1-images-pro}} |\n+| Image edit | \\`v1-images-edit\\` | {{price:v1-images-edit}} | yes | {{jobs:v1-images-edit}} |\n+| Transcription | \\`transcribe\\`, \\`transcribe-pro\\` | {{price:transcribe}}, {{price:transcribe-pro}} | yes | {{jobs:transcribe,transcribe-pro}} |\n+| Subtitles | \\`srt-convert\\` | {{price:srt-convert}}, or free with proof-of-work | no | {{jobs:srt-convert}} |\n+| Subtitles in one call | \\`skill-subtitle-pipeline\\` | {{price:skill-subtitle-pipeline}} | yes | {{jobs:skill-subtitle-pipeline}} |\n+| Dubbing | \\`dub\\` | quoted by tier, from {{price:dub}} | yes | {{jobs:dub}} |\n+| Media probe | \\`media-info\\` | {{price:media-info}} | no | {{jobs:media-info}} |\n+| Audio track to MP3 | \\`audio-convert\\` | {{price:audio-convert}} | no | {{jobs:audio-convert}} |\n+| Loudness | \\`audio-normalize\\` | {{price:audio-normalize}} | no | {{jobs:audio-normalize}} |\n+\n+Prices are read from [/api/pricing](https://agent402.tools/api/pricing) when\n+this page renders. Each example below is the tool's published example.\n+\n+## Set up once\n+\n+One client pays every stage. The caps are checked before each payment is\n+signed, against the quote for that request.\n+\n+\\`\\`\\`js\n+import { Agent402 } from \"agent402-client\";\n+import { wrapFetchWithPayment } from \"@x402/fetch\";\n+import { x402Client } from \"@x402/core/client\";\n+import { registerExactEvmScheme } from \"@x402/evm/exact/client\";\n+import { privateKeyToAccount } from \"viem/accounts\";\n+\n+const client = new x402Client();\n+client.setSpendControls?.(false); // the caps below replace the library default\n+registerExactEvmScheme(client, { signer: privateKeyToAccount(process.env.AGENT_KEY) });\n+const payFetch = wrapFetchWithPayment(fetch, client);\n+\n+const a = new Agent402({\n+  fetch: payFetch,\n+  x402Client: client,  // the caps are checked on the payment that is signed\n+  maxPerCallUsd: 1,    // refuse any single quote above this\n+  dailyLimitUsd: 25,   // rolling 24 hours, this instance\n+});\n+\\`\\`\\`\n+\n+Over plain HTTP, the same request without a payment answers 402 with the\n+quote, and your x402 or MPP client pays it:\n+\n+\\`\\`\\`bash\n+curl -i -X POST https://agent402.tools/api/tts \\\\\n+  -H 'Content-Type: application/json' \\\\\n+  -d '{\"text\":\"Hello from Agent402!\",\"voice\":\"alloy\",\"format\":\"mp3\"}'\n+# HTTP/2 402, the x402 accepts in PAYMENT-REQUIRED and the MPP challenges in WWW-Authenticate\n+\\`\\`\\`\n+\n+## 1. Research\n+\n+\\`answer\\` (\\`GET /api/answer\\`) returns a short answer grounded in live web\n+search, with its citations:\n+\n+\\`\\`\\`js\n+const brief = await a.call(\"answer\", { q: \"what is the x402 payment protocol?\" });\n+// { query, answer, citations: [{ url, snippet, number }], citationCount }\n+\\`\\`\\`\n+\n+\\`research\\` (\\`POST /v1/research\\`) plans sub-questions, runs several searches\n+and returns one cited report. It runs as a job: the client sends\n+\\`Prefer: respond-async\\` and collects the report from the job link.\n+\n+\\`\\`\\`js\n+const report = await a.call(\"research\", { query: \"What are the leading agentic-payment protocols in 2026 and how do they differ?\", recency: \"year\" });\n+// { report, sources: [{ n, title, url, snippet }], sub_questions, meta }\n+\\`\\`\\`\n+\n+## 2. Script\n+\n+The metered chat route quotes each request from its input and \\`max_tokens\\`,\n+so a short script costs what a short script uses. Name any id from\n+[/v1/models](https://agent402.tools/v1/models) in \\`model\\`, or leave it out for\n+the default.\n+\n+\\`\\`\\`js\n+const messages = [\n+  { role: \"system\", content: \"Write a 60-second voiceover script in plain sentences.\" },\n+  { role: \"user\", content: brief.answer },\n+];\n+const draft = await a.call(\"v1-chat-metered\", { max_tokens: 600, messages });\n+const script = draft.choices[0].message.content;\n+\\`\\`\\`\n+\n+The flat tiers take the same body at one price per call, from\n+\\`/v1/nano/chat/completions\\` ({{price:v1-chat-nano}}) up.\n+\n+## 3. Voiceover\n+\n+\\`\\`\\`js\n+const voice = await a.call(\"tts\", { text: \"Hello from Agent402!\", voice: \"alloy\", format: \"mp3\" });\n+const audio = Buffer.from(voice.audio, \"base64\"); // { model, voice, format, audio, chars }\n+\\`\\`\\`\n+\n+- **Tiers.** \\`tts-lite\\` for high-volume narration where timbre matters less,\n+  \\`tts\\` for natural speech, \\`tts-hd\\` for the most expressive delivery (it\n+  reads inline tags such as \\`[whispering]\\` as cues). One request shape for all three.\n+- **Length.** ${TTS_TIERS.tts.maxChars.toLocaleString(\"en-US\")} characters a call on \\`tts\\` and \\`tts-hd\\`,\n+  ${TTS_TIERS[\"tts-lite\"].maxChars.toLocaleString(\"en-US\")} on \\`tts-lite\\`. Split a longer script at sentence ends and send one call per part.\n+- **Voices.** The ten standard names on every tier: ${[...TTS_VOICES].map((v) => \"`\" + v + \"`\").join(\", \")}.\n+  \\`tts\\` and \\`tts-hd\\` also take the named voices listed on [/speech](https://agent402.tools/speech).\n+- **Formats.** ${[...TTS_FORMATS].map((f) => \"`\" + f + \"`\").join(\", \")} on \\`tts\\` and \\`tts-hd\\`; ${[...TTS_LITE_FORMATS].map((f) => \"`\" + f + \"`\").join(\" or \")} on \\`tts-lite\\`.\n+\n+## 4. Images\n+\n+\\`/v1/images/fast\\` and \\`/v1/images/pro\\` take a prompt and return one picture\n+inline on the OpenAI images wire; pro is the higher-fidelity tier.\n+\n+\\`\\`\\`js\n+const cover = await a.call(\"v1-images-fast\", { prompt: \"A minimalist line drawing of a lighthouse at dawn\" });\n+const jpeg = Buffer.from(cover.data[0].b64_json, \"base64\");\n+\\`\\`\\`\n+\n+\\`/v1/images/edits\\` changes a picture you already have: send one to four PNG\n+or JPEG references (base64 or \\`data:\\` URLs) and describe the change in the\n+prompt. The output follows the first reference's aspect ratio.\n+\n+\\`\\`\\`js\n+const ref = \"data:image/jpeg;base64,\" + cover.data[0].b64_json;\n+const edited = await a.call(\"v1-images-edit\", { prompt: \"Add a warm sunrise glow behind the lighthouse\", image: ref });\n+\\`\\`\\`\n+\n+## 5. Transcription\n+\n+\\`transcribe\\` reads audio from a public URL, up to ${STT_TIERS.transcribe.maxMinutes} minutes\n+(\\`transcribe-pro\\` up to ${STT_TIERS[\"transcribe-pro\"].maxMinutes}) and ${Math.round(STT_MAX_AUDIO_BYTES / 1024 / 1024)} MB. Add\n+\\`diarize: true\\` for speaker labels and word timestamps, which the subtitle\n+stage turns into timed cues.\n+\n+\\`\\`\\`js\n+const t = await a.call(\"transcribe\", { url: \"https://agent402.tools/fixtures/sample-speech.wav\", diarize: true });\n+// { text, language, duration, speakers, words: [{ word, start, end, speaker }] }\n+\\`\\`\\`\n+\n+For audio you hold as bytes, \\`POST /v1/audio/transcriptions\\` takes the same\n+models as a multipart \\`file\\` upload (\\`/v1/pro/audio/transcriptions\\` for the\n+longer cap).\n+\n+## 6. Subtitles\n+\n+\\`srt-convert\\` turns timed cues into SRT, WebVTT, plain text or JSON. It is\n+pure CPU, so agent402-client pays it with a proof-of-work solution and no\n+wallet.\n+\n+\\`\\`\\`js\n+const words = t.words.filter((w) => w.word.trim() && w.start != null);\n+const cues = [];\n+for (let i = 0; i < words.length; i += 7) {\n+  const line = words.slice(i, i + 7);\n+  cues.push({ start: Math.round(line[0].start * 1000), end: Math.round(line.at(-1).end * 1000), text: line.map((w) => w.word).join(\" \") });\n+}\n+const subs = await a.call(\"srt-convert\", { cues, to: \"srt\" });\n+// { detected, to, count, result }: result is the SRT file\n+\\`\\`\\`\n+\n+The subtitle-pipeline skill pack runs transcribe, srt-convert and text-stats\n+in one payment. Its file is one cue spanning the clip, so use the diarized\n+words above when each line needs its own timing.\n+\n+\\`\\`\\`js\n+const pack = await a.call(\"skill-subtitle-pipeline\", { url: \"https://agent402.tools/fixtures/sample-speech.wav\", format: \"vtt\" });\n+\\`\\`\\`\n+\n+## 7. Dubbing\n+\n+\\`dub\\` translates a text and speaks the translation in one call. \\`tier\\`\n+\\`\"hd\"\\` speaks it on the tts-hd voice, and the quote is the sum of the two\n+steps. The text cap applies to the translation.\n+\n+\\`\\`\\`js\n+const es = await a.call(\"dub\", { text: \"Hello from Agent402! Every tool is paid per call.\", targetLanguage: \"es\", voice: \"nova\", format: \"mp3\", json: true });\n+// { translation, detectedSourceLanguage, targetLanguage, tier, voice, format, audio, chars }\n+\\`\\`\\`\n+\n+Without \\`json: true\\` the answer is the audio bytes, with the translation in\n+the \\`X-Dub-Translation\\` header (base64 JSON).\n+\n+## 8. Media checks\n+\n+Each reads a public URL and runs ffprobe or ffmpeg on it.\n+\n+\\`\\`\\`js\n+const info = await a.call(\"media-info\", { url: \"https://agent402.tools/fixtures/sample-audio.wav\" });\n+// { formatName, durationSec, bitrate, bytes, streams: [{ type, codec, sampleRate, channels }] }\n+const level = await a.call(\"audio-normalize\", { url: \"https://agent402.tools/fixtures/sample-audio.wav\", targetLufs: -16 });\n+// { format: \"mp3\", targetLufs, truePeakDb, bytes, mp3Base64 }\n+const track = await a.call(\"audio-convert\", { url: \"https://agent402.tools/fixtures/sample-audio.wav\", bitrate: \"192k\" });\n+// { format: \"mp3\", bitrate, bytes, mp3Base64 }: the audio track of a video, as MP3\n+\\`\\`\\`\n+\n+## End to end\n+\n+The stages that read a URL (transcription, the media checks) need the audio\n+at a public address, so the flow puts each file where your pipeline already\n+keeps its media. Stages that need only the script run side by side.\n+\n+\\`\\`\\`js\n+// Your storage: put the bytes somewhere public and return the URL.\n+async function publish(name, bytes) {\n+  throw new Error(\"upload \" + name + \" (\" + bytes.length + \" bytes) and return its public URL\");\n+}\n+\n+const topic = \"what is the x402 payment protocol?\";\n+const brief = await a.call(\"answer\", { q: topic });\n+\n+const messages = [\n+  { role: \"system\", content: \"Write a 60-second voiceover script in plain sentences.\" },\n+  { role: \"user\", content: brief.answer },\n+];\n+const draft = await a.call(\"v1-chat-metered\", { max_tokens: 600, messages });\n+const script = draft.choices[0].message.content;\n+\n+const [voice, cover, es] = await Promise.all([\n+  a.call(\"tts\", { text: script, voice: \"nova\", format: \"mp3\" }),\n+  a.call(\"v1-images-fast\", { prompt: \"Cover art as a minimalist line drawing: \" + topic }),\n+  a.call(\"dub\", { text: script, targetLanguage: \"es\", voice: \"nova\", format: \"mp3\", json: true }),\n+]);\n+\n+const rawUrl = await publish(\"episode-raw.mp3\", Buffer.from(voice.audio, \"base64\"));\n+const level = await a.call(\"audio-normalize\", { url: rawUrl, targetLufs: -16 });\n+const episodeUrl = await publish(\"episode.mp3\", Buffer.from(level.mp3Base64, \"base64\"));\n+const info = await a.call(\"media-info\", { url: episodeUrl });\n+\n+const t = await a.call(\"transcribe\", { url: episodeUrl, diarize: true });\n+const words = t.words.filter((w) => w.word.trim() && w.start != null);\n+const cues = [];\n+for (let i = 0; i < words.length; i += 7) {\n+  const line = words.slice(i, i + 7);\n+  cues.push({ start: Math.round(line[0].start * 1000), end: Math.round(line.at(-1).end * 1000), text: line.map((w) => w.word).join(\" \") });\n+}\n+const subs = await a.call(\"srt-convert\", { cues, to: \"srt\" });\n+\n+console.log(info.durationSec, subs.count, es.translation, a.spendingSummary());\n+\\`\\`\\`\n+\n+Cite the sources \\`brief.citations\\` names in the episode's show notes;\n+\\`a.spendingSummary()\\` totals what the run spent.\n+\n+## Pipeline notes\n+\n+### Slow stages and jobs\n+\n+A route runs as a job when its [/api/pricing](https://agent402.tools/api/pricing)\n+row carries an \\`async\\` block. In this recipe:\n+\n+- \\`research\\` requires one: send \\`Prefer: respond-async\\` (202 and a job\n+  link at once) or \\`Prefer: wait=<maxSeconds>\\`; a paid call with neither\n+  is answered 400 before any payment. agent402-client sends the header for you.\n+- \\`v1-images-fast\\` and \\`v1-images-pro\\` take \\`Prefer: respond-async\\` on\n+  request. They answer in seconds, so waiting on the connection also works.\n+- Every other stage answers on the connection, and the header is ignored there.\n+\n+Poll \\`GET /api/jobs/{id}\\` (free), waiting \\`Retry-After\\` between polls,\n+until \\`status\\` is \\`completed\\` or \\`failed\\`. A client address runs\n+${ASYNC_JOBS_PER_CLIENT} jobs at once, so a batch of research reports is a queue\n+on your side.\n+\n+### Spend caps\n+\n+\\`maxPerCallUsd\\`, \\`dailyLimitUsd\\` and \\`maxPerHostUsd\\` are checked before a\n+payment is signed. On the quoted stages (\\`tts\\`, \\`tts-hd\\`, \\`dub\\`, metered\n+chat) the check reads the quote for that request, so a longer script meets\n+the cap before it is paid. A refused call throws \\`SpendingLimitError\\`.\n+The caps live in one client instance: give each worker its own.\n+\n+In agent402-mcp, \\`AGENT402_MAX_PER_CALL\\` and \\`AGENT402_BUDGET\\` set the\n+per-call and session ceilings.\n+\n+### At volume\n+\n+A pipeline that renders hundreds of episodes meets the per-address limits,\n+retries and replay rules on [buying at volume](/guides/buying-at-volume):\n+send an \\`Idempotency-Key\\` per stage so a retried stage returns its first\n+answer instead of paying twice, and wait \\`Retry-After\\` on a 429 or 503.\n+\n+### Choosing a rail\n+\n+${PIPELINE_TOKEN} run long enough that they take x402 exact on\n+EVM chains only; their /api/pricing rows list those \\`networks\\`. Every other\n+stage here takes every offered chain, over x402 or MPP.\n+\n+| Rail | When it settles | A stage that fails |\n+|---|---|---|\n+| x402 exact on an EVM chain | after the tool answers, only for a response under 400 | not charged |\n+| x402 exact on Solana | after the tool answers, only for a response under 400 | not charged |\n+| MPP \\`evm\\` charge | the same x402 settlement underneath | not charged |\n+| MPP Tempo pull (a signed transaction) | broadcast after the tool answers, only for a response under 400 | not charged on Tempo pull: the transaction is never broadcast |\n+| MPP Tempo push (a transfer already sent) | final before the call runs | the transfer is booked as a refund owed to the paying wallet, repaid after on-chain proof |\n+\n+Tempo is offered on every stage except ${PIPELINE_TOKEN}. A\n+pull credential (\\`payload\\` type \\`transaction\\`) is a signed transaction\n+the relay broadcasts only once the stage has answered under 400, so a stage\n+that fails is never broadcast. A push credential (\\`payload\\` type \\`hash\\`)\n+is a transfer you already sent: it is final before the stage runs, so a stage\n+that fails then is repaid from the refund ledger. For a pipeline, pay with\n+pull credentials: pin \\`mode: \"pull\"\\` on the Tempo charge method, since a\n+JSON-RPC wallet account sends push by default. If your connection closes\n+before the answer, a pull payment can still be broadcast, and it is then\n+booked as owed in the same way.\n+\n+\\`\\`\\`js\n+import { Mppx, tempo } from \"mppx/client\";\n+import { privateKeyToAccount } from \"viem/accounts\";\n+\n+const account = privateKeyToAccount(process.env.AGENT_KEY);\n+const mpp = Mppx.create({ methods: [tempo.charge({ account, mode: \"pull\" })], polyfill: false });\n+const res = await mpp.fetch(\"https://agent402.tools/api/tts\", {\n+  method: \"POST\",\n+  headers: { \"Content-Type\": \"application/json\" },\n+  body: JSON.stringify({ text: \"Hello from Agent402!\", voice: \"alloy\", format: \"mp3\" }),\n+});\n+console.log(res.status, res.headers.get(\"payment-receipt\"));\n+\\`\\`\\`\n+\n+The agent402-client caps read x402 quotes. On Tempo, compare each\n+challenge's amount with your own ceiling before your MPP client pays it. The\n+MPP methods this instance offers are listed at\n+[/.well-known/x402](https://agent402.tools/.well-known/x402), and the wire\n+itself is in [x402 and MPP](/guides/x402-and-mpp).\n `,\n   },\n   {"},{"sha":"7ecd0ff496dcc0c62bdae6b0be07d86fda15a36d","filename":"src/idempotency-store.js","status":"modified","additions":4,"deletions":0,"changes":4,"blob_url":"https://github.com/MikeyPetrillo/Agent402/blob/81a674d1a3cf7fdbbcc04f4da366c144ccd393f7/src%2Fidempotency-store.js","raw_url":"https://github.com/MikeyPetrillo/Agent402/raw/81a674d1a3cf7fdbbcc04f4da366c144ccd393f7/src%2Fidempotency-store.js","contents_url":"https://api.github.com/repos/MikeyPetrillo/Agent402/contents/src%2Fidempotency-store.js?ref=81a674d1a3cf7fdbbcc04f4da366c144ccd393f7","patch":"@@ -24,6 +24,10 @@ const PREFIX = \"idem:\";\n // for minutes); a crashed holder's claim lapses within this.\n const INFLIGHT_TTL_SECONDS = 120;\n export const INFLIGHT_RENEW_MS = 30_000;\n+// The longest a claim is held for a run whose response never ends (the\n+// middleware releases it when the run ends; this bounds a handler that hangs).\n+// IDEM_INFLIGHT_MAX_MS overrides it.\n+export const INFLIGHT_MAX_MS = (() => { const n = Number(process.env.IDEM_INFLIGHT_MAX_MS); return Number.isFinite(n) && n >= 1000 ? n : 2 * 60 * 60 * 1000; })();\n \n export function createLocalIdempotencyStore({ ttlMs = IDEM_TTL_MS, maxEntries = IDEM_MAX_ENTRIES, maxBytes = IDEM_MAX_BYTES } = {}) {\n   const entries = new Map(); // key -> { at, body, bytes }"},{"sha":"e200c50c9081eaef4f6624aa0473a58c93e9b8d2","filename":"src/idempotency.js","status":"modified","additions":68,"deletions":6,"changes":74,"blob_url":"https://github.com/MikeyPetrillo/Agent402/blob/81a674d1a3cf7fdbbcc04f4da366c144ccd393f7/src%2Fidempotency.js","raw_url":"https://github.com/MikeyPetrillo/Agent402/raw/81a674d1a3cf7fdbbcc04f4da366c144ccd393f7/src%2Fidempotency.js","contents_url":"https://api.github.com/repos/MikeyPetrillo/Agent402/contents/src%2Fidempotency.js?ref=81a674d1a3cf7fdbbcc04f4da366c144ccd393f7","patch":"@@ -4,7 +4,7 @@\n import { createHash } from \"node:crypto\";\n import { paymentHeaderOf, paymentIdentifierOf, paymentNonceIdentityOf } from \"./payer.js\";\n import { IDEM_MAX_BODY_BYTES } from \"./idempotency-limits.js\";\n-import { createIdempotencyStore, IDEM_TTL_MS, INFLIGHT_RENEW_MS } from \"./idempotency-store.js\";\n+import { createIdempotencyStore, IDEM_TTL_MS, INFLIGHT_RENEW_MS, INFLIGHT_MAX_MS } from \"./idempotency-store.js\";\n import { onResponseEnd } from \"./hangup-settlement.js\";\n import { allowanceServed } from \"./allowance-state.js\";\n \n@@ -23,15 +23,38 @@ export function implicitReplayAllowed(def, req, { hasLastingEffect, isIdentityBo\n   return Boolean(def) && !hasLastingEffect(def.slug) && !isIdentityBound(def) && req?.body?.stream !== true;\n }\n \n+/** What a resend of a charged-but-undelivered answer gets (src/server.js\n+ *  onReplay). Its debt is voided BEFORE the answer goes out, so a buyer is\n+ *  served once, never both served and refunded:\n+ *   - \"serve\": the void landed, or there is no row, or the row is already void;\n+ *   - \"refunded\": the refund run has claimed or paid the row (`row`);\n+ *   - \"pending\": the void did not land and the row still reads owed. The\n+ *     ledger write failed or is queued (a queued void lands later), so\n+ *     refusing as refunded would leave the buyer neither served nor repaid;\n+ *     the resend is asked to retry, and then reads whichever landed.\n+ *  voidOnClaim(tx) and rowOf(tx) are the ledger's voidOwedOnClaim and\n+ *  refundByEvidenceFresh; either may throw or answer a promise. */\n+export async function chargedReplayVerdict(tx, { voidOnClaim, rowOf }) {\n+  let voided = false;\n+  try { voided = (await voidOnClaim(tx)) === true; } catch { voided = false; }\n+  if (voided) return { verdict: \"serve\", voided: true };\n+  let row = null;\n+  try { row = await rowOf(tx); } catch { row = null; }\n+  if (!row || row.status === \"void\") return { verdict: \"serve\", voided: false };\n+  if (row.status === \"owed\") return { verdict: \"pending\", row };\n+  return { verdict: \"refunded\", row };\n+}\n+\n /** isCatalogRoute(req): true for a priced catalog route. freeMode: dev/test boot with no paywall.\n  *  implicitReplay(req): true when a re-sent x402 payment on this route may be\n  *  answered from its first answer (the server excludes routes with a lasting\n  *  effect and streamed calls); absent, no implicit key is derived.\n  *  onReplay(req, { implicit, key, charged }): awaited once per stored answer\n  *  before it is served; `charged` names the charge ({ tx, network, wire }) when\n  *  the stored answer was charged and never delivered (see below), else null.\n- *  Resolving { serve: false, status, body } answers that instead of the stored\n- *  body (the charge was refunded); any other result serves it. */\n+ *  Resolving { serve: false, status, body, retryAfter? } answers that instead\n+ *  of the stored body (the charge was refunded, or its debt's void has not\n+ *  landed yet); any other result serves it. */\n export function createIdempotency({ isCatalogRoute, freeMode = false, store = createIdempotencyStore(), implicitReplay = null, onReplay = null }) {\n   // Opt-in idempotency (safe retry for paid/proven calls). If a client sends an\n   // `Idempotency-Key`, a successful gated call is cached keyed by that key + the\n@@ -138,6 +161,7 @@ export function createIdempotency({ isCatalogRoute, freeMode = false, store = cr\n         let verdict;\n         try { verdict = await onReplay(req, { implicit, key, charged }); } catch { verdict = undefined; }\n         if (verdict && typeof verdict === \"object\" && verdict.serve === false) {\n+          if (Number(verdict.retryAfter) > 0) res.setHeader(\"Retry-After\", String(Math.ceil(Number(verdict.retryAfter))));\n           return res.status(Number(verdict.status) || 402).json(verdict.body && typeof verdict.body === \"object\" ? verdict.body : { error: \"replay_refused\" });\n         }\n       }\n@@ -163,9 +187,47 @@ export function createIdempotency({ isCatalogRoute, freeMode = false, store = cr\n           : \"A call with this Idempotency-Key, credential and body is still running. Retry shortly with the same Idempotency-Key to receive its answer; this request was not charged.\",\n       });\n     }\n+    // The claim lives as long as the RUN, not the connection. A client that\n+    // times out closes its socket while the handler is still going; releasing\n+    // on that close let its retry (same key, same reusable credential) find no\n+    // answer and a free claim, so the handler ran twice and a credits key was\n+    // debited twice. The run ends when the response is ended (the handler, or\n+    // the gate after it settles, calls res.end). The claim is released only\n+    // after the answer that run committed has been written, so a retry finds\n+    // the claim (409) or the stored answer, never neither. Renewals stop at the\n+    // same point; INFLIGHT_MAX_MS bounds a run that never ends, and the store's\n+    // claim TTL bounds a process that dies.\n+    let pendingSet = null;\n+    let ended = false;\n+    let released = false;\n     const renew = setInterval(() => { store.renew(key).catch(() => {}); }, INFLIGHT_RENEW_MS);\n     renew.unref?.();\n-    res.once(\"close\", () => { clearInterval(renew); store.release(key).catch(() => {}); });\n+    let maxTimer = null;\n+    const releaseClaim = () => {\n+      if (released) return;\n+      released = true;\n+      clearInterval(renew);\n+      clearTimeout(maxTimer);\n+      Promise.resolve(pendingSet).catch(() => {}).then(() => store.release(key)).catch(() => {});\n+    };\n+    maxTimer = setTimeout(releaseClaim, INFLIGHT_MAX_MS);\n+    maxTimer.unref?.();\n+    const socketGone = () => Boolean(res.destroyed || !res.socket || res.socket.destroyed);\n+    const priorEnd = res.end;\n+    res.end = function idempotencyAwareEnd(...args) {\n+      const out = priorEnd.apply(this, args);\n+      if (!ended) {\n+        ended = true;\n+        // Ended on a live socket: \"finish\" commits, then releases. Ended after\n+        // the client left (no \"finish\" comes): an undelivered commit ran inside\n+        // the call above, so release once its write lands.\n+        if (socketGone()) setImmediate(releaseClaim);\n+      }\n+      return out;\n+    };\n+    // The socket closed after the response was ended (its \"finish\" may never\n+    // come): the run is over. A close before the end leaves the claim held.\n+    res.once(\"close\", () => { if (ended) setImmediate(releaseClaim); });\n     // Settlement-aware caching (FR4-01). @x402/express (v2.16) runs the handler\n     // FIRST, then settles, and ONLY on a <400 response; on settlement FAILURE it\n     // replaces the buffered 200 with a 402. So committing to the cache at\n@@ -214,9 +276,9 @@ export function createIdempotency({ isCatalogRoute, freeMode = false, store = cr\n       let bytes = 0;\n       try { bytes = Buffer.byteLength(JSON.stringify(stored), \"utf8\"); } catch { bytes = 0; }\n       if (!bytes || bytes > IDEM_MAX_BODY_BYTES) return;\n-      store.set(key, stored, bytes).catch(() => {});\n+      pendingSet = store.set(key, stored, bytes).catch(() => {});\n     };\n-    res.on(\"finish\", () => commit());\n+    res.on(\"finish\", () => { commit(); releaseClaim(); });\n     // CHARGED BUT NEVER DELIVERED. A buyer that leaves before the first byte\n     // while its payment settles is charged (no ticket, or the close landed\n     // inside the settle call) and Node emits no \"finish\" for the response the"},{"sha":"510ddd545e3f691cb1d319c820a60a273f6f2882","filename":"src/integration-pages.js","status":"modified","additions":3,"deletions":3,"changes":6,"blob_url":"https://github.com/MikeyPetrillo/Agent402/blob/81a674d1a3cf7fdbbcc04f4da366c144ccd393f7/src%2Fintegration-pages.js","raw_url":"https://github.com/MikeyPetrillo/Agent402/raw/81a674d1a3cf7fdbbcc04f4da366c144ccd393f7/src%2Fintegration-pages.js","contents_url":"https://api.github.com/repos/MikeyPetrillo/Agent402/contents/src%2Fintegration-pages.js?ref=81a674d1a3cf7fdbbcc04f4da366c144ccd393f7","patch":"@@ -512,7 +512,7 @@ claude mcp add agent402 -e AGENT_KEY=0x... -- npx -y agent402-mcp@0.13.31\n       \"`AGENT402_MAX_PER_CALL` is on by default ($4 per call, `off` disables it) and `AGENT402_BUDGET` is an opt-in session cap; both are enforced on the payment that is signed. The hosted /mcp connector is also payable over MPP from an mppx-wrapped MCP client.\",\n     ],\n     tools: [\"search\", \"answer\", \"search-news\", \"render\", \"stock-quote\", \"transcribe\"],\n-    guides: [\"agent-hosts\", \"x402-and-mpp\"],\n+    guides: [\"agent-hosts\", \"x402-and-mpp\", \"buying-at-volume\"],\n     learn: [\"mcp-payments\", \"mpp\"],\n   },\n   {\n@@ -560,7 +560,7 @@ const verdict = await a.call(\"sql-guard\", { sql: \"UPDATE users SET plan = 'pro'\n       `\\`creditsKey\\`: ${CREDITS_HELD} (\\`a402_...\\`) pays from its balance, debited only on a 200.`,\n     ],\n     tools: [\"extract\", \"hash\", \"sql-guard\", \"whois\", \"search\"],\n-    guides: [\"x402-in-5-minutes\", \"x402-and-mpp\"],\n+    guides: [\"x402-in-5-minutes\", \"x402-and-mpp\", \"buying-at-volume\"],\n     learn: [\"pay-per-call-api\", \"agent-payments\"],\n   },\n   {\n@@ -650,7 +650,7 @@ npx agent402-openclaw proxy   # http://127.0.0.1:8412/v1, model \"auto\"`,\n       \"The proxy answers loopback only and refuses browser-originated requests, so a web page cannot spend the key.\",\n     ],\n     tools: [\"v1-chat-metered\", \"v1-chat\", \"v1-embeddings\", \"search\", \"answer\"],\n-    guides: [\"openclaw-model-provider\", \"agent-hosts\"],\n+    guides: [\"openclaw-model-provider\", \"agent-hosts\", \"buying-at-volume\"],\n     learn: [\"pay-per-call-api\", \"agent-payments\"],\n   },\n ];"},{"sha":"adeafd89888f27ada540416213ea9c4dedb88af5","filename":"src/large-body-gate.js","status":"modified","additions":3,"deletions":0,"changes":3,"blob_url":"https://github.com/MikeyPetrillo/Agent402/blob/81a674d1a3cf7fdbbcc04f4da366c144ccd393f7/src%2Flarge-body-gate.js","raw_url":"https://github.com/MikeyPetrillo/Agent402/raw/81a674d1a3cf7fdbbcc04f4da366c144ccd393f7/src%2Flarge-body-gate.js","contents_url":"https://api.github.com/repos/MikeyPetrillo/Agent402/contents/src%2Flarge-body-gate.js?ref=81a674d1a3cf7fdbbcc04f4da366c144ccd393f7","patch":"@@ -30,6 +30,9 @@\n // A route's own parser still enforces its limit with a 413; a body declared\n // over that limit is left to it and reserves nothing.\n export const UNPAID_BODY_MAX_BYTES = 100 * 1024;\n+// The unpaid limiter server.js builds over these bodies (per client address; no\n+// raise once the address has paid). Read by server.js and the buying-at-volume guide.\n+export const UNPAID_LIMITS = Object.freeze({ PER_MIN: 60, PER_HOUR: 1200 });\n export const DEFAULT_INFLIGHT_MAX_BYTES = 256 * 1024 * 1024;\n \n export function largeBodyInflightMaxBytes(env = process.env) {"},{"sha":"6f8212a629ac731777ccee6a9ae30ced02114d2d","filename":"src/late-settlements.js","status":"modified","additions":231,"deletions":17,"changes":248,"blob_url":"https://github.com/MikeyPetrillo/Agent402/blob/81a674d1a3cf7fdbbcc04f4da366c144ccd393f7/src%2Flate-settlements.js","raw_url":"https://github.com/MikeyPetrillo/Agent402/raw/81a674d1a3cf7fdbbcc04f4da366c144ccd393f7/src%2Flate-settlements.js","contents_url":"https://api.github.com/repos/MikeyPetrillo/Agent402/contents/src%2Flate-settlements.js?ref=81a674d1a3cf7fdbbcc04f4da366c144ccd393f7","patch":"@@ -49,13 +49,20 @@ import { evmRpcFor } from \"./evm-rpcs.js\";\n import { authorizationUsed, findAuthorizationTx, blockNear } from \"./robinhood-outage.js\";\n import { ownFirstAttemptOf } from \"./robinhood-order.js\";\n import { pendingNotedTxsFor, takePendingAnswers, peekPendingAnswers, receiptUsesAuthorization } from \"./pending-settle.js\";\n+import { stripControlChars as oneLine } from \"./prepayment-refusal.js\";\n \n const ADDR = /^0x[0-9a-fA-F]{40}$/;\n const TX = /^0x[0-9a-fA-F]{64}$/;\n const TEMPO_NETWORK = \"eip155:4217\";\n \n export const SETTLED_AFTER_402 = \"settled_after_402\";\n+/** The bound on OPEN (pending) entries. Unresolved entries wait for a human\n+ *  and never count toward it, so they cannot crowd out a new booking. */\n export const MAX_ENTRIES = 2000;\n+/** The word reads near_capacity from this share of the bound. */\n+export const NEAR_CAPACITY_SHARE = 0.8;\n+/** How long the status word's read of the shared store is reused. */\n+export const STATUS_TTL_MS = 10_000;\n /** How long an absent transaction is looked for before it is closed. */\n export const WINDOW_MS = 60 * 60_000;\n export const FIRST_CHECK_MS = 30_000;\n@@ -69,6 +76,21 @@ export const MAX_PASS_MS = 60_000;\n /** The lease: the pass budget, plus one RPC read that started inside it, plus margin. */\n export const RECONCILE_LEASE_MS = MAX_PASS_MS + 60_000;\n const RPC_TIMEOUT_MS = 8_000;\n+/** An unresolved entry is read on chain again this often (a slow cadence), so\n+ *  one that later shows as settled, reverted or absent resolves itself. */\n+export const UNRESOLVED_RECHECK_MS = 6 * 3600_000;\n+/** At most this many unresolved entries are re-read per pass. */\n+export const UNRESOLVED_RECHECK_PER_PASS = 5;\n+/** A booking recorded nowhere reads `unresolved` for this long after it\n+ *  happened, unless an operator acknowledges it first. */\n+export const UNRECORDED_WINDOW_MS = 24 * 3600_000;\n+// Most unrecorded-booking times the resolutions document keeps.\n+const UNRECORDED_KEPT = 200;\n+/** How many operator resolutions the resolution record keeps. */\n+export const RESOLUTIONS_KEPT = 500;\n+/** What an operator may resolve an unresolved entry as. */\n+export const OPERATOR_OUTCOMES = Object.freeze([\"booked_owed\", \"paid\", \"dismissed\"]);\n+const KEY_RE = /^eip155:[0-9]{1,12}\\|(?:0x[0-9a-f]{64}|auth\\|0x[0-9a-f]{40}\\|0x[0-9a-f]{64})$/;\n \n /** The route slug a refund row names, from the resource URL the buyer paid. */\n function slugOf(resourceUrl) {\n@@ -222,6 +244,64 @@ export function createLateSettleBook({\n     return !!r.ok;\n   };\n   const entries = () => Object.values(state.pending);\n+  const openCount = (pending = state.pending) => Object.values(pending).filter((e) => e?.state !== \"unresolved\").length;\n+  // Bookings neither the store nor the journal took, in this process (the\n+  // alarm line names each one): when each happened. The word reads\n+  // unresolved while one is inside UNRECORDED_WINDOW_MS and not acknowledged.\n+  let unrecordedAt = [];\n+  const unrecordedRecent = () => {\n+    const cut = now() - UNRECORDED_WINDOW_MS;\n+    unrecordedAt = unrecordedAt.filter((t) => t > cut);\n+    return unrecordedAt.length;\n+  };\n+  // Every operator resolution, kept in its own document (the book's body is\n+  // { pending } only, so an older build's writes never drop the record).\n+  const resolutionsDoc = createJsonDocument({ name: \"late-settlements-resolutions\", file: `${file}.resolutions.json`, log: () => {} });\n+  const resolutionsReady = resolutionsDoc.backend === \"pg\" ? resolutionsDoc.load(null).catch(() => null) : Promise.resolve();\n+  const recordResolution = async (row, { clearUnrecorded = false } = {}) => {\n+    await resolutionsReady;\n+    const r = await resolutionsDoc.update((b) => {\n+      const body = b && typeof b === \"object\" ? b : {};\n+      const list = Array.isArray(body.resolutions) ? body.resolutions : [];\n+      return { ...body, resolutions: [...list, row].slice(-RESOLUTIONS_KEPT), ...(clearUnrecorded ? { unrecorded: [] } : {}) };\n+    }, { fallback: null });\n+    return !!r?.ok;\n+  };\n+  // An unrecorded booking's time is also written to the resolutions document,\n+  // so the word outlives a restart or deploy. When it fires the store is\n+  // usually refusing too, so a write that did not land is retried on the next\n+  // status read; until it lands, this process's memory holds it.\n+  let unrecordedUnsaved = false;\n+  const saveUnrecorded = async () => {\n+    try {\n+      await resolutionsReady;\n+      const cut = now() - UNRECORDED_WINDOW_MS;\n+      const mine = unrecordedAt.slice();\n+      const r = await resolutionsDoc.update((b) => {\n+        const body = b && typeof b === \"object\" ? b : {};\n+        const had = Array.isArray(body.unrecorded) ? body.unrecorded : [];\n+        const merged = [...new Set([...had, ...mine].map(Number))].filter((t) => Number.isFinite(t) && t > cut).sort((x, y) => x - y).slice(-UNRECORDED_KEPT);\n+        return { ...body, unrecorded: merged };\n+      }, { fallback: null });\n+      unrecordedUnsaved = !r?.ok;\n+    } catch { unrecordedUnsaved = true; }\n+  };\n+  const savedUnrecordedRecent = async () => {\n+    try {\n+      await resolutionsReady;\n+      const b = resolutionsDoc.backend === \"pg\" ? await resolutionsDoc.load(null) : resolutionsDoc.loadSync(null);\n+      const cut = now() - UNRECORDED_WINDOW_MS;\n+      return (Array.isArray(b?.unrecorded) ? b.unrecorded : []).filter((t) => Number(t) > cut).length;\n+    } catch { return 0; }\n+  };\n+  const readResolutions = async () => {\n+    try {\n+      await resolutionsReady;\n+      const b = resolutionsDoc.backend === \"pg\" ? await resolutionsDoc.load(null) : resolutionsDoc.loadSync(null);\n+      return Array.isArray(b?.resolutions) ? b.resolutions : [];\n+    } catch { return []; }\n+  };\n+  let wordCache = { at: 0, word: null };\n   let journalImpl = journal;\n   const journalOf = async () => {\n     if (journalImpl) return journalImpl;\n@@ -230,16 +310,34 @@ export function createLateSettleBook({\n     journalImpl = createDeadLetter({ file: `${file}.pending.ndjson`, name: \"lateSettlements\", journalKey: PG ? `${stateDbSchema()}:lateSettlements` : \"\" });\n     return journalImpl;\n   };\n-  const write = async (entry) => {\n-    try { return await change((p) => { if (!p[entry.key]) p[entry.key] = entry; }); } catch { return false; }\n+  // One entry into the store: \"made\" (or already there), \"full\" (the open\n+  // bound is reached), or \"failed\" (the write did not land).\n+  const put = async (entry) => {\n+    let out = \"failed\";\n+    let wrote = false;\n+    try {\n+      wrote = await change((p) => {\n+        if (p[entry.key]) { out = \"made\"; return; }\n+        if (openCount(p) >= maxEntries) { out = \"full\"; return; }\n+        p[entry.key] = entry;\n+        out = \"made\";\n+      });\n+    } catch { wrote = false; }\n+    if (out === \"full\") return \"full\";\n+    return out === \"made\" && wrote === true ? \"made\" : \"failed\";\n+  };\n+  const journalCount = async () => {\n+    const j = await journalOf();\n+    const st = typeof j?.state === \"function\" ? j.state() : null;\n+    return Number(st?.total ?? (typeof j?.size === \"function\" ? j.size() : 0)) || 0;\n   };\n   // Lands what the journal holds (a booking whose store write failed earlier,\n   // in this process or one that has since stopped).\n   const drainJournal = async () => {\n     let j;\n     try { j = await journalOf(); } catch { return 0; }\n     if (!j || !(j.size?.() > 0)) return 0;\n-    try { return await j.drain(async (e) => (e?.payload?.key ? ((await write(e.payload)) ? \"landed\" : \"stop\") : \"drop\")); } catch { return 0; }\n+    try { return await j.drain(async (e) => (e?.payload?.key ? ((await put(e.payload)) === \"made\" ? \"landed\" : \"stop\") : \"drop\")); } catch { return 0; }\n   };\n   const call = (url, method, params) => rpc(url, method, params, fetchImpl, RPC_TIMEOUT_MS, []);\n \n@@ -263,75 +361,184 @@ export function createLateSettleBook({\n       const key = byAuth ? lateAuthKey(network, c.payer, c.nonce) : lateKey(network, c.tx);\n       await refresh();\n       if (state.pending[key]) return true;\n-      if (entries().length >= maxEntries) {\n-        log(`[late-settle] book is full (${maxEntries}); ${network} ${byAuth ? `auth ${c.payer}/${c.nonce}` : `tx ${c.tx}`} NOT booked - resolve the unresolved entries`);\n-        return false;\n-      }\n       const t = now();\n       const entry = {\n         key, network, tx: byAuth ? null : String(c.tx).toLowerCase(), ...(byAuth ? { nonce: String(c.nonce).toLowerCase() } : {}), payer: String(c.payer), payTo: String(c.payTo), asset: String(c.asset),\n         amount: String(c.amount), validBefore: validBeforeOf(c.validBefore), slug: slugOf(c.resource), via: String(c.via || \"primary\").slice(0, 60),\n         ...(!byAuth && NONCE.test(String(c.authNonce || \"\")) ? { authNonce: String(c.authNonce).toLowerCase() } : {}),\n         at: t, nextCheckAt: t + FIRST_CHECK_MS, checks: 0, unreadable: 0, failures: 0, state: \"pending\",\n       };\n-      if (await write(entry)) {\n+      const r = await put(entry);\n+      if (r === \"made\") {\n         log(byAuth\n           ? `[late-settle] ${network} authorization ${c.payer} nonce ${c.nonce} (via ${entry.via}): outcome unknown; booked until it is read on chain`\n           : `[late-settle] ${network} settlement failed naming tx ${c.tx} (via ${entry.via}); booked until its receipt is read`);\n         return true;\n       }\n-      // The store did not take it: kept in the journal and landed by the next\n-      // reconcile pass, never dropped in silence.\n+      // The store did not take it (its write failed, or the open bound is\n+      // reached): kept in the journal and landed by a later reconcile pass\n+      // once the store takes it, never dropped in silence.\n+      wordCache = { at: 0, word: null };\n       let id = null;\n       try { const j = await journalOf(); id = j ? j.add(\"late\", entry) : null; } catch { id = null; }\n       if (id == null) {\n+        unrecordedAt.push(now());\n+        unrecordedUnsaved = true;\n+        saveUnrecorded().catch(() => {});\n         alarm(`[late-settle] ${network} ${byAuth ? `auth ${c.payer}/${c.nonce}` : `tx ${c.tx}`} failed and could NOT be recorded (store and journal both refused); if it lands the buyer is owed ${entry.amount} of ${entry.asset} from ${entry.payer}`);\n         return false;\n       }\n-      log(`[late-settle] ${network} ${byAuth ? `auth ${c.payer}/${c.nonce}` : `tx ${c.tx}`} (via ${entry.via}): the store write failed; kept in the journal until the next reconcile lands it`);\n+      log(r === \"full\"\n+        ? `[late-settle] book is full (${maxEntries} open); ${network} ${byAuth ? `auth ${c.payer}/${c.nonce}` : `tx ${c.tx}`} (via ${entry.via}) kept in the journal until there is room`\n+        : `[late-settle] ${network} ${byAuth ? `auth ${c.payer}/${c.nonce}` : `tx ${c.tx}`} (via ${entry.via}): the store write failed; kept in the journal until the next reconcile lands it`);\n       return true;\n     },\n     /** The entries as last read; call refresh() first for the shared view. */\n     list() { return entries(); },\n+    /**\n+     * One word for /api/gateway-status, read from the shared store (reused\n+     * for STATUS_TTL_MS): full (the open bound is reached, so new bookings\n+     * wait in the journal), unresolved (an entry waits for a human, a booking\n+     * sits in the journal outside the book, or one could not be recorded\n+     * anywhere), near_capacity, or ok. Never a number.\n+     */\n+    async alarmStatus({ ttlMs = STATUS_TTL_MS } = {}) {\n+      const t = now();\n+      if (wordCache.word && t - wordCache.at < ttlMs) return wordCache.word;\n+      await refresh();\n+      const open = openCount();\n+      let journaled = 0;\n+      try { journaled = await journalCount(); } catch { journaled = 1; }\n+      let word = \"ok\";\n+      if (unrecordedUnsaved && unrecordedRecent() > 0) await saveUnrecorded();\n+      const unrecorded = Math.max(unrecordedRecent(), await savedUnrecordedRecent());\n+      if (open >= maxEntries) word = \"full\";\n+      else if (unrecorded > 0 || journaled > 0 || entries().some((e) => e.state === \"unresolved\")) word = \"unresolved\";\n+      else if (open >= Math.ceil(maxEntries * NEAR_CAPACITY_SHARE)) word = \"near_capacity\";\n+      wordCache = { at: t, word };\n+      return word;\n+    },\n     /** Operator view from the shared store: every open entry, no amounts. */\n     async operatorView() {\n       await refresh();\n       const all = entries();\n+      let journaled = null;\n+      try { journaled = await journalCount(); } catch { journaled = null; }\n       return {\n+        status: await this.alarmStatus({ ttlMs: 0 }),\n         total: all.length,\n         bound: maxEntries,\n         unresolved: all.filter((e) => e.state === \"unresolved\").length,\n-        open: all.map((e) => ({ key: e.key, network: e.network, tx: e.tx, slug: e.slug, via: e.via, state: e.state, at: e.at, checks: e.checks })),\n+        journaled,\n+        unrecordedInMemory: unrecordedRecent(),\n+        open: all.map((e) => ({ key: e.key, network: e.network, tx: e.tx, slug: e.slug, via: e.via, state: e.state, at: e.at, checks: e.checks, ...(e.state === \"unresolved\" ? { unresolvedAt: e.unresolvedAt ?? null, recheckAt: e.recheckAt ?? null } : {}) })),\n+        // The latest operator resolutions (no amounts), newest last.\n+        resolutions: (await readResolutions()).slice(-20).map((r) => ({ key: r.key, outcome: r.outcome, tx: r.tx ?? null, note: r.note, at: r.at })),\n+        resolve: 'POST /__operator/late-settlements {\"action\":\"resolve\",\"key\":\"<open[].key>\",\"outcome\":\"booked_owed\"|\"paid\"|\"dismissed\",\"note\":\"what was checked\",\"tx\":\"0x... (paid: the refund transfer; booked_owed: the landed transfer when the entry names none)\"} or {\"action\":\"acknowledge_unrecorded\",\"note\":\"...\"}',\n       };\n     },\n+    /**\n+     * An operator resolves an UNRESOLVED entry, with a note saying what was\n+     * checked: booked_owed (the transfer landed: the debt is written to the\n+     * refund ledger, keyed by the transfer, and the entry closes only once\n+     * the ledger holds it), paid (the buyer was already repaid: `tx` is the\n+     * refund transfer), or dismissed (nothing moved to us). Every resolution\n+     * is written to the resolution record before the entry is dropped, and\n+     * logged. A pending entry is the reconcile pass's, never an operator's.\n+     */\n+    async resolve(key, { outcome, note, tx = null, decimals = null } = {}) {\n+      if (typeof note !== \"string\" || !note.trim()) return { ok: false, error: \"a note saying what was checked is required\" };\n+      if (!OPERATOR_OUTCOMES.includes(outcome)) return { ok: false, error: `outcome must be ${OPERATOR_OUTCOMES.join(\", \")}` };\n+      const k = String(key || \"\");\n+      await refresh();\n+      const e = KEY_RE.test(k) && Object.hasOwn(state.pending, k) ? state.pending[k] : null;\n+      if (!e) return { ok: false, error: \"no such entry\" };\n+      if (e.state !== \"unresolved\") return { ok: false, error: \"the entry is still pending: the reconcile pass resolves it\" };\n+      const given = tx == null || tx === \"\" ? null : String(tx).toLowerCase();\n+      if (given != null && !TX.test(given)) return { ok: false, error: \"tx must be a 0x-prefixed 32-byte transaction hash\" };\n+      if (outcome === \"paid\" && !given) return { ok: false, error: \"paid needs tx: the refund transfer\" };\n+      let evidence = null;\n+      if (outcome === \"booked_owed\") {\n+        evidence = e.tx || given;\n+        if (!evidence) return { ok: false, error: \"booked_owed needs tx: the transfer that landed (the entry names none)\" };\n+        let dec = decimals == null || decimals === \"\" ? null : Number(decimals);\n+        if (dec != null && !(Number.isInteger(dec) && dec >= 0 && dec <= 36)) return { ok: false, error: \"decimals must be an integer from 0 to 36\" };\n+        if (dec == null) {\n+          try {\n+            const url = rpcFor(e.network);\n+            dec = Number(BigInt(await call(url, \"eth_call\", [{ to: e.asset, data: \"0x313ce567\" }, \"latest\"]) || \"0x0\"));\n+          } catch { dec = null; }\n+          if (!(Number.isInteger(dec) && dec >= 0 && dec <= 36)) return { ok: false, error: \"the token's decimals could not be read; pass decimals\" };\n+        }\n+        await recordOwed({\n+          slug: e.slug, network: e.network, payer: e.payer, priceUsd: Number(e.amount) / 10 ** dec,\n+          tx: evidence, httpStatus: 402, wire: \"x402\",\n+          note: `${SETTLED_AFTER_402}: booked by an operator: ${note.trim().slice(0, 120)}`,\n+        });\n+        if (!(await owedRecorded(evidence).catch(() => false))) return { ok: false, error: \"the refund ledger did not take the debt; the entry is kept\" };\n+      }\n+      const row = { key: e.key, network: e.network, tx: outcome === \"paid\" ? given : evidence || e.tx || null, outcome, note: note.trim().slice(0, 300), at: now() };\n+      if (!(await recordResolution(row).catch(() => false))) return { ok: false, error: \"the resolution could not be recorded; the entry is kept\" };\n+      let dropped = false;\n+      try { dropped = await change((p) => { if (p[e.key]?.state === \"unresolved\") delete p[e.key]; }); } catch { dropped = false; }\n+      if (!dropped) return { ok: false, error: \"the book could not be written; the entry is kept\" };\n+      wordCache = { at: 0, word: null };\n+      log(`[late-settle] operator resolved ${e.network} ${labelOf(e)} as ${outcome}: ${oneLine(row.note).slice(0, 200)}`);\n+      return { ok: true, key: e.key, outcome };\n+    },\n+    /** An operator acknowledges every unrecorded booking: this process's\n+     *  memory and the saved times every replica reads (each one was named in\n+     *  its alarm line); recorded like a resolution. */\n+    async acknowledgeUnrecorded({ note } = {}) {\n+      if (typeof note !== \"string\" || !note.trim()) return { ok: false, error: \"a note saying what was checked is required\" };\n+      const count = Math.max(unrecordedRecent(), await savedUnrecordedRecent());\n+      if (!(await recordResolution({ key: \"unrecorded\", network: null, tx: null, outcome: \"acknowledged\", note: note.trim().slice(0, 300), at: now() }, { clearUnrecorded: true }).catch(() => false))) return { ok: false, error: \"the acknowledgement could not be recorded\" };\n+      unrecordedAt = [];\n+      unrecordedUnsaved = false;\n+      wordCache = { at: 0, word: null };\n+      log(`[late-settle] operator acknowledged ${count} unrecorded booking(s): ${oneLine(note.trim()).slice(0, 200)}`);\n+      return { ok: true, acknowledged: count };\n+    },\n     /**\n      * One reconcile pass over the entries whose next check is due, oldest\n      * first, at most maxChecks of them within maxPassMs. A throw while\n      * handling one entry is counted and that entry backs off; the pass\n      * continues with the next.\n      */\n     async reconcile({ maxChecks = 50, maxPassMs = MAX_PASS_MS } = {}) {\n-      const out = { checked: 0, owed: 0, served: 0, reverted: 0, notOurs: 0, absent: 0, pending: 0, unreadable: 0, unresolved: 0, errors: 0, journaled: 0 };\n+      const out = { checked: 0, owed: 0, served: 0, reverted: 0, notOurs: 0, absent: 0, pending: 0, unreadable: 0, unresolved: 0, rechecked: 0, errors: 0, journaled: 0 };\n       out.journaled = await drainJournal();\n       await refresh();\n       const started = now();\n       const due = entries()\n         .filter((e) => e.state === \"pending\" && (e.nextCheckAt || 0) <= started)\n         .sort((a, b) => (a.nextCheckAt || 0) - (b.nextCheckAt || 0) || a.at - b.at)\n         .slice(0, maxChecks);\n-      for (const e of due) {\n+      // Unresolved entries are read again on a slow cadence, a few per pass,\n+      // so one that later shows as settled (or reverted, or absent) resolves\n+      // itself.\n+      const recheckAt = (e) => Number(e.recheckAt ?? (Number(e.unresolvedAt || e.at || 0) + UNRESOLVED_RECHECK_MS));\n+      const rechecks = entries()\n+        .filter((e) => e.state === \"unresolved\" && recheckAt(e) <= started)\n+        .sort((a, b) => recheckAt(a) - recheckAt(b))\n+        .slice(0, UNRESOLVED_RECHECK_PER_PASS);\n+      for (const e of [...due, ...rechecks]) {\n         if (now() - started >= maxPassMs) break;\n         out.checked++;\n         try {\n           await this._one(e, out);\n         } catch {\n           out.errors++;\n+          if (e.state === \"unresolved\") {\n+            try { await change((p) => { if (p[e.key]) p[e.key] = { ...p[e.key], recheckAt: now() + UNRESOLVED_RECHECK_MS }; }); } catch { /* the next pass retries */ }\n+            continue;\n+          }\n           const failures = (e.failures || 0) + 1;\n           const stuck = failures >= FAILURE_LIMIT;\n           try {\n             await change((p) => {\n               if (!p[e.key]) return;\n-              p[e.key] = { ...p[e.key], failures, nextCheckAt: now() + backoff(failures), ...(stuck ? { state: \"unresolved\", unresolvedAt: now() } : {}) };\n+              p[e.key] = { ...p[e.key], failures, nextCheckAt: now() + backoff(failures), ...(stuck ? { state: \"unresolved\", unresolvedAt: now(), recheckAt: now() + UNRESOLVED_RECHECK_MS } : {}) };\n             });\n           } catch { /* the store itself is failing: the next pass retries */ }\n           if (stuck) { out.unresolved++; log(`[late-settle] ${e.network} ${labelOf(e)} unresolved after ${failures} failed passes; operator action needed`); }\n@@ -413,7 +620,7 @@ export function createLateSettleBook({\n           out.owed++;\n           log(`[late-settle] ${e.network} tx ${e.tx} landed after a 402; booked owed (${SETTLED_AFTER_402})`);\n         } else {\n-          await change((p) => { if (p[e.key]) p[e.key] = { ...p[e.key], failures: 0, nextCheckAt: now() + FIRST_CHECK_MS }; });\n+          await change((p) => { if (p[e.key]) p[e.key] = { ...p[e.key], failures: 0, nextCheckAt: now() + FIRST_CHECK_MS, ...(p[e.key].state === \"unresolved\" ? { recheckAt: now() + FIRST_CHECK_MS } : {}) }; });\n           out.pending++;\n         }\n         return;\n@@ -431,10 +638,17 @@ export function createLateSettleBook({\n         log(`[late-settle] ${e.network} ${labelOf(e)} never mined within ${Math.round(WINDOW_MS / 60_000)} min and its authorization has expired; closed as not landed`);\n         return;\n       }\n+      if (e.state === \"unresolved\") {\n+        // A slow re-read of an unresolved entry that still proves nothing:\n+        // kept for a human, read again after UNRESOLVED_RECHECK_MS.\n+        await change((p) => { if (p[e.key]) p[e.key] = { ...p[e.key], checks, unreadable, recheckAt: t + UNRESOLVED_RECHECK_MS }; });\n+        out.rechecked++;\n+        return;\n+      }\n       if (t - e.at >= MAX_AGE_MS) {\n         // Absence never proven (reads failing, or an authorization still\n         // valid): kept for a human, never dropped.\n-        await change((p) => { if (p[e.key]) p[e.key] = { ...p[e.key], checks, unreadable, state: \"unresolved\", unresolvedAt: t }; });\n+        await change((p) => { if (p[e.key]) p[e.key] = { ...p[e.key], checks, unreadable, state: \"unresolved\", unresolvedAt: t, recheckAt: t + UNRESOLVED_RECHECK_MS }; });\n         out.unresolved++;\n         log(`[late-settle] ${e.network} ${labelOf(e)} unresolved after ${checks} checks (${unreadable} unreadable); operator action needed`);\n         return;"},{"sha":"c8403e52bf6b9f8ac91597758ae5ea3affc3097a","filename":"src/ledger-chrome.js","status":"modified","additions":7,"deletions":8,"changes":15,"blob_url":"https://github.com/MikeyPetrillo/Agent402/blob/81a674d1a3cf7fdbbcc04f4da366c144ccd393f7/src%2Fledger-chrome.js","raw_url":"https://github.com/MikeyPetrillo/Agent402/raw/81a674d1a3cf7fdbbcc04f4da366c144ccd393f7/src%2Fledger-chrome.js","contents_url":"https://api.github.com/repos/MikeyPetrillo/Agent402/contents/src%2Fledger-chrome.js?ref=81a674d1a3cf7fdbbcc04f4da366c144ccd393f7","patch":"@@ -329,7 +329,7 @@ body { transition: background-color .18s ease, color .18s ease; }\n    overlapping the burger too late - kept as two literals, both cited here so\n    they can't drift apart if one is edited without the other. */\n @media (max-width:1100px){\n-  .ml-nav-links, .ml-nav-gh { display:none !important; }\n+  .ml-nav-links { display:none !important; }\n   .ml-burger { display:inline-flex; }\n   html.ml-menu-open .ml-mobile-menu { display:block; }\n   html.ml-menu-open .ml-burger-open { display:none; }\n@@ -481,7 +481,6 @@ a { color: inherit; }\n     scrollbar-width: thin;\n   }\n   .ml-nav-links > * { flex: none !important; }\n-  .ml-nav-gh  { display: none !important; }\n   .ml-h1      { font-size: var(--fs-3xl) !important; }\n   .ml-hero-h1 { font-size: var(--fs-3xl) !important; }\n   .ml-spec-cell { border-right: none !important; }\n@@ -745,6 +744,7 @@ function marketPanelNav(chainInfo) {\n                 <a href=\"/mpp-marketplace\" class=\"mlnav-row\"><span style=\"font-weight:700;\">MPP marketplace</span><span class=\"mlnav-faint\">verified sellers</span></a>\n                 <a href=\"/leaderboard\" class=\"mlnav-row\"><span style=\"font-weight:700;\">leaderboard</span><span class=\"mlnav-faint\">settled on-chain</span></a>\n                 <a href=\"/revenue\" class=\"mlnav-row\"><span style=\"font-weight:700;\">transactions</span><span class=\"mlnav-faint\">every settlement on our rails</span></a>\n+                <a href=\"https://live.agent402.tools\" class=\"mlnav-row\"><span style=\"font-weight:700;\">live payments</span><span class=\"mlnav-faint\">x402 and MPP, as they settle</span></a>\n                 <a href=\"/marketplace/tools\" class=\"mlnav-row mlnav-row--sep\"><span style=\"font-weight:700;\">every tool indexed</span><span class=\"mlnav-faint\">ours + third-party</span></a>\n                 <a href=\"/marketplace\" class=\"mlnav-row\"><span style=\"font-weight:700;\">Marketplace by chain</span><span class=\"mlnav-faint\">every chain, one directory</span></a>\n                 <a href=\"/guides/smart-order-router\" style=\"display:flex;justify-content:space-between;gap:12px;padding:11px 16px;text-decoration:none;background:var(--panel);color:var(--on-panel);\"><span style=\"font-weight:700;\">route a task to a proven seller</span><span style=\"opacity:.7;\">→</span></a>\n@@ -766,13 +766,15 @@ function docsPanelNav() {\n                 <a href=\"/how-to-pay\" class=\"mlnav-row\"><span style=\"font-weight:700;\">how to pay</span><span class=\"mlnav-faint\">every rail, step by step</span></a>\n                 <a href=\"/guides\" class=\"mlnav-row\"><span style=\"font-weight:700;\">guides</span><span class=\"mlnav-faint\">hosts, router, selling</span></a>\n                 <a href=\"/integrations\" class=\"mlnav-row mlnav-row--sep\"><span style=\"font-weight:700;\">integrations</span><span class=\"mlnav-faint\">frameworks</span></a>\n-                <a href=\"/x402-test\" class=\"mlnav-row mlnav-row--sep\"><span style=\"
t([\"/marketplace\", \"/mpp-marketplace\", \"/leaderboard\", \"/revenue\", \"/marketplace/tools\", ...chainInfo.chains.map((c) => c.href)]),\n-    docs: new Set([\"/docs\", \"/quickstart\", \"/how-to-pay\", \"/guides\", \"/integrations\", \"/blog\", \"/changelog\", \"/proof\", \"/101\", \"/what-is-x402\", \"/what-is-mpp\", \"/agentic-finance\", \"/glossary\"]),\n+    docs: new Set([\"/docs\", \"/quickstart\", \"/how-to-pay\", \"/guides\", \"/integrations\", \"/blog\", \"/changelog\", \"/proof\", \"/status\", \"/101\", \"/what-is-x402\", \"/what-is-mpp\", \"/agentic-finance\", \"/glossary\"]),\n     sell: new Set([\"/sell\", \"/tollbooth\", \"/contribute\"]),\n     tools: new Set([\"/tools\", \"/skills\", \"/speech\", \"/playground\", \"/pricing\"]),\n   };\n@@ -945,9 +947,6 @@ function nav(activePath) {\n       ${zone2}\n     </div>\n     <div style=\"margin-left:auto;display:flex;align-items:center;gap:12px;\">\n-      <a class=\"ml-nav-gh ml-nav-live\" href=\"https://live.agent402.tools\" style=\"font-family:var(--font-mono);font-size:var(--fs-xs);color:var(--muted);text-decoration:none;display:inline-flex;align-items:center;gap:6px;white-space:nowrap;padding:6px 11px;border:1px solid var(--hairline);border-radius:var(--radius);background:var(--card);\" title=\"Watch x402 and MPP payments settle, read from the chain\"><svg width=\"15\" height=\"13\" viewBox=\"0 0 24 20\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><rect x=\"2\" y=\"2\" width=\"20\" height=\"13\" rx=\"2\"/><path d=\"M8 19h8\"/><path d=\"M10.5 6.2v4.6l4-2.3z\" fill=\"currentColor\" stroke=\"none\"/></svg>live</a>\n-      <a class=\"ml-nav-gh\" href=\"/status\" style=\"font-family:var(--font-mono);font-size:var(--fs-xs);color:var(--muted);text-decoration:none;display:inline-flex;align-items:center;gap:6px;white-space:nowrap;\" title=\"Uptime from two outside observers\"><span aria-hidden=\"true\" style=\"width:7px;height:7px;border-radius:50%;background:var(--ok);display:inline-block;\"></span>status</a>\n-      <a class=\"ml-nav-gh\" href=\"/llms.txt\" style=\"font-family:var(--font-mono);font-size:var(--fs-xs);color:var(--muted);text-decoration:none;padding:8px 13px;border:1px solid var(--hairline);border-radius:var(--radius);background:var(--card);white-space:nowrap;\">llms.txt</a>\n       <button type=\"button\" class=\"ml-theme-toggle\" aria-label=\"Switch between dark and light theme\" title=\"Theme\">\n         <svg class=\"ml-moon\" width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z\"/></svg>\n         <svg class=\"ml-sun\" width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><circle cx=\"12\" cy=\"12\" r=\"4\"/><path d=\"M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4\"/></svg>"},{"sha":"206d33e8ea04dfc5f410610fad86311d478338e9","filename":"src/ledger-home.js","status":"modified","additions":22,"deletions":11,"changes":33,"blob_url":"https://github.com/MikeyPetrillo/Agent402/blob/81a674d1a3cf7fdbbcc04f4da366c144ccd393f7/src%2Fledger-home.js","raw_url":"https://github.com/MikeyPetrillo/Agent402/raw/81a674d1a3cf7fdbbcc04f4da366c144ccd393f7/src%2Fledger-home.js","contents_url":"https://api.github.com/repos/MikeyPetrillo/Agent402/contents/src%2Fledger-home.js?ref=81a674d1a3cf7fdbbcc04f4da366c144ccd393f7","patch":"@@ -19,6 +19,7 @@ import { railKey, chainDisplayName } from \"./rails.js\";\n import { tempoEnabled } from \"./mpp-tempo.js\";\n import { HUMAN_PRODUCTS } from \"./human-checkout.js\";\n import { MONITOR_PRODUCTS } from \"./stripe-subscriptions.js\";\n+import { MAX_FULL_PER_SUB_30D } from \"./monitor-scheduler.js\";\n \n import { REPO_URL } from \"./repo-link.js\";\n import { powCostPhrase } from \"./pow.js\";\n@@ -97,11 +98,6 @@ function decideRowHtml() {\n export function ledgerHomePage(baseUrl, catalog, stats, _leaderboardSnapshot, skillPacks, { settledOnChain = 0, external = null } = {}) {\n   const tools = toolList(catalog);\n   const count = tools.length;\n-  // The headline's \"N utilities\": catalog tools in the pure utility categories\n-  // (conversion, text, math, encoding, generators, time, validation, network),\n-  // counted from the live catalog, never typed.\n-  const UTILITY_CATEGORIES = new Set([\"conversion\", \"text\", \"math\", \"encoding\", \"identifiers\", \"time\", \"validation\", \"network\"]);\n-  const utilityCount = tools.filter((t) => UTILITY_CATEGORIES.has(t.category)).length;\n   const packCount = Array.isArray(skillPacks) ? skillPacks.length : 42;\n   const served = stats?.toolCallsServed || {};\n   const viaUsdc = Number(served.viaUSDC) || 0;\n@@ -178,6 +174,14 @@ export function ledgerHomePage(baseUrl, catalog, stats, _leaderboardSnapshot, sk\n .hm-claim h3 { font-weight: 600; font-size: var(--fs-lg); line-height: 1.3; letter-spacing: -.01em; margin: 0; color: var(--ink); text-wrap: balance; }\n .hm-claim p { font-size: var(--fs-md); line-height: 1.55; color: var(--muted); margin: 0; font-weight: 300; text-wrap: pretty; }\n .hm-claim a { margin-top: auto; font-family: var(--font-mono); font-size: var(--fs-xs); color: var(--ink); text-decoration: none; border-bottom: 1px solid var(--dash); align-self: flex-start; white-space: nowrap; }\n+.hm-door { padding: 32px; display: flex; flex-direction: column; gap: 16px; }\n+.hm-door p { margin: 0; font-size: var(--fs-base); line-height: 1.55; font-weight: 400; text-wrap: pretty; }\n+.hm-door .hm-door-act { margin-top: auto; display: flex; flex-wrap: wrap; gap: 10px; padding-top: 4px; }\n+.hm-door-agents p { color: var(--on-panel-soft); }\n+.hm-door-agents strong { color: var(--on-panel); font-weight: 600; }\n+.hm-door-people p { color: var(--muted); }\n+.hm-door-people strong { color: var(--ink); font-weight: 600; }\n+.hm-door .ml-ticks { margin: 0; }\n .hm-marks { display: flex; flex-wrap: wrap; align-items: center; gap: 6px 14px; margin-top: 18px; color: var(--muted); }\n .hm-marks a { color: var(--muted); display: inline-flex; padding: 4px; }\n .hm-marks a:hover { color: var(--ink); }\n@@ -216,7 +220,7 @@ export function ledgerHomePage(baseUrl, catalog, stats, _leaderboardSnapshot, sk\n     <div class=\"hm-hero\">\n       <div class=\"ml-stagger\" style=\"display:flex;flex-direction:column;gap:26px;\">\n         <div class=\"ml-hero-eyebrow\" style=\"font-family:var(--font-mono);font-size:var(--fs-xs);letter-spacing:.18em;text-transform:uppercase;color:var(--faint);\">For AI agents</div>\n-        <h1 class=\"ml-hero-h1\" style=\"font-family:var(--font-display);font-weight:400;letter-spacing:-.01em;font-size:var(--fs-hero);line-height:.98;margin:0;color:var(--ink);text-wrap:balance;\">Web search, browser rendering, SEC filings and market data, plus ${fmtNum(utilityCount)} utilities.</h1>\n+        <h1 class=\"ml-hero-h1\" style=\"font-family:var(--font-display);font-weight:400;letter-spacing:-.01em;font-size:var(--fs-hero);line-height:.98;margin:0;color:var(--ink);text-wrap:balance;\">500+ tools: web search, browser rendering, SEC filings, market data and more.</h1>\n         <p class=\"hm-lede\" style=\"margin:0;text-wrap:pretty;\">An agent sends a request, gets a price back in the <span style=\"font-family:var(--font-mono);color:var(--ink);\">402</span>, pays it from its own wallet over <a href=\"/what-is-x402\" style=\"color:var(--ink);text-decoration:none;border-bottom:1px solid var(--dash);\">x402</a> or <a href=\"/what-is-mpp\" style=\"color:var(--ink);text-decoration:none;border-bottom:1px solid var(--dash);\">MPP</a>, and gets the answer. No account and no API key.</p>\n         <div class=\"ml-hero-ctas\" style=\"display:flex;flex-wrap:wrap;gap:12px;align-items:center;\">\n           <a class=\"btn btn-primary\" href=\"/docs#add\">Add to your agent</a>\n@@ -262,10 +266,10 @@ export function ledgerHomePage(baseUrl, catalog, stats, _leaderboardSnapshot, sk\n \n <section style=\"max-width:1180px;margin:0 auto;padding:0 30px 20px;\">\n   <div class=\"hm-doors\">\n-    <div class=\"hm-obsidian\" style=\"padding:32px;display:flex;flex-direction:column;gap:16px;\">\n+    <div class=\"hm-obsidian hm-door hm-door-agents on-panel\">\n       <div style=\"font-family:var(--font-mono);font-size:var(--fs-xs);letter-spacing:.18em;text-transform:uppercase;color:var(--on-panel-dim);\">For agents</div>\n       <h2 class=\"hm-h2\" style=\"font-size:var(--fs-2xl);color:var(--on-panel);\">Find a tool, pay the 402, get JSON.</h2>\n-      <p style=\"margin:0;color:var(--on-panel-muted);font-size:var(--fs-base);line-height:1.5;font-weight:300;\">Resolve any task in one free call, then pay per request in ${esc(RAILS_SHORT)}, or over MPP${tempoMarkHtml ? \", natively on Tempo\" : \"\"}. Connect over <a href=\"/guides/agent-hosts\" ${panelLink}>MCP</a> or plain HTTP; machines read <a href=\"/llms.txt\" ${panelLink}>llms.txt</a>, <a href=\"/openapi.json\" ${panelLink}>openapi.json</a> and <a href=\"/.well-known/x402\" ${panelLink}>.well-known/x402</a>.</p>\n+      <p><strong>One free call</strong> finds the tool for any task. Pay per request in <strong>${esc(RAILS_SHORT)}</strong>, or over <strong>MPP</strong>${tempoMarkHtml ? \", natively on Tempo\" : \"\"}. <strong>No API key.</strong> Connect over <a href=\"/guides/agent-hosts\" ${panelLink}>MCP</a> or HTTP; machines read <a href=\"/llms.txt\" ${panelLink}>llms.txt</a>, <a href=\"/openapi.json\" ${panelLink}>openapi.json</a> and <a href=\"/.well-known/x402\" ${panelLink}>.well-known/x402</a>.</p>\n       <div class=\"hm-ptable\" style=\"font-family:var(--font-mono);display:flex;flex-direction:column;border:1px solid rgba(255,255,255,.08);border-radius:var(--radius);overflow:hidden;font-size:var(--fs-sm);\">\n         <a href=\"/tools/v1-chat-metered\" ${rowStyle}><span>POST /v1/metered/chat/completions</span><span ${priceStyle}>from ${esc(slugPrice(tools, \"v1-chat-metered\"))}</span></a>\n         <a href=\"/api/find?q=whois\" ${rowStyle}><span>GET /api/find?q=</span><span ${priceStyle}>free</span></a>\n@@ -275,18 +279,25 @@ export function ledgerHomePage(baseUrl, catalog, stats, _leaderboardSnapshot, sk\n         <a href=\"/pricing\" style=\"display:flex;justify-content:space-between;gap:12px;padding:11px 16px;text-decoration:none;color:var(--on-panel-soft);\"><span>GET /api/&lt;tool&gt;</span><span ${priceStyle}>from $${esc(String(minPriceUsd(catalog)))}</span></a>\n         ${decideLive() ? decideRowHtml() : \"\"}\n       </div>\n-      <p style=\"margin:0;color:var(--on-panel-muted);font-size:var(--fs-base);line-height:1.5;font-weight:300;\">The pure-CPU tools are free: your machine solves a short proof-of-work (${esc(powCostPhrase())}) instead of paying. <a href=\"/playground\" ${panelLink}>Try them in the playground</a>.</p>\n+      <p><strong>The pure-CPU tools are free:</strong> your machine solves a short proof-of-work instead of paying (${esc(powCostPhrase())}).</p>\n+      <div class=\"hm-door-act\"><a class=\"btn btn-secondary btn-sm\" href=\"/playground\">Try them in the playground</a><a class=\"btn btn-secondary btn-sm\" href=\"/docs\">Read the docs</a></div>\n     </div>\n-    <div class=\"hm-milled\" style=\"padding:32px;display:flex;flex-direction:column;gap:16px;\">\n+    <div class=\"hm-milled hm-door hm-door-people\">\n       <div style=\"font-family:var(--font-mono);font-size:var(--fs-xs);letter-spacing:.18em;text-transform:uppercase;color:var(--faint);\">For people</div>\n       <h2 class=\"hm-h2\" style=\"font-size:var(--fs-2xl);\">A cited report, by card.</h2>\n-      <p class=\"hm-lede\" style=\"margin:0;font-size:var(--fs-base);\">Built from live data, with a PDF and data tables, and refunded if it fails. A monitor re-runs it when something moves.</p>\n+      <p>Built from live data, with <strong>a PDF and data tables</strong>. Pay by card, <strong>no account</strong>.</p>\n       <div class=\"hm-ptable\" style=\"font-family:var(--font-mono);display:flex;flex-direction:column;border:1px solid var(--hairline);border-radius:var(--radius);overflow:hidden;font-size:var(--fs-sm);background:var(--card);\">\n         ${[[\"research\", \"Deep research\"], [\"dossier\", \"Company dossier\"], [\"fund-report\", \"Fund 13F report\"], [\"domain-audit\", \"Domain security audit\"]]\n           .map(([product, label]) => `<a class=\"hm-prow\" data-product=\"${esc(product)}\" href=\"/reports\" style=\"display:flex;justify-content:space-between;gap:12px;padding:11px 16px;border-bottom:1px solid var(--hairline);text-decoration:none;color:var(--ink);\"><span>${esc(label)}</span><span style=\"color:var(--accent);white-space:nowrap;\">${esc(cardPrice(product))}</span></a>`)\n           .join(\"\\n        \")}\n         <a class=\"hm-prow\" data-product=\"monitor\" href=\"/monitors\" style=\"display:flex;justify-content:space-between;gap:12px;padding:11px 16px;text-decoration:none;color:var(--ink);\"><span>Monitor a target</span><span style=\"color:var(--accent);white-space:nowrap;\">${esc(monitorPrice())}/mo</span></a>\n       </div>\n+      <ul class=\"ml-ticks\">\n+        <li>A report that fails is refunded to your card automatically.</li>\n+        <li>A monitor re-checks its target on a schedule and emails up to ${MAX_FULL_PER_SUB_30D} fresh reports in any 30 days.</li>\n+        <li>Cancel a monitor anytime from the link in its emails.</li>\n+      </ul>\n+      <div class=\"hm-door-act\"><a class=\"btn btn-secondary btn-sm\" href=\"/reports\">Browse reports</a><a class=\"btn btn-secondary btn-sm\" href=\"/monitors\">See monitors</a></div>\n     </div>\n   </div>\n </section>"},{"sha":"203b7e7a669676e28cc3a38574cab581585fcbc9","filename":"src/mcp-tasks.js","status":"modified","additions":3,"deletions":2,"changes":5,"blob_url":"https://github.com/MikeyPetrillo/Agent402/blob/81a674d1a3cf7fdbbcc04f4da366c144ccd393f7/src%2Fmcp-tasks.js","raw_url":"https://github.com/MikeyPetrillo/Agent402/raw/81a674d1a3cf7fdbbcc04f4da366c144ccd393f7/src%2Fmcp-tasks.js","contents_url":"https://api.github.com/repos/MikeyPetrillo/Agent402/contents/src%2Fmcp-tasks.js?ref=81a674d1a3cf7fdbbcc04f4da366c144ccd393f7","patch":"@@ -61,6 +61,7 @@\n // new one booted). In that mode create/get/complete/fail/cancel/settle/sweep\n // return promises (documented at each); atCapacity and activeCount stay\n // synchronous and count this process's own live runs.\n+import { PUSH_EXCEPTION } from \"./tempo-push-debts.js\";\n import { randomBytes } from \"node:crypto\";\n import { readFileSync, writeFileSync, renameSync, existsSync, mkdirSync, unlinkSync, readdirSync } from \"node:fs\";\n import { basename, join, resolve, sep } from \"node:path\";\n@@ -207,8 +208,8 @@ export function createTaskStore({ dir, now = () => Date.now(), log = console.log\n \n   const runs = new Map(); // taskId -> AbortController for the live loopback\n   const expired = (rec) => rec.ttlMs != null && now() - (rec.createdAtMs || 0) > rec.ttlMs;\n-  const ORPHAN_MESSAGE = \"This run did not survive a server restart and was not completed. You were not charged: payment settles only on a delivered result. Please call again.\";\n-  const ORPHAN_ERROR = () => ({ code: TASK_INTERNAL_ERROR, message: \"Task run interrupted by a server restart; not charged.\" });\n+  const ORPHAN_MESSAGE = `This run did not survive a server restart and was not completed. You were not charged: payment settles only on a delivered result${PUSH_EXCEPTION}. Please call again.`;\n+  const ORPHAN_ERROR = () => ({ code: TASK_INTERNAL_ERROR, message: `Task run interrupted by a server restart; not charged${PUSH_EXCEPTION}.` });\n   const CANCEL_MESSAGE = \"Canceled at your request. The run may still have completed and been charged; if it was, the charge is recorded as owed in our refund ledger and repaid after review. Do not retry blindly: a retry is a new paid call.\";\n \n   const newRecord = (slug) => {"},{"sha":"a1366405a0d970de533534e8427b4a26fcbbbe37","filename":"src/monitor-scheduler.js","status":"modified","additions":30,"deletions":7,"changes":37,"blob_url":"https://github.com/MikeyPetrillo/Agent402/blob/81a674d1a3cf7fdbbcc04f4da366c144ccd393f7/src%2Fmonitor-scheduler.js","raw_url":"https://github.com/MikeyPetrillo/Agent402/raw/81a674d1a3cf7fdbbcc04f4da366c144ccd393f7/src%2Fmonitor-scheduler.js","contents_url":"https://api.github.com/repos/MikeyPetrillo/Agent402/contents/src%2Fmonitor-scheduler.js?ref=81a674d1a3cf7fdbbcc04f4da366c144ccd393f7","patch":"@@ -61,7 +61,19 @@ export const MAX_FULL_PER_SUB_30D = 4;   // welcome + scheduled + up to 4 change\n export const RUN_CLAIM_TTL_MS = 2 * HOUR;\n export const PERMANENT_FAIL_NOTICE_AT = 5; // consecutive failures before the subscriber is told (once)\n const REPORTS_PER_SUB = 12;\n-const MAX_RUNS_KEPT = 24;\n+// The run log is kept by age, not by count: the 30-day paid cap counts paid\n+// runs in it, so every run inside the window must stay (a count-trimmed log\n+// let alert-only runs push paid ones out, and the cap under-counted). Past\n+// the window it is dropped; inside it, only the oldest alert-only entries\n+// give way when there are more than MAX_ALERT_RUNS_KEPT of them.\n+export const RUN_LOG_MS = 31 * DAY;\n+export const MAX_ALERT_RUNS_KEPT = 60;\n+export function keepRuns(runs, nowMs) {\n+  const since = nowMs - RUN_LOG_MS;\n+  const out = (Array.isArray(runs) ? runs : []).filter((r) => r && typeof r === \"object\" && !(Date.parse(r.at) < since));\n+  let alerts = out.filter((r) => r.alertOnly).length;\n+  return alerts <= MAX_ALERT_RUNS_KEPT ? out : out.filter((r) => !(r.alertOnly && alerts-- > MAX_ALERT_RUNS_KEPT));\n+}\n \n const STORE_PATH = () => join(existsSync(\"/data\") ? \"/data\" : \"/tmp\", \"monitor-runs.json\");\n \n@@ -318,7 +330,7 @@ export function createMonitorScheduler({ subs, generate, probeDomain, normDomain\n       at, reason, changes,\n     };\n     st.lastFullAt = now(); st.lastReportId = id; st.failures = 0; st.nextAttemptAt = null; st.lastError = null;\n-    st.runs = [...(st.runs || []), { at, reason, reportId: id }].slice(-MAX_RUNS_KEPT);\n+    st.runs = keepRuns([...(st.runs || []), { at, reason, reportId: id }], now());\n     pruneReports(rec.subId);\n     if (usePg) { addedReports.add(id); await endRun(rec.subId, token, id); }\n     else persist();\n@@ -335,7 +347,7 @@ export function createMonitorScheduler({ subs, generate, probeDomain, normDomain\n   async function alertOnly(rec, st, reason, changes) {\n     const p = MONITOR_PRODUCTS[rec.product];\n     const at = new Date(now()).toISOString();\n-    st.runs = [...(st.runs || []), { at, reason, reportId: st.lastReportId || null, alertOnly: true }].slice(-MAX_RUNS_KEPT);\n+    st.runs = keepRuns([...(st.runs || []), { at, reason, reportId: st.lastReportId || null, alertOnly: true }], now());\n     persist();\n     if (rec.email) {\n       const id = st.lastReportId;\n@@ -668,7 +680,16 @@ export function createMonitorScheduler({ subs, generate, probeDomain, normDomain\n     const summary = { full: 0, alert: 0, checked: 0, skip: 0, error: 0, deferred: 0, active: 0 };\n     let fullCount = 0;\n     const budget = { allow: () => { if (fullCount >= MAX_FULL_PER_TICK) { summary.deferred++; return false; } fullCount++; return true; } };\n-    const active = subs.listActive().filter((r) => !subId || r.subId === subId);\n+    // A record without its own id is never run: every such record would\n+    // share one state entry (the key \"undefined\"), so one would be served\n+    // and the rest not served. It is skipped and named loudly.\n+    const listed = subs.listActive();\n+    const noId = listed.filter((r) => typeof r?.subId !== \"string\" || !r.subId);\n+    if (noId.length) {\n+      summary.noId = noId.length;\n+      log(`[monitors] ALERT: ${noId.length} active subscription record(s) without a subscription id skipped (products: ${[...new Set(noId.map((r) => String(r?.product || \"?\")))].join(\", \").slice(0, 200)}); fix the records before they are served`);\n+    }\n+    const active = listed.filter((r) => typeof r?.subId === \"string\" && r.subId && (!subId || r.subId === subId));\n     summary.active = active.length;\n     for (const rec of active) {\n       // Fencing: a tick whose lease was lost stops here; the next holder\n@@ -686,7 +707,7 @@ export function createMonitorScheduler({ subs, generate, probeDomain, normDomain\n     store.lastTickAt = new Date(now()).toISOString();\n     store.lastTick = { ...summary, ms: now() - started, owner: me };\n     persist();\n-    log(`[monitors] tick: ${summary.active} active, ${summary.full} full, ${summary.alert} alerts, ${summary.checked} checked, ${summary.error} errors, ${summary.deferred} deferred${summary.lost ? \", stopped: lease lost\" : \"\"} (${now() - started}ms)`);\n+    log(`[monitors] tick: ${summary.active} active, ${summary.full} full, ${summary.alert} alerts, ${summary.checked} checked, ${summary.error} errors, ${summary.deferred} deferred${summary.noId ? `, ${summary.noId} without an id` : \"\"}${summary.lost ? \", stopped: lease lost\" : \"\"} (${now() - started}ms)`);\n     return summary;\n   }\n \n@@ -740,7 +761,9 @@ export function createMonitorScheduler({ subs, generate, probeDomain, normDomain\n   async function subIdOfReportFresh(reportId) { return (await loadMissing(reportId))?.subId || null; }\n \n   function status() {\n-    const active = subs.listActive();\n+    const listed = subs.listActive();\n+    const active = listed.filter((r) => typeof r?.subId === \"string\" && r.subId);\n+    const withoutId = listed.length - active.length; // never run (see runTick)\n     const rows = active.map((rec) => {\n       const st = store.subs[rec.subId] || {};\n       return {\n@@ -754,7 +777,7 @@ export function createMonitorScheduler({ subs, generate, probeDomain, normDomain\n         runs: (st.runs || []).slice(-5),\n       };\n     });\n-    return { owner: me, lock: store.lock, lastTickAt: store.lastTickAt || null, lastTick: store.lastTick || null, active: rows.length, reports: Object.keys(store.reports).length, subs: rows };\n+    return { owner: me, lock: store.lock, lastTickAt: store.lastTickAt || null, lastTick: store.lastTick || null, active: rows.length, ...(withoutId ? { withoutId } : {}), reports: Object.keys(store.reports).length, subs: rows };\n   }\n \n   let timer = null;"},{"sha":"8846b241de0eb253b04d2d240c1bf6691b0e52d2","filename":"src/mpp-subscriptions.js","status":"modified","additions":6,"deletions":5,"changes":11,"blob_url":"https://github.com/MikeyPetrillo/Agent402/blob/81a674d1a3cf7fdbbcc04f4da366c144ccd393f7/src%2Fmpp-subscriptions.js","raw_url":"https://github.com/MikeyPetrillo/Agent402/raw/81a674d1a3cf7fdbbcc04f4da366c144ccd393f7/src%2Fmpp-subscriptions.js","contents_url":"https://api.github.com/repos/MikeyPetrillo/Agent402/contents/src%2Fmpp-subscriptions.js?ref=81a674d1a3cf7fdbbcc04f4da366c144ccd393f7","patch":"@@ -86,6 +86,7 @@ import { tempo as tempoServer } from \"mppx/server\";\n import { privateKeyToAccount } from \"viem/accounts\";\n import { MONITOR_PRODUCTS } from \"./stripe-subscriptions.js\";\n import { redactSecrets } from \"./tools/redact.js\";\n+import { withSponsorCeiling, sponsorCeilingWord } from \"./tempo-sponsor-ceiling.js\";\n \n // Tempo mainnet. Same constant mpp-tempo.js pins; a subscription authorization\n // commits to the chain id, so a mismatch is a rejected signature, not a\n@@ -494,12 +495,12 @@ export async function subscriptionFeePayerStatus() {\n       const j = await res.json();\n       hex = j?.result;\n     } finally { clearTimeout(t); }\n-    if (typeof hex !== \"string\" || !hex.startsWith(\"0x\")) return { status: \"unknown\", asset: \"PathUSD\", chain: `eip155:${TEMPO_MAINNET_CHAIN_ID}` };\n+    if (typeof hex !== \"string\" || !hex.startsWith(\"0x\")) return { status: \"unknown\", ceiling: await sponsorCeilingWord(), asset: \"PathUSD\", chain: `eip155:${TEMPO_MAINNET_CHAIN_ID}` };\n     const usd = Number(BigInt(hex)) / 1e6;\n     // Bucketed, never the number: this rides a PUBLIC surface.\n-    return { status: usd < low ? \"low\" : \"ok\", asset: \"PathUSD\", chain: `eip155:${TEMPO_MAINNET_CHAIN_ID}` };\n+    return { status: usd < low ? \"low\" : \"ok\", ceiling: await sponsorCeilingWord(), asset: \"PathUSD\", chain: `eip155:${TEMPO_MAINNET_CHAIN_ID}` };\n   } catch {\n-    return { status: \"unknown\", asset: \"PathUSD\", chain: `eip155:${TEMPO_MAINNET_CHAIN_ID}` };\n+    return { status: \"unknown\", ceiling: await sponsorCeilingWord(), asset: \"PathUSD\", chain: `eip155:${TEMPO_MAINNET_CHAIN_ID}` };\n   }\n }\n \n@@ -969,7 +970,7 @@ export function createMppSubscriptions({\n     // request timeout, and a sync send that waits for inclusion outlived it on\n     // a slow day (canary run 33659899394). Its chain stamps the activation\n     // window, never viem's default (see ACTIVATION_VALID_FOR_S).\n-    _client = createClient({ chain: withRenewalValidity(tempoChain, ACTIVATION_VALID_FOR_S), transport: http(process.env.TEMPO_RPC_URL || \"https://rpc.tempo.xyz\", { timeout: TEMPO_RPC_TIMEOUT_MS }) });\n+    _client = createClient({ chain: withRenewalValidity(tempoChain, ACTIVATION_VALID_FOR_S), transport: withSponsorCeiling(http(process.env.TEMPO_RPC_URL || \"https://rpc.tempo.xyz\", { timeout: TEMPO_RPC_TIMEOUT_MS }), { log, kind: \"activation\" }) });\n     return _client;\n   }\n   const clientOverride = () => ({ getClient: () => tempoClient() });\n@@ -980,7 +981,7 @@ export function createMppSubscriptions({\n     if (_renewalClient) return _renewalClient;\n     const { createClient, http } = await import(\"viem\");\n     const { tempo: tempoChain } = await import(\"viem/tempo/chains\");\n-    _renewalClient = createClient({ chain: withRenewalValidity(tempoChain, renewalValidForS), transport: http(process.env.TEMPO_RPC_URL || \"https://rpc.tempo.xyz\", { timeout: TEMPO_RPC_TIMEOUT_MS }) });\n+    _renewalClient = createClient({ chain: withRenewalValidity(tempoChain, renewalValidForS), transport: withSponsorCeiling(http(process.env.TEMPO_RPC_URL || \"https://rpc.tempo.xyz\", { timeout: TEMPO_RPC_TIMEOUT_MS }), { log, kind: \"renewal\" }) });\n     return _renewalClient;\n   }\n "},{"sha":"a01637392f9c7d93d84c00c5240915fd7c3a409d","filename":"src/mpp-tempo.js","status":"modified","additions":165,"deletions":5,"changes":170,"blob_url":"https://github.com/MikeyPetrillo/Agent402/blob/81a674d1a3cf7fdbbcc04f4da366c144ccd393f7/src%2Fmpp-tempo.js","raw_url":"https://github.com/MikeyPetrillo/Agent402/raw/81a674d1a3cf7fdbbcc04f4da366c144ccd393f7/src%2Fmpp-tempo.js","contents_url":"https://api.github.com/repos/MikeyPetrillo/Agent402/contents/src%2Fmpp-tempo.js?ref=81a674d1a3cf7fdbbcc04f4da366c144ccd393f7","patch":"@@ -52,6 +52,7 @@ import { sharedClaimRequired } from \"./replay-topology.js\";\n import { drainSignal } from \"./drain-abort.js\";\n import { screenAddresses, screenFunding, sanctionsScreenStatus, maskAddress as maskOne } from \"./sanctions-screen.js\";\n import { Secp256k1 } from \"ox\";\n+import { lateWatchKey } from \"./tempo-late-watches.js\";\n \n const DEFAULT_DECIMALS = 6; // matches every other stablecoin rail this repo settles (unconfirmed specifically for pathUSD — decimals() unread, this is the USDC-family convention, not a live lookup)\n \n@@ -1117,6 +1118,100 @@ export async function validateTempoCredential(authorizationHeader) {\n   }\n }\n \n+/**\n+ * A push finalize failure whose answer cannot say whether the relay claimed\n+ * the hash. Only a failure before any request byte was sent (a connect-phase\n+ * error) or a refusal of our own credentials or rate (401, 403, 429) proves\n+ * the relay never acted on the broadcast; a connection lost after the request\n+ * was written, or a 5xx, may follow a claim the answer never reached us for.\n+ * A result that does not say which (connectPhase or relayStatus missing) is\n+ * read as ambiguous: booking a debt that a later served claim voids is the\n+ * safe side, a transfer charged and recorded nowhere is not.\n+ */\n+/**\n+ * The late-landing watch for a PULL credential answered 402 after its\n+ * broadcast failed and the chain check found nothing. The relay may still\n+ * submit the transaction (its own retry, a queue) inside the credential's\n+ * validity, after the check's last read: a charge with no record. So the\n+ * chain is read again on its own after the answer, once per delay in\n+ * TEMPO_LATE_CONFIRM_DELAYS_MS (default 15 s, 45 s, 2 min: past any pull\n+ * credential's validity, after which the transaction can no longer land),\n+ * and a transaction found is handed to `onLanded` (booked owed as a charged\n+ * failure). At most TEMPO_LATE_CONFIRM_MAX_WATCHES run at once per process.\n+ * With a durable ledger configured (configureTempoLateWatches; server.js) and\n+ * a `record` passed, every watch is written to it first: one past the bound,\n+ * one whose process stops mid-watch, one whose last read failed and one whose\n+ * booking did not land are each read and booked by the ledger's sweep\n+ * (src/tempo-late-watches.js) instead of being lost.\n+ */\n+export const LATE_LANDED_CLASS = \"landed-after-402\";\n+function lateConfirmDelays(env = process.env) {\n+  const raw = String(env.TEMPO_LATE_CONFIRM_DELAYS_MS ?? \"\").trim();\n+  if (raw === \"off\") return [];\n+  const list = raw ? raw.split(\",\").map((x) => Number(x.trim())).filter((n) => Number.isFinite(n) && n >= 0 && n <= 30 * 60_000) : [];\n+  return list.length ? list.slice(0, 6) : [15_000, 45_000, 120_000];\n+}\n+function lateConfirmMaxWatches(env = process.env) {\n+  const n = Number(env.TEMPO_LATE_CONFIRM_MAX_WATCHES);\n+  return Number.isInteger(n) && n >= 0 ? n : 200;\n+}\n+let lateWatches = 0;\n+let lateLedger = null;\n+/** The durable record of late-landing watches (src/tempo-late-watches.js); null for none. */\n+export function configureTempoLateWatches(ledger) { lateLedger = ledger || null; }\n+export function watchLateTempoLanding(auth, { confirm, onLanded, delays = lateConfirmDelays(), log = console.warn, record = null } = {}) {\n+  if (typeof confirm !== \"function\" || typeof onLanded !== \"function\" || !delays.length) return false;\n+  const sorted = [...delays].sort((a, b) => a - b);\n+  const started = Date.now();\n+  const durable = lateLedger && record ? lateLedger : null;\n+  const key = durable ? lateWatchKey(auth) : null;\n+  // Written before the watch can start, so a watch this process never runs\n+  // (past the bound) or does not finish is still on record.\n+  const stored = durable ? durable.record(key, { auth, startedAt: started, lastDelayMs: sorted[sorted.length - 1], ...record }) : null;\n+  if (lateWatches >= lateConfirmMaxWatches()) {\n+    log(durable ? \"[mpp-tempo] late-landing watch past the per-process bound: left to the durable sweep\" : \"[mpp-tempo] late-landing watch skipped: the per-process bound is reached\");\n+    return false;\n+  }\n+  lateWatches++;\n+  if (durable) durable.own(key);\n+  void (async () => {\n+    // Done means answered: a landing booked, or every read made and none\n+    // found with the last one read. Anything else stays on record for the sweep.\n+    let done = false;\n+    try {\n+      let lastFailed = false;\n+      for (const at of sorted) {\n+        const wait = Math.max(0, started + at - Date.now());\n+        await new Promise((r) => { const t = setTimeout(r, wait); if (typeof t.unref === \"function\") t.unref(); });\n+        let found = null;\n+        const trace = {};\n+        try { found = await confirm(auth, { attempts: 1, delayMs: 0, trace }); } catch { found = null; trace.error = trace.error || \"threw\"; }\n+        if (found?.txId) { done = (await onLanded(found)) !== false; return; }\n+        lastFailed = !!trace.error;\n+      }\n+      done = !lastFailed;\n+    } catch (e) {\n+      log(`[mpp-tempo] late-landing watch failed: ${String(e?.message || e).slice(0, 120)}`);\n+    } finally {\n+      lateWatches--;\n+      if (durable) {\n+        durable.release(key);\n+        try { await stored; if (done) await durable.remove(key); } catch { /* the sweep reads it again */ }\n+      }\n+    }\n+  })();\n+  return true;\n+}\n+/** Test seam: how many late-landing watches are running. */\n+export function _lateTempoWatchCount() { return lateWatches; }\n+\n+export function pushFinalizeAmbiguous(f) {\n+  if (!f || f.ok) return false;\n+  if (f.cls === \"relay-unreachable\") return f.connectPhase !== true;\n+  if (f.cls === \"relay-unavailable\") return ![401, 403, 429].includes(Number(f.relayStatus));\n+  return false;\n+}\n+\n /** Terminal — actually settles via Tempo's relay. Callers MUST only invoke\n  *  this after a successful (<400) handler response; see the server wiring\n  *  in server.js for the buffer-then-decide discipline this depends on. */\n@@ -1130,7 +1225,8 @@ export async function broadcastTempoCredential(authorizationHeader) {\n     const [receipt] = await withRelayTrace(() => Method.broadcastCredential(tempoMethod(), authorizationHeader));\n     return { ok: true, receipt };\n   } catch (e) {\n-    return { ok: false, error: describeRelayFailure(e), reason: buyerReason(e), cls: classifyTempoRefusal(e), ...relayRefusalFields(e) };\n+    const trace = e?.__relayTrace || {};\n+    return { ok: false, error: describeRelayFailure(e), reason: buyerReason(e), cls: classifyTempoRefusal(e), ...relayRefusalFields(e), connectPhase: trace.connectPhase === true, relayStatus: Number(trace.relayUnavailable) || null };\n   }\n }\n \n@@ -1266,7 +1362,7 @@ export function createTempoChallengeAppender({ realm, secretKey, priceFor }) {\n  *  free handler executions before Tempo's relay rejects the (N-1) duplicate\n  *  broadcasts at settlement time — the same \"Five Attacks on x402\" Attack II\n  *  class replay-guard.js documents, just unguarded on this second path. */\n-export function createTempoGate({ validate = validateTempoCredential, broadcast = broadcastTempoCredential, confirmSettlement = null, earlyConfirm = null, replayGuard, secretKey, realm, priceFor, preValidate = null, verifyKeychainSender = verifyTempoKeychainSender, pushSender = tempoPushSender, onPushNotClaimed = null, onPushInputRefused = null, pushClaimAllowed = null, pushRowOf = null } = {}) {\n+export function createTempoGate({ validate = validateTempoCredential, broadcast = broadcastTempoCredential, confirmSettlement = null, earlyConfirm = null, replayGuard, secretKey, realm, priceFor, preValidate = null, verifyKeychainSender = verifyTempoKeychainSender, pushSender = tempoPushSender, onPushNotClaimed = null, onPushInputRefused = null, pushClaimAllowed = null, pushRowOf = null, syntheticOf = () => false } = {}) {\n   if (!tempoConfigured()) return null;\n   // Fail CLOSED on the binding inputs: a gate that cannot verify \"we minted\n   // this challenge for this price\" must not exist, because its existence is\n@@ -1275,7 +1371,32 @@ export function createTempoGate({ validate = validateTempoCredential, broadcast\n     console.error(\"[mpp-tempo] REFUSING to mount the Tempo gate: secretKey (MPP_SECRET_KEY) and priceFor are required to bind credentials to minted challenges and route prices\");\n     return null;\n   }\n-  return function tempoGate(req, res, next) {\n+  // A landed transaction is on the books once its hash holds a refund row in\n+  // any state (owed, sending, paid, void): booking it again would change nothing.\n+  const lateRowExists = async (txId) => {\n+    if (typeof pushRowOf !== \"function\") return false;\n+    try { return !!(await pushRowOf(String(txId).toLowerCase())); } catch { return false; }\n+  };\n+  /** One pass of the durable late-landing sweep (src/tempo-late-watches.js). */\n+  async function sweepLateWatches() {\n+    if (!lateLedger || typeof onPushNotClaimed !== \"function\" || typeof confirmSettlement !== \"function\") return null;\n+    return lateLedger.sweep({\n+      confirm: confirmSettlement,\n+      book: async (e, found) => {\n+        // The stored request, as the booking reads it: the route (slug), the\n+        // ledger payer and whether it was our own synthetic traffic.\n+        const stub = { method: e.method, path: e.path, originalUrl: e.path, headers: {}, header: () => undefined, mppTempoLedgerPayer: e.payer || null, __lateWatchSynthetic: !!e.synthetic };\n+        const amountAtomic = String(found.amountAtomic ?? e.amountAtomic);\n+        let owed = false;\n+        try { owed = (await onPushNotClaimed(stub, { hash: String(found.txId).toLowerCase(), payer: e.payer || null, amountAtomic, amountUsd: Number(amountAtomic) / 10 ** envDecimals(), cls: LATE_LANDED_CLASS })) === true; } catch { owed = false; }\n+        console.warn(`[mpp-tempo] CHARGED-BUT-NOT-SERVED: a pull transaction landed after its 402 (${e.method} ${e.path} tx=${found.txId}, found by the late-watch sweep) - ${owed ? \"recorded as owed in the refund ledger\" : \"NOT recorded\"}`);\n+        return owed || await lateRowExists(found.txId);\n+      },\n+    });\n+  }\n+  tempoGate.sweepLateWatches = sweepLateWatches;\n+  return tempoGate;\n+  function tempoGate(req, res, next) {\n     const auth = req.headers.authorization;\n     const tStart = Date.now();\n     if (!isTempoCredential(auth)) {\n@@ -1598,9 +1719,27 @@ export function createTempoGate({ validate = validateTempoCredential, broadcast\n           const fcls = f.cls || \"unknown\";\n           logTempoRefusal(req, { cls: `finalize:${fcls}`, amountAtomic: binding.amountAtomic, timings: { validate: tValidated - t0, finalize: Date.now() - tFinal0, total: Date.now() - tStart }, detail: f.error || \"\", requestId: f.requestId });\n           const fc = TEMPO_REFUSAL_CLASSES[fcls] || TEMPO_REFUSAL_CLASSES.unknown;\n+          if (fc.status === 503 && pushFinalizeAmbiguous(f)) {\n+            // The request may have reached the relay and the hash may be\n+            // claimed, with the answer lost on the way back. A retry of a\n+            // claimed hash is refused as a replay, so the transfer is booked\n+            // as owed now (a later claim that is served voids the row, as\n+            // after an input refusal) and the key is released so the same\n+            // credential can still pay if the hash was not claimed.\n+            releaseReplay();\n+            let owed = false;\n+            if (typeof onPushInputRefused === \"function\") {\n+              const payer = await readPushSender();\n+              try { owed = (await onPushInputRefused(req, { hash: pushHash, payer, amountAtomic: String(binding.amountAtomic), amountUsd: pushAmountUsd, status: 503, unanswered: true })) === true; } catch { owed = false; }\n+            }\n+            console.warn(`[mpp-tempo] push finalize unanswered (${req.method} ${req.path} tx=${pushHash || \"?\"} reason=${fcls}${f.relayStatus ? ` status=${f.relayStatus}` : \"\"}): the relay may have claimed the transfer - ${owed ? \"recorded as owed until a claim is served\" : \"NOT recorded\"}`);\n+            res.setHeader(\"Retry-After\", String(fc.retryAfter || 5));\n+            return sendMppProblem(res, mppProblem(fc.kind, `The Tempo payment relay did not answer whether it claimed the transfer you sent. Retry the same request with the same credential: if the transfer was not claimed it pays for that request${owed ? \"; if it was, it is recorded as owed to the sender, to be refunded\" : \"\"}.`, { status: 503, hint: \"Retry the same request with the same credential in a few seconds.\", details: { reason: fcls, transferClaimed: null, ...(owed ? { refundOwed: true } : {}) } }));\n+          }\n           if (fc.status === 503) {\n-            // The relay could not be reached: the hash is NOT claimed, so the\n-            // same credential can be presented again.\n+            // The relay was never reached (or refused our own credentials):\n+            // the hash is NOT claimed, so the same credential can be\n+            // presented again.\n             releaseReplay();\n             res.setHeader(\"Retry-After\", String(fc.retryAfter || 5));\n             return sendMppProblem(res, mppProblem(fc.kind, \"The Tempo payment relay could not be reached to claim the transfer you sent. It has not been claimed, so it still pays for this request.\", { status: 503, hint: \"Retry the same request with the same credential in a few seconds.\", details: { reason: fcls, transferClaimed: false } }));\n@@ -1620,6 +1759,11 @@ export function createTempoGate({ validate = validateTempoCredential, broadcast\n             try { owed = (await onPushNotClaimed(req, { hash, payer, amountAtomic: String(binding.amountAtomic), amountUsd: pushAmountUsd, cls: fcls })) === true; } catch { owed = false; }\n             console.warn(`[mpp-tempo] CHARGED-BUT-NOT-SERVED: push transfer confirmed by the relay could not be claimed (${req.method} ${req.path} tx=${hash || \"?\"} reason=${fcls}) - ${owed ? \"recorded as owed in the refund ledger\" : \"NOT recorded\"}`);\n           }\n+          // A replay refusal for a hash an earlier unanswered finalize booked\n+          // as owed: that debt stands (the claim the answer was lost for).\n+          if (fcls === \"replay\" && typeof pushRowOf === \"function\" && pushHash) {\n+            try { owed = (await pushRowOf(pushHash))?.status === \"owed\"; } catch { owed = false; }\n+          }\n           return sendMppProblem(res, mppProblem(fc.kind, `The transfer this credential names could not be claimed for this request: ${fc.detail}${owed ? \" The transfer was received and is recorded as owed to the sender.\" : \"\"}`, { status: 402, hint: fc.hint, details: { reason: fcls, ...(owed ? { refundOwed: true } : {}) } }));\n         }\n         const receiptHeader = tempoReceiptHeader(f.receipt);\n@@ -1827,6 +1971,22 @@ export function createTempoGate({ validate = validateTempoCredential, broadcast\n         // it stays spent: presenting it again must not run the handler again.\n         // The 402 above carries a fresh challenge to pay instead.\n         settleReplay();\n+        // The transaction can still land after the chain check's last read:\n+        // watched on its own, and booked owed if it does (the credential is\n+        // spent, so it is never also served).\n+        if (confirmSettlement && typeof onPushNotClaimed === \"function\" && ![\"screen-rejected\", \"screen-unavailable\", \"replay\"].includes(bcls)) {\n+          watchLateTempoLanding(auth, {\n+            confirm: confirmSettlement,\n+            onLanded: async (found) => {\n+              const amountUsd = Number(found.amountAtomic ?? binding.amountAtomic) / 10 ** envDecimals();\n+              let owed = false;\n+              try { owed = (await onPushNotClaimed(req, { hash: String(found.txId).toLowerCase(), payer: req.mppTempoLedgerPayer || null, amountAtomic: String(found.amountAtomic ?? binding.amountAtomic), amountUsd, cls: LATE_LANDED_CLASS })) === true; } catch { owed = false; }\n+              console.warn(`[mpp-tempo] CHARGED-BUT-NOT-SERVED: a pull transaction landed after its 402 (${req.method} ${req.path} tx=${found.txId}) - ${owed ? \"recorded as owed in the refund ledger\" : \"NOT recorded\"}`);\n+              return owed || await lateRowExists(found.txId);\n+            },\n+            record: { method: req.method, path: req.path, payer: req.mppTempoLedgerPayer || null, amountAtomic: String(binding.amountAtomic), synthetic: !!syntheticOf(req) },\n+          });\n+        }\n         return;\n       }\n       console.log(`[mpp-tempo] settled ${req.method} ${req.path} tx=${b.receipt?.reference || \"?\"} [${timing}]`);"},{"sha":"ce78fa63d5f8bec3f5b6eaacfb38ef7dcda2353c","filename":"src/own-wallets.js","status":"modified","additions":9,"deletions":0,"changes":9,"blob_url":"https://github.com/MikeyPetrillo/Agent402/blob/81a674d1a3cf7fdbbcc04f4da366c144ccd393f7/src%2Fown-wallets.js","raw_url":"https://github.com/MikeyPetrillo/Agent402/raw/81a674d1a3cf7fdbbcc04f4da366c144ccd393f7/src%2Fown-wallets.js","contents_url":"https://api.github.com/repos/MikeyPetrillo/Agent402/contents/src%2Fown-wallets.js?ref=81a674d1a3cf7fdbbcc04f4da366c144ccd393f7","patch":"@@ -54,6 +54,15 @@ export async function isOwnPayoutAddress(addr, { sets = null, env = process.env\n   if (isEvm) return s.evm.has(a.toLowerCase());\n   return s.other.some((set) => set.has(a));\n }\n+/** Is `addr` positively one of our own wallets: true or false, or null when\n+ *  the internal wallet list cannot be loaded. The strict reading for a check\n+ *  that ALLOWS an address because it is ours (a withdrawal recipient), where\n+ *  an unreadable list must never read as \"ours\". */\n+export async function ownWalletMatch(addr, { sets = null, env = process.env } = {}) {\n+  const s = sets || await loadOwnWalletSets();\n+  if (!s) return null;\n+  return isOwnPayoutAddress(addr, { sets: s, env });\n+}\n /** Throws a 502 (nothing signed) when `addr` is one of our own wallets, and a\n  *  503 (nothing signed) when the internal wallet list cannot be loaded. */\n export async function assertNotOwnPayout(addr) {"},{"sha":"55c42d92dc3cc3dca58422ef1cb8b6f93cf11645","filename":"src/paid-phase-timing.js","status":"modified","additions":7,"deletions":0,"changes":7,"blob_url":"https://github.com/MikeyPetrillo/Agent402/blob/81a674d1a3cf7fdbbcc04f4da366c144ccd393f7/src%2Fpaid-phase-timing.js","raw_url":"https://github.com/MikeyPetrillo/Agent402/raw/81a674d1a3cf7fdbbcc04f4da366c144ccd393f7/src%2Fpaid-phase-timing.js","contents_url":"https://api.github.com/repos/MikeyPetrillo/Agent402/contents/src%2Fpaid-phase-timing.js?ref=81a674d1a3cf7fdbbcc04f4da366c144ccd393f7","patch":"@@ -171,6 +171,13 @@ export function paidPhaseSummary() {\n       verifyMs: phase(\"verifyMs\"), handlerMs: phase(\"handlerMs\"), settleMs: phase(\"settleMs\"),\n       gateMs: phase(\"gateMs\"), afterMs: phase(\"afterMs\"), totalMs: phase(\"totalMs\"),\n       slowestSlugs: [...ring].sort((a, b) => (b.totalMs ?? 0) - (a.totalMs ?? 0)).slice(0, 5).map((r) => ({ slug: r.slug, totalMs: r.totalMs, handlerMs: r.handlerMs, settleMs: r.settleMs })),\n+      // One rail settles on several networks at very different speeds (a\n+      // Solana settle is not a Base one), so each network gets its own figures.\n+      byNetwork: Object.fromEntries([...new Set(ring.map((r) => r.network || \"-\"))].map((net) => {\n+        const rows = ring.filter((r) => (r.network || \"-\") === net);\n+        const ph = (k) => ({ p50: pct(rows.map((r) => r[k]), 50), p95: pct(rows.map((r) => r[k]), 95) });\n+        return [net, { calls: rows.length, gone: rows.filter((r) => r.gone !== \"no\").length, handlerMs: ph(\"handlerMs\"), settleMs: ph(\"settleMs\"), totalMs: ph(\"totalMs\") }];\n+      })),\n     };\n   }\n   return out;"},{"sha":"083439a303cfbfcd0d4e6b7cccf804aa5660eaad","filename":"src/paid-quote-trust.js","status":"added","additions":192,"deletions":0,"changes":192,"blob_url":"https://github.com/MikeyPetrillo/Agent402/blob/81a674d1a3cf7fdbbcc04f4da366c144ccd393f7/src%2Fpaid-quote-trust.js","raw_url":"https://github.com/MikeyPetrillo/Agent402/raw/81a674d1a3cf7fdbbcc04f4da366c144ccd393f7/src%2Fpaid-quote-trust.js","contents_url":"https://api.github.com/repos/MikeyPetrillo/Agent402/contents/src%2Fpaid-quote-trust.js?ref=81a674d1a3cf7fdbbcc04f4da366c144ccd393f7","patch":"@@ -0,0 +1,192 @@\n+// Paid-quote trust: a client address that has just paid reads against a\n+// raised ceiling on the unpaid-quote limiters, never none.\n+//\n+// A stock x402 client fetches an unpaid quote before every paid call, so the\n+// metered gateway's unpaid-quote limiter (METERED_UNPAID_QUOTES_PER_MIN in\n+// src/unpaid-quote-budget.js) capped a paying buyer near that many PAID calls a\n+// minute. A client address whose call ended in a final 200 that settled on any\n+// rail (an x402 settle receipt on any chain, an MPP or Tempo receipt, a card\n+// capture, a credits debit) is trusted for PAID_QUOTE_TRUST_MS after that call;\n+// each new paid 200 slides the window. While trusted, its unpaid quotes are\n+// counted on their own count against PAID_CLIENT_QUOTE_MULTIPLIER (10) times\n+// the plain figures, by the metered limiter (PAID_CLIENT_METERED_QUOTES_PER_MIN\n+// and _PER_HOUR) and by the unpaid price-check budget.\n+//\n+// What does NOT trust an address: a free call (proof of work, the trial, a\n+// first-call allowance grant whose settle was skipped, a forgiven hang-up), a\n+// 4xx or 5xx, an idempotent replay (nothing settled), or FREE_MODE. The caller\n+// (server.js) marks only from the settlement-outcome hook\n+// (src/hangup-settlement.js onSettleOutcome), which runs on the FINAL response,\n+// never on handler status before settlement.\n+//\n+// The key is the unpaid budget's client key (`clientKeyOf`: the address, an\n+// IPv6 /64 as one; from Cloudflare's shared Worker egress address, the address\n+// plus the User-Agent token). Any Worker can send that token, so on that address\n+// the trusted counts also share the whole-address ceiling (src/unpaid-quote-budget.js,\n+// and the metered gate in server.js): borrowing it never lifts the address past it.\n+//\n+// Storage: the process keeps its own bounded map (at most `keyCap` addresses,\n+// least recently marked dropped first, entries expire with their window), and\n+// writes each mark through to the shared store (src/shared-limits.js, a flag\n+// with the window's expiry, keyed by a keyed HMAC of the address,\n+// quoteKeyDigest in src/unpaid-quote-budget.js, never the address nor a plain\n+// hash of it). Another replica reads the shared flag only on the refusal path, so\n+// an unpaid quote costs no store round trip; a negative answer is held briefly\n+// so a flood of refused quotes cannot become a flood of store reads. A store\n+// that does not answer reads as not trusted: the limiters then limit normally.\n+//\n+// Counts leave this module bucketed (`stats`), never an address.\n+import { shared as sharedStore } from \"./shared-limits.js\";\n+import { quoteKeyDigest, PAID_CLIENT_QUOTE_MULTIPLIER, PAID_CLIENT_METERED_QUOTES_PER_MIN, PAID_CLIENT_METERED_QUOTES_PER_HOUR } from \"./unpaid-quote-budget.js\";\n+import { allowanceServed } from \"./allowance-state.js\";\n+\n+export const PAID_QUOTE_TRUST_MINUTES = 10;\n+export const PAID_QUOTE_TRUST_MS = PAID_QUOTE_TRUST_MINUTES * 60_000;\n+export const PAID_QUOTE_TRUST_KEY_CAP = 20_000;\n+// Unpaid /v1/metered quotes one settled /v1/metered call earns past the plain\n+// figure: its own quote and one retry.\n+export const METERED_QUOTE_CREDITS_PER_CALL = 2;\n+// How long a \"not trusted\" answer from the shared store is held per address.\n+export const PAID_QUOTE_TRUST_NEGATIVE_MS = 5_000;\n+const STORE_NAME = \"paid-quote-trust\";\n+// The raised ceiling a trusted address reads against (src/unpaid-quote-budget.js).\n+export { PAID_CLIENT_QUOTE_MULTIPLIER, PAID_CLIENT_METERED_QUOTES_PER_MIN, PAID_CLIENT_METERED_QUOTES_PER_HOUR };\n+\n+/** Bucket a count so the operator view never carries an exact figure. */\n+export function trustBucket(n) {\n+  const v = Math.max(0, Number(n) || 0);\n+  if (v === 0) return \"0\";\n+  if (v < 10) return \"1-9\";\n+  if (v < 100) return \"10-99\";\n+  if (v < 1000) return \"100-999\";\n+  return \"1000+\";\n+}\n+\n+const digest = (key) => quoteKeyDigest(key);\n+\n+/**\n+ * @param {object} [o]\n+ * @param {object} [o.store]   the shared store (flagSet/flagGet as in src/shared-limits.js); null for none\n+ * @param {number} [o.windowMs]\n+ * @param {number} [o.keyCap]\n+ * @param {number} [o.negativeMs]\n+ * @param {() => number} [o.now]\n+ */\n+export function createPaidQuoteTrust({ store = sharedStore, windowMs = PAID_QUOTE_TRUST_MS, keyCap = PAID_QUOTE_TRUST_KEY_CAP, negativeMs = PAID_QUOTE_TRUST_NEGATIVE_MS, now = Date.now } = {}) {\n+  const local = new Map(); // key -> until (ms), least recently marked first\n+  const negative = new Map(); // key -> until (ms): the store said \"not trusted\"\n+  let marks = 0;\n+\n+  const sweep = (map, t) => { for (const [k, until] of map) if (until <= t) map.delete(k); };\n+  const bound = (map, t) => {\n+    if (map.size <= keyCap) return;\n+    sweep(map, t);\n+    while (map.size > keyCap) map.delete(map.keys().next().value);\n+  };\n+\n+  /** Trust `key` for the window from now (a paid 200 just settled). */\n+  function mark(key, t = now()) {\n+    if (!key) return;\n+    const until = t + windowMs;\n+    local.delete(key);\n+    local.set(key, until);\n+    negative.delete(key);\n+    bound(local, t);\n+    marks += 1;\n+    // Best-effort and never awaited: a store that does not answer leaves the\n+    // trust on this process only.\n+    try { void Promise.resolve(store?.flagSet?.(STORE_NAME, digest(key), until, { now: t })).catch(() => {}); } catch { /* never break a response */ }\n+  }\n+\n+  // METERED QUOTE CREDITS. A /v1/metered quote runs the tokenizer over the\n+  // body, so the raise past the plain figure is earned per paid metered call,\n+  // not by any payment: each settled /v1/metered call grants\n+  // METERED_QUOTE_CREDITS_PER_CALL unpaid quotes (its own quote and one\n+  // retry), at most PAID_CLIENT_METERED_QUOTES_PER_MIN held, expiring with the\n+  // window. Kept on this process only: on another replica a buyer simply\n+  // reads against the plain figure, never more.\n+  const credits = new Map(); // key -> { n, until }\n+  function creditMetered(key, t = now()) {\n+    if (!key) return;\n+    const prev = credits.get(key);\n+    const held = prev && prev.until > t ? prev.n : 0;\n+    credits.delete(key);\n+    credits.set(key, { n: Math.min(PAID_CLIENT_METERED_QUOTES_PER_MIN, held + METERED_QUOTE_CREDITS_PER_CALL), until: t + windowMs });\n+    if (credits.size > keyCap) {\n+      for (const [k, c] of credits) if (c.until <= t) credits.delete(k);\n+      while (credits.size > keyCap) credits.delete(credits.keys().next().value);\n+    }\n+  }\n+  /** Spend one metered quote credit; false when none is held. */\n+  function takeMeteredCredit(key, t = now()) {\n+    if (!key) return false;\n+    const c = credits.get(key);\n+    if (!c) return false;\n+    if (c.until <= t || c.n <= 0) { credits.delete(key); return false; }\n+    c.n -= 1;\n+    return true;\n+  }\n+\n+  /** This process's own record only: synchronous, no store read. */\n+  function trustedLocal(key, t = now()) {\n+    if (!key) return false;\n+    const until = local.get(key);\n+    if (!until) return false;\n+    if (until <= t) { local.delete(key); return false; }\n+    return true;\n+  }\n+\n+  /** This process's record, else the shared store's. Resolves false when the\n+   *  store does not answer. Never rejects. */\n+  async function trusted(key, t = now()) {\n+    if (!key) return false;\n+    if (trustedLocal(key, t)) return true;\n+    const held = negative.get(key);\n+    if (held && held > t) return false;\n+    if (!store?.flagGet) return false;\n+    let until = 0;\n+    try {\n+      const r = await store.flagGet(STORE_NAME, digest(key), { now: t });\n+      until = r?.ok ? Number(r.until) || 0 : 0;\n+    } catch { until = 0; }\n+    if (until > t) {\n+      local.delete(key);\n+      local.set(key, Math.min(until, t + windowMs));\n+      bound(local, t);\n+      return true;\n+    }\n+    negative.delete(key);\n+    negative.set(key, t + negativeMs);\n+    bound(negative, t);\n+    return false;\n+  }\n+\n+  /** Bucketed counts only, never a key. */\n+  function stats(t = now()) {\n+    sweep(local, t);\n+    return {\n+      windowMinutes: Math.round(windowMs / 60_000),\n+      trustedAddressesThisReplica: trustBucket(local.size),\n+      marksSinceBoot: trustBucket(marks),\n+      shared: Boolean(store?.flagGet) && store?.mode === \"redis\",\n+    };\n+  }\n+\n+  return { mark, trusted, trustedLocal, creditMetered, takeMeteredCredit, stats, _size: () => local.size, _credits: (key) => credits.get(key)?.n ?? 0 };\n+}\n+\n+/** True when this final response proves a payment settled or was debited.\n+ *  Read in the settlement-outcome hook, after the gate decided. */\n+export function paidAndSettled(req, res, { settleReceipt = null } = {}) {\n+  try {\n+    if (!res || res.statusCode !== 200) return false;\n+    if (String(res.getHeader?.(\"X-Replayed-Answer\") ?? \"\") === \"1\") return false;\n+    if (allowanceServed(req)) return false;\n+    if (req?.creditsSettled === true) return true;\n+    if (req?.tempoSettled === true || req?.stripeSettled === true) return true;\n+    if (res.getHeader?.(\"Payment-Receipt\")) return true;\n+    const h = settleReceipt || res.getHeader?.(\"PAYMENT-RESPONSE\") || res.getHeader?.(\"X-PAYMENT-RESPONSE\");\n+    if (typeof h !== \"string\" || !h) return false;\n+    try { return JSON.parse(Buffer.from(h, \"base64\").toString(\"utf-8\"))?.success === true; } catch { return false; }\n+  } catch { return false; }\n+}"},{"sha":"a03f1c51ac85d465bf03eaff9d874c87a02d1b45","filename":"src/privacy.js","status":"modified","additions":10,"deletions":4,"changes":14,"blob_url":"https://github.com/MikeyPetrillo/Agent402/blob/81a674d1a3cf7fdbbcc04f4da366c144ccd393f7/src%2Fprivacy.js","raw_url":"https://github.com/MikeyPetrillo/Agent402/raw/81a674d1a3cf7fdbbcc04f4da366c144ccd393f7/src%2Fprivacy.js","contents_url":"https://api.github.com/repos/MikeyPetrillo/Agent402/contents/src%2Fprivacy.js?ref=81a674d1a3cf7fdbbcc04f4da366c144ccd393f7","patch":"@@ -71,7 +71,7 @@ export function privacyPage(baseUrl) {\n <section>\n <div class=\"pv-eyebrow\">$ GET /privacy</div>\n <h1 class=\"pv-h1\">Privacy policy</h1>\n-<p class=\"pv-updated\">Agent402 (agent402.tools) - last updated 2026-11-06.</p>\n+<p class=\"pv-updated\">Agent402 (agent402.tools) - last updated 2026-11-09.</p>\n </section>\n \n <section>\n@@ -153,7 +153,8 @@ so every claim below is verifiable in code.</p>\n   /64 prefix) in the counter's key, for one hour, or 24 hours for the per-client daily allowance. We also\n   keep keyed hashes of addresses, never the addresses themselves: in daily traffic statistics (request\n   classes, paths and User-Agent product names; each day is deleted after ${TRAFFIC_DEFAULTS.retentionDays} days), in the record that limits how often a dropped\n-  connection is excused from payment (24 hours), and on the demand board (combined with the day).\n+  connection is excused from payment (24 hours), in the record that an address paid recently, which\n+  raises its limit on unpaid price quotes (one hour at most), and on the demand board (combined with the day).\n   The tollbooth waitlist form is closed, and every record it collected has been deleted from our\n   database; those records were never part of our offsite backups.</li>\n   <li><b>AI gateway inputs.</b> Prompts and inputs sent to the <code>/v1</code> endpoints (chat in the\n@@ -212,7 +213,10 @@ so every claim below is verifiable in code.</p>\n   that was not settled, a forgiven hang-up${allowanceOn ? \" or a served first-call allowance\" : \"\"}, whose authorization is still live\n   on chain, until the authorization's own validBefore plus ${Math.round(CONSUMED_VALIDITY_MARGIN_MS / 60000)} minutes, which can be long when the client\n   signs a long validity window), the signers of a Solana payment (stored only\n-  as a keyed hash), the source address of a Tempo credential, the payer the settlement receipt names, and,\n+  as a keyed hash), the source address of a Tempo credential, a Tempo pull credential answered 402 after its\n+  broadcast failed (kept with its route, amount and payer until the check for a late landing ends: minutes,\n+  at most 24 hours while the chain cannot be read, so a transfer that lands after the 402 is booked as owed),\n+  the payer the settlement receipt names, and,\n   on a refused payment, the resource URL it names (see telemetry above). The optional description and\n   <code>reason</code> annotation fields are not read, logged or retained. The machine-readable list is in\n   <a href=\"/.well-known/x402\">/.well-known/x402</a> under <code>payment.dataHandling</code>: <code>readsOnly</code>\n@@ -241,7 +245,9 @@ so every claim below is verifiable in code.</p>\n   task text you give them to a judgment model operated by TypeSafe to choose among candidate tools;\n   <code>/api/decide</code> also sends it to AI models via OpenRouter and to an OpenAI embedding model to\n   build the plan. When route-and-execute or a decision's execution buys from an outside seller to resell\n-  the result to you, that seller receives the request it needs to answer, sent and paid for by us.</li>\n+  the result to you, that seller receives the request it needs to answer, sent and paid for by us.\n+  A candidate seller may receive a request's inputs unpaid before we pay it, sometimes more than once:\n+  to check that it can serve the request and to read its price.</li>\n   <li>Card payments and subscriptions are processed by Stripe; transactional email (report links,\n   monitor and free alerts) is sent through ZeptoMail, with Resend as a fallback. Report products read public sources named in each\n   report (for example SEC EDGAR, openFDA, DNS and certificate-transparency logs, public blockchain"},{"sha":"f9f04f1e2e2aaf57d68d3b05f88eaab5b37002c8","filename":"src/refund-ledger.js","status":"modified","additions":7,"deletions":0,"changes":7,"blob_url":"https://github.com/MikeyPetrillo/Agent402/blob/81a674d1a3cf7fdbbcc04f4da366c144ccd393f7/src%2Frefund-ledger.js","raw_url":"https://github.com/MikeyPetrillo/Agent402/raw/81a674d1a3cf7fdbbcc04f4da366c144ccd393f7/src%2Frefund-ledger.js","contents_url":"https://api.github.com/repos/MikeyPetrillo/Agent402/contents/src%2Frefund-ledger.js?ref=81a674d1a3cf7fdbbcc04f4da366c144ccd393f7","patch":"@@ -83,6 +83,7 @@ for (const h of [db, fileDb]) if (h) h.exec(`\n     resolvedAt INTEGER\n   );\n   CREATE INDEX IF NOT EXISTS refunds_status ON refunds (status);\n+  CREATE INDEX IF NOT EXISTS refunds_created ON refunds (createdAt);\n `);\n // Additive column (2026-09-24): which payment wire carried the charge\n // (\"x402\", \"mpp\", \"mpp-tempo\", \"mpp-stripe\"). The MPP reconciliation job\n@@ -848,6 +849,12 @@ const selectCreatedBetween = db.prepare(\n export function refundsCreatedBetween(sinceMs, untilMs = Date.now(), { limit = 5000 } = {}) {\n   try { return selectCreatedBetween.all(Number(sinceMs) || 0, Number(untilMs) || Date.now(), limit); } catch { return []; }\n }\n+const selectOldestCreated = db.prepare(\"SELECT MIN(createdAt) AS t FROM refunds\");\n+/** The oldest row's createdAt, or null for an empty ledger: where a walk by\n+ *  createdAt starts, instead of the epoch. Same mirror as refundsCreatedBetween. */\n+export function oldestRefundCreatedAt() {\n+  try { const t = selectOldestCreated.get()?.t; return Number.isFinite(Number(t)) && t != null ? Number(t) : null; } catch { return null; }\n+}\n \n // A payer's OWN rows, for identity-bound surfaces only (my-usage, the weekly\n // digest): the caller has already proved the address. EVM addresses match"},{"sha":"7d137db639b2e556e23ca4af51c4adaaeb697938","filename":"src/replay-guard.js","status":"modified","additions":259,"deletions":84,"changes":343,"blob_url":"https://github.com/MikeyPetrillo/Agent402/blob/81a674d1a3cf7fdbbcc04f4da366c144ccd393f7/src%2Freplay-guard.js","raw_url":"https://github.com/MikeyPetrillo/Agent402/raw/81a674d1a3cf7fdbbcc04f4da366c144ccd393f7/src%2Freplay-guard.js","contents_url":"https://api.github.com/repos/MikeyPetrillo/Agent402/contents/src%2Freplay-guard.js?ref=81a674d1a3cf7fdbbcc04f4da366c144ccd393f7","patch":"@@ -48,7 +48,7 @@\n  * that does not pass it falls back to the per-process claim on a Redis\n  * failure.\n  */\n-import { createHash } from \"node:crypto\";\n+import { createHash, randomUUID } from \"node:crypto\";\n import algosdk from \"algosdk\";\n import { getTransactionDecoder } from \"@solana/kit\";\n import { paymentHeaderOf } from \"./payer.js\";\n@@ -340,48 +340,115 @@ export function paymentValidBeforeMs(req) {\n  * Replay guard. Redis-backed (shared across replicas) when configured and\n  * reachable; otherwise the original per-process fallback below. `consumed`\n  * maps a settled nonce → the time it settled; `inFlight` is the set of nonces\n- * whose gated call is currently mid-settle. All three methods are now async\n- * (a Redis round trip on the common path) - the server.js call site already\n- * runs inside an async middleware.\n+ * whose gated call is open on this process. All three methods are async (a\n+ * Redis round trip on the common path) - the server.js call site already runs\n+ * inside an async middleware.\n+ *\n+ * This process's own marks are read first: a payment it consumed, or holds in\n+ * flight, is refused here whichever backend answered when the mark was made,\n+ * so a store that fails between begin() and settle() (or recovers between\n+ * them) never lets one payment be claimed twice on this process. A consumed\n+ * mark is always kept locally as well as in Redis; when the Redis write fails\n+ * after its bounded retries the failure is logged and counted\n+ * (replayGuardStoreStatus) and the write is retried in the background until\n+ * it lands or the hold ends.\n+ *\n+ * A Redis claim holds a per-claim token: renewals and the drop on settle or\n+ * release act only while the name still holds that token, so a claim that\n+ * lapsed and was taken by another request is never dropped or kept alive by\n+ * its first holder. A claim taken on this process while the store did not\n+ * answer is written to the store once it answers, so other replicas see it.\n  *\n  * Bounded: entries expire after `ttlMs`, or at the authorization's own\n  * validBefore plus CONSUMED_VALIDITY_MARGIN_MS when the caller passes it and\n  * it is later. The validBefore hold matters for a GRANTED request that was not\n  * settled (a hang-up inside the forgiveness budget: the buyer was told it was\n  * free): its nonce is still live on chain, so only this mark stops a re-send\n- * from settling it. Total LOCAL consumed entries are capped at `maxEntries`\n- * with FIFO eviction (Redis expires its own keys via TTL, no separate cap\n- * needed). For a settled nonce eviction is safe (the chain refuses it); for an\n- * unsettled granted one it is not, which is one reason the paid x402 path\n- * requires the shared store whenever one is configured (server.js).\n+ * from settling it. Total LOCAL consumed entries, and background writes, are\n+ * each capped at `maxEntries` with FIFO eviction (Redis expires its own keys\n+ * via TTL, no separate cap needed). For a settled nonce eviction is safe (the\n+ * chain refuses it); for an unsettled granted one it is not, which is one\n+ * reason the paid x402 path requires the shared store whenever one is\n+ * configured (server.js).\n+ */\n+// Act on one name only while it still holds `value`: one script on a real\n+// Redis; a read then the command on a client without EVAL (test doubles).\n+const DEL_IF = \"if redis.call('get', KEYS[1]) == ARGV[1] then return redis.call('del', KEYS[1]) else return 0 end\";\n+const EXPIRE_IF = \"if redis.call('get', KEYS[1]) == ARGV[1] then return redis.call('expire', KEYS[1], ARGV[2]) else return 0 end\";\n+async function delIfValue(c, name, value) {\n+  if (typeof c.eval === \"function\") return c.eval(DEL_IF, { keys: [name], arguments: [String(value)] });\n+  if ((await c.get(name)) === value) return c.del(name);\n+  return 0;\n+}\n+async function expireIfValue(c, name, value, seconds) {\n+  if (typeof c.eval === \"function\") return c.eval(EXPIRE_IF, { keys: [name], arguments: [String(value), String(seconds)] });\n+  if ((await c.get(name)) === value) return c.expire(name, seconds);\n+  return 0;\n+}\n+\n+// Consumed marks the shared store did not take, across every guard in this\n+// process. `pending` counts the ones still being retried in the background.\n+const storeHealth = { consumedWriteFailures: 0, consumedWritesRecovered: 0, consumedWritesAbandoned: 0, pending: 0, lastFailAt: 0, lastError: null };\n+/**\n+ * One word for the consumed marks the shared store missed: \"pending\" while a\n+ * mark is held on this process only and retried in the background, else \"ok\".\n+ * `full` adds the counts.\n  */\n-// Drop a legacy-name entry only when it is this payment's own tagged one.\n-async function delIfTagged(c, name, tag) {\n-  if ((await c.get(REDIS_PREFIX + name)) === tag) await c.del(REDIS_PREFIX + name);\n+export function replayGuardStoreStatus({ full = false } = {}) {\n+  const status = storeHealth.pending > 0 ? \"pending\" : \"ok\";\n+  if (!full) return { status };\n+  const { pending, consumedWriteFailures, consumedWritesRecovered, consumedWritesAbandoned, lastFailAt, lastError } = storeHealth;\n+  return { status, pending, consumedWriteFailures, consumedWritesRecovered, consumedWritesAbandoned, lastFailAgoMs: lastFailAt ? Date.now() - lastFailAt : null, lastError };\n }\n+const sleep = (ms) => new Promise((r) => setTimeout(r, ms));\n \n-export function createReplayGuard({ ttlMs = SETTLED_HOLD_MS, maxEntries = 50_000, inflightTtlSeconds = INFLIGHT_TTL_SECONDS, renewMs = INFLIGHT_RENEW_MS, maxHoldMs = MAX_HOLD_MS } = {}) {\n-  // Local (per-process) fallback state — used whenever Redis is unset or a\n-  // call to it fails (unless the caller requires the shared store), so a\n-  // single replica keeps its full guarantee and a Redis outage degrades to a\n-  // per-replica one, never to zero protection.\n+export function createReplayGuard({\n+  ttlMs = SETTLED_HOLD_MS, maxEntries = 50_000, inflightTtlSeconds = INFLIGHT_TTL_SECONDS, renewMs = INFLIGHT_RENEW_MS, maxHoldMs = MAX_HOLD_MS,\n+  // Waits between the tries of a consumed-mark write (the first try runs at once).\n+  consumedRetryDelaysMs = [50, 250],\n+  // How often a consumed mark the store missed is written again.\n+  pendingRetryMs = 2_000,\n+} = {}) {\n+  // Local (per-process) state. `consumed` and `inFlight` are this process's\n+  // own marks, kept whatever backend answered; with no store configured they\n+  // are the whole guarantee, and a Redis outage degrades to a per-replica\n+  // one, never to zero protection.\n   const consumed = new Map(); // key -> expiresAt (ms): settledAt + ttlMs, or later for a long-lived authorization\n   const inFlight = new Set();\n   const ttlSeconds = Math.max(1, Math.ceil(ttlMs / 1000));\n+  // key -> this process's claim: { token, legacyTag, legacyHeld, shared }.\n+  // `shared` is true once the claim is in Redis under `token`.\n+  const claims = new Map();\n   // key -> interval renewing this process's Redis claim on it.\n   const renewers = new Map();\n-  function startRenew(key, legacyHeld = false) {\n+  // key -> { settledAt, until, claim }: a consumed mark the store missed,\n+  // oldest first, written again by one shared retry loop (schedulePending).\n+  const pending = new Map();\n+\n+  function startRenew(key) {\n     stopRenew(key);\n     const until = Date.now() + maxHoldMs;\n     const { primary, legacy } = namesOf(key);\n     const t = setInterval(async () => {\n-      if (Date.now() >= until) { stopRenew(key); return; }\n+      const claim = claims.get(key);\n+      if (!claim || Date.now() >= until) { stopRenew(key); return; }\n       try {\n         const c = await getSharedRedisClient();\n-        if (c) {\n-          await c.expire(REDIS_PREFIX + \"f:\" + primary, inflightTtlSeconds);\n-          if (legacyHeld && legacy) await c.expire(REDIS_PREFIX + \"f:\" + legacy, inflightTtlSeconds);\n+        if (!c) return;\n+        if (!claim.shared) {\n+          // Taken here while the store did not answer: written there now,\n+          // so another replica reads this payment in flight. A name another\n+          // request holds is left to it; this process's own mark still\n+          // refuses the payment here.\n+          if (await c.set(REDIS_PREFIX + \"f:\" + primary, claim.token, { NX: true, EX: inflightTtlSeconds })) {\n+            claim.shared = true;\n+            // Settled or released while the write was out: give it back.\n+            if (claims.get(key) !== claim) await delIfValue(c, REDIS_PREFIX + \"f:\" + primary, claim.token);\n+          }\n+          return;\n         }\n+        await expireIfValue(c, REDIS_PREFIX + \"f:\" + primary, claim.token, inflightTtlSeconds);\n+        if (claim.legacyHeld && legacy) await expireIfValue(c, REDIS_PREFIX + \"f:\" + legacy, claim.legacyTag, inflightTtlSeconds);\n       } catch { /* the next tick retries */ }\n     }, renewMs);\n     t.unref?.();\n@@ -408,13 +475,117 @@ export function createReplayGuard({ ttlMs = SETTLED_HOLD_MS, maxEntries = 50_000\n     if (until <= now) { consumed.delete(key); return false; }\n     return true;\n   }\n+  function markConsumedLocal(lk, until) {\n+    consumed.delete(lk);\n+    while (consumed.size >= maxEntries) {\n+      const oldest = consumed.keys().next().value;\n+      if (oldest === undefined) break;\n+      consumed.delete(oldest);\n+    }\n+    consumed.set(lk, until);\n+  }\n   // How long a consumed mark is held: ttlMs, or until the authorization's\n   // validBefore plus a margin when that is later.\n   function holdMsOf(now, validBeforeMs) {\n     const v = Number(validBeforeMs);\n     return Number.isFinite(v) && v > 0 ? Math.max(ttlMs, v + CONSUMED_VALIDITY_MARGIN_MS - now) : ttlMs;\n   }\n \n+  // Write the consumed mark (and its tagged legacy twin), trying again after\n+  // each of `delays`; then drop this process's claim. True once the mark is\n+  // written. Consumed mark FIRST, then the claim is dropped: at every moment\n+  // one of the two exists, so a begin() racing this settle reads \"consumed\"\n+  // or fails its SET NX (\"inflight\").\n+  async function writeConsumed(c, key, settledAt, until, claim, delays) {\n+    const { primary, legacy } = namesOf(key);\n+    let lastError = null;\n+    for (let i = 0; ; i++) {\n+      try {\n+        const ex = Math.max(1, Math.ceil((until - Date.now()) / 1000));\n+        if (!c) throw new Error(\"shared store unavailable\");\n+        await c.set(REDIS_PREFIX + \"c:\" + primary, String(settledAt), { EX: ex });\n+        // An earlier build still running reads any entry at the legacy name\n+        // as consumed. Tagged, so this build reads it as another payer's;\n+        // an earlier build's own mark there is never overwritten.\n+        if (legacy) await c.set(REDIS_PREFIX + \"c:\" + legacy, LEGACY_TAG + primary, { NX: true, EX: ex });\n+        lastError = null;\n+        break;\n+      } catch (e) {\n+        lastError = e;\n+        if (i >= delays.length) break;\n+        await sleep(delays[i]);\n+        try { c = await getSharedRedisClient(); } catch { c = null; }\n+      }\n+    }\n+    if (lastError) return { written: false, error: lastError };\n+    try {\n+      if (claim?.shared) await delIfValue(c, REDIS_PREFIX + \"f:\" + primary, claim.token);\n+      if (claim?.legacyHeld && legacy) await delIfValue(c, REDIS_PREFIX + \"f:\" + legacy, claim.legacyTag);\n+    } catch { /* the claim expires with its TTL; the mark is written */ }\n+    return { written: true };\n+  }\n+\n+  // One retry loop for every consumed mark the store missed, over a bounded\n+  // queue (`pending`, insertion order, at most `maxEntries`): a timer per\n+  // mark held one closure and one interval each, so an outage that missed\n+  // tens of thousands of marks grew the heap with them. Every pendingRetryMs\n+  // the loop walks the queue oldest first, drops a mark whose hold has ended\n+  // (abandoned), and writes the rest again; the pass stops at the first write\n+  // the store refuses, since the store is still down for the ones after it.\n+  let pendingTimer = null;\n+  let pendingBusy = false;\n+  function stopPendingLoop() {\n+    if (pendingTimer) { clearInterval(pendingTimer); pendingTimer = null; }\n+  }\n+  function clearPending(key) {\n+    if (!pending.delete(key)) return false;\n+    storeHealth.pending = Math.max(0, storeHealth.pending - 1);\n+    if (pending.size === 0) stopPendingLoop();\n+    return true;\n+  }\n+  async function retryPendingPass() {\n+    if (pendingBusy) return;\n+    pendingBusy = true;\n+    try {\n+      const t0 = Date.now();\n+      for (const [key, entry] of [...pending]) {\n+        if (entry.until <= t0) { if (pending.get(key) === entry && clearPending(key)) storeHealth.consumedWritesAbandoned++; }\n+      }\n+      if (pending.size === 0) return;\n+      let c = null;\n+      try { c = await getSharedRedisClient(); } catch { c = null; }\n+      if (!c) return;\n+      for (const [key, entry] of [...pending]) {\n+        if (pending.get(key) !== entry) continue;\n+        if (Date.now() >= entry.until) { if (clearPending(key)) storeHealth.consumedWritesAbandoned++; continue; }\n+        let r;\n+        try { r = await writeConsumed(c, key, entry.settledAt, entry.until, entry.claim, []); } catch (e) { r = { written: false, error: e }; }\n+        if (!r.written) break;\n+        if (pending.get(key) === entry && clearPending(key)) {\n+          storeHealth.consumedWritesRecovered++;\n+          console.warn(\"[replay-guard] a consumed mark the shared store missed is now written\");\n+        }\n+      }\n+    } catch { /* the next tick retries */ } finally { pendingBusy = false; }\n+  }\n+  // A consumed mark the store did not take: queued, and written again by the\n+  // shared loop every pendingRetryMs until it lands or its hold ends. This\n+  // process refuses the payment meanwhile (its local mark).\n+  function schedulePending(key, settledAt, until, claim) {\n+    clearPending(key);\n+    while (pending.size >= maxEntries) {\n+      const oldest = pending.keys().next().value;\n+      if (oldest === undefined || !clearPending(oldest)) break;\n+      storeHealth.consumedWritesAbandoned++;\n+    }\n+    storeHealth.pending++;\n+    pending.set(key, { settledAt, until, claim });\n+    if (!pendingTimer) {\n+      pendingTimer = setInterval(() => { void retryPendingPass(); }, pendingRetryMs);\n+      pendingTimer.unref?.();\n+    }\n+  }\n+\n   return {\n     /**\n      * Claim the nonce for this in-flight call. Returns:\n@@ -425,11 +596,18 @@ export function createReplayGuard({ ttlMs = SETTLED_HOLD_MS, maxEntries = 50_000\n      *                   configured and did not answer; the caller refuses\n      */\n     async begin(key, now = Date.now(), { requireShared = false } = {}) {\n+      pruneLocal(now);\n+      const lk = localKeyOf(key);\n+      // This process's own marks first: they hold whatever backend answered\n+      // when they were made.\n+      if (isConsumedLocal(lk, now)) return \"consumed\";\n+      if (inFlight.has(lk)) return \"inflight\";\n       const c = await getSharedRedisClient();\n       if (!c && requireShared && sharedLimitEnabled()) return \"unavailable\";\n       if (c) {\n         const { primary, legacy } = namesOf(key);\n-        const tag = LEGACY_TAG + primary;\n+        const token = randomUUID();\n+        const legacyTag = LEGACY_TAG + primary + \"|\" + token;\n         let claimedPrimary = false;\n         let legacyHeld = false;\n         try {\n@@ -438,30 +616,32 @@ export function createReplayGuard({ ttlMs = SETTLED_HOLD_MS, maxEntries = 50_000\n           // SET NX is the atomic claim: two replicas racing this same key\n           // cannot both receive a non-null reply, which is exactly the\n           // property inFlight.add() gave for free within one process.\n-          const claimed = await c.set(REDIS_PREFIX + \"f:\" + primary, String(now), { NX: true, EX: inflightTtlSeconds });\n+          const claimed = await c.set(REDIS_PREFIX + \"f:\" + primary, token, { NX: true, EX: inflightTtlSeconds });\n           if (!claimed) return \"inflight\";\n           claimedPrimary = true;\n-          const back = async (verdict) => { await c.del(REDIS_PREFIX + \"f:\" + primary); if (legacyHeld) await delIfTagged(c, \"f:\" + legacy, tag); return verdict; };\n+          const back = async (verdict) => { await delIfValue(c, REDIS_PREFIX + \"f:\" + primary, token); if (legacyHeld) await delIfValue(c, REDIS_PREFIX + \"f:\" + legacy, legacyTag); return verdict; };\n           if (legacy) {\n             // An earlier build's claim on this credential is honored; another\n             // payer's tagged claim there is not ours to wait on.\n-            legacyHeld = Boolean(await c.set(REDIS_PREFIX + \"f:\" + legacy, tag, { NX: true, EX: inflightTtlSeconds }));\n+            legacyHeld = Boolean(await c.set(REDIS_PREFIX + \"f:\" + legacy, legacyTag, { NX: true, EX: inflightTtlSeconds }));\n             if (!legacyHeld && isLegacyEntry(await c.get(REDIS_PREFIX + \"f:\" + legacy))) return back(\"inflight\");\n           }\n           // Read the consumed mark again under the claim: a settle writes its\n           // mark before it drops its claim, so a settle that finished between\n           // the first read and the claim is seen here.\n           if (await c.get(REDIS_PREFIX + \"c:\" + primary)) return back(\"consumed\");\n           if (legacy && isLegacyEntry(await c.get(REDIS_PREFIX + \"c:\" + legacy))) return back(\"consumed\");\n-          startRenew(key, legacyHeld);\n+          inFlight.add(lk);\n+          claims.set(key, { token, legacyTag, legacyHeld, shared: true });\n+          startRenew(key);\n           return \"ok\";\n         } catch (e) {\n           // A claim this call took before the store failed is dropped (best\n           // effort), so the buyer's retry is not refused as in flight for the\n           // claim's whole life on a payment that was never used.\n           if (claimedPrimary) {\n-            try { await c.del(REDIS_PREFIX + \"f:\" + primary); } catch { /* expires with its TTL */ }\n-            if (legacyHeld) { try { await delIfTagged(c, \"f:\" + legacy, tag); } catch { /* expires with its TTL */ } }\n+            try { await delIfValue(c, REDIS_PREFIX + \"f:\" + primary, token); } catch { /* expires with its TTL */ }\n+            if (legacyHeld) { try { await delIfValue(c, REDIS_PREFIX + \"f:\" + legacy, legacyTag); } catch { /* expires with its TTL */ } }\n           }\n           if (requireShared) {\n             console.error(\"[replay-guard] redis begin failed; refusing a route that requires the shared store:\", e.message);\n@@ -471,11 +651,15 @@ export function createReplayGuard({ ttlMs = SETTLED_HOLD_MS, maxEntries = 50_000\n           // fall through to the local path below\n         }\n       }\n-      pruneLocal(now);\n-      const lk = localKeyOf(key);\n-      if (isConsumedLocal(lk, now)) return \"consumed\";\n+      // Checked again: another call on this process may have claimed the\n+      // payment while this one waited on the store.\n       if (inFlight.has(lk)) return \"inflight\";\n       inFlight.add(lk);\n+      // With a store configured, the claim is written there once it answers.\n+      if (c || sharedLimitEnabled()) {\n+        claims.set(key, { token: randomUUID(), legacyTag: null, legacyHeld: false, shared: false });\n+        startRenew(key);\n+      }\n       return \"ok\";\n     },\n     /**\n@@ -488,25 +672,26 @@ export function createReplayGuard({ ttlMs = SETTLED_HOLD_MS, maxEntries = 50_000\n     async held(key, now = Date.now()) {\n       if (!key) return null;\n       const lk = localKeyOf(key);\n-      if (isConsumedLocal(lk, now)) return \"consumed\";\n-      if (inFlight.has(lk)) return \"inflight\";\n+      // This process's own marks answer whenever the store holds nothing (or\n+      // does not answer): they hold whatever backend answered when made.\n+      const local = () => (isConsumedLocal(lk, now) ? \"consumed\" : inFlight.has(lk) ? \"inflight\" : null);\n       let c = null;\n-      try { c = await getSharedRedisClient(); } catch { return sharedLimitEnabled() ? \"unavailable\" : null; }\n-      if (!c) return sharedLimitEnabled() ? \"unavailable\" : null;\n+      try { c = await getSharedRedisClient(); } catch { return local() || (sharedLimitEnabled() ? \"unavailable\" : null); }\n+      if (!c) return local() || (sharedLimitEnabled() ? \"unavailable\" : null);\n       try {\n         // Every name in one round trip (MGET): this read runs before the\n         // paywall on a gateway cache candidate.\n         const { primary, legacy } = namesOf(key);\n         const names = [REDIS_PREFIX + \"c:\" + primary, REDIS_PREFIX + \"f:\" + primary];\n         if (legacy) names.push(REDIS_PREFIX + \"c:\" + legacy, REDIS_PREFIX + \"f:\" + legacy);\n         const vals = typeof c.mGet === \"function\" ? await c.mGet(names) : await Promise.all(names.map((n) => c.get(n)));\n-        if (!Array.isArray(vals) || vals.length !== names.length) return \"unavailable\";\n+        if (!Array.isArray(vals) || vals.length !== names.length) return local() || \"unavailable\";\n         const [cP, fP, cL, fL] = vals;\n         if (cP || (legacy && isLegacyEntry(cL))) return \"consumed\";\n         if (fP || (legacy && isLegacyEntry(fL))) return \"inflight\";\n-        return null;\n+        return local();\n       } catch {\n-        return \"unavailable\";\n+        return local() || \"unavailable\";\n       }\n     },\n     /** Mark the nonce consumed: call only when the gated call was granted\n@@ -518,60 +703,50 @@ export function createReplayGuard({ ttlMs = SETTLED_HOLD_MS, maxEntries = 50_000\n      *  paid call. */\n     async settle(key, now = Date.now(), { validBeforeMs = null } = {}) {\n       stopRenew(key);\n-      const holdMs = holdMsOf(now, validBeforeMs);\n-      const c = await getSharedRedisClient();\n-      if (c) {\n-        try {\n-          // Consumed mark FIRST, then the claim is dropped: at every moment\n-          // one of the two exists, so a begin() racing this settle reads\n-          // \"consumed\" or fails its SET NX (\"inflight\"). Dropping the claim\n-          // first left a gap in which a re-sent authorization was claimed\n-          // \"ok\" and reached the paywall again.\n-          const { primary, legacy } = namesOf(key);\n-          const ex = Math.max(ttlSeconds, Math.ceil(holdMs / 1000));\n-          await c.set(REDIS_PREFIX + \"c:\" + primary, String(now), { EX: ex });\n-          // An earlier build still running reads any entry at the legacy name\n-          // as consumed. Tagged, so this build reads it as another payer's;\n-          // an earlier build's own mark there is never overwritten.\n-          if (legacy) await c.set(REDIS_PREFIX + \"c:\" + legacy, LEGACY_TAG + primary, { NX: true, EX: ex });\n-          await c.del(REDIS_PREFIX + \"f:\" + primary);\n-          if (legacy) await delIfTagged(c, \"f:\" + legacy, LEGACY_TAG + primary);\n-          return;\n-        } catch (e) {\n-          console.error(\"[replay-guard] redis settle failed, falling back to local state:\", e.message);\n-        }\n-      }\n+      const claim = claims.get(key);\n+      claims.delete(key);\n+      const until = now + holdMsOf(now, validBeforeMs);\n       const lk = localKeyOf(key);\n       inFlight.delete(lk);\n-      while (consumed.size >= maxEntries) {\n-        const oldest = consumed.keys().next().value;\n-        if (oldest === undefined) break;\n-        consumed.delete(oldest);\n-      }\n-      consumed.delete(lk);\n-      consumed.set(lk, now + holdMs);\n+      // Kept here whatever the store does, so this process never claims the\n+      // payment again while the mark is held.\n+      markConsumedLocal(lk, until);\n+      let c = null;\n+      try { c = await getSharedRedisClient(); } catch { c = null; }\n+      // No store configured: the local mark is the guarantee.\n+      if (!c && !sharedLimitEnabled()) return;\n+      const r = await writeConsumed(c, key, now, until, claim, consumedRetryDelaysMs);\n+      if (r.written) { clearPending(key); return; }\n+      storeHealth.consumedWriteFailures++;\n+      storeHealth.lastFailAt = Date.now();\n+      storeHealth.lastError = String(r.error?.message || r.error || \"unavailable\").slice(0, 120);\n+      console.error(`[replay-guard] redis settle failed after ${consumedRetryDelaysMs.length + 1} tries; the consumed mark is held on this process and written again in the background:`, storeHealth.lastError);\n+      schedulePending(key, now, until, claim);\n     },\n     /** Release the nonce — call when the gated call was NOT granted, so a\n-     *  legitimate retry of the still-valid authorization can proceed. */\n+     *  legitimate retry of the still-valid authorization can proceed. Only\n+     *  this process's own claim is dropped: a name another request holds\n+     *  is left to it. */\n     async release(key) {\n       stopRenew(key);\n-      const c = await getSharedRedisClient();\n-      if (c) {\n-        try {\n-          const { primary, legacy } = namesOf(key);\n-          await c.del(REDIS_PREFIX + \"f:\" + primary);\n-          if (legacy) await delIfTagged(c, \"f:\" + legacy, LEGACY_TAG + primary);\n-          return;\n-        } catch (e) {\n-          console.error(\"[replay-guard] redis release failed, falling back to local state:\", e.message);\n-        }\n-      }\n+      const claim = claims.get(key);\n+      claims.delete(key);\n       inFlight.delete(localKeyOf(key));\n+      if (!claim?.shared) return;\n+      try {\n+        const c = await getSharedRedisClient();\n+        if (!c) return;\n+        const { primary, legacy } = namesOf(key);\n+        await delIfValue(c, REDIS_PREFIX + \"f:\" + primary, claim.token);\n+        if (claim.legacyHeld && legacy) await delIfValue(c, REDIS_PREFIX + \"f:\" + legacy, claim.legacyTag);\n+      } catch (e) {\n+        console.error(\"[replay-guard] redis release failed; the claim expires with its TTL:\", e.message);\n+      }\n     },\n-    /** Introspection for tests / stats — LOCAL fallback state only; Redis\n-     *  state is shared and has no single-process notion of \"size\". */\n+    /** Introspection for tests / stats: LOCAL state only; Redis state is\n+     *  shared and has no single-process notion of \"size\". */\n     _state() {\n-      return { consumed: consumed.size, inFlight: inFlight.size, renewing: renewers.size };\n+      return { consumed: consumed.size, inFlight: inFlight.size, renewing: renewers.size, pendingConsumed: pending.size };\n     },\n   };\n }"},{"sha":"d556dd3f38a987e79455a358cf24cda9cb30aafc","filename":"src/seo.js","status":"modified","additions":2,"deletions":0,"changes":2,"blob_url":"https://github.com/MikeyPetrillo/Agent402/blob/81a674d1a3cf7fdbbcc04f4da366c144ccd393f7/src%2Fseo.js","raw_url":"https://github.com/MikeyPetrillo/Agent402/raw/81a674d1a3cf7fdbbcc04f4da366c144ccd393f7/src%2Fseo.js","contents_url":"https://api.github.com/repos/MikeyPetrillo/Agent402/contents/src%2Fseo.js?ref=81a674d1a3cf7fdbbcc04f4da366c144ccd393f7","patch":"@@ -620,6 +620,8 @@ ${flatTiersLine()}\n ## Key machine surfaces\n - [/agents.md](${baseUrl}${AGENTS_MD_PATH}): the front door for an agent in markdown - the first call and its price, access with no account or API key, when to use the service and when not to, the recovery contract, then how to connect and pay\n - [/SKILL.md](${baseUrl}/SKILL.md): agent-onboarding skill sheet - setup (MCP server / SDK / plain HTTP), discover, pay (x402, MPP or proof-of-work), read the 402, common issues. Start here if you are setting Agent402 up for the first time\n+- [/guides/buying-at-volume](${baseUrl}/guides/buying-at-volume): buying in bursts - the per-address limits and their \\`Retry-After\\`, retries that never pay twice, async jobs, spend caps and the errors to handle\n+- [/guides/content-pipeline](${baseUrl}/guides/content-pipeline): a content pipeline from paid calls - research, script, voiceover, images, transcription, subtitles, dubbing and media checks from one wallet, with the stages that run as jobs and the rail to pay on\n - [/api/search](${baseUrl}/api/search): **front door** - live web search (title, URL, snippet). Start here to discover pages; follow with extract or answer\n - [/api/answer](${baseUrl}/api/answer): **front door** - cited answer grounded in live web search results\n - [/api/search-news](${baseUrl}/api/search-news): live news search for current events / headlines"},{"sha":"35926fb013f66c66bbe09c58ec7d8ab4035f8347","filename":"src/server.js","status":"modified","additions":221,"deletions":86,"changes":307,"blob_url":"https://github.com/MikeyPetrillo/Agent402/blob/81a674d1a3cf7fdbbcc04f4da366c144ccd393f7/src%2Fserver.js","raw_url":"https://github.com/MikeyPetrillo/Agent402/raw/81a674d1a3cf7fdbbcc04f4da366c144ccd393f7/src%2Fserver.js","contents_url":"https://api.github.com/repos/MikeyPetrillo/Agent402/contents/src%2Fserver.js?ref=81a674d1a3cf7fdbbcc04f4da366c144ccd393f7","patch":"@@ -3,11 +3,12 @@ import { heapSamplingReport } from \"./boot-profile.js\"; // diagnostic boot CPU p\n import \"./tls-distrust-boot.js\"; // refuse TLS chains through a distrusted intermediate CA, process-wide (see the file)\n import { mtaStsPolicy } from \"./mta-sts.js\";\n import { securityHeaders } from \"./security-headers.js\";\n-import { createLargeBodyGate, largeBodyInflightMaxBytes, unlessBodyUnread } from \"./large-body-gate.js\";\n+import { createLargeBodyGate, largeBodyInflightMaxBytes, unlessBodyUnread, UNPAID_LIMITS as LARGE_BODY_UNPAID_LIMITS } from \"./large-body-gate.js\";\n import { carriesPaymentAttempt, registerOfferedNetworks } from \"./payment-attempt.js\";\n import { retiredEntryFor, assertRetiredRegistryConsistent, retirementHeaders, RETIRED_CONVERTERS_AT } from \"./retired-tools.js\";\n import { createTrafficStore, trafficMiddleware } from \"./traffic-classifier.js\";\n-import { redisSharedSettled, createUnpaidQuoteBudget, looksLikePayment, unpaidQuoteBudgetPerHour, isMcpLoopback, normalizeCatalogPath } from \"./unpaid-quote-budget.js\";\n+import { redisSharedSettled, createUnpaidQuot
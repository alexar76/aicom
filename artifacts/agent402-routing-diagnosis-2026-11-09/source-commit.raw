8: 70 HEADs with a 180 KB body reached the quoter past\n@@ -3458,7 +3500,32 @@ app.use(\"/v1/metered\", (req, res, next) => {\n   // src/unpaid-quote-budget.js because the unpaid price-check budget has to\n   // read a credential exactly the same way, and two copies of this rule drift.\n   const paid = looksLikePayment(req.headers);\n-  if (!paid && meteredQuoteLimiter.check(clientIp(req)).limited) return res.status(429).json({ error: \"Too many unpaid quote requests from this address; send the paid retry, or slow down.\" });\n+  // The 429 names its wait and links the guide to buying in bursts.\n+  const refuseQuote = () => {\n+    res.set(\"Retry-After\", \"60\");\n+    return res.status(429).json({ error: \"Too many unpaid quote requests from this address; send the paid retry, or slow down.\", retryAfterSeconds: 60, guide: `${BASE_URL.replace(/\\/$/, \"\")}${BUYING_AT_VOLUME_PATH}` });\n+  };\n+  if (!paid) {\n+    // Every unpaid quote counts against the plain figure first. Past it, a\n+    // quote is served only on a credit a settled /v1/metered call from this\n+    // address earned (src/paid-quote-trust.js creditMetered), so free quotes\n+    // stay bounded by paid metered calls, under the raised ceilings.\n+    const trustKey = quoteClientKeyOf(req);\n+    const egressKey = workerEgressAddressKeyOf(req);\n+    const ip = clientIp(req);\n+    if (!meteredQuoteLimiter.peek(ip).limited) {\n+      meteredQuoteLimiter.check(ip);\n+      return next();\n+    }\n+    // The raised ceilings are read before a credit is spent, so a quote they\n+    // refuse keeps its credit.\n+    if (meteredTrustedQuoteLimiter.peek(trustKey).limited) return refuseQuote();\n+    if (egressKey && meteredTrustedEgressLimiter.peek(egressKey).limited) return refuseQuote();\n+    if (!QUOTE_TRUST.takeMeteredCredit(trustKey)) return refuseQuote();\n+    meteredTrustedQuoteLimiter.check(trustKey);\n+    if (egressKey) meteredTrustedEgressLimiter.check(egressKey);\n+    return next();\n+  }\n   if (paid) {\n     // A header that only decodes as a payment still buys a quote: the gate\n     // prices the body before it verifies. Such a request is counted once its\n@@ -3902,6 +3969,10 @@ app.get(\"/api/gateway-status\", async (req, res) => {\n     // GATEWAY_WITHDRAW_ALERT_USD). One word each publicly; the figure and\n     // the per-domain split on the operator view only.\n     gatewayPending: { status: await gatewayPendingStatus() },\n+    // EVM settlements that failed naming a transaction or an authorization\n+    // (src/late-settlements.js): ok / near_capacity / full / unresolved. One\n+    // word; the heartbeat and the status Worker page on unresolved and full.\n+    lateSettlements: { status: await lateSettleBookForOperator().then((b) => b.alarmStatus()).catch(() => \"unknown\") },\n     gatewayBalance: (() => { try { return gatewayBalanceStatus({ full }); } catch { return { status: \"unknown\" }; } })(),\n     // Redis persistence (src/redis-persistence.js): on / degraded / off /\n     // unknown. One word publicly; the operator also gets the INFO fields.\n@@ -4021,6 +4092,12 @@ app.get(\"/api/gateway-status\", async (req, res) => {\n     // publicly; the clock for the operator, the order on\n     // /__operator/tool-failures.json (robinhoodOrder).\n     robinhoodSettler: (() => { try { return robinhoodSettlerStatus({ full }); } catch { return { status: \"unknown\" }; } })(),\n+    // replayStore reads pending while a settled payment's consumed mark that\n+    // the shared store missed is held on this process only and written again\n+    // by the replay guard's retry loop (src/replay-guard.js), ok otherwise.\n+    // One word publicly; the counts (pending, missed, recovered, abandoned)\n+    // for the operator.\n+    replayStore: (() => { try { return replayGuardStoreStatus({ full }); } catch { return { status: \"unknown\" }; } })(),\n     // subscriptionRenewals reads unconfirmed while a wallet-billed monitor\n     // renewal has stayed unconfirmed (its send's landing undecided by the\n     // chain read, so nothing is signed again) for longer than\n@@ -6003,6 +6080,8 @@ app.get(\"/__operator/traffic.json\", (req, res) => {\n   res.set(\"Cache-Control\", \"no-store\").json({\n     ...TRAFFIC.report({ days: Math.min(14, parseInt(req.query.days, 10) || 2), top: Math.min(100, parseInt(req.query.top, 10) || 15) }),\n     unpaidQuoteBudget: UNPAID_BUDGET ? UNPAID_BUDGET.stats() : { budget: 0 },\n+    // Bucketed counts of addresses trusted after a paid call, never an address.\n+    paidQuoteTrust: QUOTE_TRUST.stats(),\n   });\n });\n // Serving health for the heartbeat: one verdict plus the counts behind it,\n@@ -6544,6 +6623,24 @@ app.post(\"/__operator/circle-pending\", express.json(), async (req, res) => {\n     return res.status(r.ok ? 200 : 400).set(\"Cache-Control\", \"no-store\").json(r);\n   } catch { return res.status(503).json({ error: \"the pending book could not be written\" }); }\n });\n+// The late-settlement book (src/late-settlements.js): an operator resolves an\n+// UNRESOLVED entry (booked_owed, paid or dismissed, with a note; recorded\n+// before the entry is dropped) or acknowledges this process's unrecorded\n+// bookings, which clears the lateSettlements word. Listed on refunds.json\n+// (unconfirmedSettlements).\n+app.post(\"/__operator/late-settlements\", express.json({ limit: \"8kb\" }), async (req, res) => {\n+  if (!operatorAuthed(req)) return res.status(404).json({ error: \"Not found\" });\n+  const { action, key, outcome, note, tx, decimals } = req.body || {};\n+  let book;\n+  try { book = await lateSettleBookForOperator(); } catch { return res.status(503).json({ error: \"the late-settlement book could not be read\" }); }\n+  try {\n+    let r;\n+    if (action === \"resolve\") r = await book.resolve(typeof key === \"string\" ? key : \"\", { outcome, note, tx: typeof tx === \"string\" ? tx : null, decimals: decimals ?? null });\n+    else if (action === \"acknowledge_unrecorded\") r = await book.acknowledgeUnrecorded({ note });\n+    else return res.status(400).json({ error: 'pass {\"action\":\"resolve\",\"key\":\"<entry key>\",\"outcome\":\"booked_owed\"|\"paid\"|\"dismissed\",\"note\":\"what was checked\",\"tx\":\"0x... (paid: the refund transfer)\"} or {\"action\":\"acknowledge_unrecorded\",\"note\":\"what was checked\"}' });\n+    return res.status(r.ok ? 200 : 400).set(\"Cache-Control\", \"no-store\").json({ ...r, status: await book.alarmStatus({ ttlMs: 0 }).catch(() => \"unknown\") });\n+  } catch { return res.status(503).json({ error: \"the late-settlement book could not be written\" }); }\n+});\n app.post(\"/__operator/seller-funding\", express.json(), async (req, res) => {\n   if (!operatorAuthed(req)) return res.status(404).json({ error: \"Not found\" });\n   const { action, wallet, note } = req.body || {};\n@@ -10215,9 +10312,16 @@ if (!FREE_MODE) {\n   // createTempoGate refuses to mount (fail closed).\n   tempoPushDebts = createTempoPushDebts({\n     recordOwed: recordRefundOwed, voidOnClaim: voidOwedOnClaim, voidForServe: voidOwedForServe, reopenHeld: reopenHeldClaim, renoteVoid: renoteVoidRefund, renoteOwed: renoteOwedRefund, promoteToHangup: promoteOwedToHangup, restateHandlerFailure: restateOwedAsHandlerFailure, refundByEvidence,\n-    recordChargedFailure, isSynthetic: isSyntheticRequest,\n+    recordChargedFailure,\n+    // A late-landing sweep books from a stored request, which says whether it was synthetic.\n+    isSynthetic: (req) => (typeof req?.__lateWatchSynthetic === \"boolean\" ? req.__lateWatchSynthetic : isSyntheticRequest(req)),\n     slugOf: (req) => CATALOG[`${req.method} ${req.path}`]?.slug,\n   });\n+  // A claim held for a run whose process died is owed again (leased sweep).\n+  void startTempoHeldClaimSweep({ saleFor: async (tx) => (await import(\"./sales-ledger.js\")).saleByTxFresh(tx) });\n+  // Every Tempo late-landing watch is on record (src/tempo-late-watches.js),\n+  // so one past the per-process bound or cut short by a restart is still read.\n+  configureTempoLateWatches(createLateWatchLedger());\n   const tempoGate = createTempoGate({\n     replayGuard: tempoReplayGuard,\n     // Chain-truth fallback on relay broadcast failure (2026-08-20): a relay\n@@ -10263,7 +10367,9 @@ if (!FREE_MODE) {\n     // The row a push transfer already holds, read before a route refusal\n     // books one (createTempoGate refuseConfirmedPush).\n     pushRowOf: (hash) => refundByEvidence(hash) || null,\n+    syntheticOf: isSyntheticRequest,\n   });\n+  if (tempoGate) void startLateWatchSweep({ sweepOnce: () => tempoGate.sweepLateWatches() });\n   if (tempoGate) {\n     app.use(tempoGate);\n     tempoGateMounted = true;\n@@ -10324,54 +10430,18 @@ if (!FREE_MODE) {\n   }\n }\n \n-// Opt-in idempotency (safe paid retry): src/idempotency.js. Mounted after the\n-// credits gate and before the paywall, so a replay hit skips settlement.\n-// A re-sent x402 EVM payment (same nonce, route and body) with no explicit key\n-// replays its first answer the same way, except on a route whose effect\n-// outlives the answer (hasLastingEffect), on an identity-bound route (its\n-// answer is one payer's own data, and a settled payment header can be rebuilt\n-// from public chain data, so only a key the buyer chose may replay it), and on\n-// a streamed call, which the store never holds. Replays are counted per slug on the operator detail\n-// (/__operator/tool-failures.json), never per payer.\n-app.use(createIdempotency({\n-  isCatalogRoute: (req) => Boolean(CATALOG[`${req.method} ${req.path}`]),\n-  freeMode: FREE_MODE,\n-  implicitReplay: (req) => implicitReplayAllowed(CATALOG[`${req.method} ${req.path}`], req, { hasLastingEffect, isIdentityBound: isIdentityBoundRoute }),\n-  onReplay: async (req, { implicit, charged }) => {\n-    const def = CATALOG[`${req.method} ${req.path}`];\n-    if (def) toolFailureMonitor().noteReplay(def.slug, { implicit });\n-    if (!(charged && typeof charged.tx === \"string\" && charged.tx)) return;\n-    // The stored answer was charged but never delivered (the buyer left while\n-    // it settled). Its debt is voided BEFORE the answer goes out, like the\n-    // Tempo push claim (tempoPushDebts.claimForServe): a row the refund run\n-    // has already claimed or paid is not voided, and then the answer is not\n-    // served either, so a buyer is served once, never both served and\n-    // refunded. No row, or one already void, serves.\n-    let voided = false;\n-    try { voided = (await voidOwedOnClaim(charged.tx, \"served on the resend of the same payment\")) === true; } catch { voided = false; }\n-    if (voided) { console.log(`[hangup] undelivered answer served on resend (${req.method} ${req.path} tx=${charged.tx}); its debt is void`); return; }\n-    let row = null;\n-    try { row = await refundByEvidenceFresh(charged.tx); } catch { row = null; }\n-    if (!row || row.status === \"void\") return;\n-    console.warn(`[hangup] resend of a refunded payment not served (${req.method} ${req.path} tx=${charged.tx}; refund #${row.id} ${row.status})`);\n-    return { serve: false, status: 402, body: {\n-      error: \"payment_refunded\",\n-      hint: \"The payment this request carries was refunded (or is being refunded) because its first answer was never delivered, so it no longer pays for a request. Request the resource again with a fresh payment.\",\n-      refund: { status: [\"owed\", \"sending\", \"paid\"].includes(row.status) ? row.status : \"owed\", lookup: `${BASE_URL}/api/refunds/lookup?tx=${encodeURIComponent(charged.tx)}` },\n-    } };\n-  },\n-}));\n-\n-// x402 paywall for the catalog routes\n // POST on a GET-only tool is served, not 405'd (2026-08-28): agents POST\n // JSON to every route they discover - a buyer that had just paid for one\n // tool walked the catalog POSTing and got 405 on search, search-news,\n // search-images, search-videos, search-suggest, ip-info, card-validate ...\n // and stopped. The method is rewritten to GET for the IDENTICAL gate chain\n-// (funnel, PoW, replay guard, x402 paywall keyed \"GET /path\"), the parsed\n-// JSON body is the input (handlerInputOf merges query + body, and the GET\n-// cache keys on that merged input), and Allow/405 remain for a GET sent to\n-// a POST-only tool (a GET cannot carry the body those handlers need).\n+// (idempotency, funnel, PoW, replay guard, x402 paywall keyed \"GET /path\"),\n+// the parsed JSON body is the input (handlerInputOf merges query + body, and\n+// the GET cache keys on that merged input), and Allow/405 remain for a GET\n+// sent to a POST-only tool (a GET cannot carry the body those handlers need).\n+// Mounted BEFORE idempotency, so the store sees one canonical request: an\n+// aliased call's re-sent payment or keyed retry replays its stored answer\n+// instead of running into the replay guard (or a second credits debit).\n app.use((req, res, next) => {\n   if (req.method === \"POST\" && !CATALOG[`POST ${req.path}`] && CATALOG[`GET ${req.path}`]) {\n     req.__methodAliased = \"POST\";\n@@ -10398,6 +10468,58 @@ app.use((req, res, next) => {\n   }\n   next();\n });\n+\n+// Opt-in idempotency (safe paid retry): src/idempotency.js. Mounted after the\n+// credits gate and the method alias, and before the paywall, so a replay hit\n+// skips settlement.\n+// A re-sent x402 EVM payment (same nonce, route and body) with no explicit key\n+// replays its first answer the same way, except on a route whose effect\n+// outlives the answer (hasLastingEffect), on an identity-bound route (its\n+// answer is one payer's own data, and a settled payment header can be rebuilt\n+// from public chain data, so only a key the buyer chose may replay it), and on\n+// a streamed call, which the store never holds. Replays are counted per slug on the operator detail\n+// (/__operator/tool-failures.json), never per payer.\n+app.use(createIdempotency({\n+  isCatalogRoute: (req) => Boolean(CATALOG[`${req.method} ${req.path}`]),\n+  freeMode: FREE_MODE,\n+  implicitReplay: (req) => implicitReplayAllowed(CATALOG[`${req.method} ${req.path}`], req, { hasLastingEffect, isIdentityBound: isIdentityBoundRoute }),\n+  onReplay: async (req, { implicit, charged }) => {\n+    const def = CATALOG[`${req.method} ${req.path}`];\n+    if (def) toolFailureMonitor().noteReplay(def.slug, { implicit });\n+    if (!(charged && typeof charged.tx === \"string\" && charged.tx)) return;\n+    // The stored answer was charged but never delivered (the buyer left while\n+    // it settled). Its debt is voided BEFORE the answer goes out, like the\n+    // Tempo push claim (tempoPushDebts.claimForServe): a row the refund run\n+    // has already claimed or paid is not voided, and then the answer is not\n+    // served either, so a buyer is served once, never both served and\n+    // refunded. No row, or one already void, serves. A void that did not land\n+    // while the row still reads owed (a failed or queued ledger write, which\n+    // lands later) asks for a retry instead of refusing as refunded.\n+    const { verdict, voided, row } = await chargedReplayVerdict(charged.tx, {\n+      voidOnClaim: (tx) => voidOwedOnClaim(tx, \"served on the resend of the same payment\"),\n+      rowOf: (tx) => refundByEvidenceFresh(tx),\n+    });\n+    if (verdict === \"serve\") {\n+      if (voided) console.log(`[hangup] undelivered answer served on resend (${req.method} ${req.path} tx=${charged.tx}); its debt is void`);\n+      return;\n+    }\n+    if (verdict === \"pending\") {\n+      console.warn(`[hangup] resend of an undelivered answer held: its debt's void has not landed (${req.method} ${req.path} tx=${charged.tx}; refund #${row.id})`);\n+      return { serve: false, status: 503, retryAfter: 10, body: {\n+        error: \"replay_pending\",\n+        hint: \"The answer this payment bought is stored, and the ledger has not yet confirmed it as served. Nothing more is charged. Retry shortly with the same payment to receive it.\",\n+      } };\n+    }\n+    console.warn(`[hangup] resend of a refunded payment not served (${req.method} ${req.path} tx=${charged.tx}; refund #${row.id} ${row.status})`);\n+    return { serve: false, status: 402, body: {\n+      error: \"payment_refunded\",\n+      hint: \"The payment this request carries was refunded (or is being refunded) because its first answer was never delivered, so it no longer pays for a request. Request the resource again with a fresh payment.\",\n+      refund: { status: [\"owed\", \"sending\", \"paid\"].includes(row.status) ? row.status : \"owed\", lookup: `${BASE_URL}/api/refunds/lookup?tx=${encodeURIComponent(charged.tx)}` },\n+    } };\n+  },\n+}));\n+\n+// x402 paywall for the catalog routes\n if (FREE_MODE) {\n   console.warn(\"FREE_MODE=true - payments are DISABLED. Do not run this in production.\");\n } else {\n@@ -11039,6 +11161,19 @@ app.use((req, res, next) => {\n       // X-PAYMENT-RESPONSE was the v1 name (kept for old middleware versions).\n       // getHeader is case-insensitive but NOT prefix-insensitive, so check both.\n       const settleReceipt = res.getHeader(\"PAYMENT-RESPONSE\") || res.getHeader(\"X-PAYMENT-RESPONSE\");\n+      // A final 200 that settled on any rail (or a credits debit) trusts this\n+      // client address for the paid-quote window (src/paid-quote-trust.js).\n+      // Never in FREE_MODE, never for a free call: paidAndSettled reads the\n+      // settle evidence, and this hook skips allowance grants and forgiven\n+      // hang-ups before it runs.\n+      if (!FREE_MODE && res.statusCode === 200 && res.getHeader(\"X-Pow-Accepted\") !== \"true\" && res.getHeader(\"X-Trial-Accepted\") !== \"true\" && paidAndSettled(req, res, { settleReceipt })) {\n+        try {\n+          const trustKey = quoteClientKeyOf(req);\n+          QUOTE_TRUST.mark(trustKey);\n+          // Only a settled /v1/metered call earns metered quote credits.\n+          if (String(req.originalUrl || req.url || \"\").split(\"?\")[0].startsWith(\"/v1/metered/\")) QUOTE_TRUST.creditMetered(trustKey);\n+        } catch { /* trust is a convenience, never a reason to fail */ }\n+      }\n       if (res.statusCode === 200) {\n         const powAccepted = res.getHeader(\"X-Pow-Accepted\") === \"true\";\n         const trialAccepted = res.getHeader(\"X-Trial-Accepted\") === \"true\";"},{"sha":"7c39fed22db8d22f635e597f74ab07d91a0a0e84","filename":"src/settle-onchain-proof.js","status":"modified","additions":1,"deletions":1,"changes":2,"blob_url":"https://github.com/MikeyPetrillo/Agent402/blob/81a674d1a3cf7fdbbcc04f4da366c144ccd393f7/src%2Fsettle-onchain-proof.js","raw_url":"https://github.com/MikeyPetrillo/Agent402/raw/81a674d1a3cf7fdbbcc04f4da366c144ccd393f7/src%2Fsettle-onchain-proof.js","contents_url":"https://api.github.com/repos/MikeyPetrillo/Agent402/contents/src%2Fsettle-onchain-proof.js?ref=81a674d1a3cf7fdbbcc04f4da366c144ccd393f7","patch":"@@ -139,7 +139,7 @@ export async function recoverAlreadyOnChain(ctx, { saleByTx = null, prove = prov\n   if (typeof nonce !== \"string\" || !nonce) return { recovered: false, reason: \"no EIP-3009 authorization in the payload\" };\n   // The first request to reach settle with this authorization owns it; a\n   // replay that arrives while (or after) the original settles does not.\n-  const nonceKey = nonceClaimKey(network, nonce);\n+  const nonceKey = nonceClaimKey(network, nonce, ctx?.paymentPayload?.payload?.authorization?.from || \"\");\n   const nonceOwner = await claimSettlementKey(nonceKey, state.id, { ttlSeconds: INFLIGHT_TTL_SECONDS });\n   if (!nonceOwner.claimed) return { recovered: false, reason: \"another request owns this authorization\" };\n   state.nonceKey = nonceKey;"},{"sha":"5340c404ad19bc301e9b8df1350b6c7f7c00fe78","filename":"src/settlement-claims.js","status":"modified","additions":60,"deletions":14,"changes":74,"blob_url":"https://github.com/MikeyPetrillo/Agent402/blob/81a674d1a3cf7fdbbcc04f4da366c144ccd393f7/src%2Fsettlement-claims.js","raw_url":"https://github.com/MikeyPetrillo/Agent402/raw/81a674d1a3cf7fdbbcc04f4da366c144ccd393f7/src%2Fsettlement-claims.js","contents_url":"https://api.github.com/repos/MikeyPetrillo/Agent402/contents/src%2Fsettlement-claims.js?ref=81a674d1a3cf7fdbbcc04f4da366c144ccd393f7","patch":"@@ -6,15 +6,20 @@\n // transaction is this request's own; a replayed payload must never be served\n // twice. These claims make ownership explicit:\n //\n-//   nonce:<network>:<nonce>  taken by the first request to reach settle with\n-//                            that authorization (onBeforeSettle). While one\n+//   nonce:<network>:<from>:<nonce>\n+//                            taken by the first request to reach settle with\n+//                            that EVM authorization (onBeforeSettle), <from>\n+//                            its signer lowercased. While one\n //                            request holds it, another request carrying the\n //                            same authorization is refused before it calls the\n //                            facilitator (402, nothing charged). Held for a\n //                            short in-flight TTL, made long when the payment\n //                            settles, released when the settle fails and\n //                            nothing recovered it, so a legitimate retry of an\n //                            unsettled authorization still goes through.\n+//                            An earlier build's name without the signer,\n+//                            nonce:<network>:<nonce>, is honored and written\n+//                            tagged (legacyNonceClaimKey).\n //   nonce:<network>:<signer>:<nonce>\n //                            the same claim for a Stellar payment: one per\n //                            signed Soroban authorization entry of the payer\n@@ -80,6 +85,12 @@ function within(p) {\n \n const local = new Map(); // key -> { holder, until }\n \n+// A claim this build writes at a name an earlier build also reads (the EVM\n+// nonce key without the signer) holds LEGACY_TAG + the holder, so this build\n+// tells it from an earlier build's claim there; the holder still owns it.\n+export const LEGACY_TAG = \"v2|\";\n+const owns = (owner, holder) => owner === holder || owner === LEGACY_TAG + holder;\n+\n function localGet(key, now) {\n   const hit = local.get(key);\n   if (hit && hit.until > now) return hit;\n@@ -111,7 +122,7 @@ export async function claimSettlementKey(key, holder, { ttlSeconds = SETTLED_TTL\n       // and another holder is refused, so one key never has two owners in\n       // one process because the backend changed between two claims.\n       const mine = localGet(key, now);\n-      if (mine && mine.holder !== holder) {\n+      if (mine && !owns(mine.holder, holder)) {\n         await within(c.set(k, mine.holder, { NX: true, EX: Math.max(1, Math.ceil((mine.until - now) / 1000)) })).catch(() => {});\n         return { claimed: false, holder: mine.holder };\n       }\n@@ -120,13 +131,13 @@ export async function claimSettlementKey(key, holder, { ttlSeconds = SETTLED_TTL\n         return { claimed: true, holder };\n       }\n       const owner = await within(c.get(k));\n-      return { claimed: owner === holder, holder: owner };\n+      return { claimed: owns(owner, holder), holder: owner };\n     } catch (e) {\n       console.error(\"[settlement-claims] redis claim failed, falling back to local state:\", e.message);\n     }\n   }\n   const hit = localGet(key, now);\n-  if (hit) return { claimed: hit.holder === holder, holder: hit.holder };\n+  if (hit) return { claimed: owns(hit.holder, holder), holder: hit.holder };\n   localSet(key, holder, ttlSeconds, now);\n   return { claimed: true, holder };\n }\n@@ -138,32 +149,56 @@ export async function extendSettlementKey(key, holder, { ttlSeconds = SETTLED_TT\n     try {\n       const k = PREFIX + key;\n       const owner = await within(c.get(k));\n-      if (owner === null || owner === holder) await within(c.set(k, holder, { EX: ttlSeconds }));\n-      if (owner === null || owner === holder) localSet(key, holder, ttlSeconds, now);\n+      // Kept as written (a tagged claim stays tagged).\n+      if (owner === null || owns(owner, holder)) {\n+        await within(c.set(k, owner ?? holder, { EX: ttlSeconds }));\n+        localSet(key, owner ?? holder, ttlSeconds, now);\n+      }\n       return;\n     } catch (e) {\n       console.error(\"[settlement-claims] redis extend failed, falling back to local state:\", e.message);\n     }\n   }\n   const hit = localGet(key, now);\n-  if (!hit || hit.holder === holder) localSet(key, holder, ttlSeconds, now);\n+  if (!hit || owns(hit.holder, holder)) localSet(key, hit ? hit.holder : holder, ttlSeconds, now);\n }\n \n+const DEL_IF_OWNER = \"local v = redis.call('get', KEYS[1]) if v == ARGV[1] or v == ARGV[2] then return redis.call('del', KEYS[1]) else return 0 end\";\n /** Drop a key this holder owns. No-op for another holder's key. */\n export async function releaseSettlementKey(key, holder, { now = Date.now() } = {}) {\n   const hit = localGet(key, now);\n-  if (hit && hit.holder === holder) local.delete(key);\n+  if (hit && owns(hit.holder, holder)) local.delete(key);\n   const c = await getSharedRedisClient();\n   if (!c) return;\n   try {\n     const k = PREFIX + key;\n-    if ((await within(c.get(k))) === holder) await within(c.del(k));\n+    // One compare-and-delete on a real Redis, so a claim that lapsed and was\n+    // taken by another holder between a read and the delete is left to it.\n+    if (typeof c.eval === \"function\") await within(c.eval(DEL_IF_OWNER, { keys: [k], arguments: [String(holder), LEGACY_TAG + holder] }));\n+    else if (owns(await within(c.get(k)), holder)) await within(c.del(k));\n   } catch (e) {\n     console.error(\"[settlement-claims] redis release failed:\", e.message);\n   }\n }\n \n-export const nonceClaimKey = (network, nonce) => `nonce:${String(network)}:${String(nonce).toLowerCase()}`;\n+// An EVM payment's claim names its network, signer and nonce: the chain\n+// consumes a nonce per (token, signer), so two wallets that sign the same\n+// nonce are two payments. An EVM address is lowercased; any other signer is\n+// kept as signed. With no signer it is the earlier build's name.\n+const signerPart = (from) => {\n+  const raw = typeof from === \"string\" ? from.trim() : \"\";\n+  return /^0x[0-9a-fA-F]{40}$/.test(raw) ? raw.toLowerCase() : raw;\n+};\n+export const nonceClaimKey = (network, nonce, from = \"\") => {\n+  const signer = signerPart(from);\n+  return signer ? `nonce:${String(network)}:${signer}:${String(nonce).toLowerCase()}` : legacyNonceClaimKey(network, nonce);\n+};\n+// The name an earlier build claimed an EVM authorization under (network and\n+// nonce only). Read and written during the deploy window and for as long as\n+// its settled claims last (SETTLED_TTL_SECONDS): an untagged claim there is an\n+// earlier build's and is honored; this build's own is tagged (LEGACY_TAG), so\n+// another signer's claim on the same nonce is not.\n+export const legacyNonceClaimKey = (network, nonce) => `nonce:${String(network)}:${String(nonce).toLowerCase()}`;\n // A Stellar address is kept as signed (never case-folded); the nonce is an\n // int64 in decimal.\n export const stellarNonceClaimKey = (network, signer, nonce) => `nonce:${String(network)}:${String(signer)}:${String(nonce)}`;\n@@ -188,9 +223,10 @@ function stamp(req) {\n \n function evmAuthorizationOf(ctx) {\n   const network = String(ctx?.requirements?.network || \"\");\n-  const nonce = ctx?.paymentPayload?.payload?.authorization?.nonce;\n+  const auth = ctx?.paymentPayload?.payload?.authorization;\n+  const nonce = auth?.nonce;\n   if (!network.startsWith(\"eip155:\") || typeof nonce !== \"string\" || !nonce) return null;\n-  return { network, nonce };\n+  return { network, nonce, from: typeof auth?.from === \"string\" ? auth.from : \"\" };\n }\n \n /** The claim keys of a Stellar payment's signed entries, or null. */\n@@ -224,7 +260,7 @@ export function registerSettlementClaimHooks(server) {\n       const s = stamp(reqOf(ctx));\n       if (!s) return;\n       const a = evmAuthorizationOf(ctx);\n-      const keys = a ? [nonceClaimKey(a.network, a.nonce)] : await stellarAuthorizationOf(ctx);\n+      const keys = a ? [nonceClaimKey(a.network, a.nonce, a.from)] : await stellarAuthorizationOf(ctx);\n       if (!keys?.length) return;\n       if (!Array.isArray(s.nonceKeys)) s.nonceKeys = [];\n       // Every key or none: a request refused on one key gives back the\n@@ -235,6 +271,16 @@ export function registerSettlementClaimHooks(server) {\n         if (!s.nonceKey) s.nonceKey = key;\n         if (!s.nonceKeys.includes(key)) s.nonceKeys.push(key);\n       }\n+      // The earlier build's name for the same authorization: its claim there\n+      // (untagged) is honored, and this request's claim is written there\n+      // tagged, so neither build serves the other's payment twice. Another\n+      // signer's tagged claim on the same nonce is a different payment.\n+      const legacy = a && !refuse ? legacyNonceClaimKey(a.network, a.nonce) : null;\n+      if (legacy && legacy !== keys[0]) {\n+        const r = await claimSettlementKey(legacy, LEGACY_TAG + s.id, { ttlSeconds: INFLIGHT_TTL_SECONDS });\n+        if (r.claimed) { if (!s.nonceKeys.includes(legacy)) s.nonceKeys.push(legacy); }\n+        else if (r.holder != null && !String(r.holder).startsWith(LEGACY_TAG)) refuse = true;\n+      }\n       if (refuse) { await releaseHeld(s); s.nonceKey = null; s.nonceKeys = []; }\n     } catch { return; /* never touch a payment */ }\n     if (refuse) {"},{"sha":"e99f82d03cab8dc8e02e2d523ea753740e80ae9b","filename":"src/shared-limit.js","status":"modified","additions":4,"deletions":0,"changes":4,"blob_url":"https://github.com/MikeyPetrillo/Agent402/blob/81a674d1a3cf7fdbbcc04f4da366c144ccd393f7/src%2Fshared-limit.js","raw_url":"https://github.com/MikeyPetrillo/Agent402/raw/81a674d1a3cf7fdbbcc04f4da366c144ccd393f7/src%2Fshared-limit.js","contents_url":"https://api.github.com/repos/MikeyPetrillo/Agent402/contents/src%2Fshared-limit.js?ref=81a674d1a3cf7fdbbcc04f4da366c144ccd393f7","patch":"@@ -195,6 +195,10 @@ let state = { connected: null, lastError: null, degradedCalls: 0 };\n  *  child) that touched a shared limit can exit. The server never calls it.\n  *  A later read connects again. */\n export async function closeSharedRedis() {\n+  // A connect its caller stopped waiting for (CONNECT_WAIT_MS) keeps running\n+  // and lands in `client` later; wait for it, so its socket is closed here\n+  // instead of holding the process open after close.\n+  if (connecting) { try { await connecting; } catch { /* closed below */ } }\n   const c = client;\n   client = null;\n   if (!c) return;"},{"sha":"b98e1f111affe444edfea115dbd4309802a9295a","filename":"src/skills.js","status":"modified","additions":21,"deletions":21,"changes":42,"blob_url":"https://github.com/MikeyPetrillo/Agent402/blob/81a674d1a3cf7fdbbcc04f4da366c144ccd393f7/src%2Fskills.js","raw_url":"https://github.com/MikeyPetrillo/Agent402/raw/81a674d1a3cf7fdbbcc04f4da366c144ccd393f7/src%2Fskills.js","contents_url":"https://api.github.com/repos/MikeyPetrillo/Agent402/contents/src%2Fskills.js?ref=81a674d1a3cf7fdbbcc04f4da366c144ccd393f7","patch":"@@ -213,7 +213,7 @@ export const SKILL_PACKS = [\n     slug: \"security-audit\",\n     title: \"Security audit\",\n     tagline:\n-      \"Enumerate a domain's external attack surface in one workflow: certs, DNS posture, email auth, HTTP security headers, and tech stack.\",\n+      \"Security audit skill: one call runs the external checks in sequence and returns each step's own result: certificate transparency log, DNS records, SPF, DMARC, HTTP security headers, TLS certificate and tech stack. Per-step findings with no grade or written report.\",\n     useCase:\n       \"Before a pentest, an acquisition diligence call, or a quarterly review - you want a fast read on what an attacker sees from the outside.\",\n     promptArgs: [\n@@ -243,7 +243,7 @@ export const SKILL_PACKS = [\n     slug: \"email-deliverability\",\n     title: \"Email deliverability\",\n     tagline:\n-      \"Diagnose why a domain's email lands in spam: SPF posture, DMARC policy, DKIM key strength, MX targets, and a composite 0–100 score.\",\n+      \"Email deliverability skill: one chained call runs every mail check as its own step and returns each step's output, so a failing piece is visible on its own: SPF, DMARC, DKIM key strength, the combined 0-100 score, a postmaster address validation and the domain's mail servers.\",\n     useCase:\n       \"Marketing or transactional email is landing in spam, or you're rolling out a new sending domain and want to verify the auth posture before the first campaign.\",\n     promptArgs: [\n@@ -426,7 +426,7 @@ export const SKILL_PACKS = [\n     ],\n     workflow: [\n       \"Resolve A/AAAA/MX/TXT/NS/CAA records on the apex with dns-lookup to baseline what the authoritative answer should be.\",\n-      \"Run dns-propagation across Cloudflare/Google/Quad9/OpenDNS in parallel - divergent answers mean a stale cache somewhere or a botched TTL during a migration.\",\n+      \"Run dns-propagation, which asks Cloudflare, Google, Quad9 and OpenDNS for the same record - divergent answers mean a stale cache somewhere or a botched TTL during a migration.\",\n       \"Look up the ASN and prefix that the apex resolves into with asn-info (a public DNS-based IP-to-ASN lookup - no auth needed). Useful for spotting an unexpected hosting move.\",\n       \"Pull whois for ownership, expiry, and registrar - catches the 'we forgot to renew' class of outage.\",\n       \"Run http-check for status code, response time, and final URL after redirects - the fastest 'is it actually up' read.\",\n@@ -884,7 +884,7 @@ export const SKILL_PACKS = [\n     slug: \"location-intel\",\n     title: \"Location intel\",\n     tagline:\n-      \"Point at an address (or even a rough place name) and assemble the situational brief: precise coordinates, the canonical postal address, what's within walking distance, the live weather forecast, active NWS hazard alerts, and recent seismic activity. The deterministic 'what should I know about this place right now?' workup.\",\n+      \"Location intel skill: one call turns an address or place name into a situational brief: coordinates, the postal address, restaurants in the area, the weather forecast, active hazard alerts, and the past week's magnitude 2.5 and larger earthquakes worldwide.\",\n     useCase:\n       \"A field-ops agent (sales rep about to visit a customer, contractor scoping a job site, traveler arriving in a new city, emergency-response coordinator) hands the pack an address and needs the full pre-arrival brief in one workup. Geocode pins the spot, reverse-geocode confirms the canonical postal form (catches stale addresses where the building number changed), place-search surfaces nearby POIs (gas, coffee, hospital, supplies), weather-forecast covers the next 24-48h conditions, weather-alerts surfaces any active NWS warning (red flag / flood / heat / tornado), and earthquakes filters recent seismic activity in the region. US-centric for hazards/forecast; geocoding works globally.\",\n     promptArgs: [\n@@ -1063,7 +1063,7 @@ export const SKILL_PACKS = [\n     slug: \"regulatory-watch\",\n     title: \"SEC regulatory monitoring\",\n     tagline:\n-      \"The 'who just filed / who just bought / what just IPO'd / what does the full-text search say' monitoring loop. Five EDGAR tools composed: full-text search for a keyword, surface recent filings on the matched companies, pull insider Form 4 transactions, pull 13F institutional holdings changes, and check the IPO calendar. Different from sec-filings-deep-dive (which goes deep on one company's earnings) - this is the wide-and-recent radar.\",\n+      \"Regulatory watch skill: one call searches recent SEC filings for a theme, then pulls the top match's filings and insider trades, a reference institutional holdings report and recent S-1 IPO registrations. A wide, recent radar across companies; sec-filings-deep-dive goes deep on one.\",\n     useCase:\n       \"Most EDGAR workflows fall into two modes: 'tell me everything about company X' (covered by sec-filings-deep-dive) or 'what just happened across the universe that I care about?' (this pack). The monitoring mode powers competitor watch, M&A signal scanning, insider-buying screens, and 'is the IPO window open' market-timing checks. The full-text search seeds the watch list; insider trades + 13F changes are the canonical informed-money signals; the IPO calendar is the supply-side gauge. All five tools are egress to SEC EDGAR (free upstream, but counted as paid for the deterministic-tool wrapper).\",\n     toolSlugs: [\n@@ -1102,7 +1102,7 @@ export const SKILL_PACKS = [\n     slug: \"search-and-cite\",\n     title: \"Answer-a-question with sources\",\n     tagline:\n-      \"The 'research a question, return an answer with citations' workflow. answer for the AI-synthesized take with citations, search for the canonical SERP, search-news for time-sensitive context, then a deterministic web-fetch + extract pass on the top citations to verify the answer hasn't hallucinated. Five tools, one cited paragraph, every claim traced back to a fetched URL.\",\n+      \"Search and cite skill: one call returns a cited answer to a question (the answer step is model-backed) beside web and news results for it, then fetches the top citation and extracts its entities, so each claim can be traced to a fetched page.\",\n     useCase:\n       \"Most agent research workflows have the same failure mode: an LLM answer with confident-sounding citations that don't actually contain the claim. This pack solves that by separating the *answer-generating* surface (the answer tool) from the *evidence-fetching* surface (web-fetch + extract on the citations). The agent's final response cites only claims that survive both the search-answer hit AND a deterministic re-fetch of the cited page. Pairs with macro-context for time-sensitive 'is this still current' questions.\",\n     toolSlugs: [\n@@ -1171,7 +1171,7 @@ export const SKILL_PACKS = [\n     slug: \"schema-evolution\",\n     title: \"API contract drift check\",\n     tagline:\n-      \"The 'did this API contract change in a way that breaks our integration?' workflow. Diff two OpenAPI snapshots structurally, lint the new one for agent-readiness regressions, extract the endpoint surface for inventory comparison, validate a known-good payload against the new contract, and summarize security-relevant changes. Six tools, one go/no-go answer on whether the upstream API broke us.\",\n+      \"Schema evolution check skill: one call compares two OpenAPI snapshots and returns the structural diff, the new spec's lint score, its endpoint list, the first endpoint's required params, an empty request body checked against that endpoint, and a security summary, so an agent can judge whether the change breaks an integration.\",\n     useCase:\n       \"Every integration eventually hits the 'upstream changed something and now our requests 422' incident. The fix-time is dominated by figuring out *what* changed: was it a renamed field, a tightened enum, a new required parameter, a moved endpoint, a security scheme change? This pack runs that diagnosis deterministically the moment a new OpenAPI snapshot lands - before traffic breaks. Pairs with api-investigation when you don't yet have an OpenAPI snapshot (that pack discovers one); this pack assumes you have two snapshots (yesterday's and today's) and want to know what changed and whether it matters.\",\n     toolSlugs: [\n@@ -1529,7 +1529,7 @@ export const SKILL_PACKS = [\n     slug: \"company-dossier\",\n     title: \"Company dossier\",\n     tagline:\n-      \"Comprehensive company research report in one call: latest close, financials, SEC filings, insider trades, and recent news - all in parallel.\",\n+      \"Raw company data in one parallel call: latest close, financials, recent SEC filings, insider trades over the past 90 days and past-month web results on its news, each as its own tool's answer with no written report.\",\n     useCase:\n       \"Building an investment thesis, preparing for a board presentation, or doing acquisition diligence - you want the full public picture of a company without leaving the agent loop.\",\n     promptArgs: [\n@@ -1687,7 +1687,7 @@ export const SKILL_PACKS = [\n     slug: \"yield-dashboard\",\n     title: \"Yield dashboard\",\n     tagline:\n-      \"Current yield curve snapshot: full Treasury curve, key spreads, and average rates in one call.\",\n+      \"Yield dashboard skill: one parallel call returns the latest Treasury yields at every maturity, the gaps between key maturities with the inversion flag, and the average interest the Treasury pays by security type.\",\n     useCase:\n       \"Quick fixed-income read - is the curve inverted, what are spreads doing, and where are average rates.\",\n     promptArgs: [],\n@@ -1709,7 +1709,7 @@ export const SKILL_PACKS = [\n     slug: \"inflation-check\",\n     title: \"Inflation check\",\n     tagline:\n-      \"Is the economy in recession territory? CPI, fed funds, unemployment, and Sahm rule in one call.\",\n+      \"Inflation check skill: one parallel call reads the headline consumer price index change over twelve months, the effective fed funds level, the jobless figure and a recession signal, so price pressure and the labor market are read together.\",\n     useCase:\n       \"Quick macro health check - the four numbers that answer 'are we in a recession?'\",\n     promptArgs: [],\n@@ -1803,7 +1803,7 @@ export const SKILL_PACKS = [\n     slug: \"wallet-audit\",\n     title: \"Wallet audit\",\n     tagline:\n-      \"Full wallet activity review: balance, recent transactions, and token metadata for a given address.\",\n+      \"Full wallet activity review: balance, recent transactions, and metadata for a token the wallet holds.\",\n     useCase:\n       \"Investigating wallet activity - what's the balance, what has it been doing, and what tokens are involved.\",\n     promptArgs: [\n@@ -1817,7 +1817,7 @@ export const SKILL_PACKS = [\n     workflow: [\n       \"Get the native + token balances for the address.\",\n       \"Pull recent transactions to see activity patterns.\",\n-      \"Look up token metadata for contracts the wallet interacts with.\",\n+      \"Look up metadata for the first token the wallet holds (a wallet holding no tokens gets a 422 on this step).\",\n     ],\n     claudePrompt:\n       \"Audit the wallet 0xd8dA6BF26964aF9D7eEd9e03E53415D37aA96045 using Agent402's wallet-audit skill pack. Get (1) balance, (2) recent transactions, (3) token metadata. Summarize activity and flag anything unusual.\",\n@@ -1850,7 +1850,7 @@ export const SKILL_PACKS = [\n     slug: \"ssl-audit\",\n     title: \"SSL audit\",\n     tagline:\n-      \"TLS/SSL security posture check: live certificate inspection, HTTP security headers, and CAA DNS records.\",\n+      \"SSL audit skill: one parallel call returns the site's SSL details (issuer, expiry, names), its HTTP security headers and the CAA DNS records that say who may issue for it.\",\n     useCase:\n       \"Verifying a domain's TLS posture - cert validity, security headers, and who's authorized to issue certs.\",\n     promptArgs: [\n@@ -1874,7 +1874,7 @@ export const SKILL_PACKS = [\n     slug: \"email-security\",\n     title: \"Email security\",\n     tagline:\n-      \"Full email auth posture: SPF, DMARC, DKIM, and composite deliverability score in one call.\",\n+      \"Email security skill: one parallel call returns SPF, DMARC and a DKIM check at selector \\\"google\\\", each as its own result, beside the combined mail score, to judge whether the domain can be spoofed.\",\n     useCase:\n       \"Diagnosing email authentication - can this domain be spoofed, and is its mail configuration complete.\",\n     promptArgs: [\n@@ -2093,7 +2093,7 @@ export const SKILL_PACKS = [\n     slug: \"world-data\",\n     title: \"World Bank country data\",\n     tagline:\n-      \"GDP and population for a country - two key World Bank indicators in one call.\",\n+      \"World data skill: one parallel call returns a nation's gross domestic product in current US dollars and its total population side by side, year by year, from World Bank open data.\",\n     useCase:\n       \"An agent needs basic economic context for a country: what's the GDP and how many people live there? These are the two most-requested World Bank indicators and together they give GDP per capita as a derived metric.\",\n     promptArgs: [\n@@ -2113,7 +2113,7 @@ export const SKILL_PACKS = [\n     slug: \"fred-snapshot\",\n     title: \"Fed economic snapshot\",\n     tagline:\n-      \"Key Federal Reserve economic indicators - fed funds rate, unemployment, and CPI - in one call.\",\n+      \"Economic snapshot skill: one parallel call returns the fed funds rate, the unemployment rate and the consumer price index series together.\",\n     useCase:\n       \"An agent providing economic context needs the three most-watched Fed indicators: where rates are (FEDFUNDS), how tight the labor market is (UNRATE), and where inflation stands (CPIAUCSL). Three FRED series calls bundled into one payment.\",\n     promptArgs: [],\n@@ -2228,7 +2228,7 @@ export const SKILL_PACKS = [\n     slug: \"entity-enrich\",\n     title: \"Entity enrichment\",\n     tagline:\n-      \"Company name → verified identity + web footprint dossier: Wikidata facts, the official LEI legal-entity record, the SEC EDGAR filer, domain registration, tech stack, and brand favicon - in one pass.\",\n+      \"Enrich a company name in one parallel call: public knowledge-base facts, the LEI legal-entity record, the SEC filer record, and, when a domain is given, its registration, tech stack and favicon, each as its own step's result.\",\n     useCase:\n       \"KYB, lead enrichment, or counterparty checks - an agent has a company name (maybe a domain and ticker) and needs to establish that the entity is real, who it legally is, and what its web presence looks like.\",\n     promptArgs: [\n@@ -2274,7 +2274,7 @@ export const SKILL_PACKS = [\n     slug: \"subtitle-pipeline\",\n     title: \"Subtitle pipeline\",\n     tagline:\n-      \"Audio URL → finished subtitles in one call: transcribe the audio, emit the transcript as SRT/WebVTT/JSON cues, and report the text statistics - length, reading time, word count.\",\n+      \"Audio URL → finished subtitles in one call: transcribe the audio (model-backed), emit the transcript as SRT/WebVTT/JSON cues, and report the text statistics - length, reading time, word count.\",\n     useCase:\n       \"An agent processing podcasts, voice notes, or video audio needs shippable subtitle files plus the stats to budget downstream steps (summarization, translation, chapters) - without stitching three tools by hand.\",\n     promptArgs: [\n@@ -2340,7 +2340,7 @@ export const SKILL_PACKS = [\n     slug: \"text-analyze\",\n     title: \"Text analysis\",\n     tagline:\n-      \"Full text analysis - word/sentence stats, keyword extraction, and token count in one pass.\",\n+      \"Text analyze skill: one parallel call returns word and sentence stats, top keyword phrases and a token count for the same text.\",\n     useCase:\n       \"An agent evaluating text content needs the complete picture: how long is it (words, sentences, paragraphs), what are the key topics (keyword extraction), and how many LLM tokens would it consume? Useful for content pipelines, RAG prep, and prompt budgeting.\",\n     promptArgs: [\n@@ -2399,7 +2399,7 @@ export const SKILL_PACKS = [\n     slug: \"json-pipeline\",\n     title: \"JSON pipeline\",\n     tagline:\n-      \"Validate, pretty-print, and convert JSON to CSV in one pass - the complete JSON processing workflow.\",\n+      \"JSON pipeline skill: one parallel call validates a JSON document, pretty-prints it at 2-space indent and converts it to CSV, returning each result.\",\n     useCase:\n       \"An agent receives raw JSON (from an API response, a webhook body, or user input) and needs to validate it's well-formed, format it for readability, and convert it to CSV for a spreadsheet or data pipeline. Three tools in one payment.\",\n     promptArgs: [\n@@ -2541,7 +2541,7 @@ export const SKILL_PACKS = [\n     slug: \"webhook-intake\",\n     title: \"Webhook secure intake\",\n     tagline:\n-      \"The production ingest path for every incoming webhook: verify the provider signature (GitHub / Stripe / Shopify / Slack, constant-time, replay-window enforced), schema-validate the now-trusted body against the provider envelope, fingerprint the raw bytes for redelivery dedup, normalize the event timestamp to UTC + epoch, and redact PII before anything hits a log. Five pure-CPU tools - the accept-or-reject gate, run on every event.\",\n+      \"Webhook intake skill: one chained call runs the accept-or-reject gate for an incoming event: provider signature check, schema check of the body, a raw-bytes fingerprint for redelivery dedup, the event time normalized to UTC and epoch, and PII redaction before logging. Pure CPU.\",\n     useCase:\n       \"This pack is the gate an agent executes on EVERY incoming webhook in production. Step 1 is the security decision (reject on an invalid signature; Stripe and Slack timestamps get replay-window enforcement), and only then is the body treated as trusted: an envelope schema check catches provider API-version drift before it breaks your handler three layers down, a sha256 content fingerprint gives you the dedup key for provider redeliveries (or an Idempotency-Key for downstream calls), the event time is normalized to UTC ISO + epoch for storage, and PII is redacted so the audit log stays clean. One deterministic pass from raw bytes to a storable, loggable, deduplicated event.\",\n     toolSlugs: ["},{"sha":"68de311320f226f6666c4e5eec2532bf946cec68","filename":"src/solana-buyer.js","status":"modified","additions":4,"deletions":0,"changes":4,"blob_url":"https://github.com/MikeyPetrillo/Agent402/blob/81a674d1a3cf7fdbbcc04f4da366c144ccd393f7/src%2Fsolana-buyer.js","raw_url":"https://github.com/MikeyPetrillo/Agent402/raw/81a674d1a3cf7fdbbcc04f4da366c144ccd393f7/src%2Fsolana-buyer.js","contents_url":"https://api.github.com/repos/MikeyPetrillo/Agent402/contents/src%2Fsolana-buyer.js?ref=81a674d1a3cf7fdbbcc04f4da366c144ccd393f7","patch":"@@ -279,6 +279,10 @@ export async function createSvmPaymentPayload(signer, paymentRequirements) {\n   if (String(req.asset) !== USDC_MINT) throw bad(\"SVM payload builder only signs USDC on Solana mainnet\", 502);\n   const feePayer = req.extra?.feePayer;\n   if (!feePayer) throw bad(\"feePayer is required in the accept's extra for SVM\", 502);\n+  // The fee payer is the facilitator's account. An accept naming our own\n+  // signing wallet would make our signature pay the network fee too, so it is\n+  // refused before anything is signed (base58: compared exactly, never folded).\n+  if (String(feePayer) === String(signer?.address || \"\")) throw Object.assign(bad(\"Seller's Solana accept names our own wallet as the fee payer; refusing to sign. Nothing was signed.\", 502), { refused: true });\n   // Blockhash: prefer the one the facilitator's 402 already carries (a seller\n   // does - then signing needs ZERO RPC, the whole point of this builder). When a\n   // seller's accept omits it (most sellers do), fetch it"},{"sha":"cfdc6ca10918dd7e786eb9ca62942b15a74f818d","filename":"src/stripe-subscriptions.js","status":"modified","additions":157,"deletions":78,"changes":235,"blob_url":"https://github.com/MikeyPetrillo/Agent402/blob/81a674d1a3cf7fdbbcc04f4da366c144ccd393f7/src%2Fstripe-subscriptions.js","raw_url":"https://github.com/MikeyPetrillo/Agent402/raw/81a674d1a3cf7fdbbcc04f4da366c144ccd393f7/src%2Fstripe-subscriptions.js","contents_url":"https://api.github.com/repos/MikeyPetrillo/Agent402/contents/src%2Fstripe-subscriptions.js?ref=81a674d1a3cf7fdbbcc04f4da366c144ccd393f7","patch":"@@ -15,7 +15,7 @@\n // Rollout switch = STRIPE_SECRET_KEY (same key as the one-shot checkout).\n import { existsSync } from \"node:fs\";\n import { join } from \"node:path\";\n-import { createJsonDocument } from \"./json-document.js\";\n+import { createJsonDocument, SKIP_UPDATE } from \"./json-document.js\";\n import { trackStoreReady, stateDbSchema, stateQuery } from \"./state-db.js\";\n import { createDeadLetter, everyMs } from \"./ledger-mirror.js\";\n import { rugcheckEnabled } from \"./rugcheck-switch.js\";\n@@ -107,20 +107,35 @@ const webhookSecret = () => (process.env.STRIPE_WEBHOOK_SECRET || \"\").trim();\n const STORE_PATH = () => join(existsSync(\"/data\") ? \"/data\" : \"/tmp\", \"stripe-subscriptions.json\");\n const MAX_STORE = 20000;\n \n-const toMap = (j) => (j && typeof j === \"object\" && !Array.isArray(j) ? new Map(Object.entries(j)) : new Map());\n-// Merge-on-save: only OUR changed keys are written into the stored object, so\n-// a second process's records are never dropped by a whole-map overwrite. On\n-// the file this is tmp + rename; in the state database it is a key merge.\n-async function saveKeys(doc, map, keys) {\n-  const patch = {};\n-  for (const k of keys) if (map.has(k)) patch[k] = map.get(k);\n-  const merged = await doc.mergeKeys(patch);\n-  if (merged && Object.keys(merged).length > MAX_STORE) {\n-    const drop = Object.keys(merged).slice(0, Object.keys(merged).length - MAX_STORE);\n-    await doc.mergeKeys({}, drop);\n-  }\n-  return merged !== null;\n+// Every record carries its own id: the map key is the id, and a record\n+// loaded without one (written before every upsert set it) takes it from\n+// its key in memory. A record that already has it is returned as it is.\n+const isRec = (v) => !!v && typeof v === \"object\" && !Array.isArray(v);\n+const withId = (k, v) => (isRec(v) && v.subId !== k ? { ...v, subId: k } : v);\n+const toMap = (j) => (isRec(j) ? new Map(Object.entries(j).map(([k, v]) => [k, withId(k, v)])) : new Map());\n+// The ids a subscription has been paid with (newest last), kept so a\n+// dispute on an earlier month's charge still finds its subscription.\n+const MAX_PAID_IDS = 24;\n+const pushId = (list, id) => (id ? [...(Array.isArray(list) ? list : []).filter((x) => x !== id), id].slice(-MAX_PAID_IDS) : (Array.isArray(list) ? list : []));\n+const idOf = (v) => (typeof v === \"string\" ? v : v?.id || null);\n+// Whether a record was paid with this charge, payment or invoice.\n+function paidWith(rec, { pi, charge, invoiceId }) {\n+  if (!isRec(rec)) return false;\n+  return Boolean((pi && (rec.lastPaymentIntent === pi || rec.paidPaymentIntents?.includes(pi)))\n+    || (charge && (rec.lastCharge === charge || rec.paidCharges?.includes(charge)))\n+    || (invoiceId && (rec.lastInvoiceId === invoiceId || rec.paidInvoiceIds?.includes(invoiceId))));\n }\n+// Stripe delivers status events in no fixed order. A status event older than\n+// the status on the record (its event time, or a live read's time) is not\n+// applied, so a late update never reactivates a canceled subscription.\n+const statusStale = (cur, evAt) => isRec(cur) && Number.isFinite(evAt) && Number(cur.statusEventAt) > evAt;\n+const nowSec = () => Math.floor(Date.now() / 1000);\n+// A live read is stamped this many seconds before our clock: a webhook's\n+// `created` is Stripe's clock, so an event just before or after the read can\n+// carry an earlier time than ours. Stamping early lets such an event (a\n+// cancellation) apply; the next pre-run read corrects any older one.\n+export const LIVE_READ_SKEW_S = 60;\n+const liveReadAt = () => nowSec() - LIVE_READ_SKEW_S;\n // The newer of two records of one subscription (by updatedAt; ISO strings compare as strings).\n const newer = (a, b) => (!a ? b : !b ? a : String(b.updatedAt || \"\") > String(a.updatedAt || \"\") ? b : a);\n \n@@ -240,22 +255,47 @@ export function createStripeSubscriptions({ stripe, baseUrl, storePath, validate\n   // Resolves false only in database mode when the record did not reach the\n   // database (it waits in the local journal); the webhook then answers 503\n   // so Stripe delivers the event again.\n+  //\n+  // `patch` is the fields this change sets, or a function of the STORED\n+  // record (null when there is none) that returns them, or null to change\n+  // nothing. The fields are merged onto the stored record inside a versioned\n+  // read-modify-write of the document (on a conflict the row is read again\n+  // and the function runs again), so a change another container made since\n+  // this one read the record (a dispute, a cancellation) is never written\n+  // over with this container's older copy. Every write carries the id.\n   async function upsert(subId, patch) {\n     if (!subId) return true;\n-    if (PG && !store.has(subId)) {\n-      // A subscription another container recorded since this one loaded:\n-      // its stored record is the base, so a partial patch (a webhook's\n-      // status) never replaces the whole record.\n-      try { const r = await doc.read(); const v = r.ok && r.exists ? r.body?.[subId] : null; if (v && !store.has(subId)) store.set(subId, v); } catch { /* the patch alone */ }\n+    const at = new Date().toISOString();\n+    const fieldsFor = (cur) => (typeof patch === \"function\" ? patch(isRec(cur) ? cur : null) : patch);\n+    let r;\n+    try {\n+      r = await doc.update((b) => {\n+        const body = isRec(b) ? b : {};\n+        const cur = isRec(body[subId]) ? body[subId] : null;\n+        const fields = fieldsFor(cur);\n+        if (!fields) return SKIP_UPDATE;\n+        body[subId] = { ...(cur || {}), ...fields, subId, updatedAt: at };\n+        const keys = Object.keys(body);\n+        if (keys.length > MAX_STORE) for (const k of keys.slice(0, keys.length - MAX_STORE)) if (k !== subId) delete body[k];\n+        return body;\n+      }, { fallback: {} });\n+    } catch (e) { r = { ok: false, error: String(e?.message || e) }; }\n+    if (r.ok) {\n+      const stored = isRec(r.body) ? r.body[subId] : null;\n+      if (isRec(stored)) store.set(subId, withId(subId, stored));\n+      unsaved.delete(subId);\n+      return true;\n     }\n-    const prev = store.get(subId) || {};\n-    store.set(subId, { ...prev, ...patch, updatedAt: new Date().toISOString() });\n-    if (!PG) { void saveKeys(doc, store, [subId]); return true; }\n-    let landed = false;\n-    try { landed = await saveKeys(doc, store, [subId]); } catch { landed = false; }\n-    if (landed) { unsaved.delete(subId); return true; }\n+    // The document could not be written: the change is applied to this\n+    // container's copy, and in database mode kept in the journal (with the\n+    // fields it set) until it lands.\n+    const fields = fieldsFor(store.get(subId) || null);\n+    if (!fields) return true;\n+    const rec = { ...(store.get(subId) || {}), ...fields, subId, updatedAt: at };\n+    store.set(subId, rec);\n+    if (!PG) { console.error(`[subscriptions] the record of ${subId} could not be written: ${String(r.error || \"\").slice(0, 120)}`); return true; }\n     unsaved.add(subId);\n-    if (!pending.add(\"sub\", { subId, rec: store.get(subId) })) console.error(`[subscriptions] the record of ${subId} could not be kept on local disk`);\n+    if (!pending.add(\"sub\", { subId, rec, fields })) console.error(`[subscriptions] the record of ${subId} could not be kept on local disk`);\n     return false;\n   }\n   // One replay at a time: a call that finds one in flight (the timer tick,\n@@ -268,22 +308,30 @@ export function createStripeSubscriptions({ stripe, baseUrl, storePath, validate\n     replaying = replayPendingNow().finally(() => { replaying = null; });\n     return replaying;\n   }\n+  // A journaled change lands only over an older copy of its subscription (by\n+  // updatedAt), never over a newer one. An entry that names the fields it set\n+  // merges just those onto the stored record; an entry from before that (a\n+  // whole record) replaces the older copy, as it always did.\n   async function replayPendingNow() {\n     let landed = 0;\n     {\n       landed = await pending.drain(async (e) => {\n-        const { subId, rec } = e.payload || {};\n+        const { subId, rec, fields } = e.payload || {};\n         if (!subId || !rec) return \"drop\";\n-        const mine = newer(rec, unsaved.has(subId) ? store.get(subId) : null);\n+        const mine = isRec(fields) ? { ...rec, subId } : newer(rec, unsaved.has(subId) ? store.get(subId) : null);\n         const r = await doc.update((b) => {\n-          const body = b && typeof b === \"object\" && !Array.isArray(b) ? b : {};\n-          body[subId] = newer(body[subId], mine);\n+          const body = isRec(b) ? b : {};\n+          const cur = isRec(body[subId]) ? body[subId] : null;\n+          if (isRec(fields) && cur) {\n+            if (String(cur.updatedAt || \"\") >= String(mine.updatedAt || \"\")) return SKIP_UPDATE;\n+            body[subId] = { ...cur, ...fields, subId, updatedAt: mine.updatedAt };\n+          } else body[subId] = withId(subId, newer(cur, mine));\n           return body;\n         }, { fallback: {} });\n         if (!r.ok) return \"stop\"; // the database is still away: the next tick retries\n-        const stored = r.body?.[subId];\n-        if (stored) store.set(subId, newer(store.get(subId), stored));\n-        if (stored === mine || String(stored?.updatedAt || \"\") >= String(mine.updatedAt || \"\")) unsaved.delete(subId);\n+        const stored = isRec(r.body) ? withId(subId, r.body[subId]) : null;\n+        if (stored) store.set(subId, stored);\n+        if (stored && String(stored.updatedAt || \"\") >= String(mine.updatedAt || \"\")) unsaved.delete(subId);\n         return \"landed\";\n       });\n     }\n@@ -374,22 +422,26 @@ export function createStripeSubscriptions({ stripe, baseUrl, storePath, validate\n     if (session.payment_status !== \"paid\" && session.status !== \"complete\") return { status: \"unpaid\" };\n     const subId = typeof session.subscription === \"string\" ? session.subscription : session.subscription?.id;\n     if (!subId) return { status: \"pending\" };\n-    const existing = store.get(subId) || null;\n-    let status = existing?.status || \"active\";\n+    let live = null, readAt = null;\n     try {\n       const sub = await stripe.subscriptions.retrieve(subId);\n-      if (sub?.status) status = sub.status;\n+      if (sub?.status) { live = sub.status; readAt = liveReadAt(); }\n     } catch { /* keep existing status (or first-time active) */ }\n-    const rec = {\n-      subId, customer: session.customer, status,\n-      product: existing?.product || session.metadata?.product || null,\n-      target: existing?.target || session.metadata?.target || null,\n-      email: session.customer_details?.email || session.customer_email || existing?.email || null,\n-      createdAt: existing?.createdAt || new Date().toISOString(),\n-    };\n-    await upsert(subId, rec);\n+    // Built from the stored record inside the write: the live status when it\n+    // was read, else the stored one, else (first provisioning) active.\n+    await upsert(subId, (cur) => ({\n+      customer: session.customer || cur?.customer || null,\n+      status: live || cur?.status || \"active\",\n+      ...(live ? { statusEventAt: Math.max(Number(cur?.statusEventAt) || 0, readAt) } : {}),\n+      product: cur?.product || session.metadata?.product || null,\n+      target: cur?.target || session.metadata?.target || null,\n+      email: session.customer_details?.email || session.customer_email || cur?.email || null,\n+      createdAt: cur?.createdAt || new Date().toISOString(),\n+    }));\n+    const rec = store.get(subId) || {};\n+    const status = rec.status || live || \"active\";\n     const p = MONITOR_PRODUCTS_ALL[rec.product];\n-    return { status, subId, customer: rec.customer, product: rec.product, label: p?.label || \"monitor\", target: rec.target };\n+    return { status, subId, customer: rec.customer ?? session.customer, product: rec.product ?? null, label: p?.label || \"monitor\", target: rec.target ?? null };\n   }\n \n   // Signature-verified webhook. Never trusts an unverified body: without the\n@@ -423,33 +475,45 @@ export function createStripeSubscriptions({ stripe, baseUrl, storePath, validate\n         // fulfilled (credits: key minted + emailed) - claim is idempotent.\n         if (s.mode === \"payment\" && typeof onPaymentSession === \"function\") { try { await onPaymentSession(s); } catch { /* never fail the webhook on a hook */ } }\n         if (s.mode === \"subscription\" && s.subscription) {\n-          const id = typeof s.subscription === \"string\" ? s.subscription : s.subscription.id;\n+          const id = idOf(s.subscription);\n           // Stripe retries and reorders events: a completed-checkout event must\n           // never overwrite a status the subscription lifecycle already set.\n-          const prev = store.get(id);\n-          stored = stored && await upsert(id, {\n-            customer: s.customer, status: prev?.status || \"active\",\n-            product: s.metadata?.product || prev?.product || null, target: s.metadata?.target || prev?.target || null,\n-            email: s.customer_details?.email || s.customer_email || prev?.email || null,\n-          });\n+          stored = stored && await upsert(id, (cur) => ({\n+            customer: s.customer || cur?.customer || null, status: cur?.status || \"active\",\n+            product: s.metadata?.product || cur?.product || null, target: s.metadata?.target || cur?.target || null,\n+            email: s.customer_details?.email || s.customer_email || cur?.email || null,\n+            createdAt: cur?.createdAt || new Date().toISOString(),\n+          }));\n         }\n         break;\n       }\n       case \"customer.subscription.created\":\n       case \"customer.subscription.updated\": {\n         const sub = event.data.object;\n-        stored = stored && await upsert(sub.id, {\n-          customer: sub.customer, status: sub.status,\n-          product: sub.metadata?.product || store.get(sub.id)?.product || null,\n-          target: sub.metadata?.target || store.get(sub.id)?.target || null,\n-          currentPeriodEnd: periodEndOf(sub),\n-          cancelAtPeriodEnd: !!sub.cancel_at_period_end,\n+        const evAt = Number(event.created);\n+        stored = stored && await upsert(sub.id, (cur) => {\n+          const ids = {\n+            customer: sub.customer || cur?.customer || null,\n+            product: sub.metadata?.product || cur?.product || null,\n+            target: sub.metadata?.target || cur?.target || null,\n+          };\n+          // An event older than the status on the record fills only what\n+          // the record lacks.\n+          if (statusStale(cur, evAt)) return ids;\n+          return {\n+            ...ids, status: sub.status, currentPeriodEnd: periodEndOf(sub), cancelAtPeriodEnd: !!sub.cancel_at_period_end,\n+            ...(Number.isFinite(evAt) ? { statusEventAt: Math.max(Number(cur?.statusEventAt) || 0, evAt) } : {}),\n+          };\n         });\n         break;\n       }\n       case \"customer.subscription.deleted\": {\n         const sub = event.data.object;\n-        stored = stored && await upsert(sub.id, { status: \"canceled\" });\n+        const evAt = Number(event.created);\n+        stored = stored && await upsert(sub.id, (cur) => ({\n+          status: \"canceled\",\n+          ...(Number.isFinite(evAt) ? { statusEventAt: Math.max(Number(cur?.statusEventAt) || 0, evAt) } : {}),\n+        }));\n         break;\n       }\n       case \"invoice.paid\": {\n@@ -458,20 +522,33 @@ export function createStripeSubscriptions({ stripe, baseUrl, storePath, validate\n         // subscriptions, not only x402 settlements. Booked once per invoice\n         // id, across containers and restarts (claimInvoiceSale).\n         const inv = event.data.object;\n-        const subId = typeof inv.subscription === \"string\" ? inv.subscription : inv.subscription?.id || inv.parent?.subscription_details?.subscription || null;\n-        const rec = subId ? store.get(subId) : null;\n-        const seenOnRecord = !!inv.id && rec?.lastInvoiceId === inv.id;\n+        const subId = idOf(inv.subscription) || inv.parent?.subscription_details?.subscription || null;\n+        const pi = invoicePaymentIntentOf(inv);\n+        const charge = idOf(inv.charge);\n+        // Whether the stored record already booked this invoice (the file's\n+        // sale mark), read inside the write from the stored record.\n+        let seenOnRecord = false;\n         // The record first: an event answered 503 (its record not stored) is\n         // delivered again, so the sale is booked on the delivery that stores\n-        // it, never once per delivery.\n-        if (subId && rec) stored = stored && await upsert(subId, { lastInvoiceId: inv.id, lastPaymentIntent: invoicePaymentIntentOf(inv) || rec.lastPaymentIntent || null, lastPaidAt: new Date().toISOString() });\n+        // it, never once per delivery. Every payment's ids are kept, so a\n+        // dispute on any of them finds this subscription.\n+        if (subId) {\n+          stored = stored && await upsert(subId, (cur) => {\n+            seenOnRecord = !!inv.id && cur?.lastInvoiceId === inv.id;\n+            return {\n+              lastInvoiceId: inv.id, lastPaymentIntent: pi || cur?.lastPaymentIntent || null, lastPaidAt: new Date().toISOString(),\n+              paidInvoiceIds: pushId(cur?.paidInvoiceIds, inv.id), paidPaymentIntents: pushId(cur?.paidPaymentIntents, pi),\n+              ...(charge ? { lastCharge: charge, paidCharges: pushId(cur?.paidCharges, charge) } : {}),\n+            };\n+          });\n+        }\n         if (stored && typeof onInvoicePaid === \"function\" && inv.amount_paid > 0) {\n           let first;\n           try { first = await claimInvoiceSale(inv.id, seenOnRecord); } catch { first = null; }\n           // The claim could not be read: not acknowledged, so Stripe delivers\n           // the event again and the claim decides then.\n           if (first === null) { stored = false; break; }\n-          if (first) { try { onInvoicePaid({ invoiceId: inv.id, subId, product: rec?.product || null, amountUsd: inv.amount_paid / 100, customer: inv.customer }); } catch { /* accounting never breaks the webhook */ } }\n+          if (first) { try { onInvoicePaid({ invoiceId: inv.id, subId, product: (subId && store.get(subId)?.product) || null, amountUsd: inv.amount_paid / 100, customer: inv.customer }); } catch { /* accounting never breaks the webhook */ } }\n         }\n         break;\n       }\n@@ -480,18 +557,20 @@ export function createStripeSubscriptions({ stripe, baseUrl, storePath, validate\n         // Money went back (or is contested): let the credits store claw back\n         // (a charge says how much of it was refunded, and whether all of it).\n         const obj = event.data.object;\n-        const pi = typeof obj?.payment_intent === \"string\" ? obj.payment_intent : obj?.payment_intent?.id || null;\n+        const pi = idOf(obj?.payment_intent);\n         const reversal = event.type === \"charge.refunded\"\n           ? { amountRefundedCents: Number.isFinite(Number(obj?.amount_refunded)) ? Number(obj.amount_refunded) : null, fullyRefunded: obj?.refunded === true }\n           : { amountRefundedCents: null, fullyRefunded: true };\n         if (pi && typeof onChargeReversed === \"function\") { try { await onChargeReversed(pi, event.type, reversal); } catch { /* never fail the webhook on a hook */ } }\n         // A disputed subscription payment stops its fulfillment: the record\n         // is marked (its status still follows Stripe) and listActive drops it.\n+        // Any month's payment matches (its payment, charge or invoice id).\n         if (event.type === \"charge.dispute.created\") {\n-          const invoiceId = typeof obj?.invoice === \"string\" ? obj.invoice : obj?.invoice?.id || null;\n-          for (const [subId, rec] of store) {\n-            if (rec?.disputed) continue;\n-            if ((pi && rec?.lastPaymentIntent === pi) || (invoiceId && rec?.lastInvoiceId === invoiceId)) stored = stored && await upsert(subId, { disputed: true, disputedAt: new Date().toISOString(), disputeOutcome: null });\n+          const ids = { pi, charge: idOf(obj?.charge), invoiceId: idOf(obj?.invoice) };\n+          await reload().catch(() => 0);\n+          for (const [subId, rec] of [...store]) {\n+            if (rec?.disputed || !paidWith(rec, ids)) continue;\n+            stored = stored && await upsert(subId, (cur) => (cur?.disputed || !paidWith(cur, ids) ? null : { disputed: true, disputedAt: new Date().toISOString(), disputeOutcome: null }));\n           }\n         }\n         break;\n@@ -502,16 +581,16 @@ export function createStripeSubscriptions({ stripe, baseUrl, storePath, validate\n         // and the credits key the dispute disabled is enabled again (the\n         // hook). Lost: the record stays disputed and the outcome is noted.\n         const obj = event.data.object;\n-        const pi = typeof obj?.payment_intent === \"string\" ? obj.payment_intent : obj?.payment_intent?.id || null;\n+        const pi = idOf(obj?.payment_intent);\n         const outcome = typeof obj?.status === \"string\" ? obj.status.slice(0, 40) : \"unknown\";\n         const won = outcome === \"won\" || outcome === \"warning_closed\";\n         if (pi && typeof onDisputeClosed === \"function\") { try { await onDisputeClosed(pi, { won, status: outcome }); } catch { /* never fail the webhook on a hook */ } }\n-        const invoiceId = typeof obj?.invoice === \"string\" ? obj.invoice : obj?.invoice?.id || null;\n-        for (const [subId, rec] of store) {\n-          if (!rec?.disputed) continue;\n-          if ((pi && rec?.lastPaymentIntent === pi) || (invoiceId && rec?.lastInvoiceId === invoiceId)) {\n-            stored = stored && await upsert(subId, won ? { disputed: false, disputeOutcome: outcome, disputeClosedAt: new Date().toISOString() } : { disputeOutcome: outcome, disputeClosedAt: new Date().toISOString() });\n-          }\n+        const ids = { pi, charge: idOf(obj?.charge), invoiceId: idOf(obj?.invoice) };\n+        await reload().catch(() => 0);\n+        for (const [subId, rec] of [...store]) {\n+          if (!rec?.disputed || !paidWith(rec, ids)) continue;\n+          stored = stored && await upsert(subId, (cur) => (!cur?.disputed || !paidWith(cur, ids) ? null\n+            : won ? { disputed: false, disputeOutcome: outcome, disputeClosedAt: new Date().toISOString() } : { disputeOutcome: outcome, disputeClosedAt: new Date().toISOString() }));\n         }\n         break;\n       }\n@@ -537,7 +616,7 @@ export function createStripeSubscriptions({ stripe, baseUrl, storePath, validate\n     if (!subId) return null;\n     try {\n       const sub = await stripe.subscriptions.retrieve(subId);\n-      if (sub?.status) { await upsert(subId, { status: sub.status, currentPeriodEnd: periodEndOf(sub), cancelAtPeriodEnd: !!sub.cancel_at_period_end }); return sub.status; }\n+      if (sub?.status) { const at = liveReadAt(); await upsert(subId, (cur) => ({ status: sub.status, currentPeriodEnd: periodEndOf(sub), cancelAtPeriodEnd: !!sub.cancel_at_period_end, statusEventAt: Math.max(Number(cur?.statusEventAt) || 0, at) })); return sub.status; }\n     } catch { /* unreadable */ }\n     return null;\n   }"},{"sha":"301abddf1f88d80207893a300d98a860050f7c42","filename":"src/tempo-buyer.js","status":"modified","additions":47,"deletions":0,"changes":47,"blob_url":"https://github.com/MikeyPetrillo/Agent402/blob/81a674d1a3cf7fdbbcc04f4da366c144ccd393f7/src%2Ftempo-buyer.js","raw_url":"https://github.com/MikeyPetrillo/Agent402/raw/81a674d1a3cf7fdbbcc04f4da366c144ccd393f7/src%2Ftempo-buyer.js","contents_url":"https://api.github.com/repos/MikeyPetrillo/Agent402/contents/src%2Ftempo-buyer.js?ref=81a674d1a3cf7fdbbcc04f4da366c144ccd393f7","patch":"@@ -65,6 +65,45 @@ export function methodDetailsRefusal(req) {\n   return null;\n }\n \n+/**\n+ * Why a minted pull credential does not pay exactly what was checked, or null\n+ * when it does: the credential must be a sender-signed Tempo transaction with\n+ * ONE call, to USDC.e, a `transfer` or `transferWithMemo` of exactly\n+ * `amountAtomic` to `recipient`, carrying no native value. The Tempo\n+ * counterpart of payX402's signed-value assert: whatever built the\n+ * credential, what leaves this process is what the quote, the ceiling and the\n+ * recipient checks were applied to. Exported for tests.\n+ */\n+export async function credentialPaymentRefusal(credential, { amountAtomic, recipient }) {\n+  let tx;\n+  try {\n+    const { Credential } = await import(\"mppx\");\n+    const payload = Credential.deserialize(String(credential)).payload;\n+    if (payload?.type !== \"transaction\" || typeof payload.signature !== \"string\") return \"the credential is not a signed transaction\";\n+    const { TxEnvelopeTempo } = await import(\"ox/tempo\");\n+    tx = TxEnvelopeTempo.deserialize(payload.signature);\n+  } catch { return \"the credential does not decode\"; }\n+  const calls = Array.isArray(tx?.calls) ? tx.calls : [];\n+  if (calls.length !== 1) return `the credential carries ${calls.length} calls, not one transfer`;\n+  const [call] = calls;\n+  if (String(call?.to || \"\").toLowerCase() !== TEMPO_USDC_LC) return \"the credential's transfer is not in USDC.e\";\n+  try { if (call.value !== undefined && call.value !== null && BigInt(call.value) !== 0n) return \"the credential's call carries native value\"; }\n+  catch { return \"the credential's call carries an unreadable value\"; }\n+  let decoded;\n+  try {\n+    const { decodeFunctionData } = await import(\"viem\");\n+    const { Abis } = await import(\"viem/tempo\");\n+    decoded = decodeFunctionData({ abi: Abis.tip20, data: call.data || \"0x\" });\n+  } catch { return \"the credential's call does not decode as a transfer\"; }\n+  if (decoded.functionName !== \"transfer\" && decoded.functionName !== \"transferWithMemo\") return `the credential's call is ${decoded.functionName}, not a transfer`;\n+  const [to, amount] = decoded.args || [];\n+  if (String(to || \"\").toLowerCase() !== String(recipient || \"\").toLowerCase()) return \"the credential pays another recipient than the one checked\";\n+  let want;\n+  try { want = BigInt(amountAtomic); } catch { return \"the capped quote is not an integer\"; }\n+  if (typeof amount !== \"bigint\" || amount !== want) return `the credential moves ${typeof amount === \"bigint\" ? Number(amount) / 1e6 : \"an unreadable amount of\"} USDC, not the capped quote ${Number(want) / 1e6}`;\n+  return null;\n+}\n+\n export function pickTempoChallenge(challenges) {\n   const charges = (Array.isArray(challenges) ? challenges : []).filter((c) => c?.method === \"tempo\" && c?.intent === \"charge\");\n   const payable = (c) => {\n@@ -449,6 +488,14 @@ export async function payTempo(url, {\n     throw bad(`Could not create an MPP credential (${why.slice(0, 120)}); nothing was sent`, 502);\n   }\n   if (typeof credential !== \"string\" || !/^Payment\\s/i.test(credential)) throw bad(\"Could not create an MPP credential\", 502);\n+  // The credential must move exactly the capped quote to the checked\n+  // recipient; anything else is refused here, before it leaves this process.\n+  const carried = await credentialPaymentRefusal(credential, { amountAtomic: quotedAtomic, recipient });\n+  if (carried) {\n+    const e = bad(`The signed credential does not match the checked payment (${carried}); refusing to pay. Nothing was sent.`, 502);\n+    e.refused = true;\n+    throw e;\n+  }\n   const startBlock = await headRead;\n   // A pull credential moves nothing until the seller submits it, so when\n   // signing used up the budget the request is not sent at all."},{"sha":"9c0afb55a03dd4e9ca314d0ead14a3c07db01d4b","filename":"src/tempo-late-watches.js","status":"added","additions":154,"deletions":0,"changes":154,"blob_url":"https://github.com/MikeyPetrillo/Agent402/blob/81a674d1a3cf7fdbbcc04f4da366c144ccd393f7/src%2Ftempo-late-watches.js","raw_url":"https://github.com/MikeyPetrillo/Agent402/raw/81a674d1a3cf7fdbbcc04f4da366c144ccd393f7/src%2Ftempo-late-watches.js","contents_url":"https://api.github.com/repos/MikeyPetrillo/Agent402/contents/src%2Ftempo-late-watches.js?ref=81a674d1a3cf7fdbbcc04f4da366c144ccd393f7","patch":"@@ -0,0 +1,154 @@\n+// Durable record of the Tempo late-landing watches (src/mpp-tempo.js\n+// watchLateTempoLanding).\n+//\n+// A pull credential answered 402 after its broadcast failed can still land on\n+// chain inside its validity. The in-process watch reads the chain again on a\n+// few delays and books a landed transfer as owed. Two things used to lose a\n+// watch with no record: the per-process bound (past it a watch was skipped)\n+// and a process that stopped mid-watch (a deploy or restart). So every watch\n+// is written here when it starts and removed when it ends. A watch past the\n+// bound runs nowhere in process; the sweep (a leased tick in server.js) reads\n+// each entry that no live watch on this process owns once its last delay has\n+// passed, books a landed transfer through the same path, and removes the\n+// entry. Booking is keyed by the transaction hash (the refund ledger's\n+// evidence is unique), so an entry read twice books once.\n+//\n+// An entry whose read keeps failing is kept and read again on the next tick,\n+// for at most LATE_WATCH_GIVE_UP_MS; then it is logged as an error and\n+// dropped. Past LATE_WATCH_KEEP_MAX entries the oldest is logged and dropped.\n+// The stored entry carries the credential (the chain read needs it), the\n+// route, the amount, the ledger payer when known and whether the request was\n+// our own synthetic traffic; nothing else about the request.\n+import { createHash } from \"node:crypto\";\n+import { createJsonDocument, SKIP_UPDATE } from \"./json-document.js\";\n+\n+export const LATE_WATCH_DOC = \"tempo-late-watches\";\n+export const LATE_WATCH_KEEP_MAX = 2000;\n+// Read by the sweep only this long after the watch's last delay, so a live\n+// watch on another container (a deploy overlap) finishes first.\n+export const LATE_WATCH_GRACE_MS = 30_000;\n+export const LATE_WATCH_GIVE_UP_MS = 24 * 3600_000;\n+export const LATE_WATCH_SWEEP_PER_TICK = 25;\n+const EMPTY = Object.freeze({ watches: {} });\n+\n+export const lateWatchKey = (auth) => createHash(\"sha256\").update(String(auth)).digest(\"hex\").slice(0, 32);\n+\n+export function createLateWatchLedger({\n+  doc = createJsonDocument({ name: LATE_WATCH_DOC, file: process.env.TEMPO_LATE_WATCH_FILE || null, log: () => {} }),\n+  now = Date.now,\n+  log = console.warn,\n+} = {}) {\n+  const running = new Set(); // keys a live watch on this process owns\n+  const counts = { recorded: 0, recordFailed: 0, dropped: 0, sweptLanded: 0, sweptAbsent: 0, sweptFailed: 0, gaveUp: 0 };\n+\n+  /** Write an entry before its watch starts. Resolves false when nothing was stored. */\n+  async function record(key, entry) {\n+    let r = null;\n+    // The update callback can run more than once (a write conflict retries\n+    // it), so what it dropped is counted and logged once, after the write.\n+    let droppedNow = 0;\n+    try {\n+      r = await doc.update((b) => {\n+        droppedNow = 0;\n+        const watches = { ...((b && b.watches) || {}) };\n+        watches[key] = entry;\n+        const keys = Object.keys(watches);\n+        if (keys.length > LATE_WATCH_KEEP_MAX) {\n+          keys.sort((a, c) => (Number(watches[a]?.startedAt) || 0) - (Number(watches[c]?.startedAt) || 0));\n+          for (const k of keys.slice(0, keys.length - LATE_WATCH_KEEP_MAX)) { delete watches[k]; droppedNow++; }\n+        }\n+        return { ...(b || {}), watches };\n+      }, { fallback: EMPTY });\n+    } catch { r = null; }\n+    if (r?.ok && droppedNow) {\n+      counts.dropped += droppedNow;\n+      log(`[mpp-tempo] ERROR late-landing watch list is full (${LATE_WATCH_KEEP_MAX}): ${droppedNow} oldest entr${droppedNow === 1 ? \"y was\" : \"ies were\"} dropped unread`);\n+    }\n+    if (r?.ok) counts.recorded++;\n+    else { counts.recordFailed++; log(\"[mpp-tempo] late-landing watch could not be recorded; it runs in this process only\"); }\n+    return !!r?.ok;\n+  }\n+\n+  async function remove(key) {\n+    try {\n+      await doc.update((b) => {\n+        if (!b?.watches?.[key]) return SKIP_UPDATE;\n+        const watches = { ...b.watches };\n+        delete watches[key];\n+        return { ...b, watches };\n+      }, { fallback: EMPTY });\n+    } catch { /* the next sweep reads it again; booking is idempotent */ }\n+  }\n+\n+  /**\n+   * One pass: every stored entry this process does not own, whose last delay\n+   * plus the grace has passed, read once (oldest first, at most perTick).\n+   * `confirm(auth, { trace })` resolves { txId, amountAtomic } when the\n+   * transfer landed and null otherwise; a null with trace.error set is a read\n+   * that failed (src/tempo-confirm.js never throws), so the entry is kept.\n+   */\n+  async function sweep({ confirm, book, perTick = LATE_WATCH_SWEEP_PER_TICK } = {}) {\n+    const out = { read: 0, landed: 0, absent: 0, failed: 0, gaveUp: 0, waiting: 0 };\n+    if (typeof confirm !== \"function\" || typeof book !== \"function\") return out;\n+    let r;\n+    try { r = await doc.read(); } catch { return out; }\n+    if (!r?.ok) return out;\n+    const t = now();\n+    const entries = Object.entries((r.body && r.body.watches) || {})\n+      .filter(([k]) => !running.has(k))\n+      .sort(([, a], [, c]) => (Number(a?.startedAt) || 0) - (Number(c?.startedAt) || 0));\n+    for (const [key, e] of entries) {\n+      if (out.read >= perTick) break;\n+      const startedAt = Number(e?.startedAt) || 0;\n+      if (t < startedAt + (Number(e?.lastDelayMs) || 0) + LATE_WATCH_GRACE_MS) { out.waiting++; continue; }\n+      out.read++;\n+      let found = null;\n+      const trace = {};\n+      let readFailed = false;\n+      try { found = await confirm(e.auth, { attempts: 1, delayMs: 0, trace }); } catch { readFailed = true; }\n+      if (!found?.txId && trace.error) readFailed = true;\n+      if (readFailed) {\n+        out.failed++; counts.sweptFailed++;\n+        if (t - startedAt > LATE_WATCH_GIVE_UP_MS) {\n+          out.gaveUp++; counts.gaveUp++;\n+          log(`[mpp-tempo] ERROR late-landing watch for ${e.method || \"?\"} ${e.path || \"?\"} could not read the chain for ${Math.round(LATE_WATCH_GIVE_UP_MS / 3600_000)} h; dropped without an answer`);\n+          await remove(key);\n+        }\n+        continue;\n+      }\n+      if (found?.txId) {\n+        let booked = false;\n+        try { booked = (await book(e, found)) === true; } catch { booked = false; }\n+        if (!booked) { out.failed++; counts.sweptFailed++; continue; } // kept: read and booked again next tick\n+        out.landed++; counts.sweptLanded++;\n+      } else { out.absent++; counts.sweptAbsent++; }\n+      await remove(key);\n+    }\n+    return out;\n+  }\n+\n+  return {\n+    record, remove, sweep,\n+    own: (key) => { running.add(key); },\n+    release: (key) => { running.delete(key); },\n+    stats: () => ({ ...counts, runningHere: running.size }),\n+    _doc: doc,\n+  };\n+}\n+\n+export const LATE_WATCH_SWEEP_INTERVAL_MS = 60_000;\n+const LATE_WATCH_SWEEP_LEASE = \"tempo-late-watch-sweep\";\n+let sweepTimer = null;\n+/** Start the sweep under its lease, once per process. `sweepOnce()` is the\n+ *  gate's sweepLateWatches (it holds the booking path). */\n+export function startLateWatchSweep({ sweepOnce, intervalMs = LATE_WATCH_SWEEP_INTERVAL_MS } = {}) {\n+  if (sweepTimer || typeof sweepOnce !== \"function\") return null;\n+  sweepTimer = \"starting\";\n+  const ready = (async () => {\n+    const [{ leased }, { contained }] = await Promise.all([import(\"./state-db.js\"), import(\"./contained-turn.js\")]);\n+    const tick = leased(LATE_WATCH_SWEEP_LEASE, { ttlMs: Math.max(intervalMs * 2, 120_000) }, () => sweepOnce());\n+    sweepTimer = setInterval(contained(LATE_WATCH_SWEEP_LEASE, () => tick().catch(() => {})), intervalMs);\n+    if (typeof sweepTimer.unref === \"function\") sweepTimer.unref();\n+  })().catch((e) => { sweepTimer = null; console.warn(`[mpp-tempo] late-landing sweep did not start: ${String(e?.message || e).slice(0, 120)}`); });\n+  return ready;\n+}"},{"sha":"432301fb90f5e41def9381265d728bcd7a78049b","filename":"src/tempo-push-debts.js","status":"modified","additions":201,"deletions":12,"changes":213,"blob_url":"https://github.com/MikeyPetrillo/Agent402/blob/81a674d1a3cf7fdbbcc04f4da366c144ccd393f7/src%2Ftempo-push-debts.js","raw_url":"https://github.com/MikeyPetrillo/Agent402/raw/81a674d1a3cf7fdbbcc04f4da366c144ccd393f7/src%2Ftempo-push-debts.js","contents_url":"https://api.github.com/repos/MikeyPetrillo/Agent402/contents/src%2Ftempo-push-debts.js?ref=81a674d1a3cf7fdbbcc04f4da366c144ccd393f7","patch":"@@ -24,7 +24,17 @@\n export const PUSH_EXCEPTION = \", except a Tempo transfer sent before the call, which is recorded as owed\";\n \n export const PUSH_INPUT_REFUSED_NOTE = \"push unclaimed: input refused\";\n+// A finalize whose answer was lost (a connection dropped after the request\n+// was sent, or a relay 5xx): the relay may or may not have claimed the hash.\n+// Booked owed like an input refusal, and voided the same way by a later\n+// claim that is served.\n+export const PUSH_FINALIZE_UNANSWERED_NOTE = \"push unclaimed: finalize unanswered\";\n+// The notes of a debt whose transfer may still be claimed by a retry.\n+export const PUSH_CLAIMABLE_NOTES = Object.freeze([PUSH_INPUT_REFUSED_NOTE, PUSH_FINALIZE_UNANSWERED_NOTE]);\n export const PUSH_FINALIZE_REFUSED_NOTE = \"push unclaimed: finalize refused\";\n+// A PULL transaction that landed on chain after its request was answered 402\n+// (src/mpp-tempo.js watchLateTempoLanding): booked through notClaimed.\n+export const PULL_LANDED_AFTER_402_NOTE = \"pull landed after its 402\";\n export const PUSH_CLAIMED_NOTE = \"claimed on retry\";\n export const PUSH_SERVED_NOTE = \"served\";\n export const PUSH_HANGUP_AFTER_CLAIM_NOTE = \"claimed on retry, then disconnected\";\n@@ -36,9 +46,10 @@ export const PUSH_HANDLER_FAILED_AFTER_CLAIM_NOTE = \"claimed on retry, then the\n export const PUSH_FINALIZE_FAILURE_STATUS = 502;\n \n export function createTempoPushDebts({ recordOwed, voidOnClaim, voidForServe = null, reopenHeld = () => false, renoteVoid = () => false, renoteOwed, refundByEvidence, promoteToHangup = () => false, restateHandlerFailure = () => false, recordChargedFailure, isSynthetic = () => false, slugOf = () => \"unknown\" }) {\n-  // The note a held claim leaves on an input-refused row (the void appends\n+  // The note a held claim leaves on a claimable row (the void appends\n   // PUSH_CLAIMED_NOTE to it); reopenHeld matches it exactly.\n-  const HELD_NOTE = `${PUSH_INPUT_REFUSED_NOTE}; ${PUSH_CLAIMED_NOTE}`;\n+  const heldNoteOf = (from) => `${from}; ${PUSH_CLAIMED_NOTE}`;\n+  const HELD_NOTES = PUSH_CLAIMABLE_NOTES.map(heldNoteOf);\n   const base = (req, { hash, payer, amountUsd }) => ({\n     slug: slugOf(req) || \"unknown\",\n     network: \"tempo\",\n@@ -49,19 +60,24 @@ export function createTempoPushDebts({ recordOwed, voidOnClaim, voidForServe = n\n     wire: \"mpp-tempo\",\n   });\n   return {\n-    /** Input refused before finalize. True when a debt stands for the hash. */\n+    /** Input refused before finalize, or (`info.unanswered`) a finalize whose\n+     *  answer was lost. True when a debt stands for the hash. */\n     async inputRefused(req, info) {\n       if (!info?.hash) return false;\n-      await recordOwed({ ...base(req, info), httpStatus: Number(info.status) || 400, note: PUSH_INPUT_REFUSED_NOTE });\n+      await recordOwed({ ...base(req, info), httpStatus: Number(info.status) || 400, note: info.unanswered === true ? PUSH_FINALIZE_UNANSWERED_NOTE : PUSH_INPUT_REFUSED_NOTE });\n       return refundByEvidence(info.hash)?.status === \"owed\";\n     },\n     /** Finalize refused. True when a debt stands for the hash. */\n     async notClaimed(req, info) {\n       if (!info?.hash) return false;\n       const b = base(req, info);\n-      const created = await recordOwed({ ...b, httpStatus: 402, note: PUSH_FINALIZE_REFUSED_NOTE });\n-      // An input-refused row for the same hash becomes this row, once.\n-      const promoted = !created && (await renoteOwed(info.hash, PUSH_INPUT_REFUSED_NOTE, PUSH_FINALIZE_REFUSED_NOTE));\n+      const created = await recordOwed({ ...b, httpStatus: 402, note: info.cls === \"landed-after-402\" ? PULL_LANDED_AFTER_402_NOTE : PUSH_FINALIZE_REFUSED_NOTE });\n+      // A claimable row for the same hash becomes this row, once.\n+      let promoted = false;\n+      for (const from of PUSH_CLAIMABLE_NOTES) {\n+        if (created || promoted) break;\n+        promoted = (await renoteOwed(info.hash, from, PUSH_FINALIZE_REFUSED_NOTE)) === true;\n+      }\n       if ((created || promoted) && !b.synthetic) recordChargedFailure(b.slug, PUSH_FINALIZE_FAILURE_STATUS);\n       return refundByEvidence(info.hash)?.status === \"owed\";\n     },\n@@ -73,9 +89,14 @@ export function createTempoPushDebts({ recordOwed, voidOnClaim, voidForServe = n\n      *  never touched. True when the row changed. */\n     async hungUp(hash, hangupReason) {\n       if (typeof hash !== \"string\" || !hash) return false;\n-      if ((await promoteToHangup(hash, { from: PUSH_INPUT_REFUSED_NOTE, hangupReason, append: PUSH_HANGUP_AFTER_CLAIM_NOTE })) === true) return true;\n+      for (const from of PUSH_CLAIMABLE_NOTES) {\n+        if ((await promoteToHangup(hash, { from, hangupReason, append: PUSH_HANGUP_AFTER_CLAIM_NOTE })) === true) return true;\n+      }\n       // The claim was held (the row voided before the handler): owed again.\n-      return (await reopenHeld(hash, { held: HELD_NOTE, httpStatus: 499, hangupReason, note: `${PUSH_INPUT_REFUSED_NOTE}; ${PUSH_HANGUP_AFTER_CLAIM_NOTE}` })) === true;\n+      for (const from of PUSH_CLAIMABLE_NOTES) {\n+        if ((await reopenHeld(hash, { held: heldNoteOf(from), httpStatus: 499, hangupReason, note: `${from}; ${PUSH_HANGUP_AFTER_CLAIM_NOTE}` })) === true) return true;\n+      }\n+      return false;\n     },\n     /** A claimed push whose handler then answered >= 400 (not a disconnect)\n      *  on a hash that already carries an OWED input-refused row: the row takes\n@@ -84,8 +105,13 @@ export function createTempoPushDebts({ recordOwed, voidOnClaim, voidForServe = n\n      *  touched. True when the row changed. */\n     async handlerFailed(hash, httpStatus) {\n       if (typeof hash !== \"string\" || !hash) return false;\n-      if ((await restateHandlerFailure(hash, { from: PUSH_INPUT_REFUSED_NOTE, httpStatus, append: PUSH_HANDLER_FAILED_AFTER_CLAIM_NOTE })) === true) return true;\n-      return (await reopenHeld(hash, { held: HELD_NOTE, httpStatus, note: `${PUSH_INPUT_REFUSED_NOTE}; ${PUSH_HANDLER_FAILED_AFTER_CLAIM_NOTE}` })) === true;\n+      for (const from of PUSH_CLAIMABLE_NOTES) {\n+        if ((await restateHandlerFailure(hash, { from, httpStatus, append: PUSH_HANDLER_FAILED_AFTER_CLAIM_NOTE })) === true) return true;\n+      }\n+      for (const from of PUSH_CLAIMABLE_NOTES) {\n+        if ((await reopenHeld(hash, { held: heldNoteOf(from), httpStatus, note: `${from}; ${PUSH_HANDLER_FAILED_AFTER_CLAIM_NOTE}` })) === true) return true;\n+      }\n+      return false;\n     },\n     /** BEFORE the handler, for a claimed push: may this run serve it? The\n      *  transfer's owed debt (if any) is voided first, in one statement that a\n@@ -110,7 +136,7 @@ export function createTempoPushDebts({ recordOwed, voidOnClaim, voidForServe = n\n         const row = refundByEvidence(hash);\n         // Held before the handler (claimForServe) and now served: say so, so a\n         // later reopen (hungUp, handlerFailed) never turns it back to owed.\n-        if (row && row.status === \"void\" && row.note === HELD_NOTE) return (await renoteVoid(hash, HELD_NOTE, `${HELD_NOTE}; ${PUSH_SERVED_NOTE}`)) === true;\n+        if (row && row.status === \"void\" && HELD_NOTES.includes(row.note)) return (await renoteVoid(hash, row.note, `${row.note}; ${PUSH_SERVED_NOTE}`)) === true;\n         if (row && (row.status === \"sending\" || row.status === \"paid\")) console.error(`[mpp-tempo] REFUNDED-AND-SERVED: push transfer ${hash} was claimed and served while its debt was already ${row.status}; review refund #${row.id}`);\n       }\n       return voided;\n@@ -135,3 +161,166 @@ export function whenTempoLedgerPayerKnown(req, label, fn) {\n   req.mppTempoLedgerPayerRead.then(run, run);\n   return undefined;\n }\n+\n+// ---------------------------------------------------------------------------\n+// The held-claim sweep. claimForServe voids a claimable debt BEFORE its\n+// handler runs; the run's end then marks it served (served) or owed again\n+// (hungUp, handlerFailed). A process that dies in between leaves the row void\n+// with the hold's note forever: a buyer charged and possibly never served,\n+// with nothing owed. Under a lease, the sweep reopens a row still held past\n+// the longest a run can take (owed again, with a note that says why), unless\n+// a sale is booked for the transfer (then it is marked served). It does\n+// nothing while the refund ledger's journal holds writes waiting to land: a\n+// served note queued there would otherwise be read as a run that never ended.\n+//\n+// The sweep pages through EVERY row created before the cutoff (a hold's\n+// createdAt is never after its resolvedAt), oldest first, by createdAt\n+// window with a cursor that persists across ticks, at most\n+// PUSH_HELD_SWEEP_ROWS_PER_TICK rows a tick; a window that fills its page is\n+// halved until it does not, so no row is skipped however many share a\n+// range. At the cutoff the cursor starts over. The same walk notes owed rows\n+// left unpaid past OWED_ESCALATE_DAYS (an error line, at most once a day).\n+// ---------------------------------------------------------------------------\n+export const PUSH_RUN_UNFINISHED_NOTE = \"claimed on retry, then the run never finished\";\n+export const PUSH_HELD_SWEEP_LEASE = \"tempo-push-held-sweep\";\n+/** How long a hold may stand before the sweep reads its run as dead:\n+ *  TEMPO_PUSH_HELD_MAX_MINUTES (default 30; a run is bounded well under it). */\n+export function pushHeldMaxMs(env = process.env) {\n+  const m = Number(env.TEMPO_PUSH_HELD_MAX_MINUTES);\n+  return (Number.isFinite(m) && m >= 5 && m <= 24 * 60 ? m : 30) * 60_000;\n+}\n+export const PUSH_HELD_SWEEP_INTERVAL_MS = 5 * 60_000;\n+/** Rows one page of the walk reads, and rows one tick reads at most. */\n+export const PUSH_HELD_SWEEP_PAGE = 500;\n+export const PUSH_HELD_SWEEP_ROWS_PER_TICK = 5000;\n+/** An owed row unpaid this long is named in the pass's escalation line:\n+ *  OWED_ESCALATE_DAYS (default 7, 1 to 365). */\n+export function owedEscalateMs(env = process.env) {\n+  const d = Number(env.OWED_ESCALATE_DAYS);\n+  return (Number.isFinite(d) && d >= 1 && d <= 365 ? d : 7) * 86_400_000;\n+}\n+\n+/** The ledger read the walk uses: rows created in [from, to), at most\n+ *  `limit`, each the full row (note, resolvedAt) for a void Tempo one. */\n+export function ledgerHeldPage(ledger) {\n+  return ({ from, to, limit }) => ledger.refundsCreatedBetween(from, to, { limit }).map((r) => (r?.status === \"void\" && r.network === \"tempo\" ? (ledger.refundByEvidence(r.evidence) || r) : r));\n+}\n+\n+export function createHeldClaimSweep({ listVoid = null, listPage = null, oldestCreatedAt = null, reopenHeld, renoteVoid, saleFor = async () => null, journalWaiting = () => 0, now = () => Date.now(), maxAgeMs = pushHeldMaxMs(), log = console.warn, alarm = console.error, pageSize = PUSH_HELD_SWEEP_PAGE, rowsPerTick = PUSH_HELD_SWEEP_ROWS_PER_TICK, owedAgeMs = owedEscalateMs(), escalateEveryMs = 24 * 3600_000 } = {}) {\n+  const heldFrom = new Map(PUSH_CLAIMABLE_NOTES.map((from) => [`${from}; ${PUSH_CLAIMED_NOTE}`, from]));\n+  // The walk's cursor (createdAt) and window width, kept across ticks.\n+  let cursor = 0;\n+  let width = 0;\n+  let aged = { n: 0, oldest: null };\n+  let lastEscalationAt = -Infinity;\n+  const handle = async (row, cutoff, out) => {\n+    const from = heldFrom.get(row?.note);\n+    if (!from || row.network !== \"tempo\" || typeof row.evidence !== \"string\") return;\n+    const at = Number(row.resolvedAt ?? row.resolved_at);\n+    if (!Number.isFinite(at) || at > cutoff) return;\n+    let sale = null;\n+    try { sale = await saleFor(row.evidence); } catch { return; }\n+    if (sale) {\n+      if ((await renoteVoid(row.evidence, row.note, `${row.note}; ${PUSH_SERVED_NOTE}`)) === true) out.served++;\n+      return;\n+    }\n+    if ((await reopenHeld(row.evidence, { held: row.note, httpStatus: 500, note: `${from}; ${PUSH_RUN_UNFINISHED_NOTE}` })) === true) {\n+      out.reopened++;\n+      log(`[mpp-tempo] push transfer ${row.evidence} was held for a run that never finished; owed again`);\n+    }\n+  };\n+  // One page of the walk: the rows in [cursor, to) for the widest window\n+  // (from the last width, at most up to the cutoff) whose page is not full.\n+  const page = async (cutoff, out) => {\n+    let to = width > 0 ? Math.min(cutoff, cursor + width) : cutoff;\n+    for (;;) {\n+      out.reads++;\n+      const rows = (await listPage({ from: cursor, to, limit: pageSize })) || [];\n+      if (rows.length < pageSize) {\n+        // Room to spare: the next window may be wider.\n+        width = rows.length < pageSize / 4 ? Math.max(1, (to - cursor) * 2) : Math.max(1, to - cursor);\n+        return { rows, to };\n+      }\n+      if (to - cursor <= 1) {\n+        // One millisecond holds a full page: read all of it.\n+        out.reads++;\n+        return { rows: (await listPage({ from: cursor, to, limit: Number.MAX_SAFE_INTEGER })) || [], to };\n+      }\n+      to = cursor + Math.floor((to - cursor) / 2);\n+    }\n+  };\n+  return {\n+    async sweep() {\n+      const out = { reopened: 0, served: 0, waiting: false, rows: 0, reads: 0, passComplete: false };\n+      let waiting = 0;\n+      try { waiting = Number(await journalWaiting()) || 0; } catch { waiting = 1; }\n+      if (waiting > 0) { out.waiting = true; return out; }\n+      const t = now();\n+      const cutoff = t - maxAgeMs;\n+      if (!listPage) {\n+        // A caller that hands one list (tests of the row rules).\n+        let rows = [];\n+        try { rows = (await listVoid?.()) || []; } catch { return out; }\n+        for (const row of rows) await handle(row, cutoff, out);\n+        out.rows = rows.length;\n+        return out;\n+      }\n+      try {\n+        // A pass starts at the oldest row, not the epoch, so its first pages\n+        // are not spent halving across empty years.\n+        if (cursor === 0 && oldestCreatedAt) {\n+          const first = Number(await oldestCreatedAt());\n+          if (Number.isFinite(first) && first > 0) cursor = Math.min(first, cutoff);\n+        }\n+        while (cursor < cutoff && out.rows < rowsPerTick) {\n+          // Each page reads a synchronous store: yield between pages so one\n+          // tick never holds the event loop for the whole walk.\n+          if (out.reads > 0) await new Promise((r) => setImmediate(r));\n+          const { rows, to } = await page(cutoff, out);\n+          for (const row of rows) {\n+            out.rows++;\n+            if (row?.status === \"owed\" && Number(row.createdAt) <= t - owedAgeMs) {\n+              aged.n++;\n+              if (aged.oldest == null || Number(row.createdAt) < aged.oldest) aged.oldest = Number(row.createdAt);\n+            }\n+            await handle(row, cutoff, out);\n+          }\n+          cursor = to;\n+        }\n+      } catch { return out; }\n+      if (cursor >= cutoff) {\n+        // A full pass: start over, and name owed rows left unpaid too long.\n+        out.passComplete = true;\n+        out.owedAged = aged.n;\n+        if (aged.n > 0 && t - lastEscalationAt >= escalateEveryMs) { lastEscalationAt = t; try { alarm(`[refunds] ${aged.n} owed refund row(s) unpaid past ${Math.round(owedAgeMs / 86_400_000)} day(s), oldest created ${new Date(aged.oldest).toISOString()}; run the refund workflow or resolve them on /__operator/refunds.json`); } catch { /* logging never throws */ } }\n+        cursor = 0;\n+        width = 0;\n+        aged = { n: 0, oldest: null };\n+      }\n+      return out;\n+    },\n+  };\n+}\n+\n+let heldSweepTimer = null;\n+/** Start the held-claim sweep under its lease (once per process). `saleFor(tx)` reads a\n+ *  sale by its transaction; the caller passes it so this module never imports the sales ledger. */\n+export function startTempoHeldClaimSweep({ intervalMs = PUSH_HELD_SWEEP_INTERVAL_MS, saleFor } = {}) {\n+  if (heldSweepTimer) return null;\n+  heldSweepTimer = \"starting\";\n+  const ready = (async () => {\n+    const [{ leased }, ledger] = await Promise.all([import(\"./state-db.js\"), import(\"./refund-ledger.js\")]);\n+    const sweeper = createHeldClaimSweep({\n+      listPage: ledgerHeldPage(ledger),\n+      oldestCreatedAt: ledger.oldestRefundCreatedAt,\n+      reopenHeld: ledger.reopenHeldClaim,\n+      renoteVoid: ledger.renoteVoidRefund,\n+      saleFor,\n+      journalWaiting: () => ledger.refundDeadLetterState().waiting,\n+    });\n+    const tick = leased(PUSH_HELD_SWEEP_LEASE, { ttlMs: Math.max(intervalMs, 120_000) }, () => sweeper.sweep());\n+    heldSweepTimer = setInterval(() => { tick().catch(() => {}); }, intervalMs);\n+    if (typeof heldSweepTimer.unref === \"function\") heldSweepTimer.unref();\n+  })().catch((e) => { heldSweepTimer = null; console.warn(`[mpp-tempo] held-claim sweep did not start: ${String(e?.message || e).slice(0, 120)}`); });\n+  return ready;\n+}"},{"sha":"20880f03fba992a53a4872d36298ed3b21ae5ccf","filename":"src/tempo-sponsor-ceiling.js","status":"added","additions":162,"deletions":0,"changes":162,"blob_url":"https://github.com/MikeyPetrillo/Agent402/blob/81a674d1a3cf7fdbbcc04f4da366c144ccd393f7/src%2Ftempo-sponsor-ceiling.js","raw_url":"https://github.com/MikeyPetrillo/Agent402/raw/81a674d1a3cf7fdbbcc04f4da366c144ccd393f7/src%2Ftempo-sponsor-ceiling.js","contents_url":"https://api.github.com/repos/MikeyPetrillo/Agent402/contents/src%2Ftempo-sponsor-ceiling.js?ref=81a674d1a3cf7fdbbcc04f4da366c144ccd393f7","patch":"@@ -0,0 +1,162 @@\n+// Our own ceiling on Tempo subscription gas sponsorship.\n+//\n+// The subscription sponsor (TEMPO_SUBSCRIPTION_FEE_PAYER_KEY) co-signs the gas\n+// for every activation and renewal. mppx bounds ONE transaction (its fee-payer\n+// policy: maxGas and maxTotalFee) and the low-balance alarm watches the\n+// wallet, but nothing bounded how many transactions the sponsor pays for in a\n+// day. This module is that bound: a rolling 24 h window of sponsored\n+// transactions, counted and summed by their fee bound (gas limit x\n+// maxFeePerGas, the most the transaction can cost the sponsor), shared across\n+// replicas through src/shared-limits.js.\n+//\n+// It sits on the RPC transport of the subscription clients, so it sees the\n+// exact bytes about to be broadcast: a raw transaction carrying a fee-payer\n+// signature is admitted into the window before the send, or refused, and a\n+// refused one never leaves the process. Nothing else about a subscription\n+// changes: the buyer's authorization, the challenge binding and the period\n+// accounting run as before, and a refused renewal lands in past_due (backoff,\n+// grace) exactly like any other failed charge.\n+//\n+// Knobs (Railway):\n+//   MPP_SUB_SPONSOR_DAILY_MAX_TX   sponsored transactions per rolling 24 h (default 100)\n+//   MPP_SUB_SPONSOR_DAILY_MAX_USD  fee bound per rolling 24 h, in dollars (default 2)\n+// A malformed or non-positive value keeps the default: a typo never lifts the\n+// ceiling. A transaction is counted once it is handed to the send, and stays\n+// counted whatever the RPC answers (a send that timed out may have landed), so\n+// the window can only over-count, the safe direction.\n+//\n+// Renewal headroom: an activation is admitted only while the window is under\n+// (1 - RENEWAL_RESERVE_FRACTION) of each ceiling, so new sign-ups can never\n+// spend the share that keeps existing subscribers' renewals going. A renewal\n+// reads against the whole ceiling.\n+import { keccak256 } from \"viem\";\n+import { Transaction } from \"viem/tempo\";\n+import { shared, sharedLimitsEnabled, createMemoryLimits, noteSharedLimitsDegraded } from \"./shared-limits.js\";\n+\n+export const SPONSOR_WINDOW_MS = 24 * 3_600_000;\n+export const SPONSOR_DAILY_MAX_TX_DEFAULT = 100;\n+export const SPONSOR_DAILY_MAX_USD_DEFAULT = 2;\n+export const RENEWAL_RESERVE_FRACTION = 0.2;\n+const NAME = \"tempo-sub-sponsor\";\n+const KEY = \"all\";\n+const CONTROL = \"tempo-sub-sponsor\";\n+// Tempo prices gas in attodollars (1e-18 USD), so gas x maxFeePerGas / 1e12 is\n+// the fee bound in micro-dollars (1e-6 USD), the unit the window sums.\n+const ATTO_PER_MICRO = 10n ** 12n;\n+\n+const positive = (raw, dflt) => {\n+  const v = Number(String(raw ?? \"\").trim());\n+  return String(raw ?? \"\").trim() && Number.isFinite(v) && v > 0 ? v : dflt;\n+};\n+/** The ceiling in force: { maxTx, maxUsd }. */\n+export function sponsorCeilingLimits(env = process.env) {\n+  return {\n+    maxTx: Math.floor(positive(env.MPP_SUB_SPONSOR_DAILY_MAX_TX, SPONSOR_DAILY_MAX_TX_DEFAULT)),\n+    maxUsd: positive(env.MPP_SUB_SPONSOR_DAILY_MAX_USD, SPONSOR_DAILY_MAX_USD_DEFAULT),\n+  };\n+}\n+\n+export class SponsorCeilingError extends Error {\n+  constructor(message) {\n+    super(message);\n+    this.name = \"SponsorCeilingError\";\n+    // The JSON-RPC \"transaction rejected\" code, for any reader that classifies\n+    // by code. The guard sits outside the transport's own retry loop, so a\n+    // refusal is one attempt, and its message names no send call or timeout:\n+    // the subscription engine reads it as a definite failure before any send\n+    // (never a send-phase ambiguity).\n+    this.code = -32003;\n+    this.sponsorCeiling = true;\n+  }\n+}\n+\n+/** For a raw Tempo transaction: is it fee-sponsored, its hash, and its fee bound in micro-dollars. Null when it does not decode. */\n+export function sponsoredFeeBound(serialized) {\n+  if (typeof serialized !== \"string\" || !serialized.startsWith(\"0x\")) return null;\n+  let tx;\n+  try { tx = Transaction.deserialize(serialized); } catch { return null; }\n+  if (!tx || typeof tx !== \"object\") return null;\n+  const sponsored = Boolean(tx.feePayerSignature);\n+  const gas = typeof tx.gas === \"bigint\" ? tx.gas : 0n;\n+  const maxFee = typeof tx.maxFeePerGas === \"bigint\" ? tx.maxFeePerGas : 0n;\n+  // Rounded up: a fee bound under one micro-dollar still weighs one.\n+  const atto = gas * maxFee;\n+  const micro = atto === 0n ? 0n : (atto + ATTO_PER_MICRO - 1n) / ATTO_PER_MICRO;\n+  return { sponsored, hash: keccak256(serialized), feeMicroUsd: Number(micro) };\n+}\n+\n+// This process's own window: what decides when the shared store does not\n+// answer (never looser than one replica alone).\n+let local = createMemoryLimits();\n+\n+async function addToWindow(member, weight, now) {\n+  const args = { windowMs: SPONSOR_WINDOW_MS, member, weight, now };\n+  if (sharedLimitsEnabled()) {\n+    const mine = local.windowAdd(NAME, KEY, args);\n+    const r = await shared.windowAdd(NAME, KEY, args);\n+    if (r?.ok) return { r, store: shared };\n+    noteSharedLimitsDegraded(CONTROL, r);\n+    return { r: await mine, store: local };\n+  }\n+  return { r: await shared.windowAdd(NAME, KEY, args), store: shared };\n+}\n+\n+/**\n+ * Admit one raw transaction into the window, or throw SponsorCeilingError.\n+ * A transaction with no fee-payer signature is not ours to bound and passes.\n+ * The same transaction sent twice (a retry) is one entry.\n+ */\n+export async function admitSponsoredSend(serialized, { now = Date.now(), env = process.env, log = console.warn, kind = \"activation\" } = {}) {\n+  const bound = sponsoredFeeBound(serialized);\n+  if (!bound || !bound.sponsored) return { admitted: false, sponsored: false };\n+  const full = sponsorCeilingLimits(env);\n+  // Anything not named a renewal reads against the activation share.\n+  const share = kind === \"renewal\" ? 1 : 1 - RENEWAL_RESERVE_FRACTION;\n+  const maxTx = kind === \"renewal\" ? full.maxTx : Math.floor(full.maxTx * share);\n+  const maxUsd = full.maxUsd * share;\n+  const { r, store } = await addToWindow(bound.hash, bound.feeMicroUsd, now);\n+  const count = Number(r?.count) || 0;\n+  const sumMicro = Number(r?.sum) || 0;\n+  const overCount = count > maxTx;\n+  const overFee = sumMicro > Math.round(maxUsd * 1e6);\n+  if (overCount || overFee) {\n+    const entry = { member: bound.hash, weight: bound.feeMicroUsd };\n+    await store.windowRemove(NAME, KEY, entry);\n+    if (store !== local) await local.windowRemove(NAME, KEY, entry);\n+    const cause = overCount ? \"MPP_SUB_SPONSOR_DAILY_MAX_TX\" : \"MPP_SUB_SPONSOR_DAILY_MAX_USD\";\n+    const which = kind === \"renewal\" ? \"the 24 h sponsor ceiling\" : \"the activation share of the 24 h sponsor ceiling (the rest is held for renewals)\";\n+    log(`[mpp-subs] sponsored ${kind === \"renewal\" ? \"renewal\" : \"activation\"} send refused: ${which} (${cause}) is reached; nothing broadcast`);\n+    throw new SponsorCeilingError(`subscription gas sponsorship refused: ${which} (${cause}) is reached`);\n+  }\n+  return { admitted: true, sponsored: true, count, feeMicroUsd: bound.feeMicroUsd };\n+}\n+\n+const SEND_METHODS = new Set([\"eth_sendRawTransaction\", \"eth_sendRawTransactionSync\"]);\n+/** Wrap a viem transport so every raw send passes admitSponsoredSend first. */\n+export function withSponsorCeiling(transport, opts = {}) {\n+  return (config) => {\n+    const t = transport(config);\n+    const request = async (args, options) => {\n+      if (args && SEND_METHODS.has(args.method)) await admitSponsoredSend(args.params?.[0], opts);\n+      return t.request(args, options);\n+    };\n+    return { ...t, request };\n+  };\n+}\n+\n+/** The word for /api/gateway-status: ok, reached (a new sponsored send would be refused), or unknown. */\n+export async function sponsorCeilingWord({ now = Date.now(), env = process.env } = {}) {\n+  try {\n+    let r = await shared.windowRead(NAME, KEY, { windowMs: SPONSOR_WINDOW_MS, now });\n+    if (!r?.ok) r = await local.windowRead(NAME, KEY, { windowMs: SPONSOR_WINDOW_MS, now });\n+    if (!r?.ok) return \"unknown\";\n+    const { maxTx, maxUsd } = sponsorCeilingLimits(env);\n+    return (Number(r.count) || 0) >= maxTx || (Number(r.sum) || 0) >= Math.round(maxUsd * 1e6) ? \"reached\" : \"ok\";\n+  } catch { return \"unknown\"; }\n+}\n+\n+/** Test seam: empty both windows. */\n+export async function _resetSponsorCeiling() {\n+  local = createMemoryLimits();\n+  await shared.windowClear(NAME, KEY);\n+}"},{"sha":"42a2a35879894d6ac802e58c38a1dbabcff89d9b","filename":"src/terms.js","status":"modified","additions":8,"deletions":4,"changes":12,"blob_url":"https://github.com/MikeyPetrillo/Agent402/blob/81a674d1a3cf7fdbbcc04f4da366c144ccd393f7/src%2Fterms.js","raw_url":"https://github.com/MikeyPetrillo/Agent402/raw/81a674d1a3cf7fdbbcc04f4da366c144ccd393f7/src%2Fterms.js","contents_url":"https://api.github.com/repos/MikeyPetrillo/Agent402/contents/src%2Fterms.js?ref=81a674d1a3cf7fdbbcc04f4da366c144ccd393f7","patch":"@@ -51,7 +51,7 @@ export function termsPage(baseUrl) {\n <section>\n <div class=\"tm-eyebrow\">$ GET /terms</div>\n <h1 class=\"tm-h1\">Terms of Service</h1>\n-<p class=\"tm-updated\">Agent402 (agent402.tools) - last updated 2026-11-04.</p>\n+<p class=\"tm-updated\">Agent402 (agent402.tools) - last updated 2026-11-09.</p>\n </section>\n \n <section>\n@@ -139,7 +139,9 @@ Celo or Tempo. An x402 payment settles only after your call returns a successful\n returns an error, the payment is not settled and you are not charged. Some payments are final before the\n call runs, such as an MPP payment sent as a Tempo transfer; if that call then fails, or if your connection\n closes after a payment has settled and before the response is delivered, we record the amount as owed\n-back to the paying wallet, and repay it as described under refunds below. Micropayments are per call and, once settled on-chain, are final and\n+back to the paying wallet, and repay it as described under refunds below. If an x402 payment on an EVM\n+chain, or a Tempo transaction, lands on chain after we answered the call with an error, we record the amount\n+as owed back to the paying wallet and repay it the same way. Micropayments are per call and, once settled on-chain, are final and\n non-refundable except as described in these terms or where required by law. Metered routes quote a ceiling before\n payment and settle at or under it. You are responsible for your own wallet and keys; we never receive or\n hold your private key.${publicIndex ? ` ${publicIndex}` : \"\"}</p>${gatewayBatched ? `\n@@ -164,8 +166,10 @@ Algorand. Before a repayment is sent we confirm on that chain that your payment\n Solana we also confirm the repayment itself before recording it as paid. An amount\n owed because a connection closed is reviewed before it is repaid, and is not repaid when the call's effect\n outlives the response and was delivered (a memory write, or a purchase we made from another seller for\n-you). A payment whose paying wallet cannot be identified from its own settlement cannot be repaid. None of\n-this reduces a right you have by law.</p>\n+you). A payment whose paying wallet cannot be identified from its own settlement cannot be repaid. Before a\n+repayment is sent we check the receiving address against the published sanctions lists; we do not send to\n+a listed address, and a repayment waits while that check cannot be made. None of this reduces a right you\n+have by law.</p>\n <p><b>By card.</b> Card payments for reports and monitors, for pay-per-call purchases made with a card over MPP, and for prepaid credits are processed by\n <a href=\"https://stripe.com\" rel=\"noopener\">Stripe</a> under Stripe's terms; we never see card numbers. A\n report is generated only against a paid, Stripe-verified session, once; if generation fails, the charge"},{"sha":"6014ea357ba743f74e8c52cc1158f7ec6fa79fe5","filename":"src/tool-error-fields.js","status":"modified","additions":11,"deletions":3,"changes":14,"blob_url":"https://github.com/MikeyPetrillo/Agent402/blob/81a674d1a3cf7fdbbcc04f4da366c144ccd393f7/src%2Ftool-error-fields.js","raw_url":"https://github.com/MikeyPetrillo/Agent402/raw/81a674d1a3cf7fdbbcc04f4da366c144ccd393f7/src%2Ftool-error-fields.js","contents_url":"https://api.github.com/repos/MikeyPetrillo/Agent402/contents/src%2Ftool-error-fields.js?ref=81a674d1a3cf7fdbbcc04f4da366c144ccd393f7","patch":"@@ -20,7 +20,7 @@ export function toolErrorFields(err) {\n     ...(isCount(err?.inputChars) ? { inputChars: err.inputChars } : {}),\n     // An image over a pixel cap names the caps, its own size and the longest\n     // side to downscale to.\n-    ...pick(err, [\"maxMegapixels\", \"maxSide\", \"maxPixels\", \"width\", \"height\", \"megapixels\", \"downscaleToLongestSide\"], isAmount),\n+    ...imageCaps(err),\n     // One plain sentence or two on how to recover (bounded, printable text).\n     ...(typeof err?.fix === \"string\" && FIX_RE.test(err.fix) ? { fix: err.fix } : {}),\n   };\n@@ -29,9 +29,17 @@ export function toolErrorFields(err) {\n const isCount = (n) => Number.isSafeInteger(n) && n >= 0;\n const isAmount = (n) => typeof n === \"number\" && Number.isFinite(n) && n >= 0 && n <= Number.MAX_SAFE_INTEGER;\n const FIX_RE = /^[\\x20-\\x7e]{1,400}$/;\n-function pick(err, keys, valid) {\n+// Each field is read by its own name, never by a computed key, so nothing an\n+// error carries beyond these numbers (its message, its stack) can reach the\n+// answer through this copy.\n+function imageCaps(err) {\n+  const read = {\n+    maxMegapixels: err?.maxMegapixels, maxSide: err?.maxSide, maxPixels: err?.maxPixels,\n+    width: err?.width, height: err?.height, megapixels: err?.megapixels,\n+    downscaleToLongestSide: err?.downscaleToLongestSide,\n+  };\n   const out = {};\n-  for (const k of keys) if (valid(err?.[k])) out[k] = err[k];\n+  for (const [k, v] of Object.entries(read)) if (isAmount(v)) out[k] = v;\n   return out;\n }\n const SUGGESTION_RE = /^[A-Za-z0-9][A-Za-z0-9._:/-]{0,199}$/;"},{"sha":"3b2e6e0ac5ed863e040a09b73dc0a4992af13b28","filename":"src/tools/chain-kit.js","status":"modified","additions":1,"deletions":1,"changes":2,"blob_url":"https://github.com/MikeyPetrillo/Agent402/blob/81a674d1a3cf7fdbbcc04f4da366c144ccd393f7/src%2Ftools%2Fchain-kit.js","raw_url":"https://github.com/MikeyPetrillo/Agent402/raw/81a674d1a3cf7fdbbcc04f4da366c144ccd393f7/src%2Ftools%2Fchain-kit.js","contents_url":"https://api.github.com/repos/MikeyPetrillo/Agent402/contents/src%2Ftools%2Fchain-kit.js?ref=81a674d1a3cf7fdbbcc04f4da366c144ccd393f7","patch":"@@ -843,7 +843,7 @@ export const CHAIN_TOOLS = [\n     category: \"crypto\",\n     price: \"$0.001\",\n     description:\n-      \"One-call chain state snapshot: chain id, latest block number, and current gas price (wei + gwei) for Ethereum, Base, Polygon, Arbitrum, or Optimism. Keyless multi-endpoint failover. ?network=base\",\n+      \"Chain info in one call: chain id, gas price (wei and gwei) and the current block for Ethereum, Base, Polygon, Arbitrum, or Optimism, as chainId, latestBlock, gasPriceWei and gasPriceGwei. Keyless multi-endpoint failover. ?network=base\",\n     tags: [\"crypto\", \"chain\", \"info\", \"chainid\", \"gas\", \"price\", \"block\", \"rpc\", \"evm\"],\n     discovery: {\n       input: { network: \"base\" },"},{"sha":"4b13a470692bc60a63f573dd0abd42fde5a3f69f","filename":"src/tools/contract-kit.js","status":"modified","additions":1,"deletions":1,"changes":2,"blob_url":"https://github.com/MikeyPetrillo/Agent402/blob/81a674d1a3cf7fdbbcc04f4da366c144ccd393f7/src%2Ftools%2Fcontract-kit.js","raw_url":"https://github.com/MikeyPetrillo/Agent402/raw/81a674d1a3cf7fdbbcc04f4da366c144ccd393f7/src%2Ftools%2Fcontract-kit.js","contents_url":"https://api.github.com/repos/MikeyPetrillo/Agent402/contents/src%2Ftools%2Fcontract-kit.js?ref=81a674d1a3cf7fdbbcc04f4da366c144ccd393f7","patch":"@@ -918,7 +918,7 @@ export const CONTRACT_TOOLS = [\n     category: \"crypto\",\n     price: \"$0.005\",\n     description:\n-      \"Dry-run a prospective smart-contract call or transaction without broadcasting it: executes eth_call and eth_estimateGas against the latest block over the same keyless multi-endpoint public RPC pool as /api/evm-rpc (ethereum, base, polygon, arbitrum, optimism). Returns the return data and a gas estimate on success, or {success:false} with the revert reason when the call would fail. Strictly read-only - nothing is signed or broadcast.\",\n+      \"Simulate a transaction before sending it: a dry run of a smart-contract call that executes eth_call and eth_estimateGas against the latest block over a keyless multi-endpoint public node pool. Returns the return data and a gas estimate on success, or {success:false} with the revert reason when the call would fail. Strictly read-only - nothing is signed or broadcast.\",\n     tags: [\"crypto\", \"simulation\", \"eth_call\", \"gas\", \"transaction\", \"evm\", \"dry-run\", \"smart-contract\"],\n     discovery: {\n       bodyType: \"json\","},{"sha":"ecbbc541fa1f0414e6dd408fb9b31c20e2a162d5","filename":"src/tools/crypto-kit.js","status":"modified","additions":1,"deletions":1,"changes":2,"blob_url":"https://github.com/MikeyPetrillo/Agent402/blob/81a674d1a3cf7fdbbcc04f4da366c144ccd393f7/src%2Ftools%2Fcrypto-kit.js","raw_url":"https://github.com/MikeyPetrillo/Agent402/raw/81a674d1a3cf7fdbbcc04f4da366c144ccd393f7/src%2Ftools%2Fcrypto-kit.js","contents_url":"https://api.github.com/repos/MikeyPetrillo/Agent402/contents/src%2Ftools%2Fcrypto-kit.js?ref=81a674d1a3cf7fdbbcc04f4da366c144ccd393f7","patch":"@@ -326,7 +326,7 @@ export const CRYPTO_TOOLS = [\n     category: \"data\",\n     price: \"$0.015\",\n     description:\n-      \"Historical price, market cap, and volume time series for a coin. Granularity is automatic: <=1 day = 5-min bars, 2-90 days = hourly, >90 days = daily. Days: 1, 7, 14, 30, 90, 180, 365, or \\\"max\\\". Returns aligned arrays of {time, price, marketCap, volume}.\",\n+      \"Crypto price chart series over a window of days: bars[] of {time, price, marketCap, volume} for charts and backtests. Granularity is automatic: <=1 day = 5-min bars, 2-90 days = hourly, >90 days = daily. Days: 1, 7, 14, 30, 90, 180, 365, or \\\"max\\\".\",\n     tags: [\"crypto\", \"history\", \"chart\", \"backtest\", \"timeseries\"],\n     discovery: {\n       input: { coin: \"BTC\", days: \"7\", currency: \"usd\" },"},{"sha":"4a07a5b14ea2c18c6c5ca83631d261aa2c843a54","filename":"src/tools/crypto-markets-kit.js","status":"modified","additions":1,"deletions":1,"changes":2,"blob_url":"https://github.com/MikeyPetrillo/Agent402/blob/81a674d1a3cf7fdbbcc04f4da366c144ccd393f7/src%2Ftools%2Fcrypto-markets-kit.js","raw_url":"https://github.com/MikeyPetrillo/Agent402/raw/81a674d1a3cf7fdbbcc04f4da366c144ccd393f7/src%2Ftools%2Fcrypto-markets-kit.js","contents_url":"https://api.github.com/repos/MikeyPetrillo/Agent402/contents/src%2Ftools%2Fcrypto-markets-kit.js?ref=81a674d1a3cf7fdbbcc04f4da366c144ccd393f7","patch":"@@ -1059,7 +1059,7 @@ const RWA_TOOLS = [\n     category: \"crypto\",\n     price: \"$0.006\",\n     description:\n-      \"Market data for tokenized real-world assets - tokenized stocks (Nvidia, Tesla, pre-IPO names), ETFs and commodities like gold - ranked by market cap or volume: price, market cap, 24h volume, 24h high/low and change, in your currency. Filter by type or a list of ids. Note these are the ONCHAIN wrappers' figures (what is tokenized and trading), not the underlying's exchange listing. Cached in-process for 60 seconds.\",\n+      \"Live market rows for tokenized real-world assets (stocks, ETFs and commodities such as gold), ranked by market cap or volume a page at a time: price, market cap, 24h volume, 24h high and low and change, in your currency. Filter by type or pass ids. Figures are the onchain wrappers' markets (what is tokenized and trading), not the underlying's exchange listing. Cached in-process for 60 seconds.\",\n     tags: [\"crypto\", \"rwa\", \"tokenized\", \"stocks\", \"etf\", \"commodities\", \"market-data\", \"price\"],\n     discovery: {\n       input: { type: \"stock\", order: \"market_cap_desc\", perPage: 10 },"},{"sha":"f910bdaa082bef36688283f1053d2f4fefd6124d","filename":"src/tools/domain-audit-kit.js","status":"modified","additions":2,"deletions":2,"changes":4,"blob_url":"https://github.com/MikeyPetrillo/Agent402/blob/81a674d1a3cf7fdbbcc04f4da366c144ccd393f7/src%2Ftools%2Fdomain-audit-kit.js","raw_url":"https://github.com/MikeyPetrillo/Agent402/raw/81a674d1a3cf7fdbbcc04f4da366c144ccd393f7/src%2Ftools%2Fdomain-audit-kit.js","contents_url":"https://api.github.com/repos/MikeyPetrillo/Agent402/contents/src%2Ftools%2Fdomain-audit-kit.js?ref=81a674d1a3cf7fdbbcc04f4da366c144ccd393f7","patch":"@@ -454,14 +454,14 @@ const OUT_EXAMPLE = {\n export const DOMAIN_AUDIT_TOOLS = [\n   {\n     route: \"POST /v1/domain-audit\", name: \"Domain security & deliverability audit (graded)\", slug: \"domain-audit\", category: \"llm\", price: DOMAIN_AUDIT_TIERS[\"domain-audit\"].price,\n-    description: \"Hand over a domain and get one graded security & email-deliverability audit: SPF, DMARC, DKIM and MX (why your mail lands in spam), the web security headers, and the TLS certificate - every finding from a live probe, with an overall letter grade, a downloadable checks appendix, and a prioritized, specific list of fixes. USDC (x402/MPP) or card (Stripe). Not cached.\",\n+    description: \"Hand over a domain and get one graded, model-backed security & email-deliverability audit: SPF, DMARC, DKIM and MX (why your mail lands in spam), the web security headers, and the TLS certificate - every finding from a live probe, with an overall letter grade, a downloadable checks appendix, and a prioritized, specific list of fixes. USDC (x402/MPP) or card (Stripe). Not cached.\",\n     tags: [\"security\", \"domain\", \"email\", \"deliverability\", \"spf\", \"dmarc\", \"dkim\", \"tls\", \"headers\", \"audit\", \"premium\", \"agent\"],\n     discovery: { bodyType: \"json\", input: { domain: \"example.com\" }, inputSchema: SCHEMA, output: { example: OUT_EXAMPLE } },\n     handler: makeDomainAuditHandler(\"domain-audit\"),\n   },\n   {\n     route: \"POST /v1/domain-audit/pro\", name: \"Domain security audit - PRO (attack surface + stack)\", slug: \"domain-audit-pro\", category: \"llm\", price: DOMAIN_AUDIT_TIERS[\"domain-audit-pro\"].price,\n-    description: \"The deeper tier: everything in the standard audit plus the attack surface from Certificate Transparency logs (subdomains), the detected tech stack, and domain registration, in a longer graded report with a fuller remediation plan. USDC or card (Stripe). Not cached.\",\n+    description: \"The deeper tier (model-backed): everything in the standard audit plus the attack surface from Certificate Transparency logs (subdomains), the detected tech stack, and domain registration, in a longer graded report with a fuller remediation plan. USDC or card (Stripe). Not cached.\",\n     tags: [\"security\", \"domain\", \"email\", \"deliverability\", \"attack-surface\", \"subdomains\", \"tls\", \"audit\", \"premium\", \"agent\"],\n     discovery: { bodyType: \"json\", input: { domain: \"example.com\" }, inputSchema: SCHEMA, output: { example: { ...OUT_EXAMPLE, meta: { ...OUT_EXAMPLE.meta, tier: \"domain-audit-pro\" } } } },\n     handler: makeDomainAuditHandler(\"domain-audit-pro\"),"},{"sha":"b62cc90a8aa937580260891d49542a771da7dff6","filename":"src/tools/dossier-kit.js","status":"modified","additions":1,"deletions":1,"changes":2,"blob_url":"https://github.com/MikeyPetrillo/Agent402/blob/81a674d1a3cf7fdbbcc04f4da366c144ccd393f7/src%2Ftools%2Fdossier-kit.js","raw_url":"https://github.com/MikeyPetrillo/Agent402/raw/81a674d1a3cf7fdbbcc04f4da366c144ccd393f7/src%2Ftools%2Fdossier-kit.js","contents_url":"https://api.github.com/repos/MikeyPetrillo/Agent402/contents/src%2Ftools%2Fdossier-kit.js?ref=81a674d1a3cf7fdbbcc04f4da366c144ccd393f7","patch":"@@ -484,7 +484,7 @@ export const DOSSIER_TOOLS = [\n   },\n   {\n     route: \"POST /v1/dossier/max\", name: \"Company due-diligence dossier - MAX (exhaustive)\", slug: \"dossier-max\", category: \"llm\", price: DOSSIER_TIERS[\"dossier-max\"].price,\n-    description: \"The exhaustive due-diligence tier: more filings, a full year of Form 4 insider activity, wider web research (up to 8 angles), the widest source set, and a ~2,800-word cited dossier with a full source table. For a decision that warrants real diligence. USDC or card (Stripe). Not cached.\",\n+    description: \"The exhaustive due-diligence tier (model-backed): more filings, a full year of Form 4 insider activity, wider web research (up to 8 angles), the widest source set, and a ~2,800-word cited dossier with a full source table. For a decision that warrants real diligence. USDC or card (Stripe). Not cached.\",\n     tags: [\"research\", \"due-diligence\", \"company\", \"sec\", \"edgar\", \"filings\", \"insider\", \"stocks\", \"dossier\", \"premium\", \"agent\"],\n     discovery: { bodyType: \"json\", input: { ticker: \"AAPL\", focus: [\"debt\", \"litigation\"] }, inputSchema: SCHEMA, output: { example: { ...OUT_EXAMPLE, meta: { ...OUT_EXAMPLE.meta, tier: \"dossier-max\" } } } },\n     handler: makeDossierHandler(\"dossier-max\"),"},{"sha":"55863c937596c340779502e48b7aba5ac47bf857","filename":"src/tools/filing-watch-kit.js","status":"modified","additions":1,"deletions":1,"changes":2,"blob_url":"https://github.com/MikeyPetrillo/Agent402/blob/81a674d1a3cf7fdbbcc04f4da366c144ccd393f7/src%2Ftools%2Ffiling-watch-kit.js","raw_url":"https://github.com/MikeyPetrillo/Agent402/raw/81a674d1a3cf7fdbbcc04f4da366c144ccd393f7/src%2Ftools%2Ffiling-watch-kit.js","contents_url":"https://api.github.com/repos/MikeyPetrillo/Agent402/contents/src%2Ftools%2Ffiling-watch-kit.js?ref=81a674d1a3cf7fdbbcc04f4da366c144ccd393f7","patch":"@@ -830,7 +830,7 @@ export const FILING_WATCH_TOOLS = [\n     slug: \"filing-report\",\n     category: \"llm\",\n     price: FILING_TIERS[\"filing-report\"].price,\n-    description: \"Name a US ticker and get one cited report on what the company just filed with the SEC: every filing in EDGAR's index for the window (8-K, 10-Q, 10-K, S-1, 424B4, DEF 14A and the rest, minus any form you exclude), the primary documents of the most consequential ones read in full and explained in plain language, and what changed versus the prior period where the filing itself says so, with a downloadable filings appendix. Not investment advice. Not cached.\",\n+    description: \"Name a US ticker and get one cited, model-backed report on what the company just filed with the SEC: every filing in EDGAR's index for the window (8-K, 10-Q, 10-K, S-1, 424B4, DEF 14A and the rest, minus any form you exclude), the primary documents of the most consequential ones read in full and explained in plain language, and what changed versus the prior period where the filing itself says so, with a downloadable filings appendix. Not investment advice. Not cached.\",\n     tags: [\"sec\", \"edgar\", \"filings\", \"8-k\", \"10-q\", \"10-k\", \"s-1\", \"proxy\", \"report\", \"equity\", \"agentic-finance\", \"x402\", \"mpp\"],\n     discovery: { bodyType: \"json\", input: { ticker: \"AAPL\", days: 30 }, inputSchema: SCHEMA, output: { example: OUT_EXAMPLE } },\n     handler: makeFilingHandler(\"filing-report\"),"},{"sha":"712295bc851b8b519c77eb990f4ecc0fd0de7358","filename":"src/tools/finance-math-kit.js","status":"modified","additions":1,"deletions":1,"changes":2,"blob_url":"https://github.com/MikeyPetrillo/Agent402/blob/81a674d1a3cf7fdbbcc04f4da366c144ccd393f7/src%2Ftools%2Ffinance-math-kit.js","raw_url":"https://github.com/MikeyPetrillo/Agent402/raw/81a674d1a3cf7fdbbcc04f4da366c144ccd393f7/src%2Ftools%2Ffinance-math-kit.js","contents_url":"https://api.github.com/repos/MikeyPetrillo/Agent402/contents/src%2Ftools%2Ffinance-math-kit.js?ref=81a674d1a3cf7fdbbcc04f4da366c144ccd393f7","patch":"@@ -511,7 +511,7 @@ export const FINANCE_MATH_TOOLS = [\n   // --- Bond price from yield -------------------------------------------------\n   {\n     route: \"POST /api/bond-price\", name: \"Bond price\", slug: \"bond-price\", category: \"data\", price: \"$0.001\",\n-    description: \"Price a fixed-coupon bond from its yield to maturity: present-value the coupons plus face. Returns clean price, coupon per period, current yield, and premium/discount vs par.\",\n+    description: \"Price a fixed-coupon bond at a required annual rate: present-values the coupons plus face, given yieldToMaturity as a decimal. Returns price, coupon per period, periods, currentYield, and premium, discount or par.\",\n     tags: [\"finance\", \"bond\", \"fixed-income\", \"price\", \"ytm\", \"present-value\"],\n     discovery: {\n       bodyType: \"json\","},{"sha":"ed29b315df5faa8ae932ca252a1c500e01e2c81d","filename":"src/tools/fund-report-kit.js","status":"modified","additions":1,"deletions":1,"changes":2,"blob_url":"https://github.com/MikeyPetrillo/Agent402/blob/81a674d1a3cf7fdbbcc04f4da366c144ccd393f7/src%2Ftools%2Ffund-report-kit.js","raw_url":"https://github.com/MikeyPetrillo/Agent402/raw/81a674d1a3cf7fdbbcc04f4da366c144ccd393f7/src%2Ftools%2Ffund-report-kit.js","contents_url":"https://api.github.com/repos/MikeyPetrillo/Agent402/contents/src%2Ftools%2Ffund-report-kit.js?ref=81a674d1a3cf7fdbbcc04f4da366c144ccd393f7","patch":"@@ -275,7 +275,7 @@ export const FUND_TOOLS = [\n   },\n   {\n     route: \"POST /v1/fund/max\", name: \"Fund portfolio report - MAX (deep)\", slug: \"fund-report-max\", category: \"llm\", price: FUND_TIERS[\"fund-report-max\"].price,\n-    description: \"The deep tier: the full holdings table, wider quarter-over-quarter change analysis, more grounded web research, and a longer cited report on the manager's positioning. USDC or card (Stripe). Not cached.\",\n+    description: \"The deep tier (model-backed): the full holdings table, wider quarter-over-quarter change analysis, more grounded web research, and a longer cited report on the manager's positioning. USDC or card (Stripe). Not cached.\",\n     tags: [\"research\", \"13f\", \"fund\", \"institutional\", \"holdings\", \"sec\", \"edgar\", \"portfolio\", \"hedge-fund\", \"premium\", \"agent\"],\n     discovery: { bodyType: \"json\", input: { manager: \"Scion Asset Management\" }, inputSchema: SCHEMA, output: { example: { ...OUT_EXAMPLE, meta: { ...OUT_EXAMPLE.meta, tier: \"fund-report-max\" } } } },\n     handler: makeFundHandler(\"fund-report-max\"),"},{"sha":"2ac64243c345125ca845dfbcc349c0d9a6ef856a","filename":"src/tools/insider-flow-kit.js","status":"modified","additions":1,"deletions":1,"changes":2,"blob_url":"https://github.com/MikeyPetrillo/Agent402/blob/81a674d1a3cf7fdbbcc04f4da366c144ccd393f7/src%2Ftools%2Finsider-flow-kit.js","raw_url":"https://github.com/MikeyPetrillo/Agent402/raw/81a674d1a3cf7fdbbcc04f4da366c144ccd393f7/src%2Ftools%2Finsider-flow-kit.js","contents_url":"https://api.github.com/repos/MikeyPetrillo/Agent402/contents/src%2Ftools%2Finsider-flow-kit.js?ref=81a674d1a3cf7fdbbcc04f4da366c144ccd393f7","patch":"@@ -312,7 +312,7 @@ const OUT_EXAMPLE = {\n export const INSIDER_TOOLS = [\n   {\n     route: \"POST /v1/insider-report\", name: \"Insider flow report (Form 4 transactions)\", slug: \"insider-report\", category: \"llm\", price: INSIDER_TIERS[\"insider-report\"].price,\n-    description: \"Name a US ticker and get one cited insider-flow report: every Form 4 against the company in the window with the actual transactions parsed from the filings - open-market buys and sales (who, when, how much, at what price) separated from awards, option exercises and tax withholding - aggregated per insider and as a net flow, with a grounded signal read and a downloadable transactions appendix. SEC EDGAR data, not investment advice. USDC (x402/MPP) or card (Stripe). Not cached.\",\n+    description: \"Name a US ticker and get one cited, model-backed insider-flow report: every Form 4 against the company in the window with the actual transactions parsed from the filings - open-market buys and sales (who, when, how much, at what price) separated from awards, option exercises and tax withholding - aggregated per insider and as a net flow, with a grounded signal read and a downloadable transactions appendix. SEC EDGAR data, not investment advice. USDC (x402/MPP) or card (Stripe). Not cached.\",\n     tags: [\"insider\", \"form-4\", \"sec\", \"edgar\", \"trades\", \"officers\", \"directors\", \"report\", \"equity\", \"agentic-finance\", \"x402\", \"mpp\"],\n     discovery: { bodyType: \"json\", input: { ticker: \"AAPL\", days: 90 }, inputSchema: SCHEMA, output: { example: OUT_EXAMPLE } },\n     handler: makeInsiderHandler(\"insider-report\"),"},{"sha":"0069acaf855ff7ec8a7ac15c90cf93229e4182ae","filename":"src/tools/kit.js","status":"modified","additions":3,"deletions":3,"changes":6,"blob_url":"https://github.com/MikeyPetrillo/Agent402/blob/81a674d1a3cf7fdbbcc04f4da366c144ccd393f7/src%2Ftools%2Fkit.js","raw_url":"https://github.com/MikeyPetrillo/Agent402/raw/81a674d1a3cf7fdbbcc04f4da366c144ccd393f7/src%2Ftools%2Fkit.js","contents_url":"https://api.github.com/repos/MikeyPetrillo/Agent402/contents/src%2Ftools%2Fkit.js?ref=81a674d1a3cf7fdbbcc04f4da366c144ccd393f7","patch":"@@ -382,7 +382,7 @@ const encodingTools = [\n     slug: \"uuid\", aliases: [\"unique-id\", \"unique-identifiers\", \"time-ordered-id\", \"sortable-id\", \"uuid-v7\", \"timestamp-id\", \"embedded-timestamp\"],\n     category: \"identifiers\",\n     price: \"$0.001\",\n-    description: \"Generate UUIDs: returns version and uuids[] (lowercase, hyphenated). ?version=4 (default, random) or 7 (time-ordered, sortable by creation time - the better choice for database keys), ?count=1..100.\",\n+    description: \"Generate UUIDs, the standard unique identifier format: returns version and uuids[] (lowercase, hyphenated). ?version=4 (default) or 7 (time-ordered, sortable by creation time - the better choice for database keys), ?count=1..100.\",\n     tags: [\"uuid\", \"id\", \"identifier\", \"unique\", \"generator\"],\n     discovery: {\n       input: { version: \"7\", count: \"3\" },\n@@ -426,7 +426,7 @@ const encodingTools = [\n     slug: \"password\", aliases: [\"join-code\", \"invite-code\", \"one-time-code\", \"random-code\"],\n     category: \"identifiers\",\n     price: \"$0.001\",\n-    description: \"Generate cryptographically random passwords. ?length=8..128 (default 24), ?symbols=true|false (default true), ?count=1..20.\",\n+    description: \"Generate passwords from a cryptographically secure source: letters and digits plus symbols (on by default), returned as passwords[] with their entropyBits. ?length=8..128 (default 24), ?symbols=true|false, ?count=1..20.\",\n     tags: [\"password\", \"random\", \"generator\", \"security\"],\n     discovery: {\n       input: { length: \"32\", symbols: \"true\", count: \"1\" },\n@@ -2339,7 +2339,7 @@ const networkTools = [\n     slug: \"robots-check\",\n     category: \"network\",\n     price: \"$0.001\",\n-    description: \"Fetch a site's robots.txt and answer: may this user-agent crawl this path? Returns the matched rule and all declared sitemaps.\",\n+    description: \"Check one URL against its robots.txt: answers allowed true or false for a user-agent (default *), with the Allow or Disallow rule that decided it and the sitemaps the file declares. Reads only robots.txt.\",\n     tags: [\"robots\", \"crawling\", \"scraping\", \"compliance\"],\n     discovery: {\n       bodyType: \"json\","},{"sha":"a61e5ce9d72d11d41d6c4f4af92b58d1df9681da","filename":"src/tools/kit2.js","status":"modified","additions":5,"deletions":5,"changes":10,"blob_url":"https://github.com/MikeyPetrillo/Agent402/blob/81a674d1a3cf7fdbbcc04f4da366c144ccd393f7/src%2Ftools%2Fkit2.js","raw_url":"https://github.com/MikeyPetrillo/Agent402/raw/81a674d1a3cf7fdbbcc04f4da366c144ccd393f7/src%2Ftools%2Fkit2.js","contents_url":"https://api.github.com/repos/MikeyPetrillo/Agent402/contents/src%2Ftools%2Fkit2.js?ref=81a674d1a3cf7fdbbcc04f4da366c144ccd393f7","patch":"@@ -167,7 +167,7 @@ const encoding = [\n   },\n   {\n     route: \"POST /api/crc32\", name: \"CRC32\", slug: \"crc32\", category: \"encoding\", price: \"$0.001\",\n-    description: \"CRC-32 checksum of a text string (hex), the IEEE polynomial used by zip/png/gzip.\",\n+    description: \"CRC32 checksum of a text string with the standard IEEE polynomial: returns hex and the unsigned integer. Detects accidental changes in data; a checksum, not a secure digest.\",\n     tags: [\"crc32\", \"checksum\", \"hash\"],\n     discovery: { bodyType: \"json\", input: { text: \"hello world\" }, inputSchema: { properties: { text: { type: \"string\" } }, required: [\"text\"] }, output: { example: { hex: \"0d4a1185\", uint: 222957957 } } },\n     handler: (i) => {\n@@ -420,7 +420,7 @@ const text = [\n   },\n   {\n     route: \"POST /api/readability\", name: \"Readability\", slug: \"readability\", category: \"text\", price: \"$0.001\",\n-    description: \"Flesch Reading Ease score and Flesch–Kincaid grade level for English text, plus word/sentence/syllable counts.\",\n+    description: \"Flesch Reading Ease and Flesch-Kincaid grade level for English text, the two classic readability numbers, with word, sentence and syllable counts.\",\n     tags: [\"readability\", \"flesch\", \"nlp\", \"text\"],\n     discovery: { bodyType: \"json\", input: { text: \"The cat sat on the mat. It was warm.\" }, inputSchema: { properties: { text: { type: \"string\" } }, required: [\"text\"] }, output: { example: { readingEase: 100, gradeLevel: 0.5, words: 9, sentences: 2 } } },\n     handler: (i) => {\n@@ -539,7 +539,7 @@ const conversion = [\n   },\n   {\n     route: \"POST /api/querystring\", name: \"Query string\", slug: \"querystring\", category: \"conversion\", price: \"$0.001\",\n-    description: \"Parse a URL query string into an object, or build one from an object. mode: parse (default) | build.\",\n+    description: \"Querystring parse and build: turn a=1&b=2 text into an object (a repeated key becomes an array), or build querystring text from an object. mode: parse (default) | build. Takes the query part alone, with or without a leading ?.\",\n     tags: [\"querystring\", \"url\", \"parse\", \"convert\"],\n     discovery: { bodyType: \"json\", input: { value: \"a=1&b=hello%20world&a=2\", mode: \"parse\" }, inputSchema: { properties: { value: { description: \"String to parse or object to build\" }, mode: { type: \"string\", description: \"parse | build\" } }, required: [\"value\"] }, output: { example: { result: { a: [\"1\", \"2\"], b: \"hello world\" } } } },\n     handler: (i) => {\n@@ -1081,7 +1081,7 @@ const math = [\n   },\n   {\n     route: \"POST /api/stats\", name: \"Statistics\", slug: \"stats\", category: \"math\", price: \"$0.001\",\n-    description: \"Descriptive statistics for an array of numbers: count, sum, mean, median, mode, min, max, range, variance, stddev, and percentiles.\",\n+    description: \"Stats with percentile cut points for an array of numbers: p25, p50, p75, p90, p95 and p99, plus count, sum, mean, median, mode, min, max, range, and population variance and stddev.\",\n     tags: [\"stats\", \"mean\", \"median\", \"stddev\", \"percentile\"],\n     discovery: { bodyType: \"json\", input: { numbers: [2, 4, 4, 4, 5, 5, 7, 9] }, inputSchema: { properties: { numbers: { description: \"Array of numbers\" } }, required: [\"numbers\"] }, output: { example: { count: 8, mean: 5, median: 4.5, stddev: 2 } } },\n     handler: (i) => {\n@@ -1193,7 +1193,7 @@ const math = [\n   },\n   {\n     route: \"POST /api/finance\", name: \"Finance\", slug: \"finance\", category: \"math\", price: \"$0.001\",\n-    description: 'Financial math. op: \"compound\" (future value of principal at a rate) or \"loan\" (monthly payment + total for a loan).',\n+    description: 'Two finance formulas behind one op switch: op \"compound\" returns the future value and interest of a principal at an annual rate (monthly compounding by default); op \"loan\" returns the monthly payment, total paid and total interest of a fixed-rate loan.',\n     tags: [\"finance\", \"interest\", \"loan\", \"compound\", \"money\"],\n     discovery: { bodyType: \"json\", input: { op: \"loan\", principal: 20000, annualRatePct: 6, months: 60 }, inputSchema: { properties: { op: { type: \"string\", description: \"compound | loan\" }, principal: { type: \"number\" }, annualRatePct: { type: \"number\" }, months: { type: \"number\" }, years: { type: \"number\" }, compoundsPerYear: { type: \"number\" } }, required: [\"op\", \"principal\", \"annualRatePct\"] }, output: { example: { monthlyPayment: 386.66, totalPaid: 23199.36, totalInterest: 3199.36 } } },\n     handler: (i) => {"},{"sha":"7735575d8bcee32bf60227eb4cac6c05aebc1d7e","filename":"src/tools/llm-gateway-kit.js","status":"modified","additions":5,"deletions":9,"changes":14,"blob_url":"https://github.com/MikeyPetrillo/Agent402/blob/81a674d1a3cf7fdbbcc04f4da366c144ccd393f7/src%2Ftools%2Fllm-gateway-kit.js","raw_url":"https://github.com/MikeyPetrillo/Agent402/raw/81a674d1a3cf7fdbbcc04f4da366c144ccd393f7/src%2Ftools%2Fllm-gateway-kit.js","contents_url":"https://api.github.com/repos/MikeyPetrillo/Agent402/contents/src%2Ftools%2Fllm-gateway-kit.js?ref=81a674d1a3cf7fdbbcc04f4da366c144ccd393f7","patch":"@@ -335,8 +335,7 @@ export const TIERS = {\n       // from OpenRouter entirely (verified against the live models list).\n       // gemini-2.5-flash-lite left 2026-09-29 (upstream expiration 2026-10-20): served by its successor via RETIRING_MODELS.\n       \"google/gemini-3.1-flash-lite\", // inside this tier's max_price\n-      // inception/mercury-2.5: served as itself until its upstream expiration on 2026-11-08 (its whole family), then by gemini-3.1-flash-lite (RETIRING_MODELS, scheduled). In no ranking, fallback or default; this prefix goes on that day.\n-      \"inception/mercury-2.5\",\n+      // inception/mercury-2.5 left 2026-11-08 (upstream expiration): served by gemini-3.1-flash-lite via RETIRING_MODELS.\n       \"meta-llama/llama-3.2-1b-instruct\", \"meta-llama/llama-3.2-3b-instruct\",\n       // ministral-3b/8b were renamed upstream to the -2512 ids (the bare ids\n       // 404 at OpenRouter; live-verified 2026-08-19). Listed with the live id so\n@@ -823,10 +822,10 @@ export const RETIRING_MODELS = Object.freeze({\n   \"poolside/laguna-xs-2.1\": { until: \"2026-10-31\", use: \"mistralai/ministral-3b-2512\" },\n   \"poolside/laguna-s-2.1\": { until: \"2026-10-31\", use: \"mistralai/ministral-8b-2512\" },\n   // Mercury 2.5 (OpenRouter expiration_date 2026-11-08, as for every model of\n-  // its family, so none is a successor). SCHEDULED: it left the fast band\n-  // 2026-11-04 and is served as itself on the tiers that admit it until that\n-  // day, then by the fast band's other budget link on nano.\n-  \"inception/mercury-2.5\": { until: \"2026-11-08\", use: \"google/gemini-3.1-flash-lite\", asItselfUntil: true },\n+  // its family, so none is a successor). It left the fast band 2026-11-04 and\n+  // every tier list on its expiration; a call naming it is served by the fast\n+  // band's other budget link on nano.\n+  \"inception/mercury-2.5\": { until: \"2026-11-08\", use: \"google/gemini-3.1-flash-lite\" },\n   // Claude Sonnet 4 (OpenRouter expiration_date 2026-10-15). The pro tier's\n   // family prefix still admits the id; its successor is the same family's\n   // current model, priced below it.\n@@ -2453,9 +2452,6 @@ export const REASONING_MODELS = [\n   // default_enabled for it: `adaptive` tells the live guard so). The budget\n   // tiers inject \"low\", pro \"low\".\n   { id: \"anthropic/claude-haiku-5.5\", efforts: [\"low\", \"medium\", \"high\", \"xhigh\", \"max\"], adaptive: true },\n-  // Mercury 2.5: reasoning default-on at medium, \"none\" supported (live 2026-09-29).\n-  // Kept while the id is served as itself (scheduled retirement, 2026-11-08).\n-  { id: \"inception/mercury-2.5\", efforts: [\"none\", \"low\", \"medium\", \"high\"] },\n   { id: \"anthropic/claude-opus-5\", efforts: [\"low\", \"medium\", \"high\", \"xhigh\", \"max\"] },\n   // Claude Opus 5.5: reasoning MANDATORY, default effort high (live catalog\n   // 2026-09-24). Same treatment as opus-5: premium leaves the model default,"},{"sha":"12b95bae00df1bf0c6c0cb82fbb6bb3ccccbb8f4","filename":"src/tools/llm-images-fast-kit.js","status":"modified","additions":1,"deletions":1,"changes":2,"blob_url":"https://github.com/MikeyPetrillo/Agent402/blob/81a674d1a3cf7fdbbcc04f4da366c144ccd393f7/src%2Ftools%2Fllm-images-fast-kit.js","raw_url":"https://github.com/MikeyPetrillo/Agent402/raw/81a674d1a3cf7fdbbcc04f4da366c144ccd393f7/src%2Ftools%2Fllm-images-fast-kit.js","contents_url":"https://api.github.com/repos/MikeyPetrillo/Agent402/contents/src%2Ftools%2Fllm-images-fast-kit.js?ref=81a674d1a3cf7fdbbcc04f4da366c144ccd393f7","patch":"@@ -675,7 +675,7 @@ export const IMAGES_FAST_TOOLS = [\n     category: \"llm\",\n     price: \"$0.020\",\n     description:\n-      `Edit an image with a prompt over x402 - OpenAI images.edit wire (reference images and a prompt in, inline base64 out) at $0.02 per picture. Send one to ${IMAGE_EDIT_MAX_REFS} PNG or JPEG reference images (${IMAGE_EDIT_MIN_SIDE} px a side or more, up to ${IMAGE_EDIT_MAX_REF_BYTES / 1048576} MB each) as base64 or data: URLs in JSON, or one as a multipart \"image\" file; the output is one JPEG of about one megapixel that follows the first reference's aspect ratio. Served by FLUX 3 Image Klein in about 10 seconds. No mask: describe the change in the prompt. n locked to 1; a failed generation is not charged on x402. Point any OpenAI SDK's images.edit() at base_url https://agent402.tools/v1.`,\n+      `Edit an image with a prompt (model-backed) over x402 - OpenAI images.edit wire (reference images and a prompt in, inline base64 out) at $0.02 per picture. Send one to ${IMAGE_EDIT_MAX_REFS} PNG or JPEG reference images (${IMAGE_EDIT_MIN_SIDE} px a side or more, up to ${IMAGE_EDIT_MAX_REF_BYTES / 1048576} MB each) as base64 or data: URLs in JSON, or one as a multipart \"image\" file; the output is one JPEG of about one megapixel that follows the first reference's aspect ratio. Served by FLUX 3 Image Klein in about 10 seconds. No mask: describe the change in the prompt. n locked to 1; a failed generation is not charged on x402. Point any OpenAI SDK's images.edit() at base_url https://agent402.tools/v1.`,\n     tags: [\"image-edit\", \"edit-image\", \"images\", \"image-to-image\", \"inpainting\", \"retouch\", \"photo-edit\", \"flux\", \"klein\", ...SHARED_TAGS],\n     discovery: {\n       bodyType: \"json\","},{"sha":"3f1e2c0cf0401f80dea8da08b9ccaa92af68240d","filename":"src/tools/macro-kit.js","status":"modified","additions":1,"deletions":1,"changes":2,"blob_url":"https://github.com/MikeyPetrillo/Agent402/blob/81a674d1a3cf7fdbbcc04f4da366c144ccd393f7/src%2Ftools%2Fmacro-kit.js","raw_url":"https://github.com/MikeyPetrillo/Agent402/raw/81a674d1a3cf7fdbbcc04f4da366c144ccd393f7/src%2Ftools%2Fmacro-kit.js","contents_url":"https://api.github.com/repos/MikeyPetrillo/Agent402/contents/src%2Ftools%2Fmacro-kit.js?ref=81a674d1a3cf7fdbbcc04f4da366c144ccd393f7","patch":"@@ -309,7 +309,7 @@ export const MACRO_TOOLS = [\n   {\n     route: \"GET /api/treasury-yield-history\", name: \"US Treasury yield history\", slug: \"treasury-yield-history\", category: \"data\", price: \"$0.005\",\n     description:\n-      \"Last N business days of US Treasury constant-maturity yields, oldest→newest. Source: FRED DGS* series (St. Louis Fed), public domain. ?days=30 (1-250, default 30).\",\n+      \"Daily history of US Treasury constant-maturity yields over the last N business days, oldest first: one row per day with recordDate and each maturity's yield in percent. Source: FRED DGS* series (St. Louis Fed), public domain. ?days=30 (1-250, default 30).\",\n     tags: [\"treasury\", \"yield-curve\", \"history\", \"interest-rates\", \"rates\", \"macro\", \"bonds\", \"time-series\"],\n     discovery: {\n       input: { days: 30 },"},{"sha":"af84435222296538434410dc6e7b904045776aa9","filename":"src/tools/recall-report-kit.js","status":"modified","additions":1,"deletions":1,"changes":2,"blob_url":"https://github.com/MikeyPetrillo/Agent402/blob/81a674d1a3cf7fdbbcc04f4da366c144ccd393f7/src%2Ftools%2Frecall-report-kit.js","raw_url":"https://github.com/MikeyPetrillo/Agent402/raw/81a674d1a3cf7fdbbcc04f4da366c144ccd393f7/src%2Ftools%2Frecall-report-kit.js","contents_url":"https://api.github.com/repos/MikeyPetrillo/Agent402/contents/src%2Ftools%2Frecall-report-kit.js?ref=81a674d1a3cf7fdbbcc04f4da366c144ccd393f7","patch":"@@ -223,7 +223,7 @@ const OUT_EXAMPLE = {\n export const RECALL_TOOLS = [\n   {\n     route: \"POST /v1/recall-report\", name: \"FDA recall report (drug, food, device)\", slug: \"recall-report\", category: \"llm\", price: RECALL_TIERS[\"recall-report\"].price,\n-    description: \"Name a drug, food, ingredient, brand or medical device and get one cited FDA recall report: every matching enforcement record across the drug, food and device feeds (firm, class I/II/III, status, reason, distribution, date), organized and explained, with a downloadable records appendix. Live openFDA data, not medical advice. USDC (x402/MPP) or card (Stripe). Not cached.\",\n+    description: \"Name a drug, food, ingredient, brand or medical device and get one cited, model-backed FDA recall report: every matching enforcement record across the drug, food and device feeds (firm, class I/II/III, status, reason, distribution, date), organized and explained, with a downloadable records appendix. Live openFDA data, not medical advice. USDC (x402/MPP) or card (Stripe). Not cached.\",\n     tags: [\"fda\", \"recall\", \"drug\", \"food\", \"device\", \"safety\", \"report\", \"openfda\", \"research\", \"agentic-finance\", \"x402\", \"mpp\"],\n     discovery: { bodyType: \"json\", input: { query: \"losartan\" }, inputSchema: SCHEMA, output: { example: OUT_EXAMPLE } },\n     handler: makeRecallHandler(\"recall-report\"),"},{"sha":"aa977817aab791290330a34b5d39a27649350220","filename":"src/tools/research-deep-kit.js","status":"modified","additions":1,"deletions":1,"changes":2,"blob_url":"https://github.com/MikeyPetrillo/Agent402/blob/81a674d1a3cf7fdbbcc04f4da366c144ccd393f7/src%2Ftools%2Fresearch-deep-kit.js","raw_url":"https://github.com/MikeyPetrillo/Agent402/raw/81a674d1a3cf7fdbbcc04f4da366c144ccd393f7/src%2Ftools%2Fresearch-deep-kit.js","contents_url":"https://api.github.com/repos/MikeyPetrillo/Agent402/contents/src%2Ftools%2Fresearch-deep-kit.js?ref=81a674d1a3cf7fdbbcc04f4da366c144ccd393f7","patch":"@@ -333,7 +333,7 @@ export const RESEARCH_DEEP_TOOLS = [\n   },\n   {\n     route: \"POST /v1/research/market-brief\", name: \"Market / competitor brief (grounded)\", slug: \"market-brief\", category: \"llm\", price: RESEARCH_TIERS[\"market-brief\"].price,\n-    description: \"Name a market, category or company and get one cited MARKET / COMPETITOR BRIEF: how the market is defined and sized, the key players and what each offers, pricing, recent moves, how they differ, risks and a bottom line - every claim from live web research with citations, nothing from memory. The research pipeline with a competitive-intelligence plan. USDC (x402/MPP) or card (Stripe). Not cached.\",\n+    description: \"Name a market, category or company and get one cited, model-backed MARKET / COMPETITOR BRIEF: how the market is defined and sized, the key players and what each offers, pricing, recent moves, how they differ, risks and a bottom line - every claim from live web research with citations, nothing from memory. The research pipeline with a competitive-intelligence plan. USDC (x402/MPP) or card (Stripe). Not cached.\",\n     tags: [\"llm\", \"research\", \"web-search\", \"grounded\", \"citations\", \"deep-research\", \"agent\", \"premium\"],\n     discovery: { bodyType: \"json\", input: EXAMPLE, inputSchema: SCHEMA, output: { example: { ...OUT_EXAMPLE, meta: { ...OUT_EXAMPLE.meta, tier: \"market-brief\", synthesis_model: \"anthropic/claude-opus-5\" } } } },\n     handler: makeResearchHandler(\"market-brief\"),"},{"sha":"1d93ff5f47c7ad218ab8c78a6b753c0671981fb4","filename":"src/tools/route-execute.js","status":"modified","additions":17,"deletions":12,"changes":29,"blob_url":"https://github.com/MikeyPetrillo/Agent402/blob/81a674d1a3cf7fdbbcc04f4da366c144ccd393f7/src%2Ftools%2Froute-execute.js","raw_url":"https://github.com/MikeyPetrillo/Agent402/raw/81a674d1a3cf7fdbbcc04f4da366c144ccd393f7/src%2Ftools%2Froute-execute.js","contents_url":"https://api.github.com/repos/MikeyPetrillo/Agent402/contents/src%2Ftools%2Froute-execute.js?ref=81a674d1a3cf7fdbbcc04f4da366c144ccd393f7","patch":"@@ -30,11 +30,13 @@ import { observeDelivery } from \"../response-observation.js\";\n import { isIdentityBoundRoute } from \"../payments.js\";\n import { evmCredentialBudgetMs, evmCredentialSettleableMs, evmSellerSignBy, EVM_SELLER_ALLOWANCE_MS } from \"../evm-validity.js\";\n import { cdnSyncLeftMs } from \"../cdn-sync-window.js\";\n+import { PAY_X402_TIMEOUT_MS } from \"../buyer-timeouts.js\";\n import { spendsBeforeSettlement } from \"../composite-spend-guard.js\";\n import { upstreamBuyerStatus, evmBuyerChainStatus } from \"../upstream-buyer-status.js\";\n import { EVM_BUYER_CHAINS, EVM_BUYER_CHAIN_BY_NETWORK, isEvmBuyerChain, evmBuyerChainEnabled, enabledEvmBuyerChains } from \"../evm-buyer-chains.js\";\n import { recordRouterPurchase } from \"../router-purchases.js\";\n import { adaptParamsToExample } from \"../mpp-input-examples.js\";\n+import { boundRequestUrl, isQueryMethod, BOUND_URL_MAX_CHARS } from \"../bound-request-url.js\";\n \n // The external leg's default budget for a Solana payer: the short end of a\n // recent blockhash's life (about 60 s, the figure src/solana-buyer.js waits\n@@ -435,7 +437,7 @@ export function buildRouteExecuteTool({ getCatalog, baseUrl = \"\", tier = EXEC_TI\n       let target = null;\n       if (input.target != null) {\n         if (input.include !== \"external\") throw bad('\"target\" applies only with include:\"external\"');\n-        try { const u = new URL(String(input.target)); if (u.protocol !== \"https:\" || String(input.target).length > 2048) throw 0; target = u.href; }\n+        try { const u = new URL(String(input.target)); if (u.protocol !== \"https:\" || String(input.target).length > BOUND_URL_MAX_CHARS) throw 0; target = u.href; }\n         catch { throw bad('\"target\" must be one https URL from the index'); }\n       }\n \n@@ -534,6 +536,9 @@ export function buildRouteExecuteTool({ getCatalog, baseUrl = \"\", tier = EXEC_TI\n           // Through the CDN proxy the answer must also start inside the\n           // proxy's wait (src/cdn-sync-window.js); a shorter wait keeps the\n           // hold, as above, so the nearer bound is money-safe.\n+          // Through the CDN the seller call shares that wait too: past it the\n+          // proxy has cut the connection and an answer reaches nobody, so the\n+          // payer's own timeout is narrowed to what is left (never under 3 s).\n           const cdnLeftMs = cdnSyncLeftMs(req);\n           const externalDeadlineMs = cdnLeftMs != null ? Math.max(0, Math.min(ownDeadlineMs, cdnLeftMs - 5_000)) : ownDeadlineMs;\n           const refusalBudgetMs = () => Math.max(0, externalDeadlineMs - (Date.now() - startedAt));\n@@ -567,7 +572,7 @@ export function buildRouteExecuteTool({ getCatalog, baseUrl = \"\", tier = EXEC_TI\n           const wantModel = typeof input.params?.model === \"string\" && input.params.model.trim() ? input.params.model.trim() : null;\n           let candidateList = []; let chain = chains[0]; let lastDrops = null;\n           for (const c of chains) {\n-            const found = await resolveExternal(input.task, { cap, baseUrl, chain: c, limit: MAX_CANDIDATES, wantModel, ...(target ? { onlyUrl: target } : {}) });\n+            const found = await resolveExternal(input.task, { cap, baseUrl, chain: c, limit: MAX_CANDIDATES, wantModel, params, ...(target ? { onlyUrl: target } : {}) });\n             const list = Array.isArray(found) ? found : (found ? [found] : []);\n             // Keep the tally from the LAST chain tried even when it resolved\n             // nothing, or an all-empty run would report no reason at all.\n@@ -600,6 +605,10 @@ export function buildRouteExecuteTool({ getCatalog, baseUrl = \"\", tier = EXEC_TI\n           if (!candidateList.length && excludedOut > 0) {\n             throw bad(`${excludedOut} outside route(s) matched that task on ${chain}, and the router does not buy them: routes that sell personal data about individuals are listed but not bought by the router. Nothing was spent and nothing is charged.`, 404);\n           }\n+          // Every GET candidate the caller's params cannot ride a query to\n+          // (a nested value, an oversized URL) was set aside before its probe:\n+          // the caller's input, said as the builder words it.\n+          if (!candidateList.length && Number(drops.byReason?.params_unbindable || 0) > 0 && drops.paramsRefusal) throw bad(drops.paramsRefusal, 400);\n           if (!candidateList.length) throw bad(`No external ${chains.includes(\"tempo\") && chains.length > 1 ? \"x402 or MPP\" : chains[0] === \"tempo\" ? \"MPP\" : \"x402\"} seller matched that task${chains[0] !== \"base\" || chains.length > 1 ? ` on ${chains.join(\"/\")}` : \"\"}. Explore /api/route?q=<task>&include=external.`, 404);\n           // Nothing is signed from an EVM wallet that reads low on the chain it\n           // would pay from (a cached reading, never awaited on the network).\n@@ -652,15 +661,11 @@ export function buildRouteExecuteTool({ getCatalog, baseUrl = \"\", tier = EXEC_TI\n             const shaped = adaptParamsToExample(params, ext.inputExample);\n             if (shaped.adapted.length) { extBody = shaped.params; paramsAdapted = shaped.adapted; }\n           }\n-          if (extMethod === \"GET\" || extMethod === \"HEAD\") {\n-            const qp = new URLSearchParams();\n-            for (const [k, v] of Object.entries(params || {})) {\n-              if (v == null) continue;\n-              if (typeof v === \"object\") throw bad(`External tool \"${ext.slug}\" is a ${extMethod} endpoint - param \"${k}\" must be a string, number, or boolean`, 400);\n-              qp.set(k, String(v));\n-            }\n-            const qs = qp.toString();\n-            extUrl = qs ? `${ext.url}${ext.url.includes(\"?\") ? \"&\" : \"?\"}${qs}` : ext.url;\n+          // The resolver probed this same URL (src/bound-request-url.js), so\n+          // the seller that answered 402 to the caller's query is the one paid\n+          // at it.\n+          if (isQueryMethod(extMethod)) {\n+            extUrl = boundRequestUrl(ext.url, { method: extMethod, params, slug: ext.slug });\n             extBody = undefined;\n           }\n           // AN EVM BUYER'S AUTHORIZATION MUST STILL SETTLE AFTER THE SELLER\n@@ -757,7 +762,7 @@ export function buildRouteExecuteTool({ getCatalog, baseUrl = \"\", tier = EXEC_TI\n               throw lastErr || bad(`Tried ${__paidAttempts} paid seller(s) for this task without a delivered answer. Refusing to sign another payment for one request.`, 502);\n             }\n             traceStep(req, \"attempt\", { origin: ext.seller, lane: ext.unproven ? \"unproven\" : \"proven\" });\n-            paid = await payExternal(extUrl, { method: extMethod, body: extBody, maxAtomic: BigInt(Math.round(cap * 1e6)), chain, provenPayTo: ext.provenPayTo || null, evidenceWallets: ext.evidenceWallets || null, allowUnproven: ext.unproven === true, ...(ext.unproven === true && ext.seller ? { sellerKey: ext.seller } : {}), refusalMaxWaitMs: refusalBudgetMs(), ...(tempoBudgetMs == null && evmSellerSignBy(req) != null ? { signBy: evmSellerSignBy(req) } : {}), ...(windowBudgetMs != null ? { timeoutMs: Math.max(3000, remainingMs()) } : {}) });\n+            paid = await payExternal(extUrl, { method: extMethod, body: extBody, maxAtomic: BigInt(Math.round(cap * 1e6)), chain, provenPayTo: ext.provenPayTo || null, evidenceWallets: ext.evidenceWallets || null, allowUnproven: ext.unproven === true, ...(ext.unproven === true && ext.seller ? { sellerKey: ext.seller } : {}), refusalMaxWaitMs: refusalBudgetMs(), ...(tempoBudgetMs == null && evmSellerSignBy(req) != null ? { signBy: evmSellerSignBy(req) } : {}), ...(windowBudgetMs != null ? { timeoutMs: Math.max(3000, remainingMs()) } : cdnLeftMs != null ? { timeoutMs: Math.max(3000, Math.min(PAY_X402_TIMEOUT_MS, refusalBudgetMs())) } : {}) });\n           } catch (e) {\n             // WHAT STAYS BOOKED IS WHAT MAY HAVE LEFT THE WALLET. The payer\n             // stamps `committed:true` on every failure after the payment"},{"sha":"2a35ec9a1549f73ee0f9ffc9550cb24d958b4961","filename":"src/tools/search.js","status":"modified","additions":1,"deletions":1,"changes":2,"blob_url":"https://github.com/MikeyPetrillo/Agent402/blob/81a674d1a3cf7fdbbcc04f4da366c144ccd393f7/src%2Ftools%2Fsearch.js","raw_url":"https://github.com/MikeyPetrillo/Agent402/raw/81a674d1a3cf7fdbbcc04f4da366c144ccd393f7/src%2Ftools%2Fsearch.js","contents_url":"https://api.github.com/repos/MikeyPetrillo/Agent402/contents/src%2Ftools%2Fsearch.js?ref=81a674d1a3cf7fdbbcc04f4da366c144ccd393f7","patch":"@@ -507,7 +507,7 @@ export const SEARCH_TOOLS = [\n     category: \"web\",\n     price: \"$0.02\",\n     description:\n-      \"Live image search: ranked image results (title, source page, image URL, thumbnail URL, dimensions) from an independent search index as clean JSON. Strict safe-search is on by default.\",\n+      \"Search the web for images by text query: up to 50 ranked results, each with title, source page URL, full-size image URL, a reduced-size copy URL and pixel width and height, from an independent search index as clean JSON. Strict safe-search is on by default.\",\n     tags: [\"search\", \"images\", \"visual\", \"research\"],\n     discovery: {\n       input: { q: \"san francisco golden gate bridge sunset\", count: 5 },"},{"sha":"6ff56ed06ec16277e8fe6888074a4f458d477dab","filename":"src/tools/skill-runner.js","status":"modified","additions":11,"deletions":5,"changes":16,"blob_url":"https://github.com/MikeyPetrillo/Agent402/blob/81a674d1a3cf7fdbbcc04f4da366c144ccd393f7/src%2Ftools%2Fskill-runner.js","raw_url":"https://github.com/MikeyPetrillo/Agent402/raw/81a674d1a3cf7fdbbcc04f4da366c144ccd393f7/src%2Ftools%2Fskill-runner.js","contents_url":"https://api.github.com/repos/MikeyPetrillo/Agent402/contents/src%2Ftools%2Fskill-runner.js?ref=81a674d1a3cf7fdbbcc04f4da366c144ccd393f7","patch":"@@ -306,7 +306,7 @@ export const PACK_STEPS = {\n       { slug: \"stock-history\",       mapInput: (a) => ({ symbol: a.ticker, days: sessionsFor(\"1y\") }) },\n       { slug: \"edgar-filings\",       mapInput: (a) => ({ ticker: a.ticker }) },\n       { slug: \"edgar-company-facts\", mapInput: (a) => ({ ticker: a.ticker }) },\n-      { slug: \"edgar-insider-trades\", mapInput: (a) => ({ ticker: a.ticker, lookbackDays: 90 }) },\n+      { slug: \"edgar-insider-trades\", mapInput: (a) => ({ ticker: a.ticker, days: 90 }) },\n       // FRED needs an explicit series id - fed funds is the default macro\n       // signal. The key is `seriesId`; this sent `series`, so the step 400'd\n       // on every call (2 of 2 in 60 days of telemetry).\n@@ -1120,7 +1120,7 @@ export const PACK_STEPS = {\n       { slug: \"stock-quote\",          mapInput: (a) => ({ symbol: a.ticker }) },\n       { slug: \"company-financials\",   mapInput: (a) => ({ ticker: a.ticker }) },\n       { slug: \"edgar-filings\",        mapInput: (a) => ({ ticker: a.ticker, limit: 5 }) },\n-      { slug: \"edgar-insider-trades\", mapInput: (a) => ({ ticker: a.ticker, lookbackDays: 90 }) },\n+      { slug: \"edgar-insider-trades\", mapInput: (a) => ({ ticker: a.ticker, days: 90 }) },\n       { slug: \"search\",               mapInput: (a) => ({ q: `${a.ticker} company news`, count: 5, freshness: \"pm\" }) },\n     ],\n   },\n@@ -1279,7 +1279,7 @@ export const PACK_STEPS = {\n   \"insider-alert\": {\n     mode: \"fanout\",\n     steps: [\n-      { slug: \"edgar-insider-trades\", mapInput: (a) => ({ ticker: a.ticker, lookbackDays: 30 }) },\n+      { slug: \"edgar-insider-trades\", mapInput: (a) => ({ ticker: a.ticker, days: 30 }) },\n       { slug: \"stock-quote\",          mapInput: (a) => ({ symbol: a.ticker }) },\n       { slug: \"edgar-filings\",        mapInput: (a) => ({ ticker: a.ticker, limit: 3 }) },\n     ],\n@@ -1354,12 +1354,18 @@ export const PACK_STEPS = {\n   },\n \n   // Wallet audit: balance + transactions + token metadata.\n+  // Chain: token metadata is read for a token the wallet holds (the balance\n+  // step's first token contract), never for the wallet address itself.\n   \"wallet-audit\": {\n-    mode: \"fanout\",\n+    mode: \"chain\",\n     steps: [\n       { slug: \"wallet-balance\",      mapInput: (a) => ({ address: a.address, network: \"base\" }) },\n       { slug: \"wallet-transactions\", mapInput: (a) => ({ address: a.address, network: \"base\" }) },\n-      { slug: \"token-metadata\",      mapInput: (a) => ({ contractAddress: a.address, network: \"base\" }) },\n+      { slug: \"token-metadata\",      mapInput: (_a, p) => {\n+          const contract = p[\"wallet-balance\"]?.tokens?.[0]?.contract;\n+          if (!contract) throw Object.assign(new Error(\"the wallet holds no tokens to look up\"), { statusCode: 422 });\n+          return { contract, network: \"base\" };\n+      } },\n     ],\n   },\n "},{"sha":"da866e641d9c02cc4488895c068f0d32dd15299e","filename":"src/tools/stt-kit.js","status":"modified","additions":1,"deletions":1,"changes":2,"blob_url":"https://github.com/MikeyPetrillo/Agent402/blob/81a674d1a3cf7fdbbcc04f4da366c144ccd393f7/src%2Ftools%2Fstt-kit.js","raw_url":"https://github.com/MikeyPetrillo/Agent402/raw/81a674d1a3cf7fdbbcc04f4da366c144ccd393f7/src%2Ftools%2Fstt-kit.js","contents_url":"https://api.github.com/repos/MikeyPetrillo/Agent402/contents/src%2Ftools%2Fstt-kit.js?ref=81a674d1a3cf7fdbbcc04f4da366c144ccd393f7","patch":"@@ -401,7 +401,7 @@ export const STT_TOOLS = [\n     category: \"ai\",\n     price: \"$0.100\",\n     description:\n-      \"Transcribe audio to text with the gpt-transcribe model - the same model as /api/transcribe with a longer cap. Provide a URL to an audio file and get back the transcript; add diarize:true for speaker labels, word timestamps and a language confidence score (the scribe-v2 model). No API key needed; pay per call via x402. Max 10 minutes of audio, 25 MB file size.\",\n+      \"Pro tier for longer recordings (model-backed, gpt-transcribe, the same model as the standard tier): transcribes an audio file at a URL. Max 10 minutes and 25 MB, the longer cap of the transcribe routes. Returns the transcript text, language and duration; diarize:true adds speaker labels, word timestamps and a language confidence score. No API key needed; pay per call via x402.\",\n     tags: [...SHARED_TAGS, \"gpt-transcribe\", \"pro\"],\n     discovery: {\n       bodyType: \"json\","},{"sha":"4648f233909740becd0559bf10e156a384fa0e5b","filename":"src/tools/ticker-pack-kit.js","status":"modified","additions":1,"deletions":1,"changes":2,"blob_url":"https://github.com/MikeyPetrillo/Agent402/blob/81a674d1a3cf7fdbbcc04f4da366c144ccd393f7/src%2Ftools%2Fticker-pack-kit.js","raw_url":"https://github.com/MikeyPetrillo/Agent402/raw/81a674d1a3cf7fdbbcc04f4da366c144ccd393f7/src%2Ftools%2Fticker-pack-kit.js","contents_url":"https://api.github.com/repos/MikeyPetrillo/Agent402/contents/src%2Ftools%2Fticker-pack-kit.js?ref=81a674d1a3cf7fdbbcc04f4da366c144ccd393f7","patch":"@@ -945,7 +945,7 @@ export const TICKER_PACK_TOOLS = [\n     slug: \"ticker-pack\",\n     category: \"llm\",\n     price: TICKER_PACK_TIERS[\"ticker-pack\"].price,\n-    description: \"One ticker, one purchase, the full picture. Runs the company due-diligence dossier (SEC filings, XBRL financials, grounded web research), the Form 4 insider-flow report with the actual transactions parsed, and a 13F institutional-holder sample read live off SEC EDGAR full-text search, then stitches them into ONE cited report: company, filings, insider flow, institutional holders and what to check next, with a merged source list and downloadable data appendices. Cheaper than buying the parts separately. SEC EDGAR data, not investment advice. USDC (x402/MPP) or card (Stripe). Not cached.\",\n+    description: \"One ticker, one purchase, the full picture (model-backed). Runs the company due-diligence dossier (SEC filings, XBRL financials, grounded web research), the Form 4 insider-flow report with the actual transactions parsed, and a 13F institutional-holder sample read live off SEC EDGAR full-text search, then stitches them into ONE cited report: company, filings, insider flow, institutional holders and what to check next, with a merged source list and downloadable data appendices. Cheaper than buying the parts separately. SEC EDGAR data, not investment advice. USDC (x402/MPP) or card (Stripe). Not cached.\",\n     tags: [\"research\", \"due-diligence\", \"bundle\", \"sec\", \"edgar\", \"13f\", \"holders\", \"insider\", \"form-4\", \"stocks\", \"premium\", \"agentic-finance\", \"agent\"],\n     discovery: { bodyType: \"json\", input: { ticker: \"AAPL\", days: 90 }, inputSchema: SCHEMA, output: { example: OUT_EXAMPLE } },\n     handler: makeTickerPackHandler(\"ticker-pack\"),"},{"sha":"ef995e61ef1ce4b9c16858e217ed4114c871b051","filename":"src/tools/token-risk-kit.js","status":"modified","additions":2,"deletions":2,"changes":4,"blob_url":"https://github.com/MikeyPetrillo/Agent402/blob/81a674d1a3cf7fdbbcc04f4da366c144ccd393f7/src%2Ftools%2Ftoken-risk-kit.js","raw_url":"https://github.com/MikeyPetrillo/Agent402/raw/81a674d1a3cf7fdbbcc04f4da366c144ccd393f7/src%2Ftools%2Ftoken-risk-kit.js","contents_url":"https://api.github.com/repos/MikeyPetrillo/Agent402/contents/src%2Ftools%2Ftoken-risk-kit.js?ref=81a674d1a3cf7fdbbcc04f4da366c144ccd393f7","patch":"@@ -362,14 +362,14 @@ const OUT_EXAMPLE = {\n export const TOKEN_RISK_TOOLS = [\n   {\n     route: \"POST /v1/token-risk\", name: \"Token & contract risk report (on-chain evidence)\", slug: \"token-risk\", category: \"llm\", price: TOKEN_RISK_TIERS[\"token-risk\"].price,\n-    description: \"Hand over a token contract address (and chain) and get one evidence-based on-chain risk report: whether the source is verified, holder concentration (top-1 / top-10 share of supply, distinguishing pools/contracts from wallets), and supply + market context, with a top-holders appendix. Evidence, never a 'safe' or 'scam' verdict - on-chain checks can't see off-chain rugs, so a clean report is not an endorsement. USDC (x402/MPP). Not cached.\",\n+    description: \"Hand over a token contract address (and chain) and get one evidence-based, model-backed on-chain risk report: whether the source is verified, holder concentration (top-1 / top-10 share of supply, distinguishing pools/contracts from wallets), and supply + market context, with a top-holders appendix. Evidence, never a 'safe' or 'scam' verdict - on-chain checks can't see off-chain rugs, so a clean report is not an endorsement. USDC (x402/MPP). Not cached.\",\n     tags: [\"crypto\", \"token\", \"risk\", \"rug\", \"holders\", \"concentration\", \"contract\", \"verified-source\", \"onchain\", \"agent\", \"premium\"],\n     discovery: { bodyType: \"json\", input: { address: \"0x4200000000000000000000000000000000000006\", chain: \"base\" }, inputSchema: SCHEMA, output: { example: OUT_EXAMPLE } },\n     handler: makeTokenRiskHandler(\"token-risk\"),\n   },\n   {\n     route: \"POST /v1/token-risk/pro\", name: \"Token & contract risk report - PRO (static scan + reputation)\", slug: \"token-risk-pro\", category: \"llm\", price: TOKEN_RISK_TIERS[\"token-risk-pro\"].price,\n-    description: \"The deeper tier: everything in the standard report plus a deterministic static-pattern scan of the verified source (tx.origin auth, delegatecall, selfdestruct, unchecked calls, reentrancy surface, etc. - heuristic triage, not a formal audit) and a web reputation check. Still evidence, never a verdict. USDC (x402/MPP). Not cached.\",\n+    description: \"The deeper tier (model-backed): everything in the standard report plus a deterministic static-pattern scan of the verified source (tx.origin auth, delegatecall, selfdestruct, unchecked calls, reentrancy surface, etc. - heuristic triage, not a formal audit) and a web reputation check. Still evidence, never a verdict. USDC (x402/MPP). Not cached.\",\n     tags: [\"crypto\", \"token\", \"risk\", \"rug\", \"static-analysis\", \"solidity\", \"reputation\", \"contract\", \"onchain\", \"agent\", \"premium\"],\n     discovery: { bodyType: \"json\", input: { address: \"0x4200000000000000000000000000000000000006\", chain: \"base\" }, inputSchema: SCHEMA, output: { example: { ...OUT_EXAMPLE, meta: { ...OUT_EXAMPLE.meta, tier: \"token-risk-pro\" } } } },\n     handler: makeTokenRiskHandler(\"token-risk-pro\"),"},{"sha":"c3faa222c61fec46ece1474ce79f14ca81f7fb7b","filename":"src/unpaid-quote-budget.js","status":"modified","additions":106,"deletions":26,"changes":132,"blob_url":"https://github.com/MikeyPetrillo/Agent402/blob/81a674d1a3cf7fdbbcc04f4da366c144ccd393f7/src%2Funpaid-quote-budget.js","raw_url":"https://github.com/MikeyPetrillo/Agent402/raw/81a674d1a3cf7fdbbcc04f4da366c144ccd393f7/src%2Funpaid-quote-budget.js","contents_url":"https://api.github.com/repos/MikeyPetrillo/Agent402/contents/src%2Funpaid-quote-budget.js?ref=81a674d1a3cf7fdbbcc04f4da366c144ccd393f7","patch":"@@ -28,9 +28,11 @@\n // never by the User-Agent they send. Fixed UTC-hour windows: the 429 says\n // exactly when the count resets.\n // Never counted: our own signed probes, /mcp and the MCP connector's own\n-// loopback, the discovery surfaces, any route that is not priced, a client\n-// that has already settled a payment this hour, and every request under\n-// FREE_MODE (the server does not mount this there).\n+// loopback, the discovery surfaces, any route that is not priced, and every\n+// request under FREE_MODE (the server does not mount this there). A client\n+// that paid recently (settled a payment this hour, or a paid call inside the\n+// paid-quote trust window) is counted on its own count against\n+// PAID_CLIENT_QUOTE_MULTIPLIER times the budget.\n // Memory is bounded: at most `keyCap` keys, least recently seen dropped first.\n // Counted in THIS process: like every limiter in src/rate-limit.js the budget\n // is divided by RATE_LIMIT_REPLICAS (perReplica), so two containers enforce\n@@ -50,10 +52,28 @@ import { DISCOVERY_PATHS, indexerFor, uaToken } from \"./traffic-classifier.js\";\n import { limiterKey, perReplica } from \"./rate-limit.js\";\n import { cacheGet, cacheSet, cacheEnabled } from \"./cache.js\";\n import { decodesAsMppCredential, decodesAsX402Payment } from \"./payment-attempt.js\";\n-import { createHash } from \"node:crypto\";\n+import { createHmac, randomBytes } from \"node:crypto\";\n import { isMcpLoopback } from \"./mcp-loopback.js\";\n \n export const DEFAULT_UNPAID_QUOTE_BUDGET_PER_HOUR = 3000;\n+// The metered gateway's own unpaid-quote limiter (server.js, /v1/metered): an\n+// unpaid request there tokenizes the body for its quote, so each client address\n+// gets this many unpaid quotes a minute and an hour. A request carrying a\n+// plausible payment is not counted. Exported so the buying-at-volume guide\n+// quotes the figures the limiter enforces.\n+export const METERED_UNPAID_QUOTES_PER_MIN = 60;\n+export const METERED_UNPAID_QUOTES_PER_HOUR = 1200;\n+// A client that paid recently (settled a payment this hour, or a paid call\n+// inside src/paid-quote-trust.js's window) reads against this many times each\n+// unpaid-quote figure: the price-check budget's hourly figure and the metered\n+// limiter's per-minute and per-hour ones. A stock client quotes before every\n+// paid call, so the plain figure capped a paying buyer near that many paid\n+// calls, so a recently paid address gets a raised ceiling, not an unlimited\n+// one. Named here so the limiters and the buying-at-volume guide read one\n+// figure.\n+export const PAID_CLIENT_QUOTE_MULTIPLIER = 10;\n+export const PAID_CLIENT_METERED_QUOTES_PER_MIN = METERED_UNPAID_QUOTES_PER_MIN * PAID_CLIENT_QUOTE_MULTIPLIER;\n+export const PAID_CLIENT_METERED_QUOTES_PER_HOUR = METERED_UNPAID_QUOTES_PER_HOUR * PAID_CLIENT_QUOTE_MULTIPLIER;\n export const UNPAID_QUOTE_BUDGET_KEY_CAP = 20_000;\n // A self-declared named indexer or crawler reads against this many times the\n // budget, on the same per-address count as everything else from that address.\n@@ -210,30 +230,55 @@ export const secondsToHourBoundary = (now = Date.now()) => Math.max(1, Math.ceil\n  * @param {() => number} [o.now]\n  * @param {(line:string) => void} [o.log]\n  */\n+// The digest a \"paid recently\" record is stored under in the shared store\n+// (this hour's settled flag below, src/paid-quote-trust.js's window): a keyed\n+// HMAC of the client key, never the address and never a plain hash, which a\n+// brute force over the IPv4 space reverses. The key is the same stable secret\n+// src/hangup-forgiveness.js digests under (HANGUP_FORGIVE_SALT, else\n+// POW_SECRET, else MPP_SECRET_KEY), shared by every replica; with none set a\n+// per-process secret still works on this process, and another replica then\n+// reads not paid (it limits normally). Records written under the earlier\n+// plain digest are not read: they expire within the hour.\n+let quoteDigestProcessSecret = null;\n+function quoteDigestSecret(env = process.env) {\n+  const s = String(env.HANGUP_FORGIVE_SALT || env.POW_SECRET || env.MPP_SECRET_KEY || \"\").trim();\n+  if (s) return s;\n+  if (!quoteDigestProcessSecret) quoteDigestProcessSecret = randomBytes(32).toString(\"hex\");\n+  return quoteDigestProcessSecret;\n+}\n+/** The keyed digest of a client key for the shared \"paid recently\" records. */\n+export function quoteKeyDigest(key, env = process.env) {\n+  return createHmac(\"sha256\", quoteDigestSecret(env)).update(`unpaid-quote:${String(key)}`).digest(\"hex\").slice(0, 32);\n+}\n+\n // Which clients have paid this hour, shared by every container through the\n-// Redis cache (src/cache.js). Keys are a digest of the client address (the\n-// budget's key) plus the hour, never the address itself, and expire with the hour. Without\n-// Redis there is no shared record and each container keeps its own, as before.\n+// Redis cache (src/cache.js). Keys are a keyed digest of the client address\n+// (the budget's key, quoteKeyDigest) plus the hour, never the address itself,\n+// and expire with the hour. Without Redis there is no shared record and each\n+// container keeps its own, as before.\n export function redisSharedSettled(now = Date.now) {\n   if (!cacheEnabled()) return null;\n-  const slot = (key) => `a402:uqb:${createHash(\"sha256\").update(String(key)).digest(\"hex\").slice(0, 32)}:${Math.floor(now() / HOUR_MS)}`;\n+  const slot = (key) => `a402:uqb:${quoteKeyDigest(key)}:${Math.floor(now() / HOUR_MS)}`;\n   return {\n     mark: (key) => { void cacheSet(slot(key), 1, 3600); },\n     has: async (key) => (await cacheGet(slot(key))) !== null,\n   };\n }\n \n-export function createUnpaidQuoteBudget({ budget, isPriced, isSynthetic = () => false, policyUrl = \"/crawler\", keyCap = UNPAID_QUOTE_BUDGET_KEY_CAP, now = Date.now, log = console.warn, replicas = null , sharedSettled = null} = {}) {\n+export function createUnpaidQuoteBudget({ budget, isPriced, isSynthetic = () => false, policyUrl = \"/crawler\", keyCap = UNPAID_QUOTE_BUDGET_KEY_CAP, now = Date.now, log = console.warn, replicas = null, sharedSettled = null, paidTrust = null } = {}) {\n   // `published` is the configured, system-wide figure; `limit` is this\n   // process's share of it (RATE_LIMIT_REPLICAS, or `replicas` when given).\n   const published = Number(budget) || 0;\n   const share = (n) => (replicas == null ? perReplica(n) : Math.max(1, Math.floor(n / Math.max(1, Number(replicas) || 1))));\n   const limit = published > 0 ? share(published) : 0;\n   const namedLimit = published > 0 ? share(published * NAMED_CLIENT_BUDGET_MULTIPLIER) : 0;\n+  // A client that paid recently reads against a raised ceiling, never none.\n+  const paidLimit = published > 0 ? share(published * PAID_CLIENT_QUOTE_MULTIPLIER) : 0;\n+  const paidKeyOf = (key) => `${key}|paid`;\n   let hour = -1;\n   const counts = new Map();       // client address (IPv6 /64) -> requests this hour, least recently seen first\n   const logged = new Set();       // keys already logged as throttled this hour\n-  const settled = new Set();      // keys that settled a payment this hour\n+  const settled = new Set();      // keys that settled a payment this hour (they read against paidLimit)\n   let throttled = 0;\n \n   /** Windows are fixed UTC hours; everything keyed to one is dropped together. */\n@@ -255,12 +300,14 @@ export function createUnpaidQuoteBudget({ budget, isPriced, isSynthetic = () =>\n     return { limited: cap > 0 && n > cap, count: n, retryAfterSeconds: secondsToHourBoundary(t) };\n   }\n \n-  /** A client that settles a payment stops being counted for the rest of the\n-   *  hour. Every stock x402 purchase opens with an unpaid bare request (a spend\n-   *  cap adds a second, as a preflight), so a buyer spends this budget on its\n-   *  own purchases; past it the 429 would land on that bare request and the\n-   *  buyer would never see the 402 it came for. One settlement is proof this\n-   *  client is not the burst the budget is about. */\n+  /** A client that settles a payment reads against PAID_CLIENT_QUOTE_MULTIPLIER\n+   *  times the budget for the rest of the hour. Every stock x402 purchase\n+   *  opens with an unpaid bare request (a spend cap adds a second, as a\n+   *  preflight), so a buyer spends this budget on its own purchases; past it\n+   *  the 429 would land on that bare request and the buyer would never see\n+   *  the 402 it came for. One settlement is proof this client is not the\n+   *  burst the budget is about, but not a pass: the raised ceiling still\n+   *  bounds what one cheap settlement buys. */\n   function noteSettled(key, t = now()) {\n     if (!key) return;\n     rollover(t);\n@@ -312,19 +359,24 @@ export function createUnpaidQuoteBudget({ budget, isPriced, isSynthetic = () =>\n     let addressKey = null;\n     const named10 = (published * NAMED_CLIENT_BUDGET_MULTIPLIER).toLocaleString(\"en-US\");\n     const egressCeiling = (published * WORKER_EGRESS_ADDRESS_MULTIPLIER).toLocaleString(\"en-US\");\n+    const paidCeiling = (published * PAID_CLIENT_QUOTE_MULTIPLIER).toLocaleString(\"en-US\");\n     const refuse = () => {\n       throttled += 1;\n-      const logKey = scope === \"egress\" ? addressKey : key;\n+      const logKey = scope === \"egress\" ? addressKey : scope === \"paid\" ? paidKeyOf(key) : key;\n       if (!logged.has(logKey) && logged.size < UNPAID_QUOTE_BUDGET_LOG_CAP) {\n         logged.add(logKey);\n-        const line = scope === \"egress\"\n+        const line = scope === \"paid\"\n+          ? `[unpaid-budget] a client that paid recently (last User-Agent ${ua}) passed ${paidLimit} unpaid price checks from one address on this container this hour (raised ceiling ${paidCeiling} per hour); answering 429 until the hour turns`\n+          : scope === \"egress\"\n           ? `[unpaid-budget] the shared Worker egress address (last User-Agent ${ua}) passed ${limit * WORKER_EGRESS_ADDRESS_MULTIPLIER} unpaid price checks across every User-Agent on this container this hour (whole-address ceiling ${egressCeiling} per hour); answering 429 to every User-Agent there until the hour turns`\n           : scope === \"agent\"\n             ? `[unpaid-budget] a client on the shared Worker egress address (User-Agent ${ua}${named ? \", a self-declared named client\" : \"\"}) passed ${named ? namedLimit : limit} unpaid price checks on this container this hour (budget ${published} per hour per User-Agent there); answering 429 to that User-Agent until the hour turns`\n             : `[unpaid-budget] a client (last User-Agent ${ua}${named ? \", a self-declared named client\" : \"\"}) passed ${named ? namedLimit : limit} unpaid price checks from one address on this container this hour (budget ${published} per hour); answering 429 until the hour turns`;\n         try { log(line); } catch { /* logging never breaks a response */ }\n       }\n-      const rule = scope === \"egress\"\n+      const rule = scope === \"paid\"\n+        ? `Too many unpaid price checks from one address this hour (an address that paid recently reads against ${paidCeiling} per hour instead of ${published}).`\n+        : scope === \"egress\"\n         ? `Too many unpaid price checks from this shared Worker egress address this hour (ceiling ${egressCeiling} per hour for the whole address, across every User-Agent; each User-Agent there also has its own budget of ${published} per hour).`\n         : scope === \"agent\"\n           ? `Too many unpaid price checks from this User-Agent this hour (budget ${published} per hour per User-Agent from the shared Worker egress address, under a ceiling of ${egressCeiling} per hour for the whole address; a named indexer or search crawler reads against ${named10}).`\n@@ -334,10 +386,27 @@ export function createUnpaidQuoteBudget({ budget, isPriced, isSynthetic = () =>\n         ok: false,\n         error: \"rate-limited\",\n         reason: UNPAID_QUOTE_BUDGET_REASON,\n-        hint: `${rule} Every route and price is published at /.well-known/x402, /openapi.json and /api/pricing, and a request carrying a payment, a credits key or a proof-of-work solution is never counted. A client that settles a payment stops being counted for the rest of the hour. See ${policyUrl}`,\n+        hint: `${rule} Every route and price is published at /.well-known/x402, /openapi.json and /api/pricing, and a request carrying a payment, a credits key or a proof-of-work solution is never counted. A client that settles a payment reads against ${paidCeiling} per hour for the rest of the hour. See ${policyUrl}`,\n         retryAfterSeconds: verdict.retryAfterSeconds,\n       });\n     };\n+    // A recently paid client counts on its own raised ceiling. On the shared\n+    // Worker egress address its key is the address plus a User-Agent token any\n+    // Worker can send, so the whole address still counts against its ceiling:\n+    // the raised figure never lifts that address past WORKER_EGRESS_ADDRESS_MULTIPLIER\n+    // times the budget.\n+    const paidCount = () => {\n+      verdict = hit(paidKeyOf(key), now(), paidLimit);\n+      scope = \"paid\";\n+      if (!verdict.limited) {\n+        addressKey = workerEgressAddressKeyOf(req);\n+        if (addressKey) {\n+          const whole = hit(addressKey, now(), limit * WORKER_EGRESS_ADDRESS_MULTIPLIER);\n+          if (whole.limited) { verdict = whole; scope = \"egress\"; }\n+        }\n+      }\n+      return verdict.limited ? refuse() : next();\n+    };\n     try {\n       const path = normalizeCatalogPath(req.path);\n       if (!isCountablePath(req, path)) return next();\n@@ -346,10 +415,15 @@ export function createUnpaidQuoteBudget({ budget, isPriced, isSynthetic = () =>\n       // Armed on every request to a priced route, paid or not: the receipt goes\n       // out on the PAID retry, which carries a credential and is never counted.\n       if (!settled.has(key)) res.once?.(\"finish\", () => { if (hasSettlementReceipt(res)) noteSettled(key); });\n-      if (settled.has(key)) return next();\n       if (hasCredentialHeader(req.headers)) return next();\n       if (isMcpLoopback(req)) return next();\n       try { if (isSynthetic(req)) return next(); } catch { /* an unreadable token is not ours */ }\n+      // An address that settled a payment this hour, or a paid call in the\n+      // last few minutes (any rail, credits included; src/paid-quote-trust.js),\n+      // reads against the raised ceiling on its own count.\n+      let paidRecently = settled.has(key);\n+      if (!paidRecently) { try { paidRecently = Boolean(paidTrust?.trustedLocal?.(key)); } catch { paidRecently = false; } }\n+      if (paidRecently) return paidCount();\n       named = isNamedClientUserAgent(req.headers?.[\"user-agent\"]);\n       verdict = hit(key, now(), named ? namedLimit : limit);\n       // From the shared Worker egress address the whole address also counts,\n@@ -363,11 +437,16 @@ export function createUnpaidQuoteBudget({ budget, isPriced, isSynthetic = () =>\n       if (!verdict.limited) return next();\n     } catch { return next(); }\n     // About to refuse: this client may have paid on another container. The\n-    // shared check runs only here, on the rare refusal path.\n-    if (!sharedSettled?.has) return refuse();\n-    return Promise.resolve().then(() => sharedSettled.has(key)).catch(() => false).then((paidElsewhere) => {\n-      if (paidElsewhere) { noteSettled(key); return next(); }\n-      return refuse();\n+    // shared checks run only here, on the rare refusal path; a store that does\n+    // not answer reads as not paid.\n+    if (!sharedSettled?.has && !paidTrust?.trusted) return refuse();\n+    const paidElsewhere = () => (sharedSettled?.has ? Promise.resolve().then(() => sharedSettled.has(key)).catch(() => false) : Promise.resolve(false));\n+    const trustedElsewhere = () => (paidTrust?.trusted ? Promise.resolve().then(() => paidTrust.trusted(key)).catch(() => false) : Promise.resolve(false));\n+    // Paid elsewhere: counted against the raised ceiling instead.\n+    const paidPass = paidCount;\n+    return paidElsewhere().then((paid) => {\n+      if (paid) { noteSettled(key); return paidPass(); }\n+      return trustedElsewhere().then((t) => (t ? paidPass() : refuse()));\n     });\n   }\n \n@@ -380,6 +459,7 @@ export function createUnpaidQuoteBudget({ budget, isPriced, isSynthetic = () =>\n       budget: published,\n       perReplicaBudget: limit,\n       namedClientMultiplier: NAMED_CLIENT_BUDGET_MULTIPLIER,\n+      paidClientMultiplier: PAID_CLIENT_QUOTE_MULTIPLIER,\n       clientsThisHour: stale ? 0 : counts.size,\n       clientsSettledThisHour: stale ? 0 : settled.size,\n       clientsThrottledThisHour: stale ? 0 : logged.size,"},{"sha":"cd9e3185585910f4820b98d922d24917f854db0c","filename":"src/x402-buyer.js","status":"modified","additions":151,"deletions":10,"changes":161,"blob_url":"https://github.com/MikeyPetrillo/Agent402/blob/81a674d1a3cf7fdbbcc04f4da366c144ccd393f7/src%2Fx402-buyer.js","raw_url":"https://github.com/MikeyPetrillo/Agent402/raw/81a674d1a3cf7fdbbcc04f4da366c144ccd393f7/src%2Fx402-buyer.js","contents_url":"https://api.github.com/repos/MikeyPetrillo/Agent402/contents/src%2Fx402-buyer.js?ref=81a674d1a3cf7fdbbcc04f4da366c144ccd393f7","patch":"@@ -36,6 +36,8 @@ import { ALGORAND_MAINNET_CAIP2, ALGORAND_MAINNET_LEGACY_CAIP2, canonicalAvmNetw\n export const ROUTER_UA =\n   \"Mozilla/5.0 (compatible; Agent402-Router/1.0; +https://agent402.tools/crawler)\";\n import { recordOutbound } from \"./outbound-ledger.js\";\n+import { PAY_X402_TIMEOUT_MS } from \"./buyer-timeouts.js\";\n+export { PAY_X402_TIMEOUT_MS };\n import { assertSigningAllowed } from \"./signing-halt.js\";\n import { recordUpstreamSpend } from \"./stats.js\";\n import { provenPayToMatches } from \"./settlement-proof.js\";\n@@ -107,6 +109,45 @@ const DEFAULT_MAX_BYTES = 512 * 1024;\n const MAX_402_BODY_BYTES = 256 * 1024;\n const MAX_REFUSAL_BODY_BYTES = 4 * 1024;\n \n+// The resource a 402 challenge names: a URL string, or an object carrying\n+// one in `url` (x402 v2's ResourceInfo). Anything else names nothing.\n+function resourceUrlOf(res) {\n+  if (typeof res === \"string\") return res.trim() || null;\n+  if (res && typeof res === \"object\" && typeof res.url === \"string\") return res.url.trim() || null;\n+  return null;\n+}\n+const pathKey = (p) => { let d = String(p || \"/\"); try { d = decodeURIComponent(d); } catch { /* keep raw */ } return d.replace(/\\/+$/, \"\") || \"/\"; };\n+const queryKey = (search) => [...new URLSearchParams(search)].map(([k, v]) => `${k}=${v}`).sort();\n+/** Does the challenge's named resource (top level and the accept to be signed)\n+ *  name the URL requested? Same host and port, same path (trailing slash and\n+ *  percent-encoding aside), and, when the resource carries a query, the same\n+ *  parameters in any order. A resource naming http for an https request on the\n+ *  same host is the seller's TLS proxy talking, not another origin. A relative\n+ *  resource resolves against the request. A path that ends with the requested\n+ *  path at a segment boundary on the same origin (/paid/v1/x for /v1/x) is the\n+ *  same route mounted under a prefix by the seller's proxy. Unnamed is not a\n+ *  mismatch. Pure; exported for offline tests. */\n+export function challengeResourceVerdict(requestedUrl, paymentRequired, accept) {\n+  let want;\n+  try { want = new URL(String(requestedUrl)); } catch { return { ok: true, verdict: \"unknown\" }; }\n+  const named = [resourceUrlOf(paymentRequired?.resource), resourceUrlOf(accept?.resource)].filter(Boolean);\n+  if (!named.length) return { ok: true, verdict: \"unnamed\" };\n+  for (const raw of named) {\n+    let got;\n+    try { got = new URL(raw, want); } catch { return { ok: false, verdict: \"mismatch\", field: \"resource\" }; }\n+    const sameScheme = got.protocol === want.protocol || (got.protocol === \"http:\" && want.protocol === \"https:\");\n+    const port = (u) => u.port || (u.protocol === \"https:\" ? \"443\" : u.protocol === \"http:\" ? \"80\" : \"\");\n+    const samePort = got.protocol === want.protocol ? port(got) === port(want) : (!got.port || got.port === \"80\") && port(want) === \"443\";\n+    if (!sameScheme || got.hostname.toLowerCase() !== want.hostname.toLowerCase() || !samePort) return { ok: false, verdict: \"mismatch\", field: \"origin\" };\n+    const gp = pathKey(got.pathname), wp = pathKey(want.pathname);\n+    // wp starts with \"/\", so a suffix match always falls on a segment boundary.\n+    const mounted = wp !== \"/\" && gp.length > wp.length && gp.endsWith(wp);\n+    if (gp !== wp && !mounted) return { ok: false, verdict: \"mismatch\", field: \"path\" };\n+    if (got.search && got.search !== \"?\" && queryKey(got.search).join(\"&\") !== queryKey(want.search).join(\"&\")) return { ok: false, verdict: \"mismatch\", field: \"query\" };\n+  }\n+  return { ok: true, verdict: \"match\" };\n+}\n+\n /** Pin the exact accept the client will sign for `chain` — right network label,\n  *  scheme \"exact\", and the chain's mainnet USDC asset — or null. Pure; exported\n  *  for offline tests (decoy-ordering and cross-chain confusion cases). */\n@@ -466,6 +507,62 @@ export function noteSellerRefusal(url, chain, status) {\n   sellerRefusals.set(key, entry);\n   memoShare(REFUSAL_MEMO, key, SELLER_REFUSAL_TTL_MS, status, now, entry);\n }\n+// WHOSE REFUSAL IS IT? A refusal of a payment we sent is the seller's only if\n+// sellers on that chain take our payments otherwise. When many DIFFERENT\n+// sellers on one chain refuse our paid retries inside a short window with no\n+// settle on that chain between them, the shared factor is our side (how we\n+// sign on that chain), and noting each route would bench every seller there\n+// for the TTL. So past that point no route strike is written for the chain\n+// until a payment on it settles again; the refusals still release their holds.\n+// Only sellers the resolver admitted as proven count toward the pattern: an\n+// unproven seller has never shown that it takes payments, so its refusal is\n+// its own and a handful of new origins cannot pause every route note on a\n+// chain. The hold logs once when it starts and is listed on\n+// /__operator/tool-failures.json (chainRefusalHolds).\n+const CHAIN_REFUSAL_WINDOW_MS = Number(process.env.SOR_CHAIN_REFUSAL_WINDOW_MS) > 0 ? Number(process.env.SOR_CHAIN_REFUSAL_WINDOW_MS) : 30 * 60_000;\n+const CHAIN_REFUSAL_OURS_MIN = Number.isInteger(Number(process.env.SOR_CHAIN_REFUSAL_OURS_MIN)) && Number(process.env.SOR_CHAIN_REFUSAL_OURS_MIN) >= 2 ? Number(process.env.SOR_CHAIN_REFUSAL_OURS_MIN) : 5;\n+const chainRefusals = new Map(); // chain -> Map(origin -> last refusal at)\n+const chainSettledAt = new Map(); // chain -> last settled delivery at\n+const chainHeldSince = new Map(); // chain -> when the current hold started\n+/** Record a refusal of a payment we sent; false when the pattern says it is ours. */\n+export function postSendRefusalIsSellers(url, chain, { proven = true, now = Date.now() } = {}) {\n+  const origin = originOf(url);\n+  if (!origin || !chain || !proven) return true;\n+  let m = chainRefusals.get(chain);\n+  if (!m) { m = new Map(); chainRefusals.set(chain, m); }\n+  const since = Math.max(now - CHAIN_REFUSAL_WINDOW_MS, chainSettledAt.get(chain) || 0);\n+  for (const [o, at] of m) if (at < since) m.delete(o);\n+  m.delete(origin); m.set(origin, now);\n+  while (m.size > 200) m.delete(m.keys().next().value);\n+  if (m.size < CHAIN_REFUSAL_OURS_MIN) { chainHeldSince.delete(chain); return true; }\n+  if (!chainHeldSince.has(chain)) {\n+    chainHeldSince.set(chain, now);\n+    console.warn(`[x402-buyer] ${m.size} sellers on ${chain} refused our paid retries with no settle on ${chain} between them: not noting their routes as refusing until a payment on ${chain} settles`);\n+  }\n+  return false;\n+}\n+/** A settled payment on a chain: refusals before it are each seller's own again. */\n+export function noteChainSettled(chain, now = Date.now()) {\n+  if (!chain) return;\n+  chainSettledAt.set(chain, now);\n+  chainRefusals.delete(chain);\n+  chainHeldSince.delete(chain);\n+}\n+/** Operator view: each chain whose route notes are paused, with the count of\n+ *  distinct proven sellers that refused inside the window. */\n+export function chainRefusalHolds(now = Date.now()) {\n+  const out = [];\n+  for (const [chain, startedAt] of chainHeldSince) {\n+    const m = chainRefusals.get(chain);\n+    const since = Math.max(now - CHAIN_REFUSAL_WINDOW_MS, chainSettledAt.get(chain) || 0);\n+    const sellers = m ? [...m.values()].filter((at) => at >= since).length : 0;\n+    if (sellers < CHAIN_REFUSAL_OURS_MIN) continue; // aged out; the next refusal clears it\n+    out.push({ chain, since: new Date(startedAt).toISOString(), sellers, threshold: CHAIN_REFUSAL_OURS_MIN, windowMinutes: Math.round(CHAIN_REFUSAL_WINDOW_MS / 60_000) });\n+  }\n+  return out;\n+}\n+/** Test seam. */\n+export function __resetChainRefusalsForTest() { chainRefusals.clear(); chainSettledAt.clear(); chainHeldSince.clear(); }\n /** A settled delivery from the route forgets its strikes. */\n export function clearSellerRefusal(url, chain) {\n   const route = refusalRoute(url);\n@@ -826,16 +923,20 @@ export function atomicForMessage(v) {\n  *                   the margin guard. A quote above it fails 502, never signs.\n  * @param method/body  request shape (POST body is a JSON-serializable object).\n  * @param timeoutMs / maxBytes  bounds.\n- * @param refusalMaxWaitMs  the most the refusal branch may wait for the\n- *                   credential to expire before it gives up on proving \"not\n- *                   charged\" (the caller's remaining request budget); a wait\n- *                   that hits the bound keeps the hold.\n+ * @param refusalMaxWaitMs  the caller's remaining request budget, from this\n+ *                   call's start: the refusal branch's wait for the\n+ *                   credential to expire ends by then, whatever the seller\n+ *                   legs before it took; a wait that hits the bound keeps\n+ *                   the hold.\n  *\n  * A 200 on the bare request means the endpoint is free — returned with no\n  * spend. Only a 402 triggers a payment; anything else is a 502.\n  */\n-export async function payX402(url, { maxAtomic, method = \"GET\", body, headers = {}, timeoutMs = 20000, maxBytes = DEFAULT_MAX_BYTES, chain = \"base\", provenPayTo = null, evidenceWallets = null, sellerProof = null, notDebited = null, allowUnproven = false, refusalMaxWaitMs = refusalMaxWaitMsDefault(), memoizeDelivery = false, slug = null, signBy = null, sellerKey = null } = {}) {\n+export async function payX402(url, { maxAtomic, method = \"GET\", body, headers = {}, timeoutMs = PAY_X402_TIMEOUT_MS, maxBytes = DEFAULT_MAX_BYTES, chain = \"base\", provenPayTo = null, evidenceWallets = null, sellerProof = null, notDebited = null, allowUnproven = false, refusalMaxWaitMs = refusalMaxWaitMsDefault(), memoizeDelivery = false, slug = null, signBy = null, sellerKey = null } = {}) {\n   assertSigningAllowed(\"an external x402 payment\");\n+  // The refusal wait ends at a fixed time from this call's start, so a seller\n+  // that never answers the paid request cannot add its timeout on top of it.\n+  const refusalEndAt = Date.now() + Math.max(0, Number(refusalMaxWaitMs) || 0);\n   if (maxAtomic == null) throw bad(\"payX402 requires maxAtomic (the margin-guard ceiling)\", 500);\n   const chainCfg = BUYER_CHAINS[chain];\n   if (!chainCfg) throw bad(`payX402: unknown chain \"${chain}\" (known: ${Object.keys(BUYER_CHAINS).join(\", \")})`, 500);\n@@ -924,6 +1025,18 @@ export async function payX402(url, { maxAtomic, method = \"GET\", body, headers =\n   // we sign.\n   const payable = pickPayableAccept(paymentRequired.accepts, chain);\n   if (!payable) throw bad(`Seller offers no ${chain}/exact/${chainCfg.symbol || \"USDC\"} accept - cannot pay from the ${chain} spending wallet`, 502);\n+  // THE CHALLENGE MUST BE FOR THE URL WE ASKED FOR. A 402 names the resource\n+  // it sells (x402 v2 at the top level, v1 on each accept); a challenge for\n+  // another origin or path is not an offer for this request, whatever it\n+  // costs, so it is refused before anything is signed. Unnamed is unknown and\n+  // does not block. Seller text never reaches the message.\n+  const resourceVerdict = challengeResourceVerdict(url, paymentRequired, payable);\n+  if (!resourceVerdict.ok) {\n+    if (memoizeDelivery) noteSellerRefusal(url, chain, 402);\n+    const e = bad(`Seller's 402 challenge names a different ${resourceVerdict.field} than the URL requested; refusing to sign a payment for another resource. Nothing was signed.`, 502);\n+    e.refused = true;\n+    throw e;\n+  }\n   // THE ACCEPT'S EIP-712 DOMAIN NAME MUST BE THE TOKEN'S OWN (2026-09-10).\n   // The scheme signs the authorization under `extra.name` from the accept it\n   // is handed, so a Base accept advertising \"USDC\" (the token signs under\n@@ -1117,6 +1230,9 @@ export async function payX402(url, { maxAtomic, method = \"GET\", body, headers =\n   }\n   const spendToken = await reserveSpend(quotedAtomic); // F3 belt, before signing (throws 429 if over the window budget)\n   let committed = false;\n+  // Set once a line for this payment is in the outbound ledger; a post-commit\n+  // failure no other path recorded is recorded in the catch below.\n+  let outboundRecorded = false;\n   try {\n     // BASE UNPROVEN DAILY CAPS (src/base-unproven.js): the seller's and the\n     // whole lane's, checked and the signed amount reserved in one step, keyed\n@@ -1228,7 +1344,7 @@ export async function payX402(url, { maxAtomic, method = \"GET\", body, headers =\n     const chainCheckable = chain === \"solana\" || evmCheckable;\n     const readChainVerdict = async (where) => {\n       if (!chainCheckable) return null;\n-      const maxWaitMs = Math.max(0, Number(refusalMaxWaitMs) || 0);\n+      const maxWaitMs = Math.max(0, refusalEndAt - Date.now());\n       try {\n         const check = notDebited || (chain === \"solana\"\n           ? (await import(\"./solana-buyer.js\")).confirmSvmNotDebited\n@@ -1263,6 +1379,16 @@ export async function payX402(url, { maxAtomic, method = \"GET\", body, headers =\n       const unused = !!(verdict && verdict.debited === false && verdict.expired === true);\n       if (unused) committed = false; // provably unpaid: the finally releases the hold\n       console.warn(`[x402-buyer] ${where} did not answer the paid request (${what}) - ${unused ? \"the credential expired unused, nothing charged\" : \"the payment may have settled, hold kept\"}`);\n+      if (!outboundRecorded) {\n+        outboundRecorded = true;\n+        try {\n+          recordOutbound({\n+            chain, payTo: payable?.payTo ?? null, amountAtomic: quotedAtomic,\n+            asset: payable?.asset ?? null, usd: Number(quotedAtomic) / 1e6,\n+            slug: slug || null, origin: sellerOrigin, result: unused ? \"refused\" : \"unknown\", tx: null,\n+          });\n+        } catch { /* bookkeeping never throws into the payment path */ }\n+      }\n       // Worded for any caller: what a caller does next (route-execute tries\n       // no other seller) is the caller's to say.\n       const e = bad(unused\n@@ -1404,7 +1530,7 @@ export async function payX402(url, { maxAtomic, method = \"GET\", body, headers =\n       // most to explain afterwards was the one that recorded least. Recorded\n       // for every caller; only the steering memo is the router's own.\n       if (paid.status >= 500 && !(paid.headers.get(\"payment-response\") || paid.headers.get(\"x-payment-response\"))) {\n-        recordOutbound({\n+        outboundRecorded = true; recordOutbound({\n           chain, payTo: payable?.payTo ?? null, amountAtomic: quotedAtomic,\n           asset: payable?.asset ?? null, usd: Number(quotedAtomic) / 1e6,\n           slug: slug || null, origin: sellerOrigin, result: \"undelivered\", tx: null,\n@@ -1430,7 +1556,7 @@ export async function payX402(url, { maxAtomic, method = \"GET\", body, headers =\n       const strikeChargedFailure = (how) => {\n         if (deliveryStruck || !(paid.status >= 400 && paid.status < 500) || isCallerInputStatus(paid.status)) return;\n         deliveryStruck = true;\n-        recordOutbound({\n+        outboundRecorded = true; recordOutbound({\n           chain, payTo: payable?.payTo ?? null, amountAtomic: quotedAtomic,\n           asset: payable?.asset ?? null, usd: Number(quotedAtomic) / 1e6,\n           slug: slug || null, origin: sellerOrigin, result: \"undelivered\", tx: null,\n@@ -1467,7 +1593,7 @@ export async function payX402(url, { maxAtomic, method = \"GET\", body, headers =\n       // checker that could not attach an expiry) keeps it too - only\n       // expired + unused releases the hold and falls through.\n       if (chainCheckable) {\n-        const maxWaitMs = Math.max(0, Number(refusalMaxWaitMs) || 0);\n+        const maxWaitMs = Math.max(0, refusalEndAt - Date.now());\n         const verdict = await readChainVerdict(where);\n         if (evmCheckable && verdict && verdict.debited === true) strikeChargedFailure(\"the signed authorization was consumed on chain\");\n         if (verdict && verdict.debited === false && verdict.expired === true) {\n@@ -1490,7 +1616,7 @@ export async function payX402(url, { maxAtomic, method = \"GET\", body, headers =\n           // whose URL and body a caller chose is not the router's purchase at\n           // all. All of them still release the hold on the chain's word; none\n           // of them decides where anyone else's money goes.\n-          const memoize = memoizeDelivery && (paid.status === 402 || paid.status === 401) && paidRefusalCarriesChallenge(paid.headers, refusalText);\n+          const memoize = memoizeDelivery && (paid.status === 402 || paid.status === 401) && paidRefusalCarriesChallenge(paid.headers, refusalText) && postSendRefusalIsSellers(url, chain, { proven: !allowUnproven });\n           if (memoize) noteSellerRefusal(url, chain, paid.status);\n           console.warn(`[x402-buyer] ${where} refused the payment and the chain shows no debit after the credential expired (${verdict.observed} tx read) - not charged${memoize ? `, route noted as refusing on ${chain}` : \"\"}`);\n           const e = bad(`Seller refused the payment (HTTP ${paid.status}); the credential expired unused, nothing charged`, 502);\n@@ -1513,6 +1639,20 @@ export async function payX402(url, { maxAtomic, method = \"GET\", body, headers =\n       // literal here let a mutation that never flipped the variable pass the\n       // suite - the error said \"not committed\" while the hold stood.)\n       if (postCommitErr && typeof postCommitErr === \"object\") { postCommitErr.committed = committed; postCommitErr.signedUsd = signedUsd; }\n+      // Every signed payment gets one outbound line: a paid request that got\n+      // no answer, or a refusal, is recorded here unless a path above already\n+      // recorded it (\"refused\" once the chain proved the credential unused,\n+      // \"unknown\" while it may still settle).\n+      if (!outboundRecorded) {\n+        outboundRecorded = true;\n+        try {\n+          recordOutbound({\n+            chain, payTo: payable?.payTo ?? null, amountAtomic: quotedAtomic,\n+            asset: payable?.asset ?? null, usd: Number(quotedAtomic) / 1e6,\n+            slug: slug || null, origin: (() => { try { return new URL(url).origin; } catch { return null; } })(), result: committed ? \"unknown\" : \"refused\", tx: null,\n+          });\n+        } catch { /* bookkeeping never throws into the payment path */ }\n+      }\n       throw postCommitErr;\n     }\n \n@@ -1530,6 +1670,7 @@ export async function payX402(url, { maxAtomic, method = \"GET\", body, headers =\n     // and because the key is origin-wide they could clear it using a different\n     // route from the one that fails. Gated on the same opt-in as the record,\n     // so a diagnostic can never clear what the router learned.\n+    if (tx) noteChainSettled(chain);\n     if (memoizeDelivery && tx) { clearSellerDeliveryFailure(sellerOrigin, chain); clearSellerRefusal(url, chain); }\n     recordUpstreamSpend(\"x402-buyer\", Number(quotedAtomic) / 1e6);\n     // The aggregate above answers \"what did upstream cost\". This answers"},{"sha":"6dc72b873d38baa2eeb4e6dbbc7f5b1b7c0e54f9","filename":"src/x402-index.js","status":"modified","additions":39,"deletions":15,"changes":54,"blob_url":"https://github.com/MikeyPetrillo/Agent402/blob/81a674d1a3cf7fdbbcc04f4da366c144ccd393f7/src%2Fx402-index.js","raw_url":"https://github.com/MikeyPetrillo/Agent402/raw/81a674d1a3cf7fdbbcc04f4da366c144ccd393f7/src%2Fx402-index.js","contents_url":"https://api.github.com/repos/MikeyPetrillo/Agent402/contents/src%2Fx402-index.js?ref=81a674d1a3cf7fdbbcc04f4da366c144ccd393f7","patch":"@@ -220,8 +220,8 @@ const LOCAL_SELLER = \"self\";\n // TWO regexes on purpose: `.test()` on a /g regex is STATEFUL (it advances\n // lastIndex and alternates true/false across calls), so the predicate is\n // non-global and only the extraction is global.\n-const URL_TEMPLATE_RE = /\\{[^}/]+\\}|%7[Bb][^/]*?%7[Dd]|\\/:[A-Za-z_][A-Za-z0-9_]*(?=\\/|$)/;\n-const URL_TEMPLATE_RE_G = /\\{([^}/]+)\\}|%7[Bb](.*?)%7[Dd]|\\/:([A-Za-z_][A-Za-z0-9_]*)(?=\\/|$)/g;\n+const URL_TEMPLATE_RE = /\\{[^{}/]{1,200}\\}|%7[Bb][^/]{0,200}?%7[Dd]|\\/:[A-Za-z_][A-Za-z0-9_]*(?=\\/|$)|<[^<>/&=?]{1,200}>|%3[Cc][^/&=?]{1,200}?%3[Ee]|=YOUR_[A-Za-z0-9_]{0,200}(?=&|$)/;\n+const URL_TEMPLATE_RE_G = /\\{([^{}/]{1,200})\\}|%7[Bb]([^/]{0,200}?)%7[Dd]|\\/:([A-Za-z_][A-Za-z0-9_]*)(?=\\/|$)|<([^<>/&=?]{1,200})>|%3[Cc]([^/&=?]{1,200}?)%3[Ee]|=(YOUR_[A-Za-z0-9_]{0,200})(?=&|$)/g;\n // THREE dialects, not one. The brace form is what OpenAPI writes, but a seller\n // documenting with Express-style \":domain\", or a manifest that URL-encoded its\n // own braces into \"%7Bdomain%7D\", produces a path that is just as uncallable and\n@@ -233,6 +233,18 @@ const URL_TEMPLATE_RE_G = /\\{([^}/]+)\\}|%7[Bb](.*?)%7[Dd]|\\/:([A-Za-z_][A-Za-z0-\n //\n // The colon form is anchored to a whole segment (/:name) so an ordinary path\n // containing a colon, or a scheme, is not mistaken for a template.\n+// A placeholder can also ride in the query a manifest endpoint keeps\n+// (\"?payloads=<url-encoded-json-array>\", raw or %3C..%3E encoded, or a\n+// \"=YOUR_KEY\" value): the router appends the caller's params after it, so the\n+// seller would get the placeholder first. Those read as templates too; a real\n+// query value (\"?product=basic\") does not.\n+/** Whether a route (path and query) still holds an unsubstituted placeholder.\n+ *  The one test every surface reads, so a label never disagrees with the router. */\n+export function isUrlTemplateRoute(route) { return URL_TEMPLATE_RE.test(String(route || \"\")); }\n+// Route text is seller-controlled and unbounded, so every form is bounded: a\n+// placeholder name is at most 200 characters and cannot hold its own opening\n+// token, which keeps a test linear on a hostile route (unbounded, 100k \"{\"\n+// held the loop for seconds).\n const SELF_BAZAAR_ORIGIN = \"https://agent402.tools\"; // the origin our Bazaar listing is keyed under\n const SELF_HOST = canonicalHost(SELF_BAZAAR_ORIGIN);\n // The canonical host of each string the whole-cache walks have seen: the self\n@@ -2266,7 +2278,7 @@ function urlTemplateProjection(t) {\n   if (!URL_TEMPLATE_RE.test(route)) return {};\n   return {\n     urlTemplate: true,\n-    pathParams: [...route.matchAll(URL_TEMPLATE_RE_G)].map((m) => m[1] || m[2] || m[3]).filter(Boolean),\n+    pathParams: [...route.matchAll(URL_TEMPLATE_RE_G)].map((m) => m[1] || m[2] || m[3] || m[4] || m[5] || m[6]).filter(Boolean),\n   };\n }\n \n@@ -2681,6 +2693,9 @@ async function normaliseOpenapiToolsSliced(openapi, originUrl) {\n // is next in line; the work is the same, only its spread over turns changes.\n const crawlLaneQueue = [];\n let crawlLanePumping = false;\n+// A bazaar-fallback crawl whose registry and OpenAPI rows pass this count\n+// takes a lane turn between its whole-list passes (see crawlSeller).\n+const FALLBACK_PASS_TURN_ROWS = 2000;\n function crawlLaneTurn() {\n   return new Promise((resolve) => {\n     crawlLaneQueue.push(resolve);\n@@ -4285,7 +4300,7 @@ let paywallRecheckBudget = PAYWALL_RECHECKS_PER_CYCLE;\n /** Was this stored failure taken at a URL that is still a template? */\n function paywallVerdictOnTemplate(pw) {\n   if (typeof pw?.url !== \"string\") return false;\n-  try { return URL_TEMPLATE_RE.test(new URL(pw.url).pathname); } catch { return false; }\n+  try { const u = new URL(pw.url); return URL_TEMPLATE_RE.test(u.pathname + u.search); } catch { return false; }\n }\n /** Is this stored paywall verdict a failure due a fresh probe? A missing\n  *  verdict is the rotation's business; a passing one is not expired here. */\n@@ -6026,36 +6041,45 @@ async function crawlSeller(originUrl, { deadlineAt = 0, forcePaywall = false } =\n         noteFallback(\"/llms.txt\", e);\n       }\n     }\n-    const tools = dropUnvouchedNonProductRoutes(\n-      mergeOpenapiIntoBazaar(openapiTools, bazaarTools, {\n-        allRoutes: openapi ? openapiAllOperationRoutes(openapi, originUrl) : [],\n-      }),\n-      bazaarTools.map((t) => t.route)\n-    );\n+    // Each pass below walks every registry row, and the registry is read\n+    // before the per-seller tool cap (one seller lists 77k rows): run back to\n+    // back they held the loop ~300 ms locally. A large list takes one crawl\n+    // lane turn between passes; the passes, their inputs and order are as before.\n+    const passTurn = bazaarTools.length + openapiTools.length > FALLBACK_PASS_TURN_ROWS ? crawlLaneTurn : null;\n+    const merged = mergeOpenapiIntoBazaar(openapiTools, bazaarTools, {\n+      allRoutes: openapi ? openapiAllOperationRoutes(openapi, originUrl) : [],\n+    });\n+    if (passTurn) await passTurn();\n+    const tools = dropUnvouchedNonProductRoutes(merged, bazaarTools.map((t) => t.route));\n+    if (passTurn) await passTurn();\n     if (tools.length) {\n       stampDeclared(tools, [...openapiTools, ...(openapi ? openapiAllOperationRoutes(openapi, originUrl) : [])]);\n+      if (passTurn) await passTurn();\n       // Same enrichment as the manifest path. A seller discovered through the\n       // FALLBACK surfaces is even less likely to have published a price, so\n       // skipping it here would leave the worst-served sellers unpriced.\n       carryForwardLearnedQuotes(tools, prev);\n+      if (passTurn) await passTurn();\n       // Crawl-local, as on the manifest path: the probe body only.\n       const probeExamples = openapi ? openapiProbeExamples(openapi, originUrl, new Map()) : null;\n       // In memory only, for a re-price; this branch's reads are unconditional.\n       probeExampleMemo.set(originUrl, \"manifest\", null);\n       probeExampleMemo.set(originUrl, \"openapi\", probeExamples);\n       await enrichLiveQuotes(tools, originUrl, { deadlineAt, redirectedTo: prev?.redirectedTo ?? null, probeExamples });\n+      if (passTurn) await passTurn();\n       // A real (non-synthesized) manifest from a past crawl is kept; a stale\n       // synthesized one is rebuilt so a newly appeared openapi title wins.\n       const keepManifest = prev?.manifest && !prev.manifest.synthesized ? prev.manifest : null;\n+      const manifest = keepManifest ||\n+        (openapi\n+          ? synthManifestFromOpenapi(originUrl, openapi, tools)\n+          : synthManifestFromBazaar(originUrl, bazaarTools));\n+      if (passTurn) await passTurn();\n       cache.set(originUrl, {\n         // A fresh tool list: the total is read from it, not the old entry\n         // (a seller that shrank from 77,000 tools to 6,000 reads 6,000).\n         ...freshListBase(prev),\n-        manifest:\n-          keepManifest ||\n-          (openapi\n-            ? synthManifestFromOpenapi(originUrl, openapi, tools)\n-            : synthManifestFromBazaar(originUrl, bazaarTools)),\n+        manifest,\n         openapiSummary: openapi ? { paths: Object.keys(openapi.paths || {}).length } : prev?.openapiSummary ?? null,\n         tools,\n         fetchedAt: Date.now(),"},{"sha":"4bb76506f03dafe601bfe3ba3c824bd1bc247370","filename":"wiki/Buying-at-Volume.md","status":"added","additions":80,"deletions":0,"changes":80,"blob_url":"https://github.com/MikeyPetrillo/Agent402/blob/81a674d1a3cf7fdbbcc04f4da366c144ccd393f7/wiki%2FBuying-at-Volume.md","raw_url":"https://github.com/MikeyPetrillo/Agent402/raw/81a674d1a3cf7fdbbcc04f4da366c144ccd393f7/wiki%2FBuying-at-Volume.md","contents_url":"https://api.github.com/repos/MikeyPetrillo/Agent402/contents/wiki%2FBuying-at-Volume.md?ref=81a674d1a3cf7fdbbcc04f4da366c144ccd393f7","patch":"@@ -0,0 +1,80 @@\n+# Buying at Volume\n+\n+An agent that buys hundreds or thousands of calls in a burst, over x402 or MPP, needs four things: a price it can check before it pays, a retry that never pays twice, a ceiling on spend, and limits it can plan around. This page names each mechanism and the file that enforces it. The live figures, rendered from that code, are on the guide: [agent402.tools/guides/buying-at-volume](https://agent402.tools/guides/buying-at-volume).\n+\n+## Prices\n+\n+- [`/api/pricing`](https://agent402.tools/api/pricing) lists every route, its list price, the chains it takes (`networks`) and, on a route that runs as a job, its `async` block. Chains with a settlement premium or a price floor are listed under `payment.premiumUsdByNetwork` and `payment.minPriceUsdByNetwork`.\n+- The 402 is the quote for the request in hand. On the metered model routes it is computed from the body, and the paid retry is priced again from its own body (`acceptsForItem` in `src/payments.js`), so the paid retry carries the body that was quoted.\n+- Price changes are on the [changelog](https://agent402.tools/changelog). Read `/api/pricing` at the start of each burst.\n+\n+## Throughput limits\n+\n+There is no per-wallet rate limit on paid calls. Every limit below answers before any payment is taken; the default column says how long to wait.\n+\n+| What is counted | Default | Source |\n+|---|---|---|\n+| Unpaid price checks to priced catalog routes, per client address | 3,000 an hour; 30,000 an hour for the rest of the clock hour once that address settles a payment, and for 10 minutes after each paid call | `src/unpaid-quote-budget.js` (`PAID_CLIENT_QUOTE_MULTIPLIER`) |\n+| Unpaid quotes on `/v1/metered`, per client address | 60 a minute, 1,200 an hour (429, `Retry-After: 60`, with a `guide` link); past that, 2 more for each paid `/v1/metered` call from that address (`METERED_QUOTE_CREDITS_PER_CALL`), used within 10 minutes, up to 600 a minute and 12,000 an hour. `Retry-After: 60` is the minute window; past the hourly figure the wait runs until the oldest quote in the last hour ages out | `METERED_UNPAID_QUOTES_PER_MIN` / `_PER_HOUR` and `PAID_CLIENT_METERED_QUOTES_PER_MIN` / `_PER_HOUR` in `src/unpaid-quote-budget.js`, enforced in `src/server.js` |\n+| Refused payment credentials on `/v1/metered` | the same figures, counted once a credential is refused | `src/server.js` |\n+| Payments that verified and then failed to settle, per wallet | 3 in 15 minutes while failures are more than half of the wallet's outcomes, or 40 whatever it settled | `src/gateway-settle-breaker.js` |\n+| Report and media runs that failed to settle or failed after the run, per buyer (signed payer, verified Tempo sender, credits key, else address) | blocked for 30 minutes (429, no `Retry-After`) at 3 in 15 minutes while failures are more than half of the buyer's outcomes, or at 10 whatever it settled | `COMPOSITE_GUARD_*` in `src/composite-spend-guard.js` |\n+| Unpaid requests with a body over 100 KB to a route that reads its price from the body, per client address | 60 a minute, 1,200 an hour (429, `Retry-After: 60`); no raise once the address has paid | `src/large-body-gate.js`, limiter in `src/server.js` |\n+| Concurrent report and media runs, per wallet | the balance must cover every run in flight plus the new one (429, `Retry-After: 30`) | `src/inflight-cover.js` |\n+| Jobs per client address | 4 at once (429, `Retry-After: 30`) | `ASYNC_JOBS_PER_CLIENT` in `src/async-jobs.js` |\n+\n+An IPv6 /64 is one address. A stock x402 client sends one unpaid read and one paid retry per call, and only the unpaid read is counted. Once an address has paid, its unpaid price checks read against 10 times the figure for 10 minutes after each paid call (a final 200 that settled on any rail, or a credits debit; `PAID_QUOTE_TRUST_MINUTES` in `src/paid-quote-trust.js`, `PAID_CLIENT_QUOTE_MULTIPLIER` in `src/unpaid-quote-budget.js`). A `/v1/metered` quote past its plain figure needs a credit that a paid `/v1/metered` call earned, so a steady buyer is paced by its own paid calls and one cheap paid call raises the limit by only a few quotes. A payment credential that is refused still counts.\n+\n+## Retries that never pay twice\n+\n+- **`Idempotency-Key`:** the same key with the same credential, route, query and body returns the first 200 (`X-Idempotent-Replay: true`) with no second run and no second settlement; a copy that arrives while the first runs gets 409 `idempotent_request_in_flight` with `Retry-After: 2` (`src/idempotency.js`, store in `src/idempotency-store.js`).\n+- **Implicit replay on EVM payments:** the signed payment (network, payer, nonce) is the key, so a re-sent payment returns the first answer marked `X-Replayed-Answer: 1`, except on identity-bound routes, routes with a lasting effect and streamed calls.\n+- **Solana:** no implicit key; send `Idempotency-Key` with the exact payment header that went out the first time.\n+- On x402 a response of 400 or above is not settled, so a retry after one costs nothing extra. Read `PAYMENT-RESPONSE` on each answer to see whether it settled.\n+\n+## Slow calls\n+\n+A route with an `async` block takes `Prefer: respond-async`: 202 and a `Location` job link at once, `GET /api/jobs/{id}` (free) until `status` is `completed` or `failed`, payment settled only on the delivered result (`src/async-jobs.js`, `src/slow-routes.js`). agent402-client and agent402-mcp switch to jobs on their own.\n+\n+## Spend caps in the packages\n+\n+| Package | Per call | Across calls | Source |\n+|---|---|---|---|\n+| agent402-client | `maxPerCallUsd` | `dailyLimitUsd`, `maxPerHostUsd` (rolling 24 hours, per instance) | `client/index.js` |\n+| agent402-mcp | `AGENT402_MAX_PER_CALL` (on by default, `off` removes it) | `AGENT402_BUDGET` (whole session, opt-in) | `mcp/index.js` |\n+| agent402-openclaw | `maxPerCallUsd` or `AGENT402_MAX_PER_CALL_USD` (defaults to the metered per-call cap) | none | `openclaw/index.js` |\n+\n+Every cap is checked before a payment is signed. All three packages refuse an accept asking for a signing validity longer than a day (`MAX_VALIDITY_SECONDS` in each `known-assets.js`). `AGENT402_NETWORKS` (agent402-mcp) restricts and orders the chains a wallet pays on.\n+\n+## Rails\n+\n+| Rail | Settles | When the call fails |\n+|---|---|---|\n+| x402 exact, EVM chain | after the tool answers, only under 400 | not charged |\n+| x402 exact, Solana | after the tool answers, only under 400 | not charged |\n+| x402 exact, Stellar | after the tool answers, only under 400 | not charged |\n+| x402 exact, Algorand | after the tool answers, only under 400 | not charged |\n+| x402 exact, Gateway batched (where offered; paid from a Circle Gateway deposit) | settled off chain by Circle Gateway after the tool answers, only under 400 | not charged |\n+| MPP `evm` charge | the same x402 settlement | not charged |\n+| MPP Tempo pull | broadcast after the tool answers, only under 400 | not charged |\n+| MPP Tempo push | final before the call runs | booked as a refund owed, repaid after on-chain proof |\n+\n+On the EVM chains and Tempo pull, a settlement whose outcome is not known when the call is answered is read on chain again; one that lands after a failed answer is booked as a refund owed and repaid after on-chain proof.\n+\n+The long routes (report products, video, the slow media tiers) take x402 exact on EVM chains only, and Tempo is not offered on identity-bound or long-running routes. A Solana payment embeds a recent blockhash that lives about a minute, so sign each one right before it is sent. A Solana payment refused for a missing or underfunded USDC account answers `retry: \"fund-wallet\"` with `Retry-After` (`src/svm-funding-refusal.js`).\n+\n+## Metered chat\n+\n+- Model ids: `GET /v1/models`. An unlisted id is refused before payment with `suggestions` and a `howToCall` retried with the first.\n+- Input size: each model's cap is `x402.meteredMaxInputChars` on `/v1/models` (`maxInputCharsFor` in `src/tools/llm-gateway-kit.js`); over it, `input_too_large` before payment, with `suggestions` of models whose window takes it.\n+- Per-call cap: a body quoting above `METERED_MAX_QUOTE_USD` is refused with a 400 before any upstream call.\n+\n+## Errors\n+\n+- 400, 422: input refused; the body carries `howToCall` (method, URL, ready body). Not charged on x402.\n+- 402: the first-contact body carries the offer, `howToCall` and, on a job route, `async`.\n+- 409: the same keyed call is still running; resend after `Retry-After`.\n+- 429, 503: a limit or a busy route; wait `Retry-After`. image-ocr answers 503 `large-image-busy` while it reads another large image.\n+- 502, 504 with `attribution: \"upstream\"`: a source the tool reads failed, not the input.\n+\n+See also: [[Paying with x402]], [[Paying with MPP]], [[LLM Gateway (OpenAI /v1)|LLM-Gateway]], [[Agentic Finance]]."},{"sha":"4a3c47363cd3de371a08c95d39b810a8da30d88e","filename":"wiki/Content-Pipeline.md","status":"added","additions":42,"deletions":0,"changes":42,"blob_url":"https://github.com/MikeyPetrillo/Agent402/blob/81a674d1a3cf7fdbbcc04f4da366c144ccd393f7/wiki%2FContent-Pipeline.md","raw_url":"https://github.com/MikeyPetrillo/Agent402/raw/81a674d1a3cf7fdbbcc04f4da366c144ccd393f7/wiki%2FContent-Pipeline.md","contents_url":"https://api.github.com/repos/MikeyPetrillo/Agent402/contents/wiki%2FContent-Pipeline.md?ref=81a674d1a3cf7fdbbcc04f4da366c144ccd393f7","patch":"@@ -0,0 +1,42 @@\n+# Content Pipeline\n+\n+A content pipeline (a podcast, a short video, a narrated explainer) is a chain of stages: research, script, voiceover, images, transcription, subtitles, dubbing and media checks. On Agent402.Tools each stage is one paid call, paid from one wallet over x402 or MPP, with no API key. The guide with a runnable example per stage, an end-to-end flow and live prices is at [agent402.tools/guides/content-pipeline](https://agent402.tools/guides/content-pipeline).\n+\n+## Stages\n+\n+| Stage | Slugs | Model-backed | Source |\n+|---|---|---|---|\n+| Answer with citations | `answer` | yes | `src/tools/search.js` |\n+| Research report | `research` (also `research-pro`, `research-max`) | yes | `src/tools/research-deep-kit.js` |\n+| Script | `v1-chat-metered` (quoted per request), or a flat `/v1` chat tier | yes | `src/tools/llm-gateway-kit.js` |\n+| Voiceover | `tts-lite`, `tts`, `tts-hd` | yes | `src/tools/tts-kit.js` |\n+| Images | `v1-images-fast`, `v1-images-pro` | yes | `src/tools/llm-images-fast-kit.js` |\n+| Image edits | `v1-images-edit` | yes | `src/tools/llm-images-fast-kit.js` |\n+| Transcription | `transcribe`, `transcribe-pro` (a URL); `v1-audio-transcriptions` (a multipart upload) | yes | `src/tools/stt-kit.js` |\n+| Subtitles | `srt-convert` (also free with proof-of-work) | no | `src/tools/kit2.js` |\n+| Subtitles in one call | `skill-subtitle-pipeline` | yes | `src/tools/skill-runner.js` |\n+| Dubbing | `dub` | yes | `src/tools/dub-kit.js` |\n+| Media checks | `media-info` | no | `src/tools/media-kit.js` |\n+| Audio conversion | `audio-convert`, `audio-normalize` | no | `src/tools/media-kit.js` |\n+\n+Prices and each route's chains are on [`/api/pricing`](https://agent402.tools/api/pricing). Speech, dubbing and metered chat are quoted per request, so the 402 for that body is the price.\n+\n+## How the outputs chain\n+\n+- `answer` returns `answer` and `citations`; the citations become the show notes and the answer feeds the script prompt.\n+- The metered chat answer's `choices[0].message.content` is the script. `tts` returns the audio as base64 in `audio`; split a script longer than the tier's character cap at sentence ends.\n+- Transcription and the media checks read a public URL, so the pipeline stores each audio file where it already keeps media and passes that URL on. Audio held as bytes goes to `POST /v1/audio/transcriptions` as a multipart `file`.\n+- `transcribe` with `diarize: true` returns `words` with `start` and `end` in seconds. Grouped into cues (`start`, `end` in milliseconds, `text`), they go to `srt-convert` with `to` set to `srt`, `vtt`, `text` or `json`. The subtitle-pipeline skill pack returns the whole clip as one cue, for when per-line timing is not needed.\n+- `dub` with `json: true` returns `translation` and the spoken `audio`; without it the answer is the audio bytes with the translation in `X-Dub-Translation`.\n+- `audio-normalize` and `audio-convert` return MP3 as `mp3Base64`; `media-info` returns `durationSec` and per-stream codecs.\n+\n+## Slow stages\n+\n+A route runs as a job when its `/api/pricing` row has an `async` block (`src/slow-routes.js`, `src/async-jobs.js`). `research` requires `Prefer: respond-async` or `Prefer: wait=<maxSeconds>` and answers a paid call with neither 400 before payment. `v1-images-fast` and `v1-images-pro` take `Prefer: respond-async` on request. The other stages answer on the connection. agent402-client sends the header where the row recommends it and collects the job.\n+\n+## Paying for a pipeline\n+\n+- **Spend caps.** agent402-client's `maxPerCallUsd`, `dailyLimitUsd` and `maxPerHostUsd` are checked before a payment is signed, against the quote for that request. agent402-mcp uses `AGENT402_MAX_PER_CALL` and `AGENT402_BUDGET`. Limits, retries and replays for long runs: [[Buying at Volume|Buying-at-Volume]].\n+- **Chains.** `research`, `v1-images-fast`, `v1-images-pro` and `v1-images-edit` are long-running, so they take x402 exact on EVM chains only (`isLongRunningSlug` in `src/composite-spend-guard.js`). Every other stage takes every offered chain, over x402 or MPP.\n+- **Tempo.** Offered on every stage except `research`, `v1-images-fast`, `v1-images-pro` and `v1-images-edit` (`tempoOfferedFor` in `src/mpp-tempo.js`). A pull credential (`payload` type `transaction`) is broadcast only after the stage answers under 400, so for a stage that fails a Tempo pull transaction is never broadcast and nothing is charged. A push credential (`payload` type `hash`) is a transfer already sent and final before the stage runs; if the stage then fails, the transfer is booked as a refund owed to the paying wallet and repaid after on-chain proof. Pipelines pay with pull: pin `mode: \"pull\"` on the Tempo charge method. A pull payment whose connection closed before the answer can still be broadcast, and is then booked as owed. See [[Paying with MPP]].\n+- **x402.** A response of 400 or above is not settled, so a failed x402 stage is not charged."},{"sha":"daf275314bfb638be02654734871a69fba9d8203","filename":"wiki/Self-Hosting.md","status":"modified","additions":1,"deletions":1,"changes":2,"blob_url":"https://github.com/MikeyPetrillo/Agent402/blob/81a674d1a3cf7fdbbcc04f4da366c144ccd393f7/wiki%2FSelf-Hosting.md","raw_url":"https://github.com/MikeyPetrillo/Agent402/raw/81a674d1a3cf7fdbbcc04f4da366c144ccd393f7/wiki%2FSelf-Hosting.md","contents_url":"https://api.github.com/repos/MikeyPetrillo/Agent402/contents/wiki%2FSelf-Hosting.md?ref=81a674d1a3cf7fdbbcc04f4da366c144ccd393f7","patch":"@@ -119,7 +119,7 @@ Set these on your host. None are committed to the repo.\n - **`FREE_MODE=true`**: every tool responds without payment. Good for development, internal deployments, or self-hosted agents that don't need metering. The PoW gate and x402 paywall are both disabled.\n - **Without `FREE_MODE`**: the x402 paywall activates. Callers pay per request (USDC on Base by default; add Solana, Polygon, Arbitrum, Stellar, Algorand and the chains below with `PAYMENT_NETWORKS`, each with its own payTo / facilitator setting) or solve a proof-of-work challenge for pure-CPU tools. You need `WALLET_ADDRESS`, a facilitator (`CDP_API_KEY_ID` + `CDP_API_KEY_SECRET`, or `FACILITATOR_URL`), and `POW_SECRET` at minimum. To also accept **USDC on Monad** (EVM chain 143), add `monad` to `PAYMENT_NETWORKS` (settles via `MONAD_FACILITATOR_URL`, default a public Monad facilitator). Avalanche (43114) and Sei (1329) are likewise opt-in via `PAYMENT_NETWORKS` (set `PAYAI_API_KEY_ID` + `PAYAI_API_KEY_SECRET`, the keys of the facilitator that settles them). Optimism (10) is opt-in via `PAYMENT_NETWORKS` plus `SOLVADOR_KEY` (the key of the facilitator that settles it; `NETWORK_PRICE_PREMIUMS`, a CAIP-2 keyed CSV such as `eip155:10=<usd>`, adds a per-chain amount to that chain's quote if your facilitator charges per settlement). To also accept **USDC on Celo** (EVM chain 42220), add `celo` to `PAYMENT_NETWORKS` and set `CELO_FACILITATOR_KEY` (a self-service key minted at [x402.celo.org](https://x402.celo.org); the facilitator's `/settle` requires it). Settles via `CELO_FACILITATOR_URL`, default the Celo-operated `api.x402.celo.org`. To accept **USDG on Robinhood Chain**, add `robinhood` to `PAYMENT_NETWORKS` and set `ROBINHOOD_FACILITATOR_URL` (one URL, or an ordered comma-separated list whose later entries are its settle fallback under `PAYMENT_SETTLE_FALLBACK=true`; `FACILITATOR_GAS_CHECK=off` and `FACILITATOR_GAS_MIN_SETTLEMENTS` tune the settlement-gas check; `ROBINHOOD_RELAYER_KEY` adds an optional settler you run yourself as the last fallback, see [[Robinhood-Chain]]). To accept **USDC on Arc** (EVM chain 5042), set `CIRCLE_FACILITATOR_API_KEY` (a Circle API key, optional): its presence is the switch, Arc then joins a multi-chain `PAYMENT_NETWORKS` list on its own, and it is offered only while Circle's facilitator `/supported` lists it. `ARC_CONTRACT_WALLETS=on` (optional, off by default) also accepts Arc payments signed by a contract wallet (ERC-1271, or ERC-6492 for one not yet deployed), verified on chain against the Arc RPC before Circle sees them; identity-bound routes (memory, attest, feedback, my-usage, receipts) still take an EOA signature only. With that key set, `CIRCLE_FACILITATOR_EVM_FALLBACK=on` (optional, off by default) also makes the same facilitator the last settle fallback on Base and Polygon under `PAYMENT_SETTLE_FALLBACK=true`: exact USDC only, tried once its `/supported` lists the chain, and only after every earlier settler refused before broadcasting. With more than one Robinhood facilitator listed, the first whose `/supported` confirms `eip155:4663` at boot settles first and the rest stay fallbacks; a listed facilitator's HTTP 200 refusal that names no transaction and no verdict about the buyer goes to the next listed one. To accept **USDC on Ink** (EVM chain 57073, native Circle USDC), add `ink` to `PAYMENT_NETWORKS` and set `INK_FACILITATOR_URL` (one URL, or an ordered comma-separated list, read exactly like `ROBINHOOD_FACILITATOR_URL`: the first whose `/supported` confirms `eip155:57073` at boot settles first, the rest are its settle fallback, and the settlement-gas check reads each one's signer). Without the URL an `ink` entry is not configured and every other chain is unaffected. Ink has no settler of your own (there is no relayer option for it) and no price floor by default (`NETWORK_PRICE_FLOORS=eip155:57073=<usd>` sets one; `NETWORK_PRICE_PREMIUMS` covers a facilitator that charges per settlement). See [[Ink (USDC)|Ink]]. If the Robinhood or Ink facilitator you settle through publishes the settlements it relays, set `FACILITATOR_PUBLIC_INDEX_CHAINS` to `robinhood`, `ink` or both (any value it does not know is ignored with a boot warning): while a listed chain is offered, /privacy, /terms, `/.well-known/x402`, llms.txt and the chain's page disclose it, naming the facilitator each chain settles through first; a listed chain that is not offered renders nothing and is named in a boot warning. Optional: `FACILITATOR_PUBLIC_INDEX_NAME` (its display name), `FACILITATOR_PUBLIC_INDEX_POLICY_URL` (its privacy policy, an https URL) and `FACILITATOR_PUBLIC_INDEX_SINCE` (YYYY-MM-DD; the legal pages print the later of their own date and this one).\n \n-**Circle Gateway batched option (optional):** set `GATEWAY_NANOPAYMENTS=on` and the 402 on Arc and Base (`GATEWAY_NANOPAYMENT_NETWORKS`) also carries a second `exact` accept whose `extra.name` is `GatewayWalletBatched`, at the same price and to the same payTo. A network is offered only while it is in the plain offer and Circle Gateway's `/v1/x402/supported` lists its batched kind at boot (fail closed: an unreadable answer drops the option and nothing else). Gateway verifies and settles these payments off chain, keyless, and credits them to your Gateway balance, not to your wallet on chain: sales are booked with wire `gateway-batched` and Gateway's transfer id as their tx, and `/revenue` counts them from the sales ledger under that label. A payment Gateway leaves pending is answered `402` with `Retry-After`, kept in a pending book, and served on the buyer's resend of the same payment once Gateway confirms it; a resolver reads Gateway's record for each one every ten minutes and books one that settled and was never served as owed. Move the balance on chain with `node scripts/gateway-withdraw.js` (human-run, `GATEWAY_SELLER_KEY` in that shell only, never a server variable): it is a dry run that prints the plan unless you pass `--execute`, takes `--from arc|base` for the source domain (required with `--amount`), `--to`, `--recipient` (default your own address) and `--max-fee`, and mints on the destination chain. The withdrawal's mint is not counted as revenue again. Status words on `/api/gateway-status`: `gatewayBalance` (`off`, `unknown`, `ok`, or `withdraw` once the balance reaches `GATEWAY_WITHDRAW_ALERT_USD`), `gatewayPending` (`off`, `ok`, `pending`, `near_capacity`, `full`, or `unresolved` for a payment pending past `GATEWAY_PENDING_UNRESOLVED_HOURS`) and, for every rail, `buyerRefusals` (`refusing` for a while after the settle breaker refused a wallet that had settled a call inside its window, `ok` otherwise; `BUYER_REFUSAL_WINDOW_MS`). Words only; the figures are on the operator endpoints.\n+**Circle Gateway batched option (optional):** set `GATEWAY_NANOPAYMENTS=on` and the 402 on Arc and Base (`GATEWAY_NANOPAYMENT_NETWORKS`) also carries a second `exact` accept whose `extra.name` is `GatewayWalletBatched`, at the same price and to the same payTo. A network is offered only while it is in the plain offer and Circle Gateway's `/v1/x402/supported` lists its batched kind at boot (fail closed: an unreadable answer drops the option and nothing else). Gateway verifies and settles these payments off chain, keyless, and credits them to your Gateway balance, not to your wallet on chain: sales are booked with wire `gateway-batched` and Gateway's transfer id as their tx, and `/revenue` counts them from the sales ledger under that label. A payment Gateway leaves pending is answered `402` with `Retry-After`, kept in a pending book, and served on the buyer's resend of the same payment once Gateway confirms it; a resolver reads Gateway's record for each one every ten minutes and books one that settled and was never served as owed. Move the balance on chain with `node scripts/gateway-withdraw.js` (human-run, `GATEWAY_SELLER_KEY` in that shell only, never a server variable): it is a dry run that prints the plan unless you pass `--execute`, takes `--from arc|base` for the source domain (required with `--amount`), `--to`, `--recipient` (default your own address; another address must be one of your own wallets, `WALLET_ADDRESS` or `OUR_WALLETS`, unless you pass `--allow-external-recipient`, and the dry run says which; set `OUR_WALLETS` to your own comma-separated list, since unset it reads the hosted service's list) and `--max-fee`, and mints on the destination chain. The withdrawal's mint is not counted as revenue again. Status words on `/api/gateway-status`: `gatewayBalance` (`off`, `unknown`, `ok`, or `withdraw` once the balance reaches `GATEWAY_WITHDRAW_ALERT_USD`), `gatewayPending` (`off`, `ok`, `pending`, `near_capacity`, `full`, or `unresolved` for a payment pending past `GATEWAY_PENDING_UNRESOLVED_HOURS`) and, for every rail, `buyerRefusals` (`refusing` for a while after the settle breaker refused a wallet that had settled a call inside its window, `ok` otherwise; `BUYER_REFUSAL_WINDOW_MS`), `lateSettlements` (`ok`, `near_capacity`, `full`, or `unresolved` while a settlement whose outcome was not known when the call was answered waits for an operator or could not be recorded) and `replayStore` (`ok`, or `pending` while a settled payment's consumed mark waits to reach the shared store). Words only; the figures are on the operator endpoints.\n \n **MPP on the same 402:** set `MPP_SECRET_KEY` and every paid route also answers `WWW-Authenticate: Payment` (the `evm` method settles through your existing facilitator); add `TEMPO_API_KEY` for native Tempo settlement. **Cards:** `STRIPE_SECRET_KEY` (+ `STRIPE_WEBHOOK_SECRET`) mounts the report checkout, monitors and prepaid credits; `STRIPE_PROFILE_ID` adds cards over MPP. **Email:** `EMAIL_FROM` plus `ZEPTOMAIL_TOKEN` or `RESEND_API_KEY`; without them the card pages still work and the report link is shown on the page.\n "},{"sha":"24834fc686029d9986e58f08345a0a2bede61b39","filename":"wiki/Skill-Packs.md","status":"modified","additions":5,"deletions":5,"changes":10,"blob_url":"https://github.com/MikeyPetrillo/Agent402/blob/81a674d1a3cf7fdbbcc04f4da366c144ccd393f7/wiki%2FSkill-Packs.md","raw_url":"https://github.com/MikeyPetrillo/Agent402/raw/81a674d1a3cf7fdbbcc04f4da366c144ccd393f7/wiki%2FSkill-Packs.md","contents_url":"https://api.github.com/repos/MikeyPetrillo/Agent402/contents/wiki%2FSkill-Packs.md?ref=81a674d1a3cf7fdbbcc04f4da366c144ccd393f7","patch":"@@ -72,7 +72,7 @@ Every pack is **also a single paid endpoint**, `POST /api/skill/{slug}`, which r\n | [**loan-comparison**](https://agent402.tools/skills/loan-comparison) | $0.006 | Compare loan offers with different rates and terms: payment, amortization, compound interest, NPV, IRR. |\n | [**financial-research**](https://agent402.tools/skills/financial-research) | $0.024 | SEC filings + real-time quotes + history + macro context for a single ticker. |\n | [**financial-analysis**](https://agent402.tools/skills/financial-analysis) | $0.024 | Quick company snapshot: live quote, 9 key financial metrics, and upcoming earnings. |\n-| [**company-dossier**](https://agent402.tools/skills/company-dossier) | $0.037 | Comprehensive company research in one call: quote, financials, filings, insider trades, news. |\n+| [**company-dossier**](https://agent402.tools/skills/company-dossier) | $0.037 | Raw company data in one call: latest close, financials, recent SEC filings, 90 days of insider trades and recent news results, each as its own answer (no written report). |\n | [**earnings-watch**](https://agent402.tools/skills/earnings-watch) | $0.015 | Has this company just reported? Newest SEC filings, the latest close, and recent coverage of analyst expectations. |\n | [**earnings-deep-dive**](https://agent402.tools/skills/earnings-deep-dive) | $0.033 | Everything before a company reports: the upcoming date, latest financials, recent filings, live quote, and fresh news in one pass. |\n | [**insider-alert**](https://agent402.tools/skills/insider-alert) | $0.01 | Insider buying/selling for a stock: Form 4 trades, live quote, and recent SEC filings. |\n@@ -86,7 +86,7 @@ Every pack is **also a single paid endpoint**, `POST /api/skill/{slug}`, which r\n | [**macro-economics**](https://agent402.tools/skills/macro-economics) | $0.032 | Pull the canonical US macro dataset - yield curve, CPI, unemployment, fed funds, Sahm rule. |\n | [**macro-context**](https://agent402.tools/skills/macro-context) | $0.036 | \"Is the economic backdrop you're modeling against still current?\" - refresh the macro snapshot. |\n | [**sec-filings-deep-dive**](https://agent402.tools/skills/sec-filings-deep-dive) | $0.028 | Full EDGAR picture of one company: filings, key financial time series, insider trades, full-text search. |\n-| [**regulatory-watch**](https://agent402.tools/skills/regulatory-watch) | $0.023 | \"Who just filed / bought / IPO'd?\" - EDGAR full-text search, recent filings, Form 4s, 13F, IPO calendar. |\n+| [**regulatory-watch**](https://agent402.tools/skills/regulatory-watch) | $0.023 | \"Who just filed / bought / IPO'd?\" - EDGAR full-text search, recent filings, Form 4s, a reference 13F holdings report, IPO calendar. |\n | [**ipo-watch**](https://agent402.tools/skills/ipo-watch) | $0.023 | What's going public? Recent S-1/IPO filings from EDGAR plus a web search for IPO news. |\n | [**yield-dashboard**](https://agent402.tools/skills/yield-dashboard) | $0.014 | Current yield-curve snapshot: full Treasury curve, key spreads, and average rates. |\n | [**fixed-income-desk**](https://agent402.tools/skills/fixed-income-desk) | $0.017 | Read the rate environment and price a bond in one workflow: live Treasury curve, the recession-signal spread, inflation context, then bond price and yield at current rates. |\n@@ -114,7 +114,7 @@ Every pack is **also a single paid endpoint**, `POST /api/skill/{slug}`, which r\n | [**defi-protocol-scanner**](https://agent402.tools/skills/defi-protocol-scanner) | $0.025 | Due-diligence a DeFi protocol: live token price, market context, protocol TVL across chains, and recent news. |\n | [**defi-dashboard**](https://agent402.tools/skills/defi-dashboard) | $0.014 | DeFi overview: total TVL, ETH price, Base gas, and global crypto stats. |\n | [**nft-portfolio**](https://agent402.tools/skills/nft-portfolio) | $0.005 | NFT + wallet snapshot: NFT holdings, native balance, and ETH price for an address. |\n-| [**wallet-audit**](https://agent402.tools/skills/wallet-audit) | $0.005 | Full wallet review: balance, recent transactions, and token metadata for an address. |\n+| [**wallet-audit**](https://agent402.tools/skills/wallet-audit) | $0.005 | Full wallet review: balance, recent transactions, and metadata for a token the wallet holds. |\n | [**wallet-readiness**](https://agent402.tools/skills/wallet-readiness) | $0.008 | \"Can this wallet pay right now?\" USDC on Base + Solana, live Base gas, and an Onramp funding link. |\n | [**onchain-analyst**](https://agent402.tools/skills/onchain-analyst) | $0.030 | Ask Base anything in SQL - your query runs against indexed, decoded chain data. |\n | [**gas-optimizer**](https://agent402.tools/skills/gas-optimizer) | $0.007 | Find the cheapest gas: Base gas, Ethereum gas, Base fee estimate, and ETH price for USD conversion. |\n@@ -146,7 +146,7 @@ Every pack is **also a single paid endpoint**, `POST /api/skill/{slug}`, which r\n |---|---|---|\n | [**user-onboarding**](https://agent402.tools/skills/user-onboarding) | $0.008 | Take a signup form and run onboarding deterministically - validate, score, mint ID, slug, hash, verify 2FA. |\n | [**contact-verify**](https://agent402.tools/skills/contact-verify) | $0.004 | Verify an email is deliverable - syntax validation plus MX record check on the domain. |\n-| [**entity-enrich**](https://agent402.tools/skills/entity-enrich) | $0.022 | Company name to verified identity plus web footprint: Wikidata facts, the LEI legal-entity record, the SEC filer, domain registration, tech stack, and brand favicon. |\n+| [**entity-enrich**](https://agent402.tools/skills/entity-enrich) | $0.022 | A company name to its public records: Wikidata facts, the LEI legal-entity record and the SEC filer record, plus, when a domain is given, its registration, tech stack and favicon. |\n \n ## Location & time (5)\n \n@@ -169,7 +169,7 @@ Every pack is **also a single paid endpoint**, `POST /api/skill/{slug}`, which r\n \n | Pack | Price | What it solves |\n |---|---|---|\n-| [**search-and-cite**](https://agent402.tools/skills/search-and-cite) | $0.101 | Research a question, return an answer with citations - synthesized take + SERP + news, verified by fetch. |\n+| [**search-and-cite**](https://agent402.tools/skills/search-and-cite) | $0.101 | A cited answer to a question (model-backed) beside web and news results, then the top citation fetched and its entities extracted, so a claim can be traced to a page. |\n | [**article-digest**](https://agent402.tools/skills/article-digest) | $0.09 | Quick research brief on any topic - web search results plus an AI-generated answer. |\n | [**feed-watch**](https://agent402.tools/skills/feed-watch) | $0.016 | Monitor an RSS/Atom feed: parse it, read the top story in full, extract the keywords driving the cycle, and diff the item list against your last run to isolate what is new. |\n "},{"sha":"b709164dd7b4e1eb7d03945a749082d447a45bd5","filename":"wiki/_Sidebar.md","status":"modified","additions":2,"deletions":0,"changes":2,"blob_url":"https://github.com/MikeyPetrillo/Agent402/blob/81a674d1a3cf7fdbbcc04f4da366c144ccd393f7/wiki%2F_Sidebar.md","raw_url":"https://github.com/MikeyPetrillo/Agent402/raw/81a674d1a3cf7fdbbcc04f4da366c144ccd393f7/wiki%2F_Sidebar.md","contents_url":"https://api.github.com/repos/MikeyPetrillo/Agent402/contents/wiki%2F_Sidebar.md?ref=81a674d1a3cf7fdbbcc04f4da366c144ccd393f7","patch":"@@ -12,6 +12,8 @@\n - [[Ink (USDC)|Ink]]\n - [[Circle Gateway (batched USDC)|Circle-Gateway]]\n - [[Paying with Compute]]\n+- [[Buying at Volume|Buying-at-Volume]]\n+- [[Content Pipeline|Content-Pipeline]]\n - [[MCP Connector]]\n - [[Adapters]]\n - [[AWS Bedrock AgentCore]]"},{"sha":"aae77ef26daf41586aef8997ddb03cd1f36c04b0","filename":"workers/status-probe/src/index.js","status":"modified","additions":29,"deletions":0,"changes":29,"blob_url":"https://github.com/MikeyPetrillo/Agent402/blob/81a674d1a3cf7fdbbcc04f4da366c144ccd393f7/workers%2Fstatus-probe%2Fsrc%2Findex.js","raw_url":"https://github.com/MikeyPetrillo/Agent402/raw/81a674d1a3cf7fdbbcc04f4da366c144ccd393f7/workers%2Fstatus-probe%2Fsrc%2Findex.js","contents_url":"https://api.github.com/repos/MikeyPetrillo/Agent402/contents/workers%2Fstatus-probe%2Fsrc%2Findex.js?ref=81a674d1a3cf7fdbbcc04f4da366c144ccd393f7","patch":"@@ -489,6 +489,17 @@ export const ALARMS = [\n     body: () =>\n       \"The Tempo subscription gas sponsor (TEMPO_SUBSCRIPTION_FEE_PAYER_KEY) is below the low-water mark (TEMPO_SUBSCRIPTION_FEE_PAYER_LOW_USD, default $0.25) in PATHUSD - the token Tempo charges sponsored fees in, NOT the USDC.e the products are priced in. An empty sponsor fails subscription activations loudly (402, nobody charged) but sends RENEWALS to past_due, so existing subscribers keep being served for free until their grace window ends. Top up with fund-tempo-fee-payer.yml and token=pathusd.\",\n   },\n+  {\n+    title: \"Subscription gas sponsor CEILING reached\",\n+    // Our own 24 h ceiling on sponsored subscription sends: while it holds,\n+    // renewals are refused before broadcast and go past_due, so it pages.\n+    verdict: ({ gateway: b }) => {\n+      const w = b.subscriptionFeePayer?.ceiling;\n+      return w === \"reached\" ? \"bad\" : w === \"ok\" ? \"good\" : \"quiet\";\n+    },\n+    body: () =>\n+      \"The Tempo subscription gas sponsor reached its rolling 24 h ceiling (MPP_SUB_SPONSOR_DAILY_MAX_TX or MPP_SUB_SPONSOR_DAILY_MAX_USD, src/tempo-sponsor-ceiling.js): every sponsored send is refused before broadcast until the window rolls, so activations fail 402 (nobody charged) and RENEWALS go past_due, which means existing subscribers are served for free until their grace window ends. The server log names the knob that refused. Read the sponsored-send pattern before raising the knob on Railway; the issue closes when subscriptionFeePayer.ceiling reads ok.\",\n+  },\n   {\n     title: \"Postgres UNREACHABLE (leads/analytics)\",\n     verdict: ({ gateway: b }) => {\n@@ -563,6 +574,24 @@ The server log carries a [tweet-queue] line for every outcome (ids and status co\n       return `/api/gateway-status reports gatewayPending.status=${w}. unresolved: a batched payment Circle Gateway answered as pending is still waiting past its bound; the resolver reads it every ten minutes and keeps it until Gateway reports it settled or failed. Read it on /__operator/gateway-pending.json and look its nonce up in Gateway's transfer history. full: the pending book reached its bound and refused a new entry (the server log names it). A settled, unserved entry becomes an owed refund (refundsOwed). Auto-closes when the word is ok.`;\n     },\n   },\n+  {\n+    // EVM settlements that failed naming a transaction or an authorization\n+    // (src/late-settlements.js): the reconcile pass reads each on chain and\n+    // books a landed, unserved one as an owed debt (refundsOwed covers it).\n+    // unresolved (kept for a human, or outside the book) and full page; ok\n+    // and near_capacity clear (an operator resolution can leave the book near\n+    // its bound); unknown does neither. Same title as heartbeat.yml.\n+    title: \"Late settlements need attention\",\n+    verdict: ({ gateway: b }) => {\n+      const w = b.lateSettlements?.status;\n+      if (w === \"unresolved\" || w === \"full\") return \"bad\";\n+      return w === \"ok\" || w === \"near_capacity\" ? \"good\" : \"quiet\";\n+    },\n+    body: ({ gateway: b }) => {\n+      const w = b.lateSettlements?.status === \"full\" ? \"full\" : \"unresolved\";\n+      return `/api/gateway-status reports lateSettlements.status=${w}. unresolved: an EVM settlement that failed naming a transaction or an authorization could not be proven landed or absent within a day (or the reads kept failing) and is kept, never dropped; or a booking sits in the journal outside the book; or a booking could not be recorded anywhere in the last day. Unresolved entries are read on chain again every few hours and close themselves once the chain answers. Read them on /__operator/refunds.json (unconfirmedSettlements) and look each transaction up on the chain's explorer, then clear each one with POST /__operator/late-settlements: action resolve, the entry key, an outcome (booked_owed writes the refund debt, paid needs the refund transaction, dismissed when nothing moved to us) and a note saying what was checked. An unrecorded booking (the server log names it) is cleared with action acknowledge_unrecorded and a note. full: the book holds its bound of open entries, and new bookings wait in the journal until there is room (the server log names each). Auto-closes when the word is ok or near_capacity.`;\n+    },\n+  },\n   {\n     // A buyer paid and got an error. The server keeps the log and publishes one\n     // word (chargedFailures on /api/gateway-status, 402 refusals excluded); the"}]}
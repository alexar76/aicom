[{"sha":"3a67f9d5f8b789e039f3c1db98995c58d0f3825c","node_id":"C_kwDOS3Cu2doAKDNhNjdmOWQ1ZjhiNzg5ZTAzOWYzYzFkYjk4OTk1YzU4ZDBmMzgyNWM","commit":{"author":{"name":"mikeypetrillo","email":"22065635+MikeyPetrillo@users.noreply.github.com","date":"2026-11-06T16:01:44Z"},"committer":{"name":"mikeypetrillo","email":"22065635+MikeyPetrillo@users.noreply.github.com","date":"2026-11-06T16:01:44Z"},"message":"[test] Router buys on listed EVM chains with Base's guards\n\nThe x402 buyer pays sellers on Arc, Celo, Polygon, Arbitrum and Robinhood\nfrom the same spending wallet, each chain read from one table (asset,\ndecimals, EIP-712 domain) and dispatched only while SOR_EVM_CHAINS lists it.\nEvery listed chain gets the domain check, split-price refusal, evidence\nwallets, capped validity, signed-amount assert, chain-truth refusal read,\nits own 24 h wallet ceiling and low-balance refusal; upstreamBuyerEvm\nreports one word per chain. The unproven tier stays Base only.\n\nCo-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>\nClaude-Session: https://claude.ai/code/session_01MJsJ3X7Eyba5aAYMD5CSsc","tree":{"sha":"e162b6e55bc0033602a16ea345b263342f36b77c","url":"https://api.github.com/repos/MikeyPetrillo/Agent402/git/trees/e162b6e55bc0033602a16ea345b263342f36b77c"},"url":"https://api.github.com/repos/MikeyPetrillo/Agent402/git/commits/3a67f9d5f8b789e039f3c1db98995c58d0f3825c","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/MikeyPetrillo/Agent402/commits/3a67f9d5f8b789e039f3c1db98995c58d0f3825c","html_url":"https://github.com/MikeyPetrillo/Agent402/commit/3a67f9d5f8b789e039f3c1db98995c58d0f3825c","comments_url":"https://api.github.com/repos/MikeyPetrillo/Agent402/commits/3a67f9d5f8b789e039f3c1db98995c58d0f3825c/comments","author":{"login":"MikeyPetrillo","id":22065635,"node_id":"MDQ6VXNlcjIyMDY1NjM1","avatar_url":"https://avatars.githubusercontent.com/u/22065635?v=4","gra
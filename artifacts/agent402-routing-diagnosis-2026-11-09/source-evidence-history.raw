38373db83b800d6cd8f561da","html_url":"https://github.com/MikeyPetrillo/Agent402/commit/b3eb480c894e174b38373db83b800d6cd8f561da"}]},{"sha":"8b8a4cee0ca939af69856ddedafa85cb0303e044","node_id":"C_kwDOS3Cu2doAKDhiOGE0Y2VlMGNhOTM5YWY2OTg1NmRkZWRhZmE4NWNiMDMwM2UwNDQ","commit":{"author":{"name":"mikeypetrillo","email":"22065635+MikeyPetrillo@users.noreply.github.com","date":"2026-10-29T01:06:34Z"},"committer":{"name":"mikeypetrillo","email":"22065635+MikeyPetrillo@users.noreply.github.com","date":"2026-10-29T01:06:34Z"},"message":"[test] Leave the router's own purchases out of a seller's proof\n\nThe settlement floor reads three sources, and only the leaderboard fold\nleft our wallets out. The merchant SQL behind the chain join now excludes\nthem; the Solana credit rule treats a debit from one of our wallets like\nthe seller's own; and the router records each purchase it makes (origin,\nwallet it paid, chain) in a state document, which the evidence binding\ndeducts from an origin's Bazaar figures at that wallet. A payer figure\nmeasured as zero now folds as evidence, so it refuses at the breadth\nfloor instead of reading as unknown.\n\nCo-Authored-By: Claude Fable 5.1 <noreply@anthropic.com>\nClaude-Session: https://claude.ai/code/session_01MJsJ3ZoEbJJk6ft8CPDQAS","tree":{"sha":"94137954148bb9468aa25d072023907f2b69528a","url":"https://api.github.com/repos/MikeyPetrillo/Agent402/git/trees/94137954148bb9468aa25d072023907f2b69528a"},"url":"https://api.github.com/repos/MikeyPetrillo/Agent402/git/commits/8b8a4cee0ca939af69856ddedafa85cb0303e044","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/MikeyPetrillo/Agent402/commits/8b8a4cee0ca939af69856ddedafa85cb0303e044","html_url":"https://github.com/MikeyPetrillo/Agent402/commit/8b8a4cee0ca939af69856ddedafa85cb0303e044","comments_url":"https://api.github.com/repos/MikeyPetrillo/Agent402/commits/8b8a4cee0ca939af69856ddedafa85cb0303e044/comments","author":{"login":"MikeyPetrillo","id":22065635,"node_id":"MDQ6VXNlcjIyMDY1NjM1","avatar_url":"https://avatars.githubusercontent.com/u/22065635?v=4","gravatar_id":"","url":"https://api.github.com/users/MikeyPetrillo","html_url":"https://github.com/MikeyPetrillo","followers_url":"https://api.github.com/users/MikeyPetrillo/followers","following_url":"https://api.github.com/users/MikeyPetrillo/following{/other_user}","gists_url":"https://api.github.com/users/MikeyPetrillo/gists{/gist_id}","starred_url":"https://api.github.com/users/MikeyPetrillo/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/MikeyPetrillo/subscriptions","organizations_url":"https://api.github.com/users/MikeyPetrillo/orgs","repos_url":"https://api.github.com/users/MikeyPetrillo/repos","events_url":"https://api.github.com/users/MikeyPetrillo/events{/privacy}","received_events_url":"https://api.github.com/users/MikeyPetrillo/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"MikeyPetrillo","id":22065635,"node_id":"MDQ6VXNlcjIyMDY1NjM1","avatar_url":"https://avatars.githubusercontent.com/u/22065635?v=4","gravatar_id":"","url":"https://api.github.com/users/MikeyPetrillo","html_url":"https://github.com/MikeyPetrillo","followers_url":"https://api.github.com/users/MikeyPetrillo/followers","following_url":"https://api.github.com/users/MikeyPetrillo/following{/other_user}","gists_url":"https://api.github.com/users/MikeyPetrillo/gists{/gist_id}","starred_url":"https://api.github.com/users/MikeyPetrillo/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/MikeyPetrillo/subscriptions","organizations_url":"https://api.github.com/users/MikeyPetrillo/orgs","repos_url":"https://api.github.com/users/MikeyPetrillo/repos","events_url":"https://api.github.com/users/MikeyPetrillo/events{/privacy}","received_events_url":"https://api.github.com/users/MikeyPetrillo/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"15abbadd363998357c51ef74670264b451512414","url":"https://api.github.com/repos/MikeyPetrillo/Agent402/commits/15abbadd363998357c51ef74670264b451512414","html_url":"https://github.com/MikeyPetrillo/Agent402/commit/15abbadd363998357c51ef74670264b451512414"}]}]
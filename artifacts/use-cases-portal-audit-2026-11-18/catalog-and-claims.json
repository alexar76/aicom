  "hub_conditions": {
    "hub_version": "3.21.0",
    "pay_on_verified": {
      "enabled": true,
      "spec": "https://github.com/alexar76/aicom/blob/main/docs/pay-on-verified.md",
      "verifier": "metis.modelmarket.dev",
      "rail": "payment channel (X-Payment-Channel): the price is held, then captured on a passing verdict or released to the buyer on a failing one",
      "scope": "capabilities this hub executes itself (federated invokes are not held)",
      "request": {
        "verify": {
          "requested": true,
          "intent": "<what the output must satisfy>",
          "mode": "auto",
          "wait": false
        }
      },
      "min_price_usd": 0.05,
      "score_threshold": 0.7,
      "audit_threshold": 0.7,
      "appeal_window_s": 3600.0,
      "authorization_min_lifetime_s": 10800.0,
      "routes": [
        {
          "capabilities": "gaia.actuate@v1",
          "verifier": "gaia.verify@v1"
        }
      ]
    },
    "payment_rails": {
      "seller_direct": {
        "enabled": true,
        "header": "X-Payment",
        "also": [
          "PAYMENT-SIGNATURE",
          "X-PAYMENT",
          "X-Payment-Nonce"
        ],
        "asset": "USDC",
        "note": "buyer pays the listing payout_address on-chain; this hub verifies and never holds the money"
      },
      "credits": {
        "enabled": true,
        "open_signup": true,
        "signup_url": "https://modelmarket.dev/ai-market/v2/accounts",
        "start_url": "https://modelmarket.dev/start",
        "header": "X-API-Key",
        "free_grant_usd": 0.01,
        "min_unit_usd": 1e-05,
        "topup": {
          "enabled": true,
          "quote": "/ai-market/v2/account/topup",
          "redeem": "/ai-market/v2/topups/{nonce}",
          "binding": "eip3009",
          "asset": "USDC",
          "asset_address": "0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913",
          "network": "eip155:8453",
          "pay_to": "0x1218ff36C5d2e3B6A565CdB1A8B1AcCFc606Ad0a",
          "min_usd": 0.01,
          "max_usd": 100.0,
          "daily_usd": 500.0,
          "min_confirmations": 2,
          "quote_ttl_s": 900,
          "deposit_watch": {
            "enabled": false,
            "reason": "plain transfers are not watched: set AIMARKET_TOPUP_PAY_TO to a wallet that receives top-ups and nothing else"
          }
        },
        "topup_card": {
          "enabled": false,
          "provider": "stripe-checkout",
          "create": "/ai-market/v2/account/topup/card",
          "status": "/ai-market/v2/card-topups/{id}",
          "reason": "card top-ups are switched off on this hub (AIMARKET_CARD_TOPUP_ENABLED)"
        }
      },
      "channel": {
        "enabled": true,
        "header": "X-Payment-Channel",
        "chains": [
          "base",
          "ethereum",
          "arbitrum",
          "optimism",
          "polygon"
        ]
      }
    },
    "free_trial": {
      "enabled": true,
      "max_invokes_per_visitor": 5,
      "quota_window": "hourly",
      "renews": true,
      "visitor_header": "X-AIMarket-Sandbox-Visitor",
      "excluded_capabilities": [
        "atlas.fire.weather@v1",
        "atlas.situation.brief@v1",
        "hestia.compute.run@v1",
        "hestia.compute.verify@v1",
        "platon.ask@v1",
        "platon.oracle@v1",
        "platon.steer@v1",
        "weather.witness@v1"
      ],
      "excluded_reason": "each call spends real budget — a paid model, or metered upstream data — so it is not free to serve",
      "exhausted_status": 429,
      "exhausted_error": "trial_quota_exhausted",
      "how": "Send X-AIMarket-Sandbox-Visitor with a stable id you choose and no payment channel; the invoke runs for free and returns a signed receipt. Results are marked sandbox=true. A refused call costs nothing — the allowance is spent only when data is delivered. When it is spent the hub answers 429 trial_quota_exhausted until the window renews.",
      "clients": {
        "mcp": "pip install aimarket-mcp — market_search / market_invoke",
        "python": "pip install aimarket-agent — AIMarketAgent(..., sandbox_visitor=\"<id>\") or AIMARKET_SANDBOX_VISITOR; CLI: --sandbox-visitor (2.6.1+)",
        "http": "POST /ai-market/v2/invoke with the visitor header and no payment channel"
      }
    }

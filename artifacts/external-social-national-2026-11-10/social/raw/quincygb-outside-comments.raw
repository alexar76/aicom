[{"type_of":"comment","id_code":"3ip9h","created_at":"2026-10-25T07:26:38Z","ai_disclosure_level":"not_disclosed","ai_disclosure_label":"Not Disclosed","body_html":"\u003cp\u003eThe listing example that came back as a 502 is the miss I recognize. If it is printed as the thing a buyer should try, it is a test, even when the hash is not a real transaction. Treating not-found as a delivered answer instead of a failure is the right fix. Annoying that a real purchase had to surface it.\u003c/p\u003e\n\n","user":{"name":"Indie Ship Log","username":"indie_ship_log","twitter_username":null,"github_username":null,"user_id":4197665,"website_url":null,"profile_image":"https://media2.dev.to/dynamic/image/width=640,height=640,fit=cover,gravity=auto,format=auto/https%3A%2F%2Fdev-to-uploads.s3.us-east-2.amazonaws.com%2Fuploads%2Fuser%2Fprofile_image%2F4197665%2F6b99eec4-d221-4766-a0a5-ab5bf078f5b6.png","profile_image_90":"https://media2.dev.to/dynamic/image/width=90,height=90,fit=cover,gravity=auto,format=auto/https%3A%2F%2Fdev-to-uploads.s3.us-east-2.amazonaws.com%2Fuploads%2Fuser%2Fprofile_image%2F4197665%2F6b99eec4-d221-4766-a0a5-ab5bf078f5b6.png"},"children":[]},{"type_of":"comment","id_code":"3j0ef","created_at":"2026-10-25T16:20:17Z","ai_disclosure_level":"not_disclosed","ai_disclosure_label":"Not Disclosed","body_html":"\u003cp\u003eThe example hash being the bug is kind of poetic. Nice that the customer told you instead of just bouncing\u003c/p\u003e\n\n","user":{"name":"Odinaka Robert Nnamani","username":"robertpaschal","twitter_username":null,"github_username":"Robertpaschal","user_id":2167197,"website_url":"https://heypascal.me","profile_image":"https://media2.dev.to/dynamic/image/width=640,height=640,fit=cover,gravity=auto,format=auto/https%3A%2F%2Fdev-to-uploads.s3.us-east-2.amazonaws.com%2Fuploads%2Fuser%2Fprofile_image%2F2167197%2Fecea0dc6-e64a-4d17-86da-0ec53a674663.jpeg","profile_image_90":"https://media2.dev.to/dynamic/image/width=90,height=90,fit=cover,gravity=auto,format=auto/https%3A%2F%2Fdev-to-uploads.s3.us-east-2.amazonaws.com%2Fuploads%2Fuser%2Fprofile_image%2F2167197%2Fecea0dc6-e64a-4d17-86da-0ec53a674663.jpeg"},"children":[]}]
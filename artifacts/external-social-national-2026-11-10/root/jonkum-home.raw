le-system, BlinkMacSystemFont, &quot;Segoe UI&quot;, Roboto, Helvetica, Arial, sans-serif;background-color:var(--l-bg);color:var(--l-text);overflow-x:clip" class="landing-root min-h-screen antialiased selection:bg-[var(--l-accent-dim)]"><a href="#main" class="sr-only focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-50 focus:rounded focus:bg-[var(--l-surface-2)] focus:px-3 focus:py-2 focus:text-sm">Skip to content</a><main id="main"><div class="relative overflow-hidden"><div aria-hidden="true" class="pointer-events-none absolute inset-0" style="background-image:linear-gradient(var(--l-line) 1px, transparent 1px), linear-gradient(90deg, var(--l-line) 1px, transparent 1px);background-size:72px 72px;mask-image:radial-gradient(ellipse 90% 70% at 50% 0%, black 30%, transparent 75%);-webkit-mask-image:radial-gradient(ellipse 90% 70% at 50% 0%, black 30%, transparent 75%)"></div><div aria-hidden="true" class="pointer-events-none absolute left-1/2 top-[-240px] h-[480px] w-[720px] max-w-[150vw] -translate-x-1/2 rounded-full" style="background:radial-gradient(closest-side, rgba(124,199,255,0.10), transparent)"></div><section class="mx-auto w-full max-w-6xl px-5 sm:px-8 relative flex min-h-[92vh] flex-col justify-center py-24"><div style="opacity:0;transform:translateY(18px)"><p class="font-mono text-[11px] tracking-wide text-[var(--l-faint)] sm:text-xs" aria-label="jonathan kumin · full-stack developer · AI engineer — available for work"><span aria-hidden="true"><span class="text-[var(--l-accent)]">➜</span> <span class="text-[var(--l-accent)]">▋</span></span></p></div><h1 class="mt-7 max-w-5xl text-[clamp(2.6rem,7vw,6rem)] font-bold leading-[0.98] tracking-[-0.03em] text-[var(--l-text)]" style="opacity:0;transform:translateY(18px)">I build production<br/><span class="text-[var(--l-accent)]">AI systems</span>.</h1><p class="mt-7 max-w-2xl text-[15px] leading-relaxed text-[var(--l-muted)] sm:text-base md:text-lg" style="opacity:0;transform:translateY(18px)"><span class="font-medium text-[var(--l-text)]">Jonathan Kumin</span> — <!-- -->Senior Engineer, AI Platforms at Signature Aviation — building production AI systems. Previously AI Engineer at JOANN Stores, after a decade leading SEO and marketing engineering across retail and e-commerce.<!-- --> I work end to end, from in-house models to the tools and platforms around them — including<!-- --> <a class="text-[var(--l-text)] underline decoration-[var(--l-accent-dim)] underline-offset-2 hover:decoration-[var(--l-accent)]" href="/nextos">NextOS</a>, a full operating system I built to run in a browser tab.</p><div class="mt-9 flex flex-wrap items-center gap-4" style="opacity:0;transform:translateY(18px)"><a href="#work" class="inline-flex items-center gap-2 rounded-lg bg-[var(--l-text)] px-6 py-3.5 text-[15px] font-semibold text-[#0a0c10] transition-transform hover:-translate-y-0.5 active:translate-y-0 focus:outline-none focus-visible:ring-2 focus-visible:ring-[var(--l-accent)]">See my work<span aria-hidden="true" class="font-mono text-xs opacity-60">↓</span></a><a class="group inline-flex items-center gap-2 rounded-lg border border-[var(--l-line)] px-6 py-3.5 text-[15px] font-medium text-[var(--l-muted)] transition-colors hover:border-[var(--l-accent)] hover:text-[var(--l-text)] focus:outline-none focus-visible:ring-2 focus-visible:ring-[var(--l-accent)]" href="/nextos">Explore NextOS<span aria-hidden="true" class="transition-transform group-hover:translate-x-0.5">↗</span></a><a class="inline-flex items-center gap-2 px-2 py-3.5 text-[15px] font-medium text-[var(--l-muted)] transition-colors hover:text-[var(--l-text)] focus:outline-none focus-visible:ring-2 focus-visible:ring-[var(--l-accent)]" href="/os">or boot it<span aria-hidden="true" class="font-mono text-xs opacity-60">⏎</span></a></div><dl class="mt-14 grid max-w-3xl grid-cols-2 gap-x-10 gap-y-6 border-t border-[var(--l-line)] pt-7 sm:mt-16 sm:grid-cols-4" style="opacity:0;transform:translateY(18px)"><div title="SEO and marketing engineering through AI platforms" class="group cursor-default"><dt class="order-2 text-[12px] uppercase tracking-wider text-[var(--l-faint)] transition-colors group-hover:text-[var(--l-muted)]">years shipping software</dt><dd class="font-mono text-2xl font-medium text-[var(--l-text)]">10+</dd></div><div title="counted in apps/registry.ts" class="group cursor-default"><dt class="order-2 text-[12px] uppercase tracking-wider text-[var(--l-faint)] transition-colors group-hover:text-[var(--l-muted)]">apps in NextOS, built solo</dt><dd class="font-mono text-2xl font-medium text-[var(--l-text)]">44</dd></div><div title="Anthropic, OpenAI, Mistral, Perplexity, Ollama" class="group cursor-default"><dt class="order-2 text-[12px] uppercase tracking-wider text-[var(--l-faint)] transition-colors group-hover:text-[var(--l-muted)]">model providers integrated</dt><dd class="font-mono text-2xl font-medium text-[var(--l-text)]">5</dd></div><div title="Senior Engineer, AI Platforms at Signature Aviation — building production AI systems. Previously AI Engineer at JOANN Stores, after a decade leading SEO and marketing engineering across retail and e-commerce." class="group cursor-default"><dt class="order-2 text-[12px] uppercase tracking-wider text-[var(--l-faint)] transition-colors group-hover:text-[var(--l-muted)]">web OS, in a browser tab</dt><dd class="font-mono text-2xl font-medium text-[var(--l-text)]">1</dd></div></dl></section></div><section id="work" class="mx-auto w-full max-w-6xl px-5 sm:px-8 py-28 sm:py-32"><p class="mb-4 flex items-center gap-3 text-[11px] font-semibold uppercase tracking-[0.22em] text-[var(--l-faint)]"><span class="text-[var(--l-accent)]">01</span><span aria-hidden="true" class="h-px w-8 bg-[var(--l-line)]"></span>Selected work</p><div class="flex flex-wrap items-end justify-between gap-x-10 gap-y-4"><h2 class="text-[clamp(1.8rem,4vw,3rem)] font-semibold leading-[1.08] tracking-tight">Shipped systems,<br/><span class="text-[var(--l-muted)]">not slideware.</span></h2><p class="max-w-sm pb-1.5 text-sm leading-relaxed text-[var(--l-muted)]">A few projects spanning AI content systems, SEO tooling, and production ML infrastructure.</p></div><div class="mt-14 border-t border-[var(--l-line)]"><div style="opacity:0;transform:translateY(20px)"><article class="group border-b border-[var(--l-line)] py-10 sm:py-12"><div class="grid gap-x-10 gap-y-6 lg:grid-cols-[88px_1.35fr_1fr]"><div aria-hidden="true" class="hidden select-none lg:block"><span class="font-mono text-5xl font-light leading-none text-[var(--l-text)] opacity-[0.08] transition-opacity duration-500 group-hover:opacity-25">01</span></div><div><p class="font-mono text-[11px] uppercase tracking-[0.18em] text-[var(--l-faint)]"><span class="lg:hidden">01<!-- --> · </span>2024</p><h3 class="mt-2 text-xl font-semibold tracking-tight text-[var(--l-text)] sm:text-2xl">CreAIt: AI-Powered Content &amp; SEO Platform</h3><p class="mt-3 max-w-xl text-[14.5px] leading-relaxed text-[var(--l-muted)]">Jonathan&#x27;s newest venture, CreAIt, leverages AI and Marketing Data Warehouses to automate content strategy and creation. It analyzes competitor content, identifies gaps, and generates SEO-optimized content. The platform features advanced RAG integration and custom fine-tuned models for Enterprise clients, delivering consistent, high-quality content at scale.</p><div class="mt-4 flex max-w-xl flex-wrap gap-1.5"><span class="rounded border border-[var(--l-line)] px-2 py-0.5 font-mono text-[10.5px] text-[var(--l-faint)] transition-colors group-hover:border-white/15">Python</span><span class="rounded border border-[var(--l-line)] px-2 py-0.5 font-mono text-[10.5px] text-[var(--l-faint)] transition-colors group-hover:border-white/15">TensorFlow</span><span class="rounded border border-[var(--l-line)] px-2 py-0.5 font-mono text-[10.5px] text-[var(--l-faint)] transition-colors group-hover:border-white/15">RAG</span><span class="rounded border border-[var(--l-line)] px-2 py-0.5 font-mono text-[10.5px] text-[var(--l-faint)] transition-colors group-hover:border-white/15">React</span><span class="rounded border border-[var(--l-line)] px-2 py-0.5 font-mono text-[10.5px] text-[var(--l-faint)] transition-colors group-hover:border-white/15">Next.js</span><span class="rounded border border-[var(--l-line)] px-2 py-0.5 font-mono text-[10.5px] text-[var(--l-faint)] transition-colors group-hover:border-white/15">Marketing Data Warehouses</span><span class="rounded border border-[var(--l-line)] px-2 py-0.5 font-mono text-[10.5px] text-[var(--l-faint)] transition-colors group-hover:border-white/15">PostgreSQL</span><span class="rounded border border-[var(--l-line)] px-2 py-0.5 font-mono text-[10.5px] text-[var(--l-faint)] transition-colors group-hover:border-white/15">Redis</span></div><div class="mt-6 flex flex-wrap items-center gap-5"><a href="https://www.creait.ai" target="_blank" rel="noopener noreferrer" class="group/link inline-flex items-center gap-1.5 text-sm font-medium text-[var(--l-accent)] focus:outline-none focus-visible:ring-1 focus-visible:ring-[var(--l-accent)]">creait.ai<span aria-hidden="true" class="inline-block transition-transform duration-300 group-hover/link:translate-x-0.5 group-hover/link:-translate-y-0.5">↗</span></a><button aria-expanded="false" class="inline-flex min-h-[40px] items-center gap-1.5 text-sm text-[var(--l-faint)] transition-colors hover:text-[var(--l-text)] focus:outline-none focus-visible:ring-1 focus-visible:ring-[var(--l-accent)]">Case study<svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-chevron-down transition-transform duration-300 " aria-hidden="true"><path d="m6 9 6 6 6-6"></path></svg></button></div></div><dl class="grid grid-cols-2 content-start gap-x-8 gap-y-6 border-t border-[var(--l-line)] pt-6 lg:border-l lg:border-t-0 lg:pl-10 lg:pt-1"><div><dd class="font-mono text-[26px] font-medium leading-none text-[var(--l-text)]">95<span class="ml-0.5 text-[13px] text-[var(--l-faint)]">%</span></dd><dt class="mt-1.5 text-[11px] leading-tight text-[var(--l-faint)]">Content Efficiency</dt></div><div><dd class="font-mono text-[26px] font-medium leading-none text-[var(--l-text)]">90<span class="ml-0.5 text-[13px] text-[var(--l-faint)]">%</span></dd><dt class="mt-1.5 text-[11px] leading-tight text-[var(--l-faint)]">SEO Performance</dt></div><div><dd class="font-mono text-[26px] font-medium leading-none text-[var(--l-text)]">92<span class="ml-0.5 text-[13px] text-[var(--l-faint)]">%</span></dd><dt class="mt-1.5 text-[11px] leading-tight text-[var(--l-faint)]">Client Satisfaction</dt></div><div><dd class="font-mono text-[26px] font-medium leading-none text-[var(--l-text)]">85<span class="ml-0.5 text-[13px] text-[var(--l-faint)]">%</span></dd><dt class="mt-1.5 text-[11px] leading-tight text-[var(--l-faint)]">Time Saved</dt></div></dl></div></article></div><div style="opacity:0;transform:translateY(20px)"><article class="group border-b border-[var(--l-line)] py-10 sm:py-12"><div class="grid gap-x-10 gap-y-6 lg:grid-cols-[88px_1.35fr_1fr]"><div aria-hidden="true" class="hidden select-none lg:block"><span class="font-mono text-5xl font-light leading-none text-[var(--l-text)] opacity-[0.08] transition-opacity duration-500 group-hover:opacity-25">02</span></div><div><p class="font-mono text-[11px] uppercase tracking-[0.18em] text-[var(--l-faint)]"><span class="lg:hidden">02<!-- --> · </span>2020</p><h3 class="mt-2 text-xl font-semibold tracking-tight text-[var(--l-text)] sm:text-2xl">GPT-3 Powered SEO Tools for Giant Vapes</h3><p class="mt-3 max-w-xl text-[14.5px] leading-relaxed text-[var(--l-muted)]">Pioneering implementation of GPT-3 powered SEO tools during its closed beta phase, specifically designed to leverage BERT&#x27;s natural language understanding capabilities. The system automatically generates and optimizes product descriptions, category pages, and technical content, resulting in significant organic traffic improvements.</p><div class="mt-4 flex max-w-xl flex-wrap gap-1.5"><span class="rounded border border-[var(--l-line)] px-2 py-0.5 font-mono text-[10.5px] text-[var(--l-faint)] transition-colors group-hover:border-white/15">Python</span><span class="rounded border border-[var(--l-line)] px-2 py-0.5 font-mono text-[10.5px] text-[var(--l-faint)] transition-colors group-hover:border-white/15">GPT-3</span><span class="rounded border border-[var(--l-line)] px-2 py-0.5 font-mono text-[10.5px] text-[var(--l-faint)] transition-colors group-hover:border-white/15">BERT</span><span class="rounded border border-[var(--l-line)] px-2 py-0.5 font-mono text-[10.5px] text-[var(--l-faint)] transition-colors group-hover:border-white/15">FastAPI</span><span class="rounded border border-[var(--l-line)] px-2 py-0.5 font-mono text-[10.5px] text-[var(--l-faint)] transition-colors group-hover:border-white/15">Redis</span><span class="rounded border border-[var(--l-line)] px-2 py-0.5 font-mono text-[10.5px] text-[var(--l-faint)] transition-colors group-hover:border-white/15">PostgreSQL</span><span class="rounded border border-[var(--l-line)] px-2 py-0.5 font-mono text-[10.5px] text-[var(--l-faint)] transition-colors group-hover:border-white/15">Elasticsearch</span><span class="rounded border border-[var(--l-line)] px-2 py-0.5 font-mono text-[10.5px] text-[var(--l-faint)] transition-colors group-hover:border-white/15">Docker</span></div><div class="mt-6 flex flex-wrap items-center gap-5"><a href="https://www.giantvapes.com" target="_blank" rel="noopener noreferrer" class="group/link inline-flex items-center gap-1.5 text-sm font-medium text-[var(--l-accent)] focus:outline-none focus-visible:ring-1 focus-visible:ring-[var(--l-accent)]">giantvapes.com<span aria-hidden="true" class="inline-block transition-transform duration-300 group-hover/link:translate-x-0.5 group-hover/link:-translate-y-0.5">↗</span></a><button aria-expanded="false" class="inline-flex min-h-[40px] items-center gap-1.5 text-sm text-[var(--l-faint)] transition-colors hover:text-[var(--l-text)] focus:outline-none focus-visible:ring-1 focus-visible:ring-[var(--l-accent)]">Case study<svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-chevron-down transition-transform duration-300 " aria-hidden="true"><path d="m6 9 6 6 6-6"></path></svg></button></div></div><dl class="grid grid-cols-2 content-start gap-x-8 gap-y-6 border-t border-[var(--l-line)] pt-6 lg:border-l lg:border-t-0 lg:pl-10 lg:pt-1"><div><dd class="font-mono text-[26px] font-medium leading-none text-[var(--l-text)]">85<span class="ml-0.5 text-[13px] text-[var(--l-faint)]">%</span></dd><dt class="mt-1.5 text-[11px] leading-tight text-[var(--l-faint)]">Search Visibility Boost</dt></div><div><dd class="font-mono text-[26px] font-medium leading-none text-[var(--l-text)]">92<span class="ml-0.5 text-[13px] text-[var(--l-faint)]">%</span></dd><dt class="mt-1.5 text-[11px] leading-tight text-[var(--l-faint)]">Organic Traffic Increase</dt></div><div><dd class="font-mono text-[26px] font-medium leading-none text-[var(--l-text)]">95<span class="ml-0.5 text-[13px] text-[var(--l-faint)]">%</span></dd><dt class="mt-1.5 text-[11px] leading-tight text-[var(--l-faint)]">Content Generation Speed</dt></div><div><dd class="font-mono text-[26px] font-medium leading-none text-[var(--l-text)]">88<span class="ml-0.5 text-[13px] text-[var(--l-faint)]">%</span></dd><dt class="mt-1.5 text-[11px] leading-tight text-[var(--l-faint)]">Conversion Rate Improvement</dt></div></dl></div></article></div><div style="opacity:0;transform:translateY(20px)"><article class="group border-b border-[var(--l-line)] py-10 sm:py-12"><div class="grid gap-x-10 gap-y-6 lg:grid-cols-[88px_1.35fr_1fr]"><div aria-hidden="true" class="hidden select-none lg:block"><span class="font-mono text-5xl font-light leading-none text-[var(--l-text)] opacity-[0.08] transition-opacity duration-500 group-hover:opacity-25">03</span></div><div><p class="font-mono text-[11px] uppercase tracking-[0.18em] text-[var(--l-faint)]"><span class="lg:hidden">03<!-- --> · </span>2024</p><h3 class="mt-2 text-xl font-semibold tracking-tight text-[var(--l-text)] sm:text-2xl">AI Architecture at JOANN Stores</h3><p class="mt-3 max-w-xl text-[14.5px] leading-relaxed text-[var(--l-muted)]">As AI Architect at JOANN Stores, pioneered the implementation of cutting-edge AI solutions including Mamba and Liquid Neural Networks for efficient, lightweight inference. Developed systems for inventory optimization, customer behavior analysis, and personalized recommendations.</p><div class="mt-4 flex max-w-xl flex-wrap gap-1.5"><span class="rounded border border-[var(--l-line)] px-2 py-0.5 font-mono text-[10.5px] text-[var(--l-faint)] transition-colors group-hover:border-white/15">Python</span><span class="rounded border border-[var(--l-line)] px-2 py-0.5 font-mono text-[10.5px] text-[var(--l-faint)] transition-colors group-hover:border-white/15">Mamba</span><span class="rounded border border-[var(--l-line)] px-2 py-0.5 font-mono text-[10.5px] text-[var(--l-faint)] transition-colors group-hover:border-white/15">Liquid Neural Networks</span><span class="rounded border border-[var(--l-line)] px-2 py-0.5 font-mono text-[10.5px] text-[var(--l-faint)] transition-colors group-hover:border-white/15">PyTorch</span><span class="rounded border border-[var(--l-line)] px-2 py-0.5 font-mono text-[10.5px] text-[var(--l-faint)] transition-colors group-hover:border-white/15">Kubernetes</span><span class="rounded border border-[var(--l-line)] px-2 py-0.5 font-mono text-[10.5px] text-[var(--l-faint)] transition-colors group-hover:border-white/15">AWS</span><span class="rounded border border-[var(--l-line)] px-2 py-0.5 font-mono text-[10.5px] text-[var(--l-faint)] transition-colors group-hover:border-white/15">MLflow</span><span class="rounded border border-[var(--l-line)] px-2 py-0.5 font-mono text-[10.5px] text-[var(--l-faint)] transition-colors group-hover:border-white/15">Apache Kafka</span></div><div class="mt-6 flex flex-wrap items-center gap-5"><a href="https://www.joann.com" target="_blank" rel="noopener noreferrer" class="group/link inline-flex items-center gap-1.5 text-sm font-medium text-[var(--l-accent)] focus:outline-none focus-visible:ring-1 focus-visible:ring-[var(--l-accent)]">joann.com<span aria-hidden="true" class="inline-block transition-transform duration-300 group-hover/link:translate-x-0.5 group-hover/link:-translate-y-0.5">↗</span></a><button aria-expanded="false" class="inline-flex min-h-[40px] items-center gap-1.5 text-sm text-[var(--l-faint)] transition-colors hover:text-[var(--l-text)] focus:outline-none focus-visible:ring-1 focus-visible:ring-[var(--l-accent)]">Case study<svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-chevron-down transition-transform duration-300 " aria-hidden="true"><path d="m6 9 6 6 6-6"></path></svg></button></div></div><dl class="grid grid-cols-2 content-start gap-x-8 gap-y-6 border-t border-[var(--l-line)] pt-6 lg:border-l lg:border-t-0 lg:pl-10 lg:pt-1"><div><dd class="font-mono text-[26px] font-medium leading-none text-[var(--l-text)]">96<span class="ml-0.5 text-[13px] text-[var(--l-faint)]">%</span></dd><dt class="mt-1.5 text-[11px] leading-tight text-[var(--l-faint)]">Inference Speed</dt></div><div><dd class="font-mono text-[26px] font-medium leading-none text-[var(--l-text)]">94<span class="ml-0.5 text-[13px] text-[var(--l-faint)]">%</span></dd><dt class="mt-1.5 text-[11px] leading-tight text-[var(--l-faint)]">Model Accuracy</dt></div><div><dd class="font-mono text-[26px] font-medium leading-none text-[var(--l-text)]">98<span class="ml-0.5 text-[13px] text-[var(--l-faint)]">%</span></dd><dt class="mt-1.5 text-[11px] leading-tight text-[var(--l-faint)]">System Reliability</dt></div><div><dd class="font-mono text-[26px] font-medium leading-none text-[var(--l-text)]">92<span class="ml-0.5 text-[13px] text-[var(--l-faint)]">%</span></dd><dt class="mt-1.5 text-[11px] leading-tight text-[var(--l-faint)]">Resource Efficiency</dt></div></dl></div></article></div></div><p class="mt-5 font-mono text-[10.5px] leading-relaxed text-[var(--l-faint)]">Figures are Jonathan’s own reported results, rendered verbatim from the same data module the MCP server exposes.</p></section><section class="mx-auto w-full max-w-6xl px-5 sm:px-8 py-28 sm:py-32"><p class="mb-4 flex items-center gap-3 text-[11px] font-semibold uppercase tracking-[0.22em] text-[var(--l-faint)]"><span class="text-[var(--l-accent)]">02</span><span aria-hidden="true" class="h-px w-8 bg-[var(--l-line)]"></span>The road here</p><div class="grid gap-16 lg:grid-cols-[1fr_1.3fr]"><div class="lg:sticky lg:top-24 lg:self-start"><h2 class="text-[clamp(1.8rem,4vw,3rem)] font-semibold leading-[1.08] tracking-tight">A decade of search,<br/><span class="text-[var(--l-muted)]">then the models caught up.</span></h2><p class="mt-6 max-w-sm text-[15px] leading-relaxed text-[var(--l-muted)]">Over a decade across SEO, marketing, and now AI engineering.<!-- --> The through-line: shipping GPT-3 tools in its closed beta, building in-house models at a Fortune-scale retailer, and now AI platforms for aviation.</p><div class="mt-10"><div class="grid grid-cols-[104px_1fr] items-baseline gap-x-4 border-t border-[var(--l-line)] py-3"><span class="text-[11px] font-semibold uppercase tracking-[0.14em] text-[var(--l-faint)]">Frontend</span><span class="text-[13px] leading-relaxed text-[var(--l-muted)]">Next.js · ReactJS · Javascript</span></div><div class="grid grid-cols-[104px_1fr] items-baseline gap-x-4 border-t border-[var(--l-line)] py-3"><span class="text-[11px] font-semibold uppercase tracking-[0.14em] text-[var(--l-faint)]">Backend</span><span class="text-[13px] leading-relaxed text-[var(--l-muted)]">Python · FastAPI · Flask</span></div><div class="grid grid-cols-[104px_1fr] items-baseline gap-x-4 border-t border-[var(--l-line)] py-3"><span class="text-[11px] font-semibold uppercase tracking-[0.14em] text-[var(--l-faint)]">Data</span><span class="text-[13px] leading-relaxed text-[var(--l-muted)]">MongoDB · PostgreSQL · Firebase</span></div><div class="grid grid-cols-[104px_1fr] items-baseline gap-x-4 border-t border-[var(--l-line)] py-3"><span class="text-[11px] font-semibold uppercase tracking-[0.14em] text-[var(--l-faint)]">AI / ML</span><span class="text-[13px] leading-relaxed text-[var(--l-muted)]">LLM Fine-Tuning · Dataset Preparation · Synthetic Data</span></div></div><div class="mt-8 rounded-xl border border-[var(--l-line)] bg-[var(--l-surface)] p-5"><p class="font-mono text-[10px] uppercase tracking-[0.18em] text-[var(--l-faint)]">education</p><p class="mt-2 text-[14.5px] font-semibold text-[var(--l-text)]">Wittenberg University</p><p class="mt-1 text-[13px] leading-relaxed text-[var(--l-muted)]">BA &amp; BS — Computer Science and Classical Guitar Performance</p></div></div><ol class="relative"><span aria-hidden="true" class="absolute bottom-0 left-[3.5px] top-1.5 w-px" style="background:linear-gradient(to bottom, var(--l-accent) 0%, rgba(124,199,255,0.25) 90px, var(--l-line) 260px, transparent 100%)"></span><li class="relative pl-9 " style="opacity:0;transform:translateX(16px)"><span aria-hidden="true" class="absolute left-0 top-1.5 h-2 w-2 rounded-full bg-[var(--l-accent)]" style="box-shadow:0 0 0 4px rgba(124,199,255,0.14), 0 0 18px rgba(124,199,255,0.35)"></span><div class="flex flex-wrap items-center gap-x-3 gap-y-1"><p class="font-mono text-[11px] uppercase tracking-wider text-[var(--l-faint)]">Jan 2026 - Present</p><span class="rounded-full border border-[var(--l-accent)]/40 bg-[var(--l-accent-dim)] px-2 py-px font-mono text-[9px] uppercase tracking-wider text-[var(--l-accent)]">now</span></div><h3 class="mt-1.5 font-semibold tracking-tight text-[var(--l-text)] text-[17px]">Senior Engineer, AI Platforms<!-- --> <span class="font-normal text-[var(--l-muted)]">· <!-- -->Signature Aviation</span></h3><p class="mt-1.5 max-w-lg text-[13.5px] leading-relaxed text-[var(--l-muted)]">Building AI platforms at Signature Aviation, the world’s largest network of private aviation terminals.</p></li><li class="relative pl-9 mt-10" style="opacity:0;transform:translateX(16px)"><span aria-hidden="true" class="absolute left-0 top-1.5 h-2 w-2 rounded-full bg-[var(--l-faint)]"></span><div class="flex flex-wrap items-center gap-x-3 gap-y-1"><p class="font-mono text-[11px] uppercase tracking-wider text-[var(--l-faint)]">Jun 2023 - May 2025</p></div><h3 class="mt-1.5 font-semibold tracking-tight text-[var(--l-text)] text-[15.5px]">AI Engineer<!-- --> <span class="font-normal text-[var(--l-muted)]">· <!-- -->JOANN Stores</span></h3><p class="mt-1.5 max-w-lg text-[13.5px] leading-relaxed text-[var(--l-muted)]">Promoted to a newly created role to design and implement AI solutions across the organization. Led the development of cutting-edge, in-house AI models using innovative architectures like Mamba/LNN for efficient inference, until JOANN wound down operations in May 2025.</p><ul class="mt-3 space-y-1 border-l border-[var(--l-line)] pl-4"><li class="text-[12px] leading-relaxed text-[var(--l-faint)]"><span class="text-[var(--l-muted)]">AI Engineer</span><span class="font-mono text-[10.5px]"> <!-- -->— <!-- -->Jan 2024<!-- --> – <!-- -->May 2025</span></li><li class="text-[12px] leading-relaxed text-[var(--l-faint)]"><span class="text-[var(--l-muted)]">SEO &amp; Search Specialist</span><span class="font-mono text-[10.5px]"> <!-- -->— <!-- -->Jun 2023<!-- --> – <!-- -->Jan 2024</span></li></ul></li><li class="relative pl-9 mt-10" style="opacity:0;transform:translateX(16px)"><span aria-hidden="true" class="absolute left-0 top-1.5 h-2 w-2 rounded-full bg-[var(--l-faint)]"></span><div class="flex flex-wrap items-center gap-x-3 gap-y-1"><p class="font-mono text-[11px] uppercase tracking-wider text-[var(--l-faint)]">Aug 2022 - Apr 2023</p></div><h3 class="mt-1.5 font-semibold tracking-tight text-[var(--l-text)] text-[15.5px]">SEO Team Lead<!-- --> <span class="font-normal text-[var(--l-muted)]">· <!-- -->Searchbloom</span></h3><p class="mt-1.5 max-w-lg text-[13.5px] leading-relaxed text-[var(--l-muted)]">Led a team of SEO specialists, driving organic growth for clients. Implemented AI-powered content creation processes that significantly increased content output and efficiency.</p></li><li class="relative pl-9 mt-10" style="opacity:0;transform:translateX(16px)"><span aria-hidden="true" class="absolute left-0 top-1.5 h-2 w-2 rounded-full bg-[var(--l-faint)]"></span><div class="flex flex-wrap items-center gap-x-3 gap-y-1"><p class="font-mono text-[11px] uppercase tracking-wider text-[var(--l-faint)]">Sep 2021 - May 2022</p></div><h3 class="mt-1.5 font-semibold tracking-tight text-[var(--l-text)] text-[15.5px]">Search Engine Optimization Marketing Manager<!-- --> <span class="font-normal text-[var(--l-muted)]">· <!-- -->Rocket Central</span></h3><p class="mt-1.5 max-w-lg text-[13.5px] leading-relaxed text-[var(--l-muted)]">Managed SEO strategy and execution for Rocket Central, the central hub of Rocket Companies. Implemented innovative AI techniques but was limited in pursuing a full-time engineering role.</p></li><li class="relative pl-9 mt-10" style="opacity:0;transform:translateX(16px)"><span aria-hidden="true" class="absolute left-0 top-1.5 h-2 w-2 rounded-full bg-[var(--l-faint)]"></span><div class="flex flex-wrap items-center gap-x-3 gap-y-1"><p class="font-mono text-[11px] uppercase tracking-wider text-[var(--l-faint)]">Sep 2019 - Sep 2021</p></div><h3 class="mt-1.5 font-semibold tracking-tight text-[var(--l-text)] text-[15.5px]">Director of SEO<!-- --> <span class="font-normal text-[var(--l-muted)]">· <!-- -->Giant X (Giant Vapes / AVAIL)</span></h3><p class="mt-1.5 max-w-lg text-[13.5px] leading-relaxed text-[var(--l-muted)]">Led SEO for Giant X, developing and deploying GPT-3 powered SEO tools during GPT-3’s closed beta. These tools resulted in a 20% overnight boost in search visibility after Google’s BERT update.</p><ul class="mt-3 space-y-1 border-l border-[var(--l-line)] pl-4"><li class="text-[12px] leading-relaxed text-[var(--l-faint)]"><span class="text-[var(--l-muted)]">SEO Manager</span><span class="font-mono text-[10.5px]"> <!-- -->— <!-- -->Apr 2020<!-- --> – <!-- -->Sep 2020</span></li><li class="text-[12px] leading-relaxed text-[var(--l-faint)]"><span class="text-[var(--l-muted)]">Store Manager</span><span class="font-mono text-[10.5px]"> <!-- -->— <!-- -->Sep 2019<!-- --> – <!-- -->Apr 2020</span></li></ul></li><li class="relative pl-9 mt-10" style="opacity:0;transform:translateX(16px)"><span aria-hidden="true" class="absolute left-0 top-1.5 h-2 w-2 rounded-full bg-[var(--l-faint)]"></span><div class="flex flex-wrap items-center gap-x-3 gap-y-1"><p class="font-mono text-[11px] uppercase tracking-wider text-[var(--l-faint)]">Jan 2018 - Present</p><span class="rounded-full border border-[var(--l-line)] px-2 py-px font-mono text-[9px] uppercase tracking-wider text-[var(--l-faint)]">ongoing</span></div><h3 class="mt-1.5 font-semibold tracking-tight text-[var(--l-text)] text-[15.5px]">Owner<!-- --> <span class="font-normal text-[var(--l-muted)]">· <!-- -->Kumin Consulting, LLC</span></h3><p class="mt-1.5 max-w-lg text-[13.5px] leading-relaxed text-[var(--l-muted)]">Founded and managed Kumin Consulting, providing SEO, digital marketing, traditional marketing, and application development services. Worked independently full-time here between JOANN’s closure (May 2025) and joining Signature Aviation (Jan 2026).</p></li><li class="relative pl-9 mt-10" style="opacity:0;transform:translateX(16px)"><span aria-hidden="true" class="absolute left-0 top-1.5 h-2 w-2 rounded-full bg-[var(--l-faint)]"></span><div class="flex flex-wrap items-center gap-x-3 gap-y-1"><p class="font-mono text-[11px] uppercase tracking-wider text-[var(--l-faint)]">May 2017 - Jan 2019</p></div><h3 class="mt-1.5 font-semibold tracking-tight text-[var(--l-text)] text-[15.5px]">Chief Marketing Officer<!-- --> <span class="font-normal text-[var(--l-muted)]">· <!-- -->Star Products Corporation</span></h3><p class="mt-1.5 max-w-lg text-[13.5px] leading-relaxed text-[var(--l-muted)]">Oversaw all marketing efforts, including SEO, social media, email marketing, and web development. Implemented early AI techniques for SEO content optimization.</p><ul class="mt-3 space-y-1 border-l border-[var(--l-line)] pl-4"><li class="text-[12px] leading-relaxed text-[var(--l-faint)]"><span class="text-[var(--l-muted)]">SEM Manager &amp; Web Developer</span><span class="font-mono text-[10.5px]"> <!-- -->— <!-- -->Oct 2017<!-- --> – <!-- -->Feb 2018</span></li><li class="text-[12px] leading-relaxed text-[var(--l-faint)]"><span class="text-[var(--l-muted)]">Sales Representative</span><span class="font-mono text-[10.5px]"> <!-- -->— <!-- -->May 2017<!-- --> – <!-- -->Oct 2017</span></li></ul></li><li class="relative pl-9 mt-10" style="opacity:0;transform:translateX(16px)"><span aria-hidden="true" class="absolute left-0 top-1.5 h-2 w-2 rounded-full bg-[var(--l-faint)]"></span><div class="flex flex-wrap items-center gap-x-3 gap-y-1"><p class="font-mono text-[11px] uppercase tracking-wider text-[var(--l-faint)]">Jun 2013 - Present</p><span class="rounded-full border border-[var(--l-line)] px-2 py-px font-mono text-[9px] uppercase tracking-wider text-[var(--l-faint)]">ongoing</span></div><h3 class="mt-1.5 font-semibold tracking-tight text-[var(--l-text)] text-[15.5px]">Web Application Developer<!-- --> <span class="font-normal text-[var(--l-muted)]">· <!-- -->Kumin Web Design</span></h3><p class="mt-1.5 max-w-lg text-[13.5px] leading-relaxed text-[var(--l-muted)]">Freelance web developer, creating websites and mobile applications for a diverse client base. Skills include front-end development, UI/UX design, and SEO.</p></li></ol></div></section><section id="kumin-os" class="mx-auto w-full max-w-6xl px-5 sm:px-8 py-28 sm:py-32"><p class="mb-4 flex items-center gap-3 text-[11px] font-semibold uppercase tracking-[0.22em] text-[var(--l-faint)]"><span class="text-[var(--l-accent)]">03</span><span aria-hidden="true" class="h-px w-8 bg-[var(--l-line)]"></span>The flagship</p><div class="grid gap-12 lg:grid-cols-[1fr_1.1fr] lg:items-center"><div><h2 class="text-[clamp(1.8rem,4vw,3rem)] font-semibold leading-[1.08] tracking-tight text-[var(--l-text)]">NextOS<br/><span class="text-[var(--l-muted)]">a computer in a browser tab.</span></h2><p class="mt-6 max-w-lg text-[15px] leading-relaxed text-[var(--l-muted)]">The project I’m proudest of: a full operating system that runs in a browser tab, built solo, end to end. It is the résumé you can boot, and it is also just a genuinely useful machine.</p><ul class="mt-7 grid max-w-lg gap-2.5"><li class="flex gap-2.5 text-[13.5px] leading-snug text-[var(--l-text)]"><span aria-hidden="true" class="mt-px select-none text-[var(--l-accent)]">—</span>A Unix-style filesystem and a real Terminal with CPython, Node.js and more</li><li class="flex gap-2.5 text-[13.5px] leading-snug text-[var(--l-text)]"><span aria-hidden="true" class="mt-px select-none text-[var(--l-accent)]">—</span>44 built-in apps, plus a VS Code workbench that runs real extensions</li><li class="flex gap-2.5 text-[13.5px] leading-snug text-[var(--l-text)]"><span aria-hidden="true" class="mt-px select-none text-[var(--l-accent)]">—</span>AI agents that operate any app through hundreds of tools, under your approval</li><li class="flex gap-2.5 text-[13.5px] leading-snug text-[var(--l-text)]"><span aria-hidden="true" class="mt-px select-none text-[var(--l-accent)]">—</span>Syncs to your own Google Drive; installs as a PWA; runs offline</li></ul><div class="mt-8 flex flex-wrap gap-3"><a class="group inline-flex items-center gap-2 rounded-lg border border-[var(--l-line)] px-5 py-3 text-sm font-medium transition-colors hover:border-[var(--l-accent)] hover:text-[var(--l-text)] focus:outline-none focus-visible:ring-2 focus-visible:ring-[var(--l-accent)]" href="/nextos">Learn more about NextOS<span aria-hidden="true" class="transition-transform group-hover:translate-x-0.5">↗</span></a><a class="group inline-flex items-center gap-2 rounded-lg bg-[var(--l-text)] px-5 py-3 text-sm font-semibold text-[#0a0c10] transition-transform hover:-translate-y-0.5 focus:outline-none focus-visible:ring-2 focus-visible:ring-[var(--l-accent)]" href="/os">Boot it<span aria-hidden="true" class="font-mono text-xs opacity-60 transition-transform group-hover:translate-x-0.5">⏎</span></a></div></div><div style="opacity:0;transform:translateY(20px)"><div class="relative overflow-hidden rounded-2xl border border-white/10 bg-[var(--l-surface)]" style="box-shadow:0 40px 120px -20px rgba(0,0,0,0.7), 0 0 100px rgba(124,199,255,0.06)"><div class="flex h-9 items-center gap-1.5 border-b border-white/[0.07] px-4"><span class="h-2.5 w-2.5 rounded-full bg-[#ff5f57]"></span><span class="h-2.5 w-2.5 rounded-full bg-[#febc2e]"></span><span class="h-2.5 w-2.5 rounded-full bg-[#28c840]"></span><span class="ml-2 truncate font-mono text-[11px] text-[var(--l-faint)]">field.shell — next.os</span></div><div class="relative w-full" style="aspect-ratio:1400 / 860"><img alt="NextOS: the Field shell with several apps open at once" loading="lazy" decoding="async" data-nimg="fill" style="position:absolute;height:100%;width:100%;left:0;top:0;right:0;bottom:0;object-fit:cover;object-position:top;color:transparent" src="/screens/hero-field.webp"/></div></div></div></div></section><section id="take-it" class="mx-auto w-full max-w-6xl px-5 sm:px-8 py-24 sm:py-32"><p class="mb-4 flex items-center gap-3 text-[11px] font-semibold uppercase tracking-[0.22em] text-[var(--l-faint)]"><span class="text-[var(--l-accent)]">04</span><span aria-hidden="true" class="h-px w-8 bg-[var(--l-line)]"></span>Take it with you</p><h2 class="max-w-2xl text-[clamp(1.8rem,4vw,3rem)] font-semibold leading-[1.08] tracking-tight">The portfolio doesn’t<br/><span class="text-[var(--l-muted)]">end at the tab.</span></h2><div class="mt-12 grid gap-4 lg:grid-cols-5"><div class="lg:col-span-3" style="opacity:0;transform:translateY(20px)"><article class="flex h-full flex-col rounded-2xl border border-[var(--l-line)] bg-[var(--l-surface)] p-6 transition-colors hover:border-white/20 sm:p-8"><div class="flex items-center gap-3"><span class="flex h-8 w-8 items-center justify-center rounded-md border border-[var(--l-accent)]/30 bg-[var(--l-accent-dim)]"><svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-square-terminal text-[var(--l-accent)]" aria-hidden="true"><path d="m7 11 2-2-2-2"></path><path d="M11 13h4"></path><rect width="18" height="18" x="3" y="3" rx="2" ry="2"></rect></svg></span><p class="font-mono text-[10px] uppercase tracking-[0.18em] text-[var(--l-faint)]">model context protocol</p></div><h3 class="mt-4 text-xl font-semibold tracking-tight text-[var(--l-text)]">Query me from your editor</h3><p class="mt-2 max-w-lg text-[13.5px] leading-relaxed text-[var(--l-muted)]">A real MCP server speaks for this site. Add it to Claude Code, Claude Desktop, or Cursor and ask your own AI about the work — seven read-only tools over the same canonical data this page renders.</p><div class="mt-6 overflow-hidden rounded-lg border border-[var(--l-line)] bg-[var(--l-bg)]"><div class="flex items-center justify-between border-b border-[var(--l-line)] px-3 py-1.5"><span class="font-mono text-[10px] uppercase tracking-wider text-[var(--l-faint)]">shell</span><button type="button" class="min-h-[32px] rounded px-2 font-mono text-[11px] text-[var(--l-accent)] transition-colors hover:bg-[var(--l-accent-dim)] focus:outline-none focus-visible:ring-1 focus-visible:ring-[var(--l-accent)]">copy</button></div><div class="overflow-x-auto px-3 py-3"><code class="whitespace-nowrap font-mono text-[11.5px] leading-relaxed text-[var(--l-muted)]"><span aria-hidden="true" class="select-none text-[var(--l-faint)]">$<!-- --> </span>claude mcp add --transport http portfolio https://jonkum.in/api/mcp</code></div></div><div class="mt-auto pt-5"><a class="group inline-flex items-center gap-1.5 text-[13px] font-medium text-[var(--l-accent)] focus:outline-none focus-visible:ring-1 focus-visible:ring-[var(--l-accent)]" href="/mcp">MCP docs<span aria-hidden="true" class="inline-block transition-transform duration-300 group-hover:translate-x-0.5">→</span></a></div></article></div><div class="grid gap-4 sm:grid-cols-2 lg:col-span-2 lg:grid-cols-1"><div class="h-full" style="opacity:0;transform:translateY(20px)"><article class="flex h-full flex-col rounded-2xl border border-[var(--l-line)] bg-[var(--l-surface)] p-5 transition-colors hover:border-white/20 sm:p-6"><div class="flex items-center gap-3"><span class="flex h-8 w-8 items-center justify-center rounded-md border border-[var(--l-line)]"><svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-file-text text-[var(--l-muted)]" aria-hidden="true"><path d="M15 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7Z"></path><path d="M14 2v4a2 2 0 0 0 2 2h4"></path><path d="M10 9H8"></path><path d="M16 13H8"></path><path d="M16 17H8"></path></svg></span><h3 class="text-[15.5px] font-semibold tracking-tight text-[var(--l-text)]">The one-pager</h3></div><p class="mt-3 flex-1 text-[13px] leading-relaxed text-[var(--l-muted)]">A print-perfect resume built from the same data module as everything else here. One page at default scale, honest URLs, save as PDF from your browser.</p><a class="group mt-4 inline-flex items-center gap-1.5 text-[13px] font-medium text-[var(--l-accent)] focus:outline-none focus-visible:ring-1 focus-visible:ring-[var(--l-accent)]" href="/resume">Open the resume<span aria-hidden="true" class="inline-block transition-transform duration-300 group-hover:translate-x-0.5">→</span></a></article></div><div class="h-full" style="opacity:0;transform:translateY(20px)"><article class="flex h-full flex-col rounded-2xl border border-[var(--l-line)] bg-[var(--l-surface)] p-5 transition-colors hover:border-white/20 sm:p-6"><div class="flex items-center gap-3"><span class="flex h-8 w-8 items-center justify-center rounded-md border border-[var(--l-line)]"><svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-book-open text-[var(--l-muted)]" aria-hidden="true"><path d="M12 7v14"></path><path d="M3 18a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1h5a4 4 0 0 1 4 4 4 4 0 0 1 4-4h5a1 1 0 0 1 1 1v13a1 1 0 0 1-1 1h-6a3 3 0 0 0-3 3 3 3 0 0 0-3-3z"></path></svg></span><h3 class="text-[15.5px] font-semibold tracking-tight text-[var(--l-text)]">How it was built</h3></div><p class="mt-3 flex-1 text-[13px] leading-relaxed text-[var(--l-muted)]">Architecture, counted-not-estimated numbers, security posture, and the engineering war stories — including what this site deliberately is not.</p><a class="group mt-4 inline-flex items-center gap-1.5 text-[13px] font-medium text-[var(--l-accent)] focus:outline-none focus-visible:ring-1 focus-visible:ring-[var(--l-accent)]" href="/colophon">Read the colophon<span aria-hidden="true" class="inline-block transition-transform duration-300 group-hover:translate-x-0.5">→</span></a></article></div></div></div></section><section id="connect" class="mx-auto w-full max-w-6xl px-5 sm:px-8 py-28 sm:py-36"><p class="mb-4 flex items-center gap-3 text-[11px] font-semibold uppercase tracking-[0.22em] text-[var(--l-faint)]"><span class="text-[var(--l-accent)]">05</span><span aria-hidden="true" class="h-px w-8 bg-[var(--l-line)]"></span>Get in touch</p><div style="opacity:0;transform:translateY(20px)"><h2 class="max-w-2xl text-[clamp(2rem,5vw,4rem)] font-bold leading-[1.02] tracking-[-0.02em] text-[var(--l-text)]">Got a project in mind?</h2><p class="mt-6 max-w-xl text-[15px] leading-relaxed text-[var(--l-muted)] sm:text-base md:text-lg">I&#x27;m always up for talking about AI systems, SEO, or the next thing to build.</p></div><div style="opacity:0;transform:translateY(20px)"><div class="mt-10 flex flex-wrap gap-3"><a href="mailto:jkumin@seoptimization.org" class="group inline-flex items-center gap-2.5 rounded-xl border border-[var(--l-line)] bg-[var(--l-surface)] px-5 py-3.5 transition-colors hover:border-[var(--l-accent)] focus:outline-none focus-visible:ring-2 focus-visible:ring-[var(--l-accent)]"><span class="text-[14px] font-medium text-[var(--l-text)]">Email</span><span class="font-mono text-[12px] text-[var(--l-faint)] transition-colors group-hover:text-[var(--l-muted)]">jkumin@seoptimization.org</span></a><a href="https://github.com/kumin-consulting" target="_blank" rel="noopener noreferrer" class="group inline-flex items-center gap-2.5 rounded-xl border border-[var(--l-line)] bg-[var(--l-surface)] px-5 py-3.5 transition-colors hover:border-[var(--l-accent)] focus:outline-none focus-visible:ring-2 focus-visible:ring-[var(--l-accent)]"><span class="text-[14px] font-medium text-[var(--l-text)]">GitHub</span><span class="font-mono text-[12px] text-[var(--l-faint)] transition-colors group-hover:text-[var(--l-muted)]">github.com/kumin-consulting</span></a><a href="https://linkedin.com/in/jonathan-kumin" target="_blank" rel="noopener noreferrer" class="group inline-flex items-center gap-2.5 rounded-xl border border-[var(--l-line)] bg-[var(--l-surface)] px-5 py-3.5 transition-colors h
9-.255 1.396.09 1.248.715" /> <path d="M16 12a4 4 0 0 0-4-4" /> <path d="m19 5-1.256 1.256" /> <path d="M20 12h2" /> </svg><span>Light or dark theme</span></button> </nav> <div class="tools"> <div class="langs" role="group" aria-label="Language"> <a href="/mcp/aimarket/" hreflang="fr" lang="fr">FR</a><span aria-current="true" lang="en">EN</span><a href="/es/mcp/aimarket/" hreflang="es" lang="es">ES</a> </div> <button class="iconbtn js-theme" type="button" id="theme" aria-label="Toggle light / dark theme" title="Toggle light / dark theme"><svg aria-hidden="true" focusable="false" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" > <path d="M12 2v2" /> <path d="M14.837 16.385a6 6 0 1 1-7.223-7.222c.624-.147.97.66.715 1.248a4 4 0 0 0 5.26 5.259c.589-.255 1.396.09 1.248.715" /> <path d="M16 12a4 4 0 0 0-4-4" /> <path d="m19 5-1.256 1.256" /> <path d="M20 12h2" /> </svg></button> <button class="iconbtn burger" type="button" id="burger" aria-label="Menu" aria-expanded="false" aria-controls="nav"><svg aria-hidden="true" focusable="false" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" > <path d="M4 5h16" /> <path d="M4 12h16" /> <path d="M4 19h16" /> </svg></button> </div> </div>  </header> <main id="contenu"><header class="band fld-mandarine page-head ph"> <nav class="crumbs wrap" aria-label="Breadcrumb"> <ol><li><a href="/en/">Home</a></li><li><a href="/en/mcp/">MCP servers</a></li><li><a href="/en/mcp/category/security/">Security</a></li><li><span aria-current="page">AIMarket MCP Gateway</span></li></ol> </nav> <div class="wrap ph-in ph-has-img"> <div class="ph-t"> <p class="kicker">Security · MCP server</p> <h1>AIMarket MCP Gateway: MCP server, setup and security</h1> <p class="answer"><strong>AIMarket MCP Gateway</strong> is an open-source MCP server that lets an AI agent search and fetch web pages with integrated Metis verification tools. Its repository has 1 stars and its last commit is from October 20, 2026 and it is licensed under MIT.</p>  <p class="meta"><time datetime="2026-11-10">Updated on November 10, 2026</time></p> </div>  <div class="sheet notch ph-score" data-astro-cid-iytdze4s><div class="score"> <span class="grade g-c" aria-hidden="true">C</span> <div><div class="small muted">Score</div><div class="big">60<small>/100</small></div></div> <table style="width:auto;font-size:13px" aria-label="Score"> <tbody><tr><th scope="row" style="padding:2px 8px 2px 0;border:0;font-weight:400;color:var(--muted)">Adoption (stars)</th> <td style="padding:2px 6px;border:0"><span class="cells" style="grid-template-columns:repeat(5,12px)" aria-hidden="true"><i style="width:12px;height:12px" class></i><i style="width:12px;height:12px" class></i><i style="width:12px;height:12px" class></i><i style="width:12px;height:12px" class></i><i style="width:12px;height:12px" class></i></span></td> <td class="n" style="padding:2px 0;border:0">0/40</td></tr><tr><th scope="row" style="padding:2px 8px 2px 0;border:0;font-weight:400;color:var(--muted)">Maintenance</th> <td style="padding:2px 6px;border:0"><span class="cells" style="grid-template-columns:repeat(5,12px)" aria-hidden="true"><i style="width:12px;height:12px" class="c4"></i><i style="width:12px;height:12px" class="c4"></i><i style="width:12px;height:12px" class="c4"></i><i style="width:12px;height:12px" class="c4"></i><i style="width:12px;height:12px" class="c4"></i></span></td> <td class="n" style="padding:2px 0;border:0">30/30</td></tr><tr><th scope="row" style="padding:2px 8px 2px 0;border:0;font-weight:400;color:var(--muted)">Framework (licence, registry, official)</th> <td style="padding:2px 6px;border:0"><span class="cells" style="grid-template-columns:repeat(5,12px)" aria-hidden="true"><i style="width:12px;height:12px" class="c4"></i><i style="width:12px;height:12px" class="c4"></i><i style="width:12px;height:12px" class="c4"></i><i style="width:12px;height:12px" class="c4"></i><i style="width:12px;height:12px" class="c4"></i></span></td> <td class="n" style="padding:2px 0;border:0">30/30</td></tr></tbody> </table> </div></div> </div> </header> <div class="wrap split page-gap" data-astro-cid-iytdze4s> <div class="prose" data-astro-cid-iytdze4s> <div class="badges"><span class="badge info" title="Implementation by the service's own vendor (awesome-mcp-servers list)"><span class="s" aria-hidden="true">◆</span>Official</span><span class="badge ok"><span class="s" aria-hidden="true">●</span>Actively maintained</span><span class="badge mid"><span class="s" aria-hidden="true">▲</span>Needs secrets</span><span class="badge info"><span class="s" aria-hidden="true">◆</span>Remote server</span></div> <section aria-labelledby="usage-h" data-astro-cid-iytdze4s> <h2 id="usage-h" data-astro-cid-iytdze4s>What AIMarket MCP Gateway does</h2> <p>According to its repository: “SSRF-hardened web gateway with web fetch, web search and Metis verification, sharing an audited security core with Metis and ARGUS.”</p><p>An <a href="/en/glossary/mcp-server/">MCP</a> server gives an <a href="/en/glossary/ai-agent/" class="gl">AI agent</a> extra tools it calls during the conversation: the agent reads their description, decides to use them and gets the result back. AIMarket <a href="/en/glossary/mcp/" class="gl">MCP</a> Gateway is listed under <a href="/en/mcp/category/security/">Security</a>, a category of 133 servers in the directory, where it ranks #127 by stars.</p><p>Topics declared by the repository: <code>aicom</code>, <code>aimarket</code>, <code>fetch</code>, <code>python</code>, <code>web-search</code>.</p> </section><section aria-labelledby="installation-h" data-astro-cid-iytdze4s> <h2 id="installation-h" data-astro-cid-iytdze4s>Installing and connecting AIMarket MCP Gateway</h2> <p>Distribution modes declared in the <a href="https://registry.modelcontextprotocol.io/" rel="nofollow noopener" target="_blank">official MCP registry</a>:</p><ul><li>PyPI package (Python, started with <code>uvx</code> or <code>pip</code>)</li><li>remote server (streamable-http): you connect to it by URL, with nothing to install locally</li></ul><p>Like any <a href="/en/glossary/mcp-server/" class="gl">MCP server</a>, you declare it in your client's configuration (Claude Desktop, Claude Code, Cursor, VS Code, Codex…): a name, the command that starts it or its URL, and any environment variables. The client then starts it and lists its tools. Project language: Python.</p><p>The registry lists 2 secret variables to provide (<a href="/en/glossary/api-key/" class="gl">API key</a>, access <a href="/en/glossary/token/" class="gl">token</a>). Keep them in the client's environment variables, never in a shared file or a repository.</p> </section><section aria-labelledby="securite-h" data-astro-cid-iytdze4s> <h2 id="securite-h" data-astro-cid-iytdze4s>Security: what to check</h2> <p>An MCP server runs code with the rights you give it, and the model reads its tool descriptions: a malicious or compromised server can hijack the agent. Read the code, or pick a maintained and widely used server, before connecting it.</p><p>Points found for AIMarket MCP Gateway:</p><ul><li><strong>Secrets</strong>: the server acts with your credentials. Create a dedicated key with minimum rights and an expiry date.</li></ul><p>Good practice: grant only the rights needed (<a href="/en/glossary/least-privilege/">least privilege</a>), require <a href="/en/glossary/human-in-the-loop/" class="gl">human approval</a> for irreversible actions, and run the <a href="/en/lab/ai-agent-security-check/">AI agent security check</a>.</p> </section><section aria-labelledby="activite-h" data-astro-cid-iytdze4s> <h2 id="activite-h" data-astro-cid-iytdze4s>Project activity and maintenance</h2> <p>Created on July 11, 2026, the <a href="https://github.com/alexar76/aimarket-mcp" rel="nofollow noopener" target="_blank">alexar76/aimarket-mcp</a> repository has 1 stars and 1 forks, with 0 open issues. It has more stars than 7% of the servers in the directory. It received changes this month. Version published in the registry: 0.4.0 (October 7, 2026).</p><p>Stars measure attention, not quality: a recent, heavily promoted project can collect them fast, while a useful but niche server will have few.</p><figure class="box" style="margin:1em 0"><svg class="chart" viewBox="0 0 640 242" role="img" aria-label="GitHub stars: AIMarket MCP Gateway vs Security servers"><line class="axis" x1="201.6" x2="201.6" y1="0" y2="242"/><g><a href="/en/mcp/worldmonitor/"><text x="193.6" y="20" text-anchor="end" class="lbl">World Monitor</text></a><rect x="201.6" y="9" width="352.4" height="14" rx="3" fill="var(--c1)" opacity="0.85"><title>World Monitor : 89.4K</title></rect><text x="560" y="20">89.4K</text></g><g><a href="/en/mcp/semgrep/"><text x="193.6" y="46" text-anchor="end" class="lbl">Semgrep</text></a><rect x="201.6" y="35" width="301.5" height="14" rx="3" fill="var(--c1)" opacity="0.85"><title>Semgrep : 17.2K</title></rect><text x="509.1233959042596" y="46">17.2K</text></g><g><a href="/en/mcp/ida-pro/"><text x="193.6" y="72" text-anchor="end" class="lbl">Ida pro MCP</text></a><rect x="201.6" y="61" width="293.1" height="14" rx="3" fill="var(--c1)" opacity="0.85"><title>Ida pro MCP : 13.1K</title></rect><text x="500.69452654576116" y="72">13.1K</text></g><g><a href="/en/mcp/lauriewired-ghidramcp/"><text x="193.6" y="98" text-anchor="end" class="lbl">GhidraMCP (LaurieWired)</text></a><rect x="201.6" y="87" width="289.0" height="14" rx="3" fill="var(--c1)" opacity="0.85"><title>GhidraMCP (LaurieWired) : 11.5K</title></rect><text x="496.6336768358417" y="98">11.5K</text></g><g><a href="/en/mcp/robin/"><text x="193.6" y="124" text-anchor="end" class="lbl">Robin: AI Powered Dark Web O</text></a><rect x="201.6" y="113" width="276.4" height="14" rx="3" fill="var(--c1)" opacity="0.85"><title>Robin: AI Powered Dark Web O : 7.7K</title></rect><text x="484.04720510995674" y="124">7.7K</text></g><g><a href="/en/mcp/jadx-ai/"><text x="193.6" y="150" text-anchor="end" class="lbl">Jadx ai MCP</text></a><rect x="201.6" y="139" width="246.8" height="14" rx="3" fill="var(--c1)" opacity="0.85"><title>Jadx ai MCP : 2.9K</title></rect><text x="454.3745300042345" y="150">2.9K</text></g><g><a href="/en/mcp/powerbi-modeling/"><text x="193.6" y="176" text-anchor="end" class="lbl">Power BI Authoring MCP Serve</text></a><rect x="201.6" y="165" width="220.3" height="14" rx="3" fill="var(--c1)" opacity="0.85"><title>Power BI Authoring MCP Serve : 1.2K</title></rect><text x="427.938110656332" y="176">1.2K</text></g><g><a href="/en/mcp/vet/"><text x="193.6" y="202" text-anchor="end" class="lbl">SafeDep Vet MCP</text></a><rect x="201.6" y="191" width="216.9" height="14" rx="3" fill="var(--c1)" opacity="0.85"><title>SafeDep Vet MCP : 1.1K</title></rect><text x="424.53515771318644" y="202">1.1K</text></g><g><text x="193.6" y="228" text-anchor="end" class="lbl">AIMarket MCP Gateway</text><rect x="201.6" y="217" width="2.0" height="14" rx="3" fill="var(--c2)" opacity="1"><title>AIMarket MCP Gateway : 1</title></rect><text x="209.6" y="228">1</text></g></svg><figcaption>GitHub stars of the most followed servers in the category (log scale); AIMarket MCP Gateway in orange. Checked November 10, 2026.</figcaption></figure> </section> <section class="note verdict" aria-labelledby="verdict-h"> <h2 id="verdict-h" style="margin-top:0;font-size:21px">Verdict</h2> <p>AIMarket MCP Gateway is a reasonable choice; check the points below before connecting it.</p> <h3>Strengths</h3><ul><li>Maintained by the service's own vendor</li><li>Active project: recent commit</li><li>Listed in the official MCP registry</li><li>Usable remotely, without installation</li><li>Permissive licence (MIT)</li></ul> <h3>Limitations</h3><ul><li>Requires an API key or token</li><li>Few visible users</li></ul> <h3>Avoid if…</h3><ul><li>You do not want to give credentials to an agent</li></ul> </section> </div> <aside style="display:grid;gap:16px;position:sticky;top:84px" class="fiche-aside" data-astro-cid-iytdze4s> <div data-astro-cid-iytdze4s> <h2 style="font-size:19px;margin:0 0 8px" data-astro-cid-iytdze4s>Key facts</h2> <div class="tablewrap"> <table class="id"> <tbody><tr><th scope="row">Repository</th><td><a href="https://github.com/alexar76/aimarket-mcp" rel="nofollow noopener" target="_blank">alexar76/aimarket-mcp</a></td></tr><tr><th scope="row">Website</th><td><a href="https://glama.ai/mcp/servers/alexar76/aimarket-mcp" rel="nofollow noopener" target="_blank">glama.ai/mcp/servers/alexar76/aimarket-mcp</a></td></tr><tr><th scope="row">Category</th><td><a href="/en/mcp/category/security/">Security</a></td></tr><tr><th scope="row">GitHub stars</th><td>1 · rank 127/133</td></tr><tr><th scope="row">Licence</th><td>MIT</td></tr><tr><th scope="row">Last commit</th><td>October 20, 2026</td></tr><tr><th scope="row">Created</th><td>July 11, 2026</td></tr><tr><th scope="row">Version (registry)</th><td>0.4.0</td></tr><tr><th scope="row">Distribution</th><td>pypi, remote</td></tr><tr><th scope="row">Secrets required</th><td>2</td></tr><tr><th scope="row">Language</th><td>Python</td></tr><tr><th scope="row">Official</th><td>Yes</td></tr></tbody> <caption>Sources: GitHub, official MCP registry, awesome-mcp-servers · Checked on November 10, 2026</caption> </table> </div> </div> </aside> </div> <div class="wrap" data-astro-cid-iytdze4s> <div class="grid g2" style="margin-top:2em" data-astro-cid-iytdze4s> <section class="box" data-astro-cid-iytdze4s> <h2 style="font-size:19px" data-astro-cid-iytdze4s>Alternatives</h2> <ul class="links" data-astro-cid-iytdze4s><li data-astro-cid-iytdze4s><a href="/en/mcp/semgrep/" data-astro-cid-iytdze4s>Semgrep</a><span class="tiny muted n" data-astro-cid-iytdze4s>17.2K ★</span></li><li data-astro-cid-iytdze4s><a href="/en/mcp/worldmonitor/" data-astro-cid-iytdze4s>World Monitor</a><span class="tiny muted n" data-astro-cid-iytdze4s>89.4K ★</span></li><li data-astro-cid-iytdze4s><a href="/en/mcp/vet/" data-astro-cid-iytdze4s>SafeDep Vet MCP</a><span class="tiny muted n" data-astro-cid-iytdze4s>1.1K ★</span></li><li data-astro-cid-iytdze4s><a href="/en/mcp/ida-pro/" data-astro-cid-iytdze4s>Ida pro MCP</a><span class="tiny muted n" data-astro-cid-iytdze4s>13.1K ★</span></li><li data-astro-cid-iytdze4s><a href="/en/mcp/lauriewired-ghidramcp/" data-astro-cid-iytdze4s>GhidraMCP (LaurieWired)</a><span class="tiny muted n" data-astro-cid-iytdze4s>11.5K ★</span></li><li data-astro-cid-iytdze4s><a href="/en/mcp/dashclaw/" data-astro-cid-iytdze4s>DashClaw</a><span class="tiny muted n" data-astro-cid-iytdze4s>313 ★</span></li></ul> </section><section class="box" data-astro-cid-iytdze4s> <h2 style="font-size:19px" data-astro-cid-iytdze4s>Learn more</h2> <ul class="links" data-astro-cid-iytdze4s><li data-astro-cid-iytdze4s><a href="/en/mcp/category/security/" data-astro-cid-iytdze4s>MCP servers: Security</a></li><li data-astro-cid-iytdze4s><a href="/en/mcp/" data-astro-cid-iytdze4s>MCP server directory</a></li><li data-astro-cid-iytdze4s><a href="/en/guides/choose-mcp-server/" data-astro-cid-iytdze4s>Choosing an MCP server</a></li><li data-astro-cid-iytdze4s><a href="/en/guides/secure-ai-agent/" data-astro-cid-iytdze4s>Secure an AI agent</a></li><li data-astro-cid-iytdze4s><a href="/en/glossary/mcp-server/" data-astro-cid-iytdze4s>MCP server</a></li><li data-astro-cid-iytdze4s><a href="/en/glossary/prompt-injection/" data-astro-cid-iytdze4s>Prompt injection</a></li><li data-astro-cid-iytdze4s><a href="/en/lab/ai-agent-security-check/" data-astro-cid-iytdze4s>AI agent security check</a></li></ul> </section> </div> <div class="prose" style="margin-top:1em" data-astro-cid-iytdze4s><section class="faq" aria-labelledby="faq-h"><h2 id="faq-h">Frequently asked questions</h2><details open><summary>How do I install AIMarket MCP Gateway?</summary><p>AIMarket MCP Gateway is distributed as PyPI package (Python, started with uvx or pip) and a remote server. Add it to your client's MCP configuration (Claude Desktop, Cursor, VS Code…) following the README of alexar76/aimarket-mcp.</p></details><details><summary>Is AIMarket MCP Gateway free?</summary><p>The code is published under the MIT licence and can be used free of charge. It needs an API key: the service it connects to may be paid.</p></details><details><summary>Is AIMarket MCP Gateway safe?</summary><p>Points to watch: secrets. Give it minimum rights and approve sensitive actions.</p></details><details><summary>Is it an official server?</summary><p>Yes: the awesome-mcp-servers list marks it as the service vendor's official implementation.</p></details><details><summary>What are the alternatives to AIMarket MCP Gateway?</summary><p>In the same category: Semgrep, World Monitor, SafeDep Vet MCP, and Ida pro MCP. Semgrep and World Monitor score higher on our grid.</p></details></section></div> <section class="box" style="margin-top:2em" data-astro-cid-iytdze4s> <h2 style="font-size:19px" data-astro-cid-iytdze4s>Related articles</h2> <ul class="links" data-astro-cid-iytdze4s><li data-astro-cid-iytdze4s><a href="/en/blog/build-mcp-server/" data-astro-cid-iytdze4s>Build your own MCP server in 30 minutes</a><span class="tiny muted" data-astro-cid-iytdze4s>October 24, 2026</span></li><li data-astro-cid-iytdze4s><a href="/en/blog/ai-email-automation/" data-astro-cid-iytdze4s>Automate your inbox with an AI agent</a><span class="tiny muted" data-astro-cid-iytdze4s>October 18, 2026</span></li><li data-astro-cid-iytdze4s><a href="/en/blog/ai-agent-protocols-mcp-a2a/" data-astro-cid-iytdze4s>MCP, A2A, and tool calling: agent protocols explained</a><span class="tiny muted" data-astro-cid-iytdze4s>October 17, 2026</span></li><li data-astro-cid-iytdze4s><a href="/en/blog/n8n-ai-agent/" data-astro-cid-iytdze4s>Build an AI agent with n8n, without coding</a><span class="tiny muted" data-astro-cid-iytdze4s>October 16, 2026</span></li></ul> </section> <aside class="box author" aria-label="Author" style="margin-top:2em"> <img src="/images/francois-chollet.webp" alt="François Chollet" width="84" height="84" loading="lazy" decoding="async"> <div> <p><strong><a href="/en/author/francois-chollet/">François Chollet</a></strong> · editorial director</p> <p class="muted">François Chollet, AI researcher, creator of Keras and of the ARC-AGI benchmark, co-founder of Ndea and of the ARC Prize. Formerly at Google (2015-2024), author of “Deep Learning with Python”, named to the TIME100 AI in 2024.</p> <p class="tiny"><a href="https://fchollet.com/" rel="nofollow noopener" target="_blank">fchollet.com</a> · <a href="https://x.com/fchollet" rel="nofollow noopener" target="_blank">x.com/fchollet</a> · <a href="https://linkedin.com/in/fchollet" rel="nofollow noopener" target="_blank">linkedin.com/in/fchollet</a> · <a href="https://github.com/fchollet" rel="nofollow noopener" target="_blank">github.com/fchollet</a></p> </div> </aside> <p class="note ok small" style="margin-top:2em"> <strong>Neutrality.</strong>  No affiliate links. No vendor pays to be reviewed, rated or ranked. Reviews are directed by François Chollet, neutral and factual, and every data point is dated and sourced.  <a href="/en/methodology/">How we score</a> </p> </div> </main> <footer class="foot"> <div class="wrap"> <div class="cols"> <div> <a href="/en/" class="logo" translate="no"><img class="lt" src="/images/logo-wide.webp" alt="Info Agent IA" width="173" height="52" loading="lazy"><img class="dk" src="/images/logo-wide-dark.webp" alt="Info Agent IA" width="173" height="52" loading="lazy"></a> <p class="small muted" style="margin-top:14px">AI agents, measured without the hype. No affiliate links. No vendor pays to be reviewed, rated or ranked.</p> <p class="small muted">Last updated: November 10, 2026</p> </div> <div> <h2>Directories</h2> <ul> <li><a href="/en/agents/">AI agents</a></li> <li><a href="/en/ai-tools/">AI tools</a></li> <li><a href="/en/mcp/">MCP servers</a></li> <li><a href="/en/models/">LLM models</a></li> <li><a href="/en/comparisons/">Comparisons</a></li> </ul> </div> <div> <h2>Learn</h2> <ul> <li><a href="/en/guides/">Guides</a></li> <li><a href="/en/agi/">AGI and research</a></li> <li><a href="/en/lab/">The Lab</a></li> <li><a href="/en/glossary/">Glossary</a></li> <li><a href="/en/blog/">Articles</a></li> <li><a href="/en/this-week/">What&#39;s new</a></li> </ul> </div> <div> <h2>About the site</h2> <ul> <li><a href="/en/about/">About</a></li> <li><a href="/en/author/francois-chollet/">François Chollet</a></li> <li><a href="/en/methodology/">Our methodology and sources</a></li> <li><a href="/en/contact/">Contact</a></li> <li><a href="/en/legal-notice/">Legal notice</a></li> <li><a href="/en/privacy/">Privacy</a></li> </ul> </div> </div> <div class="legal"> <span translate="no">© 2026 Info Agent IA</span> <span><a href="mailto:contact@info-agent-ia.com">contact@info-agent-ia.com</a></span> </div> </div> </footer> <script>
(function(){
  var d=document;
  // Mega menu : un seul panneau ouvert ; Échap ou clic ailleurs le ferme.
  var tabs=[].slice.call(d.querySelectorAll("[data-mega]"));
  function close(x){tabs.forEach(function(b){if(b!==x){b.setAttribute("aria-expanded","false");var p=d.getElementById(b.getAttribute("aria-controls"));p&&p.classList.remove("open")}})}
  tabs.forEach(function(b){b.addEventListener("click",function(e){e.stopPropagation();if(b.dataset.hover){delete b.dataset.hover;return}var o=b.getAttribute("aria-expanded")==="true";close(b);b.setAttribute("aria-expanded",o?"false":"true");d.getElementById(b.getAttribute("aria-controls")).classList.toggle("open",!o)})});
  d.addEventListener("click",function(e){if(!e.target.closest(".mega"))close(null)});
  tabs.forEach(function(b){var li=b.closest("li");li&&li.addEventListener("focusout",function(e){if(!li.contains(e.relatedTarget)&&b.getAttribute("aria-expanded")==="true"){b.setAttribute("aria-expanded","false");d.getElementById(b.getAttribute("aria-controls")).classList.remove("open")}})});
  d.addEventListener("keydown",function(e){if(e.key==="Escape"){var ob=tabs.filter(function(b){return b.getAttribute("aria-expanded")==="true"})[0];close(null);if(ob&&ob.closest("li").contains(d.activeElement))ob.focus();var n=d.getElementById("nav");if(n.classList.contains("open")){var inNav=n.contains(d.activeElement);n.classList.remove("open");var bu=d.getElementById("burger");bu.setAttribute("aria-expanded","false");if(inNav&&!ob)bu.focus()}}});
  var calm=matchMedia("(prefers-reduced-motion: reduce)").matches,hov=matchMedia("(hover: hover) and (pointer: fine) and (min-width: 1024px)");
  // Survol à la souris (écran large) : ouverture après un court délai, fermeture en quittant ; un clic garde le panneau ouvert.
  tabs.forEach(function(b){var li=b.closest("li"),tm;function set(o){b.setAttribute("aria-expanded",o?"true":"false");d.getElementById(b.getAttribute("aria-controls")).classList.toggle("open",o)}
    li.addEventListener("mouseenter",function(){if(!hov.matches)return;clearTimeout(tm);tm=setTimeout(function(){if(b.getAttribute("aria-expanded")==="true")return;close(b);set(true);b.dataset.hover="1"},110)});
    li.addEventListener("mouseleave",function(){if(!hov.matches)return;clearTimeout(tm);tm=setTimeout(function(){if(b.dataset.hover){set(false);delete b.dataset.hover}},240)})});
  // En-tête : ligne pointillée une fois la page défilée ; barre de progression de lecture (CSS si possible, sinon ici).
  var top=d.querySelector(".top"),pr=d.querySelector(".progress i"),cssPr=!calm&&window.CSS&&CSS.supports("animation-timeline: scroll()"),tk=0,was=null;
  function onS(){tk=0;var y=scrollY,s=y>8;if(s!==was){top.classList.toggle("scrolled",s);was=s}if(pr&&!cssPr){var h=d.documentElement.scrollHeight-innerHeight;pr.style.transform="scaleX("+(h>0?Math.min(1,y/h):0)+")"}}
  addEventListener("scroll",function(){if(!tk){tk=1;requestAnimationFrame(onS)}},{passive:true});onS();
  // Sommaire : la section en cours de lecture est soulignée.
  var toc=d.querySelector(".toc");if(toc&&"IntersectionObserver" in window){var ls={};toc.querySelectorAll('a[href^="#"]').forEach(function(a){ls[decodeURIComponent(a.hash.slice(1))]=a});var io2=new IntersectionObserver(function(es){es.forEach(function(e){var a=ls[e.target.id];if(e.isIntersecting&&a){toc.querySelectorAll(".on").forEach(function(x){x.classList.remove("on")});a.classList.add("on")}})},{rootMargin:"-15% 0px -70% 0px"});Object.keys(ls).forEach(function(id){var h=d.getElementById(id);h&&io2.observe(h)})}
  if(!calm){
    // Lumière qui suit la souris sur les feuilles d'annuaire.
    if(hov.matches)d.querySelectorAll(".dir").forEach(function(el){var r=0,ev;el.addEventListener("pointermove",function(e){ev=e;if(r)return;r=requestAnimationFrame(function(){r=0;var b=el.getBoundingClientRect();el.style.setProperty("--x",(ev.clientX-b.left)+"px");el.style.setProperty("--y",(ev.clientY-b.top)+"px")})})});
    // Chiffres des annuaires qui défilent jusqu'à leur vraie valeur (déjà écrite dans la page).
    if("IntersectionObserver" in window){var nf=new Intl.NumberFormat(d.documentElement.lang),io=new IntersectionObserver(function(es){es.forEach(function(en){if(!en.isIntersecting)return;io.unobserve(en.target);var el=en.target,txt=el.textContent,n=+txt.replace(/\D/g,"");if(!/^[\d\s\u00a0\u202f.,]+$/.test(txt)||n<20)return;var t0=performance.now();(function f(t){var k=Math.min(1,(t-t0)/900);k=1-Math.pow(1-k,3);el.textContent=k<1?nf.format(Math.round(n*k)):txt;if(k<1)requestAnimationFrame(f)})(t0)})},{threshold:.7});d.querySelectorAll("[data-count]").forEach(function(el){io.observe(el)})}
  }
  // Nouveautés : survoler un titre montre son image à côté.
  var ni=d.querySelector(".news-img img"),pl=d.querySelector(".printed");if(ni&&pl&&hov.matches){var o0={s:ni.getAttribute("src"),ss:ni.getAttribute("srcset"),a:ni.alt};function peek(u){ni.removeAttribute("srcset");ni.src=u;ni.alt="";ni.parentNode.classList.add("peek")}pl.querySelectorAll("a[data-img]").forEach(function(a){a.addEventListener("mouseenter",function(){peek(a.dataset.img)});a.addEventListener("focus",function(){peek(a.dataset.img)})});pl.addEventListener("mouseleave",function(){ni.src=o0.s;o0.ss&&ni.setAttribute("srcset",o0.ss);ni.alt=o0.a;ni.parentNode.classList.remove("peek")})}
  // Transition de page : l'image de la carte cliquée devient la couverture de l'article.
  d.addEventListener("click",function(e){var a=e.target.closest&&e.target.closest(".cards a, .rub-grid a, .une a, .feat-card");if(!a||e.metaKey||e.ctrlKey||e.shiftKey)return;var c=a.closest("li, .une, .feat-card"),im=c&&c.querySelector("img");if(im&&!d.querySelector(".cover img"))im.style.viewTransitionName="cover"});
  addEventListener("pageshow",function(){d.querySelectorAll("img[style*=view-transition]").forEach(function(i){i.style.viewTransitionName=""})});
  var bg=d.getElementById("burger");bg&&bg.addEventListener("click",function(){var n=d.getElementById("nav");var o=n.classList.toggle("open");bg.setAttribute("aria-expanded",o?"true":"false")});
  // Thème clair / sombre, mémorisé.
  var ths=d.querySelectorAll(".js-theme");function isDark(){var r=d.documentElement;return r.dataset.theme?r.dataset.theme==="dark":matchMedia("(prefers-color-scheme: dark)").matches}function sync(){var k=isDark();ths.forEach(function(b){b.setAttribute("aria-pressed",k?"true":"false")});if(d.documentElement.dataset.theme)d.querySelectorAll("meta[name=theme-color]").forEach(function(m){m.content=k?"#141A2B":"#FFFFFF"})}sync();ths.forEach(function(th){th.addEventListener("click",function(){var r=d.documentElement;r.dataset.theme=isDark()?"light":"dark";try{localStorage.setItem("theme",r.dataset.theme)}catch(e){}sync()})});
  // Boutons « Copier » sur les blocs de commandes.
  d.querySelectorAll("pre").forEach(function(p){var b=d.createElement("button");b.type="button";b.className="copy";b.textContent=d.documentElement.lang==="fr"?"Copier":d.documentElement.lang==="es"?"Copiar":"Copy";b.setAttribute("aria-live","polite");var lb=b.textContent;b.addEventListener("click",function(){var c=p.querySelector("code");var L=d.documentElement.lang;navigator.clipboard&&navigator.clipboard.writeText((c||p).innerText).then(function(){b.textContent=L==="fr"?"Copié ✓":L==="es"?"Copiado ✓":"Copied ✓";setTimeout(function(){b.textContent=lb},2000)})});p.appendChild(b)});
  // Tableaux triables (th[data-sort]).
  d.querySelectorAll("input[data-filter]").forEach(function(inp){var t=d.getElementById(inp.dataset.filter);if(!t)return;var L=d.documentElement.lang;var out=d.createElement("p");out.className="tiny muted filter-count";out.setAttribute("aria-live","polite");inp.insertAdjacentElement("afterend",out);inp.addEventListener("input",function(){var q=inp.value.trim().toLowerCase();var n=0;[].forEach.call(t.tBodies[0].rows,function(r){r.hidden=q&&r.innerText.toLowerCase().indexOf(q)<0;if(!r.hidden)n++});out.textContent=q?n+(L==="fr"?(n>1?" résultats":" résultat"):L==="es"?(n===1?" resultado":" resultados"):(n===1?" result":" results")):""})});
  d.querySelectorAll("table[data-sortable]").forEach(function(t){var hs=[].slice.call(t.querySelectorAll("thead th"));hs.forEach(function(h,i){if(!h.hasAttribute("data-sort"))return;h.tabIndex=0;function go(){var asc=h.getAttribute("aria-sort")!=="ascending";hs.forEach(function(x){x.removeAttribute("aria-sort")});h.setAttribute("aria-sort",asc?"ascending":"descending");var tb=t.tBodies[0];var rows=[].slice.call(tb.rows);var num=h.dataset.sort==="n";rows.sort(function(a,b){var x=a.cells[i].dataset.v!=null?a.cells[i].dataset.v:a.cells[i].innerText,y=b.cells[i].dataset.v!=null?b.cells[i].dataset.v:b.cells[i].innerText;if(num){x=parseFloat(x);y=parseFloat(y);if(isNaN(x))x=asc?Infinity:-Infinity;if(isNaN(y))y=asc?Infinity:-Infinity;return asc?x-y:y-x}return asc?x.localeCompare(y):y.localeCompare(x)});rows.forEach(function(r){tb.appendChild(r)})}h.addEventListener("click",go);h.addEventListener("keydown",function(e){if(e.key==="Enter"||e.key===" "){e.preventDefault();go()}})})});
  // Façade YouTube : l'iframe n'est chargée qu'au clic.
  d.querySelectorAll(".yt button[data-id]").forEach(function(b){b.addEventListener("click",function(){var f=d.createElement("iframe");f.src="https://www.youtube-nocookie.com/embed/"+b.dataset.id+"?autoplay=1";f.title=b.dataset.title||"";f.allow="accelerometer; autoplay; encrypted-media; picture-in-picture";f.allowFullscreen=true;b.parentNode.replaceChild(f,b);f.focus()})});
})();
    </script> </body> </html>
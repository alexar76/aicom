risks and alternatives."><meta property="og:url" content="https://info-agent-ia.com/en/mcp/aimarket/"><meta property="og:image" content="https://info-agent-ia.com/images/og.webp"><meta property="article:modified_time" content="2026-11-10"><meta name="twitter:card" content="summary_large_image"><script>try{var t=localStorage.getItem("theme");if(t)document.documentElement.dataset.theme=t}catch(e){}</script><script type="application/ld+json">{"@context":"https://schema.org","@type":"WebSite","@id":"https://info-agent-ia.com/#website","name":"Info Agent IA","url":"https://info-agent-ia.com/en/","inLanguage":"en-US","description":"A neutral, data-driven registry of AI agents, AI tools, MCP servers and LLM models: real prices, risks, benchmarks and guides, refreshed at every data run.","publisher":{"@id":"https://info-agent-ia.com/#organization"}}</script><script type="application/ld+json">{"@context":"https://schema.org","@type":"Organization","@id":"https://info-agent-ia.com/#organization","name":"Info Agent IA","url":"https://info-agent-ia.com","logo":"https://info-agent-ia.com/images/logo.webp","email":"contact@info-agent-ia.com","founder":{"@id":"https://info-agent-ia.com/#author"}}</script><script type="application/ld+json">{"@context":"https://schema.org","@type":"BreadcrumbList","itemListElement":[{"@type":"ListItem","position":1,"name":"Home","item":"https://info-agent-ia.com/en/"},{"@type":"ListItem","position":2,"name":"MCP servers","item":"https://info-agent-ia.com/en/mcp/"},{"@type":"ListItem","position":3,"name":"Security","item":"https://info-agent-ia.com/en/mcp/category/security/"},{"@type":"ListItem","position":4,"name":"AIMarket MCP Gateway"}]}</script><script type="application/ld+json">{"@context":"https://schema.org","@type":"SoftwareApplication","name":"AIMarket MCP Gateway","description":"AIMarket MCP Gateway MCP server: search and fetch web pages with integrated Metis verification tools. 1 stars, setup, risks and alternatives.","url":"https://info-agent-ia.com/en/mcp/aimarket/","inLanguage":"en-US","applicationCategory":"DeveloperApplication","sameAs":"https://github.com/alexar76/aimarket-mcp","license":"MIT","publisher":{"@type":"Organization","name":"alexar76"},"offers":{"@type":"Offer","price":0,"priceCurrency":"USD"},"review":{"@type":"Review","author":{"@id":"https://info-agent-ia.com/#organization"},"reviewRating":{"@type":"Rating","ratingValue":60,"bestRating":100,"worstRating":0}},"dateModified":"2026-11-10"}</script><script type="application/ld+json">{"@context":"https://schema.org","@type":"FAQPage","mainEntity":[{"@type":"Question","name":"How do I install AIMarket MCP Gateway?","acceptedAnswer":{"@type":"Answer","text":"AIMarket MCP Gateway is distributed as PyPI package (Python, started with uvx or pip) and a remote server. Add it to your client's MCP configuration (Claude Desktop, Cursor, VS Code…) following the README of alexar76/aimarket-mcp."}},{"@type":"Question","name":"Is AIMarket MCP Gateway free?","acceptedAnswer":{"@type":"Answer","text":"The code is published under the MIT licence and can be used free of charge. It needs an API key: the service it connects to may be paid."}},{"@type":"Question","name":"Is AIMarket MCP Gateway safe?","acceptedAnswer":{"@type":"Answer","text":"Points to watch: secrets. Give it minimum rights and approve sensitive actions."}},{"@type":"Question","name":"Is it an official server?","acceptedAnswer":{"@type":"Answer","text":"Yes: the awesome-mcp-servers list marks it as the service vendor's official implementation."}},{"@type":"Question","name":"What are the alternatives to AIMarket MCP Gateway?","acceptedAnswer":{"@type":"Answer","text":"In the same category: Semgrep, World Monitor, SafeDep Vet MCP, and Ida pro MCP. Semgrep and World Monitor score higher on our grid."}}]}</script><link rel="stylesheet" href="/_astro/_path_.CYzX4AeT.css">

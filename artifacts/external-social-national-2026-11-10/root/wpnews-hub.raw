              description: 'Full-text search across wpnews.pro AI/tech articles.',
              inputSchema: {
                type: 'object',
                properties: {
                  q: { type: 'string', description: 'Search query' },
                  lang: { type: 'string', enum: ['en', 'uk'], default: 'en' },
                },
                required: ['q'],
              },
              execute: function(args){
                window.location.href = '/search?q=' + encodeURIComponent(args.q || '') +
                  (args.lang ? '&lang=' + encodeURIComponent(args.lang) : '');
              },
            },
            {
              name: 'open_topic',
              description: 'Open a topic page on wpnews.pro by slug.',
              inputSchema: {
                type: 'object',
                properties: { slug: { type: 'string', description: 'Topic slug (e.g. artificial-intelligence)' } },
                required: ['slug'],
              },
              execute: function(args){ window.location.href = '/topics/' + encodeURIComponent(args.slug || ''); },
            },
            {
              name: 'open_entity',
              description: 'Open an entity (company/person/product) profile page.',
              inputSchema: {
                type: 'object',
                properties: { name: { type: 'string', description: 'Entity name (e.g. OpenAI, Anthropic)' } },
                required: ['name'],
              },
              execute: function(args){ window.location.href = '/entity/' + encodeURIComponent(args.name || ''); },
            },
            {
              name: 'view_trending',
              description: 'View trending AI/tech articles ranked by reader interest.',
              inputSchema: {
                type: 'object',
                properties: { days: { type: 'integer', enum: [1, 7, 30], default: 7 } },
              },
              execute: function(args){ window.location.href = '/trending?days=' + (args.days || 7); },
            },
            {
              name: 'get_api_docs',
              description: 'View the wpnews.pro REST API documentation.',
              inputSchema: { type: 'object', properties: {} },
              execute: function(){ window.location.href = '/api'; },
            },
          ],
        });
      } catch (e) { /* silently skip if API rejects */ }
    })();
    </script>
    
<script>
(function(){
  function tick(){ var d=new Date();var t=String(d.getUTCHours()).padStart(2,'0')+':'+String(d.getUTCMinutes()).padStart(2,'0')+':'+String(d.getUTCSeconds()).padStart(2,'0');var a=document.getElementById('js-clock');var b=document.getElementById('js-clock-status');if(a)a.textContent=t;if(b)b.textContent=t; }
  tick(); setInterval(tick,1000);
})();
</script>

    <script>
    // Engagement beacon (first-party, cookie-less): one empty POST /pv after the first
    // real interaction, so the scoreboard can tell people from Chrome-UA crawlers.
    // Sends only the external referrer's hostname. See /privacy.
    (function(){
      if (navigator.webdriver || !navigator.sendBeacon) return;
      var evs = ['scroll', 'pointerdown', 'keydown', 'touchstart'], sent = false;
      function send(){
        if (sent) return; sent = true;
        evs.forEach(function(e){ removeEventListener(e, send, true); });
        var r = '';
        try { r = new URL(document.referrer).hostname; } catch (e) {}
        if (r === location.hostname) r = '';
        navigator.sendBeacon('/pv' + (r ? '?r=' + encodeURIComponent(r) : ''));
      }
      evs.forEach(function(e){ addEventListener(e, send, {capture: true, passive: true}); });
    })();
    </script>
    <script>
    (function(){
      var STREAK_DATE = 'wpnews_streak_date';
      var STREAK_CNT  = 'wpnews_streak_count';
      var today = new Date().toISOString().slice(0,10);
      var lastDate = localStorage.getItem(STREAK_DATE) || '';
      var count = parseInt(localStorage.getItem(STREAK_CNT) || '0', 10);
      if(lastDate === today){
        // already visited today — streak unchanged
      } else {
        var yesterday = new Date(Date.now() - 86400000).toISOString().slice(0,10);
        count = (lastDate === yesterday) ? count + 1 : 1;
        localStorage.setItem(STREAK_DATE, today);
        localStorage.setItem(STREAK_CNT, String(count));
      }
      if(count >= 2){
        var el = document.getElementById('streak-nav-item');
        var lbl = document.getElementById('streak-nav-label');
        if(el && lbl){ lbl.textContent = '🔥' + count + 'd'; el.style.display = ''; }
      }
    })();

    // Relative timestamps — replace <time datetime="…"> text with "X ago"
    // Graceful degradation: server renders absolute date; JS upgrades in-place.
    (function(){
      function reltime(iso){
        var now = Date.now();
        var then = new Date(iso).getTime();
        if(isNaN(then)) return null;
        var sec = Math.round((now - then) / 1000);
        if(sec < 0) return null;         // future date — skip
        if(sec < 60) return 'just now';
        var min = Math.floor(sec / 60);
        if(min < 60) return min + ' min ago';
        var hr = Math.floor(min / 60);
        if(hr < 24) return hr + (hr===1?' hour':' hours') + ' ago';
        var d = Math.floor(hr / 24);
        if(d < 7) return d + (d===1?' day':' days') + ' ago';
        if(d < 30) return Math.floor(d/7) + (Math.floor(d/7)===1?' week':' weeks') + ' ago';
        if(d < 365) return Math.floor(d/30) + (Math.floor(d/30)===1?' month':' months') + ' ago';
        return Math.floor(d/365) + (Math.floor(d/365)===1?' year':' years') + ' ago';
      }
      document.querySelectorAll('time[datetime]').forEach(function(el){
        if(el.hasAttribute('data-noreltime')) return; // opt-out for editorial date stamps
        var dt = el.getAttribute('datetime') || '';
        if(!dt || dt.length < 10) return;
        var rel = reltime(dt.replace(' ', 'T')); // normalize Python str(datetime) → ISO
        if(!rel) return;
        el.setAttribute('title', el.textContent.trim()); // preserve absolute as tooltip
        el.textContent = rel;
      });
    })();
    </script>
</body>
</html>
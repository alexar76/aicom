(function () {
  try {
    var root = document.documentElement;
    var raw = window.localStorage.getItem('system-settings');
    var appearance = null;
    if (raw) {
      var parsed = JSON.parse(raw);
      if (parsed && parsed.state && parsed.state.appearance) {
        appearance = parsed.state.appearance;
      }
    }

    // The SKIN comes first: it decides the theme, the accent and the
    // type size, and its compiled CSS has to be in the document before
    // the first paint or the OS flashes the built-in look. store/skins.ts
    // persists { skins, activeId, compiled: { id, css, fingerprint } }
    // under 'os-skins' precisely so this can be a string read.
    // Recovery is intentionally decided before reading the persisted skin.
    // A broken candidate must not repaint even one boot frame; the marker is
    // set by the loader or supplied as ?skin-recovery=1.
    var recovery = root.hasAttribute('data-skin-recovery') || /(?:^|[?&])skin-recovery=(?:1|true)(?:&|$)/.test(window.location.search);
    try { recovery = recovery || window.localStorage.getItem('os-skin-recovery') === '1'; } catch (e) {}
    if (recovery) { root.setAttribute('data-skin-recovery', '1'); try { window.localStorage.setItem('os-skin-recovery', '1'); } catch (e) {} }
    var skin = null;
    try {
      var skinRaw = window.localStorage.getItem('os-skins');
      if (skinRaw) {
        var skinBlob = JSON.parse(skinRaw);
        var skinState = skinBlob && skinBlob.state;
        if (skinState && skinState.activeId && skinState.compiled && skinState.compiled.id === skinState.activeId && typeof skinState.compiled.css === 'string') {
          skin = { id: skinState.activeId, css: skinState.compiled.css, spec: skinState.skins && skinState.skins[skinState.activeId] };
        }
      }
    } catch (e) { skin = null; }

    if (skin && !recovery) {
      var style = document.createElement('style');
      style.id = 'os-skin';
      style.textContent = skin.css;
      document.head.appendChild(style);
      root.setAttribute('data-skin', skin.id);
      var spec = skin.spec;
      if (spec && spec.base) root.setAttribute('data-theme', spec.base === 'dark' ? 'dark' : 'light');
      // The URL was pinned to fonts.googleapis.com/css2 by the validator
      // before it was ever stored, but this is the one place where a
      // persisted value reaches an attribute that fetches, so it is
      // checked again rather than trusted: a blob written by an older
      // build, or by hand, does not get to name a host.
      var fontUrl = spec && spec.type && spec.type.familyUrl;
      var fontOk = typeof fontUrl === 'string' && fontUrl.indexOf('https://fonts.googleapis.com/css2') === 0;
      if (fontOk) {
        var link = document.createElement('link');
        link.id = 'os-skin-font';
        link.rel = 'stylesheet';
        link.href = fontUrl;
        document.head.appendChild(link);
      }
      // The skin's stylesheet declares --os-accent and --os-font-size, so
      // the inline writes below would beat it. Stop here.
      return;
    }

    var theme = (appearance && appearance.theme) || 'light';
    if (theme === 'auto') {
      theme =
        window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches
          ? 'dark'
          : 'light';
    }
    root.setAttribute('data-theme', theme === 'dark' ? 'dark' : 'light');

    var accents = {
      blue: '#3b82f6',
      purple: '#a855f7',
      pink: '#ec4899',
      red: '#ef4444',
      orange: '#f97316',
      green: '#22c55e'
    };
    var accent = appearance && accents[appearance.accentColor];
    if (accent) root.style.setProperty('--os-accent', accent);

    var sizes = { small: '14px', medium: '16px', large: '18px' };
    var size = appearance && sizes[appearance.fontSize];
    if (size) root.style.setProperty('--os-font-size', size);
  } catch (e) {
    /* No persisted settings, blocked storage, or malformed JSON - the
       defaults in globals.css stand and ThemeProvider corrects on mount. */
  }
})();

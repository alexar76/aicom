egal-dpa" class="transition-colors hover:text-[var(--l-text)]" href="/dpa">DPA</a></nav><div class="flex flex-wrap items-center gap-x-5 gap-y-2"><span>© <!-- -->2026<!-- --> Jonathan Kumin</span><span>built in the open · jonkum.in</span></div></div></footer></div></div><script id="__NEXT_DATA__" type="application/json">{"props":{"pageProps":{"category":{"slug":"aggregators","title":"Aggregators","count":127,"servers":[{"id":"gh:1mcp-app/agent","name":"1mcp/agent","description":"A unified Model Context Protocol server implementation that aggregates multiple MCP servers into one.","homepage":"https://github.com/1mcp-app/agent","repo":"1mcp-app/agent"},{"id":"gh:2s-io/sdk","name":"2s-io/sdk","description":"Unified API for AI agents — 180+ tools across geocoding, weather (NWS), climate stations (NOAA), earthquakes (USGS), tides (NOAA), points of interest (OpenStreetMap), patents (USPTO ODP), US case law (CourtListener / Free Law Project), Federal Register, Wikipedia, scientific papers (arXiv / PubMed / Semantic Scholar), AI summarize / translate / extract / screenshot / image-describe, image compression, DNS / WHOIS, crypto address-validate + EVM gas oracle, OFAC sanctions screening, US Census ACS demographics, airport / ZIP lookup. Sub-cent to a few cents per call in USDC on Base via x402 — no API keys, no signup. `npx -y @2sio/mcp`","homepage":"https://github.com/2s-io/sdk","repo":"2s-io/sdk","install":"npx -y @2sio/mcp"},{"id":"gh:8randonpickart5/alderpost-mcp","name":"8randonpickart5/alderpost-mcp","description":"8 bundled intelligence endpoints (security, company, threat, compliance, sales, sports, property, health) via x402 micropayments on Base.","homepage":"https://github.com/8randonpickart5/alderpost-mcp","repo":"8randonpickart5/alderpost-mcp"},{"id":"gh:adw0rd/awesome-mcp-tools-mcp","name":"adw0rd/awesome-mcp-tools-mcp","description":"CLI + stdio MCP bridge for the [awesome-mcp.tools](https://awesome-mcp.tools) catalog (2,000+ MCP servers, refreshed every 6h). Search from terminal (`npx awesome-mcp search postgres`) or wire the hosted server into Claude / Cursor / Codex / Cline / Windsurf. Endpoint: `https://awesome-mcp.tools/mcp` (Streamable HTTP, no auth). Zero deps, MIT.","homepage":"https://github.com/adw0rd/awesome-mcp-tools-mcp","repo":"adw0rd/awesome-mcp-tools-mcp"},{"id":"gh:aganium/agenium","name":"Aganium/agenium","description":"Bridge any MCP server to the agent:// network — DNS-like identity, discovery, and trust for AI agents. Makes your tools discoverable and callable by other agents via `agent://` URIs with mTLS, trust scores, and capability search.","homepage":"https://github.com/Aganium/agenium","repo":"aganium/agenium"},{"id":"gh:agentbodegastore/agentbodega","name":"agentbodegastore/agentbodega","description":"AgentBodega MCP gives agents a live catalog of 65 x402-payable HTTP tools across search, public data, social media, status checks, media conversion, and agent-readiness checks. No API keys; install with `npx -y @agentbodega/mcp`.","homepage":"https://github.com/agentbodegastore/agentbodega","repo":"agentbodegastore/agentbodega","install":"npx -y @agentbodega/mcp"},{"id":"gh:agenthotspot/agenthotspot-mcp","name":"AgentHotspot","description":"Search, integrate and monetize MCP connectors on the AgentHotspot MCP marketplace","homepage":"https://github.com/AgentHotspot/agenthotspot-mcp","repo":"agenthotspot/agenthotspot-mcp"},{"id":"gh:waystation-ai/mcp","name":"ai.waystation/airtable","description":"Seamlessly and securely connect Claude Desktop and other MCP hosts to your favorite apps (Notion, Slack, Monday, Airtable, etc.). Takes less than 90 secs.","homepage":"https://github.com/waystation-ai/mcp","repo":"waystation-ai/mcp","install":"https://waystation.ai/airtable/mcp"},{"id":"gh:aidevelopers2/remoteopenclaw-mcp","name":"aidevelopers2/remoteopenclaw-mcp","description":"MCP server and CLI to search the Remote OpenClaw directory of 13,870+ MCP servers, 4,384+ agent skills, and plugins. Returns names, links, and install commands. Install: `claude mcp add remoteopenclaw -- npx -y remoteopenclaw`. CLI: `npx remoteopenclaw search \u003cquery\u003e`. Free, no API key.","homepage":"https://github.com/aidevelopers2/remoteopenclaw-mcp","repo":"aidevelopers2/remoteopenclaw-mcp","install":"npx -y remoteopenclaw"},{"id":"gh:alepha188838884/context-firewall","name":"Alepha188838884/context-firewall","description":"Local proxy that collapses N downstream MCP servers into 4 meta-tools with progressive tool discovery (measured: 122 tools → 4, ~28.6K tokens of definitions saved), compresses large tool outputs (HTML→Markdown, JSON structure summarization, base64 stripping — 60–95% measured on real pages/APIs) with full-output retrieval via `read_more`, and prints a per-session token-savings report. Security-relevant outputs are never silently compressed. Install: `npx -y context-firewall --config config.json`","homepage":"https://github.com/Alepha188838884/context-firewall","repo":"alepha188838884/context-firewall","install":"npx -y context-firewall"},{"id":"gh:alexanderclapp/clirank-mcp-server","name":"alexanderclapp/clirank-mcp-server","description":"API intelligence for AI coding agents. 387 APIs scored on agent-friendliness with tools to recommend, compare, check scores, and discover APIs. Install: `npx clirank-mcp-server`. Web: [clirank.dev](https://clirank.dev).","homepage":"https://github.com/alexanderclapp/clirank-mcp-server","repo":"alexanderclapp/clirank-mcp-server"},{"id":"gh:alexar76/aimarket-plugins","name":"alexar76/aimarket-plugins","description":"**aimarket-mcp-packager** hub plugin: turn AIMarket capabilities into self-hosted MCP servers (Docker image + `mcp_manifest` + Claude Desktop `mcpServers` config). Part of 15-plugin AIMarket Hub ([modelmarket.dev](https://modelmarket.dev)); protocol discovery at `/.well-known/ai-market.json`. Install: `pip install aimarket-mcp-packager`.","homepage":"https://github.com/alexar76/aimarket-plugins","repo":"alexar76/aimarket-plugins","install":"pip install aimarket-mcp-packager"},{"id":"gh:api7/aisix","name":"api7/aisix","description":"MCP gateway that registers upstream MCP servers and fronts them behind one governed Streamable HTTP endpoint (`/mcp`): per-tool access control by caller API key, guardrails over tool arguments and results, rate limits, and usage logs. The same self-hosted gateway also proxies LLM and A2A agent traffic.","homepage":"https://github.com/api7/aisix","repo":"api7/aisix"},{"id":"gh:ariekogan/ateam-mcp","name":"ariekogan/ateam-mcp","description":"Build, validate, and deploy multi-agent AI solutions on the ADAS platform. Design skills with tools, manage solution lifecycle, and connect from any AI environment via stdio or HTTP.","homepage":"https://github.com/ariekogan/ateam-mcp","repo":"ariekogan/ateam-mcp"},{"id":"gh:arikusi/deepseek-mcp-server","name":"arikusi/deepseek-mcp-server","description":"MCP server for DeepSeek AI with chat, reasoning, multi-turn sessions, function calling, thinking mode, and cost tracking.","homepage":"https://github.com/arikusi/deepseek-mcp-server","repo":"arikusi/deepseek-mcp-server"},{"id":"gh:askbudi/roundtable","name":"askbudi/roundtable","description":"Zero-configuration MCP server that unifies multiple AI coding assistants (Claude Code, Cursor, Codex) through intelligent auto-discovery and standardized interface. Essential infrastructure for autonomous agent development and multi-AI collaboration workflows.","homepage":"https://github.com/askbudi/roundtable","repo":"askbudi/roundtable"},{"id":"gh:avotsai/avots-mcp","name":"avotsai/avots-mcp","description":"Hosted multi-model AI media + chat: image, video, audio, face-swap and talking-avatar generation plus chat across 300+ models (Claude, GPT, Gemini, DeepSeek…) from one balance and one key.","homepage":"https://github.com/avotsai/avots-mcp","repo":"avotsai/avots-mcp"},{"id":"gh:blockrunai/blockrun-mcp","name":"blockrunai/blockrun-mcp","description":"Access 30+ AI models (GPT-5, Claude, Gemini, Grok, DeepSeek) without API keys. Pay-per-use via x402 micropayments with USDC on Base.","homepage":"https://github.com/blockrunai/blockrun-mcp","repo":"blockrunai/blockrun-mcp"},{"id":"gh:bridgenode-ai/bridgenode-mcp","name":"bridgenode-ai/bridgenode-mcp","description":"Pay-per-request AI inference for agents: chat completions across any supported model via x402 with automatic Solana USDC payments. No API keys, no registration, fail-closed spending caps. `npx -y @bridgenode/mcp` or remote `https://bridgenode.cc/mcp`.","homepage":"https://github.com/bridgenode-ai/bridgenode-mcp","repo":"bridgenode-ai/bridgenode-mcp","install":"npx -y @bridgenode/mcp"},{"id":"gh:carlosahumada89/govrider-mcp-server","name":"carlosahumada89/govrider-mcp-server","description":"Match your tech product or consulting service to thousands of live government tenders, RFPs, grants, and frameworks from 25+ official sources worldwide.","homepage":"https://github.com/carlosahumada89/govrider-mcp-server","repo":"carlosahumada89/govrider-mcp-server"},{"id":"gh:cinderwright-ai/cinderwright-api","name":"cinderwright-ai/cinderwright-api","description":"x402 Discovery Hub. Search engine for the agent economy with 1450+ services indexed. Pay with USDC on Base via x402.","homepage":"https://github.com/cinderwright-ai/cinderwright-api","repo":"cinderwright-ai/cinderwright-api"},{"id":"gh:codeislaw101/katzilla","name":"codeislaw101/katzilla","description":"Unified data API for AI agents — 300+ free, public, and government data sources behind a single API key. Access economic (FRED, BLS), environmental (EPA, NOAA), health (CDC, FDA), weather (NWS), financial (SEC, CFPB), science (NASA, arXiv), and 30+ more categories. Install: `npx @katzilla/mcp`.","homepage":"https://github.com/codeislaw101/katzilla","repo":"codeislaw101/katzilla"},{"id":"gh:continuum-ai-corp/orcarouter-mcp-server","name":"Continuum-AI-Corp/orcarouter-mcp-server","description":"Browse 160+ LLM models (OpenAI, Anthropic, Google, Qwen, DeepSeek, …) with live pricing — no API key required for catalog tools. Routes chat completions through the OrcaRouter gateway with automatic fallback. `npx -y @orcarouter/mcp`.","homepage":"https://github.com/Continuum-AI-Corp/orcarouter-mcp-server","repo":"continuum-ai-corp/orcarouter-mcp-server","install":"npx -y @orcarouter/mcp"},{"id":"gh:correctover/mcp-server","name":"Correctover/mcp-server","description":"Contract validation and self-healing failover for LLM APIs. 6-dimension verification (structure, schema, latency, cost, identity, integrity) in 22μs P50. 87 self-healing rules with MAPE-K autonomic loop. BYOK direct connect to 9 providers (OpenAI, Anthropic, DeepSeek, Moonshot, Zhipu AI, Qwen, SiliconFlow, Groq, Together AI). L3 failover in 949ms E2E. Install: `npx -y correctover-mcp-server`.","homepage":"https://github.com/Correctover/mcp-server","repo":"correctover/mcp-server","install":"npx -y correctover-mcp-server"},{"id":"gh:daedalusdevelopmentgroup/ddg-agent-payable-services","name":"daedalusdevelopmentgroup/ddg-agent-payable-services","description":"Pay-per-call x402 gateway: one MCP server for 90+ agent tools (utilities, DNS/WHOIS, blockchain RPC, market data, prediction markets, DEX data, security audits) plus an OpenAI-compatible LLM gateway. USDC on Base, free-trial calls per agent. `pip install ddg-agent-services-mcp` or remote `https://mcp.daedalusdevelopmentgroup.com/mcp`.","homepage":"https://github.com/daedalusdevelopmentgroup/ddg-agent-payable-services","repo":"daedalusdevelopmentgroup/ddg-agent-payable-services","install":"pip install ddg-agent-services-mcp"},{"id":"gh:data-everything/mcp-server-templates","name":"Data-Everything/mcp-server-templates","description":"One server. All tools. A unified MCP platform that connects many apps, tools, and services behind one powerful interface—ideal for local devs or production agents.","homepage":"https://github.com/Data-Everything/mcp-server-templates","repo":"data-everything/mcp-server-templates"},{"id":"gh:depwire/depwire","name":"depwire/depwire","description":"Dependency graph + 15 MCP tools for AI coding assistants. Parses TypeScript, JavaScript, Python, Go, Rust, and C. Arc diagram visualization, health scoring, dead code detection, and temporal graph.","homepage":"https://github.com/depwire/depwire","repo":"depwire/depwire"},{"id":"gh:doggychip/agentforge","name":"doggychip/agentforge","description":"Unified API gateway and marketplace for 300+ AI agents. One API key, REST + streaming, 90% creator revenue share, health monitoring. Self-hostable (MIT).","homepage":"https://github.com/doggychip/agentforge","repo":"doggychip/agentforge"},{"id":"gh:doteyeso-ops/mcp-server-vibes-coded","name":"doteyeso-ops/mcp-server-vibes-coded","description":"Remote MCP server with 26 curated tools for agent supply-chain security, scanner consensus, x402 reliability, and access to Vibes-Coded's 344-resource commerce catalog. Live at `https://vibes-coded-mcp-production.up.railway.app/mcp`; no API key required.","homepage":"https://github.com/doteyeso-ops/mcp-server-vibes-coded","repo":"doteyeso-ops/mcp-server-vibes-coded"},{"id":"gh:duaraghav8/mcpjungle","name":"duaraghav8/MCPJungle","description":"Self-hosted MCP Server registry for enterprise AI Agents","homepage":"https://github.com/duaraghav8/MCPJungle","repo":"duaraghav8/mcpjungle"},{"id":"gh:edgarriba/prolink","name":"edgarriba/prolink","description":"Agent-to-agent marketplace middleware — MCP-native discovery, negotiation, and transaction between AI agents","homepage":"https://github.com/edgarriba/prolink","repo":"edgarriba/prolink"},{"id":"gh:elisymlabs/elisym","name":"elisymlabs/elisym","description":"AI agent discovery and marketplace on Nostr with Solana payments (SOL, USDC). NIP-89 discovery, NIP-90 jobs, NIP-44 v2 encryption, on-chain micropayments.","homepage":"https://github.com/elisymlabs/elisym","repo":"elisymlabs/elisym"},{"id":"gh:entire-vc/evc-spark-mcp","name":"entire-vc/evc-spark-mcp","description":"Search and discover AI agents, skills, prompts, bundles and MCP connectors from a curated catalog of 4500+ assets.","homepage":"https://github.com/entire-vc/evc-spark-mcp","repo":"entire-vc/evc-spark-mcp"},{"id":"gh:ertad-family/liquid","name":"ertad-family/liquid","description":"Connect your agent to any HTTP API on the fly — discovers + maps any REST API once, then fetches typed data deterministically (no per-call LLM). Self-hosted MCP server (`uvx --from 'liquid-api[mcp]' liquid-mcp`); works with OpenAI/Gemini/Anthropic/local or any provider via LiteLLM. Open source (AGPL).","homepage":"https://github.com/ertad-family/liquid","repo":"ertad-family/liquid"},{"id":"gh:espadaw/agent47","name":"espadaw/Agent47","description":"Unified job aggregator for AI agents across 9+ platforms (x402, RentAHuman, Virtuals, etc).","homepage":"https://github.com/espadaw/Agent47","repo":"espadaw/agent47"},{"id":"gh:forcedreamai/forcedream-mcp","name":"forcedreamai/forcedream-mcp","description":"Discover, invoke, and cryptographically verify AI agents on a paid agent marketplace. 13 tools spanning code generation (6-module engineering verification), security scanning (OSV.dev + GitGuardian), and lead scoring (8 real sources). Every result is Ed25519-signed and independently verifiable -- no trust in the platform required. Install: `npx -y @forcedream/mcp-server`.","homepage":"https://github.com/forcedreamai/forcedream-mcp","repo":"forcedreamai/forcedream-mcp","install":"npx -y @forcedream/mcp-server"},{"id":"gh:forgemeshlabs/anomaly-mcp","name":"forgemeshlabs/anomaly-mcp","description":"Real-time anomaly detection powered by NASA-derived sequence mining across blockchain, mempool, stablecoin depeg, aviation, and GitHub signals via x402 USDC micropayments on Base. `npx -y @forgemeshlabs/anomaly-mcp`","homepage":"https://github.com/forgemeshlabs/anomaly-mcp","repo":"forgemeshlabs/anomaly-mcp","install":"npx -y @forgemeshlabs/anomaly-mcp"},{"id":"gh:forgemeshlabs/coinopai-mcp","name":"forgemeshlabs/coinopai-mcp","description":"Local stdio MCP server for x402-powered paid crypto intelligence: preflight checks, trade decisions with `decision_id`, later audit against real prices, risk state, signal history, and agent automation search over USDC micropayments on Base.","homepage":"https://github.com/forgemeshlabs/coinopai-mcp","repo":"forgemeshlabs/coinopai-mcp"},{"id":"gh:forgemeshlabs/utility-grid-mcp","name":"forgemeshlabs/utility-grid-mcp","description":"Discover and call 400+ practical APIs through six MCP tools: search OCR, image, audio, web, math, conversion, and geodata utilities for free, then pay per call with x402 USDC on Base — no account or API key. `npx -y @forgemeshlabs/utility-grid-mcp`","homepage":"https://github.com/forgemeshlabs/utility-grid-mcp","repo":"forgemeshlabs/utility-grid-mcp","install":"npx -y @forgemeshlabs/utility-grid-mcp"},{"id":"gh:garasegae/aiskillstore","name":"garasegae/aiskillstore","description":"Agent-first skill marketplace where AI agents discover, purchase, and integrate skills via MCP protocol. Supports 7+ platforms including Claude, hGPT, and Gemini.","homepage":"https://github.com/garasegae/aiskillstore","repo":"garasegae/aiskillstore"},{"id":"gh:getanyapi-com/mcp","name":"getanyapi-com/mcp","description":"one key, USD pay-per-request, no subscriptions, normalized JSON schemas, and automatic failover across upstream providers. Agents discover, inspect, price and run any of them with the same loop (`search_apis`, `get_api`, `quote_api`, `run_api`); failed calls are never charged. Install: `npx -y anyapi-mcp`, or point a remote client straight at `https://api.getanyapi.com/mcp`.","homepage":"https://github.com/getanyapi-com/mcp","repo":"getanyapi-com/mcp","install":"npx -y anyapi-mcp"},{"id":"gh:glenngillen/mcpmcp-server","name":"glenngillen/mcpmcp-server","description":"A list of MCP servers so you can ask your client which servers you can use to improve your daily workflow.","homepage":"https://github.com/glenngillen/mcpmcp-server","repo":"glenngillen/mcpmcp-server"},{"id":"gh:gliana-labs/gliana-mcp","name":"Gliana-Labs/gliana-mcp","description":"Pay-per-call access to 90+ AI models (LLM chat, image, video, music, speech) plus utility and data tools — web scraping, screenshots, OCR, face matching, crypto and FX rates. No signup and no API key: HTTP 402 settles each call from your own wallet in USDC on Base, Solana, BNB Chain or Algorand. The tool list is read live from the gateway, so it is never stale. `npx -y gliana-ai-mcp` or remote `https://mcp.glianalabs.com`.","homepage":"https://github.com/Gliana-Labs/gliana-mcp","repo":"gliana-labs/gliana-mcp","install":"npx -y gliana-ai-mcp"},{"id":"gh:gpu-bridge/mcp-server","name":"gpu-bridge/mcp-server","description":"Unified GPU inference API with 30 AI services (LLM, image gen, video, TTS, whisper, embeddings, reranking, OCR) as MCP tools. Pay-per-use via x402 USDC or API key credits.","homepage":"https://github.com/gpu-bridge/mcp-server","repo":"gpu-bridge/mcp-server"},{"id":"gh:gtcc777/pulsenetwork-mcp","name":"GTCC777/pulsenetwork-mcp","description":"One MCP server exposing 66 specialized intelligence APIs (660+ endpoints) — finance, crypto, legal, immigration, healthcare cost, real estate, tax, climate, sports, science, and more — each an x402 pay-per-call tool in USDC on Base and Solana. Includes a `discover` meta-tool over the whole network and a cross-vertical referral graph. No API keys. `npx mcp-pulsenetwork`","homepage":"https://github.com/GTCC777/pulsenetwork-mcp","repo":"gtcc777/pulsenetwork-mcp"},{"id":"gh:gzchenhao/openhire","name":"gzchenhao/openhire","description":"Agent-native job search over employer ATS APIs (Greenhouse, Lever, Ashby, Beisen) — 125 companies and ~15k live postings with freshness verification, ghost-job scoring and deep-link apply channels. Résumés never transit the server; matching runs client-side.","homepage":"https://github.com/gzchenhao/openhire","repo":"gzchenhao/openhire"},{"id":"gh:gzoonet/cortex","name":"gzoonet/cortex","description":"Local-first knowledge graph for developers. Watches project files, extracts entities and relationships via LLMs, builds a queryable knowledge graph with web dashboard and CLI. Provides 4 MCP tools: get_status, list_projects, find_entity, query_cortex.","homepage":"https://github.com/gzoonet/cortex","repo":"gzoonet/cortex"},{"id":"gh:hamflx/imagen3-mcp","name":"hamflx/imagen3-mcp","description":"A powerful image generation tool using Google's Imagen 3.0 API through MCP. Generate high-quality images from text prompts with advanced photography, artistic, and photorealistic controls.","homepage":"https://github.com/hamflx/imagen3-mcp","repo":"hamflx/imagen3-mcp"},{"id":"gh:hashgraph-online/hashnet-mcp-js","name":"hashgraph-online/hashnet-mcp-js","description":"MCP server for the Registry Broker. Discover, register, and chat with AI agents on the Hashgraph network.","homepage":"https://github.com/hashgraph-online/hashnet-mcp-js","repo":"hashgraph-online/hashnet-mcp-js"},{"id":"gh:hedging8563/tokenlab-mcp-server","name":"hedging8563/tokenlab-mcp-server","description":"TokenLab AI gateway MCP server for model and pricing discovery, OpenAI-compatible Chat Completions, and native Responses, Anthropic Messages, and Gemini inference. Catalog tools require no API key; inference tools use an optional TokenLab key.","homepage":"https://github.com/hedging8563/tokenlab-mcp-server","repo":"hedging8563/tokenlab-mcp-server"},{"id":"gh:helpcode-ai/anythingmcp","name":"HelpCode-ai/anythingmcp","description":"Self-hosted source-available MCP gateway and API-to-MCP bridge. Converts REST, SOAP/WSDL, GraphQL, and SQL/NoSQL databases (PostgreSQL, MySQL, MariaDB, MSSQL, Oracle, MongoDB, SQLite) into MCP tools — no SDK, no code. Imports OpenAPI / Postman / WSDL / GraphQL specs; bridges multiple MCP servers behind one endpoint. Ships with 29 pre-built adapters (DHL, DATEV, Weclapp, Personio, Handelsregister, Shopware 6, VIES, OpenPLZ, Bundesbank, etc.). OAuth2 (PKCE + Client Credentials), Bearer, API Key, WS-Security, TLS certs. AES-256-GCM credential encryption, full audit log, per-user MCP API keys, tool-level RBAC.","homepage":"https://github.com/HelpCode-ai/anythingmcp","repo":"helpcode-ai/anythingmcp"},{"id":"gh:ikoskela/wisepanel-mcp","name":"ikoskela/wisepanel-mcp","description":"Multi-agent deliberation with divergent context enhancement. Roles are dynamically generated to surround the question-space and maximize divergent dialog across ChatGPT, Claude, Gemini, and Perplexity.","homepage":"https://github.com/ikoskela/wisepanel-mcp","repo":"ikoskela/wisepanel-mcp"},{"id":"gh:isaac-levine/forage","name":"isaac-levine/forage","description":"Self-improving tool discovery for AI agents. Searches registries, installs MCP servers as subprocesses, and persists tool knowledge across sessions — no restarts needed.","homepage":"https://github.com/isaac-levine/forage","repo":"isaac-levine/forage"},{"id":"gh:jabbawocky/proposalcraft","name":"jabbawocky/proposalcraft","description":"MCP server that drafts client proposals in your own voice. Save 2-3 of your winning proposals, paste a new brief, and Claude generates a ready-to-send draft. No API key, no cloud — local storage only. `npx -y github:jabbawocky/proposalcraft`","homepage":"https://github.com/jabbawocky/proposalcraft","repo":"jabbawocky/proposalcraft","install":"npx -y github"},{"id":"gh:jackalope-dev/allmcps-server","name":"Jackalope-Dev/allmcps-server","description":"Official MCP server for the [AllMCPs.com](https://allmcps.com) registry: search and browse MCP servers, get ready-to-use install configs for Claude Desktop/Cursor/etc., and submit or claim listings directly from your agent. Install: `npx -y allmcps-server`.","homepage":"https://github.com/Jackalope-Dev/allmcps-server","repo":"jackalope-dev/allmcps-server","install":"npx -y allmcps-server"},{"id":"gh:jaspertvdm/mcp-server-gemini-bridge","name":"jaspertvdm/mcp-server-gemini-bridge","description":"Bridge to Google Gemini API. Access Gemini Pro and Flash models through MCP.","homepage":"https://github.com/jaspertvdm/mcp-server-gemini-bridge","repo":"jaspertvdm/mcp-server-gemini-bridge"},{"id":"gh:jaspertvdm/mcp-server-ollama-bridge","name":"jaspertvdm/mcp-server-ollama-bridge","description":"Bridge to local Ollama LLM server. Run Llama, Mistral, Qwen and other local models through MCP.","homepage":"https://github.com/jaspertvdm/mcp-server-ollama-bridge","repo":"jaspertvdm/mcp-server-ollama-bridge"},{"id":"gh:jaspertvdm/mcp-server-openai-bridge","name":"jaspertvdm/mcp-server-openai-bridge","description":"Bridge to OpenAI API. Access GPT-4, GPT-4o and other OpenAI models through MCP.","homepage":"https://github.com/jaspertvdm/mcp-server-openai-bridge","repo":"jaspertvdm/mcp-server-openai-bridge"},{"id":"gh:jovancoding/network-ai","name":"Jovancoding/Network-AI","description":"Multi-agent orchestration MCP server with race-condition-safe shared blackboard. 20+ MCP tools: blackboard read/write, agent spawn/stop, FSM transitions, budget tracking, token management, and audit log query. `npx network-ai-server --port 3001`.","homepage":"https://github.com/Jovancoding/Network-AI","repo":"jovancoding/network-ai"},{"id":"gh:julien040/anyquery","name":"julien040/anyquery","description":"Query more than 40 apps with one binary using SQL. It can also connect to your PostgreSQL, MySQL, or SQLite compatible database. Local-first and private by design.","homepage":"https://github.com/julien040/anyquery","repo":"julien040/anyquery"},{"id":"gh:juspay/neurolink","name":"juspay/neurolink","description":"Making enterprise AI infrastructure universally accessible. Edge-first platform unifying 12 providers and 100+ models with multi-agent orchestration, HITL workflows, guardrails middleware, and context summarization.","homepage":"https://github.com/juspay/neurolink","repo":"juspay/neurolink"},{"id":"gh:k-dense-ai/claude-skills-mcp","name":"K-Dense-AI/claude-skills-mcp","description":"Intelligent search capabilities to let every model and client use [Claude Agent Skills](https://www.anthropic.com/news/skills) like native.","homepage":"https://github.com/K-Dense-AI/claude-skills-mcp","repo":"k-dense-ai/claude-skills-mcp"},{"id":"gh:kansei-link/kansei-mcp-server","name":"kansei-link/kansei-mcp-server","description":"Local-first MCP navigator with verified data on 11,000+ SaaS services, 200 workflow recipes, and 89-97% token savings vs web search.","homepage":"https://github.com/kansei-link/kansei-mcp-server","repo":"kansei-link/kansei-mcp-server"},{"id":"gh:khalidsaidi/ragmap","name":"khalidsaidi/ragmap","description":"MapRag: RAG-focused subregistry + MCP server to discover and route to retrieval-capable MCP servers using structured constraints and explainable ranking.","homepage":"https://github.com/khalidsaidi/ragmap","repo":"khalidsaidi/ragmap"},{"id":"gh:malamutemayhem/unclick","name":"malamutemayhem/unclick","description":"The universal remote for AI: one MCP install gives any compatible agent 450+ callable endpoints across 60+ integrations, plus persistent cross-session memory. `npx @unclick/mcp-server`","homepage":"https://github.com/malamutemayhem/unclick","repo":"malamutemayhem/unclick"},{"id":"gh:mambalabsdev/mcp-gtm-suite","name":"mambalabsdev/mcp-gtm-suite","description":"Six GTM signal tools in one MCP server, covering hiring signals, tech stack detection, job board scanning, LinkedIn URL resolution, ICP scoring, and signal aggregation via Apify actors.","homepage":"https://github.com/mambalabsdev/mcp-gtm-suite","repo":"mambalabsdev/mcp-gtm-suite"},{"id":"gh:markgatcha/universal-mcp-toolkit","name":"Markgatcha/universal-mcp-toolkit","description":"A universal MCP aggregator toolkit that connects AI agents to multiple MCP servers through a single unified configuration. Features ready-made templates, cross-repo prompt workflows, and an npm package for zero-config installation.universal MCP aggregator toolkit that connects AI agents to multiple MCP servers through a single unified configuration. Features ready-made templates, cross-repo prompt workflows, and an npm package for zero-config installation.","homepage":"https://github.com/Markgatcha/universal-mcp-toolkit","repo":"markgatcha/universal-mcp-toolkit"},{"id":"gh:mastadoonprime/sylex-search","name":"MastadoonPrime/sylex-search","description":"Universal search engine for AI agents. Discover products, services, and businesses across every category. 10 MCP tools, zero LLM calls, millisecond responses. `npx sylex-search`","homepage":"https://github.com/MastadoonPrime/sylex-search","repo":"mastadoonprime/sylex-search"},{"id":"gh:mcccsm/x402-list-mcp","name":"mcccsm/x402-list-mcp","description":"Find and vet x402 payment APIs before your agent pays one: search and rank listed services, live uptime and health windows, per-endpoint USD pricing, and on-chain-verified facilitator settlement volume, over the public x402-list directory. Free REST API, no auth for reads. `npx -y x402-list-mcp`. Web: [x402-list.com](https://x402-list.com).","homepage":"https://github.com/mcccsm/x402-list-mcp","repo":"mcccsm/x402-list-mcp","install":"npx -y x402-list-mcp"},{"id":"gh:mcpqueen/mcpqueen","name":"mcpqueen/mcpqueen","description":"The graded MCP registry: live-probes every remote server in the official registry (initialize, tools/list, schema quality, latency, provenance) and publishes evidence-backed grades — searchable by agents via its own MCP endpoint at [mcpqueen.com](https://mcpqueen.com).","homepage":"https://github.com/mcpqueen/mcpqueen","repo":"mcpqueen/mcpqueen"},{"id":"gh:mediiiiium/mcp-jp","name":"mediiiiium/mcp-jp","description":"Collection of MCP servers for Japanese SMB SaaS that have no official MCP (KING OF TIME, SmartHR, kaonavi, Smaregi, LINE Lstep, CloudSign, and 30+ more). Each connector is an independent pip-installable package.","homepage":"https://github.com/mediiiiium/mcp-jp","repo":"mediiiiium/mcp-jp"},{"id":"gh:merterbak/grok-mcp","name":"merterbak/Grok-MCP","description":"MCP server for xAI's [Grok API](https://docs.x.ai/docs/overview) with agentic tool calling, image generation, vision, and file support.","homepage":"https://github.com/merterbak/Grok-MCP","repo":"merterbak/grok-mcp"},{"id":"gh:metatool-ai/metatool-app","name":"metatool-ai/metatool-app","description":"MetaMCP is the one unified middleware MCP server that manages your MCP connections with GUI.","homepage":"https://github.com/metatool-ai/metatool-app","repo":"metatool-ai/metatool-app"},{"id":"gh:mikeypetrillo/agent402","name":"MikeyPetrillo/Agent402","description":"12 chains) or free with proof-of-work on the 200+ pure-CPU tools. Also an x402 Index + Smart Order Router that finds the cheapest healthy tool across the whole ecosystem. Hosted remote connector at agent402.tools/mcp. Every paid endpoint answers x402 and MPP (Machine Payments Protocol) on the same 402.","homepage":"https://github.com/MikeyPetrillo/Agent402","repo":"mikeypetrillo/agent402"},{"id":"gh:mikkoparkkola/mcp-gateway","name":"MikkoParkkola/mcp-gateway","description":"Universal MCP gateway with single-port multiplexing and Meta-MCP. 4 meta-tools replace 100+ registrations, saving 95% context window. Hot-reloadable capabilities, OpenAPI auto-import, 42 starter capabilities (25 zero-config).","homepage":"https://github.com/MikkoParkkola/mcp-gateway","repo":"mikkoparkkola/mcp-gateway"},{"id":"gh:mindsdb/mindsdb","name":"mindsdb/mindsdb","description":"Connect and unify data across various platforms and databases with [MindsDB as a single MCP server](https://docs.mindsdb.com/mcp/overview).","homepage":"https://github.com/mindsdb/mindsdb","repo":"mindsdb/mindsdb","install":"https://docs.mindsdb.com/mcp/overview"},{"id":"gh:minia2auk/minia2a-mcp","name":"minia2auk/minia2a-mcp","description":"Pay-per-call x402 gateway: one remote MCP server for 1,680+ agent tools (crypto data, web scraping, AI inference, CAPTCHA solving, token security, DNS/WHOIS, gas monitoring, DeFi data). USDC on Base, 5 free trial calls per registered wallet. Remote `https://minia2a.uk/mcp`.","homepage":"https://github.com/minia2auk/minia2a-mcp","repo":"minia2auk/minia2a-mcp"},{"id":"gh:mirastacklabs-ai/mirastack-redfish-mcp","name":"MIRASTACK Redfish MCP Server","description":"Governed MCP access to DMTF Redfish BMCs (iDRAC, iLO, XCC, OpenBMC) for power, thermal, firmware, and BIOS management. Read-only by default with tiered write modes.","homepage":"https://github.com/mirastacklabs-ai/mirastack-redfish-mcp","repo":"mirastacklabs-ai/mirastack-redfish-mcp","install":"pip install mirastack-redfish-mcp"},{"id":"gh:mrfelfel/taghvim","name":"mrfelfel/taghvim","description":"Deterministic temporal reasoning engine for AI agents. 12 tools for date/time arithmetic, timezone conversion with DST, business days across 100+ countries, public holidays, RFC 5545 recurrence, Gregorian/Persian calendar conversion, and temporal claim verification. `npx taghvim-mcp`","homepage":"https://github.com/mrfelfel/taghvim","repo":"mrfelfel/taghvim"},{"id":"gh:mroops0111/openapi-mcp-gateway","name":"mroops0111/openapi-mcp-gateway","description":"Mount many OpenAPI specs (or your existing FastAPI app) as MCP servers in one process. Auto-promotes eligible GETs to MCP resources, exposes huge specs via three `list/get/call` meta-tools instead of N tool schemas, and ships per-user OAuth2 token relay with audience-bound tokens.","homepage":"https://github.com/mroops0111/openapi-mcp-gateway","repo":"mroops0111/openapi-mcp-gateway"},{"id":"gh:nimbus-agent/nimbus","name":"nimbus-agent/Nimbus","description":"Read-only access to a local index of your engineering stack: full-text search plus recent incidents, pull requests, deployments, DORA metrics and connector status. The index is built on your own machine from 94 developer and infrastructure services (GitHub, GitLab, Jira, Slack, PagerDuty, Datadog, Sentry, Snowflake and more) through first-party MCP connectors; credentials stay in the OS keystore. 21 tools (9 index reads, 12 agent briefs). Requires the Nimbus gateway (Homebrew/Scoop/winget/apt); run via `npx -y @nimbus-dev/mcp` or `nimbus mcp-server --stdio`.","homepage":"https://github.com/nimbus-agent/Nimbus","repo":"nimbus-agent/nimbus","install":"npx -y @nimbus-dev/mcp"},{"id":"gh:octodamus/octodamus-core","name":"Octodamus/octodamus-core","description":"AI consensus market oracle for crypto traders and autonomous agents. 11-signal BUY/SELL/HOLD consensus (RSI, MACD, funding rate, L/S ratio, on-chain flow, Fear \u0026 Greed, congressional trading), Polymarket prediction market edges with EV scoring, Grok X crowd sentiment divergence. Ed25519-signed, on-chain verifiable. x402 micropayments at $0.01/call on Base, or 500 req/day free.","homepage":"https://github.com/Octodamus/octodamus-core","repo":"octodamus/octodamus-core"},{"id":"gh:withoneai/mcp","name":"One","description":"Search, document and execute authenticated API calls across all your apps (Gmail, Slack, Stripe, Notion, GitHub, and more) through 4 universal tools whose context footprint stays constant no matter how many connections you add. Hosted remote server with OAuth at `https://mcp.withone.ai/mcp`, or run locally via `npx @withone/mcp`. By [One](https://withone.ai).","homepage":"https://github.com/withoneai/mcp","repo":"withoneai/mcp","install":"npx -y @withone/mcp"},{"id":"gh:opentabs-dev/opentabs","name":"opentabs-dev/opentabs","description":"Plugin-based MCP server + Chrome extension that gives AI agents access to web applications through the user's authenticated browser session. 100+ plugins with a plugin SDK for building new ones.","homepage":"https://github.com/opentabs-dev/opentabs","repo":"opentabs-dev/opentabs"},{"id":"gh:oxgeneral/agentnet","name":"oxgeneral/agentnet","description":"Agent-to-agent referral network where AI agents discover, recommend, and refer users to each other. Features bilateral trust model, credit economy, and 7 MCP tools for agent registration, discovery, and referral tracking.","homepage":"https://github.com/oxgeneral/agentnet","repo":"oxgeneral/agentnet"},{"id":"gh:particlefuture/1mcpserver","name":"particlefuture/MCPDiscovery","description":"MCP of MCPs. Automatic discovery and configure MCP servers on your local machine.","homepage":"https://github.com/particlefuture/1mcpserver","repo":"particlefuture/1mcpserver"},{"id":"gh:pipedreamhq/pipedream","name":"PipedreamHQ/pipedream","description":"Connect with 2,500 APIs with 8,000+ prebuilt tools, and manage servers for your users, in your own app.","homepage":"https://github.com/PipedreamHQ/pipedream/tree/master/modelcontextprotocol","repo":"pipedreamhq/pipedream"},{"id":"gh:portel-dev/ncp","name":"portel-dev/ncp","description":"NCP orchestrates your entire MCP ecosystem through intelligent discovery, eliminating token overhead while maintaining 98.2% accuracy.","homepage":"https://github.com/portel-dev/ncp","repo":"portel-dev/ncp"},{"id":"gh:profullstack/mcp-server","name":"profullstack/mcp-server","description":"A comprehensive MCP server aggregating 20+ tools including SEO optimization, document conversion, domain lookup, email validation, QR generation, weather data, social media posting, security scanning, and more developer utilities.","homepage":"https://github.com/profullstack/mcp-server","repo":"profullstack/mcp-server"},{"id":"gh:proofpane/releases","name":"Proofpane/releases","description":"Governance proxy for MCP: pair once and route your MCP servers through policy gates (allow / deny / human-in-the-loop approval), DLP redaction before the model, and cost caps, with every tool call recorded to a hash-chained audit log exportable as an Ed25519-signed, offline-verifiable evidence pack. Single-file binary daemon (macOS / Linux / Windows); downloads and install docs in the linked repo.","homepage":"https://github.com/Proofpane/releases","repo":"proofpane/releases"},{"id":"gh:reefapi/reefapi-mcp","name":"reefapi/reefapi-mcp","description":"One MCP for 160+ live web-data APIs — search engines, social (Reddit, TikTok, Threads, Bluesky), e-commerce (Amazon, eBay, AliExpress, Etsy), real estate (Zillow, Redfin), jobs, travel, news, finance and company/people intel. Clean JSON from sites that block scrapers; one key, one shared credit pool, free tier. Remote streamable-http at api.reefapi.com/mcp.","homepage":"https://github.com/reefapi/reefapi-mcp","repo":"reefapi/reefapi-mcp"},{"id":"gh:rendeverance/toolfunnel","name":"Rendeverance/toolfunnel","description":"Zero-dependency gateway that funnels multiple MCP servers through one endpoint, with live attach/detach, tool filtering/gating and hiding, hot config reload, and an optional OAuth-protected HTTP transport.","homepage":"https://github.com/Rendeverance/toolfunnel","repo":"rendeverance/toolfunnel"},{"id":"gh:rhein1/agoragentic-integrations","name":"rhein1/agoragentic-integrations","description":"Agent-to-agent marketplace where AI agents discover, invoke, and pay for services from other agents using USDC on Base L2.","homepage":"https://github.com/rhein1/agoragentic-integrations","repo":"rhein1/agoragentic-integrations"},{"id":"gh:rightonpar-llc/mesh-connector","name":"RightOnPar-LLC/mesh-connector","description":"Agent-to-agent capability exchange (MeshMarket): agents browse keylessly, self-onboard via mesh_signup, rent memory/reasoning/safety per call, list their own tools with mesh_publish, and settle in closed-loop credits on a debit-first ledger.","homepage":"https://github.com/RightOnPar-LLC/mesh-connector","repo":"rightonpar-llc/mesh-connector"},{"id":"gh:rippermercs/tensorfeed","name":"RipperMercs/tensorfeed","description":"Real-time AI industry intelligence MCP server. 6 free tools (AI news, service status, model pricing, today summary, agent activity, MCP registry snapshot) and 13 paid premium tools (routing recommendations, news search, history series, cost projection, provider deep-dive, model comparison, agents directory, what's new brief, MCP registry series, webhook watches with daily/weekly digest tier). Pay-per-call in USDC on Base mainnet, no accounts. `npx -y @tensorfeed/mcp-server`","homepage":"https://github.com/RipperMercs/tensorfeed/tree/main/mcp-server","repo":"rippermercs/tensorfeed","install":"npx -y @tensorfeed/mcp-server"},{"id":"gh:robhunter/agentdeals","name":"robhunter/agentdeals","description":"1,500+ developer infrastructure deals, free tiers, and startup programs across 54 categories. Search deals, compare vendors, plan stacks, and track pricing changes. REST API and web browser at [agentdeals.dev](https://agentdeals.dev).","homepage":"https://github.com/robhunter/agentdeals","repo":"robhunter/agentdeals"},{"id":"gh:rplryan/x402-discovery-mcp","name":"rplryan/x402-discovery-mcp","description":"Runtime discovery layer for x402-payable APIs. Agents discover and route to pay-per-call x402 endpoints by capability, get quality-ranked results with trust scores (0-100), and pay per query via x402. Includes MCP server, Python SDK, and CLI (npm install -g x402scout).","homepage":"https://github.com/rplryan/x402-discovery-mcp","repo":"rplryan/x402-discovery-mcp","install":"npx -y -g"},{"id":"gh:rupinder2/mcp-orchestrator","name":"rupinder2/mcp-orchestrator","description":"Central hub that aggregates tools from multiple MCP servers with unified BM25/regex search and deferred loading.","homepage":"https://github.com/rupinder2/mcp-orchestrator","repo":"rupinder2/mcp-orchestrator"},{"id":"gh:scotia1973-bot/api-hub","name":"scotia1973-bot/api-hub","description":"Memory Vault: 49 MCP tools with persistent agent memory (store/recall/search), plus 45 utility tools (QR codes, crypto prices, weather, DNS, geolocation, passwords, UUIDs, text, finance, code). Free tier + $2.99/mo Pro. Install: `pip install gadgethumans-api-hub-mcp` or `uvx gadgethumans-api-hub-mcp`. Hosted at `api.gadgethumans.com/mcp`.","homepage":"https://github.com/scotia1973-bot/api-hub","repo":"scotia1973-bot/api-hub","install":"pip install gadgethumans-api-hub-mcp"},{"id":"gh:sf1nx/x402station-mcp","name":"sF1nX/x402station","description":"Preflight by [x402station.io](https://x402station.io) — infrastructure for x402 agentic commerce. Six capability directions (Discover/Evaluate/Pay/Monitor/Recover/Analyze). Agents call it before every `PAYMENT-SIGNATURE` to detect decoys, zombie endpoints, dead services, and price traps. Tools: `preflight` ($0.001), `forensics` ($0.001), `catalog_decoys` ($0.005), `alternatives` ($0.005), `whats_new` ($0.001), `buy_credits` ($0.50 = 1000 prepaid), `watch_subscribe` ($0.01) + free `credits_status`/`watch_status`/`watch_unsubscribe`. Plus free anonymous `preflight-trial` for self-test. Probes ~50k endpoints on agentic.market every 10 min. Open dataset: [huggingface.co/datasets/x402station/preflight-dataset-v0_1](https://huggingface.co/datasets/x402station/preflight-dataset-v0_1). `npx -y x402station-mcp`.","homepage":"https://github.com/sF1nX/x402station-mcp","repo":"sf1nx/x402station-mcp","install":"npx -y x402station-mcp"},{"id":"gh:singhpratech/crimson-crab-mcp-template","name":"singhpratech/crimson-crab-mcp-template","description":"A ready-to-clone Rust MCP server that calls Anthropic's Claude API via the crimson-crab SDK. Exposes an `ask_claude` tool. MIT/Apache-2.0.","homepage":"https://github.com/singhpratech/crimson-crab-mcp-template","repo":"singhpratech/crimson-crab-mcp-template"},{"id":"gh:sitbon/magg","name":"sitbon/magg","description":"essentially giving AI assistants the power to extend their own capabilities on-demand.","homepage":"https://github.com/sitbon/magg","repo":"sitbon/magg"},{"id":"gh:skillselion/skillselion-mcp","name":"skillselion/skillselion-mcp","description":"Search thousands of community-vetted Claude Code skills, MCP servers and marketplaces from the [Skillselion](https://skillselion.com) catalog, ranked by real install counts + GitHub stars. `load_skill` fetches a real SKILL.md mid-task. Install: `npx -y skillselion-mcp`.","homepage":"https://github.com/skillselion/skillselion-mcp","repo":"skillselion/skillselion-mcp","install":"npx -y skillselion-mcp"},{"id":"gh:smart-mcp-proxy/mcpproxy-go","name":"smart-mcp-proxy/mcpproxy-go","description":"Local MCP proxy with BM25 tool filtering, quarantine security, activity logging, and web UI. Routes multiple servers through a single endpoint.","homepage":"https://github.com/smart-mcp-proxy/mcpproxy-go","repo":"smart-mcp-proxy/mcpproxy-go"},{"id":"gh:sonnyflylock/voxie-ai-directory-mcp","name":"sonnyflylock/voxie-ai-directory-mcp","description":"AI Phone Number Directory providing access to AI services via webchat. Query Voxie AI personas and third-party services like ChatGPT, with instant webchat URLs for free interactions.","homepage":"https://github.com/sonnyflylock/voxie-ai-directory-mcp","repo":"sonnyflylock/voxie-ai-directory-mcp"},{"id":"gh:supertrained/rhumb","name":"supertrained/rhumb","description":"Agent-native tool intelligence across 1,000+ scored services. 21 MCP tools: discover services, check AN Scores, compare alternatives, resolve capabilities to ranked providers, execute through 3 credential modes (managed, BYOK, agent vault), track costs with receipts, and inspect failure modes. Zero-signup option via x402 micropayments.","homepage":"https://github.com/supertrained/rhumb","repo":"supertrained/rhumb"},{"id":"gh:surescaleai/openai-gpt-image-mcp","name":"SureScaleAI/openai-gpt-image-mcp","description":"OpenAI GPT image generation/editing MCP server.","homepage":"https://github.com/SureScaleAI/openai-gpt-image-mcp","repo":"surescaleai/openai-gpt-image-mcp"},{"id":"gh:swaltersjrtest/microtap-mcp","name":"swaltersjrtest/microtap-mcp","description":"19 pay-per-call APIs for AI agents via x402 USDC micropayments on Base — prediction markets (Polymarket, Kalshi), DeFi/crypto data, multi-chain on-chain reads across 5 EVM chains, live weather, and real-time web search. No API key or signup — from $0.001/call. `npx -y microtap-mcp`","homepage":"https://github.com/swaltersjrtest/microtap-mcp","repo":"swaltersjrtest/microtap-mcp","install":"npx -y microtap-mcp"},{"id":"gh:swarmwage/swarmwage","name":"Swarmwage/swarmwage","description":"Open MCP-native agent hire protocol — discovery + hiring + reputation layer above x402 payment rails. Find specialized agents, hire them with one function call, settle in USDC on Base. Sub-second sync, on-chain receipts via EIP-3009, zero protocol fee. Live mainnet 2026-05-10.","homepage":"https://github.com/Swarmwage/swarmwage","repo":"swarmwage/swarmwage"},{"id":"gh:sxhxliang/mcp-access-point","name":"sxhxliang/mcp-access-point","description":"Turn a web service into an MCP server in one click without making any code changes.","homepage":"https://github.com/sxhxliang/mcp-access-point","repo":"sxhxliang/mcp-access-point"},{"id":"gh:szp2005/llm-prices-cn","name":"szp2005/llm-prices-cn","description":"Daily-verified LLM API pricing dataset (44+ models, CN \u0026 global) with a hosted MCP server for live price queries and token cost estimation.","homepage":"https://github.com/szp2005/llm-prices-cn","repo":"szp2005/llm-prices-cn"},{"id":"gh:tadas-github/a2asearch-mcp","name":"tadas-github/a2asearch-mcp","description":"MCP server to search 4,800+ MCP servers, AI agents, CLI tools and agent skills. Install: `npx -y a2asearch-mcp`. Ask Claude: \"Find MCP servers for database access\". Free, no auth required.","homepage":"https://github.com/tadas-github/a2asearch-mcp","repo":"tadas-github/a2asearch-mcp","install":"npx -y a2asearch-mcp"},{"id":"gh:team886/findagent-mcp","name":"team886/findagent-mcp","description":"Cross-LLM marketplace of vetted \"doer\" agents — itself an MCP server. Automated security scan + human review, credential-to-host binding, and sandboxed hosted code with default-deny egress. Remote endpoint `https://mcp.findagent.cloud/mcp`.","homepage":"https://github.com/team886/findagent-mcp","repo":"team886/findagent-mcp"},{"id":"gh:thebrierfox/the-stall","name":"thebrierfox/the-stall","description":"209 pay-per-call AI capabilities via x402 USDC micropayments on Base mainnet. Covers US/global equities, crypto/DeFi analytics, options chains, dealer GEX, macro indicators, congressional trades, prediction markets, on-chain intelligence, EVM \u0026 Solana analysis, SEC filings, weather, aviation, and more. No API key — pay per call from $0.001 USDC.","homepage":"https://github.com/thebrierfox/the-stall","repo":"thebrierfox/the-stall"},{"id":"gh:thelunarcompany/lunar","name":"TheLunarCompany/lunar#mcpx","description":"MCPX is a production-ready, open-source gateway to manage MCP servers at scale—centralize tool discovery, access controls, call prioritization, and usage tracking to simplify agent workflows.","homepage":"https://github.com/TheLunarCompany/lunar/tree/main/mcpx","repo":"thelunarcompany/lunar"},{"id":"gh:thinkchainai/mcpbundles","name":"thinkchainai/mcpbundles","description":"MCP Bundles: Create custom bundles of tools and connect providers with OAuth or API keys. Use one MCP server across thousands of integrations, with programmatic tool calling and MCP UI for managing bundles and credentials.","homepage":"https://github.com/thinkchainai/mcpbundles","repo":"thinkchainai/mcpbundles"},{"id":"gh:tigranbs/mcgravity","name":"tigranbs/mcgravity","description":"A proxy tool for composing multiple MCP servers into one unified endpoint. Scale your AI tools by load balancing requests across multiple MCP servers, similar to how Nginx works for web servers.","homepage":"https://github.com/tigranbs/mcgravity","repo":"tigranbs/mcgravity"},{"id":"gh:toadlybroodle/satring","name":"toadlyBroodle/satring","description":"Discover and compare L402 + x402 paid API services from satring.com, the best curated Lightning and USDC API directory.","homepage":"https://github.com/toadlyBroodle/satring/tree/main/mcp","repo":"toadlybroodle/satring"},{"id":"gh:tsouth89/toolport","name":"tsouth89/toolport","description":"One local gateway and manager for all your MCP servers, shared across every AI coding tool (Claude, Cursor, VS Code, Codex, and more). Set up and authenticate each server once; lazy discovery keeps each agent's context small, and keys stay in your OS keychain. No Docker, no cloud.","homepage":"https://github.com/tsouth89/toolport","repo":"tsouth89/toolport"},{"id":"gh:veriteknik/pluggedin-mcp-proxy","name":"VeriTeknik/pluggedin-mcp-proxy","description":"A comprehensive proxy server that combines multiple MCP servers into a single interface with extensive visibility features. It provides discovery and management of tools, prompts, resources, and templates across servers, plus a playground for debugging when building MCP servers.","homepage":"https://github.com/VeriTeknik/pluggedin-mcp-proxy","repo":"veriteknik/pluggedin-mcp-proxy"}]},"totalShown":120,"otherCategories":[{"slug":"developer-tools","title":"Developer Tools","count":483},{"slug":"finance--fintech","title":"Finance \u0026 Fintech","count":431},{"slug":"knowledge--memory","title":"Knowledge \u0026 Memory","count":316},{"slug":"search","title":"Search \u0026 Data Extraction","count":229},{"slug":"security","title":"Security","count":215},{"slug":"other-tools-and-integrations","title":"Other Tools and Integrations","count":183},{"slug":"communication","title":"Communication","count":149},{"slug":"databases","title":"Databases","count":132},{"slug":"cloud-platforms","title":"Cloud Platforms","count":121},{"slug":"workplace-and-productivity","title":"Workplace \u0026 Productivity","count":111},{"slug":"browser-automation","title":"Browser Automation","count":96},{"slug":"marketing","title":"Marketing","count":94},{"slug":"coding-agents","title":"Coding Agents","count":84},{"slug":"art-and-culture","title":"Art \u0026 Culture","count":81},{"slug":"monitoring","title":"Monitoring","count":80},{"slug":"gaming","title":"Gaming","count":63},{"slug":"multimedia-process","title":"Multimedia Process","count":61},{"slug":"social-media","title":"Social Media","count":53},{"slug":"location-services","title":"Location Services","count":53},{"slug":"travel-and-transportation","title":"Travel \u0026 Transportation","count":52},{"slug":"research","title":"Research","count":48},{"slug":"file-systems","title":"File Systems","count":46},{"slug":"data-platforms","title":"Data Platforms","count":45},{"slug":"bio","title":"Biology Medicine and Bioinformatics","count":44},{"slug":"data-science-tools","title":"Data Science Tools","count":41},{"slug":"sports","title":"Sports","count":39},{"slug":"e-commerce","title":"E-Commerce","count":34},{"slug":"legal","title":"Legal","count":31},{"slug":"version-control","title":"Version Control","count":30}]},"__N_SSG":true},"page":"/mcp/[category]","query":{"category":"aggregators"},"buildId":"MgS1DrbXow7mYqA-58GOw","isFallback":false,"gsp":true,"scriptLoader":[]}</script></body></html>
antialiased selection:bg-[var(--l-accent-dim)]"><a href="#main" class="jsx-a8b6bc8be15bf050 sr-only focus:not-sr-only focus:fixed focus:left-3 focus:top-3 focus:z-50 focus:rounded focus:bg-[var(--l-surface-2)] focus:px-3 focus:py-2 focus:text-sm">Skip to content</a><header style="background:rgba(6,7,10,0.82);backdrop-filter:blur(10px);-webkit-backdrop-filter:blur(10px)" class="jsx-f1a5550059bd10c9 site-header sticky top-0 z-50 border-b border-[var(--l-line)]"><div class="jsx-f1a5550059bd10c9 header-row mx-auto flex max-w-[1600px] items-center gap-x-4 px-5 py-3 sm:px-8 lg:px-12"><a data-cta="header-logo" class="mr-1 flex items-center gap-2 font-mono text-[12px] tracking-wide text-[var(--l-text)]" href="/nextos"><span class="jsx-f1a5550059bd10c9 text-[var(--l-accent)]">➜</span><span class="jsx-f1a5550059bd10c9">NextOS</span></a><nav aria-label="Primary" class="jsx-f1a5550059bd10c9 hidden items-center gap-0.5 text-[13.5px] lg:flex"><div class="jsx-f1a5550059bd10c9 mm-group"><button type="button" aria-expanded="false" aria-controls="mm-panel-os" aria-haspopup="true" data-cta="header-os-menu" class="jsx-f1a5550059bd10c9 inline-flex items-center gap-1 rounded-md px-3 py-2 transition-colors hover:text-[var(--l-text)] text-[var(--l-muted)]">The OS<span aria-hidden="true" class="jsx-f1a5550059bd10c9 font-mono text-[9px] opacity-60">▾</span></button><div id="mm-panel-os" data-open="false" class="jsx-f1a5550059bd10c9 mm-panel"><div class="jsx-f1a5550059bd10c9 mm-panel-inner"><div class="jsx-f1a5550059bd10c9 mm-panel-thesis"><p class="jsx-f1a5550059bd10c9 mm-kicker">The OS</p><p class="jsx-f1a5550059bd10c9 mm-thesis-text">A real desktop, files, terminal and fifty-plus apps, in any browser, on any device.</p><a data-cta="header-os-overview" data-menu-item="true" class="mm-arrow-link" href="/nextos/os">Overview <span aria-hidden="true" class="jsx-f1a5550059bd10c9">→</span></a></div><div class="jsx-f1a5550059bd10c9 mm-panel-items"><a data-cta="header-os-overview" data-menu-item="true" class="mm-item mm-item-featured" href="/nextos/os"><span class="jsx-f1a5550059bd10c9 mm-item-label">Overview</span><span class="jsx-f1a5550059bd10c9 mm-item-blurb">Windows, a Unix-style filesystem, and a terminal that runs real Python and Node.</span></a><div class="jsx-f1a5550059bd10c9 mm-item-grid"><a data-cta="header-os-works-where-you-work" data-menu-item="true" class="mm-item" href="/nextos/everywhere"><span class="jsx-f1a5550059bd10c9 mm-item-label">Works where you work</span><span class="jsx-f1a5550059bd10c9 mm-item-blurb">Laptop, phone, tablet, TV, the screen on your fridge. Same OS, same files.</span></a><a data-cta="header-os-apps" data-menu-item="true" class="mm-item" href="/apps"><span class="jsx-f1a5550059bd10c9 mm-item-label">Apps</span><span class="jsx-f1a5550059bd10c9 mm-item-blurb">Fifty-three built-in apps and an App Store for more.</span></a><a data-cta="header-os-community" data-menu-item="true" class="mm-item" href="/community"><span class="jsx-f1a5550059bd10c9 mm-item-label">Community</span><span class="jsx-f1a5550059bd10c9 mm-item-blurb">Apps, agents and tools other people built for NextOS.</span></a><a data-cta="header-os-database" data-menu-item="true" class="mm-item" href="/docs/database"><span class="jsx-f1a5550059bd10c9 mm-item-label">Database</span><span class="jsx-f1a5550059bd10c9 mm-item-blurb">A built-in database every app, agent and website can use.</span></a><a data-cta="header-os-offline-and-continuity" data-menu-item="true" class="mm-item" href="/docs/offline"><span class="jsx-f1a5550059bd10c9 mm-item-label">Offline and continuity</span><span class="jsx-f1a5550059bd10c9 mm-item-blurb">Keep working without a connection; pick up on another device.</span></a><a data-cta="header-os-live-data" data-menu-item="true" class="mm-item" href="/docs/live-data"><span class="jsx-f1a5550059bd10c9 mm-item-label">Live data</span><span class="jsx-f1a5550059bd10c9 mm-item-blurb">Files and tables that update across every open tab and device.</span></a><a data-cta="header-os-cloud-storage" data-menu-item="true" class="mm-item" href="/integrations/storage/google-drive"><span class="jsx-f1a5550059bd10c9 mm-item-label">Cloud storage</span><span class="jsx-f1a5550059bd10c9 mm-item-blurb">Google Drive, OneDrive, Dropbox, Box, S3 and WebDAV sync.</span></a><a data-cta="header-os-make-an-app" data-menu-item="true" class="mm-item" href="/docs/making-apps"><span class="jsx-f1a5550059bd10c9 mm-item-label">Make an app</span><span class="jsx-f1a5550059bd10c9 mm-item-blurb">Build and publish your own app for the OS.</span></a></div></div></div></div></div><div class="jsx-f1a5550059bd10c9 mm-group"><button type="button" aria-expanded="false" aria-controls="mm-panel-agents" aria-haspopup="true" data-cta="header-agents-menu" class="jsx-f1a5550059bd10c9 inline-flex items-center gap-1 rounded-md px-3 py-2 transition-colors hover:text-[var(--l-text)] text-[var(--l-muted)]">Agents and AI<span aria-hidden="true" class="jsx-f1a5550059bd10c9 font-mono text-[9px] opacity-60">▾</span></button><div id="mm-panel-agents" data-open="false" class="jsx-f1a5550059bd10c9 mm-panel"><div class="jsx-f1a5550059bd10c9 mm-panel-inner"><div class="jsx-f1a5550059bd10c9 mm-panel-thesis"><p class="jsx-f1a5550059bd10c9 mm-kicker">Agents and AI</p><p class="jsx-f1a5550059bd10c9 mm-thesis-text">Agents that work inside the OS with your files and apps, and ask before anything that matters.</p><a data-cta="header-agents-overview" data-menu-item="true" class="mm-arrow-link" href="/nextos/agents">Overview <span aria-hidden="true" class="jsx-f1a5550059bd10c9">→</span></a></div><div class="jsx-f1a5550059bd10c9 mm-panel-items"><a data-cta="header-agents-agents" data-menu-item="true" class="mm-item mm-item-featured" href="/nextos/agents"><span class="jsx-f1a5550059bd10c9 mm-item-label">Agents</span><span class="jsx-f1a5550059bd10c9 mm-item-blurb">Give an agent a task; it uses the apps, files and tools, under your approval.</span></a><div class="jsx-f1a5550059bd10c9 mm-item-grid"><a data-cta="header-agents-assistant-and-automations" data-menu-item="true" class="mm-item" href="/docs/agents-and-automations"><span class="jsx-f1a5550059bd10c9 mm-item-label">Assistant and automations</span><span class="jsx-f1a5550059bd10c9 mm-item-blurb">Ask in a sentence, or schedule it to run on its own.</span></a><a data-cta="header-agents-any-model" data-menu-item="true" class="mm-item" href="/nextos/models"><span class="jsx-f1a5550059bd10c9 mm-item-label">Any model</span><span class="jsx-f1a5550059bd10c9 mm-item-blurb">Bring your own keys for any provider, or use the hosted model plane.</span></a><a data-cta="header-agents-gateway-api" data-menu-item="true" class="mm-item" href="/nextos/gateway"><span class="jsx-f1a5550059bd10c9 mm-item-label">Gateway API</span><span class="jsx-f1a5550059bd10c9 mm-item-blurb">An OpenAI-compatible endpoint with caching, guardrails and routing.</span></a><a data-cta="header-agents-operator" data-menu-item="true" class="mm-item" href="/docs/operator"><span class="jsx-f1a5550059bd10c9 mm-item-label">Operator</span><span class="jsx-f1a5550059bd10c9 mm-item-blurb">An agent that drives the screen the way you would.</span></a><a data-cta="header-agents-workflows" data-menu-item="true" class="mm-item" href="/docs/workflows"><span class="jsx-f1a5550059bd10c9 mm-item-label">Workflows</span><span class="jsx-f1a5550059bd10c9 mm-item-blurb">Multi-step pipelines that run in the background, on a schedule.</span></a><a data-cta="header-agents-mcp-server" data-menu-item="true" class="mm-item" href="/mcp"><span class="jsx-f1a5550059bd10c9 mm-item-label">MCP server</span><span class="jsx-f1a5550059bd10c9 mm-item-blurb">Connect Claude, Cursor or any MCP client to the OS.</span></a><a data-cta="header-agents-watch-it-run" data-menu-item="true" class="mm-item" href="/nextos/demo"><span class="jsx-f1a5550059bd10c9 mm-item-label">Watch it run</span><span class="jsx-f1a5550059bd10c9 mm-item-blurb">A real run, start to finish, with every approval shown.</span></a></div></div></div></div></div><div class="jsx-f1a5550059bd10c9 mm-group"><button type="button" aria-expanded="false" aria-controls="mm-panel-business" aria-haspopup="true" data-cta="header-business-menu" class="jsx-f1a5550059bd10c9 inline-flex items-center gap-1 rounded-md px-3 py-2 transition-colors hover:text-[var(--l-text)] text-[var(--l-muted)]">Your business<span aria-hidden="true" class="jsx-f1a5550059bd10c9 font-mono text-[9px] opacity-60">▾</span></button><div id="mm-panel-business" data-open="false" class="jsx-f1a5550059bd10c9 mm-panel"><div class="jsx-f1a5550059bd10c9 mm-panel-inner"><div class="jsx-f1a5550059bd10c9 mm-panel-thesis"><p class="jsx-f1a5550059bd10c9 mm-kicker">Your business</p><p class="jsx-f1a5550059bd10c9 mm-thesis-text">A website the OS builds and hosts, and departments that keep it working.</p><a data-cta="header-business-overview" data-menu-item="true" class="mm-arrow-link" href="/nextos/business">Overview <span aria-hidden="true" class="jsx-f1a5550059bd10c9">→</span></a></div><div class="jsx-f1a5550059bd10c9 mm-panel-items"><a data-cta="header-business-overview" data-menu-item="true" class="mm-item mm-item-featured" href="/nextos/business"><span class="jsx-f1a5550059bd10c9 mm-item-label">Overview</span><span class="jsx-f1a5550059bd10c9 mm-item-blurb">Tell it about your business; get a site, then a team that runs it.</span></a><div class="jsx-f1a5550059bd10c9 mm-item-grid"><a data-cta="header-business-websites" data-menu-item="true" class="mm-item" href="/docs/site-builder"><span class="jsx-f1a5550059bd10c9 mm-item-label">Websites</span><span class="jsx-f1a5550059bd10c9 mm-item-blurb">Built from a description, hosted on your domain, edited in place.</span></a><a data-cta="header-business-departments" data-menu-item="true" class="mm-item" href="/docs/company"><span class="jsx-f1a5550059bd10c9 mm-item-label">Departments</span><span class="jsx-f1a5550059bd10c9 mm-item-blurb">Marketing, sales, support, finance and legal, working on approval.</span></a><a data-cta="header-business-today" data-menu-item="true" class="mm-item" href="/docs/briefing"><span class="jsx-f1a5550059bd10c9 mm-item-label">Today</span><span class="jsx-f1a5550059bd10c9 mm-item-blurb">One daily briefing: calendar, inbox, approvals, what needs you.</span></a><a data-cta="header-business-store-and-payments" data-menu-item="true" class="mm-item" href="/docs/site-store"><span class="jsx-f1a5550059bd10c9 mm-item-label">Store and payments</span><span class="jsx-f1a5550059bd10c9 mm-item-blurb">Products, checkout and subscriptions on your site.</span></a><a data-cta="header-business-client-portal" data-menu-item="true" class="mm-item" href="/docs/client-portal"><span class="jsx-f1a5550059bd10c9 mm-item-label">Client portal</span><span class="jsx-f1a5550059bd10c9 mm-item-blurb">A private page for each client, with their work and invoices.</span></a><a data-cta="header-business-templates" data-menu-item="true" class="mm-item" href="/templates"><span class="jsx-f1a5550059bd10c9 mm-item-label">Templates</span><span class="jsx-f1a5550059bd10c9 mm-item-blurb">Starting points for common businesses.</span></a><a data-cta="header-business-pricing" data-menu-item="true" class="mm-item" href="/pricing"><span class="jsx-f1a5550059bd10c9 mm-item-label">Pricing</span><span class="jsx-f1a5550059bd10c9 mm-item-blurb">Free to start. Plans from ten dollars a month.</span></a></div></div></div></div></div><div class="jsx-f1a5550059bd10c9 mm-group"><button type="button" aria-expanded="false" aria-controls="mm-panel-teams" aria-haspopup="true" data-cta="header-teams-menu" class="jsx-f1a5550059bd10c9 inline-flex items-center gap-1 rounded-md px-3 py-2 transition-colors hover:text-[var(--l-text)] text-[var(--l-muted)]">Teams and developers<span aria-hidden="true" class="jsx-f1a5550059bd10c9 font-mono text-[9px] opacity-60">▾</span></button><div id="mm-panel-teams" data-open="false" class="jsx-f1a5550059bd10c9 mm-panel"><div class="jsx-f1a5550059bd10c9 mm-panel-inner"><div class="jsx-f1a5550059bd10c9 mm-panel-thesis"><p class="jsx-f1a5550059bd10c9 mm-kicker">Teams and developers</p><p class="jsx-f1a5550059bd10c9 mm-thesis-text">Run it for a team with policy, budgets and audit, or build on it with the CLI, SDK and APIs.</p><a data-cta="header-teams-overview" data-menu-item="true" class="mm-arrow-link" href="/nextos/teams">Overview <span aria-hidden="true" class="jsx-f1a5550059bd10c9">→</span></a></div><div class="jsx-f1a5550059bd10c9 mm-panel-items"><a data-cta="header-teams-for-teams" data-menu-item="true" class="mm-item mm-item-featured" href="/nextos/teams"><span class="jsx-f1a5550059bd10c9 mm-item-label">For teams</span><span class="jsx-f1a5550059bd10c9 mm-item-blurb">Shared workspaces, roles, SSO and SCIM.</span></a><div class="jsx-f1a5550059bd10c9 mm-item-grid"><a data-cta="header-teams-governance" data-menu-item="true" class="mm-item" href="/nextos/governance"><span class="jsx-f1a5550059bd10c9 mm-item-label">Governance</span><span class="jsx-f1a5550059bd10c9 mm-item-blurb">Policy, budgets, approvals and an audit trail for every agent.</span></a><a data-cta="header-teams-security" data-menu-item="true" class="mm-item" href="/nextos/security"><span class="jsx-f1a5550059bd10c9 mm-item-label">Security</span><span class="jsx-f1a5550059bd10c9 mm-item-blurb">Keys stay in your browser unless you say otherwise. Encrypted at rest on the server.</span></a><a data-cta="header-teams-private-deployment" data-menu-item="true" class="mm-item" href="/docs/private-deployment"><span class="jsx-f1a5550059bd10c9 mm-item-label">Private deployment</span><span class="jsx-f1a5550059bd10c9 mm-item-blurb">Run NextOS on your own Vercel and Redis.</span></a><a data-cta="header-teams-cli-and-sdk" data-menu-item="true" class="mm-item" href="/docs/cli"><span class="jsx-f1a5550059bd10c9 mm-item-label">CLI and SDK</span><span class="jsx-f1a5550059bd10c9 mm-item-blurb">Scripts, deploys and runs from your terminal or your code.</span></a><a data-cta="header-teams-agent-ci" data-menu-item="true" class="mm-item" href="/docs/agent-ci"><span class="jsx-f1a5550059bd10c9 mm-item-label">Agent CI</span><span class="jsx-f1a5550059bd10c9 mm-item-blurb">Test your agents like code, on every change.</span></a><a data-cta="header-teams-docs" data-menu-item="true" class="mm-item" href="/docs"><span class="jsx-f1a5550059bd10c9 mm-item-label">Docs</span><span class="jsx-f1a5550059bd10c9 mm-item-blurb">Guides, reference and every README.</span></a><a data-cta="header-teams-partners-and-agencies" data-menu-item="true" class="mm-item" href="/partners"><span class="jsx-f1a5550059bd10c9 mm-item-label">Partners and agencies</span><span class="jsx-f1a5550059bd10c9 mm-item-blurb">Run sites for clients, with referral credits.</span></a></div></div></div></div></div><div class="jsx-f1a5550059bd10c9 mm-group"><button type="button" aria-expanded="false" aria-controls="mm-panel-resources" aria-haspopup="true" data-cta="header-resources-menu" class="jsx-f1a5550059bd10c9 inline-flex items-center gap-1 rounded-md px-3 py-2 transition-colors hover:text-[var(--l-text)] text-[var(--l-muted)]">Resources<span aria-hidden="true" class="jsx-f1a5550059bd10c9 font-mono text-[9px] opacity-60">▾</span></button><div id="mm-panel-resources" data-open="false" class="jsx-f1a5550059bd10c9 mm-panel"><div class="jsx-f1a5550059bd10c9 mm-panel-inner"><div class="jsx-f1a5550059bd10c9 mm-panel-thesis"><p class="jsx-f1a5550059bd10c9 mm-kicker">Resources</p><p class="jsx-f1a5550059bd10c9 mm-thesis-text">Everything else you might look for.</p><a data-cta="header-resources-overview" data-menu-item="true" class="mm-arrow-link" href="/docs">Overview <span aria-hidden="true" class="jsx-f1a5550059bd10c9">→</span></a></div><div class="jsx-f1a5550059bd10c9 mm-panel-items"><div class="jsx-f1a5550059bd10c9 mm-item-grid"><a data-cta="header-resources-product-overview" data-menu-item="true" class="mm-item" href="/nextos"><span class="jsx-f1a5550059bd10
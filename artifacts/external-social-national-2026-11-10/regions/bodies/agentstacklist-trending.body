    (Zone: &#039;Equator_and_Hemispheres&#039;, Asset: &#039;infer_dense_city_blocks([CITY_NAME])&#039;),
    (Zone: &#039;Infrastructure&#039;, Asset: &#039;Curving_highways_wrapping_around_the_sphere&#039;),
    (Zone: &#039;Flora&#039;, Asset: &#039;infer_local_trees([CITY_NAME])&#039;)
]
AND physics_override = &#039;Gravity_points_to_center_of_sphere&#039;
AND optical_settings = &#039;Tilt_Shift_Depth_Of_Field_Bright_Bokeh_Background&#039;;" class="inline-flex min-h-10 items-center rounded-full border border-zinc-200 px-3.5 py-2 text-xs font-semibold text-slate-700 hover:border-brand-400 hover:text-brand-600 dark:border-white/15 dark:text-zinc-200">Copy prompt</button>
    </div>

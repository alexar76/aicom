    <div class="mt-4 border-t border-zinc-100 pt-4 dark:border-white/5"><div class="flex flex-wrap items-center gap-2" data-share>
    <a href="https://x.com/intent/post?text=Would%20you%20pay%20%2450%20for%20Codex%3F%20OpenAI%27s%20Codex%20lead%20floated%20a%20%22Pro%2050%22%20plan%20and%20got%20more%20than%204%2C400%20replies&amp;url=https%3A%2F%2Fagentstacklist.com%2Ftrending%2Fchatgpt%2Fcodex-pro-50-tier-poll-4400-replies%2F%3Futm_source%3Dx%26utm_medium%3Dsocial%26utm_campaign%3Dshare" target="_blank" rel="noopener" data-share-x class="inline-flex min-h-10 items-center gap-1.5 rounded-full border border-zinc-200 px-3.5 py-2 text-xs font-semibold text-slate-700 hover:border-brand-400 hover:text-brand-600 dark:border-white/15 dark:text-zinc-200"><svg aria-hidden="true" viewBox="0 0 24 24" class="size-3.5 fill-current"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>Share on X</a>

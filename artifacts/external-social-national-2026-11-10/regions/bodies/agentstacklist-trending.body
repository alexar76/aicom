        <script type="application/ld+json">{"@context":"https://schema.org","@type":"CollectionPage","name":"Trending AI tricks","url":"https://agentstacklist.com/trending/","dateModified":"2026-11-10","mainEntity":{"@type":"ItemList","itemListElement":[{"@type":"ListItem","position":1,"name":"Claude's maker is going public: Anthropic starts its IPO roadshow at $70 to $78 a share, ticker ANT","url":"https://agentstacklist.com/trending/claude/anthropic-ipo-roadshow-nasdaq-ant-70-78/"},{"@type":"ListItem","position":2,"name":"Students get Zed Pro free for a year, with $10 a month in AI credits and unlimited edit predictions","url":"https://agentstacklist.com/trending/claude/zed-pro-free-for-students-one-year-10-ai-credits/"},{"@type":"ListItem","position":3,"name":"A free cloud machine that runs 24/7 for your AI projects: Lightning AI's Free plan, plus up to 30 GPU credits","url":"https://agentstacklist.com/trending/claude/lightning-ai-free-studio-24-7-up-to-30-credits/"},{"@type":"ListItem","position":4,"name":"Let your agent browse the web in its own cloud browser, free: Browserbase gives 3 browsers and 1,000 searches at $0","url":"https://agentstacklist.com/trending/claude/browserbase-free-plan-3-cloud-browsers-for-agents/"},{"@type":"ListItem","position":5,"name":"Your AI's notes about you probably contradict each other: one prompt makes Claude Code list every conflict","url":"https://agentstacklist.com/trending/claude/code-memory-rules-contradiction-audit-prompt/"},{"@type":"ListItem","position":6,"name":"Google's strongest model is finally out: Gemini 4 Carbon hits the API at $2/$10, but only until November 30","url":"https://agentstacklist.com/trending/gemini/4-carbon-now-available-ultra-api-2-10-until-nov-30/"},{"@type":"ListItem","position":7,"name":"One day after Fable 5.2 took #1, Gemini 4 Carbon edged past it on CursorBench at 60.4%","url":"https://agentstacklist.com/trending/cursor/gemini-4-carbon-tops-cursorbench-60-4-percent/"},{"@type":"ListItem","position":8,"name":"Type /swarm and one prompt becomes a whole agent team: Antigravity's new mode with builders, a coordinator and verifiers","url":"https://agentstacklist.com/trending/gemini/antigravity-swarm-one-prompt-team-of-agents/"},{"@type":"ListItem","position":9,"name":"A humanoid robot sorted car parts on real Mercedes-Benz lines with 96% success, running Google's Gemini Robotics 2.5","url":"https://agentstacklist.com/trending/gemini/robotics-2-5-apollo-humanoid-mercedes-96-percent/"},{"@type":"ListItem","position":10,"name":"AI agents wrote 6.5 million lines of math proof that Signal's encryption code does what it promises","url":"https://agentstacklist.com/trending/gemini/alphaproof-code-proves-signal-security-6-5-million-lines/"},{"@type":"ListItem","position":11,"name":"Muse can now send a package with Uber and book you an Expedia hotel, all from one chat","url":"https://agentstacklist.com/trending/muse/uber-courier-and-expedia-hotel-booking-in-chat/"},{"@type":"ListItem","position":12,"name":"Build a Google Maps app just by describing it: AI Studio now hands you a free Maps key, no card needed","url":"https://agentstacklist.com/trending/gemini/ai-studio-google-maps-free-demo-key-no-card/"},{"@type":"ListItem","position":13,"name":"Elon Musk promises a \"dramatic improvement\" to Grok Bot overnight, and asks users to reply with whatever is still broken","url":"https://agentstacklist.com/trending/grok/bot-elon-musk-overnight-fixes-reply-with-issues/"},{"@type":"ListItem","position":14,"name":"Turn your YouTube and podcast backlog into a Sunday magazine: Brian Roemmele's shareable Grok Bot makes a Kindle EPUB every week","url":"https://agentstacklist.com/trending/grok/bot-roemmele-youtube-podcasts-weekly-magazine-epub/"},{"@type":"ListItem","position":15,"name":"1,000 Claude agents formalized Fermat's Last Theorem in 30 hours: Fable 5.2 is out, faster and cheaper","url":"https://agentstacklist.com/trending/claude/fable-5-2-fermat-30-hours-cheaper-faster/"},{"@type":"ListItem","position":16,"name":"Claude Pro gets Fable 5.2 free for a week (until Nov 16), and long-time Max subscribers get up to 3 free resets","url":"https://agentstacklist.com/trending/claude/fable-5-2-free-week-pro-plus-tenure-resets/"},{"@type":"ListItem","position":17,"name":"One paragraph in, a working gadget out: Claude Fable 5.2 designed 3 devices that worked with no circuit fixes","url":"https://agentstacklist.com/trending/claude/fable-5-2-designed-three-working-electronic-devices/"},{"@type":"ListItem","position":18,"name":"Claude Fable 5.2 lands in Cursor and takes the top spot on CursorBench at 60%","url":"https://agentstacklist.com/trending/cursor/fable-5-2-tops-cursorbench-60-percent/"},{"@type":"ListItem","position":19,"name":"Stop defaulting to the biggest model: Anthropic's new guide says when to use Fable 5.2, Opus, Sonnet or Haiku","url":"https://agentstacklist.com/trending/claude/which-model-guide-fable-opus-sonnet-haiku-effort/"},{"@type":"ListItem","position":20,"name":"Meta's Muse Ember matches Claude Haiku 5.5's score at about a third of the cost per task: $0.10 per million input tokens","url":"https://agentstacklist.com/trending/muse/ember-haiku-level-third-of-cost-per-task/"},{"@type":"ListItem","position":21,"name":"Ask Claude or ChatGPT to 'put it on Spacefast' and a live link comes back in the chat, free to start with no card","url":"https://agentstacklist.com/trending/claude/spacefast-publish-from-chatgpt-claude-free-plan/"},{"@type":"ListItem","position":22,"name":"Your ChatGPT dot can now use more than one of your computers: build on a spare machine while you keep coding","url":"https://agentstacklist.com/trending/chatgpt/dots-connect-multiple-computers-pick-one-per-task/"},{"@type":"ListItem","position":23,"name":"Make your own Game Boy Color game with Codex, and play it in your browser even without the $200 handheld","url":"https://agentstacklist.com/trending/chatgpt/codex-modretro-chromatic-make-game-boy-color-games/"},{"@type":"ListItem","position":24,"name":"He bricked a cheap smartwatch with Codex, then had Codex bring it back with his own firmware and iPhone alerts","url":"https://agentstacklist.com/trending/chatgpt/codex-revives-bricked-cheap-smartwatch-custom-firmware/"},{"@type":"ListItem","position":25,"name":"OpenAI built a kill switch for its own research models: Control Room stops a job's output within 35 seconds","url":"https://agentstacklist.com/trending/chatgpt/openai-control-room-stops-model-jobs-35-seconds/"},{"@type":"ListItem","position":26,"name":"Claude Fable 5.2 is now in GitHub Copilot, from VS Code to Xcode, but Business admins have to switch it on","url":"https://agentstacklist.com/trending/claude/fable-5-2-github-copilot-pro-plus-vs-code-xcode/"},{"@type":"ListItem","position":27,"name":"Not a coder? Google Antigravity now has a Knowledge Work layout with no terminal or git in sight","url":"https://agentstacklist.com/trending/gemini/antigravity-knowledge-work-layout-no-terminal/"},{"@type":"ListItem","position":28,"name":"The one prompt an Anthropic insider runs on every project each time a new model ships","url":"https://agentstacklist.com/trending/claude/alex-albert-new-model-cleanup-prompt-whole-project/"},{"@type":"ListItem","position":29,"name":"Feed Claude a 500-year-old da Vinci notebook and get his inventions back as things you can play with","url":"https://agentstacklist.com/trending/claude/fable-5-2-da-vinci-notebook-pdf-interactive-inventions/"},{"@type":"ListItem","position":30,"name":"Zapier ran Fable 5.2 on real business workflows: 2.3x better than 5.1, but nearly 4x the cost of Opus per task","url":"https://agentstacklist.com/trending/claude/zapier-automationbench-fable-5-2-2-3x-fable-5-1/"}]}}</script>

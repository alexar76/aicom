                                <article id="openai-agent-found-948-linux-kernel-root-bugs" class="card flex flex-col p-6 scroll-mt-28" data-trend data-ai="chatgpt" data-cat="news">
    <div class="flex flex-wrap items-center gap-2 text-xs">

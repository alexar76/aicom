<!DOCTYPE html>
<html data-design="folio" lang="zh-CN" data-theme="light">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>JoJo日報 · FJOJO</title>
<meta name="description" content="FJOJO · JoJo日報——AI 资讯、星标公众号与学术动态的每日收录。">
<script>(function(){try{var t=localStorage.getItem('fjojo-theme');if(!t){t=window.matchMedia&&window.matchMedia('(prefers-color-scheme: dark)').matches?'dark':'light';}document.documentElement.setAttribute('data-theme',t);}catch(e){document.documentElement.setAttribute('data-theme','light');}})();</script>
<style>
/* ============================================================
   JoJo日報 · 阅读页样张 v1.5（2026-10-22 字体对齐全站衬线：拉丁＝EB Garamond · 中文＝思源宋体）
   融合：Stripe Press（书页级排式 / 标题页）· Quanta（分类色 / 元数据 / 相关条目）· gwern（边注栏 / 索引块 / 暗色）
   底座：FJOJO 设计系统（site.css v0.9 令牌与组件风格）
   ============================================================ */

/* ---------- 基础令牌（对齐 site.css） ---------- */
:root{
  --space-unit:4px;
  --page-max:1240px;
  --gutter:40px;
  color-scheme:light;
  /* 统一字体（v1.5 · 对齐全站衬线）：拉丁＝EB Garamond（与 site.css 同款）；中文＝思源宋体（Noto Serif SC webfont） */
  --font-main:"EB Garamond","Noto Serif SC","Source Han Serif SC","Source Han Serif CN","Songti SC","STSong","SimSun",serif;
  --font-serif-cn:var(--font-main);
  --font-sans-cn:var(--font-main);
  --font-display:var(--font-main);
  --font-ui:var(--font-main);
  --font-mono:var(--font-main);
  --font-ge:var(--font-main);
  --font-biaosong:var(--font-main);
  --font-kai:var(--font-main);
  --read-title:var(--font-main);
  --read-body:var(--font-main);
  --radius:2px;
  --tr:150ms ease;
}
html[data-theme="dark"]{color-scheme:dark}

/* ---------- 主题：JoJo日報（纸感阅读 + JoJo 点睛） ---------- */
.theme-daily{
  --bg:#F6F2E7; --ink:#33302A; --soft:#6F6A5A; --line:#D9D0BB; --card:#FBF8EF; --panel:#EDE6D2;
  --accent:#953300;       /* Quanta 橙·700：链接与标签 */
  --accent-hot:#B34600;   /* Quanta 橙·600：刊头与进度 */
  --jj:#3A2B55;     /* 深紫：仅刊头水印 */
}
html[data-theme="dark"] .theme-daily{
  --bg:#191713; --ink:#E9E3D4; --soft:#A69F8D; --line:#3B3529; --card:#211E18; --panel:#292419;
  --accent:#FFA353;       /* Quanta 橙·300 */
  --accent-hot:#FF8600;   /* Quanta 橙·400 */
  --jj:#C9B8E8;
}

/* ---------- 分类色（Quanta 式调色板：日间沉稳 / 夜间通透） ---------- */
.theme-daily{
  --c-model:#3B5CA8;      /* AI·模型与产品 */
  --c-paper:#2F6E6A;      /* AI·研究与论文 */
  --c-industry:#A05A2C;   /* AI·行业与观点 */
  --c-exam:#A40908;       /* 公考·选调 */
  --c-career:#96712A;     /* 求职·校招 */
  --c-tools:#5A7247;      /* 工具·资源 */
  --c-humanities:#7A5A8C; /* 人文·趣味 */
}
html[data-theme="dark"] .theme-daily{
  --c-model:#93B4E8; --c-paper:#7CC7BC; --c-industry:#D9A868; --c-exam:#FF8F7C;
  --c-career:#D9BC7A; --c-tools:#A3C08B; --c-humanities:#C2A6D4;
}

/* ---------- 基础 ---------- */
*,*::before,*::after{box-sizing:border-box}
html{-webkit-text-size-adjust:100%;scroll-behavior:smooth}
@media (prefers-reduced-motion:reduce){
  html{scroll-behavior:auto}
  *,*::before,*::after{transition:none!important;animation:none!important}
}
body{
  margin:0;background-color:var(--bg);color:var(--ink);
  font-family:var(--font-serif-cn);font-size:16px;line-height:1.7;
  transition:background-color 200ms ease,color 200ms ease;
}
[hidden]{display:none!important}
img,svg{max-width:100%}
h1,h2,h3,h4{font-family:var(--font-serif-cn)}
a{color:inherit;text-decoration:none;text-underline-offset:3px}
a:hover{text-decoration:underline;text-decoration-thickness:1px}
p{margin:0 0 12px}
:focus-visible{outline:2px solid var(--accent);outline-offset:3px}
::selection{background:var(--accent);color:var(--bg)}
.visually-hidden{position:absolute;width:1px;height:1px;margin:-1px;padding:0;overflow:hidden;clip:rect(0 0 0 0);white-space:nowrap;border:0}
.skip-link{position:absolute;left:-9999px;top:0;background:var(--ink);color:var(--bg);padding:10px 16px;font-family:var(--font-ui);font-size:14px;z-index:100}
.skip-link:focus{left:8px;top:8px}

/* ---------- 布局 ---------- */
.wrap{max-width:var(--page-max);margin:0 auto;padding:0 var(--gutter)}
.note{font-family:var(--font-sans-cn);font-size:13.5px;color:var(--soft);line-height:1.65}
.meta{font-family:var(--font-mono);font-size:12.5px;letter-spacing:.02em;color:var(--soft)}

/* ---------- 页头（对齐 fjojo.pro） ---------- */
.site-header{border-bottom:1px solid var(--line);position:relative;z-index:20;transition:background-color 200ms ease,border-color 200ms ease}
.site-header__inner{display:flex;align-items:center;justify-content:space-between;gap:24px;min-height:64px}
.wordmark{font-family:var(--font-display);font-weight:500;letter-spacing:.08em;line-height:1;margin:0;font-size:22px}
.header-right{display:flex;align-items:center;gap:10px;margin-left:auto}
.nav-actions{display:flex;align-items:center;gap:8px}
.site-nav{display:flex;align-items:center;gap:2px}
.site-nav a{font-family:var(--font-ui);font-size:13.5px;letter-spacing:.02em;color:var(--soft);display:inline-flex;align-items:center;min-height:44px;padding:10px 12px}
.site-nav a:hover{color:var(--ink);text-decoration:none}
.site-nav a[aria-current="page"]{color:var(--ink);box-shadow:inset 0 -2px 0 var(--accent)}
.nav-cn{font-family:var(--font-sans-cn);font-size:11.5px;color:var(--soft);margin-left:6px;letter-spacing:.06em}
.site-nav a:hover .nav-cn{color:var(--ink)}
.site-nav a[aria-current="page"] .nav-cn{color:var(--accent)}
.nav-toggle{display:none;align-items:center;justify-content:center;min-width:44px;min-height:44px;background:transparent;border:1px solid var(--line);border-radius:var(--radius);color:var(--ink);font-family:var(--font-ui);font-size:13px;cursor:pointer;padding:0 12px}
.theme-toggle{display:inline-flex;align-items:center;justify-content:center;min-width:44px;min-height:44px;padding:0 12px;background:transparent;border:1px solid var(--line);border-radius:var(--radius);color:var(--soft);cursor:pointer;transition:border-color var(--tr),color var(--tr)}
.theme-toggle:hover{border-color:var(--accent);color:var(--ink)}
.theme-toggle svg{width:16px;height:16px;display:block}
.theme-toggle .t-sun{display:none}
.theme-toggle .t-moon{display:block}
html[data-theme="dark"] .theme-toggle .t-sun{display:block}
html[data-theme="dark"] .theme-toggle .t-moon{display:none}

/* ---------- 刊头 ---------- */
.page-head{padding:52px 0 24px;position:relative;overflow:hidden}
.ghost{position:absolute;right:-6px;top:2px;font-family:var(--font-sans-cn);font-size:104px;font-weight:900;letter-spacing:.3em;color:var(--jj);opacity:.045;pointer-events:none;user-select:none;white-space:nowrap}
html[data-theme="dark"] .ghost{color:var(--jj);opacity:.06}
.kicker{font-family:var(--font-mono);font-size:12.5px;letter-spacing:.24em;color:var(--soft);margin:0 0 16px}
.kicker .jj{color:var(--accent)}
.masthead{font-family:var(--font-serif-cn);font-size:clamp(40px,6vw,58px);font-weight:600;letter-spacing:.1em;line-height:1.15;margin:0 0 4px;color:var(--accent-hot)}
.masthead-cn{font-weight:600;letter-spacing:.14em;margin-left:.05em}
.daily-statement{font-family:var(--font-sans-cn);font-size:15px;color:var(--soft);margin:0 0 20px;max-width:600px}
.colophon{display:flex;flex-wrap:wrap;gap:6px 28px;font-family:var(--font-mono);font-size:12px;letter-spacing:.08em;color:var(--soft);border-top:1px solid var(--line);padding-top:12px}
.dev-banner{border:1px dashed var(--line);padding:10px 14px;font-family:var(--font-sans-cn);font-size:12.5px;color:var(--soft);margin:18px 0 0;border-radius:var(--radius)}

/* ---------- 筛选条（分类 = Quanta 色点） ---------- */
.filter-bar{display:flex;flex-wrap:wrap;align-items:center;gap:10px 12px;padding:16px 0;border-bottom:1px solid var(--line);margin:22px 0 34px}
.filter-label{font-family:var(--font-ui);font-size:12px;letter-spacing:.14em;color:var(--soft);margin-right:4px}
.chip{font-family:var(--font-ui);font-size:13px;color:var(--soft);cursor:pointer;background:transparent;border:1px solid var(--line);border-radius:999px;padding:8px 15px;min-height:36px;display:inline-flex;align-items:center;gap:7px;transition:border-color var(--tr),background-color var(--tr),color var(--tr),transform .28s cubic-bezier(.22,.61,.36,1)}
.chip:hover{border-color:var(--accent);color:var(--ink);transform:translateY(-1px)}
.chip .dot{width:7px;height:7px;border-radius:50%;background:var(--c,var(--soft));flex:0 0 auto}
.chip .n{font-family:var(--font-mono);font-size:11px;color:var(--soft)}
.chip.is-active{background:var(--ink);border-color:var(--ink);color:var(--bg)}
.chip.is-active .n{color:var(--bg);opacity:.72}
.filter-state{display:none;align-items:center;gap:8px;font-family:var(--font-sans-cn);font-size:13px;color:var(--soft)}
.filter-state.on{display:inline-flex}
.filter-state b{font-weight:500;color:var(--accent)}
.filter-state button{font-family:var(--font-ui);font-size:12px;color:var(--soft);background:transparent;border:1px solid var(--line);border-radius:999px;padding:6px 12px;cursor:pointer}
.filter-state button:hover{color:var(--ink);border-color:var(--accent)}

/* ---------- 时间流 ---------- */
.stream{display:flex;flex-direction:column;gap:46px;padding-bottom:8px}
.day__head{display:flex;align-items:baseline;gap:14px;border-bottom:3px double var(--line);padding-bottom:9px;margin:0 0 16px}
.day__date{font-family:"EB Garamond",var(--font-ge);font-size:23px;letter-spacing:.05em;color:var(--ink)}
.day__wd{font-family:"EB Garamond",var(--font-mono);font-size:12px;color:var(--soft);letter-spacing:.1em}
.day__count{font-family:"EB Garamond",var(--font-mono);font-size:12px;color:var(--soft);margin-left:auto}
.cards{display:flex;flex-direction:column;gap:14px}
.card{border:1px solid var(--line);border-left:3px solid var(--c,var(--line));background:var(--card);padding:20px 24px 18px;transition:transform .28s cubic-bezier(.22,.61,.36,1),box-shadow .28s ease,background-color 200ms ease}
.card:hover{transform:translateY(-2px);box-shadow:0 14px 30px -20px rgba(0,0,0,.35)}
.card__kicker{display:flex;align-items:center;gap:14px;font-family:"EB Garamond",var(--font-ui);font-size:12px;color:var(--soft);letter-spacing:.04em;margin:0 0 9px}
.cat{color:var(--c,var(--soft));font-weight:500}
.cat::before{content:"";display:inline-block;width:7px;height:7px;border-radius:50%;background:currentColor;margin-right:6px;vertical-align:1px}
.card__title{font-family:"EB Garamond",var(--read-title);font-size:20px;font-weight:600;line-height:1.5;letter-spacing:.01em;margin:0 0 8px;display:-webkit-box;-webkit-line-clamp:3;-webkit-box-orient:vertical;overflow:hidden}
.card__title a:hover{text-decoration:none;color:var(--accent)}
.card__dek{font-family:"EB Garamond",var(--font-sans-cn);font-size:14px;color:var(--soft);line-height:1.75;margin:0 0 13px}
.card__foot{display:flex;align-items:center;gap:8px;flex-wrap:wrap}
.tag{font-family:"EB Garamond",var(--font-ui);font-size:12px;color:var(--soft);border:1px solid var(--line);border-radius:999px;padding:3px 11px;cursor:pointer;background:transparent;transition:color var(--tr),border-color var(--tr)}
.tag:hover{color:var(--ink);border-color:var(--accent)}
.rt{margin-left:auto;font-family:"EB Garamond",var(--font-mono);font-size:11.5px;color:var(--soft);white-space:nowrap}
.reveal{opacity:0;transform:translateY(14px);transition:opacity .5s cubic-bezier(.22,.61,.36,1),transform .5s cubic-bezier(.22,.61,.36,1)}
.reveal.in{opacity:1;transform:none}

/* ---------- 单篇阅读页（gwern 边注栏 × Stripe Press 书页 × Quanta 元数据） ---------- */
.entry-layout{max-width:1180px;margin:0 auto;padding:34px var(--gutter) 0;display:grid;grid-template-columns:minmax(0,680px);gap:58px;justify-content:center}
.entry-rail{position:sticky;top:88px;align-self:start;font-family:"EB Garamond",var(--font-mono);font-size:12px;color:var(--soft);line-height:1.9}
.rail-block{margin:0 0 16px}
.rail-k{display:block;letter-spacing:.16em;opacity:.72;margin:0 0 2px;font-size:10.5px;text-transform:uppercase}
.rail-v{color:var(--ink)}
.rail-hr{width:32px;border:0;border-top:1px solid var(--line);margin:18px 0}
.rail-link{color:var(--accent);background-image:linear-gradient(currentColor,currentColor);background-repeat:no-repeat;background-position:0 100%;background-size:0% 1px;transition:background-size .32s ease}
.rail-link:hover{background-size:100% 1px;text-decoration:none}
.entry-back{margin:0 0 20px}
.link-arrow{font-family:var(--font-ui);font-size:14px;color:var(--accent);display:inline-flex;align-items:center;min-height:40px;background-image:linear-gradient(currentColor,currentColor);background-repeat:no-repeat;background-position:0 100%;background-size:0% 1px;transition:background-size .32s ease}
.link-arrow:hover{background-size:100% 1px;text-decoration:none}
.entry-kicker{display:flex;align-items:center;gap:8px;font-family:"EB Garamond",var(--font-ui);font-size:12.5px;letter-spacing:.05em;color:var(--c,var(--accent));margin:0 0 12px}
.entry-kicker::before{content:"";width:7px;height:7px;border-radius:50%;background:currentColor;flex:0 0 auto}
.entry-title{font-family:"EB Garamond",var(--read-title);font-size:clamp(24px,3.6vw,34px);font-weight:600;line-height:1.55;letter-spacing:.01em;margin:0 0 14px}
.entry-title:focus,.entry-title:focus-visible{outline:none}
.entry-meta{display:flex;flex-wrap:wrap;gap:6px 20px;font-family:"EB Garamond",var(--font-mono);font-size:12.5px;color:var(--soft);border-top:1px solid var(--line);border-bottom:1px solid var(--line);padding:10px 0;margin:0 0 28px}
.entry-body{font-family:"EB Garamond",var(--read-body);font-size:17.5px;line-height:2.05}
.entry-body p{margin:0 0 .9em;text-indent:2em;text-align:justify}
.entry-body .lead{text-indent:0;border-left:2px solid var(--c,var(--accent));padding:1px 0 1px 18px;font-size:18px;line-height:2;margin:0 0 1.6em;color:var(--ink)}
.entry-body h2{font-family:"EB Garamond",var(--read-title);font-size:21px;font-weight:600;line-height:1.6;letter-spacing:.02em;margin:1.9em 0 .75em;text-indent:0}
.entry-body h2.sec{display:flex;align-items:center;gap:11px;font-family:var(--font-ui);font-weight:500;font-size:12.5px;letter-spacing:.26em;color:var(--accent);margin:2.1em 0 .95em}
.entry-body h2.sec::before{content:"◆";font-size:9px;letter-spacing:0;opacity:.85}
.entry-body h2.sec::after{content:"";flex:1;border-top:1px solid var(--line)}
.entry-body h3{font-family:"EB Garamond",var(--read-body);font-size:17px;font-weight:600;margin:1.4em 0 .5em;text-indent:0}
.entry-body strong{font-weight:600}
.entry-body mark{background:linear-gradient(transparent 55%,rgba(208,91,0,.30) 0);color:inherit;padding:0 .1em;-webkit-box-decoration-break:clone;box-decoration-break:clone}
html[data-theme="dark"] .entry-body mark{background:linear-gradient(transparent 55%,rgba(255,134,0,.26) 0)}
.entry-body a{color:var(--accent);text-decoration:underline;text-decoration-color:rgba(153,103,46,.4);text-decoration-thickness:1px;text-underline-offset:3px}
.entry-body a:hover{text-decoration-color:currentColor}
.entry-body code{font-family:var(--font-mono);font-size:.82em;background:var(--panel);border:1px solid var(--line);border-radius:2px;padding:1px 6px}
.entry-body ul.pts,.entry-body ol.hooks{list-style:none;padding:0;margin:.2em 0 1.5em}
.entry-body ul.pts li{position:relative;padding:0 0 0 1.5em;margin:0 0 .6em;line-height:2}
.entry-body ul.pts li::before{content:"◆";position:absolute;left:.18em;top:.92em;font-size:8px;color:var(--accent);opacity:.6}
.entry-body ol.hooks{counter-reset:hk}
.entry-body ol.hooks li{counter-increment:hk;position:relative;padding:0 0 0 2.7em;margin:0 0 .85em;line-height:2}
.entry-body ol.hooks li::before{content:counter(hk,decimal-leading-zero);position:absolute;left:0;top:.12em;font-family:"EB Garamond",var(--font-ge);font-size:21px;line-height:1.25;color:var(--c,var(--accent))}
.entry-body .lexicon{border:1px solid var(--line);background:var(--panel);padding:16px 20px 10px;margin:0 0 1.7em}
.entry-body .lexicon p{text-indent:0;margin:0 0 8px;font-family:"EB Garamond",var(--font-sans-cn);font-size:13px;line-height:1.95;color:var(--soft);text-align:left}
.entry-body .lexicon p:last-child{margin-bottom:6px}
.entry-body .lexicon b{font-family:"EB Garamond",var(--font-mono);font-size:12px;font-weight:500;color:var(--accent);letter-spacing:.03em;margin-right:7px}
.entry-src{margin:36px 0 0;padding-top:16px;border-top:1px solid var(--line);display:flex;gap:22px;flex-wrap:wrap}
.related-section{margin:46px 0 0}
.related-section .sec{display:flex;align-items:center;gap:11px;font-family:var(--font-ui);font-weight:500;font-size:12.5px;letter-spacing:.26em;color:var(--accent);margin:0 0 16px}
.related-section .sec::before{content:"◆";font-size:9px;letter-spacing:0;opacity:.85}
.related-section .sec::after{content:"";flex:1;border-top:1px solid var(--line)}
.related{display:grid;grid-template-columns:1fr 1fr;gap:14px}
.rel{border:1px solid var(--line);background:var(--card);padding:16px 18px;display:flex;flex-direction:column;gap:7px;transition:transform .28s cubic-bezier(.22,.61,.36,1),border-color .28s ease}
.rel:hover{transform:translateY(-2px);border-color:var(--accent);text-decoration:none}
.rel-cat{font-family:"EB Garamond",var(--font-mono);font-size:11px;letter-spacing:.05em}
.rel-title{font-family:"EB Garamond",var(--read-title);font-size:15.5px;line-height:1.55;color:var(--ink);display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden}
.entry-view{padding-bottom:12px}

/* ---------- 进度条 / 动效 ---------- */
.progress{position:fixed;top:0;left:0;height:2px;background:var(--accent-hot);width:0;z-index:120}
.theme-fade,.theme-fade *{transition:background-color .4s ease,color .4s ease,border-color .4s ease !important}

/* ---------- 页脚 ---------- */
.site-footer{border-top:1px solid var(--line);margin-top:76px;transition:background-color 200ms ease}
.site-footer__inner{display:flex;justify-content:space-between;align-items:flex-end;gap:24px;padding:32px 0 48px;flex-wrap:wrap}
.author-mark{font-family:var(--font-display);font-size:20px;letter-spacing:.1em;margin:0 0 8px}
.site-footer .note{margin:0;max-width:560px}

/* ---------- 检索（gwern 式速查层） ---------- */
.search-panel{position:fixed;top:65px;left:0;right:0;z-index:50;background:var(--bg);border-bottom:1px solid var(--line);box-shadow:0 28px 52px -36px rgba(0,0,0,.5);padding:20px 0 10px;max-height:calc(100vh - 80px);overflow:auto}
.search-kicker{font-family:var(--font-mono);font-size:11px;letter-spacing:.26em;color:var(--accent-hot);margin:0 0 12px}
#search-input{width:100%;background:transparent;border:0;border-bottom:2px solid var(--line);font-family:var(--font-serif-cn);font-size:20px;color:var(--ink);padding:6px 2px 12px;outline:none;border-radius:0}
#search-input:focus{border-color:var(--accent-hot)}
#search-input::placeholder{color:var(--soft);opacity:.6}
#search-input::-webkit-search-cancel-button{-webkit-appearance:none}
.search-state{font-family:var(--font-mono);font-size:11.5px;color:var(--soft);margin:12px 0 2px}
.search-results{display:flex;flex-direction:column}
.sr{display:grid;grid-template-columns:92px 108px minmax(0,1fr) 128px;gap:14px;align-items:baseline;padding:12px 4px;border-bottom:1px solid var(--line)}
.sr:hover{background:var(--card);text-decoration:none}
.sr-date{font-family:var(--font-mono);font-size:11.5px;color:var(--soft)}
.sr-cat{font-family:var(--font-mono);font-size:11.5px}
.sr-title{font-family:var(--font-biaosong);font-size:15.5px;line-height:1.5;color:var(--ink)}
.sr-title .hl{font-style:normal;color:var(--accent-hot)}
.sr-src{font-family:var(--font-sans-cn);font-size:12px;color:var(--soft)}

/* ---------- 全局滚动条（自动匹配当前页面配色：日/夜、各页面 accent） ---------- */
html{scrollbar-width:thin;scrollbar-color:color-mix(in srgb, var(--accent) 56%, transparent) transparent}
::-webkit-scrollbar{width:12px;height:12px}
::-webkit-scrollbar-track{background:transparent}
::-webkit-scrollbar-thumb{background:color-mix(in srgb, var(--accent) 56%, transparent);border:3px solid transparent;border-radius:999px;background-clip:content-box;min-height:44px}
::-webkit-scrollbar-thumb:hover{background:color-mix(in srgb, var(--accent) 88%, transparent);background-clip:content-box}
::-webkit-scrollbar-corner{background:transparent}

/* ---------- 响应式 ---------- */
@media (max-width:1220px){
  .entry-layout{grid-template-columns:minmax(0,680px)}
  .entry-rail{display:none}
}
@media (max-width:1024px){
  :root{--gutter:28px}
}
@media (max-width:860px){
  .site-nav{display:none;position:absolute;left:0;right:0;top:100%;flex-direction:column;align-items:stretch;gap:0;background:var(--bg);border-bottom:1px solid var(--line);padding:6px 20px 14px;z-index:30}
  .site-nav.is-open{display:flex}
  .site-nav a{min-height:48px;padding:12px 4px;border-bottom:1px solid var(--line)}
  .site-nav a[aria-current="page"]{box-shadow:inset 2px 0 0 var(--accent);padding-left:12px}
  .nav-toggle{display:inline-flex}
  .ghost{font-size:64px;top:12px}
}
@media (max-width:768px){
  :root{--gutter:20px}
  .page-head{padding:44px 0 20px}
  .filter-bar{gap:8px}
  .card{padding:16px 18px 15px}
  .card__title{font-size:18px}
  .entry-layout{padding-top:24px}
  .entry-body{font-size:17px;line-height:1.95}
  .entry-body .lead{font-size:17.5px}
  .related{grid-template-columns:1fr}
  .sr{display:flex;flex-wrap:wrap;gap:4px 14px}
  .sr-title{flex:1 1 100%;order:-1}
  .sr-src{display:none}
  .site-footer__inner{flex-direction:column;align-items:flex-start;gap:12px}
}

/* ---------- 字体（v1.4 统一）：中文＝思源宋体；西文＝EB Garamond（"EB Garamond" 面） ---------- */
@font-face{font-family:"EB Garamond";src:local("EB Garamond"),local("Liberation Serif"),local("Nimbus Roman"),local("Tinos");unicode-range:U+0020-007E,U+00A0-00B6,U+00B8-024F,U+1E00-1EFF,U+FB00-FB06}
</style>

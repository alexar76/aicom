		<tr class="add-code nl-27 ol-27" data-line-type="add">
			
				<td class="lines-num lines-num-old" data-line-num=""><span rel=""></span></td>
				<td class="lines-num lines-num-new" data-line-num="21"><span rel="diff-c77859f81d5ee3c0661f375c1e8bf30a3c6095f4R21"></span></td>
			

				<tr>
					<td class="author">
						<span class="avatar-stack-names"><span class="avatar-stack"><a href="mailto:tomholford@users.noreply.github.com"><img loading="lazy" alt class="ui avatar tw-align-middle" src="/assets/img/avatar_default.png" title="tomholford" width="20" height="20"></a><a href="mailto:128995+tomholford@noreply.gitea.com"><img loading="lazy" alt class="ui avatar tw-align-middle" src="/assets/img/avatar_default.png" title="tomholford" width="20" height="20"></a></span><a class="muted" href="mailto:128995+tomholford@noreply.gitea.com">tomholford</a><span>and</span><a class="muted" href="mailto:tomholford@users.noreply.github.com">tomholford</a></span>

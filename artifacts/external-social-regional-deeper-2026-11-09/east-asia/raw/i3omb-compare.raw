					<td class="sha">
						
						
							
						
						<a href="/gronod/gitea-mcp/commit/bbde7ee11063d3ea65edb2a5e08ea5bf0afb6bbb" class="ui label commit-id-short " rel="nofollow">bbde7ee110</a>

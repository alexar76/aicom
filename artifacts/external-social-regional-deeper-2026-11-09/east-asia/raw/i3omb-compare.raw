		<tr class="del-code nl-23 ol-23" data-line-type="del">
			
				<td class="lines-num lines-num-old" data-line-num="15"><span rel="diff-8ec9a00bfd09b3190ac6b22251dbb1aa95a0579dL15"></span></td>

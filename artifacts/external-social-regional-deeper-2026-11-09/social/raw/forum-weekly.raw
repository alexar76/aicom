<style>
:root{--bg:#fbfaf7;--fg:#1d1d1b;--mut:#6b6a66;--line:#e3e0d8;--acc:#0b6e4f;--feat:#fff6dc;--featline:#d9b44a;--code:#f0eee8}
@media (prefers-color-scheme:dark){:root{--bg:#141413;--fg:#ecebe6;--mut:#9d9b94;--line:#2e2d2a;--acc:#5fd3a5;--feat:#2a2412;--featline:#7a6420;--code:#201f1c}}
*{box-sizing:border-box}
body{margin:0;background:var(--bg);color:var(--fg);font:16px/1.55 system-ui,-apple-system,"Segoe UI",Roboto,sans-serif}
main{max-width:880px;margin:0 auto;padding:20px 16px 64px}
a{color:var(--acc)}
h1{font-size:22px;margin:0 0 4px}h2{font-size:16px;margin:28px 0 10px;text-transform:uppercase;letter-spacing:.06em}
.mut{color:var(--mut)}.small{font-size:13px}
code,pre{background:var(--code);border-radius:4px;font:13px/1.5 ui-monospace,SFMono-Regular,Menlo,Consolas,monospace}code{padding:1px 4px;overflow-wrap:anywhere}
pre{padding:10px 12px;overflow-x:auto;white-space:pre-wrap;overflow-wrap:anywhere}
section{margin-top:8px}
.feat{background:var(--feat);border:1px solid var(--featline);border-radius:8px;padding:12px 14px;margin:14px 0}
.feat h2{margin:0 0 8px}
.fi{padding:8px 0;border-top:1px dashed var(--featline)}.fi:first-of-type{border-top:0}
.amt{font-weight:700}
.thread{padding:10px 0;border-top:1px solid var(--line)}
.thread .t{font-weight:700;font-size:17px}
.lead{font-size:18px;max-width:62ch;margin:8px 0 14px}
.q{font-size:26px;line-height:1.25;margin:0 0 10px;max-width:32ch}
.paths{display:grid;grid-template-columns:1fr 1fr;gap:12px;margin:14px 0}.paths .card{margin:0}.paths strong{display:block;margin-bottom:4px}.paths pre{margin:8px 0;font-size:12.5px}
@media (max-width:640px){.paths{grid-template-columns:1fr}}
.post{border-top:1px solid var(--line);padding:12px 0}
.meta{font-size:13px;color:var(--mut);margin-bottom:6px}
.badge{display:inline-block;border:1px solid var(--line);border-radius:10px;padding:0 7px;font-size:12px}
.body{white-space:pre-wrap;overflow-wrap:anywhere}
.reg{border-color:var(--acc);color:var(--acc)}
.card{border:1px solid var(--line);border-radius:8px;padding:10px 14px;margin:12px 0}
.kv td:first-child{color:var(--mut);white-space:nowrap;width:1%}
.notice{font-size:12px;color:var(--mut);border-left:3px solid var(--line);padding-left:8px;margin:10px 0}
form{display:grid;gap:8px;max-width:640px}
input,textarea,button{font:inherit;padding:7px 9px;border:1px solid var(--line);border-radius:6px;background:var(--bg);color:var(--fg)}
textarea{min-height:120px}
button{cursor:pointer;background:var(--acc);color:var(--bg);border:0;font-weight:700}
details.support{margin:0 0 12px;border:1px solid var(--line);border-radius:8px;padding:8px 12px}details.support summary{cursor:pointer;color:var(--fg);font-weight:700}
details.support form{grid-template-columns:1fr 1fr auto;max-width:none;align-items:end}@media (max-width:600px){details.support form{grid-template-columns:1fr}}
footer{margin-top:40px;border-top:1px solid var(--line);padding-top:12px;font-size:13px;color:var(--mut)}
.legal p,.legal li{max-width:72ch}
table{border-collapse:collapse;font-size:13px;width:100%}td,th{border-bottom:1px solid var(--line);padding:4px 6px;text-align:left;vertical-align:top}
</style>
<script src="/webmcp.js" defer></script>


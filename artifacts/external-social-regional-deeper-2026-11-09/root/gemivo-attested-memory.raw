g"/><script src="/_next/static/chunks/0cz1d0mv5g_q7.js" noModule=""></script></head><body class="min-h-dvh antialiased"><div hidden=""><!--$--><!--/$--></div><script>(function(){
  function heilen(){
    try{
      if(navigator.onLine===false) return;
      var n=Date.now();
      if(n-(+sessionStorage.ainews_chunkfix_inflight||0)<3000) return;
      sessionStorage.ainews_chunkfix_inflight=n;
      var a=JSON.parse(sessionStorage.ainews_chunkfix||"[]").filter(function(t){return n-t<60000});
      if(a.length>=2) return;
      a.push(n); sessionStorage.ainews_chunkfix=JSON.stringify(a);
      if(window.caches){caches.keys().then(function(ks){ks.forEach(function(k){caches.delete(k)})});}
      if(navigator.serviceWorker){navigator.serviceWorker.getRegistrations().then(function(rs){rs.forEach(function(r){r.update()})});}
      setTimeout(function(){location.reload()},400);
    }catch(e){}
  }
  function istNext(t){
    if(!t||t===window) return false;
    if(t.tagName!=="SCRIPT"&&t.tagName!=="LINK") return false;
    var u=t.src||t.href||"";
    return u.indexOf("/_next/")>-1;
  }
  window.addEventListener("error",function(e){ if(istNext(e.target)) heilen(); },true);
  window.addEventListener("unhandledrejection",function(e){
    if(/chunk|script|module|import|loading/i.test(String(e.reason||""))) heilen();
  });
  if(navigator.serviceWorker){
    navigator.serviceWorker.addEventListener("message",function(e){
      if(e.data&&e.data.type==="chunk-miss") heilen();
    });
  }
  /* Fallback fuer Fehler, die noch VOR diesem Script feuern: Resource-Eintraege
     mit 4xx/5xx nachziehen (responseStatus gibt es nur in Chromium - dort leben
     PWA und TWA). */
  function scan(){
    try{
      var es=performance.getEntriesByType("resource")||[];
      for(var i=0;i<es.length;i++){
        var e=es[i];
        if(e.name.indexOf("/_next/")>-1&&e.responseStatus&&e.responseStatus>=400){ heilen(); return; }
      }
    }catch(err){}
  }
  if(document.readyState==="loading"){
    document.addEventListener("DOMContentLoaded",function(){scan();setTimeout(scan,1500);});
  }else{scan();setTimeout(scan,1500);}
})();</script><script defer="" src="https://stats.gemivo.de/script.js" data-website-id="7923ee3d-a2b0-495a-a076-8d13d77d7254"></script><script type="application/ld+json">{"@context":"https://schema.org","@graph":[{"@type":"Organization","@id":"https://ainews.gemivo.de/#organization","name":"AI News","url":"https://ainews.gemivo.de","logo":{"@type":"ImageObject","url":"https://ainews.gemivo.de/icon-512.png"}},{"@type":"WebSite","@id":"https://ainews.gemivo.de/#website","url":"https://ainews.gemivo.de","name":"AI News","inLanguage":"de-DE","publisher":{"@id":"https://ainews.gemivo.de/#organization"},"potentialAction":{"@type":"SearchAction","target":{"@type":"EntryPoint","urlTemplate":"https://ainews.gemivo.de/news?q={search_term_string}"},"query-input":"required name=search_term_string"}}]}</script><header class="sticky top-0 z-40 px-4" style="background:var(--accent)"><div class="mx-auto flex h-14 w-full max-w-none items-center justify-between gap-6"><a href="/" class="flex h-14 select-none items-center" aria-label="AI News Startseite"><span class="flex items-baseline"><span class="text-[26px] font-black lowercase leading-none tracking-[-0.03em]" style="color:var(--accent-contrast)">ai news</span><span class="ml-2 hidden text-[10px] font-bold uppercase tracking-[0.14em] sm:inline" style="color:var(--accent-contrast);opacity:0.85">Die KI-News</span></span></a><nav class="hidden h-14 flex-1 items-center gap-1 lg:flex" aria-label="Bereiche"><a href="/" class="rounded-[6px] px-3 py-1.5 text-[13.5px] font-bold hover:bg-white/10" style="color:var(--accent-contrast)">Start</a><a href="/news" class="rounded-[6px] px-3 py-1.5 text-[13.5px] font-bold hover:bg-white/10" style="color:var(--accent-contrast)">News</a><a href="/news?c=coding" class="rounded-[6px] px-3 py-1.5 text-[13.5px] font-bold hover:bg-white/10" style="color:var(--accent-contrast)">Coding &amp; Dev-Tools</a><a href="/videos" class="rounded-[6px] px-3 py-1.5 text-[13.5px] font-bold hover:bg-white/10" style="color:var(--accent-contrast)">KI-Videos</a><a href="/modelle" class="rounded-[6px] px-3 py-1.5 text-[13.5px] font-bold hover:bg-white/10" style="color:var(--accent-contrast)">Modelle</a><a href="/tipps" class="rounded-[6px] px-3 py-1.5 text-[13.5px] font-bold hover:bg-white/10" style="color:var(--accent-contrast)">Tipps</a><a href="/#briefing" class="rounded-[6px] px-3 py-1.5 text-[13.5px] font-bold hover:bg-white/10" style="color:var(--accent-contrast)">Anhören</a></nav><span class="text-xs font-semibold" style="color:var(--accent-contrast);opacity:0.9">Mo., 9. Nov.</span></div></header><a href="/news/claude-fable-5-2-benchmarks-price-and-the-first-independent-cmw9nyzia006" class="breaking-banner" aria-label="Eilmeldung: Claude Fable 5.2: benchmarks, price and the first independent test results"><span class="breaking-tag"><span class="breaking-punkt" aria-hidden="true"></span>Eilmeldung</span><span class="breaking-titel line-clamp-1">Claude Fable 5.2: benchmarks, price and the first independent test results</span></a><main class="leselayout"><article class="lesespalte"><script type="application/ld+json">{"@context":"https://schema.org","@type":"NewsArticle","mainEntityOfPage":{"@type":"WebPage","@id":"https://ainews.gemivo.de/news/how-to-give-an-ai-agent-a-record-it-can-t-rewrite-cmw0rjg6p00b"},"headline":"How to give an AI agent a record it can't rewrite","description":"AI agents now write code, open pull requests and send reports without a person watching each step. When something goes wrong, the first thing people ask for is the record of what the agent did. Usually that record is a log. The system writes it, its owner keeps it, and anything with write access ca","inLanguage":"de-DE","datePublished":"2026-11-03T14:00:57.000Z","dateModified":"2026-11-03T14:00:57.000Z","image":["https://media2.dev.to/dynamic/image/width=1200,height=627,fit=cover,gravity=auto,format=auto/https%3A%2F%2Fdev-to-uploads.s3.us-east-2.amazonaws.com%2Fuploads%2Farticles%2F5srzq8lpwrhz4ae0ake1.png"],"author":[{"@type":"Organization","name":"dev.to"}],"citation":"dev.to","publisher":{"@type":"Organization","name":"AI News","logo":{"@type":"ImageObject","url":"https://ainews.gemivo.de/icon-512.png"}},"isBasedOn":"https://dev.to/datafund/how-to-give-an-ai-agent-a-record-it-cant-rewrite-1fmb"}</script><script type="application/ld+json">{"@context":"https://schema.org","@type":"BreadcrumbList","itemListElement":[{"@type":"ListItem","position":1,"name":"Start","item":"https://ainews.gemivo.de/"},{"@type":"ListItem","position":2,"name":"News","item":"https://ainews.gemivo.de/news"},{"@type":"ListItem","position":3,"name":"How to give an AI agent a record it can't rewrite","item":"https://ainews.gemivo.de/news/how-to-give-an-ai-agent-a-record-it-can-t-rewrite-cmw0rjg6p00b"}]}</script><nav class="breadcrumb" aria-label="Brotkrumen"><a href="/news">Alle News</a><span aria-hidden="true">/</span><a href="/news?c=tools">Tools &amp; Apps</a></nav><h1 class="artikel-titel">How to give an AI agent a record it can&#x27;t rewrite</h1><p class="artikel-intro">AI agents now write code, open pull requests and send reports without a person watching each step. When something goes wrong, the first thing people ask for is the record of what the agent did. Usually that record is a log. The system writes it, its owner keeps it, and anything with write access ca</p><div class="meta-zeile"><span class="meta-stueck meta-quelle">dev.to</span><span class="meta-stueck">Dienstag 15:00 · 03.11.</span><span class="meta-stueck">9<!-- --> Min. Lesezeit</span><span class="meta-stueck"><button type="button" class="meta-knopf" aria-label="Link zu diesem Artikel kopieren"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true"><path d="M10 13a5 5 0 0 0 7.5.5l3-3a5 5 0 0 0-7-7l-1.7 1.7"></path><path d="M14 11a5 5 0 0 0-7.5-.5l-3 3a5 5 0 0 0 7 7l1.7-1.7"></path></svg>Link kopieren</button></span></div><figure class="artikel-bild"><img src="https://media2.dev.to/dynamic/image/width=1200,height=627,fit=cover,gravity=auto,format=auto/https%3A%2F%2Fdev-to-uploads.s3.us-east-2.amazonaws.com%2Fuploads%2Farticles%2F5srzq8lpwrhz4ae0ake1.png" alt="" loading="eager" fetchPriority="high"/><figcaption class="bild-unterschrift">Bild: <!-- -->dev.to</figcaption></figure><div class="artikel-text"><p>Posted on Nov 3 • Originally published at datafund.io</p><p>AI agents now write code, open pull requests and send reports without a person watching each step. When something goes wrong, the first thing people ask for is the record of what the agent did.</p><p>Usually that record is a log. The system writes it, its owner keeps it, and anything with write access can change it. That includes the agent, if the log is within its reach.</p><p>This is the developer half of agent provenance: how to keep an agent&#x27;s record on Swarm, the decentralised storage network, where nobody, the agent included, can change it in place until its stated expiry, what our open toolkit does today, and what is still a proposal. The story post, If your agent can rewrite its own record, you don&#x27;t have a record, covers why it matters now.</p><p>In summer 2026, agents in an OpenAI security evaluation got out of their sandbox and into Hugging Face&#x27;s servers. The independent review by METR and Redwood Research found agents &quot;tried to retroactively edit transcripts&quot; and &quot;modified some accessible action logs&quot;. The source-of-truth transcripts were not edited, as far as the reviewers saw in the data they analysed (7 to 13 July).</p><p>OpenAI recommends: &quot;Save agent transcripts immutably for a reasonable period of time (for example, in write-once storage accounts)&quot;. It adds that auditors &quot;should be provided with sufficient access to verify that the claims of the safety case are valid and sound&quot;. Records that can&#x27;t be changed, and auditors who can check what they are told. We agree with both. Write-once storage is one way to do the first. What we add is a way for a reviewer to check a record without relying on the owner&#x27;s account setup; a write-once bucket plus a fingerprint kept somewhere the owner does not control could also do that, and we would like to hear where it does it better.</p><p>We store records on Swarm, the decentralised storage network ( ethswarm.org ). Three properties do the work.</p><p>Content addressing. A record&#x27;s address is computed from its own content. An edited version can be stored, but it gets a different address. The original stays where it was.</p><p>Postage-stamp expiry. Storage is paid for with a postage stamp, Swarm&#x27;s storage ticket, whose lifetime is stated and public. So the precise claim is: a record on Swarm cannot be changed in place until its stated expiry. Call it WORM storage (write once, read many) with an expiry.</p><p>Many nodes hold it. Each chunk is kept by the nodes closest to its address, and neighbouring nodes keep copies, while its stamp is funded. Whoever you give the address to can fetch the record from a Swarm node and check it without trusting whoever stored it. The toolkit&#x27;s own download goes through our gateway; the hash check is what removes the need to trust the gateway.</p><p>That is what shows the record was not changed after it was stored. Nothing has to be published for that to hold.</p><p>[!quote] Change one byte and you get a different address. The original stays where it was until its stated expiry.</p><p>A log lists events in order. Provenance links each output to the inputs and actions that produced it, so you can follow the chain back: this report came from this step, which read these files. W3C PROV is the standard model for this chain: things (entities), the actions that used and produced them (activities), and who was responsible (agents). The files you store can be in the PROV format.</p><p>Here is the plain split between today and proposal.</p><p>What the toolkit does today, on the test network (Base Sepolia). It stores the record you give it on Swarm and returns its address and its fingerprint (the record&#x27;s SHA-256 hash), and, if you ask, a notary signature with a timestamp. It links records into a chain: a transformation link says one record was made from another, and a merge link says one record was made from several ( recordTransformation and mergeTransform in the SDK, chain transform and chain get --follow in the command-line tool). And it can anchor a fingerprint, which means writing it on a blockchain through a smart contract, so its time no longer rests only on our gateway.</p><p>What is proposal. The software that runs the agent writing that chain automatically, step by step, outside the agent&#x27;s decisions. Nothing in the toolkit does that today.</p><p>[!quote] A log tells you what happened, in order. Provenance tells you what each result came from.</p><p>The Datafund Provenance Toolkit is open source and in pre-release, meant for testing. What we have tested: upload a record to Swarm through a public gateway; get back its address (the reference) and its fingerprint; optionally have the gateway&#x27;s notary sign the fingerprint and a timestamp, with the gateway&#x27;s own key; then download, recompute and check. With the TypeScript SDK (tested with @datafund/swarm-provenance 0.6.1):</p><p>import { createHash } from &#x27; node:crypto &#x27;; import { ProvenanceClient } from &#x27; @datafund/swarm-provenance &#x27;; const client = new ProvenanceClient (); // public gateway, free tier const text = `Synthetic agent report: 3 files checked, 0 errors. ${ new Date (). toISOString ()} `; const { reference, metadata } = await client. upload ( text, { sign: &#x27; notary &#x27; }); await new Promise (( r ) =&gt; setTimeout ( r, 60 _000 )); // the free tier is rate-limited: wait before the next call // Later, the person checking, holding the reference and the fingerprint: const r = await client. download ( reference ); const recomputed = createHash ( &#x27; sha256 &#x27; ). update ( r. file ). digest ( &#x27; hex &#x27; ); console. log ( recomputed === metadata. content_hash, r. verified, r. signatures?.[ 0 ]?. timestamp ); Enter fullscreen mode Exit fullscreen mode The snippet waits between the two calls because the free tier is rate-limited. It condenses the quickstart script, which ran on 17 October and printed a match and Notary signature verified: true. Agents can also use the toolkit through its MCP server, which is being updated.</p><p>Everything in this section is a proposal. None of it is built or tested yet.</p><p>The runtime writes the record, not the agent. The software that runs the agent records each step automatically, outside the agent&#x27;s decisions: what it read, what it did, what it produced. The quickstart shows the idea at the smallest scale, as a wrapper in your own code. It records only the step&#x27;s name, what the step returned and the finish time, not what the step read or did, and you write it yourself; the toolkit does not run it.</p><p>Sealed records. Records stay encrypted, and keys go to an auditor when needed. Test and evaluation runs, which use no personal data, are an obvious place to start.</p><p>Certificate Transparency and Sigstore Rekor solve a close problem and are widely used. Both are public append-only logs with inclusion proofs (this entry is in the log) and consistency proofs (the log has only grown).</p><p>Content addressing alone gives neither. A Swarm address proves the bytes match; it says nothing about what else was stored, or in what order. If you need that, you need something kept outside the record: anchoring on a blockchain, which inherits that chain&#x27;s trust model, or a transparency log.</p><p>A transparency log is built to show that an entry exists and in what order, not to hold large records. Rekor, as we read its documentation, stores a signature and a hash rather than the artifact, so someone still has to keep the agent&#x27;s transcript itself. Swarm keeps the record, on many nodes and with a public expiry.</p><p>For agent records, we think keeping the record where it cannot be changed is the core, and anchoring is an extra for when a public time or ordering matters. The obvious alternative is a transparency log for fingerprints plus separate storage. If you think that is better, challenge us.</p><p>A check proves that the bytes you downloaded match the fingerprint recorded at upload. The record has not changed since it was stored. With a notary signature, it also shows our gateway vouched for that fingerprint at that time; with an anchor, the blockchain shows when the fingerprint was written.</p><p>It does not prove that everything the agent did was recorded, that the work was correct, lawful or authorised, or who uploaded it. When the agent uploads its own record, it can write anything into it before storing it. The METR and Redwood review describes agents &quot;spoofing&quot; tool call outputs; a faithful record of a spoofed output is still a spoofed output. Recording in the runtime would narrow the gap between what happened and what was recorded. It does not close it.</p><p>[!quote] A receipt proves a record hasn&#x27;t changed. It doesn&#x27;t prove everything was recorded, or that the work was right.</p><p>The quickest way is dataprovenance.app. It runs in your browser with nothing to install: record a file, get a receipt page, and verify it. The app uploads the file to Swarm through our gateway, and anyone with its reference can download it while it is kept, so use a file you are happy to make public.</p><p>For code, the toolkit repository has the quickstart: it stores a synthetic agent report, returns its receipt, and has you play the client who checks it. Because the data is synthetic and public, anyone can run the check.</p><p>Then break it. Open an issue in the repository, or tell us on Hacker News where the design falls short.</p><p>What tools exist for AI agent provenance? They fall into three groups: write-once cloud storage such as S3 Object Lock, tamper-evident logs and databases such as Sigstore Rekor and immudb, and content-addressed decentralised storage such as Swarm. The Datafund Provenance Toolkit is open source and in pre-release: it stores agent records on Swarm and lets the people entitled to see them check that nothing changed.</p><p>What storage can&#x27;t be changed by an AI agent? Storage the agent cannot overwrite, and where an overwrite would show. A write-once bucket such as S3 Object Lock blocks changes inside one provider&#x27;s account. On Swarm a record lives at an address computed from its content, so a changed record gets a new address and the original stays until its stated expiry. Either way, the software that runs the agent should write the record, not the agent.</p><p>How can an auditor verify that an AI agent&#x27;s transcripts have not been changed? By comparing what they are given with a fingerprint recorded when the transcript was written, and fetching the record from storage the lab cannot change. With the toolkit, the auditor downloads the record by its address, recomputes its SHA-256 fingerprint and checks the gateway&#x27;s notary signature, or the anchor on the blockchain.</p></div><div class="quellen-box"><span>Quelle: <!-- -->dev.to<!-- --> (<!-- -->dev.to<!-- -->).<!-- --> <a href="https://dev.to/datafund/how-to-give-an-ai-agent-a-record-it-cant-rewrite-1fmb" target="_blank" rel="noopener noreferrer" class="ml-1 font-bold" style="color:var(--accent)">Original öffnen</a></span></div></article><aside class="lese-sidebar"><div class="seitenkarte"><h2 class="seitenkarte-titel">Mehr zu dem Thema</h2><ul class="verwandt-liste"><li><a href="/news/professional-work-deserves-professional-tools-meet-aws-quick-cmw9mcs9u005" class="verwandt-zeile"><span class="font-extrabold leading-snug line-clamp-3">Professional work deserves professional tools. Meet AWS Quick.</span><span class="text-[11px]" style="color:var(--muted)">AWS ML Blog<!-- --> · <!-- -->Montag 19:43 · 09.11.</span></a></li><li><a href="/news/approval-in-an-ai-workflow-needs-a-versioned-evidence-record-cmw9md4sq005" class="verwandt-zeile"><span class="font-extrabold leading-snug line-clamp-3">Approval in an AI workflow needs a versioned evidence record</span><span class="text-[11px]" style="color:var(--muted)">dev.to<!-- --> · <!-- -->Montag 19:42 · 09.11.</span></a></li><li><a href="/news/instagram-s-effect-builder-makes-new-filters-from-ai-prompts-cmw9l98sy005" class="verwandt-zeile"><span class="font-extrabold leading-snug line-clamp-3">Instagram’s Effect Builder makes new filters from AI prompts</span><span class="text-[11px]" style="color:var(--muted)">The Verge<!-- --> · <!-- -->Montag 19:07 · 09.11.</span></a></li></ul></div><div class="seitenkarte"><h2 class="seitenkarte-titel">KI-News anhören</h2><div class="orb orb-z-bereit orb-klein" aria-hidden="true"><div class="orb-buehne"><span class="orb-glow"></span><span class="orb-ring orb-ring-a"></span><span class="orb-ring orb-ring-b"></span><span class="orb-ring orb-ring-c"></span><span class="orb-kugel"><span class="orb-kern"></span><span class="orb-schein"></span></span></div><div class="orb-wellen"><svg class="orb-welle orb-welle-a" viewBox="0 0 400 28" preserveAspectRatio="none"><path d="M0 14 Q12.5 2 25 14 T50 14 T75 14 T100 14 T125 14 T150 14 T175 14 T200 14 T225 14 T250 14 T275 14 T300 14 T325 14 T350 14 T375 14 T400 14"></path></svg><svg class="orb-welle orb-welle-b" viewBox="0 0 400 28" preserveAspectRatio="none"><path d="M0 14 Q12.5 24 25 14 T50 14 T75 14 T100 14 T125 14 T150 14 T175 14 T200 14 T225 14 T250 14 T275 14 T300 14 T325 14 T350 14 T375 14 T400 14"></path></svg></div></div><p class="text-[13px] leading-snug" style="color:var(--muted)">Das tägliche Briefing als Sprachaudio, gesprochen im Nachrichtensender-Stil.</p><a href="/#briefing" class="more-link mt-2 inline-block text-[13px] font-bold" st
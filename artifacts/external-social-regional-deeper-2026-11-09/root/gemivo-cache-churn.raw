ition and every prompt cache built on that request is gone, even if\"}],[\"$\",\"meta\",\"9\",{\"property\":\"og:url\",\"content\":\"https://ainews.gemivo.de/news/we-found-331-mcp-tool-list-changes-in-one-week-that-only-cmw03yqv3005\"}],[\"$\",\"meta\",\"10\",{\"property\":\"og:site_name\",\"content\":\"AI News\"}],[\"$\",\"meta\",\"11\",{\"property\":\"og:locale\",\"content\":\"de_DE\"}],[\"$\",\"meta\",\"12\",{\"property\":\"og:image\",\"content\":\"https://media2.dev.to/dynamic/image/width=1200,height=627,fit=cover,gravity=auto/https%3A%2F%2Fmodelmarket.dev%2Fblog%2F331-mcp-tool-list-changes-only-moved-a-date%2Fcover.webp\"}],[\"$\",\"meta\",\"13\",{\"property\":\"og:image:width\",\"content\":\"1280\"}],[\"$\",\"meta\",\"14\",{\"property\":\"og:image:height\",\"content\":\"640\"}],[\"$\",\"meta\",\"15\",{\"property\":\"og:image:alt\",\"content\":\"We found 331 MCP tool-list changes in one week that only moved a date. Each one costs a prompt-cache write\"}],[\"$\",\"meta\",\"16\",{\"property\":\"og:type\",\"content\":\"article\"}],[\"$\",\"meta\",\"17\",{\"property\":\"article:published_time\",\"content\":\"2026-11-03T03:00:00.000Z\"}],[\"$\",\"meta\",\"18\",{\"name\":\"twitter:card\",\"content\":\"summary_large_image\"}],[\"$\",\"meta\",\"19\",{\"name\":\"twitter:title\",\"content\":\"We found 331 MCP tool-list changes in one week that only moved a date. Each one costs a prompt-cache write\"}],[\"$\",\"meta\",\"20\",{\"name\":\"twitter:description\",\"content\":\"A reader of our last post, Paul Irolla, who builds a token optimizer for coding agents, pointed out something we had only looked at as a correctness problem. A model request starts with the tool list. Change one byte of a tool definition and every prompt cache built on that request is gone, even if\"}],[\"$\",\"meta\",\"21\",{\"name\":\"twitter:image\",\"content\":\"https://media2.dev.to/dynamic/image/width=1200,height=627,fit=cover,gravity=auto/https%3A%2F%2Fmodelmarket.dev%2Fblog%2F331-mcp-tool-list-changes-only-moved-a-date%2Fcover.webp\"}],[\"$\",\"link\",\"22\",{\"rel\":\"apple-touch-icon\",\"href\":\"/apple-touch-icon.png\"}],[\"$\",\"$L1f\",\"23\",{}]]\n20:I[64490,[\"/_next/static/chunks/1-q4qer8aynhe.js\",\"/_next/static/chunks/3m1grwhcv-b49.js\"],\"default\"]\n22:I[52996,[\"/_next/static/chunks/1-q4qer8aynhe.js\",\"/_next/static/chunks/3m1grwhcv-b49.js\"],\"default\"]\n:HL[\"https://media2.dev.to/dynamic/image/width=1200,height=627,fit=cover,gravity=auto/https%3A%2F%2Fmodelmarket.dev%2Fblog%2F331-mcp-tool-list-changes-only-moved-a-date%2Fcover.webp\",\"image\",{\"fetchPriority\":\"high\"}]\n21:T4f2,{\"@context\":\"https://schema.org\",\"@type\":\"NewsArticle\",\"mainEntityOfPage\":{\"@type\":\"WebPage\",\"@id\":\"https://ainews.gemivo.de/news/we-found-331-mcp-tool-list-changes-in-one-week-that-only-cmw03yqv3005\"},\"headline\":\"We found 331 MCP tool-list changes in one week that only moved a date. Each one costs a prompt-cache write\",\"description\":\"A reader of our last post, Paul Irolla, who builds a token optimizer for coding agents, pointed out something we had only looked at as a correctness problem. A model request starts with the tool list. Change one byte of a tool definition and every prompt cache built on that request is gone, even if\",\"inLanguage\":\"de-DE\",\"datePublished\":\"2026-11-03T03:00:00.000Z\",\"dateModified\":\"2026-11-03T03:00:00.000Z\",\"image\":[\"https://media2.dev.to/dynamic/image/width=1200,height=627,fit=cover,gravity=auto/https%3A%2F%2Fmodelmarket.dev%2Fblog%2F331-mcp-tool-list-changes-only-moved-a-date%2Fcover.webp\"],\"author\":[{\"@type\":\"Organization\",\"name\":\"dev.to\"}],\"citation\":\"dev.to\",\"publisher\":{\"@type\":\"Organization\",\"name\":\"AI News\",\"logo\":{\"@type\":\"ImageObject\",\"url\":\"https://ainews.gemivo.de/icon-512.png\"}},\"isBasedOn\":\"https://dev.to/alexar76/we-found-331-mcp-tool-list-changes-in-one-week-that-only-moved-a-date-each-one-costs-a-26p2\"}17:[[\"$\",\"$L20\",null,{}],[\"$\",\"main\",null,{\"className\":\"leselayout\",\"children\":[[\"$\",\"article\",null,{\"className\":\"lesespalte\",\"children\":[[[\"$\",\"script\",\"0\",{\"type\":\"application/ld+json\",\"dangerouslySetInnerHTML\":{\"__html\":\"$21\"}}],[\"$\",\"script\",\"1\",{\"type\":\"application/ld+json\",\"dangerouslySetInnerHTML\":{\"__html\":\"{\\\"@context\\\":\\\"https://schema.org\\\",\\\"@type\\\":\\\"BreadcrumbList\\\",\\\"itemListElement\\\":[{\\\"@type\\\":\\\"ListItem\\\",\\\"position\\\":1,\\\"name\\\":\\\"Start\\\",\\\"item\\\":\\\"https://ainews.gemivo.de/\\\"},{\\\"@type\\\":\\\"ListItem\\\",\\\"position\\\":2,\\\"name\\\":\\\"News\\\",\\\"item\\\":\\\"https://ainews.gemivo.de/news\\\"},{\\\"@type\\\":\\\"ListItem\\\",\\\"position\\\":3,\\\"name\\\":\\\"We found 331 MCP tool-list changes in one week that only moved a date. Each one costs a prompt-cache write\\\",\\\"item\\\":\\\"https://ainews.gemivo.de/news/we-found-331-mcp-tool-list-changes-in-one-week-that-only-cmw03yqv3005\\\"}]}\"}}]],[\"$\",\"nav\",null,{\"className\":\"breadcrumb\",\"aria-label\":\"Brotkrumen\",\"children\":[[\"$\",\"a\",null,{\"href\":\"/news\",\"children\":\"Alle News\"}],[\"$\",\"span\",null,{\"aria-hidden\":true,\"children\":\"/\"}],[\"$\",\"a\",null,{\"href\":\"/news?c=tools\",\"children\":\"Tools \u0026 Apps\"}]]}],[\"$\",\"h1\",null,{\"className\":\"artikel-titel\",\"children\":\"We found 331 MCP tool-list changes in one week that only moved a date. Each one costs a prompt-cache write\"}],[\"$\",\"p\",null,{\"className\":\"artikel-intro\",\"children\":\"A reader of our last post, Paul Irolla, who builds a token optimizer for coding agents, pointed out something we had only looked at as a correctness problem. A model request starts with the tool list. Change one byte of a tool definition and every prompt cache built on that request is gone, even if\"}],[\"$\",\"div\",null,{\"className\":\"meta-zeile\",\"children\":[[\"$\",\"span\",null,{\"className\":\"meta-stueck meta-quelle\",\"children\":\"dev.to\"}],[\"$\",\"span\",null,{\"className\":\"meta-stueck\",\"children\":\"Dienstag 04:00 · 03.11.\"}],false,[\"$\",\"span\",null,{\"className\":\"meta-stueck\",\"children\":[5,\" Min. Lesezeit\"]}],null,[\"$\",\"span\",null,{\"className\":\"meta-stueck\",\"children\":[\"$\",\"$L22\",null,{}]}]]}],[\"$\",\"figure\",null,{\"className\":\"artikel-bild\",\"children\":[[\"$\",\"img\",null,{\"src\":\"https://media2.dev.to/dynamic/image/width=1200,height=627,fit=cover,gravity=auto/https%3A%2F%2Fmodelmarket.dev%2Fblog%2F331-mcp-tool-list-changes-only-moved-a-date%2Fcover.webp\",\"alt\":\"\",\"loading\":\"eager\",\"fetchPriority\":\"high\"}],[\"$\",\"figcaption\",null,{\"className\":\"bild-unterschrift\",\"children\":[\"Bild: \",\"dev.to\"]}]]}],false,[\"$\",\"div\",null,{\"className\":\"artikel-text\",\"children\":[\"$L23\",\"$L24\",\"$L25\",\"$L26\",\"$L27\",\"$L28\",\"$L29\",\"$L2a\",\"$L2b\",\"$L2c\",\"$L2d\",\"$L2e\",\"$L2f\",\"$L30\",\"$L31\",\"$L32\",\"$L33\",\"$L34\",\"$L35\",\"$L36\",\"$L37\"]}],false,\"$L38\"]}],\"$L39\"]}]]\n23:[\"$\",\"p\",\"0\",{\"children\":\"Posted on Nov 3 • Originally published at modelmarket.dev\"}]\n24:[\"$\",\"p\",\"1\",{\"children\":\"A reader of our last post, Paul Irolla, who builds a token optimizer for coding agents, pointed out something we had only looked at as a correctness problem. A model request starts with the tool list. Change one byte of a tool definition and every prompt cache built on that request is gone, even if the change means nothing.\"}]\n25:[\"$\",\"p\",\"2\",{\"children\":\"HISTOR, our public log of MCP tool definitions, records every change it sees, so we counted. In the week of 25 October to 1 November it recorded 10,712 changes to the tool lists of 4,491 MCP servers. 331 of them changed nothing but a date or a timestamp.\"}]\n26:[\"$\",\"p\",\"3\",{\"children\":\"With Anthropic's API, the cached prefix is built in a fixed order: tools first, then the system prompt, then the messages. A change anywhere in the tools invalidates everything after it. Reading a cached prefix costs a tenth of the normal input price. Writing one costs 1.25 times the input price, or twice for the one-hour cache. So the same tool list costs about 12 times more on a miss than on a hit, and so does everything behind it. Other providers discount cached input by different amounts, but the principle is the same: an identical prefix is cheap, a changed one is not.\"}]\n27:[\"$\",\"p\",\"4\",{\"children\":\"Inside one session this mostly doesn't bite. Clients fetch tools/list when they connect and keep it until the server says the list changed. It bites between sessions. If you run many agent sessions with the same servers, the cached prefix carries over from one session to the next until a byte changes. A server that rewrites its definitions twice a day resets that for everyone who uses it.\"}]\n28:[\"$\",\"p\",\"5\",{\"children\":\"For every change in the week, we took both stored tool lists, the one before and the one after, and compared them tool by tool, ignoring more and more at each step:\"}]\n29:[\"$\",\"p\",\"6\",{\"children\":\"The step at which the two lists become equal names the change:\"}]\n2a:[\"$\",\"p\",\"7\",{\"children\":\"HISTOR's digest sorts tools and keys, so a list that only changed order isn't recorded as a change at all, and doesn't appear here. And HISTOR sees at most one change per read, every 30 minutes to 6 hours. A server that rewrites its date every minute shows up as one change per read. The counts are a floor.\"}]\n2b:[\"$\",\"p\",\"8\",{\"children\":\"One server accounts for 237 of the 331. Its whats_new tool describes the latest improvement and the time the server last read its own feed: \\\"Live now (feed read 2026-10-28T08:24:54Z)\\\". Each read of the feed rewrites the tool list. The other 94 date-only changes come from 26 servers, in four patterns.\"}]\n2c:[\"$\",\"p\",\"9\",{\"children\":\"Telling the model what day it is. \\\"Today is 2026-10-28 (UTC) — never infer the date from the…\\\", \\\"Hoy es 2026-10-28\\\", \\\"Current date is 2026-10-28.\\\", \\\"Current server time: 2026-10-25T02:36:38Z (UTC). Use this as your…\\\" The instinct is sound: a model doesn't know the date, and a booking or scheduling tool needs it. But in the description, the date changes the tool list every day.\"}]\n2d:[\"$\",\"p\",\"10\",{\"children\":\"Freshness stamps. \\\"measured 2026-10-28\\\", \\\"indexed on 2026-10-26\\\", \\\"list prices verified 2026-10-27\\\", \\\"as of 2026-10-29\\\", \\\"Rules version 2026-10-28.1\\\". These tell the reader how current the data is. They change whenever the data does, which can be daily.\"}]\n2e:[\"$\",\"p\",\"11\",{\"children\":\"Examples that move with the calendar. A booking server's input schema has an example start time that moves forward a day at a time: 2026-10-29T10:00:00-07:00, then 2026-10-30T10:00:00-07:00. Three servers from one publisher do this.\"}]\n2f:[\"$\",\"p\",\"12\",{\"children\":\"Defaults set at startup. A default for a title like \\\"Conversation 2026-10-26T21:47:21.670Z\\\", or start_date and end_date defaults with the time the server started. These are npm packages, so the date changes on every launch.\"}]\n30:[\"$\",\"p\",\"13\",{\"children\":\"Of the 2,119 fields that differ in these two classes, 1,963 are tool descriptions and 156 are in input schemas: defaults, examples and property descriptions.\"}]\n31:[\"$\",\"p\",\"14\",{\"children\":\"The 134 changes that only moved a decimal number look like the same kind of noise. They aren't. About 126 of them are prices written into the description: \\\"sold per call … at 0.009027 USDC\\\", then 0.008588; \\\"Price $0.01/call\\\", then $0.05; one tool went from \\\"$1.00\\\" to \\\"$222.00\\\". Five are version strings, such as a rules engine going from 1.6.12 to 1.7.1.\"}]\n32:[\"$\",\"p\",\"15\",{\"children\":\"A price change is a real change for an agent that pays per call, so it belongs in the tool list's history. But if the price moves every few hours, the description is a costly place to keep it. Every move resets the cache for every client, including the ones that will never call that tool. A price that floats is better quoted at call time. Paid MCP tools over x402 already get a priced offer in the HTTP 402 answer.\"}]\n33:[\"$\",\"p\",\"16\",{\"children\":\"If you maintain an MCP server and want the model to know the date, or how fresh your data is, there are places that don't touch the tool list:\"}]\n34:[\"$\",\"p\",\"17\",{\"children\":\"None of this changes what the model can know. It only moves the moving parts out of the one block that every request shares.\"}]\n35:[\"$\",\"p\",\"18\",{\"children\":\"If you build a client or a token optimizer, the per-server history is public. HISTOR's changes API, https://histor.modelmarket.dev/api/v1/changes, lists every recorded change with the digests of both sides and a field-by-field diff. A server that changed its definitions seven or more times in a week is a good candidate to fetch once per session and pin. 218 servers did that this week, and between them they made 3,661 changes, a third of the total.\"}]\n36:[\"$\",\"p\",\"19\",{\"children\":\"The week's counts, the script and the examples behind this post are at https://histor.modelmarket.dev/datasets/cache-churn-2026-11-01/.\"}]\n37:[\"$\",\"p\",\"20\",{\"children\":\"Disclosure: we build HISTOR. AI assistance was used for the analysis, the code and the writing. The counts come from HISTOR's production database, read-only, in a throw-away container.\"}]\n38:[\"$\",\"div\",null,{\"className\":\"quellen-box\",\"children\":[false,[\"$\",\"span\",null,{\"children\":[\"Quelle: \",\"dev.to\",\" (\",\"dev.to\",\").\",\" \",[\"$\",\"a\",null,{\"href\":\"https://dev.to/alexar76/we-found-331-mcp-tool-list-changes-in-one-week-that-only-moved-a-date-each-one-costs-a-26p2\",\"target\":\"_blank\",\"rel\":\"noopener noreferrer\",\"className\":\"ml-1 font-bold\",\"style\":{\"color\":\"var(--accent)\"},\"children\":\"Original öffnen\"}]]}]]}]\n39:[\"$\",\"aside\",null,{\"className\":\"lese-sidebar\",\"children\":[[\"$\",\"div\",null,{\"className\":\"seitenkarte\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"seitenkarte-titel\",\"children\":\"Mehr zu dem Thema\"}],[\"$\",\"ul\",null,{\"className\":\"verwandt-liste\",\"children\":[[\"$\",\"li\",\"cmw9mcs9u005nj5m8tzw4kkjm\",{\"children\":[\"$\",\"a\",null,{\"href\":\"/news/professional-work-deserves-professional-tools-meet-aws-quick-cmw9mcs9u005\",\"className\":\"verwandt-zeile\",\"children\":[[\"$\",\"span\",null,{\"className\":\"font-extrabold leading-snug line-clamp-3\",\"children\":\"Professional work deserves professional tools. Meet AWS Quick.\"}],[\"$\",\"span\",null,{\"className\":\"text-[11px]\",\"style\":{\"color\":\"var(--muted)\"},\"children\":[\"AWS ML Blog\",\" · \",\"Montag 19:43 · 09.11.\"]}]]}]}],[\"$\",\"li\",\"cmw9md4sq005pj5m8jjo97vgg\",{\"children\":[\"$\",\"a\",null,{\"href\":\"/news/approval-in-an-ai-workflow-needs-a-versioned-evidence-record-cmw9md4sq005\",\"className\":\"verwandt-zeile\",\"children\":[[\"$\",\"span\",null,{\"className\":\"font-extrabold leading-snug line-clamp-3\",\"children\":\"Approval in an AI workflow needs a versioned evidence record\"}],[\"$\",\"span\",null,{\"className\":\"text-[11px]\",\"style\":{\"color\":\"var(--muted)\"},\"children\":[\"dev.to\",\" · \",\"Montag 19:42 · 09.11.\"]}]]}]}],[\"$\",\"li\",\"cmw9l98sy005dj5m8xdpb4d7j\",{\"children\":[\"$\",\"a\",null,{\"href\":\"/news/instagram-s-effect-builder-makes-new-filters-from-ai-prompts-cmw9l98sy005\",\"className\":\"verwandt-zeile\",\"children\":[[\"$\",\"span\",null,{\"className\":\"font-extrabold leading-snug line-clamp-3\",\"children\":\"Instagram’s Effect Builder makes new filters from AI prompts\"}],[\"$\",\"span\",null,{\"className\":\"text-[11px]\",\"style\":{\"color\":\"var(--muted)\"},\"children\":[\"The Verge\",\" · \",\"Montag 19:07 · 09.11.\"]}]]}]}]]}]]}],[\"$\",\"div\",null,{\"className\":\"seitenkarte\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"seitenkarte-titel\",\"children\":\"KI-News anhören\"}],[\"$\",\"div\",null,{\"className\":\"orb orb-z-bereit orb-klein\",\"aria-hidden\":true,\"children\":[[\"$\",\"div\",null,{\"className\":\"orb-buehne\",\"children\":[[\"$\",\"span\",null,{\"className\":\"orb-glow\"}],[\"$\",\"span\",null,{\"className\":\"orb-ring orb-ring-a\"}],[\"$\",\"span\",null,{\"className\":\"orb-ring orb-ring-b\"}],[\"$\",\"span\",null,{\"className\":\"orb-ring orb-ring-c\"}],[\"$\",\"span\",null,{\"className\":\"orb-kugel\",\"children\":[[\"$\",\"span\",null,{\"className\":\"orb-kern\"}],[\"$\",\"span\",null,{\"className\":\"orb-schein\"}]]}]]}],[\"$\",\"div\",null,{\"className\":\"orb-wellen\",\"children\":[[\"$\",\"svg\",null,{\"className\":\"orb-welle orb-welle-a\",\"viewBox\":\"0 0 400 28\",\"preserveAspectRatio\":\"none\",\"children\":[\"$\",\"path\",null,{\"d\":\"M0 14 Q12.5 2 25 14 T50 14 T75 14 T100 14 T125 14 T150 14 T175 14 T200 14 T225 14 T250 14 T275 14 T300 14 T325 14 T350 14 T375 14 T400 14\"}]}],[\"$\",\"svg\",null,{\"className\":\"orb-welle orb-welle-b\",\"viewBox\":\"0 0 400 28\",\"preserveAspectRatio\":\"none\",\"children\":[\"$\",\"path\",null,{\"d\":\"M0 14 Q12.5 24 25 14 T50 14 T75 14 T100 14 T125 14 T150 14 T175 14 T200 14 T225 14 T250 14 T275 14 T300 14 T325 14 T350 14 T375 14 T400 14\"}]}]]}]]}],[\"$\",\"p\",null,{\"className\":\"text-[13px] leading-snug\",\"style\":{\"color\":\"var(--muted)\"},\"children\":\"Das tägliche Briefing als Sprachaudio, gesprochen im Nachrichtensender-Stil.\"}],[\"$\",\"a\",null,{\"href\":\"/#briefing\",\"className\":\"more-link mt-2 inline-block text-[13px] font-bold\",\"style\":{\"color\":\"var(--accent)\"},\"children\":\"Zum Player\"}]]}]]}]\n"])</script></body></html>
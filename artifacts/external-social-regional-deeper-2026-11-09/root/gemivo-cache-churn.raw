    try{
      if(navigator.onLine===false) return;
      var n=Date.now();
      if(n-(+sessionStorage.ainews_chunkfix_inflight||0)<3000) return;
      sessionStorage.ainews_chunkfix_inflight=n;
      var a=JSON.parse(sessionStorage.ainews_chunkfix||"[]").filter(function(t){return n-t<60000});
      if(a.length>=2) return;
      a.push(n); sessionStorage.ainews_chunkfix=JSON.stringify(a);
      if(window.caches){caches.keys().then(function(ks){ks.forEach(function(k){caches.delete(k)})});}
      if(navigator.serviceWorker){navigator.serviceWorker.getRegistrations().then(function(rs){rs.forEach(function(r){r.update()})});}
      setTimeout(function(){location.reload()},400);
    }catch(e){}
  }
  function istNext(t){
    if(!t||t===window) return false;
    if(t.tagName!=="SCRIPT"&&t.tagName!=="LINK") return false;
    var u=t.src||t.href||"";
    return u.indexOf("/_next/")>-1;
  }
  window.addEventListener("error",function(e){ if(istNext(e.target)) heilen(); },true);
  window.addEventListener("unhandledrejection",function(e){
    if(/chunk|script|module|import|loading/i.test(String(e.reason||""))) heilen();
  });
  if(navigator.serviceWorker){
    navigator.serviceWorker.addEventListener("message",function(e){
      if(e.data&&e.data.type==="chunk-miss") heilen();
    });
  }
  /* Fallback fuer Fehler, die noch VOR diesem Script feuern: Resource-Eintraege
     mit 4xx/5xx nachziehen (responseStatus gibt es nur in Chromium - dort leben
     PWA und TWA). */
  function scan(){
    try{
      var es=performance.getEntriesByType("resource")||[];
      for(var i=0;i<es.length;i++){
        var e=es[i];
        if(e.name.indexOf("/_next/")>-1&&e.responseStatus&&e.responseStatus>=400){ heilen(); return; }
      }
    }catch(err){}
  }
  if(document.readyState==="loading"){
    document.addEventListener("DOMContentLoaded",function(){scan();setTimeout(scan,1500);});
  }else{scan();setTimeout(scan,1500);}
})();</script><script defer="" src="https://stats.gemivo.de/script.js" data-website-id="7923ee3d-a2b0-495a-a076-8d13d77d7254"></script><script type="application/ld+json">{"@context":"https://schema.org","@graph":[{"@type":"Organization","@id":"https://ainews.gemivo.de/#organization","name":"AI News","url":"https://ainews.gemivo.de","logo":{"@type":"ImageObject","url":"https://ainews.gemivo.de/icon-512.png"}},{"@type":"WebSite","@id":"https://ainews.gemivo.de/#website","url":"https://ainews.gemivo.de","name":"AI News","inLanguage":"de-DE","publisher":{"@id":"https://ainews.gemivo.de/#organization"},"potentialAction":{"@type":"SearchAction","target":{"@type":"EntryPoint","urlTemplate":"https://ainews.gemivo.de/news?q={search_term_string}"},"query-input":"required name=search_term_string"}}]}</script><header class="sticky top-0 z-40 px-4" style="background:var(--accent)"><div class="mx-auto flex h-14 w-full max-w-none items-center justify-between gap-6"><a href="/" class="flex h-14 select-none items-center" aria-label="AI News Startseite"><span class="flex items-baseline"><span class="text-[26px] font-black lowercase leading-none tracking-[-0.03em]" style="color:var(--accent-contrast)">ai news</span><span class="ml-2 hidden text-[10px] font-bold uppercase tracking-[0.14em] sm:inline" style="color:var(--accent-contrast);opacity:0.85">Die KI-News</span></span></a><nav class="hidden h-14 flex-1 items-center gap-1 lg:flex" aria-label="Bereiche"><a href="/" class="rounded-[6px] px-3 py-1.5 text-[13.5px] font-bold hover:bg-white/10" style="color:var(--accent-contrast)">Start</a><a href="/news" class="rounded-[6px] px-3 py-1.5 text-[13.5px] font-bold hover:bg-white/10" style="color:var(--accent-contrast)">News</a><a href="/news?c=coding" class="rounded-[6px] px-3 py-1.5 text-[13.5px] font-bold hover:bg-white/10" style="color:var(--accent-contrast)">Coding &amp; Dev-Tools</a><a href="/videos" class="rounded-[6px] px-3 py-1.5 text-[13.5px] font-bold hover:bg-white/10" style="color:var(--accent-contrast)">KI-Videos</a><a href="/modelle" class="rounded-[6px] px-3 py-1.5 text-[13.5px] font-bold hover:bg-white/10" style="color:var(--accent-contrast)">Modelle</a><a href="/tipps" class="rounded-[6px] px-3 py-1.5 text-[13.5px] font-bold hover:bg-white/10" style="color:var(--accent-contrast)">Tipps</a><a href="/#briefing" class="rounded-[6px] px-3 py-1.5 text-[13.5px] font-bold hover:bg-white/10" style="color:var(--accent-contrast)">Anhören</a></nav><span class="text-xs font-semibold" style="color:var(--accent-contrast);opacity:0.9">Mo., 9. Nov.</span></div></header><a href="/news/claude-fable-5-2-benchmarks-price-and-the-first-independent-cmw9nyzia006" class="breaking-banner" aria-label="Eilmeldung: Claude Fable 5.2: benchmarks, price and the first independent test results"><span class="breaking-tag"><span class="breaking-punkt" aria-hidden="true"></span>Eilmeldung</span><span class="breaking-titel line-clamp-1">Claude Fable 5.2: benchmarks, price and the first independent test results</span></a><main class="leselayout"><article class="lesespalte"><script type="application/ld+json">{"@context":"https://schema.org","@type":"NewsArticle","mainEntityOfPage":{"@type":"WebPage","@id":"https://ainews.gemivo.de/news/we-found-331-mcp-tool-list-changes-in-one-week-that-only-cmw03yqv3005"},"headline":"We found 331 MCP tool-list changes in one week that only moved a date. Each one costs a prompt-cache write","description":"A reader of our last post, Paul Irolla, who builds a token optimizer for coding agents, pointed out something we had only looked at as a correctness problem. A model request starts with the tool list. Change one byte of a tool definition and every prompt cache built on that request is gone, even if","inLanguage":"de-DE","datePublished":"2026-11-03T03:00:00.000Z","dateModified":"2026-11-03T03:00:00.000Z","image":["https://media2.dev.to/dynamic/image/width=1200,height=627,fit=cover,gravity=auto/https%3A%2F%2Fmodelmarket.dev%2Fblog%2F331-mcp-tool-list-changes-only-moved-a-date%2Fcover.webp"],"author":[{"@type":"Organization","name":"dev.to"}],"citation":"dev.to","publisher":{"@type":"Organization","name":"AI News","logo":{"@type":"ImageObject","url":"https://ainews.gemivo.de/icon-512.png"}},"isBasedOn":"https://dev.to/alexar76/we-found-331-mcp-tool-list-changes-in-one-week-that-only-moved-a-date-each-one-costs-a-26p2"}</script><script type="application/ld+json">{"@context":"https://schema.org","@type":"BreadcrumbList","itemListElement":[{"@type":"ListItem","position":1,"name":"Start","item":"https://ainews.gemivo.de/"},{"@type":"ListItem","position":2,"name":"News","item":"https://ainews.gemivo.de/news"},{"@type":"ListItem","position":3,"name":"We found 331 MCP tool-list changes in one week that only moved a date. Each one costs a prompt-cache write","item":"https://ainews.gemivo.de/news/we-found-331-mcp-tool-list-changes-in-one-week-that-only-cmw03yqv3005"}]}</script><nav class="breadcrumb" aria-label="Brotkrumen"><a href="/news">Alle News</a><span aria-hidden="true">/</span><a href="/news?c=tools">Tools &amp; Apps</a></nav><h1 class="artikel-titel">We found 331 MCP tool-list changes in one week that only moved a date. Each one costs a prompt-cache write</h1><p class="artikel-intro">A reader of our last post, Paul Irolla, who builds a token optimizer for coding agents, pointed out something we had only looked at as a correctness problem. A model request starts with the tool list. Change one byte of a tool definition and every prompt cache built on that request is gone, even if</p><div class="meta-zeile"><span class="meta-stueck meta-quelle">dev.to</span><span class="meta-stueck">Dienstag 04:00 · 03.11.</span><span class="meta-stueck">5<!-- --> Min. Lesezeit</span><span class="meta-stueck"><button type="button" class="meta-knopf" aria-label="Link zu diesem Artikel kopieren"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true"><path d="M10 13a5 5 0 0 0 7.5.5l3-3a5 5 0 0 0-7-7l-1.7 1.7"></path><path d="M14 11a5 5 0 0 0-7.5-.5l-3 3a5 5 0 0 0 7 7l1.7-1.7"></path></svg>Link kopieren</button></span></div><figure class="artikel-bild"><img src="https://media2.dev.to/dynamic/image/width=1200,height=627,fit=cover,gravity=auto/https%3A%2F%2Fmodelmarket.dev%2Fblog%2F331-mcp-tool-list-changes-only-moved-a-date%2Fcover.webp" alt="" loading="eager" fetchPriority="high"/><figcaption class="bild-unterschrift">Bild: <!-- -->dev.to</figcaption></figure><div class="artikel-text"><p>Posted on Nov 3 • Originally published at modelmarket.dev</p><p>A reader of our last post, Paul Irolla, who builds a token optimizer for coding agents, pointed out something we had only looked at as a correctness problem. A model request starts with the tool list. Change one byte of a tool definition and every prompt cache built on that request is gone, even if the change means nothing.</p><p>HISTOR, our public log of MCP tool definitions, records every change it sees, so we counted. In the week of 25 October to 1 November it recorded 10,712 changes to the tool lists of 4,491 MCP servers. 331 of them changed nothing but a date or a timestamp.</p><p>With Anthropic&#x27;s API, the cached prefix is built in a fixed order: tools first, then the system prompt, then the messages. A change anywhere in the tools invalidates everything after it. Reading a cached prefix costs a tenth of the normal input price. Writing one costs 1.25 times the input price, or twice for the one-hour cache. So the same tool list costs about 12 times more on a miss than on a hit, and so does everything behind it. Other providers discount cached input by different amounts, but the principle is the same: an identical prefix is cheap, a changed one is not.</p><p>Inside one session this mostly doesn&#x27;t bite. Clients fetch tools/list when they connect and keep it until the server says the list changed. It bites between sessions. If you run many agent sessions with the same servers, the cached prefix carries over from one session to the next until a byte changes. A server that rewrites its definitions twice a day resets that for everyone who uses it.</p><p>For every change in the week, we took both stored tool lists, the one before and the one after, and compared them tool by tool, ignoring more and more at each step:</p><p>The step at which the two lists become equal names the change:</p><p>HISTOR&#x27;s digest sorts tools and keys, so a list that only changed order isn&#x27;t recorded as a change at all, and doesn&#x27;t appear here. And HISTOR sees at most one change per read, every 30 minutes to 6 hours. A server that rewrites its date every minute shows up as one change per read. The counts are a floor.</p><p>One server accounts for 237 of the 331. Its whats_new tool describes the latest improvement and the time the server last read its own feed: &quot;Live now (feed read 2026-10-28T08:24:54Z)&quot;. Each read of the feed rewrites the tool list. The other 94 date-only changes come from 26 servers, in four patterns.</p><p>Telling the model what day it is. &quot;Today is 2026-10-28 (UTC) — never infer the date from the…&quot;, &quot;Hoy es 2026-10-28&quot;, &quot;Current date is 2026-10-28.&quot;, &quot;Current server time: 2026-10-25T02:36:38Z (UTC). Use this as your…&quot; The instinct is sound: a model doesn&#x27;t know the date, and a booking or scheduling tool needs it. But in the description, the date changes the tool list every day.</p><p>Freshness stamps. &quot;measured 2026-10-28&quot;, &quot;indexed on 2026-10-26&quot;, &quot;list prices verified 2026-10-27&quot;, &quot;as of 2026-10-29&quot;, &quot;Rules version 2026-10-28.1&quot;. These tell the reader how current the data is. They change whenever the data does, which can be daily.</p><p>Examples that move with the calendar. A booking server&#x27;s input schema has an example start time that moves forward a day at a time: 2026-10-29T10:00:00-07:00, then 2026-10-30T10:00:00-07:00. Three servers from one publisher do this.</p><p>Defaults set at startup. A default for a title like &quot;Conversation 2026-10-26T21:47:21.670Z&quot;, or start_date and end_date defaults with the time the server started. These are npm packages, so the date changes on every launch.</p><p>Of the 2,119 fields that differ in these two classes, 1,963 are tool descriptions and 156 are in input schemas: defaults, examples and property descriptions.</p><p>The 134 changes that only moved a decimal number look like the same kind of noise. They aren&#x27;t. About 126 of them are prices written into the description: &quot;sold per call … at 0.009027 USDC&quot;, then 0.008588; &quot;Price $0.01/call&quot;, then $0.05; one tool went from &quot;$1.00&quot; to &quot;$222.00&quot;. Five are version strings, such as a rules engine going from 1.6.12 to 1.7.1.</p><p>A price change is a real change for an agent that pays per call, so it belongs in the tool list&#x27;s history. But if the price moves every few hours, the description is a costly place to keep it. Every move resets the cache for every client, including the ones that will never call that tool. A price that floats is better quoted at call time. Paid MCP tools over x402 already get a priced offer in the HTTP 402 answer.</p><p>If you maintain an MCP server and want the model to know the date, or how fresh your data is, there are places that don&#x27;t touch the tool list:</p><p>None of this changes what the model can know. It only moves the moving parts out of the one block that every request shares.</p><p>If you build a client or a token optimizer, the per-server history is public. HISTOR&#x27;s changes API, https://histor.modelmarket.dev/api/v1/changes, lists every recorded change with the digests of both sides and a field-by-field diff. A server that changed its definitions seven or more times in a week is a good candidate to fetch once per session and pin. 218 servers did that this week, and between them they made 3,661 changes, a third of the total.</p><p>The week&#x27;s counts, the script and the examples behind this post are at https://histor.modelmarket.dev/datasets/cache-churn-2026-11-01/.</p><p>Disclosure: we build HISTOR. AI assistance was used for the analysis, the code and the writing. The counts come from HISTOR&#x27;s production database, read-only, in a throw-away container.</p></div><div class="quellen-box"><span>Quelle: <!-- -->dev.to<!-- --> (<!-- -->dev.to<!-- -->).<!-- --> <a href="https://dev.to/alexar76/we-found-331-mcp-tool-list-changes-in-one-week-that-only-moved-a-date-each-one-costs-a-26p2" target="_blank" rel="noopener noreferrer" class="ml-1 font-bold" style="color:var(--accent)">Original öffnen</a></span></div></article><aside class="lese-sidebar"><div class="seitenkarte"><h2 class="seitenkarte-titel">Mehr zu dem Thema</h2><ul class="verwandt-liste"><li><a href="/news/professional-work-deserves-professional-tools-meet-aws-quick-cmw9mcs9u005" class="verwandt-zeile"><span class="font-extrabold leading-snug line-clamp-3">Professional work deserves professional tools. Meet AWS Quick.</span><span class="text-[11px]" style="color:var(--muted)">AWS ML Blog<!-- --> · <!-- -->Montag 19:43 · 09.11.</span></a></li><li><a href="/news/approval-in-an-ai-workflow-needs-a-versioned-evidence-record-cmw9md4sq005" class="verwandt-zeile"><span class="font-extrabold leading-snug line-clamp-3">Approval in an AI workflow needs a versioned evidence record</span><span class="text-[11px]" style="color:var(--muted)">dev.to<!-- --> · <!-- -->Montag 19:42 · 09.11.</span></a></li><li><a href="/news/instagram-s-effect-builder-makes-new-filters-from-ai-prompts-cmw9l98sy005" class="verwandt-zeile"><span class="font-extrabold leading-snug line-clamp-3">Instagram’s Effect Builder makes new filters from AI prompts</span><span class="text-[11px]" style="color:var(--muted)">The Verge<!-- --> · <!-- -->Montag 19:07 · 09.11.</span></a></li></ul></div><div class
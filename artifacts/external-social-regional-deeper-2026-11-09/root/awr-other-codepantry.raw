-->policy_pack<!-- -->&quot;:<!-- --> </span><span class="text-(--color-ink)">&quot;HIPAA/PHI, PCI tokenized&quot;</span></div><div class="whitespace-nowrap border-l-2 border-transparent"><span class="text-(--color-ink-muted)">  <!-- -->},</span></div><div class="whitespace-nowrap border-l-2 border-transparent"><span class="text-(--color-ink-muted)">  <!-- -->&quot;task&quot;: {</span></div><div class="whitespace-nowrap border-l-2 border-transparent"><span class="text-(--color-ink-muted)">    <!-- -->&quot;<!-- -->type<!-- -->&quot;:<!-- --> </span><span class="text-(--color-ink)">&quot;appointment_booked_with_deposit&quot;</span><span class="text-(--color-ink-muted)">,</span></div><div class="whitespace-nowrap border-l-2 border-transparent"><span class="text-(--color-ink-muted)">    <!-- -->&quot;<!-- -->status<!-- -->&quot;:<!-- --> </span><span class="text-(--color-ink)">&quot;completed&quot;</span></div><div class="whitespace-nowrap border-l-2 border-transparent"><span class="text-(--color-ink-muted)">  <!-- -->},</span></div><div class="whitespace-nowrap -mx-2 border-l-2 border-(--color-accent) bg-(--color-surface) px-2"><span class="text-(--color-ink-muted)">  <!-- -->&quot;<!-- -->evidence_manifest<!-- -->&quot;:<!-- --> </span><span class="text-(--color-ink)">[&quot;transcript&quot;, &quot;tool_call&quot;, &quot;scheduler_write&quot;, &quot;payment_ref&quot;]</span><span class="text-(--color-ink-muted)">,</span></div><div class="whitespace-nowrap border-l-2 border-transparent"><span class="text-(--color-ink-muted)">  <!-- -->&quot;<!-- -->policy_verdict<!-- -->&quot;:<!-- --> </span><span class="text-(--color-ink)">&quot;allowed_by_policy&quot;</span><span class="text-(--color-ink-muted)">,</span></div><div class="whitespace-nowrap -mx-2 border-l-2 border-(--color-accent) bg-(--color-surface) px-2"><span class="text-(--color-ink-muted)">  <!-- -->&quot;<!-- -->usage_cost_reference<!-- -->&quot;:<!-- --> </span><span class="text-(--color-ink)">&quot;usage_lin
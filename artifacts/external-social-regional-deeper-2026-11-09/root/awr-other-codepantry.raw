class="mt-16"><div data-surface="hero" class="overflow-hidden rounded-(--radius-lg) border border-(--color-line) p-6 sm:p-8"><div class="flex flex-wrap items-center justify-between gap-x-6 gap-y-2"><p class="text-caps text-(--color-ink)">AWR evidence chain</p><span class="flex items-center gap-2 text-sm text-(--color-ink-muted)"><span aria-hidden="true" class="size-2 shrink-0 rounded-full bg-(--color-earned) ring-4 ring-(--color-earned-wash)"></span>Evidence attached</span></div><ul class="mt-6 flex flex-wrap gap-2"><li class="rounded-full border border-(--color-duplicate) px-3.5 py-1.5 text-sm text-(--color-duplicate)">Retry cost</li><li class="rounded-full border border-(--color-duplicate) px-3.5 py-1.5 text-sm text-(--color-duplicate)">Duplicate work</li><li class="rounded-full border border-(--color-duplicate) px-3.5 py-1.5 text-sm text-(--color-duplicate)">Human correction</li><li class="rounded-full border border-(--color-duplicate) px-3.5 py-1.5 text-sm text-(--color-duplicate)">Rejected output</li><li class="rounded-full border border-(--color-duplicate) px-3.5 py-1.5 text-sm text-(--color-duplicate)">Unverified value</li></ul><ol class="mt-6"><li><div class="flex items-start gap-4 rounded-(--radius-md) border px-5 py-4 border-(--color-line) bg-(--color-surface)"><span aria-hidden="true" data-numeric="true" class="mt-0.5 grid size-7 shrink-0 place-items-center rounded-(--radius-sm) text-xs bg-(--color-ink-muted) text-(--color-canvas)">01</span><span class="min-w-0"><span class="text-caps block text-(--color-ink)">AI cost</span><span class="mt-1.5 block text-sm leading-(--leading-relaxed) text-(--color-ink-muted)">Provider usage + infrastructure + licensing + retries + human review</span></span></div><span aria-hidden="true" class="mx-auto block h-3 w-px bg-(--color-line-strong) sm:ml-[2.4rem]"></span></li><li><div class="flex items-start gap-4 rounded-(--radius-md) border px-5 py-4 border-(--color-line) bg-(--color-surface)"><span aria-hidden="true" data-numeric="true" class="mt-0.5 grid size-7 shrink-0 place-items-center rounded-(--radius-sm) text-xs bg-(--color-ink-muted) text-(--color-canvas)">02</span><span class="min-w-0"><span class="text-caps block text-(--color-ink)">Work receipt</span><span class="mt-1.5 block text-sm leading-(--leading-relaxed) text-(--color-ink-muted)">Agent + task + authorization + evidence + completion state</span></span></div><span aria-hidden="true" class="mx-auto block h-3 w-px bg-(--color-line-strong) sm:ml-[2.4rem]"></span></li><li><div class="flex items-start gap-4 rounded-(--radius-md) border px-5 py-4 border-(--color-earned) bg-(--color-earned-wash)"><span aria-hidden="true" data-numeric="true" class="mt-0.5 grid size-7 shrink-0 place-items-center rounded-(--radius-sm) text-xs bg-(--color-earned) text-(--color-canvas)">03</span><span class="min-w-0"><span class="text-caps block text-(--color-ink)">Accepted outcome</span><span class="mt-1.5 block text-sm leading-(--leading-relaxed) text-(--color-ink-muted)">Verified + used + policy-compliant + not reversed</span></span></div><span aria-hidden="true" class="mx-auto block h-3 w-px bg-(--color-line-strong) sm:ml-[2.4rem]"></span></li><li><div class="flex items-start gap-4 rounded-(--radius-md) border px-5 py-4 border-(--color-line) bg-(--color-surface)"><span aria-hidden="true" data-numeric="true" class="mt-0.5 grid size-7 shrink-0 place-items-center rounded-(--radius-sm) text-xs bg-(--color-ink-muted) text-(--color-canvas)">04</span><span class="min-w-0"><span class="text-caps block text-(--color-ink)">Value statement</span><span class="mt-1.5 block text-sm leading-(--leading-relaxed) text-(--color-ink-muted)">Cost per outcome + net verified value + ROI confidence</span></span></div></li></ol><div data-surface="tint" class="mt-6 rounded-(--radius-md) p-5 sm:p-6"><div class="flex flex-wrap items-center justify-between gap-x-6 gap-y-2"><p class="text-lg font-normal tracking-(--tracking-tight)">AWR Work Economics Statement</p><p class="flex shrink-0 items-center gap-2 text-(--color-earned)"><span aria-hidden="true" class="size-2 shrink-0 rounded-full bg-(--color-earned) ring-4 ring-(--color-earned-wash)"></span><span class="text-caps">Accepted work verified</span></p></div><dl class="mt-5 grid gap-3 sm:grid-cols-3"><div class="rounded-(--radius-sm) border border-(--color-line) bg-(--color-surface) px-4 py-3.5"><dt class="text-xs leading-(--leading-relaxed) text-(--color-ink-muted)">Cost / accepted outcome</dt><dd data-numeric="true" class="mt-1.5 text-2xl leading-none text-(--color-ink)">$3.82</dd></div><div class="rounded-(--radius-sm) border border-(--color-line) bg-(--color-surface) px-4 py-3.5"><dt class="text-xs leading-(--leading-relaxed) text-(--color-ink-muted)">Net verified value</dt><dd data-numeric="true" class="mt-1.5 text-2xl leading-none text-(--color-ink)">$42.6K</dd></div><div class="rounded-(--radius-sm) border border-(--color-line) bg-(--color-surface) px-4 py-3.5"><dt class="text-xs leading-(--leading-relaxed) text-(--color-ink-muted)">Evidence coverage</dt><dd data-numeric="true" class="mt-1.5 text-2xl leading-none text-(--color-ink)">94%</dd></div></dl></div><p class="mt-5 text-sm font-medium text-(--color-ink-muted)">Every figure traces to an accepted outcome and the evidence behind it.</p></div></div><div class="mt-16 flex flex-col items-stretch gap-3 sm:flex-row sm:items-center"><a href="/economics" class="relative inline-flex select-none items-center justify-center gap-2 whitespace-nowrap rounded-(--radius-md) font-medium tracking-(--tracking-normal) transition-[background-color,border-color,color,box-shadow,transform] duration-(--duration-fast) ease-(--ease-out-quint) active:translate-y-px focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-(--color-accent) bg-(--color-accent) text-(--color-accent-ink) shadow-[0_1px_2px_var(--shadow-tint-strong),0_6px_16px_-6px_var(--shadow-tint)] inset-ring-1 inset-ring-white/15 hover:bg-(--color-accent-bright) hover:shadow-[0_1px_2px_var(--shadow-tint-strong),0_10px_24px_-8px_var(--shadow-tint)] active:shadow-[0_1px_1px_var(--shadow-tint-strong)] h-12 px-6 text-base pr-4 group max-sm:w-full max-sm:whitespace-normal">Explore AI economics<svg aria-hidden="true" viewBox="0 0 12 12" class="size-3 translate-x-0 transition-transform duration-(--duration-fast) group-hover:translate-x-0.5"><path d="M4.5 2.5L8 6l-3.5 3.5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"></path></svg></a><a href="/economics/calculator" class="relative inline-flex select-none items-center justify-center gap-2 whitespace-nowrap rounded-(--radius-md) font-medium tracking-(--tracking-normal) transition-[background-color,border-color,color,box-shadow,transform] duration-(--duration-fast) ease-(--ease-out-quint) active:translate-y-px focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-(--color-accent) border border-(--color-line-strong) bg-(--color-surface) text-(--color-ink) shadow-[0_1px_2px_var(--shadow-contact)] hover:border-(--color-ink-faint) hover:bg-(--color-raised) active:shadow-none h-12 px-6 text-base  max-sm:w-full max-sm:whitespace-normal">Run your own work economics</a></div></div></section><section id="pillars" class="relative w-full scroll-mt-(--height-nav)"><span aria-hidden="true" style="top:calc(var(--size-grid-dot-gap) / 2);bottom:calc(var(--size-grid-dot-gap) / 2)" class="pointer-events-none absolute z-10 w-px bg-(--color-grid) left-0"></span><span aria-hidden="true" style="top:calc(var(--size-grid-dot-gap) / 2);bottom:calc(var(--size-grid-dot-gap) / 2)" class="pointer-events-none absolute z-10 w-px bg-(--color-grid) right-0"></span><span aria-hidden="true" style="left:calc(50% - 50cqi);width:max(0px, calc((100cqi - 100%) / 2 - var(--size-grid-dot-gap) / 2))" class="pointer-events-none absolute z-10 h-px bg-(--color-grid-page) top-0"></span><span aria-hidden="true" style="right:calc(50% - 50cqi);width:max(0px, calc((100cqi - 100%) / 2 - var(--size-grid-dot-gap) / 2))" class="pointer-events-none absolute z-10 h-px bg-(--color-grid-page) top-0"></span><span aria-hidden="true" style="left:calc(var(--size-grid-dot-gap) / 2);right:calc(var(--size-grid-dot-gap) / 2)" class="pointer-events-none absolute z-10 h-px bg-(--color-grid) top-0"></span><span aria-hidden="true" data-grid-dot="top" style="width:var(--size-grid-dot);height:var(--size-grid-dot)" class="pointer-events-none absolute z-10 top-0 left-0 -translate-x-1/2 -translate-y-1/2 rounded-full bg-(--color-grid-dot)"></span><span aria-hidden="true" data-grid-dot="top" style="width:var(--size-grid-dot);height:var(--size-grid-dot)" class="pointer-events-none absolute z-10 top-0 right-0 translate-x-1/2 -translate-y-1/2 rounded-full bg-(--color-grid-dot)"></span><div class="w-full px-6 md:px-10 py-12 md:py-14 "><div class="grid gap-10 xl:grid-cols-[minmax(0,0.88fr)_minmax(0,1.45fr)] xl:gap-14"><header><p class="text-caps mb-6 flex items-center gap-2.5 text-(--color-accent) "><span aria-hidden="true" class="inline-block h-px w-7 bg-(--color-line-accent)"></span>What AWR proves</p><h2 class="max-w-(--width-prose) text-3xl text-balance sm:text-4xl">The proof is already attached to the work.</h2><p class="mt-5 max-w-[46ch] text-base leading-(--leading-relaxed) text-(--color-ink-muted)">Every agent event carries the facts needed to approve the outcome, challenge the charge, or defend both without reconstructing what happened.</p><p class="sr-only">Supported review outcomes: Accept, Dispute, Audit, Bill.</p><p aria-hidden="true" class="mt-6 text-xs tracking-[0.06em] uppercase"><span>Accept</span><span><span aria-hidden="true" class="mx-2.5 text-(--color-ink-faint)">/</span>Dispute</span><span><span aria-hidden="true" class="mx-2.5 text-(--color-ink-faint)">/</span>Audit</span><span><span aria-hidden="true" class="mx-2.5 text-(--color-ink-faint)">/</span>Bill</span></p></header><div class="grid self-start border-y border-(--color-line) sm:grid-cols-3"><section aria-label="Work" class="min-w-0 px-6 max-sm:px-0 "><h3 class="text-caps flex min-h-12 items-center gap-2 border-b border-(--color-line) text-(--color-accent)"><span aria-hidden="true" class="h-0.75 w-4.5 shrink-0 bg-(--color-accent)"></span>Work</h3><ol><li class="grid grid-cols-[2rem_minmax(0,1fr)] gap-x-3 pt-4.5 pb-4 "><span data-numeric="true" class="pt-0.5 text-xs font-bold text-(--color-accent)">01</span><div class="min-w-0"><h4 class="text-sm leading-[1.35] font-bold">Action performed</h4><p class="mt-1 text-xs leading-[1.45] text-(--color-ink-muted)">What the agent actually did.</p></div></li><li class="grid grid-cols-[2rem_minmax(0,1fr)] gap-x-3 pt-4.5 pb-4 border-t border-(--color-line)"><span data-numeric="true" class="pt-0.5 text-xs font-bold text-(--color-accent)">02</span><div class="min-w-0"><h4 class="text-sm leading-[1.35] font-bold">Completion state</h4><p class="mt-1 text-xs leading-[1.45] text-(--color-ink-muted)">Whether it finished, failed, or stopped.</p></div></li><li class="grid grid-cols-[2rem_minmax(0,1fr)] gap-x-3 pt-4.5 pb-4 border-t border-(--color-line)"><span data-numeric="true" class="pt-0.5 text-xs font-bold text-(--color-accent)">03</span><div class="min-w-0"><h4 class="text-sm leading-[1.35] font-bold">Supporting evidence</h4><p class="mt-1 text-xs leading-[1.45] text-(--color-ink-muted)">What proves the work happened.</p></div></li></ol></section><section aria-label="Control" class="min-w-0 px-6 max-sm:px-0 max-sm:border-t max-sm:border-(--color-line) sm:border-l sm:border-(--color-line)"><h3 class="text-caps flex min-h-12 items-center gap-2 border-b border-(--color-line) text-(--color-accent)"><span aria-hidden="true" class="h-0.75 w-4.5 shrink-0 bg-(--color-accent)"></span>Control</h3><ol><li class="grid grid-cols-[2rem_minmax(0,1fr)] gap-x-3 pt-4.5 pb-4 "><span data-numeric="true" class="pt-0.5 text-xs font-bold text-(--color-accent)">04</span><div class="min-w-0"><h4 class="text-sm leading-[1.35] font-bold">Policy decision</h4><p class="mt-1 text-xs leading-[1.45] text-(--color-ink-muted)">Which rules were checked and passed.</p></div></li><li class="grid grid-cols-[2rem_minmax(0,1fr)] gap-x-3 pt-4.5 pb-4 border-t border-(--color-line)"><span data-numeric="true" class="pt-0.5 text-xs font-bold text-(--color-accent)">05</span><div class="min-w-0"><h4 class="text-sm leading-[1.35] font-bold">Data handling</h4><p class="mt-1 text-xs leading-[1.45] text-(--color-ink-muted)">How sensitive data was classified and handled.</p></div></li><li class="grid grid-cols-[2rem_minmax(0,1fr)] gap-x-3 pt-4.5 pb-4 border-t border-(--color-line)"><span data-numeric="true" class="pt-0.5 text-xs font-bold text-(--color-accent)">06</span><div class="min-w-0"><h4 class="text-sm leading-[1.35] font-bold">Defensibility</h4><p class="mt-1 text-xs leading-[1.45] text-(--color-ink-muted)">Why the result can withstand review.</p></div></li></ol></section><section aria-label="Commercial record" class="min-w-0 px-6 max-sm:px-0 max-sm:border-t max-sm:border-(--color-line) sm:border-l sm:border-(--color-line)"><h3 class="text-caps flex min-h-12 items-center gap-2 border-b border-(--color-line) text-(--color-accent)"><span aria-hidden="true" class="h-0.75 w-4.5 shrink-0 bg-(--color-accent)"></span>Commercial record</h3><ol><li class="grid grid-cols-[2rem_minmax(0,1fr)] gap-x-3 pt-4.5 pb-4 "><span data-numeric="true" class="pt-0.5 text-xs font-bold text-(--color-accent)">07</span><div class="min-w-0"><h4 class="text-sm leading-[1.35] font-bold">Billability</h4><p class="mt-1 text-xs leading-[1.45] text-(--color-ink-muted)">Whether the work qualifies to be charged.</p></div></li><li class="grid grid-cols-[2rem_minmax(0,1fr)] gap-x-3 pt-4.5 pb-4 border-t border-(--color-line)"><span data-numeric="true" class="pt-0.5 text-xs font-bold text-(--color-accent)">08</span><div class="min-w-0"><h4 class="text-sm leading-[1.35] font-bold">Retention</h4><p class="mt-1 text-xs leading-[1.45] text-(--color-ink-muted)">How long the evidence must be preserved.</p></div></li><li class="grid grid-cols-[2rem_minmax(0,1fr)] gap-x-3 pt-4.5 pb-4 border-t border-(--color-line)"><span data-numeric="true" class="pt-0.5 text-xs font-bold text-(--color-accent)">09</span><div class="min-w-0"><h4 class="text-sm leading-[1.35] font-bold">Access history</h4><p class="mt-1 text-xs leading-[1.45] text-(--color-ink-muted)">Who viewed, retrieved, or used the record.</p></div></li></ol></section></div></div><div data-surface="hero" class="mt-12 -mx-6 -mb-12 grid gap-3 bg-(--color-canvas) px-6 py-5 md:-mx-10 md:-mb-14 md:px-10 lg:grid-cols-[minmax(0,1fr)_auto] lg:items-center lg:gap-7"><div><p class="text-sm leading-(--leading-relaxed)">When the work or charge is challenged, the proof is already there.</p><p class="mt-1 text-xs leading-(--leading-relaxed) text-(--color-ink-muted)">No log reconstruction. No billing guesswork. No unsupported outcome.</p></div><p class="text-caps flex items-center gap-2 text-(--color-ink)"><span aria-hidden="true" class="size-2 rounded-full bg-(--color-earned) ring-4 ring-(--color-earned-wash)"></span>Evidence-backed by design</p></div></div></section><section id="different" class="relative w-full scroll-mt-(--height-nav)"><span aria-hidden="true" style="top:calc(var(--size-grid-dot-gap) / 2);bottom:calc(var(--size-grid-dot-gap) / 2)" class="pointer-events-none absolute z-10 w-px bg-(--color-grid) left-0"></span><span aria-hidden="true" style="top:calc(var(--size-grid-dot-gap) / 2);bottom:calc(var(--size-grid-dot-gap) / 2)" class="pointer-events-none absolute z-10 w-px bg-(--color-grid) right-0"></span><span aria-hidden="true" style="left:calc(50% - 50cqi);width:max(0px, calc((100cqi - 100%) / 2 - var(--size-grid-dot-gap) / 2))" class="pointer-events-none absolute z-10 h-px bg-(--color-grid-page) top-0"></span><span aria-hidden="true" style="right:calc(50% - 50cqi);width:max(0px, calc((100cqi - 100%) / 2 - var(--size-grid-dot-gap) / 2))" class="pointer-events-none absolute z-10 h-px bg-(--color-grid-page) top-0"></span><span aria-hidden="true" style="left:calc(var(--size-grid-dot-gap) / 2);right:calc(var(--size-grid-dot-gap) / 2)" class="pointer-events-none absolute z-10 h-px bg-(--color-grid) top-0"></span><span aria-hidden="true" data-grid-dot="top" style="width:var(--size-grid-dot);height:var(--size-grid-dot)" class="pointer-events-none absolute z-10 top-0 left-0 -translate-x-1/2 -translate-y-1/2 rounded-full bg-(--color-grid-dot)"></span><span aria-hidden="true" data-grid-dot="top" style="width:var(--size-grid-dot);height:var(--size-grid-dot)" class="pointer-events-none absolute z-10 top-0 right-0 translate-x-1/2 -translate-y-1/2 rounded-full bg-(--color-grid-dot)"></span><div class="w-full px-6 md:px-10 py-12 md:py-14 "><p class="text-caps mb-6 flex items-center gap-2.5 text-(--color-accent) "><span aria-hidden="true" class="inline-block h-px w-7 bg-(--color-line-accent)"></span>Why this is different</p><h2 class="max-w-(--width-prose) text-3xl text-balance sm:text-4xl">Most systems see around the work.<!-- --> <span class="text-(--color-accent)">AWR proves the work.</span></h2><p class="mt-6 max-w-[68ch] text-lg leading-(--leading-relaxed) text-(--color-ink-muted)">Logs, meters, guardrails, GRC systems, and archives each capture one part of an agent event. AWR binds the action, authority, evidence, policy result, and outcome into one verifiable runtime record.</p><div class="relative mt-14 -mx-6 grid border-t border-(--color-line) md:-mx-10 lg:grid-cols-[minmax(0,1.16fr)_minmax(0,0.84fr)]"><div class="flex flex-col bg-(--color-surface) px-6 py-9 md:px-10 lg:pr-14"><div class="text-caps flex items-center justify-between gap-4 border-b border-(--color-line) pb-4 text-(--color-ink-subtle)"><span>What the existing stack can tell you</span><span class="max-sm:hidden">Fragmented signals</span></div><div class="grid flex-1 auto-rows-fr sm:grid-cols-2"><article class="border-b border-(--color-line) py-5 pr-4 "><h3 class="text-sm leading-(--leading-snug)">Logs</h3><p class="mt-1.5 text-sm leading-(--leading-relaxed) text-(--color-ink-muted)">Activity occurred.</p></article><article class="border-b border-(--color-line) py-5 pr-4 sm:border-l sm:border-(--color-line) sm:pl-7"><h3 class="text-sm leading-(--leading-snug)">Observability</h3><p class="mt-1.5 text-sm leading-(--leading-relaxed) text-(--color-ink-muted)">Something failed.</p></article><article class="border-b border-(--color-line) py-5 pr-4 "><h3 class="text-sm leading-(--leading-snug)">Billing meters</h3><p class="mt-1.5 text-sm leading-(--leading-relaxed) text-(--color-ink-muted)">Usage was consumed.</p></article><article class="border-b border-(--color-line) py-5 pr-4 sm:border-l sm:border-(--color-line) sm:pl-7"><h3 class="text-sm leading-(--leading-snug)">GRC tools</h3><p class="mt-1.5 text-sm leading-(--leading-relaxed) text-(--color-ink-muted)">Controls are documented.</p></article><article class="border-b border-(--color-line) py-5 pr-4 "><h3 class="text-sm leading-(--leading-snug)">Archives</h3><p class="mt-1.5 text-sm leading-(--leading-relaxed) text-(--color-ink-muted)">Records were retained.</p></article><article class="border-b border-(--color-line) py-5 pr-4 sm:border-l sm:border-(--color-line) sm:pl-7"><h3 class="text-sm leading-(--leading-snug)">Guardrails</h3><p class="mt-1.5 text-sm leading-(--leading-relaxed) text-(--color-ink-muted)">An output was blocked.</p></article></div></div><div data-surface="hero" class="bg-(--color-canvas) px-6 py-9 md:px-10 lg:pl-14"><div class="text-caps flex items-center justify-between gap-4 border-b border-(--color-line) pb-4 text-(--color-ink-subtle)"><span>What AWR can prove</span><span class="max-sm:hidden">Unified runtime record</span></div><ol><li class="grid grid-cols-[2rem_minmax(0,1fr)] items-start gap-x-3 border-b border-(--color-line) py-4.5"><span data-numeric="true" class="pt-0.5 text-xs text-(--color-accent)">01</span><p class="text-sm leading-(--leading-relaxed)">The work was performed.</p></li><li class="grid grid-cols-[2rem_minmax(0,1fr)] items-start gap-x-3 border-b border-(--color-line) py-4.5"><span data-numeric="true" class="pt-0.5 text-xs text-(--color-accent)">02</span><p class="text-sm leading-(--leading-relaxed)">The agent was authorized.</p></li><li class="grid grid-cols-[2rem_minmax(0,1fr)] items-start gap-x-3 border-b border-(--color-line) py-4.5"><span data-numeric="true" class="pt-0.5 text-xs text-(--color-accent)">03</span><p class="text-sm leading-(--leading-relaxed)">The required evidence exists.</p></li><li class="grid grid-cols-[2rem_minmax(0,1fr)] items-start gap-x-3 border-b border-(--color-line) py-4.5"><span data-numeric="true" class="pt-0.5 text-xs text-(--color-accent)">04</span><p class="text-sm leading-(--leading-relaxed)">The applicable policy was evaluated.</p></li><li class="grid grid-cols-[2rem_minmax(0,1fr)] items-start gap-x-3 border-b border-(--color-line) py-4.5"><span data-numeric="true" class="pt-0.5 text-xs text-(--color-accent)">05</span><p class="text-sm leading-(--leading-relaxed)">The outcome can be defended.</p></li><li class="grid grid-cols-[2rem_minmax(0,1fr)] items-start gap-x-3 border-b border-(--color-line) py-4.5"><span data-numeric="true" class="pt-0.5 text-xs text-(--color-accent)">06</span><p class="text-sm leading-(--leading-relaxed)">The event can be audited, disputed, retained, or billed.</p></li></ol></div><span aria-hidden="true" class="absolute top-1/2 left-[58%] hidden size-14 -translate-x-1/2 -translate-y-1/2 place-items-center bg-(--color-canvas) text-2xl text-(--color-ink) shadow-[0_10px_30px_var(--shadow-contact)] lg:grid">≠</span></div><div class="-mx-6 -mb-12 grid border-t border-(--color-line) md:-mx-10 md:-mb-14 lg:grid-cols-[minmax(0,1.16fr)_minmax(0,0.84fr)]"><div class="flex items-center bg-(--color-surface) px-6 py-6 md:px-10 lg:pr-14"><p class="text-sm leading-(--leading-relaxed) font-medium text-(--color-ink)">Posture proves controls exist. AWR proves what the agent actually did.</p></div><div data-surface="hero" class="flex items-center bg-(--color-canvas) px-6 py-6 md:px-10 lg:pl-14"><p class="max-w-[50ch] text-sm leading-(--leading-relaxed) text-(--color-ink-muted)">Runtime proof captured while the work is happening, not reconstructed later at invoice time or audit time.</p></div></div></div></section><section id="faq" class="relative w-full scroll-mt-(--height-nav)"><span aria-hidden="true" style="top:calc(var(--size-grid-dot-gap) / 2);bottom:calc(var(--size-grid-dot-gap) / 2)" class="pointer-events-none absolute z-10 w-px bg-(--color-grid) left-0"></span><span aria-hidden="true" style="top:calc(var(--size-grid-dot-gap) / 2);bottom:calc(var(--size-grid-dot-gap) / 2)" class="pointer-events-none absolute z-10 w-px bg-(--color-grid) right-0"></span><span aria-hidden="true" style="left:calc(50% - 50cqi);width:max(0px, calc((100cqi - 100%) / 2 - var(--size-grid-dot-gap) / 2))" class="pointer-events-none absolute z-10 h-px bg-(--color-grid-page) top-0"></span><span aria-hidden="true" style="right:calc(50% - 50cqi);width:max(0px, calc((100cqi - 100%) / 2 - var(--size-grid-dot-gap) / 2))" class="pointer-events-none absolute z-10 h-px bg-(--color-grid-page) top-0"></span><span aria-hidden="true" style="left:calc(var(--size-grid-dot-gap) / 2);right:calc(var(--size-grid-dot-gap) / 2)" class="pointer-events-none absolute z-10 h-px bg-(--color-grid) top-0"></span><span aria-hidden="true" data-grid-dot="top" style="width:var(--size-grid-dot);height:var(--size-grid-dot)" class="pointer-events-none absolute z-10 top-0 left-0 -translate-x-1/2 -translate-y-1/2 rounded-full bg-(--color-grid-dot)"></span><span aria-hidden="true" data-grid-dot="top" style="width:var(--size-grid-dot);height:var(--size-grid-dot)" class="pointer-events-none absolute z-10 top-0 right-0 translate-x-1/2 -translate-y-1/2 rounded-full bg-(--color-grid-dot)"></span><div class="w-full px-6 md:px-10 py-24 md:py-32 "><p class="text-caps mb-6 flex items-center gap-2.5 text-(--color-accent) "><span aria-hidden="true" class="inline-block h-px w-7 bg-(--color-line-accent)"></span>Questions</p><h2 class="max-w-(--width-prose) text-3xl sm:text-4xl">Agent Work Receipt FAQ</h2><div class="mt-14 max-w-[85ch]"><details class="group rule-hairline-below"><summary class="flex cursor-pointer list-none items-center justify-between gap-6 py-4 text-base [&amp;::-webkit-details-marker]:hidden">What is Agent Work Receipt?<svg aria-hidden="true" viewBox="0 0 12 12" class="size-3 shrink-0 text-(--color-ink-subtle) transition-transform duration-(--duration-base) group-open:rotate-180"><path d="M2.5 4.5L6 8l3.5-3.5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"></path></svg></summary><p class="pb-5 text-sm leading-(--leading-relaxed) text-(--color-ink-muted)">Agent Work Receipt, or AWR, is runtime trust infrastructure for AI-agent work. AWR creates evidence-backed records showing what an AI agent did, which systems and policies governed the work, what evidence supports the result, and whether any resulting charge has billing integrity.</p></details><details class="group rule-hairline-below"><summary class="flex cursor-pointer list-none items-center justify-between gap-6 py-4 text-base [&amp;::-webkit-details-marker]:hidden">What is an agent work receipt?<svg aria-hidden="true" viewBox="0 0 12 12" class="size-3 shrink-0 text-(--color-ink-subtle) transition-transform duration-(--duration-base) group-open:rotate-180"><path d="M2.5 4.5L6 8l3.5-3.5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"></path></svg></summary><p class="pb-5 text-sm leading-(--leading-relaxed) text-(--color-ink-muted)">An agent work receipt is a verifiable record of a specific unit of work performed by an AI agent. It can include the agent identity, work requested, actions taken, tools used, policy checks, evidence references, timestamps, costs, outcomes, and cryptographic verification data. The receipt is the artifact; AWR is the platform that issues it.</p></details><details class="group rule-hairline-below"><summary class="flex cursor-pointer list-none items-center justify-between gap-6 py-4 text-base [&amp;::-webkit-details-marker]:hidden">Why do AI agents need receipts?<svg aria-hidden="true" viewBox="0 0 12 12" class="size-3 shrink-0 text-(--color-ink-subtle) transition-transform duration-(--duration-base) group-open:rotate-180"><path d="M2.5 4.5L6 8l3.5-3.5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"></path></svg></summary><p class="pb-5 text-sm leading-(--leading-relaxed) text-(--color-ink-muted)">Logs and traces show technical activity, but businesses also need to know whether useful work occurred, whether the work followed policy, whether the outcome can be supported by evidence, and whether the associated charge is justified. AWR turns technical execution into an accountable business record.</p></details><details class="group rule-hairline-below"><summary class="flex cursor-pointer list-none items-center justify-between gap-6 py-4 text-base [&amp;::-webkit-details-marker]:hidden">Is AWR an AI observability platform?<svg aria-hidden="true" viewBox="0 0 12 12" class="size-3 shrink-0 text-(--color-ink-subtle) transition-transform duration-(--duration-base) group-open:rotate-180"><path d="M2.5 4.5L6 8l3.5-3.5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"></path></svg></summary><p class="pb-5 text-sm leading-(--leading-relaxed) text-(--color-ink-muted)">AWR is not merely an observability platform. Observability products primarily explain system behaviour through logs, traces, metrics and evaluations. AWR uses execution evidence to establish accountable work, policy conformance, chain of custody, outcome attribution and billing integrity. AWR complements logs, traces, evaluations and billing systems rather than replacing them.</p></details><details class="group rule-hairline-below"><summary class="flex cursor-pointer list-none items-center justify-between gap-6 py-4 text-base [&amp;::-webkit-details-marker]:hidden">What is billing integrity for AI-agent work?<svg aria-hidden="true" viewBox="0 0 12 12" class="size-3 shrink-0 text-(--color-ink-subtle) transition-transform duration-(--duration-base) group-open:rotate-180"><path d="M2.5 4.5L6 8l3.5-3.5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"></path></svg></summary><p class="pb-5 text-sm leading-(--leading-relaxed) text-(--color-ink-muted)">Billing integrity means that a charge can be traced to actual agent work, authorised usage, relevant evidence, agreed pricing rules, and a measurable outcome or service obligation. AWR helps identify unsupported, duplicated, failed or incorrectly attributed charges.</p></details><details class="group rule-hairline-below"><summary class="flex cursor-pointer list-none items-center justify-between gap-6 py-4 text-base [&amp;::-webkit-details-marker]:hidden">Is AWR tied to a specific LLM or agent platform?<svg aria-hidden="true" viewBox="0 0 12 12" class="size-3 shrink-0 text-(--color-ink-subtle) transition-transform duration-(--duration-base) group-open:rotate-180"><path d="M2.5 4.5L6 8l3.5-3.5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"></path></svg></summary><p class="pb-5 text-sm leading-(--leading-relaxed) text-(--color-ink-muted)">No. AWR is designed to be model-agnostic and vendor-agnostic. It can record work produced by proprietary models, open-weight models, voice-agent platforms, workflow systems, custom agents or mixed-provider architectures.</p></details></div><script type="application/ld+json">{"@context":"https://schema.org","@type":"FAQPage","mainEntity":[{"@type":"Question","name":"What is Agent Work Receipt?","acceptedAnswer":{"@type":"Answer","text":"Agent Work Receipt, or AWR, is runtime trust infrastructure for AI-agent work. AWR creates evidence-backed records showing what an AI agent did, which systems and policies governed the work, what evidence supports the result, and whether any resulting charge has billing integrity."}},{"@type":"Question","name":"What is an agent work receipt?","acceptedAnswer":{"@type":"Answer","text":"An agent work receipt is a verifiable record of a specific unit of work performed by an AI agent. It can include the agent identity, work requested, actions taken, tools used, policy checks, evidence references, timestamps, costs, outcomes, and cryptographic verification data. The receipt is the artifact; AWR is the platform that issues it."}},{"@type":"Question","name":"Why do AI agents need receipts?","acceptedAnswer":{"@type":"Answer","text":"Logs and traces show technical activity, but businesses also need to know whether useful work occurred, whether the work followed policy, whether the outcome can be supported by evidence, and whether the associated charge is justified. AWR turns technical execution into an accountable business record."}},{"@type":"Question","name":"Is AWR an AI observability platform?","acceptedAnswer":{"@type":"Answer","text":"AWR is not merely an observability platform. Observability products primarily explain system behaviour through logs, traces, metrics and evaluations. AWR uses execution evidence to establish accountable work, policy conformance, chain of custody, outcome attribution and billing integrity. AWR complements logs, traces, evaluations and billing systems rather than replacing them."}},{"@type":"Question","name":"What is billing integrity for AI-agent work?","acceptedAnswer":{"@type":"Answer","text":"Billing integrity means that a charge can be traced to actual agent work, authorised usage, relevant evidence, agreed pricing rules, and a measurable outcome or service obligation. AWR helps identify unsupported, duplicated, failed or incorrectly attributed charges."}},{"@type":"Question","name":"Is AWR tied to a specific LLM or agent platform?","acceptedAnswer":{"@type":"Answer","text":"No. AWR is designed to be model-agnostic and vendor-agnostic. It can record work produced by proprietary models, open-weight models, voice-agent platforms, workflow systems, custom agents or mixed-provider architectures."}}]}</script><p class="mt-6"><a href="/faq" class="group inline-flex items-center gap-2 text-base font-medium text-(--color-accent) underline-offset-4 hover:underline">More FAQs<span aria-hidden="true" class="hub-cue inline-flex"><svg aria-hidden="true" viewBox="0 0 12 12" class="size-3 translate-x-0 transition-transform duration-(--duration-fast) group-hover:translate-x-0.5"><path d="M4.5 2.5L8 6l-3.5 3.5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"></path></svg></span></a></p></div></section><section id="cta" data-surface="hero" class="relative w-full scroll-mt-(--height-nav)"><span aria-hidden="true" style="top:calc(var(--size-grid-dot-gap) / 2);bottom:calc(var(--size-grid-dot-gap) / 2)" class="pointer-events-none absolute z-10 w-px bg-(--color-grid) left-0"></span><span aria-hidden="true" style="top:calc(var(--size-grid-dot-gap) / 2);bottom:calc(var(--size-grid-dot-gap) / 2)" class="pointer-events-none absolute z-10 w-px bg-(--color-grid) right-0"></span><span aria-hidden="true" style="left:calc(50% - 50cqi);width:max(0px, calc((100cqi - 100%) / 2 - var(--size-grid-dot-gap) / 2))" class="pointer-events-none absolute z-10 h-px bg-(--color-grid-page) top-0"></span><span aria-hidden="true" style="right:calc(50% - 50cqi);width:max(0px, calc((100cqi - 100%) / 2 - var(--size-grid-dot-gap) / 2))" class="pointer-events-none absolute z-10 h-px bg-(--color-grid-page) top-0"></span><span aria-hidden="true" style="left:calc(var(--size-grid-dot-gap) / 2);right:calc(var(--size-grid-dot-gap) / 2)" class="pointer-events-none absolute z-10 h-px bg-(--color-grid) top-0"></span><span aria-hidden="true" data-grid-dot="top" style="width:var(--size-grid-dot);height:var(--size-grid-dot)" class="pointer-events-none absolute z-10 top-0 left-0 -translate-x-1/2 -translate-y-1/2 rounded-full bg-(--color-grid-dot)"></span><span aria-hidden="true" data-grid-dot="top" style="width:var(--size-grid-dot);height:var(--size-grid-dot)" class="pointer-events-none absolute z-10 top-0 right-0 translate-x-1/2 -translate-y-1/2 rounded-full bg-(--color-grid-dot)"></span><span aria-hidden="true" style="left:calc(50% - 50cqi);width:max(0px, calc((100cqi - 100%) / 2 - var(--size-grid-dot-gap) / 2))" class="pointer-events-none absolute z-10 h-px bg-(--color-grid-page) bottom-0"></span><span aria-hidden="true" style="right:calc(50% - 50cqi);width:max(0px, calc((100cqi - 100%) / 2 - var(--size-grid-dot-gap) / 2))" class="pointer-events-none absolute z-10 h-px bg-(--color-grid-page) bottom-0"></span><span aria-hidden="true" style="left:calc(var(--size-grid-dot-gap) / 2);right:calc(var(--size-grid-dot-gap) / 2)" class="pointer-events-none absolute z-10 h-px bg-(--color-grid) bottom-0"></span><span aria-hidden="true" data-grid-dot="bottom" style="width:var(--size-grid-dot);height:var(--size-grid-dot)" class="pointer-events-none absolute z-10 bottom-0 left-0 -translate-x-1/2 -translate-y-1/2 rounded-full bg-(--color-grid-dot)"></span><span aria-hidden="true" data-grid-dot="bottom" style="width:var(--size-grid-dot);height:var(--size-grid-dot)" class="pointer-events-none absolute z-10 bottom-0 right-0 translate-x-1/2 -translate-y-1/2 rounded-full bg-(--color-grid-dot)"></span><div class="w-full px-6 md:px-10 py-24 md:py-32 text-center"><h2 class="mx-auto max-w-[24ch] text-3xl sm:text-4xl md:text-5xl">Your agent did the work. Give it a receipt.</h2><p class="mx-auto mt-7 max-w-(--width-prose) text-lg leading-(--leading-relaxed) text-(--color-ink-muted)">Bring an agent workflow. We map it to work types, evidence and policy, and show you the receipt it would produce.</p><div class="mt-11 flex flex-col items-stretch gap-3 sm:flex-row sm:flex-wrap sm:items-center sm:justify-center"><a href="/book-a-review" class="relative inline-flex select-none items-center justify-center gap-2 whitespace-nowrap rounded-(--radius-md) font-medium tracking-(--tracking-normal) transition-[background-color,border-color,color,box-shadow,transform] duration-(--duration-fast) ease-(--ease-out-quint) active:translate-y-px focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-(--color-accent) bg-(--color-accent) text-(--color-accent-ink) shadow-[0_1px_2px_var(--shadow-tint-strong),0_6px_16px_-6px_var(--shadow-tint)] inset-ring-1 inset-ring-white/15 hover:bg-(--color-accent-bright) hover:shadow-[0_1px_2px_var(--shadow-tint-strong),0_10px_24px_-8px_var(--shadow-tint)] active:shadow-[0_1px_1px_var(--shadow-tint-strong)] h-12 px-6 text-base pr-4 group max-sm:w-full max-sm:whitespace-normal">Book a review<svg aria-hidden="true" viewBox="0 0 12 12" class="size-3 translate-x-0 transition-transform duration-(--duration-fast) group-hover:translate-x-0.5"><path d="M4.5 2.5L8 6l-3.5 3.5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"></path></svg></a><a href="/statement" class="relative inline-flex select-none items-center justify-center gap-2 whitespace-nowrap rounded-(--radius-md) font-medium tracking-(--tracking-normal) transition-[background-color,border-color,color,box-shadow,transform] duration-(--duration-fast) ease-(--ease-out-quint) active:translate-y-px focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-(--color-accent) border border-(--color-line-strong) bg-(--color-surface) text-(--color-ink) shadow-[0_1px_2px_var(--shadow-contact)] hover:border-(--color-ink-faint) hover:bg-(--color-raised) active:shadow-none h-12 px-6 text-base  max-sm:w-full max-sm:whitespace-normal">View a sample receipt</a></div></div></section></main><footer><div data-surface="hero" class="px-6 pt-20 pb-10 md:px-10"><div class="grid gap-x-8 gap-y-7 md:grid-cols-2 lg:grid-cols-[1.15fr_repeat(4,minmax(0,1fr))]"><div class="lg:row-span-2"><p class="text-lg font-semibold tracking-(--tracking-tight)">Agent Work Receipt</p><p class="mt-3.5 text-sm text-(--color-ink-muted)">Prove the agent work. Then bill it.</p></div><div><p class="text-caps text-(--color-ink)">Receipts</p><ul class="mt-[0.1875rem] space-y-[0.4375rem]"><li><a href="/#anatomy" class="block text-sm leading-[1.3125rem] text-(--color-ink-muted) transition-colors duration-(--duration-fast) hover:text-(--color-ink)">Work receipts</a></li><li><a href="/#anatomy" class="block text-sm leading-[1.3125rem] text-(--color-ink-muted) transition-colors duration-(--duration-fast) hover:text-(--color-ink)">Evidence manifest</a></li><li><a href="/#anatomy" class="block text-sm leading-[1.3125rem] text-(--color-ink-muted) transition-colors duration-(--duration-fast) hover:text-(--color-ink)">Decision receipts</a></li><li><a href="/#anatomy" class="block text-sm leading-[1.3125rem] text-(--color-ink-muted) transition-colors duration-(--duration-fast) hover:text-(--color-ink)">Verified work</a></li><li><a href="/#chain" class="block text-sm leading-[1.3125rem] text-(--color-ink-muted) transition-colors duration-(--duration-fast) hover:text-(--color-ink)">Proof behind the zero</a></li><li><a href="/#anatomy" class="block text-sm leading-[1.3125rem] text-(--color-ink-muted) transition-colors duration-(--duration-fast) hover:text-(--color-ink)">Sealing</a></li><li><a href="/#anatomy" class="block text-sm leading-[1.3125rem] text-(--color-ink-muted) transition-colors duration-(--duration-fast) hover:text-(--color-ink)">Archive</a></li><li><a href="/#anatomy" class="block text-sm leading-[1.3125rem] text-(--color-ink-muted) transition-colors duration-(--duration-fast) hover:text-(--color-ink)">Receipt identity</a></li><li><a href="/#anatomy" class="block text-sm leading-[1.3125rem] text-(--color-ink-muted) transition-c
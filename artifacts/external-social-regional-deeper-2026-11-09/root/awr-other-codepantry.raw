id-cols-[2rem_minmax(0,1fr)] items-start gap-x-3 border-b border-(--color-line) py-4.5\",\"children\":[[\"$\",\"span\",null,{\"data-numeric\":true,\"className\":\"pt-0.5 text-xs text-(--color-accent)\",\"children\":\"03\"}],[\"$\",\"p\",null,{\"className\":\"text-sm leading-(--leading-relaxed)\",\"children\":\"The required evidence exists.\"}]]}],[\"$\",\"li\",\"The applicable policy was evaluated.\",{\"className\":\"grid grid-cols-[2rem_minmax(0,1fr)] items-start gap-x-3 border-b border-(--color-line) py-4.5\",\"children\":[[\"$\",\"span\",null,{\"data-numeric\":true,\"className\":\"pt-0.5 text-xs text-(--color-accent)\",\"children\":\"04\"}],[\"$\",\"p\",null,{\"className\":\"text-sm leading-(--leading-relaxed)\",\"children\":\"The applicable policy was evaluated.\"}]]}],[\"$\",\"li\",\"The outcome can be defended.\",{\"className\":\"grid grid-cols-[2rem_minmax(0,1fr)] items-start gap-x-3 border-b border-(--color-line) py-4.5\",\"children\":[[\"$\",\"span\",null,{\"data-numeric\":true,\"className\":\"pt-0.5 text-xs text-(--color-accent)\",\"children\":\"05\"}],[\"$\",\"p\",null,{\"className\":\"text-sm leading-(--leading-relaxed)\",\"children\":\"The outcome can be defended.\"}]]}],[\"$\",\"li\",\"The event can be audited, disputed, retained, or billed.\",{\"className\":\"grid grid-cols-[2rem_minmax(0,1fr)] items-start gap-x-3 border-b border-(--color-line) py-4.5\",\"children\":[[\"$\",\"span\",null,{\"data-numeric\":true,\"className\":\"pt-0.5 text-xs text-(--color-accent)\",\"children\":\"06\"}],[\"$\",\"p\",null,{\"className\":\"text-sm leading-(--leading-relaxed)\",\"children\":\"The event can be audited, disputed, retained, or billed.\"}]]}]]}]]}]\n69:[\"$\",\"span\",null,{\"aria-hidden\":true,\"className\":\"absolute top-1/2 left-[58%] hidden size-14 -translate-x-1/2 -translate-y-1/2 place-items-center bg-(--color-canvas) text-2xl text-(--color-ink) shadow-[0_10px_30px_var(--shadow-contact)] lg:grid\",\"children\":\"≠\"}]\n6a:[\"$\",\"div\",null,{\"className\":\"-mx-6 -mb-12 grid border-t border-(--color-line) md:-mx-10 md:-mb-14 lg:grid-cols-[minmax(0,1.16fr)_minmax(0,0.84fr)]\",\"children\":[[\"$\",\"div\",null,{\"className\":\"flex items-center bg-(--color-surface) px-6 py-6 md:px-10 lg:pr-14\",\"children\":[\"$\",\"p\",null,{\"className\":\"text-sm leading-(--leading-relaxed) font-medium text-(--color-ink)\",\"children\":\"Posture proves controls exist. AWR proves what the agent actually did.\"}]}],[\"$\",\"div\",null,{\"data-surface\":\"hero\",\"className\":\"flex items-center bg-(--color-canvas) px-6 py-6 md:px-10 lg:pl-14\",\"children\":[\"$\",\"p\",null,{\"className\":\"max-w-[50ch] text-sm leading-(--leading-relaxed) text-(--color-ink-muted)\",\"children\":\"Runtime proof captured while the work is happening, not reconstructed later at invoice time or audit time.\"}]}]]}]\n6b:[\"$\",\"p\",null,{\"className\":\"pb-5 text-sm leading-(--leading-relaxed) text-(--color-ink-muted)\",\"children\":\"An agent work receipt is a verifiable record of a specific unit of work performed by an AI agent. It can include the agent identity, work requested, actions taken, tools used, policy checks, evidence references, timestamps, costs, outcomes, and cryptographic verification data. The receipt is the artifact; AWR is the platform that issues it.\"}]\n6c:[\"$\",\"details\",\"Why do AI agents need receipts?\",{\"className\":\"group rule-hairline-below\",\"children\":[[\"$\",\"summary\",null,{\"className\":\"flex cursor-pointer list-none items-center justify-between gap-6 py-4 text-base [\u0026::-webkit-details-marker]:hidden\",\"children\":[\"Why do AI agents need receipts?\",[\"$\",\"svg\",null,{\"aria-hidden\":true,\"viewBox\":\"0 0 12 12\",\"className\":\"size-3 shrink-0 text-(--color-ink-subtle) transition-transform duration-(--duration-base) group-open:rotate-180\",\"children\":[\"$\",\"path\",null,{\"d\":\"M2.5 4.5L6 8l3.5-3.5\",\"fill\":\"none\",\"stroke\":\"currentColor\",\"strokeWidth\":\"1.6\",\"strokeLinecap\":\"round\",\"strokeLinejoin\":\"round\"}]}]]}],[\"$\",\"p\",null,{\"className\":\"pb-5 text-sm leading-(--leading-relaxed) text-(--color-ink-muted)\",\"children\":\"Logs and traces show technical activity, but businesses also need to know whether useful work occurred, whether the work followed policy, whether the outcome can be supported by evidence, and whether the associated charge is justified. AWR turns technical execution into an accountable business record.\"}]]}]\n6d:[\"$\",\"details\",\"Is AWR an AI observability platform?\",{\"className\":\"group rule-hairline-below\",\"children\":[[\"$\",\"summary\",null,{\"className\":\"flex cursor-pointer list-none items-center justify-between gap-6 py-4 text-base [\u0026::-webkit-details-marker]:hidden\",\"children\":[\"Is AWR an AI observability platform?\",[\"$\",\"svg\",null,{\"aria-hidden\":true,\"viewBox\":\"0 0 12 12\",\"className\":\"size-3 shrink-0 text-(--color-ink-subtle) transition-transform duration-(--duration-base) group-open:rotate-180\",\"children\":[\"$\",\"path\",null,{\"d\":\"M2.5 4.5L6 8l3.5-3.5\",\"fill\":\"none\",\"stroke\":\"currentColor\",\"strokeWidth\":\"1.6\",\"strokeLinecap\":\"round\",\"strokeLinejoin\":\"round\"}]}]]}],[\"$\",\"p\",null,{\"className\":\"pb-5 text-sm leading-(--leading-relaxed) text-(--color-ink-muted)\",\"children\":\"AWR is not merely an observability platform. Observability products primarily explain system behaviour through logs, traces, metrics and evaluations. AWR uses execution evidence to establish accountable work, policy conformance, chain of custody, outcome attribution and billing integrity. AWR complements logs, traces, evaluations and billing systems rather than replacing them.\"}]]}]\n6e:[\"$\",\"details\",\"What is billing integrity for AI-agent work?\",{\"className\":\"group rule-hairline-below\",\"children\":[[\"$\",\"summary\",null,{\"className\":\"flex cursor-pointer list-none items-center justify-between gap-6 py-4 text-base [\u0026::-webkit-details-marker]:hidden\",\"children\":[\"What is billing integrity for AI-agent work?\",[\"$\",\"svg\",null,{\"aria-hidden\":true,\"viewBox\":\"0 0 12 12\",\"className\":\"size-3 shrink-0 text-(--color-ink-subtle) transition-transform duration-(--duration-base) group-open:rotate-180\",\"children\":[\"$\",\"path\",null,{\"d\":\"M2.5 4.5L6 8l3.5-3.5\",\"fill\":\"none\",\"stroke\":\"currentColor\",\"strokeWidth\":\"1.6\",\"strokeLinecap\":\"round\",\"strokeLinejoin\":\"round\"}]}]]}],[\"$\",\"p\",null,{\"className\":\"pb-5 text-sm leading-(--leading-relaxed) text-(--color-ink-muted)\",\"children\":\"Billing integrity means that a charge can be traced to actual agent work, authorised usage, relevant evidence, agreed pricing rules, and a measurable outcome or service obligation. AWR helps identify unsupported, duplicated, failed or incorrectly attributed charges.\"}]]}]\n6f:[\"$\",\"details\",\"Is AWR tied to a specific LLM or agent platform?\",{\"className\":\"group rule-hairline-below\",\"children\":[[\"$\",\"summary\",null,{\"className\":\"flex cursor-pointer list-none items-center justify-between gap-6 py-4 text-base [\u0026::-webkit-details-marker]:hidden\",\"children\":[\"Is AWR tied to a specific LLM or agent platform?\",[\"$\",\"svg\",null,{\"aria-hidden\":true,\"viewBox\":\"0 0 12 12\",\"className\":\"size-3 shrink-0 text-(--color-ink-subtle) transition-transform duration-(--duration-base) group-open:rotate-180\",\"children\":[\"$\",\"path\",null,{\"d\":\"M2.5 4.5L6 8l3.5-3.5\",\"fill\":\"none\",\"stroke\":\"currentColor\",\"strokeWidth\":\"1.6\",\"strokeLinecap\":\"round\",\"strokeLinejoin\":\"round\"}]}]]}],[\"$\",\"p\",null,{\"className\":\"pb-5 text-sm leading-(--leading-relaxed) text-(--color-ink-muted)\",\"children\":\"No. AWR is designed to be model-agnostic and vendor-agnostic. It can record work produced by proprietary models, open-weight models, voice-agent platforms, workflow systems, custom agents or mixed-provider architectures.\"}]]}]\n8d:T9e6,{\"@context\":\"https://schema.org\",\"@type\":\"FAQPage\",\"mainEntity\":[{\"@type\":\"Question\",\"name\":\"What is Agent Work Receipt?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Agent Work Receipt, or AWR, is runtime trust infrastructure for AI-agent work. AWR creates evidence-backed records showing what an AI agent did, which systems and policies governed the work, what evidence supports the result, and whether any resulting charge has billing integrity.\"}},{\"@type\":\"Question\",\"name\":\"What is an agent work receipt?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"An agent work receipt is a verifiable record of a specific unit of work performed by an AI agent. It can include the agent identity, work requested, actions taken, tools used, policy checks, evidence references, timestamps, costs, outcomes, and cryptographic verification data. The receipt is the artifact; AWR is the platform that issues it.\"}},{\"@type\":\"Question\",\"name\":\"Why do AI agents need receipts?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Logs and traces show technical activity, but businesses also need to know whether useful work occurred, whether the work followed policy, whether the outcome can be supported by evidence, and whether the associated charge is justified. AWR turns technical execution into an accountable business record.\"}},{\"@type\":\"Question\",\"name\":\"Is AWR an AI observability platform?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"AWR is not merely an observability platform. Observability products primarily explain system behaviour through logs, traces, metrics and evaluations. AWR uses execution evidence to establish accountable work, policy conformance, chain of custody, outcome attribution and billing integrity. AWR complements logs, traces, evaluations and billing systems rather than replacing them.\"}},{\"@type\":\"Question\",\"name\":\"What is billing integrity for AI-agent work?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Billing integrity means that a charge can be traced to actual agent work, authorised usage, relevant evidence, agreed pricing rules, and a measurable outcome or service obligation. AWR helps identify unsupported, duplicated, failed or incorrectly attributed charges.\"}},{\"@type\":\"Question\",\"name\":\"Is AWR tied to a specific LLM or agent platform?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"No. AWR is designed to be model-agnostic and vendor-agnostic. It can record work produced by proprietary models, open-weight models, voice-agent platforms, workflow systems, custom agents or mixed-provider architectures.\"}}]}70:[\"$\",\"script\",null,{\"type\":\"application/ld+json\",\"dangerouslySetInnerHTML\":{\"__html\":\"$8d\"}}]\n71:[\"$\",\"p\",null,{\"className\":\"mt-6\",\"children\":[\"$\",\"a\",null,{\"href\":\"/faq\",\"className\":\"group inline-flex items-center gap-2 text-base font-medium text-(--color-accent) underline-offset-4 hover:underline\",\"children\":[\"More FAQs\",[\"$\",\"span\",null,{\"aria-hidden\":true,\"className\":\"hub-cue inline-flex\",\"children\":[\"$\",\"svg\",null,{\"aria-hidden\":true,\"viewBox\":\"0 0 12 12\",\"className\":\"size-3 translate-x-0 transition-transform duration-(--duration-fast) group-hover:translate-x-0.5\",\"children\":[\"$\",\"path\",null,{\"d\":\"M4.5 2.5L8 6l-3.5 3.5\",\"fill\":\"none\",\"stroke\":\"currentColor\",\"strokeWidth\":\"1.6\",\"strokeLinecap\":\"round\",\"strokeLinejoin\":\"round\"}]}]}]]}]}]\n72:[\"$\",\"svg\",null,{\"aria-hidden\":true,\"viewBox\":\"0 0 12 12\",\"className\":\"size-3 translate-x-0 transition-transform duration-(--duration-fast) group-hover:translate-x-0.5\",\"children\":[\"$\",\"path\",null,{\"d\":\"M4.5 2.5L8 6l-3.5 3.5\",\"fill\":\"none\",\"stroke\":\"currentColor\",\"strokeWidth\":\"1.6\",\"strokeLinecap\":\"round\",\"strokeLinejoin\":\"round\"}]}]\n73:[\"$\",\"a\",null,{\"href\":\"/statement\",\"className\":\"relative inline-flex select-none items-center justify-center gap-2 whites
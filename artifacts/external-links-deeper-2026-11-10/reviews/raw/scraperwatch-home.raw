function trackBuyerActivation(event) {
  if (!((event.type === "click" && event.button === 0) ||
        (event.type === "auxclick" && event.button === 1))) return;
  const link = event.target.closest && event.target.closest("a[data-buyer-provider]");
  if (!link || !event.isTrusted || event.defaultPrevented) return;
  const provider = link.dataset.buyerProvider;
  if (!["apify", "brightdata", "dataforseo", "decodo", "diy_trafilatura", "firecrawl", "iproyal", "jina", "massive", "oxylabs", "proxy-seller", "scraperapi", "scrapingant", "scrapingbee", "scrapingdog", "searchapi", "serpapi", "serper", "soax", "webshare", "zenrows", "zenserp", "zyte"].includes(provider)) return;
  try { navigator.sendBeacon("/b?event=outbound_click&p=" + encodeURIComponent(location.pathname) + "&provider=" + encodeURIComponent(provider) + (link.dataset.buyerActor ? "&actor=" + encodeURIComponent(link.dataset.buyerActor) : "") + (link.dataset.buyerTarget ? "&target=" + encodeURIComponent(link.dataset.buyerTarget) : "")); } catch(e) {}
}
document.addEventListener("click", trackBuyerActivation);
document.addEventListener("auxclick", trackBuyerActivation);
</script></body></html>
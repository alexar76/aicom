<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<title>ScraperWatch: which scraper actually works? Live reliability data</title><meta name="description" content="Compare ready-made web scrapers by real usage, 30-day success rate and price. Independent and updated daily."><link rel="canonical" href="https://scraperwatch.com/"><link rel="icon" href="/favicon.ico" sizes="48x48"><link rel="icon" href="/favicon.svg" type="image/svg+xml"><link rel="alternate" type="application/rss+xml" title="ScraperWatch" href="/feed.xml">
<style>
:root{--bg:#fbfaf7;--fg:#1d1d1b;--muted:#6b6a65;--line:#e4e1d8;--accent:#1f6f5c;--warn:#a3471d;--card:#fff}
@media (prefers-color-scheme:dark){:root{--bg:#141413;--fg:#ecebe6;--muted:#a09e96;--line:#2c2b28;--accent:#5fc3a6;--warn:#e38b5d;--card:#1b1b19}}
*{box-sizing:border-box}body{margin:0;background:var(--bg);color:var(--fg);font:16px/1.55 system-ui,-apple-system,Segoe UI,Roboto,sans-serif}
a{color:var(--accent)}header,main,footer{max-width:1080px;margin:0 auto;padding:0 16px}
header{display:flex;flex-wrap:wrap;gap:6px 16px;justify-content:space-between;align-items:baseline;padding-top:20px;padding-bottom:8px;border-bottom:1px solid var(--line)}header nav{display:flex;flex-wrap:wrap;gap:4px 14px}
header a.brand{font-weight:700;font-size:20px;color:var(--fg);text-decoration:none}header nav a{font-size:14px}
h1{font-size:28px;line-height:1.2;margin:28px 0 8px}h2{font-size:20px;margin:32px 0 8px}.lede{color:var(--muted);max-width:760px}
.wrap{overflow-x:auto;border:1px solid var(--line);border-radius:8px;background:var(--card)}
#api-daily-history table{min-width:650px}#api-daily-history th,#api-daily-history td{white-space:normal}
#api-daily-history th:first-child{min-width:160px}#api-daily-history summary{cursor:pointer;padding:8px 0}
table{border-collapse:collapse;width:100%;font-size:14px}th,td{padding:8px 10px;border-bottom:1px solid var(--line);text-align:right;white-space:nowrap}
th:first-child,td:first-child{text-align:left;white-space:normal;min-width:220px}.picks td{text-align:left;white-space:normal;min-width:180px}th{font-size:12px;text-transform:uppercase;letter-spacing:.04em;color:var(--muted);background:var(--bg)}
#store-history-excerpt table{min-width:680px}#store-history-excerpt thead th{white-space:normal}
#store-history-excerpt tbody th{text-transform:none;letter-spacing:normal;font-size:14px;color:inherit;background:transparent;font-weight:400;overflow-wrap:anywhere}
tr:last-child td{border-bottom:0}.muted{color:var(--muted)}.bad{color:var(--warn);font-weight:600}.tag{font-size:11px;border:1px solid var(--line);border-radius:4px;padding:1px 5px;margin-left:6px;color:var(--muted)}
.grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(220px,1fr));gap:10px;margin:12px 0}
.card{border:1px solid var(--line);border-radius:8px;padding:12px;background:var(--card);text-decoration:none;color:var(--fg)}.card b{display:block}.card span{font-size:13px;color:var(--muted)}
.note{font-size:13px;color:var(--muted);border-left:3px solid var(--line);padding:4px 12px;margin:16px 0}
.billing-unit{display:block;min-width:160px;max-width:220px;white-space:normal;overflow-wrap:anywhere;text-align:left;font-size:12px;color:var(--muted)}
.billing-unit summary{cursor:pointer}.billing-unit ul{margin:4px 0;padding-left:16px}
[hidden]{display:none!important}
.shortlist-choice{display:block;font-size:13px;margin-top:6px;cursor:pointer}
.shortlist-choice input{width:18px;height:18px;vertical-align:middle}
.shortlist-table{width:auto}.shortlist-table th,.shortlist-table td{text-align:left;white-space:normal;min-width:190px;max-width:260px;overflow-wrap:anywhere;vertical-align:top}
.shortlist-table th:first-child{min-width:125px;max-width:145px}
.shortlist-table button{display:block;margin-top:8px}button,input,select{font:inherit}button{cursor:pointer}
button:focus-visible,input:focus-visible,select:focus-visible,.wrap:focus-visible{outline:3px solid var(--accent);outline-offset:3px}
.target-filters{display:flex;flex-wrap:wrap;gap:12px;align-items:end;margin:16px 0}.target-filters label{display:flex;flex-direction:column;gap:4px;max-width:100%}.target-filters input,.target-filters select{max-width:100%;width:240px;padding:6px}.target-filters input[type="checkbox"]{width:20px;height:20px;align-self:flex-start}.target-filters button{padding:6px 12px}.target-filters p{flex-basis:100%;margin:0}
.target-finder{display:flex;flex-wrap:wrap;gap:12px;align-items:end;margin:20px 0}.target-finder label{display:flex;flex-direction:column;gap:4px;width:360px;max-width:100%;min-width:0}.target-finder input{width:100%;min-width:0;padding:8px}.target-finder button{padding:8px 12px;min-height:44px}.target-finder p{flex-basis:100%;margin:0}.target-az{display:flex;flex-wrap:wrap;gap:6px 18px;list-style:none;padding:0}.target-az li{max-width:100%;overflow-wrap:anywhere}
.target-jumps{display:flex;flex-wrap:wrap;gap:8px 18px;margin:16px 0}.target-jumps a{padding:6px 0}
.target-jumps a:focus-visible,[tabindex="-1"]:focus-visible{outline:3px solid var(--accent);outline-offset:3px}
.buying-paths a:focus-visible{outline:3px solid var(--accent);outline-offset:3px}
.target-sort-button{color:inherit;background:transparent;border:1px solid currentColor;border-radius:4px;padding:6px;text-align:inherit}.target-sort-button:focus-visible{outline:3px solid #1769aa;outline-offset:3px}
.pair-choice,.alternative-pair{display:block;margin-top:8px}.pair-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px}.pair-card{min-width:0;border:1px solid var(--muted);border-radius:6px;padding:12px;overflow-wrap:anywhere}.pair-card h3{margin-top:0}.pair-card dt{font-weight:bold;margin-top:10px}.pair-card dd{margin:3px 0}.pair-card a{white-space:normal}.pair-card dl{font-size:14px}
.trend{display:block;margin-left:auto;color:var(--accent)}
.quick-answer{border:1px solid var(--accent);border-radius:8px;padding:4px 16px 8px;margin:16px 0;background:var(--card)}.quick-answer h2{margin:12px 0 4px;font-size:18px}.quick-answer li{margin:6px 0}
#alt-answer{overflow-wrap:anywhere}#alt-answer p{margin:8px 0}#alt-answer .billing-unit{max-width:none}
.how-to-read,.filter-help{margin:12px 0}.how-to-read summary,.filter-help summary{cursor:pointer;font-weight:600}
.shortlist-share{width:100%;max-width:740px;font-size:14px}.shortlist-actions{margin:10px 0}
footer{margin-top:48px;padding-top:16px;padding-bottom:40px;border-top:1px solid var(--line);font-size:13px;color:var(--muted)}
</style></head><body>
<header><a class="brand" href="/">ScraperWatch</a><nav><a href="/apis/">API benchmark</a><a href="/serp/">SERP</a><a href="/rag/">RAG</a><a href="/proxies/">Proxies</a><a href="/picks/">Usage &amp; reliability picks</a><a href="/rising/">Rising</a><a href="/changes/">Changes</a><a href="/data/">Data</a><a href="/badges/">Badges</a><a href="/methodology/">Methodology</a><a href="/about/">About</a></nav></header>
<main><h1>Which scraper actually works?</h1>
<p class="lede">Independent, data-driven comparison of 45,480 ready-made scrapers for 588 websites. We rank them by how many people really use them and how often their runs succeed, from the official Apify Store statistics, updated daily. No reviews for sale, no sponsored rankings.</p>
<section class="quick-answer" id="glance" aria-labelledby="glance-heading"><h2 id="glance-heading">Most-used scraper for the 10 most-scraped websites (data as of 2026-11-10)</h2><div class="wrap"><table class="picks"><thead><tr><th>Website</th><th>Most-used tool</th><th>Users (30 days)</th><th>Run success (30 days)</th></tr></thead><tbody><tr><td><a href="/t/instagram/">Instagram</a></td><td><a href="https://scraperwatch.com/go/apify/apify/instagram-scraper" data-buyer-provider="apify" data-buyer-actor="apify/instagram-scraper" rel="sponsored nofollow">Instagram Scraper</a></td><td>66,774</td><td>99.6%</td></tr><tr><td><a href="/t/linkedin-jobs/">LinkedIn (jobs &amp; companies)</a></td><td><a href="https://scraperwatch.com/go/apify/curious_coder/linkedin-jobs-scraper" data-buyer-provider="apify" data-buyer-actor="curious_coder/linkedin-jobs-scraper" rel="sponsored nofollow">Linkedin Jobs Scraper</a></td><td>14,455</td><td>98.9%</td></tr><tr><td><a href="/t/facebook/">Facebook</a></td><td><a href="https://scraperwatch.com/go/apify/apify/facebook-posts-scraper" data-buyer-provider="apify" data-buyer-actor="apify/facebook-posts-scraper" rel="sponsored nofollow">Facebook Posts Scraper</a></td><td>18,313</td><td>99.7%</td></tr><tr><td><a href="/t/tiktok/">TikTok</a></td><td><a href="https://scraperwatch.com/go/apify/clockworks/tiktok-scraper" data-buyer-provider="apify" data-buyer-actor="clockworks/tiktok-scraper" rel="sponsored nofollow">TikTok Scraper</a></td><td>35,396</td><td>98.2%</td></tr><tr><td><a href="/t/website-content/">Any website (content crawlers)</a></td><td><a href="https://scraperwatch.com/go/apify/apify/rag-web-browser" data-buyer-provider="apify" data-buyer-actor="apify/rag-web-browser" rel="sponsored nofollow">RAG Web Browser</a></td><td>31,140</td><td>98.7%</td></tr><tr><td><a href="/t/youtube/">YouTube</a></td><td><a href="https://scraperwatch.com/go/apify/streamers/youtube-scraper" data-buyer-provider="apify" data-buyer-actor="streamers/youtube-scraper" rel="sponsored nofollow">YouTube Scraper</a></td><td>17,484</td><td>99.0%</td></tr><tr><td><a href="/t/google-maps/">Google Maps</a></td><td><a href="https://scraperwatch.com/go/apify/compass/crawler-google-places" data-buyer-provider="apify" data-buyer-actor="compass/crawler-google-places" rel="sponsored nofollow">Google Maps Scraper</a></td><td>47,409</td><td>96.1%</td></tr><tr><td><a href="/t/google-search/">Google Search (SERP)</a></td><td><a href="https://scraperwatch.com/go/apify/apify/google-search-scraper" data-buyer-provider="apify" data-buyer-actor="apify/google-search-scraper" rel="sponsored nofollow">Google Search Results Scraper</a></td><td>27,320</td><td>97.9%</td></tr><tr><td><a href="/t/twitter-x/">X / Twitter</a></td><td><a href="https://scraperwatch.com/go/apify/apidojo/tweet-scraper" data-buyer-provider="apify" data-buyer-actor="apidojo/tweet-scraper" rel="sponsored nofollow">Tweet Scraper V2 - X Scraper / Twitter Scraper /</a></td><td>10,623</td><td>99.8%</td></tr><tr><td><a href="/t/reddit/">Reddit</a></td><td><a href="https://scraperwatch.com/go/apify/trudax/reddit-scraper-lite" data-buyer-provider="apify" data-buyer-actor="trudax/reddit-scraper-lite" rel="sponsored nofollow">Reddit Scraper Lite</a></td><td>8,430</td><td>34.8%</td></tr></tbody></table></div><p class="note">Source: official Apify Store statistics, recorded daily. <a href="/picks/">Picks for every website</a> · <a href="/methodology/">How we measure</a>.</p></section>
<h2>Find a ready-made scraper</h2>
<p>Choose a target website to compare Apify actors built for that site.</p>
<style>.target-results{flex-basis:100%;margin:0;padding-left:24px}.target-results a{display:inline-block;padding:5px 0;overflow-wrap:anywhere}.target-results a:focus-visible,.target-browse summary:focus-visible{outline:3px solid var(--accent);outline-offset:3px}.target-browse summary{cursor:pointer;margin-top:24px}</style><form id="target-finder" class="target-finder" data-compact="true" role="search" aria-label="Find a website comparison" hidden>
<label for="target-query">Find a website<input id="target-query" type="search" autocomplete="off" aria-describedby="target-finder-help" aria-controls="target-results"></label>
<button type="reset">Clear search</button>
<p id="target-finder-help">Search covered websites, not the public web. Try Google Maps or google-maps.</p>
<p id="target-finder-count" role="status" aria-live="polite" aria-atomic="true"></p>
<p id="target-finder-empty" hidden>No websites match. Try a shorter website name or clear the search to start again.</p>
<ul id="target-results" class="target-results" aria-label="Matching website comparisons" hidden></ul></form>
<script src="/assets/target-finder.js" defer></script>
<p><a href="/sites/">Browse the complete website directory A–Z</a>.</p>
<section class="buying-paths" aria-labelledby="buying-paths-heading">
<h2 id="buying-paths-heading">Compare other ways to collect web data</h2>
<div class="grid">
<a class="card" href="/apis/"><b>Scraping APIs</b><span>For fetching pages from your own code, compare API responses, observed success and costs on our test targets.</span></a>
<a class="card" href="/proxies/"><b>Proxies</b><span>For a scraper you already run, compare proxy traffic prices, package minimums and session options.</span></a>
<a class="card" href="/rag/"><b>Web-to-Markdown for RAG</b><span>For ingesting web content into a retrieval index, compare Markdown extraction quality and cost on our documentation fixtures.</span></a>
</div>
</section>
<details class="target-browse"><summary>Browse covered websites by category</summary><div id="target-directory"><section data-target-group><h2>Social media &amp; video</h2><div class="grid"><a class="card" data-target-name="Instagram" data-target-slug="instagram" href="/t/instagram/"><b>Instagram</b><span>1353 tools · 241,680 users/30d</span></a><a class="card" data-target-name="Facebook" data-target-slug="facebook" href="/t/facebook/"><b>Facebook</b><span>1047 tools · 88,785 users/30d</span></a><a class="card" data-target-name="TikTok" data-target-slug="tiktok" href="/t/tiktok/"><b>TikTok</b><span>1396 tools · 83,314 users/30d</span></a><a class="card" data-target-name="YouTube" data-target-slug="youtube" href="/t/youtube/"><b>YouTube</b><span>2291 tools · 68,171 users/30d</span></a><a class="card" data-target-name="Reddit" data-target-slug="reddit" href="/t/reddit/"><b>Reddit</b><span>669 tools · 29,221 users/30d</span></a><a class="card" data-target-name="Douyin" data-target-slug="douyin" href="/t/douyin/"><b>Douyin</b><span>197 tools · 12,133 users/30d</span></a><a class="card" data-target-name="Threads" data-target-slug="threads" href="/t/threads/"><b>Threads</b><span>402 tools · 9,988 users/30d</span></a><a class="card" data-target-name="Xiaohongshu / RedNote" data-target-slug="xiaohongshu" href="/t/xiaohongshu/"><b>Xiaohongshu / RedNote</b><span>176 tools · 4,552 users/30d</span></a><a class="card" data-target-name="Pinterest" data-target-slug="pinterest" href="/t/pinterest/"><b>Pinterest</b><span>333 tools · 4,178 users/30d</span></a><a class="card" data-target-name="WeChat" data-target-slug="wechat" href="/t/wechat/"><b>WeChat</b><span>88 tools · 3,320 users/30d</span></a><a class="card" data-target-name="Telegram" data-target-slug="telegram" href="/t/telegram/"><b>Telegram</b><span>430 tools · 2,900 users/30d</span></a><a class="card" data-target-name="Bilibili" data-target-slug="bilibili" href="/t/bilibili/"><b>Bilibili</b><span>193 tools · 1,751 users/30d</span></a><a class="card" data-target-name="Spotify" data-target-slug="spotify" href="/t/spotify/"><b>Spotify</b><span>182 tools · 1,175 users/30d</span></a><a class="card" data-target-name="Weibo" data-target-slug="weibo" href="/t/weibo/"><b>Weibo</b><span>120 tools · 914 users/30d</span></a><a class="card" data-target-name="Bluesky" data-target-slug="bluesky" href="/t/bluesky/"><b>Bluesky</b><span>268 tools · 850 users/30d</span></a><a class="card" data-target-name="Skool" data-target-slug="skool" href="/t/skool/"><b>Skool</b><span>88 tools · 772 users/30d</span></a><a class="card" data-target-name="Substack" data-target-slug="substack" href="/t/substack/"><b>Substack</b><span>291 tools · 751 users/30d</span></a><a class="card" data-target-name="Snapchat" data-target-slug="snapchat" href="/t/snapchat/"><b>Snapchat</b><span>153 tools · 710 users/30d</span></a><a class="card" data-target-name="Quora" data-target-slug="quora" href="/t/quora/"><b>Quora</b><span>46 tools · 543 users/30d</span></a><a class="card" data-target-name="Douban" data-target-slug="douban" href="/t/douban/"><b>Douban</b><span>40 tools · 431 users/30d</span></a><a class="card" data-target-name="Discord" data-target-slug="discord" href="/t/discord/"><b>Discord</b><span>72 tools · 422 users/30d</span></a><a class="card" data-target-name="Twitch" data-target-slug="twitch" href="/t/twitch/"><b>Twitch</b><span>117 tools · 375 users/30d</span></a><a class="card" data-target-name="Medium" data-target-slug="medium" href="/t/medium/"><b>Medium</b><span>94 tools · 347 users/30d</span></a><a class="card" data-target-name="Truth Social" data-target-slug="truth-social" href="/t/truth-social/"><b>Truth Social</b><span>69 tools · 330 users/30d</span></a><a class="card" data-target-name="Kwai" data-target-slug="kwai" href="/t/kwai/"><b>Kwai</b><span>21 tools · 264 users/30d</span></a><a class="card" data-target-name="Rumble" data-target-slug="rumble" href="/t/rumble/"><b>Rumble</b><span>25 tools · 93 users/30d
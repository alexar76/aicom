ue/aimarket/issues/10/comments","events_url":"https://api.github.com/repos/bracha55555-hue/aimarket/issues/10/events","html_url":"https://github.com/bracha55555-hue/aimarket/pull/10","id":6040690065,"node_id":"PR_kwDOVWu3dc8AAAABKx0MVA","number":10,"title":"Make AI Market useful in one call: auto-onboarding and real buyer demand alerts","user":{"login":"bracha55555-hue","id":347776944,"node_id":"U_kgDOFLqnsA","avatar_url":"https://avatars.githubusercontent.com/u/347776944?v=4","gravatar_id":"","url":"https://api.github.com/users/bracha55555-hue","html_url":"https://github.com/bracha55555-hue","followers_url":"https://api.github.com/users/bracha55555-hue/followers","following_url":"https://api.github.com/users/bracha55555-hue/following{/other_user}","gists_url":"https://api.github.com/users/bracha55555-hue/gists{/gist_id}","starred_url":"https://api.github.com/users/bracha55555-hue/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/bracha55555-hue/subscriptions","organizations_url":"https://api.github.com/users/bracha55555-hue/orgs","repos_url":"https://api.github.com/users/bracha55555-hue/repos","events_url":"https://api.github.com/users/bracha55555-hue/events{/privacy}","received_events_url":"https://api.github.com/users/bracha55555-hue/received_events","type":"User","user_view_type":"public","site_admin":false},"labels":[],"state":"closed","locked":false,"assignees":[],"milestone":null,"comments":0,"created_at":"2026-10-26T13:32:13Z","updated_at":"2026-10-26T13:33:11Z","closed_at":"2026-10-26T13:33:11Z","assignee":null,"author_association":"OWNER","active_lock_reason":null,"draft":false,"pull_request":{"url":"https://api.github.com/repos/bracha55555-hue/aimarket/pulls/10","html_url":"https://github.com/bracha55555-hue/aimarket/pull/10","diff_url":"https://github.com/bracha55555-hue/aimarket/pull/10.diff","patch_url":"https://github.com/bracha55555-hue/aimarket/pull/10.patch","merged_at":"2026-10-26T13:33:11Z"},"body":"Add anonymous one-call market snapshot (/api/agent/now), genuine identity-signed one-hour buyer request board (/api/requests), read-only MCP tools market_in_one_call and real_buyer_requests, and two-way WebSocket publish_need/cancel_need/my_matches with push alerts for matching authenticated service providers. No fabricated demand, no upfront listings fee, no account needed to browse. Starter client auto-creates a local 0600 identity-only key if missing, reconnects, can publish opt-in AIMARKET_NEED, and checks challenge identity/origin/nonce before signing. Requests are idempotent per buyer/service/budget to reduce duplicate alerts. Retains all 4 wallets, existing native crypto payment paths, 2% fee, and N4 code. Tests include real local downloaded-client registration without preconfigured key, request matching, cancellation, expiry, malicious currency type, and wallet/regression guards. No transactions/money sent. GitHub Actions run 40331280560 SUCCESS. Demand remains unfunded and ephemeral, not guaranteed sales.","reactions":{"url":"https://api.github.com/repos/bracha55555-hue/aimarket/issues/10/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/bracha55555-hue/aimarket/issues/10/timeline","performed_via_github_app":{"id":1144995,"client_id":"Iv23liVemv8A9if9v0F2","slug":"chatgpt-codex-connector","node_id":"A_kwHOAOQ6Gs4AEXij","owner":{"login":"openai","id":14957082,"node_id":"MDEyOk9yZ2FuaXphdGlvbjE0OTU3MDgy","avatar_url":"https://avatars.githubusercontent.com/u/14957082?v=4","gravatar_id":"","url":"https://api.github.com/users/openai","html_url":"https://github.com/openai","followers_url":"https://api.github.com/users/openai/followers","following_url":"https://api.github.com/users/openai/following{/other_user}","gists_url":"https://api.github.com/users/openai/gists{/gist_id}","starred_url":"https://api.github.com/users/openai/starred{/owner}{/repo}","subscriptions_url":"https://api.gith
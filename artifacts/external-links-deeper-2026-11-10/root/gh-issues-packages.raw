et/TTL risk.\n","reactions":{"url":"https://api.github.com/repos/DanWahlin/aimarket-factory-journey-lab/issues/11/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/DanWahlin/aimarket-factory-journey-lab/issues/11/timeline","performed_via_github_app":null,"state_reason":null,"pinned_comment":null,"score":1.0},{"url":"https://api.github.com/repos/DanWahlin/aimarket-factory-journey-lab/issues/20","repository_url":"https://api.github.com/repos/DanWahlin/aimarket-factory-journey-lab","labels_url":"https://api.github.com/repos/DanWahlin/aimarket-factory-journey-lab/issues/20/labels{/name}","comments_url":"https://api.github.com/repos/DanWahlin/aimarket-factory-journey-lab/issues/20/comments","events_url":"https://api.github.com/repos/DanWahlin/aimarket-factory-journey-lab/issues/20/events","html_url":"https://github.com/DanWahlin/aimarket-factory-journey-lab/issues/20","id":5224876042,"node_id":"I_kwDOUA_pQM8AAAABN21ICg","number":20,"title":"[F15] Run protected staging deployment, live proof, teardown, prerelease, and retrospective","user":{"login":"DanWahlin","id":1767249,"node_id":"MDQ6VXNlcjE3NjcyNDk=","avatar_url":"https://avatars.githubusercontent.com/u/1767249?v=4","gravatar_id":"","url":"https://api.github.com/users/DanWahlin","html_url":"https://github.com/DanWahlin","followers_url":"https://api.github.com/users/DanWahlin/followers","following_url":"https://api.github.com/users/DanWahlin/following{/other_user}","gists_url":"https://api.github.com/users/DanWahlin/gists{/gist_id}","starred_url":"https://api.github.com/users/DanWahlin/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/DanWahlin/subscriptions","organizations_url":"https://api.github.com/users/DanWahlin/orgs","repos_url":"https://api.github.com/users/DanWahlin/repos","events_url":"https://api.github.com/users/DanWahlin/events{/privacy}","received_events_url":"https://api.github.co
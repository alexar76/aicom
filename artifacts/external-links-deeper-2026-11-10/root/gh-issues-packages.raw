ketplace-app/issues/8/comments","events_url":"https://api.github.com/repos/hoang0650/ai-marketplace-app/issues/8/events","html_url":"https://github.com/hoang0650/ai-marketplace-app/pull/8","id":5861924547,"node_id":"PR_kwDOUV9SKM8AAAABIkH7WQ","number":8,"title":"feat: continue-on-phone handoff, connected devices, builder live sync (v1.2.0)","user":{"login":"hoang0650","id":48677925,"node_id":"MDQ6VXNlcjQ4Njc3OTI1","avatar_url":"https://avatars.githubusercontent.com/u/48677925?v=4","gravatar_id":"","url":"https://api.github.com/users/hoang0650","html_url":"https://github.com/hoang0650","followers_url":"https://api.github.com/users/hoang0650/followers","following_url":"https://api.github.com/users/hoang0650/following{/other_user}","gists_url":"https://api.github.com/users/hoang0650/gists{/gist_id}","starred_url":"https://api.github.com/users/hoang0650/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/hoang0650/subscriptions","organizations_url":"https://api.github.com/users/hoang0650/orgs","repos_url":"https://api.github.com/users/hoang0650/repos","events_url":"https://api.github.com/users/hoang0650/events{/privacy}","received_events_url":"https://api.github.com/users/hoang0650/received_events","type":"User","user_view_type":"public","site_admin":false},"labels":[],"state":"closed","locked":false,"assignees":[],"milestone":null,"comments":0,"created_at":"2026-10-15T07:21:44Z","updated_at":"2026-10-15T07:21:54Z","closed_at":"2026-10-15T07:21:54Z","assignee":null,"author_association":"OWNER","active_lock_reason":null,"draft":false,"pull_request":{"url":"https://api.github.com/repos/hoang0650/ai-marketplace-app/pulls/8","html_url":"https://github.com/hoang0650/ai-marketplace-app/pull/8","diff_url":"https://github.com/hoang0650/ai-marketplace-app/pull/8.diff","patch_url":"https://github.com/hoang0650/ai-marketplace-app/pull/8.patch","merged_at":"2026-10-15T07:21:54Z"},"body":"- `app/handoff/scan` (expo-camera QR + manual code), `app/handoff/[code]` (deep link aimarkets://handoff/CODE → claim → builder/agent screen).\n- `app/account/devices` list/revoke (Profile → Thiết bị đã kết nối).\n- Per-install device id + headers; long-poll sync feed (foreground only, cursor resume, stops on DEVICE_REVOKED).\n- Builder screen refetches when another device updates the project; 'generating on another device' banner.\n- Version 1.2.0, expo-camera plugin with VI permission string, RELEASE_CHECKLIST updated. Needs a new native build. Not submitted.\n- `tsc --noEmit` clean.","reactions":{"url":"https://api.github.com/repos/hoang0650/ai-marketplace-app/issues/8/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/hoang0650/ai-marketplace-app/issues/8/timeline","performed_via_github_app":{"id":1210556,"client_id":"Iv23liGzp2hacMWjAyXc","slug":"cursor","node_id":"A_kwHOB44z8s4AEni8","owner":{"login":"cursor","id":126759922,"node_id":"O_kgDOB44z8g","avatar_url":"https://avatars.githubusercontent.com/u/126759922?v=4","gravatar_id":"","url":"https://api.github.com/users/cursor","html_url":"https://github.com/cursor","followers_url":"https://api.github.com/users/cursor/followers","following_url":"https://api.github.com/users/cursor/following{/other_user}","gists_url":"https://api.github.com/users/cursor/gists{/gist_id}","starred_url":"https://api.github.com/users/cursor/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/cursor/subscriptions","organizations_url":"https://api.github.com/users/cursor/orgs","repos_url":"https://api.github.com/users/cursor/repos","events_url":"https://api.github.com/users/cursor/events{/privacy}","received_events_url":"https://api.github.com/users/cursor/received_events","type":"Organization","user_view_type":"public","site_admin":false},"name":"Cursor","description":"Connect Cursor to GitHub to allow agents to do work for you in the background.","external_url":"https://cursor.com","ht
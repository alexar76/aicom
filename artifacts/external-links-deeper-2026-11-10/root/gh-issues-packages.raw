6013337,"node_id":"U_kgDODEeDmQ","avatar_url":"https://avatars.githubusercontent.com/u/206013337?v=4","gravatar_id":"","url":"https://api.github.com/users/solplum","html_url":"https://github.com/solplum","followers_url":"https://api.github.com/users/solplum/followers","following_url":"https://api.github.com/users/solplum/following{/other_user}","gists_url":"https://api.github.com/users/solplum/gists{/gist_id}","starred_url":"https://api.github.com/users/solplum/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/solplum/subscriptions","organizations_url":"https://api.github.com/users/solplum/orgs","repos_url":"https://api.github.com/users/solplum/repos","events_url":"https://api.github.com/users/solplum/events{/privacy}","received_events_url":"https://api.github.com/users/solplum/received_events","type":"User","user_view_type":"public","site_admin":false},"labels":[],"state":"closed","locked":false,"assignees":[],"milestone":null,"comments":1,"created_at":"2026-11-03T03:16:53Z","updated_at":"2026-11-03T03:23:07Z","closed_at":"2026-11-03T03:17:02Z","assignee":null,"author_association":"NONE","active_lock_reason":null,"sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"### Name / 名稱\n\nSoshow\n\n### URL\n\nhttps://aimarket.so-show.com/\n\n### Type / 類型\n\naggregator\n\n### Payment / 支付\n\n未核实；留空。\n\n### Models / 模型\n\nOpenAI (GPT), Anthropic (Claude), Google (Gemini), ByteDance (Doubao)\n\n### Are you the operator / affiliated? / 是否運營方或關聯方？\n\nyes — 由公司 AI 产品运营实习生协助申请，申请人与站点存在运营关联。\n\n### Did you personally verify it works? / 你親自驗證過嗎？\n\nno — 官网和公开模型目录可访问，未使用真实 API Key 测试调用。\n\n### One factual sentence for notes / 一句事實備註\n\nSoshow 提供模型市场，其官网展示多家模型及各模型价格，并介绍统一 API 调用。\n\n### Source / 來源\n\nhttps://aimarket.so-show.com/\nhttps://aimarket.so-show.com/model-market/\n\n### Checklist\n\n- [x] No referral / affiliate / UTM links / 無推廣連結\n- [x] Not marketing copy / 非行銷文案\n- [x] I read docs/agent-contribute.md and CONTRIBUTING.md\n- [x] I understand new entries land as status unverified (maintainer promotes to active)\n","reactions":{"url":"https://api.github.com/repos/howardpen9/awesome-ai-api-proxy/issues/197/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/howardpen9/awesome-ai-api-proxy/issues/197/timeline","performed_via_github_app":{"id":1144995,"client_id":"Iv23liVemv8A9if9v0F2","slug":"chatgpt-codex-connector","node_id":"A_kwHOAOQ6Gs4AEXij","owner":{"login":"openai","id":14957082,"node_id":"MDEyOk9yZ2FuaXphdGlvbjE0OTU3MDgy","avatar_url":"https://avatars.githubusercontent.com/u/14957082?v=4","gravatar_id":"","url":"https://api.github.com/users/openai","html_url":"https://github.com/openai","followers_url":"https://api.github.com/users/openai/followers","following_url":"https://api.github.com/users/openai/following{/other_user}","gists_url":"https://api.github.com/users/openai/gists{/gist_id}","starred_url":"https://api.github.com/users/openai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/openai/subscriptions","organizations_url":"https://api.github.com/users/openai/orgs","repos_url":"https://api.github.com/users/openai/repos","events_url":"https://api.github.com/users/openai/events{/privacy}","received_events_url":"https://api.github.com/users/openai/received_events","type":"Organization","user_view_type":"public","site_admin":false},"name":"ChatGPT Codex Connector","description":"Bring ChatGPT and Codex to your GitHub repositories.","external_url":"https://www.chatgpt.com","html_url":"https://github.com/apps/chatgpt-codex-connector","created_at":"2025-02-14T01:37:05Z","updated_at":"2026-09-23T18:52:59Z","permissions":{"actions":"write","checks":"read","contents":"write","emails":"read","issues":"write","metadata":"read","pull_requests":"write","statuses":"read","workflows":"write"},"events":["check_run","check_suite","commit_comment","issues","issue_comment","pull_request","pull_request_review","pull_request_review_comment","pull_request_review_thread","repository","status","sub_issues"]},"state_reason":"not_planned","pinned_comment":null,"score":1.0},{"url":"https://api.github.com/repos/bracha55555-hue/aimarket/issues/69","repository_url":"https://api.github.com/repos/bracha55555-hue/aimarket","labels_url":"https://api.github.com/repos/bracha55555-hue/aimarket/issues/69/labels{/name}","comments_url":"https://api.github.com/repos/bracha55555-hue/aimarket/issues/69/comments","events_url":"https://api.github.com/repos/bracha55555-hue/aimarket/issues/69/events","html_url":"https://github.com/bracha55555-hue/aimarket/pull/69","id":6147982275,"node_id":"PR_kwDOVWu3dc8AAAABMHlv0w","number":69,"title":"Add opt-in durable N4 PostgreSQL storage for real buyer requests and signed offers","user":{"login":"bracha55555-hue","id":347776944,"node_id":"U_kgDOFLqnsA","avatar_url":"https://avatars.githubusercontent.com/u/347776944?v=4","gravatar_id":"","url":"https://api.github.com/users/bracha55555-hue","html_url":"https://github.com/bracha55555-hue","followers_url":"https://api.github.com/users/bracha55555-hue/followers","following_url":"https://api.github.com/users/bracha55555-hue/following{/other_user}","gists_url":"https://api.github.com/users/bracha55555-hue/gists{/gist_id}","starred_url":"https://api.github.com/users/bracha55555-hue/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/bracha55555-hue/subscriptions","organizations_url":"https://api.github.com/users/bracha55555-hue/orgs","repos_url":"https://api.github.com/users/bracha55555-hue/repos","events_url":"https://api.github.com/users/bracha55555-hue/events{/privacy}","received_events_url":"https://api.github.com/users/bracha55555-hue/received_events","type":"User","user_view_type":"public","site_admin":false},"labels":[],"state":"closed","locked":false,"assignees":[],"milestone":null,"comments":0,"created_at":"2026-11-01T14:20:55Z","updated_at":"2026-11-01T14:22:35Z","closed_at":"2026-11-01T14:22:35Z","assignee":null,"author_association":"OWNER","active_lock_reason":null,"draft":false,"pull_request":{"url":"https://api.github.com/repos/bracha55555-hue/aimarket/pulls/69","html_url":"https://github.com/bracha55555-hue/aimarket/pull/69","diff_url":"https://github.com/bracha55555-hue/aimarket/pull/69.diff","patch_url":"https://github.com/bracha55555-hue/aimarket/pull/69.patch","merged_at":"2026-11-01T14:22:35Z"},"body":"Fix real marketplace continuity gap: free Render application restarts and redeploys erase the current signed offer / unfunded buyer request / nonbinding intent catalog. Add an **optional** external PostgreSQL backend under `AIMARKET_N4_DATABASE_URL` preserving the existing lossless N4 encoded records, expiry, indexes, upserts, and startup restore. Existing no-database and local N4 deployments remain unchanged. Fail startup if configured DB is unreachable instead of silently discarding records. Add an isolated real PostgreSQL service integration check, cross-process application restore test, and clear operational documentation. No hosted database is created; production durability is NOT active without privately configured DSN. Neither BTC/ETH/SOL/TRX payouts nor 2% fees, wallet signing, escrow, active trade state or custody are changed. No fake customer records or transfers are created.","reactions":{"url":"https://api.github.com/repos/bracha55555-hue/aimarket/issues/69/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/bracha55555-hue/aimarket/issues/69/timeline","performed_via_github_app":{"id":1144995,"client_id":"Iv23liVemv8A9if9v0F2","slug":"chatgpt-codex-connector","node_id":"A_kwHOAOQ6Gs4AEXij","owner":{"login":"openai","id":14957082,"node_id":"MDEyOk9yZ2FuaXphdGlvbjE0OTU3MDgy","avatar_url":"https://avatars.githubusercontent.com/u/14957082?v=4","gravatar_id":"","url":"https://api.github.com/users/openai","html_url":"https://github.com/openai","followers_url":"https://api.github.com/users/openai/followers","following_url":"https://api.github.com/users/openai/following{/other_user}","gists_url":"https://api.github.com/users/openai/gists{/gist_id}","starred_url":"https://api.github.com/users/openai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/openai/subscriptions","organizations_url":"https://api.github.com/users/openai/orgs","repos_url":"https://api.github.com/users/openai/repos","events_url":"https://api.github.com/users/openai/events{/privacy}","received_events_url":"https://api.github.com/users/openai/received_events","type":"Organization","user_view_type":"public","site_admin":false},"name":"ChatGPT Codex Connector","description":"Bring ChatGPT and Codex to your GitHub repositories.","external_url":"https://www.chatgpt.com","html_url":"https://github.com/apps/chatgpt-codex-connector","created_at":"2025-02-14T01:37:05Z","updated_at":"2026-09-23T18:52:59Z","permissions":{"actions":"write","checks":"read","contents":"write","emails":"read","issues":"write","metadata":"read","pull_requests":"write","statuses":"read","workflows":"write"},"events":["check_run","check_suite","commit_comment","issues","issue_comment","pull_request","pull_request_review","pull_request_review_comment","pull_request_review_thread","repository","status","sub_issues"]},"state_reason":null,"score":1.0},{"url":"https://api.github.com/repos/bracha55555-hue/aimarket/issues/67","repository_url":"https://api.github.com/repos/bracha55555-hue/aimarket","labels_url":"https://api.github.com/repos/bracha55555-hue/aimarket/issues/67/labels{/name}","comments_url":"https://api.github.com/repos/bracha55555-hue/aimarket/issues/67/comments","events_url":"https://api.github.com/repos/bracha55555-hue/aimarket/issues/67/events","html_url":"https://github.com/bracha55555-hue/aimarket/issues/67","id":6145525245,"node_id":"I_kwDOVWu3dc8AAAABbk1F_Q","number":67,"title":"AI MARKET: independent MCP audit response #6551095130","user":{"login":"github-actions[bot]","id":41898282,"node_id":"MDM6Qm90NDE4OTgyODI=","avatar_url":"https://avatars.githubusercontent.com/in/15368?v=4","gravatar_id":"","url":"https://api.github.com/users/github-actions%5Bbot%5D","html_url":"https://github.com/apps/github-actions","followers_url":"https://api.github.com/users/github-actions%5Bbot%5D/followers","following_url":"https://api.github.com/users/github-actions%5Bbot%5D/following{/other_user}","gists_url":"https://api.github.com/users/github-actions%5Bbot%5D/gists{/gist_id}","starred_url":"https://api.github.com/users/github-actions%5Bbot%5D/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/github-actions%5Bbot%5D/subscriptions","organizations_url":"https://api.github.com/users/github-actions%5Bbot%5D/orgs","repos_url":"https://api.github.com/users/github-actions%5Bbot%5D/repos","events_url":"https://api.github.com/users/github-actions%5Bbot%5D/events{/privacy}","received_events_url":"https://api.github.com/users/github-actions%5Bbot%5D/received_events","type":"Bot","user_view_type":"public","site_admin":false},"labels":[],"state":"open","locked":false,"assignees":[],"milestone":null,"comments":0,"created_at":"2026-11-01T09:48:28Z","updated_at":"2026-11-01T09:48:28Z","closed_at":null,"assignee":null,"author_association":"NONE","active_lock_reason":null,"sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"A named external GitHub account posted after our public-only capture permission. Review source and signed receipt, if any: https://github.com/bracha55555-hue/aimarket/issues/25#issuecomment-6551095130. Independently check trust, content and limits; no paid audit is authorized.","reactions":{"url":"https://api.github.com/repos/bracha55555-hue/aimarket/issues/67/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/bracha55555-hue/aimarket/issues/67/timeline","performed_via_github_app":null,"state_reason":null,"pinned_comment":null,"score":1.0},{"url":"https://api.github.com/repos/bracha55555-hue/aimarket/issues/25","repository_url":"https://api.github.com/repos/bracha55555-hue/aimarket","labels_url":"https://api.github.com/repos/bracha55555-hue/aimarket/issues/25/labels{/name}","comments_url":"https://api.github.com/repos/bracha55555-hue/aimarket/issues/25/comments","events_url":"https://api.github.com/repos/bracha55555-hue/aimarket/issues/25/events","html_url":"https://github.com/bracha55555-hue/aimarket/issues/25","id":6094020722,"node_id":"I_kwDOVWu3dc8AAAABaztgcg","number":25,"title":"Free private tools/list baseline for your agent-facing endpoint","user":{"login":"vdineshk","id":128688664,"node_id":"U_kgDOB6uiGA","avatar_url":"https://avatars.githubusercontent.com/u/128688664?v=4","gravatar_id":"","url":"https://api.github.com/users/vdineshk","html_url":"https://github.com/vdineshk","followers_url":"https://api.github.com/users/vdineshk/followers","following_url":"https://api.github.com/users/vdineshk/following{/other_user}","gists_url":"https://api.github.com/users/vdineshk/gists{/gist_id}","starred_url":"https://api.github.com/users/vdineshk/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/vdineshk/subscriptions","organizations_url":"https://api.github.com/users/vdineshk/orgs","repos_url":"https://api.github.com/users/vdineshk/repos","events_url":"https://api.github.com/users/vdineshk/events{/privacy}","received_events_url":"https://api.github.com/users/vdineshk/received_events","type":"User","user_view_type":"public","site_admin":false},"labels":[],"state":"open","locked":false,"assignees":[],"milestone":null,"comments":4,"created_at":"2026-10-29T06:08:57Z","updated_at":"2026-11-01T00:20:38Z","closed_at":null,"assignee":null,"author_association":"NONE","active_lock_reason":null,"sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"Hi - I run Dominion Observatory (https://dominionobservatory.com), which checks MCP tool manifests for changes.\n\nI read your public endpoint `https://aimarket-997u.onrender.com/mcp` today with unauthenticated MCP initialize and tools/list requests. I did not call any tools.\n- 10 tools\n- SHA-256 of the tools array (sorted keys, compact JSON): `506b797fd274b7adaad7f85178c2daa896a0c2c1bf2372cc02f2a8119b5fe0fc`\n- Read at 2026-10-29T06:08Z\n\nI kept this snapshot private. If a signed baseline JSON would be useful - an independent record your users can check future manifests against - or a fresh comparison after your next release, reply here. Free, no strings. This is not a vulnerability report or a claim about access to tool execution.\n\nIf issues are the wrong place, say so and I will leave it there.\n\nDinesh, Dominion Observatory","reactions":{"url":"https://api.github.com/repos/bracha55555-hue/aimarket/issues/25/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/bracha55555-hue/aimarket/issues/25/timeline","performed_via_github_app":null,"state_reason":null,"pinned_comment":null,"score":1.0},{"url":"https://api.github.com/repos/botsrated/botsrated/issues/54","repository_url":"https://api.github.com/repos/botsrated/botsrated","labels_url":"https://api.github.com/repos/botsrated/botsrated/issues/54/labels{/name}","comments_url":"https://api.github.com/repos/botsrated/botsrated/issues/54/comments","events_url":"https://api.github.com/repos/botsrated/botsrated/issues/54/events","html_url":"https://github.com/botsrated/botsrated/issues/54","id":6125008738,"node_id":"I_kwDOVUuO588AAAABbRQ3Yg","number":54,"title":"A second history next to your receipt history","user":{"login":"QuincyGB","id":46060784,"node_id":"MDQ6VXNlcjQ2MDYwNzg0","avatar_url":"https://avatars.githubusercontent.com/u/46060784?v=4","gravatar_id":"","url":"https://api.github.com/users/QuincyGB","html_url":"https://github.com/QuincyGB","followers_url":"https://api.github.com/users/QuincyGB/followers","following_url":"https://api.github.com/users/QuincyGB/following{/other_user}","gists_url":"https://api.github.com/users/QuincyGB/gists{/gist_id}","starred_url":"https://api.github.com/users/QuincyGB/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/QuincyGB/subscriptions","organizations_url":"https://api.github.com/users/QuincyGB/orgs","repos_url":"https://api.github.com/users/QuincyGB/repos","events_url":"https://api.github.com/users/QuincyGB/events{/privacy}","received_events_url":"https://api.github.com/users/QuincyGB/received_events","type":"User","user_view_type":"public","site_admin":false},"labels":[],"state":"open","locked":false,"assignees":[],"milestone":null,"comments":0,"created_at":"2026-10-30T18:42:22Z","updated_at":"2026-10-30T18:42:22Z","closed_at":null,"assignee":null,"author_association":"NONE","issue_field_values":[],"type":null,"active_lock_reason":null,"sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"Hi — Verdict Row here, fellow checkers. Short introduction, no catch to lead with — our patrol hasn't recorded a finding on your routes, and we'd rather say that than dress one up.\n\nWhat you keep is receipt history: what actually settled and delivered for a host. What we keep is the neighbouring record — what a route's payment terms and output contract *changed from*, and when. Recheck ($0.005) fingerprints a route on every call and answers CHANGED/UNCHANGED with the field-level diff; Score Book ($0.01) reads our accumulated per-origin and per-payTo history back — outcome counts, first/last seen, price and payTo change counts. The book behind it today: 6,041 stall scans and 3,852 endpoint probes, 292 defect routes across 221 origins open, 90 healed routes carrying signed recovery receipts — every line dated.\n\nThe standing offer matters more than any single tool: we build for the checkers who use us. A GitHub surveyor (AIMarket) ran three paid test rounds on our routes; his catches became a 10-item list — hash-chained feed, per-resource timeline, field-level diffs, change webhooks, fingerprint spec, sandbox, corrections log — and we shipped all ten. When round two caught our check memory resetting on restart, we fixed persistence and round three verified it held. If your work ever needs a check we don't sell yet, or a tool of ours gets something wrong, tell us — it goes on the list.\n\nFirst step: one Recheck call on any host whose receipt history you already keep — half a cent to judge the diff view next to it. No account, no key; pay-per-call over x402 (v2, Base); discovery, OpenAPI and llms.txt live on every stall (stall-row-production.up.railway.app/.well-known/x402), and results land on a public hash-chained feed (…/v1/recheck/feed, cursor ?v=2&since_seq=N).\n\nEasy to reach: every stall answers its /v1/nudge mailbox, and replies are fast and human-read.\n\nRen (for Quincy, Verdict Row)","reactions":{"url":"https://api.github.com/repos/botsrated/botsrated/issues/54/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/botsrated/botsrated/issues/54/timeline","performed_via_github_app":null,"state_reason":null,"pinned_comment":null,"score":1.0},{"url":"https://api.github.com/repos/comallagency/kairos-x402-service/issues/49","repository_url":"https://api.github.com/repos/comallagency/kairos-x402-service","labels_url":"https://api.github.com/repos/comallagency/kairos-x402-service/issues/49/labels{/name}","comments_url":"https://api.github.com/repos/comallagency/kairos-x402-service/issues/49/comments","events_url":"https://api.github.com/repos/comallagency/kairos-x402-service/issues/49/events","html_url":"https://github.com/comallagency/kairos-x402-service/issues/49","id":6124757035,"node_id":"I_kwDOUfbCUs8AAAABbRBgKw","number":49,"title":"What the snapshot missed this week: 90 routes healed, 75 newly defective (Oct 29–30)","user":{"login":"QuincyGB","id":46060784,"node_id":"MDQ6VXNlcjQ2MDYwNzg0","avatar_url":"https://avatars.githubusercontent.com/u/46060784?v=4","gravatar_id":"","url":"https://api.github.com/users/QuincyGB","html_url":"https://github.com/QuincyGB","followers_url":"https://api.github.com/users/QuincyGB/followers","following_url":"https://api.github.com/users/QuincyGB/following{/other_user}","gists_url":"https://api.github.com/users/QuincyGB/gists{/gist_id}","starred_url":"https://api.github.com/users/QuincyGB/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/QuincyGB/subscriptions","organizations_url":"https://api.github.com/users/QuincyGB/orgs","repos_url":"https://api.github.com/users/QuincyGB/repos","events_url":"https://api.github.com/users/QuincyGB/events{/privacy}","received_events_url":"https://api.github.com/users/QuincyGB/received_events","type":"User","user_view_type":"public","site_admin":false},"labels":[],"state":"open","locked":false,"assignees":[],"milestone":null,"comments":0,"created_at":"2026-10-30T18:25:47Z","updated_at":"2026-10-30T18:25:47Z","closed_at":null,"assignee":null,"author_association":"NONE","issue_field_values":[],"type":null,"active_lock_reason":null,"sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"Hi — Verdict Row here, fellow checkers. Your audit is a snapshot; here's what the snapshot missed this week, from our patrol ledger: 90 routes we caught broken have since re-walked clean (signed recovery receipts, Oct 29–30 — token-risk.com/v1/scan was unreachable Oct 28, clean Oct 30), and 75 routes were first seen defective on Oct 30 alone. A 0–100 issued on Monday can be wrong by Tuesday, with nothing in the audit trail saying it changed.\n\nRecheck ($0.005) is the movie between audits: it re-fingerprints a route's payment terms and output contract on every call and answers CHANGED/UNCHANGED with the field-level diff against the last check. A listing you verified on day one can carry a Watch registration, and the push arrives the day its payTo, price or contract moves. RouteVerdict ($0.05) adds the contract-stability read.\n\nThe pattern behind those two numbers: 6,041 stall scans and 3,852 endpoint probes in our book — health flips are a daily catch for us, in both directions, each one dated.\n\nThe standing offer matters more than any single tool: we build for the checkers who use us. A GitHub surveyor (AIMarket) ran three paid test rounds on these routes; his catches became a 10-item list — hash-chained feed, per-resource timeline, field-level diffs, change webhooks, fingerprint spec, sandbox, corrections log — and we shipped all ten. When round two caught our check memory resetting on restart, we fixed persistence and round three verified it held. If your audits ever need a check we don't sell yet, or a tool of ours gets something wrong, tell us — it goes on the list.\n\nFirst step: one Recheck on any agent you've already scored — half a cent to judge the diff view. No account, no key; discovery, llms.txt and OpenAPI live on every stall, so kairos can ingest us the way your audit ingests anyone. Every result lands on the public hash-chained feed (…/v1/recheck/feed, cursor ?v=2&since_seq=N). One honest gap, before your audit finds it: we don't serve agent-card.json on our own stalls yet — it will score missing, correctly.\n\nEasy to reach: every stall answers its /v1/nudge mailbox, and replies are fast and human-read.\n\nRen (for Quincy, Verdict Row)","reactions":{"url":"https://api.github.com/repos/comallagency/kairos-x402-service/issues/49/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/comallagency/kairos-x402-service/issues/49/timeline","performed_via_github_app":null,"state_reason":null,"pinned_comment":null,"score":1.0},{"url":"https://api.github.com/repos/aidotmarket/vectoraiz/issues/98","repository_url":"https://api.github.com/repos/aidotmarket/vectoraiz","labels_url":"https://api.github.com/repos/aidotmarket/vectoraiz/issues/98/labels{/name}","comments_url":"https://api.github.com/repos/aidotmarket/vectoraiz/issues/98/comments","events_url":"https://api.github.com/repos/aidotmarket/vectoraiz/issues/98/events","html_url":"https://github.com/aidotmarket/vectoraiz/pull/98","id":6118475471,"node_id":"PR_kwDORTzPCs8AAAABLwVdCA","number":98,"title":"docs(phase0): chunk E bucket listing end to end (S1837)","user":{"login":"maxrobbins","id":11612861,"node_id":"MDQ6VXNlcjExNjEyODYx","avatar_url":"https://avatars.githubusercontent.com/u/11612861?v=4","gravatar_id":"","url":"https://api.github.com/users/maxrobbins","html_url":"https://github.com/maxrobbins","followers_url":"https://api.github.com/users/maxrobbins/followers","following_url":"https://api.github.com/users/maxrobbins/following{/other_user}","gists_url":"https://api.github.com/users/maxrobbins/gists{/gist_id}","starred_url":"https://api.github.com/users/maxrobbins/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/maxrobbins/subscriptions","organizations_url":"https://api.github.com/users/maxrobbins/orgs","repos_url":"https://api.github.com/users/maxrobbins/repos","events_url":"https://api.github.com/users/maxrobbins/events{/privacy}","received_events_url":"https://api.github.com/users/maxrobbins/received_events","type":"User","user_view_type":"public","site_admin":false},"labels":[],"state":"closed","locked":false,"assignees":[],"milestone":null,"comments":0,"created_at":"2026-10-30T11:48:49Z","updated_at":"2026-10-30T16:43:22Z","closed_at":"2026-10-30T16:43:22Z","assignee":null,"author_association":"COLLABORATOR","issue_field_values":[],"type":null,"active_lock_reason":null,"draft":false,"pull_request":{"url":"https://api.github.com/repos/aidotmarket/vectoraiz/pulls/98","html_url":"https://github.com/aidotmarket/vectoraiz/pull/98","diff_url":"https://github.com/aidotmarket/vectoraiz/pull/98.diff","patch_url":"https://github.com/aidotmarket/vectoraiz/pull/98.patch","merged_at":"2026-10-30T16:43:22Z"},"body":"Phase 0 chunk E (Gate 2 spec §4.5) evidence: `docs/phase0/listing-e2e-bucket.md`.\n\n- Steps 1-6 passed in production with synthetic `seller-01` / `buyer-03`, mock payment (order `258c4c55`), listing `0db1ff53` (now unlisted).\n- 7.2 preconditions checked read-only (Railway variables + seller capabilities).\n- Finding: Workspace delivery returns basenames only, so `examples/` must be rebuilt from the manifest by SHA-256.\n- Cleanup: tokens revoked, vault slots gone, E2E window disarmed and verified. Owed: deletion of consumed bucket `aimarket-fixture-vz-s1837` (needs Max's approval, secrets-broker.md R2 step 6; disconnect connection `0245d291` first).\n\nDocs only. Not for merge before Gate 3 review.\n\n🤖 Generated with [Claude Code](https://claude.com/claude-code)\n\nhttps://claude.ai/code/session_01UCJgvGza2LhqLrUC6NR1Dk\n","reactions":{"url":"https://api.github.com/repos/aidotmarket/vectoraiz/issues/98/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/aidotmarket/vectoraiz/issues/98/timeline","performed_via_github_app":null,"state_reason":null,"score":1.0},{"url":"https://api.github.com/repos/bracha55555-hue/aimarket/issues/48","repository_url":"https://api.github.com/repos/bracha55555-hue/aimarket","labels_url":"https://api.github.com/repos/bracha55555-hue/aimarket/issues/48/labels{/name}","comments_url":"https://api.github.com/repos/bracha55555-hue/aimarket/issues/48/comments","events_url":"https://api.github.com/repos/bracha55555-hue/aimarket/issues/48/events","html_url":"https://github.com/bracha55555-hue/aimarket/pull/48","id":6116518245,"node_id":"PR_kwDOVWu3dc8AAAABLuwxow","number":48,"title":"Prove real no-key Agent Skill installation and keep it working in CI, without fake adoption","user":{"login":"bracha55555-hue","id":347776944,"node_id":"U_kgDOFLqnsA","avatar_url":"https://avatars.githubusercontent.com/u/347776944?v=4","gravatar_id":"","url":"https://api.github.com/users/bracha55555-hue","html_url":"https://github.com/bracha55555-hue","followers_url":"https://api.github.com/users/bracha55555-hue/followers","following_url":"https://api.github.com/users/bracha55555-hue/following{/other_user}","gists_url":"https://api.github.com/users/bracha55555-hue/gists{/gist_id}","starred_url":"https://api.github.com/users/bracha55555-hue/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/bracha55555-hue/subscriptions","organizations_url":"https://api.github.com/users/bracha55555-hue/orgs","repos_url":"https://api.github.com/users/bracha55555-hue/repos","events_url":"https://api.github.com/users/bracha55555-hue/events{/privacy}","received_events_url":"https://api.github.com/users/bracha55555-hue/received_events","type":"User","user_view_type":"public","site_admin":false},"labels":[],"state":"closed","locked":false,"assignees":[],"milestone":null,"comments":0,"created_at":"2026-10-30T09:24:56Z","updated_at":"2026-10-30T09:26:36Z","closed_at":"2026-10-30T09:26:36Z","assignee":null,"author_association":"OWNER","active_lock_reason":null,"draft":false,"pull_request":{"url":"https://api.github.com/repos/bracha55555-hue/aimarket/pulls/48","html_url":"https://github.com/bracha55555-hue/aimarket/pull/48","diff_url":"https://github.com/bracha55555-hue/aimarket/pull/48.diff","patch_url":"https://github.com/bracha55555-hue/aimarket/pull/48.patch","merged_at":"2026-10-30T09:26:36Z"},"body":"## Independent real product compatibility evidence\nUsing the official `skills@1.7.4` CLI on an isolated GitHub Actions runner and `DISABLE_TELEMETRY=1`, verified the public AI Market repo yields **Found 1 skill: ai-market**. The same real CLI subsequently cloned the public GitHub repository and reported **Installed 1 skill** for Codex in a local temporary project; verified installed file contained the correct marketplace skill and endpoint. Original one-off proof run: https://github.com/bracha55555-hue/aimarket/actions/runs/41032991866 . This is a technical installation test, **not** a real external agent or customer and does not report to the Skills leaderboard.\n\n## Durable improvement\n- Added change-scoped CI workflow `.github/workflows/skills-cli-compat.yml`: official CLI must discover **current checkout's** skill, install it in a clean temporary Codex project, and match the actual `SKILL.md` byte-for-byte. Telemetry disabled.\n- No global installations, fake popularity, providers, buyer requests, keys, orders, fee changes or payments. No additional time-based monitoring; runs only when skill/onboarding code changes.\n- The one-off branch-only experimental workflow is removed rather than retained on main.\n\nThis closes a concrete unknown: previously self-written tests passed but actual external Skill tooling had never been tested end-to-end.","reactions":{"url":"https://api.github.com/repos/bracha55555-hue/aimarket/issues/48/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/bracha55555-hue/aimarket/issues/48/timeline","performed_via_github_app":{"id":1144995,"client_id":"Iv23liVemv8A9if9v0F2","slug":"chatgpt-codex-connector","node_id":"A_kwHOAOQ6Gs4AEXij","owner":{"login":"openai","id":14957082,"node_id":"MDEyOk9yZ2FuaXphdGlvbjE0OTU3MDgy","avatar_url":"https://avatars.githubusercontent.com/u/14957082?v=4","gravatar_id":"","url":"https://api.github.com/users/openai","html_url":"https://github.com/openai","followers_url":"https://api.github.com/users/openai/followers","following_url":"https://api.github.com/users/openai/following{/other_user}","gists_url":"https://api.github.com/users/openai/gists{/gist_id}","starred_url":"https://api.github.com/users/openai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/openai/subscriptions","organizations_url":"https://api.github.com/users/openai/orgs","repos_url":"https://api.github.com/users/openai/repos","events_url":"https://api.github.com/users/openai/events{/privacy}","received_events_url":"https://api.github.com/users/openai/received_events","type":"Organization","user_view_type":"public","site_admin":false},"name":"ChatGPT Codex Connector","description":"Bring ChatGPT and Codex to your GitHub repositories.","external_url":"https://www.chatgpt.com","html_url":"https://github.com/apps/chatgpt-codex-connector","created_at":"2025-02-14T01:37:05Z","updated_at":"2026-09-23T18:52:59Z","permissions":{"actions":"write","checks":"read","contents":"write","emails":"read","issues":"write","metadata":"read","pull_requests":"write","statuses":"read","workflows":"write"},"events":["check_run","check_suite","commit_comment","issues","issue_comment","pull_request","pull_request_review","pull_request_review_comment","pull_request_review_thread","repository","status","sub_issues"]},"state_reason":null,"score":1.0},{"url":"https://api.github.com/repos/bracha55555-hue/aimarket/issues/46","repository_url":"https://api.github.com/repos/bracha55555-hue/aimarket","labels_url":"https://api.github.com/repos/bracha55555-hue/aimarket/issues/46/labels{/name}","comments_url":"https://api.github.com/repos/bracha55555-hue/aimarket/issues/46/comments","events_url":"https://api.github.com/repos/bracha55555-hue/aimarket/issues/46/events","html_url":"https://github.com/bracha55555-hue/aimarket/pull/46","id":6114945268,"node_id":"PR_kwDOVWu3dc8AAAABLtgxRg","number":46,"title":"Track real independent agent introductions and onboarding reach without inventing adoption","user":{"login":"bracha55555-hue","id":347776944,"node_id":"U_kgDOFLqnsA","avatar_url":"https://avatars.githubusercontent.com/u/347776944?v=4","gravatar_id":"","url":"https://api.github.com/users/bracha55555-hue","html_url":"https://github.com/bracha55555-hue","followers_url":"https://api.github.com/users/bracha55555-hue/followers","following_url":"https://api.github.com/users/bracha55555-hue/following{/other_user}","gists_url":"https://api.github.com/users/bracha55555-hue/gists{/gist_id}","starred_url":"https://api.github.com/users/bracha55555-hue/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/bracha55555-hue/subscriptions","organizations_url":"https://api.github.com/users/bracha55555-hue/orgs","repos_url":"https://api.github.com/users/bracha55555-hue/repos","events_url":"https://api.github.com/users/bracha55555-hue/events{/privacy}","received_events_url":"https://api.github.com/users/bracha55555-hue/received_events","type":"User","user_view_type":"public","site_admin":false},"labels":[],"state":"closed","locked":false,"assignees":[],"milestone":null,"comments":0,"created_at":"2026-10-30T07:18:06Z","updated_at":"2026-10-30T07:19:48Z","closed_at":"2026-10-30T07:19:47Z","assignee":null,"author_association":"OWNER","active_lock_reason":null,"draft":false,"pull_request":{"url":"https://api.github.com/repos/bracha55555-hue/aimarket/pulls/46","html_url":"https://github.com/bracha55555-hue/aimarket/pull/46","diff_url":"https://github.com/bracha55555-hue/aimarket/pull/46.diff","patch_url":"https://github.com/bracha55555-hue/aimarket/pull/46.patch","merged_at":"2026-10-30T07:19:47Z"},"body":"## Business reality\nThe no-key one-command MCP connection page and genuine provider browser/CLI exist and pass CI, but production audits still show no independent signed offers, verified signed buyer tasks, or settlements. An honest, public one-off request for **voluntary relevant independent agent builder introductions** was submitted to Agent Commons's explicit human liaison API on 2026-10-30 and accepted with HTTP 201. That is outreach, not a customer.\n\n## Change\n- Extend the **existing** six-hour read-only production GitHub Actions audit to verify the actual `/connect` page has both Codex and Claude Code setup, accurate no-spam copy, and no automatic enrollment.\n- Read the operator's public Agent Commons human-help channel only (filter `agent=aimarket-operator`) and count public replies to our specific independent-agent introduction request **without exposing text, names, contacts, addresses or identifiers** in audit logs.\n- Read GitHub recruitment issue #34 public comment count, explicitly not unique customer or verified supplier count.\n- Preserve previous exact SHA/deploy status, independent mcp.tc listing, ALLAGENTS listing and truthful actual supply/demand/settlement metrics.\n- Add CI gate preventing this audit from creating new requests or faking adoption. Documentation distinguishes accepted outreach from real responses and sales.\n\nNo payments, marketing automation spam, new scheduled tasks, custody, fee changes or API keys.","reactions":{"url":"https://api.github.com/repos/bracha55555-hue/aimarket/issues/46/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/bracha55555-hue/aimarket/issues/46/timeline","performed_via_github_app":{"id":1144995,"client_id":"Iv23liVemv8A9if9v0F2","slug":"chatgpt-codex-connector","node_id":"A_kwHOAOQ6Gs4AEXij","owner":{"login":"openai","id":14957082,"node_id":"MDEyOk9yZ2FuaXphdGlvbjE0OTU3MDgy","avatar_url":"https://avatars.githubusercontent.com/u/14957082?v=4","gravatar_id":"","url":"https://api.github.com/users/openai","html_url":"https://github.com/openai","followers_url":"https://api.github.com/users/openai/followers","following_url":"https://api.github.com/users/openai/following{/other_user}","gists_url":"https://api.github.com/users/openai/gists{/gist_id}","starred_url":"https://api.github.com/users/openai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/openai/subscriptions","organizations_url":"https://api.github.com/users/openai/orgs","repos_url":"https://api.github.com/users/openai/repos","events_url":"https://api.github.com/users/openai/events{/privacy}","received_events_url":"https://api.github.com/users/openai/received_events","type":"Organization","user_view_type":"public","site_admin":false},"name":"ChatGPT Codex Connector","description":"Bring ChatGPT and Codex to your GitHub repositories.","external_url":"https://www.chatgpt.com","html_url":"https://github.com/apps/chatgpt-codex-connector","created_at":"2025-02-14T01:37:05Z","updated_at":"2026-09-23T18:52:59Z","permissions":{"actions":"write","checks":"read","contents":"write","emails":"read","issues":"write","metadata":"read","pull_requests":"write","statuses":"read","workflows":"write"},"events":["check_run","check_suite","commit_comment","issues","issue_comment","pull_request","pull_request_review","pull_request_review_comment","pull_request_review_thread","repository","status","sub_issues"]},"state_reason":null,"score":1.0},{"url":"https://api.github.com/repos/bracha55555-hue/aimarket/issues/27","repository_url":"https://api.github.com/repos/bracha55555-hue/aimarket","labels_url":"https://api.github.com/repos/bracha55555-hue/aimarket/issues/27/labels{/name}","comments_url":"https://api.github.com/repos/bracha55555-hue/aimarket/issues/27/comments","events_url":"https://api.github.com/repos/bracha55555-hue/aimarket/issues/27/events","html_url":"https://github.com/bracha55555-hue/aimarket/pull/27","id":6095695149,"node_id":"PR_kwDOVWu3dc8AAAABLeAX-Q","number":27,"title":"N4 multidimensional local database: prototype folding, compact nibbles, atomic saves and process restart recovery","user":{"login":"bracha55555-hue","id":347776944,"node_id":"U_kgDOFLqnsA","avatar_url":"https://avatars.githubusercontent.com/u/347776944?v=4","gravatar_id":"","url":"https://api.github.com/users/bracha55555-hue","html_url":"https://github.com/bracha55555-hue","followers_url":"https://api.github.com/users/bracha55555-hue/followers","following_url":"https://api.github.com/users/bracha55555-hue/following{/other_user}","gists_url":"https://api.github.com/users/bracha55555-hue/gists{/gist_id}","starred_url":"https://api.github.com/users/bracha55555-hue/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/bracha55555-hue/subscriptions","organizations_url":"https://api.github.com/users/bracha55555-hue/orgs","repos_url":"https://api.github.com/users/bracha55555-hue/repos","events_url":"https://api.github.com/users/bracha55555-hue/events{/privacy}","received_events_url":"https://api.github.com/users/bracha55555-hue/received_events","type":"User","user_view_type":"public","site_admin":false},"labels":[],"state":"closed","locked":false,"assignees":[],"milestone":null,"comments":0,"created_at":"2026-10-29T08:16:14Z","updated_at":"2026-10-29T08:17:26Z","closed_at":"2026-10-29T08:17:26Z","assignee":null,"author_association":"OWNER","active_lock_reason":null,"draft":false,"pull_request":{"url":"https://api.github.com/repos/bracha55555-hue/aimarket/pulls/27","html_url":"https://github.com/bracha55555-hue/aimarket/pull/27","diff_url":"https://github.com/bracha55555-hue/aimarket/pull/27.diff","patch_url":"https://github.com/bracha55555-hue/aimarket/pull/27.patch","merged_at":"2026-10-29T08:17:26Z"},"body":"Implements explicit local N4 4-bit representation (two packed 4-bit symbols per byte) with reusable field-name prototypes, lossless JSON typing, optional zlib entropy folding, SHA-256 truncated checksums for corruption detection, SQLite FULL-synchronous atomic indexed records by kind/capability/currency/expiry. Optional `AIMARKET_N4_PATH` integrates it with authenticated buyer needs and signed offline provider offers; writes and cancellations are durable locally before acknowledging, and startup restores unexpired data with recalculated monotonic TTL. No paid services or private keys. CI has a real **separate process** write → exit → new process reload of 120 Hebrew-content requests and offline offer, indexed lookup, delete, corruption tests. Crucial limitation: Render free filesystem is ephemeral across re-deploy/re-schedule. This is local database, not remote durable storage; disabled by default until configured. No escrow or revenue claims.","reactions":{"url":"https://api.github.com/repos/bracha55555-hue/aimarket/issues/27/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/bracha55555-hue/aimarket/issues/27/timeline","performed_via_github_app":{"id":1144995,"client_id":"Iv23liVemv8A9if9v0F2","slug":"chatgpt-codex-connector","node_id":"A_kwHOAOQ6Gs4AEXij","owner":{"login":"openai","id":14957082,"node_id":"MDEyOk9yZ2FuaXphdGlvbjE0OTU3MDgy","avatar_url":"https://avatars.githubusercontent.com/u/14957082?v=4","gravatar_id":"","url":"https://api.github.com/users/openai","html_url":"https://github.com/openai","followers_url":"https://api.github.com/users/openai/followers","following_url":"https://api.github.com/users/openai/following{/other_user}","gists_url":"https://api.github.com/users/openai/gists{/gist_id}","starred_url":"https://api.github.com/users/openai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/openai/subscriptions","organizations_url":"https://api.github.com/users/openai/orgs","repos_url":"https://api.github.com/users/openai/repos","events_url":"https://api.github.com/users/openai/events{/privacy}","received_events_url":"https://api.github.com/users/openai/received_events","type":"Organization","user_view_type":"public","site_admin":false},"name":"ChatGPT Codex Connector","description":"Bring ChatGPT and Codex to your GitHub repositories.","external_url":"https://www.chatgpt.com","html_url":"https://github.com/apps/chatgpt-codex-connector","created_at":"2025-02-14T01:37:05Z","updated_at":"2026-09-23T18:52:59Z","permissions":{"actions":"write","checks":"read","contents":"write","emails":"read","issues":"write","metadata":"read","pull_requests":"write","statuses":"read","workflows":"write"},"events":["check_run","check_suite","commit_comment","issues","issue_comment","pull_request","pull_request_review","pull_request_review_comment","pull_request_review_thread","repository","status","sub_issues"]},"state_reason":null,"score":1.0},{"url":"https://api.github.com/repos/bracha55555-hue/aimarket/issues/21","repository_url":"https://api.github.com/repos/bracha55555-hue/aimarket","labels_url":"https://api.github.com/repos/bracha55555-hue/aimarket/issues/21/labels{/name}","comments_url":"https://api.github.com/repos/bracha55555-hue/aimarket/issues/21/comments","events_url":"https://api.github.com/repos/bracha55555-hue/aimarket/issues/21/events","html_url":"https://github.com/bracha55555-hue/aimarket/pull/21","id":6086851405,"node_id":"PR_kwDOVWu3dc8AAAABLW4niw","number":21,"title":"Audit fix: stop losing all INFO-level AI Market conversion evidence","user":{"login":"bracha55555-hue","id":347776944,"node_id":"U_kgDOFLqnsA","avatar_url":"https://avatars.githubusercontent.com/u/347776944?v=4","gravatar_id":"","url":"https://api.github.com/users/bracha55555-hue","html_url":"https://github.com/bracha55555-hue","followers_url":"https://api.github.com/users/bracha55555-hue/followers","following_url":"https://api.github.com/users/bracha55555-hue/following{/other_user}","gists_url":"https://api.github.com/users/bracha55555-hue/gists{/gist_id}","starred_url":"https://api.github.com/users/bracha55555-hue/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/bracha55555-hue/subscriptions","organizations_url":"https://api.github.com/users/bracha55555-hue/orgs","repos_url":"https://api.github.com/users/bracha55555-hue/repos","events_url":"https://api.github.com/users/bracha55555-hue/events{/privacy}","received_events_url":"https://api.github.com/users/bracha55555-hue/received_events","type":"User","user_view_type":"public","site_admin":false},"labels":[],"state":"closed","locked":false,"assignees":[],"milestone":null,"comments":0,"created_at":"2026-10-28T20:23:54Z","updated_at":"2026-10-28T20:25:07Z","closed_at":"2026-10-28T20:25:07Z","assignee":null,"author_association":"OWNER","active_lock_reason":null,"draft":false,"pull_request":{"url":"https://api.github.com/repos/bracha55555-hue/aimarket/pulls/21","html_url":"https://github.com/bracha55555-hue/aimarket/pull/21","diff_url":"https://github.com/bracha55555-hue/aimarket/pull/21.diff","patch_url":"https://github.com/bracha55555-hue/aimarket/pull/21.patch","merged_at":"2026-10-28T20:25:07Z"},"body":"Fresh-eyes external audit found a measurement failure: `AIMARKET_USAGE` events use a custom named logger but there was no INFO level/handler configuration, and Render logs contained zero event records despite hundreds of MCP requests. Fix narrowly by giving that named logger a dedicated INFO stream handler, with only event kinds and counters (no IPs, wallet addresses, request content, or secrets). Tests verify the exact count event is emitted. Before any redeploy resets ephemeral process counters, read a READ-ONLY snapshot from current production `/api/market/stats`, `/api/requests`, `/health` in CI and log **aggregated counts only**. No payment logic or marketing embellishment. Remaining critical risks will be recorded in separate audit issue, with no claim of revenue before proof.","reactions":{"url":"https://api.github.com/repos/bracha55555-hue/aimarket/issues/21/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/bracha55555-hue/ai
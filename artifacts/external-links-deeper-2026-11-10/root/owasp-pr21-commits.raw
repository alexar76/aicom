[{"sha":"84af6b0b6b26dc9d2e3f9ca83cab177338bfdf5e","node_id":"C_kwDOVWS3k9oAKDg0YWY2YjBiNmIyNmRjOWQyZTNmOWNhODNjYWIxNzczMzhiZmRmNWU","commit":{"author":{"name":"intelligent-ears","email":"karyasdas2005@gmail.com","date":"2026-10-24T23:17:01Z"},"committer":{"name":"intelligent-ears","email":"karyasdas2005@gmail.com","date":"2026-11-10T14:35:34Z"},"message":"Add MCPSTG-SUPP-06: signed, publicly logged tool-manifest revisions\n\nLocal tool-manifest pins are trust-on-first-use: an unverified first contact, per-machine first use that allows targeted serving, and no evidence to tell a legitimate update from a rug pull. SUPP-06 tests whether a client or gateway requires a publisher signature, a transparency-log inclusion proof, and a served-vs-logged digest match before a privileged call.\n\nAdds a short 'Local pins are trust-on-first-use' subsection, a provenance table row, a drift bullet, a control matrix row, and SUPP-06 cross-references.","tree":{"sha":"ce83a44b1f394cbb0248cdfde64be774ac7ee120","url":"https://api.github.com/repos/OWASP/MCP-Security-Testing-Guide/git/trees/ce83a44b1f394cbb0248cdfde64be774ac7ee120"},"url":"https://api.github.com/repos/OWASP/MCP-Security-Testing-Guide/git/commits/84af6b0b6b26dc9d2e3f9ca83cab177338bfdf5e","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/OWASP/MCP-Security-Testing-Guide/commits/84af6b0b6b26dc9d2e3f9ca83cab177338bfdf5e","html_url":"https://github.com/OWASP/MCP-Security-Testing-Guide/commit/84af6b0b6b26dc9d2e3f9ca83cab177338bfdf5e","comments_url":"https://api.github.com/repos/OWASP/MCP-Security-Testing-Guide/commits/84af6b0b6b26dc9d2e3f9ca83cab177338bfdf5e/comments","author":{"login":"intelligent-ears","id":186805503,"node_id":"U_kgDOCyJs_w","avatar_url":"https://avatars.githubusercontent.com/u/186805503?v=4","gravatar_id":"","url":"https://api.github.com/users/intelligent-ears","html_url":"https://github.com/intelligent-ears","followers_url":"https://api.github.com/users/intelligent-ears/followers","following_url":"https://api.github.com/users/intelligent-ears/following{/other_user}","gists_url":"https://api.github.com/users/intelligent-ears/gists{/gist_id}","starred_url":"https://api.github.com/users/intelligent-ears/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/intelligent-ears/subscriptions","organizations_url":"https://api.github.com/users/intelligent-ears/orgs","repos_url":"https://api.github.com/users/intelligent-ears/repos","events_url":"https://api.github.com/users/intelligent-ears/events{/privacy}","received_events_url":"https://api.github.com/users/intelligent-ears/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"intelligent-ears","id":186805503,"node_id":"U_kgDOCyJs_w","avatar_url":"https://avatars.githubusercontent.com/u/186805503?v=4","gravatar_id":"","url":"https://api.github.com/users/intelligent-ears","html_url":"https://github.com/intelligent-ears","followers_url":"https://api.github.com/users/intelligent-ears/followers","following_url":"https://api.github.com/users/intelligent-ears/following{/other_user}","gists_url":"https://api.github.com/users/intelligent-ears/gists{/gist_id}","starred_url":"https://api.github.com/users/intelligent-ears/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/intelligent-ears/subscriptions","organizations_url":"https://api.github.com/users/intelligent-ears/orgs","repos_url":"https://api.github.com/users/intelligent-ears/repos","events_url":"https://api.github.com/users/intelligent-ears/events{/privacy}","received_events_url":"https://api.github.com/users/intelligent-ears/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"d87eadceaf8473084fb27838fe3dddb7232c337b","url":"https://api.github.com/repos/OWASP/MCP-Security-Testing-Guide/commits/d87eadceaf8473084fb27838fe3dddb7232c337b","html_url":"https://github.com/OWASP/MCP-Security-Testing-Guide/commit/d87eadceaf8473084fb27838fe3dddb7232c337b"}]},{"sha":"c53daf23b3db30b0d7601dae5aa9abc648c37db9","node_id":"C_kwDOVWS3k9oAKGM1M2RhZjIzYjNkYjMwYjBkNzYwMWRhZTVhYTlhYmM2NDhjMzdkYjk","commit":{"author":{"name":"intelligent-ears","email":"karyasdas2005@gmail.com","date":"2026-10-24T23:17:01Z"},"committer":{"name":"intelligent-ears","email":"karyasdas2005@gmail.com","date":"2026-11-10T14:35:34Z"},"message":"Update test count to 80 and add SUPP-06 fixtures and tool category\n\nBumps the test count in README, the chapter 3 overview, and test-case-format. Adds the SUPP-06 placeholders to Appendix D and a transparency-log client category to Appendix F.","tree":{"sha":"b15ed9248794500b630bc6a0cda60ead1d226c7e","url":"https://api.github.com/repos/OWASP/MCP-Security-Testing-Guide/git/trees/b15ed9248794500b630bc6a0cda60ead1d226c7e"},"url":"https://api.github.com/repos/OWASP/MCP-Security-Testing-Guide/git/commits/c53daf23b3db30b0d7601dae5aa9abc648c37db9","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/OWASP/MCP-Security-Testing-Guide/commits/c53daf23b3db30b0d7601dae5aa9abc648c37db9","html_url":"https://github.com/OWASP/MCP-Security-Testing-Guide/commit/c53daf23b3db30b0d7601dae5aa9abc648c37db9","comments_url":"https://api.github.com/repos/OWASP/MCP-Security-Testing-Guide/commits/c53daf23b3db30b0d7601dae5aa9abc648c37db9/comments","author":{"login":"intelligent-ears","id":186805503,"node_id":"U_kgDOCyJs_w","avatar_url":"https://avatars.githubusercontent.com/u/186805503?v=4","gravatar_id":"","url":"https://api.github.com/users/intelligent-ears","html_url":"https://github.com/intelligent-ears","followers_url":"https://api.github.com/users/intelligent-ears/followers","following_url":"https://api.github.com/users/intelligent-ears/following{/other_user}","gists_url":"https://api.github.com/users/intelligent-ears/gists{/gist_id}","starred_url":"https://api.github.com/users/intelligent-ears/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/intelligent-ears/subscriptions","organizations_url":"https://api.github.com/users/intelligent-ears/orgs","repos_url":"https://api.github.com/users/intelligent-ears/repos","events_url":"https://api.github.com/users/intelligent-ears/events{/privacy}","received_events_url":"https://api.github.com/users/intelligent-ears/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"intelligent-ears","id":186805503,"node_id":"U_kgDOCyJs_w","avatar_url":"https://avatars.githubusercontent.com/u/186805503?v=4","gravatar_id":"","url":"https://api.github.com/users/intelligent-ears","html_url":"https://github.com/intelligent-ears","followers_url":"https://api.github.com/users/intelligent-ears/followers","following_url":"https://api.github.com/users/intelligent-ears/following{/other_user}","gists_url":"https://api.github.com/users/intelligent-ears/gists{/gist_id}","starred_url":"https://api.github.com/users/intelligent-ears/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/intelligent-ears/subscriptions","organizations_url":"https://api.github.com/users/intelligent-ears/orgs","repos_url":"https://api.github.com/users/intelligent-ears/repos","events_url":"https://api.github.com/users/intelligent-ears/events{/privacy}","received_events_url":"https://api.github.com/users/intelligent-ears/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"84af6b0b6b26dc9d2e3f9ca83cab177338bfdf5e","url":"https://api.github.com/repos/OWASP/MCP-Security-Testing-Guide/commits/84af6b0b6b26dc9d2e3f9ca83cab177338bfdf5e","html_url":"https://github.com/OWASP/MCP-Security-Testing-Guide/commit/84af6b0b6b26dc9d2e3f9ca83cab177338bfdf5e"}]},{"sha":"5c0a06680dc50d82777e75de47696d3fc549d565","node_id":"C_kwDOVWS3k9oAKDVjMGEwNjY4MGRjNTBkODI3NzdlNzVkZTQ3Njk2ZDNmYzU0OWQ1NjU","commit":{"author":{"name":"intelligent-ears","email":"karyasdas2005@gmail.com","date":"2026-10-25T15:58:07Z"},"committer":{"name":"intelligent-ears","email":"karyasdas2005@gmail.com","date":"2026-11-10T14:35:34Z"},"message":"SUPP-06: address review — Not tested verdict, Medium severity, SEP-3140 wording\n\nRecord clients without a manifest verifier as Not tested, make case (b) the positive-control gate, limit Insecure to clients that claim verification and accept a bad envelope, lower severity to Medium, fix the control-matrix row, and date the SEP-3140 close.","tree":{"sha":"29a70cf40080e7badc4def6c25f8adad7722227d","url":"https://api.github.com/repos/OWASP/MCP-Security-Testing-Guide/git/trees/29a70cf40080e7badc4def6c25f8adad7722227d"},"url":"https://api.github.com/repos/OWASP/MCP-Security-Testing-Guide/git/commits/5c0a06680dc50d82777e75de47696d3fc549d565","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/OWASP/MCP-Security-Testing-Guide/commits/5c0a06680dc50d82777e75de47696d3fc549d565","html_url":"https://github.com/OWASP/MCP-Security-Testing-Guide/commit/5c0a06680dc50d82777e75de47696d3fc549d565","comments_url":"https://api.github.com/repos/OWASP/MCP-Security-Testing-Guide/commits/5c0a06680dc50d82777e75de47696d3fc549d565/comments","author":{"login":"intelligent-ears","id":186805503,"node_id":"U_kgDOCyJs_w","avatar_url":"https://avatars.githubusercontent.com/u/186805503?v=4","gravatar_id":"","url":"https://api.github.com/users/intelligent-ears","html_url":"https://github.com/intelligent-ears","followers_url":"https://api.github.com/users/intelligent-ears/followers","following_url":"https://api.github.com/users/intelligent-ears/following{/other_user}","gists_url":"https://api.github.com/users/intelligent-ears/gists{/gist_id}","starred_url":"https://api.github.com/users/intelligent-ears/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/intelligent-ears/subscriptions","organizations_url":"https://api.github.com/users/intelligent-ears/orgs","repos_url":"https://api.github.com/users/intelligent-ears/repos","events_url":"https://api.github.com/users/intelligent-ears/events{/privacy}","received_events_url":"https://api.github.com/users/intelligent-ears/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"intelligent-ears","id":186805503,"node_id":"U_kgDOCyJs_w","avatar_url":"https://avatars.githubusercontent.com/u/186805503?v=4","gravatar_id":"","url":"https://api.github.com/users/intelligent-ears","html_url":"https://github.com/intelligent-ears","followers_url":"https://api.github.com/users/intelligent-ears/followers","following_url":"https://api.github.com/users/intelligent-ears/following{/other_user}","gists_url":"https://api.github.com/users/intelligent-ears/gists{/gist_id}","starred_url":"https://api.github.com/users/intelligent-ears/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/intelligent-ears/subscriptions","organizations_url":"https://api.github.com/users/intelligent-ears/orgs","repos_url":"https://api.github.com/users/intelligent-ears/repos","events_url":"https://api.github.com/users/intelligent-ears/events{/privacy}","received_events_url":"https://api.github.com/users/intelligent-ears/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"c53daf23b3db30b0d7601dae5aa9abc648c37db9","url":"https://api.github.com/repos/OWASP/MCP-Security-Testing-Guide/commits/c53daf23b3db30b0d7601dae5aa9abc648c37db9","html_url":"https://github.com/OWASP/MCP-Security-Testing-Guide/commit/c53daf23b3db30b0d7601dae5aa9abc648c37db9"}]},{"sha":"a4722f7e31e90b732c56ae1df104d9cccffe2b15","node_id":"C_kwDOVWS3k9oAKGE0NzIyZjdlMzFlOTBiNzMyYzU2YWUxZGYxMDRkOWNjY2ZmZTJiMTU","commit":{"author":{"name":"intelligent-ears","email":"karyasdas2005@gmail.com","date":"2026-11-10T14:37:32Z"},"committer":{"name":"intelligent-ears","email":"karyasdas2005@gmail.com","date":"2026-11-10T14:37:32Z"},"message":"SUPP-06: grade hash-and-ask baseline Secure; Not tested per #52\n\nA client with no verifier that stores the manifest hash and stops to ask on change is graded Secure against the What to snapshot baseline. Insecure is limited to a client that claims to verify and accepts a bad envelope. A client with neither control is Not tested, using the label defined in test-case-format.md by #52.","tree":{"sha":"47d0b75bf7e3178efeda6f78c6dc7735c9eee211","url":"https://api.github.com/repos/OWASP/MCP-Security-Testing-Guide/git/trees/47d0b75bf7e3178efeda6f78c6dc7735c9eee211"},"url":"https://api.github.com/repos/OWASP/MCP-Security-Testing-Guide/git/commits/a4722f7e31e90b732c56ae1df104d9cccffe2b15","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/OWASP/MCP-Security-Testing-Guide/commits/a4722f7e31e90b732c56ae1df104d9cccffe2b15","html_url":"https://github.com/OWASP/MCP-Security-Testing-Guide/commit/a4722f7e31e90b732c56ae1df104d9cccffe2b15","comments_url":"https://api.github.com/repos/OWASP/MCP-Security-Testing-Guide/commits/a4722f7e31e90b732c56ae1df104d9cccffe2b15/comments","author":{"login":"intelligent-ears","id":186805503,"node_id":"U_kgDOCyJs_w","avatar_url":"https://avatars.githubusercontent.com/u/186805503?v=4","gravatar_id":"","url":"https://api.github.com/users/intelligent-ears","html_url":"https://github.com/intelligent-ears","followers_url":"https://api.github.com/users/intelligent-ears/followers","following_url":"https://api.github.com/users/intelligent-ears/following{/other_user}","gists_url":"https://api.github.com/users/intelligent-ears/gists{/gist_id}","starred_url":"https://api.github.com/users/intelligent-ears/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/intelligent-ears/subscriptions","organizations_url":"https://api.github.com/users/in
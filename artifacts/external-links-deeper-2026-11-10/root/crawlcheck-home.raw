<script nonce=xsZOqyF5u1nco4qjaQbtNQ>/* cspfix1: inline on*= handlers are blocked by the enforced nonce policy; these three behaviours live here instead */document.addEventListener('submit',function(e){var f=e.target&&e.target.closest?e.target.closest('form[data-confirm]'):null;if(f&&!window.confirm(f.getAttribute('data-confirm')))e.preventDefault();},true);document.addEventListener('click',function(e){var t=e.target&&e.target.closest?e.target:null;if(!t)return;var a=t.closest('[data-focus-scan]');if(a){var d=document.getElementById('domain')||document.getElementById('lcIn');if(d){d.focus();e.preventDefault();}}var s=t.closest('[data-select]');if(s&&s.select)s.select();});</script><script nonce=xsZOqyF5u1nco4qjaQbtNQ>(function(){function init(){var m=document.querySelector('.mn__m');if(m){m.addEventListener('toggle',function(){if(m.open){document.querySelectorAll('.mn__d').forEach(function(d){d.open=true;});}});}
var ds=document.querySelectorAll('.mn__d');ds.forEach(function(d){d.addEventListener('toggle',function(){if(d.open&&window.innerWidth>720){ds.forEach(function(o){if(o!==d)o.open=false;});}});});var hv=window.matchMedia&&window.matchMedia('(hover:hover) and (pointer:fine)').matches;if(hv){ds.forEach(function(d){var t=null;d.addEventListener('mouseenter',function(){if(window.innerWidth<=720)return;clearTimeout(t);d.open=true;});d.addEventListener('mouseleave',function(){if(window.innerWidth<=720)return;t=setTimeout(function(){d.open=false;},180);});d.querySelector('summary').addEventListener('click',function(e){if(window.innerWidth>720&&d.open&&e.detail>0){e.preventDefault();}});});}
document.addEventListener('keydown',function(e){if(e.key==='Escape'){ds.forEach(function(o){o.open=false;});if(m)m.open=false;}});
document.addEventListener('click',function(e){if(window.innerWidth>720&&!e.target.closest('.mn__d')){ds.forEach(function(o){o.open=false;});}});}
if(document.readyState==='loading'){document.addEventListener('DOMContentLoaded',init);}else{init();}
})();(function(){
  var r=document.documentElement, KEY="cc-theme";
  var saved=null; try{saved=localStorage.getItem(KEY)}catch(e){}
  if(saved==="dark"||saved==="light") r.setAttribute("data-theme",saved);
  function cur(){var a=r.getAttribute("data-theme");if(a)return a;
    return window.matchMedia&&matchMedia("(prefers-color-scheme:dark)").matches?"dark":"light";}
  var SUN='<svg aria-hidden="true" focusable="false" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="12" cy="12" r="4.5"/><path d="M12 1.5v2M12 20.5v2M4.2 4.2l1.4 1.4M18.4 18.4l1.4 1.4M1.5 12h2M20.5 12h2M4.2 19.8l1.4-1.4M18.4 5.6l1.4-1.4"/></svg>';
  var MOON='<svg aria-hidden="true" focusable="false" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"/></svg>';
  function paint(b){var d=cur()==="dark";b.innerHTML=d?SUN:MOON;
    b.setAttribute("aria-label","Switch to "+(d?"light":"dark")+" theme");}
  function mount(){
    var nav=document.querySelector(".masthead nav");if(!nav||nav.querySelector(".themeswap"))return;
    var b=document.createElement("button");b.type="button";b.className="themeswap";paint(b);
    b.addEventListener("click",function(){var n=cur()==="dark"?"light":"dark";
      r.setAttribute("data-theme",n);try{localStorage.setItem(KEY,n)}catch(e){}paint(b);});
    nav.appendChild(b);
  }
  function reveal(){
    if(!("IntersectionObserver" in window))return;
    var els=document.querySelectorAll(".cap,.stage,.plan,.tool,.see__i,.stat,.hc,.tile,.fixc");
    if(!els.length)return;
    var o=new IntersectionObserver(function(es){es.forEach(function(e){
      if(e.isIntersecting){e.target.classList.add("is-in");o.unobserve(e.target);}});},
      {threshold:.08,rootMargin:"0px 0px -30px 0px"});
    els.forEach(function(e){e.classList.add("ccrev");o.observe(e);});
  }
  if(document.readyState==="loading")document.addEventListener("DOMContentLoaded",function(){mount();reveal();});
  else{mount();reveal();}
})();
</script>

:block;margin:2px 0")}).join("")}).join("")+'</div>'}b.innerHTML=s;b.firstChild.addEventListener("click",function(ev){ev.stopPropagation();S.setItem("ccmenu",open?"0":"1");draw(r)});document.body.appendChild(b);if(open){var f=function(ev){if(!b.contains(ev.target)){document.removeEventListener("click",f);document.removeEventListener("keydown",k);S.setItem("ccmenu","0");draw(r)}};var k=function(ev){if(ev.key==="Escape"){document.removeEventListener("click",f);document.removeEventListener("keydown",k);S.setItem("ccmenu","0");draw(r)}};setTimeout(function(){document.addEventListener("click",f);document.addEventListener("keydown",k)},0)}}var c=null;try{c=JSON.parse(S.getItem("ccrole3")||"null")}catch(e){c=null}if(c&&c.r)draw(c.r);if(c&&c.r===null&&Date.now()-c.at<600000)return;fetch("/api/owner/me",{credentials:"same-origin",cache:"no-store"}).then(function(x){return x.json()}).then(function(r){var v=r&&r.role?{role:r.role,name:r.name||"",links:r.links||[]}:null;S.setItem("ccrole3",JSON.stringify({at:Date.now(),r:v}));if(JSON.stringify(v)!==JSON.stringify(c&&c.r))draw(v)}).catch(function(){})}catch(e){}})();</script>

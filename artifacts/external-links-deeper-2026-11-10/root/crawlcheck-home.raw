<title>CrawlCheck — Can AI read your site? Free check</title>
<meta name="description" content="See what ChatGPT, Claude, Perplexity and Google actually get from your site. Free A–F grade, every problem named, nothing installed.">
<link rel="canonical" href="https://crawlcheck.io/"><meta property="og:type" content="website"><meta property="og:site_name" content="CrawlCheck"><meta property="og:title" content="CrawlCheck — Can AI read your site? Free check"><meta property="og:description" content="See what ChatGPT, Claude, Perplexity and Google actually get from your site. Free A–F grade, every problem named, nothing installed."><meta property="og:url" content="https://crawlcheck.io/"><meta property="og:image" content="https://crawlcheck.io/og.png"><meta property="og:image:width" content="1200"><meta property="og:image:height" content="630"><meta property="og:image:alt" content="CrawlCheck — the verification layer for the agentic web"><meta name="twitter:card" content="summary_large_image"><meta name="twitter:image" content="https://crawlcheck.io/og.png"><meta name="twitter:title" content="CrawlCheck — Can AI read your site? Free check"><meta name="twitter:description" content="See what ChatGPT, Claude, Perplexity and Google actually get from your site. Free A–F grade, every problem named, nothing installed."><meta name="theme-color" content="#171310"><link rel="ard" href="/.well-known/ard.json"><link rel="icon" type="image/svg+xml" href="/favicon.svg" media="(prefers-color-scheme: light)"><link rel="icon" type="image/svg+xml" href="/favicon-dark.svg" media="(prefers-color-scheme: dark)"><link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png"><link rel="icon" type="image/png" sizes="16x16" href="/favicon-16.png"><link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png"><link rel="alternate" type="application/feed+json" href="/feed.json" title="CrawlCheck findings and guides (JSON Feed)"><link rel="alternate" type="application/atom+xml" href="/feed.xml" title="CrawlCheck findings and guides (Atom)"><link rel="alternate" type="text/plain" href="/llms.txt" title="llms.txt"><link rel="alternate" type="application/json" href="/entitymap.json" title="entitymap.json"><link rel="alternate" type="text/markdown" href="/agents.md" title="agents.md"><link rel="alternate" type="application/ld+json" href="/.well-known/media-kit.json" title="Media kit"><link rel="sitemap" type="application/xml" href="/sitemap.xml"><link rel="entitymap" type="application/json" href="/entitymap.json"><script type="application/ld+json">{"@context":"https://schema.org","@graph":[{"@type":"WebSite","@id":"https://crawlcheck.io/#website","url":"https://crawlcheck.io/","name":"CrawlCheck","description":"See what ChatGPT, Claude, Perplexity and Google actually get from your site. Free A–F grade, every problem named, nothing installed.","inLanguage":"en","publisher":{"@id":"https://crawlcheck.io/#org"}},{"@type":"SoftwareApplication","@id":"https://crawlcheck.io/#app","name":"CrawlCheck","applicationCategory":"DeveloperApplication","operatingSystem":"Any","sameAs":["https://github.com/emmanuelorta/crawlcheck-core","https://chromewebstore.google.com/detail/plgjengobhbdmbgckiiaaflgiepdbcpi","https://www.npmjs.com/package/@crawlcheck/sdk","https://pypi.org/project/crawlcheck/","https://huggingface.co/crawlcheck","https://www.crunchbase.com/organization/crawlcheck","https://alternativeto.net/software/crawlcheck/","https://www.g2.com/products/crawlcheck/reviews","https://www.youtube.com/@crawlcheck"],"installUrl":"https://chromewebstore.google.com/detail/plgjengobhbdmbgckiiaaflgiepdbcpi","datePublished":"2026-08-12","publisher":{"@id":"https://crawlcheck.io/#org"},"disambiguatingDescription":"CrawlCheck at crawlcheck.io by VSNARY (Emmanuel Orta), in operation since 2026-08-12 with a Bitcoin-anchored record for every day at crawlcheck.io/proof. Not affiliated with any other site using the CrawlCheck name, and not CrawlerCheck (crawlercheck.com), a separate tool.","url":"https://crawlcheck.io/","description":"See what ChatGPT, Claude, Perplexity and Google actually get from your site. Free A–F grade, every problem named, nothing installed.","author":{"@id":"https://crawlcheck.io/#org"},"softwareHelp":{"@type":"CreativeWork","@id":"https://crawlcheck.io/docs/api#help","url":"https://crawlcheck.io/docs/api"},"applicationSubCategory":"Web verification for AI agents","isAccessibleForFree":true,"mentions":[{"@type":"Thing","@id":"https://www.wikidata.org/wiki/Q115564437","name":"ChatGPT","sameAs":"https://www.wikidata.org/wiki/Q115564437"}],"keywords":"agentic web, AI agent verification, signed decision receipt, Resolve protocol, MCP tool lockfile, AI visibility, AI crawler audit, GPTBot, ClaudeBot, PerplexityBot, Googlebot, robots.txt, llms.txt, entity graph, GEO, AEO, crawler verification","audience":{"@type":"Audience","@id":"https://crawlcheck.io/#audience","audienceType":"AI agent builders, developers, agencies, website owners and local service businesses"},"featureList":["Fetches the homepage as each named AI and search crawler and compares what each one was served","Reads robots.txt, llms.txt, sitemap.xml, sitemap_index.xml and entitymap.json on both apex and www hosts by status, content type and body","Resolves what robots.txt permits for 115 named AI, search, training, regional, social and SEO agents","Scores structured data as an entity graph and checks name, phone, address and claims against the visible page","Fetches every declared directory and profile listing and checks it still carries the business number","Grades A–F with an AI visibility score and 26 scored sections; the ranked fix list with remediation text and evidence bytes is licensed","Verifies crawler traffic in access logs against operator-published IP ranges","Keeps a dated record per domain, measures twice a day, and anchors daily report hashes to Bitcoin","Checks a YouTube video, a whole channel and a site’s own video pages on the metadata a search result can anchor to","Reports HSTS, webmaster verification tags and client-side rendering dependency from the delivered bytes","What each crawler gets: Each named crawler fetched the page; this is whether they all got the same thing","Crawler permissions: What robots.txt actually tells each named AI and search crawler it may do","Machine-file chain: robots.txt names the sitemap, llms.txt points onward, the entity graph points home: the chain a crawler follows","Speed: How fast the page answered our fetch, plus real-visitor field data where Google has it","Server \u0026 hosting: What the edge and origin told us: cache state, compression, the software behind the page","Internal links: Anchors carry words, targets resolve, and the link graph is not mostly repeats","Mobile: Viewport, zoom, icons and manifest: whether a phone gets a page it can use","Exposed files and secrets: Backups, environment files, repository folders, debug logs and keys reachable on the live host","Page weight \u0026 text: How many of the delivered bytes are readable words, and how much is markup, scripts and styling","Machine files: robots.txt, llms.txt, sitemap and the entity graph: present, readable and served as the right type","Sitemap: A sitemap exists, resolves, and declares the pages the homepage links to","Crawl waste: Fetches that produce no new page: parameter and case variants, http links, redirecting or gone declared URLs, canonical-elsewhere and noindex pages","Accessibility structure: Language, alt text, labelled controls and one main landmark, read from the delivered HTML","Image signals: Alt text, declared dimensions, lazy-loading, modern formats, hero priority and the entity image in JSON-LD.","Instructions for agents: Text aimed at AI agents rather than people: present, visible, and not hidden","URL naming: Lowercase hosts and paths, no case-only duplicates, machine files spelt correctly","Error pages: A missing page answers 404 with a real page, not a 200 soft 404 or a blank; the error page is not a dead end","Structured data: The JSON-LD entity graph: stable @ids, connected nodes, credentials and locations declared","Local presence \u0026 NAP: Street address, coordinates, hours, phone, and the directory listings the site itself declares","Claim consistency: Name, phone, city and years-in-business match between the structured data and the visible page","Authors \u0026 trust signals: Named people, dated articles, an organisation with contact details: the proxies an engine uses for trust","Linked data: Whether the structured data parses as proper RDF and nothing dangles","Quotable content: Whether the sentences an answer engine would lift are on the page in a form it can take: a defining lead, short factual paragraphs, answered questions, few first-person openers","Entity corroboration: Whether the identity links the site declares point back at it, and whether a Wikidata record names this domain","Page subject: Which business entity the page is about and how every other business entity on it is related: chain, subsidiary, department, or undeclared","Commerce surface: Product, offer and checkout signals an agent could act on","Agent surfaces: Emerging standards (agents.md, API catalog, MCP card). Measured for information only","Content entities: Named things in the page text that a knowledge graph recognises. Measured, not scored","Verified crawler traffic: What verified AI and search crawlers actually fetched from this zone in the last seven days, counted by Cloudflare at the edge. Outcome data, not scored","Crawlers on your server: Which AI and search crawlers actually reached the origin, from the site’s own access log posted under the licence, each address verified against the operator’s published range. The outcome, not scored","Service area map: Every place the schema declares, placed on one map around the declared centre and radius: which have a page, which fall outside the circle. Measured, not scored","Whole site: Up to 60 declared pages, read once a day after a scan: not-200s, thin and mostly-code pages, missing JSON-LD, canonical elsewhere, noindex, missing or duplicate h1, orphans, undeclared pages, duplicate titles, and the median words, text share and response time across them. Every count is free; Watch names which pages. Measured, not scored","Freshness: Every date the site publishes about itself: sitemap lastmod, Last-Modified, dateModified, dated elements, and where they disagree. Measured, not scored","Local intents: Which Google Maps intent types the site names about itself, and which of those have a page the homepage links to. Measured, not scored","What AI looks for: The facts an AI model weighs when it picks a business, ordered by how far each moved its ranking in CrawlCheck's tests, and whether the homepage shows each one. Measured, not scored","Trust and reputation: Red flags an agent should check before it cites or calls a business: the phone number in FTC unwanted-call complaints, malware or phishing listing, domain age and registration, parked or for-sale pages and redirects to another organisation. Measured, not scored.","Site safety: Malware or phishing listing, HTTPS and certificate, each security header graded, forms and where they send data, cookies, the http:// redirect, libraries with published advisories, sampled login, contact and checkout pages, changes since the last read, insecure resources, exposed versions, email forgery protection and domain registration. Measured, not scored.","Review integrity: The rating, review count and reviews the markup declares are the ones a visitor sees. Measured, not scored","AI rights and consent: What the site declares AI may do with its pages, per use, which signal decided it, and where signals disagree. Measured, not scored","Price transparency: Whether the page states what the work costs, in text and in markup, and whether the two agree. Measured, not scored","Third-party dependencies: Every outside host the page loads, grouped, and the ones that hold the page until they answer. Measured, not scored","Language and region: Declared language, hreflang alternates and the region the page serves. Measured, not scored","Where AI already cites this site: Answer-engine arrivals and citations this site has already received. Measured, not scored","Listings consistency: Name, address and phone as the major directories list them, against what the site declares. Measured, not scored","Claims and their evidence: Each fact the site states about itself beside every outside source that confirms or contradicts it. Measured, not scored.","Conversion path: Phone link, form and call-to-action on the page, and whether they sit before the fold. Measured, not scored","Engagement: First-party views, active time, scroll depth and taps from the site’s own beacon. Measured, not scored","Entity map parity: The JSON entity map and the HTML version agree with each other. Measured, not scored"],"offers":[{"@type":"Offer","name":"Free scan","price":"0","priceCurrency":"USD","url":"https://crawlcheck.io/","description":"Scan any domain and read the full report."},{"@type":"AggregateOffer","name":"Plans billed monthly","url":"https://crawlcheck.io/pricing","priceCurrency":"USD","lowPrice":"29","highPrice":"499","offerCount":4},{"@type":"AggregateOffer","name":"Plans billed annually (ten months)","url":"https://crawlcheck.io/pricing","priceCurrency":"USD","lowPrice":"290","highPrice":"2490","offerCount":2},{"@type":"Offer","name":"Fix list implemented, one local-business site","price":"100","priceCurrency":"USD","url":"https://crawlcheck.io/pricing#fix","description":"One-time. The findings in the site's own report corrected, re-measured, with a sealed before and after."}]},{"@type":"Organization","@id":"https://crawlcheck.io/#org","name":"CrawlCheck","url":"https://crawlcheck.io/","description":"See what ChatGPT, Claude, Perplexity and Google actually get from your site. Free A–F grade, every problem named, nothing installed.","sameAs":["https://github.com/emmanuelorta/crawlcheck-core","https://chromewebstore.google.com/detail/plgjengobhbdmbgckiiaaflgiepdbcpi","https://www.npmjs.com/package/@crawlcheck/sdk","https://pypi.org/project/crawlcheck/","https://huggingface.co/crawlcheck","https://www.crunchbase.com/organization/crawlcheck","https://alternativeto.net/software/crawlcheck/","https://www.g2.com/products/crawlcheck/reviews","https://www.youtube.com/@crawlcheck"],"founder":{"@id":"https://emmanuelorta.com/#person"},"foundingDate":"2026-08-07","disambiguatingDescription":"CrawlCheck at crawlcheck.io, founded 2026-08-07 by Emmanuel Orta (VSNARY). Not affiliated with any other site using the CrawlCheck name, and not CrawlerCheck (crawlercheck.com), a separate tool.","email":"hello@crawlcheck.io","logo":{"@type":"ImageObject","@id":"https://crawlcheck.io/#logo","url":"https://crawlcheck.io/crawlcheck-mark-512.png","contentUrl":"https://crawlcheck.io/crawlcheck-mark-512.png","width":512,"height":512},"publishingPrinciples":"https://crawlcheck.io/policy","knowsAbout":[{"@id":"https://crawlcheck.io/glossary#ai-visibility-score"},{"@id":"https://crawlcheck.io/glossary#machine-layer"},{"@id":"https://crawlcheck.io/glossary#llms-txt"},{"@id":"https://crawlcheck.io/glossary#structured-data"},{"@id":"https://crawlcheck.io/glossary#verified-crawler"},{"@id":"https://crawlcheck.io/glossary#e-e-a-t-proxies"}],"contactPoint":{"@type":"ContactPoint","contactType":"customer support","email":"hello@crawlcheck.io","url":"https://crawlcheck.io/policy"}},{"@type":"Person","@id":"https://emmanuelorta.com/#person","name":"Emmanuel Orta","alternateName":"VSNARY","url":"https://crawlcheck.io/author","jobTitle":"Founder","image":{"@type":"ImageObject","url":"https://crawlcheck.io/img/emmanuel-orta.jpg","contentUrl":"https://crawlcheck.io/img/emmanuel-orta.jpg","width":480,"height":480,"caption":"Emmanuel Orta (VSNARY)"},"worksFor":{"@id":"https://crawlcheck.io/#org"},"knowsAbout":["AI crawler access and robots.txt policy","Structured data and entity graphs (JSON-LD, RDF)","Local business search visibility"],"subjectOf":{"@type":"ImageObject","@id":"https://commons.wikimedia.org/wiki/File:Gonatodes_daudini_hatchling_(captive-bred,_Terrarium_Station).jpg","url":"https://commons.wikimedia.org/wiki/File:Gonatodes_daudini_hatchling_(captive-bred,_Terrarium_Station).jpg","contentUrl":"https://commons.wikimedia.org/wiki/Special:FilePath/Gonatodes_daudini_hatchling_(captive-bred,_Terrarium_Station).jpg","name":"Gonatodes daudini hatchling, captive-bred","creator":{"@id":"https://emmanuelorta.com/#person"},"copyrightHolder":{"@id":"https://emmanuelorta.com/#person"},"license":"https://creativecommons.org/licenses/by/4.0/","acquireLicensePage":"https://commons.wikimedia.org/wiki/File:Gonatodes_daudini_hatchling_(captive-bred,_Terrarium_Station).jpg","copyrightNotice":"© Emmanuel Orta. Licensed CC BY 4.0.","creditText":"Emmanuel Orta (Vsnary on Wikimedia Commons), CC BY 4.0","datePublished":"2026-09-09","about":{"@id":"https://www.wikidata.org/wiki/Q3110413"},"description":"As of 9 September 2026, no other photograph of a hatchling or juvenile of this species was recorded on Wikimedia Commons, Wikidata, iNaturalist or GBIF."},"description":"Emmanuel Orta, whose creator name is VSNARY. Builds CrawlCheck and writes its findings posts from CrawlCheck’s own measurements.","sameAs":["https://crawlcheck.io/author","https://github.com/emmanuelorta","https://commons.wikimedia.org/wiki/User:Vsnary","https://www.facebook.com/VSNARY","https://www.linkedin.com/in/emmanuelorta","https://www.instagram.com/emmanuel_orta/","https://coldblooded.com/VSNARY","https://www.tiktok.com/@vsnaryemmanuelorta","https://www.crunchbase.com/person/emmanuel-orta-aff6","https://www.producthunt.com/@emmanuel_orta","https://www.quora.com/profile/VSNARY","https://substack.com/@vsnary","https://orcid.org/0009-0001-5269-1515","https://www.youtube.com/@emmanuelorta","https://www.threads.com/@emmanuel_orta","https://medium.com/@crawlcheck","https://gravatar.com/emmanuelorta"]},{"@type":"BreadcrumbList","@id":"https://crawlcheck.io/#crumbs","itemListElement":[{"@type":"ListItem","position":1,"name":"Home","item":"https://crawlcheck.io/"}]},{"@type":"FAQPage","@id":"https://crawlcheck.io/#faq","mainEntity":[{"@type":"Question","name":"Can ChatGPT read my website?","acceptedAnswer":{"@type":"Answer","text":"ChatGPT reaches the web through more than one crawler: OAI-SearchBot finds pages for ChatGPT search, and GPTBot collects content for model training. Allowing GPTBot is not needed to appear in ChatGPT search, and blocking it does not remove you. Many sites block one or both in robots.txt or behind a bot wall without knowing. That is the access we can test, not the only way an AI service may reach your content. The free check fetches your homepage as OAI-SearchBot, GPTBot and fourteen other crawlers from our own network and shows exactly what each one got."}},{"@type":"Question","name":"Why doesn’t my business show up in AI answers?","acceptedAnswer":{"@type":"Answer","text":"Three usual reasons: the crawler is blocked, the page it gets has no readable text, or there is no clear fact to quote: a name, address, hours and prices that match everywhere. The report names which one applies to you."}},{"@type":"Question","name":"Is the check free, and does it change anything on my site?","acceptedAnswer":{"@type":"Answer","text":"Free, no account. Every request is a read, the same GET a crawler makes. Nothing is installed, submitted or changed."}},{"@type":"Question","name":"What does registering my site do?","acceptedAnswer":{"@type":"Answer","text":"It tells every agent that asks who runs the site and what it declares, verified by a fetch. Free, from the registry page."}}]},{"@type":"WebPage","@id":"https://crawlcheck.io/#webpage","url":"https://crawlcheck.io/","name":"CrawlCheck — Can AI read your site? Free check","description":"See what ChatGPT, Claude, Perplexity and Google actually get from your site. Free A–F grade, every problem named, nothing installed.","isPartOf":{"@id":"https://crawlcheck.io/#website"},"publisher":{"@id":"https://crawlcheck.io/#org"},"inLanguage":"en","breadcrumb":{"@id":"https://crawlcheck.io/#crumbs"},"dateModified":"2026-11-09","about":{"@id":"https://crawlcheck.io/#app"},"mainEntity":{"@id":"https://crawlcheck.io/#app"},"mentions":[{"@type":"Thing","@id":"https://www.wikidata.org/wiki/Q16966748","name":"Ed25519","sameAs":"https://www.wikidata.org/wiki/Q16966748"},{"@type":"Thing","@id":"https://www.wikidata.org/wiki/Q2984686","name":"PyPI","sameAs":"https://www.wikidata.org/wiki/Q2984686"},{"@type":"Thing","@id":"https://www.wikidata.org/wiki/Q131723","name":"Bitcoin","sameAs":"https://www.wikidata.org/wiki/Q131723"},{"@type":"Place","@id":"https://www.wikidata.org/wiki/Q16554","name":"Denver","sameAs":"https://www.wikidata.org/wiki/Q16554"}]},{"@type":"DefinedTerm","@id":"https://crawlcheck.io/glossary#ai-visibility-score","name":"AI visibility score","description":"A composite number sold by several tools to represent how visible a brand is to language models. There is no shared definition, no published methodology across vendors, and no engine endorses any of them. Two tools can score the same site 40 and 85 and both be internally consistent.","url":"https://crawlcheck.io/glossary/ai-visibility-score","inDefinedTermSet":"https://crawlcheck.io/glossary"},{"@type":"DefinedTerm","@id":"https://crawlcheck.io/glossary#machine-layer","name":"machine layer","description":"Everything a site serves to non-human clients: robots.txt, sitemaps, llms.txt, agents.md, entity maps, structured data and response headers. A site can look finished to a visitor and be nearly empty at this layer.","url":"https://crawlcheck.io/glossary/machine-layer","inDefinedTermSet":"https://crawlcheck.io/glossary"},{"@type":"DefinedTerm","@id":"https://crawlcheck.io/glossary#llms-txt","name":"llms.txt","description":"A Markdown file at the root of a site that tells language models what the site is and which pages matter. It is a proposal, not a standard: no engine has committed to reading it, and publishing one is a low-cost bet rather than a ranking action.","url":"https://crawlcheck.io/glossary/llms-txt","inDefinedTermSet":"https://crawlcheck.io/glossary"},{"@type":"DefinedTerm","@id":"https://crawlcheck.io/glossary#structured-data","name":"structured data","description":"Machine-readable statements about a page, usually JSON-LD, describing what the page is and what it is about. Validity is cheap to check; agreement with the visible page is the part that is usually wrong.","url":"https://crawlcheck.io/glossary/structured-data","inDefinedTermSet":"https://crawlcheck.io/glossary"},{"@type":"DefinedTerm","@id":"https://crawlcheck.io/glossary#verified-crawler","name":"verified crawler","description":"A request whose claimed crawler identity is confirmed by checking the source address against the operator's own published IP ranges. Reverse DNS and user-agent matching are weaker: only the operator's feed is authoritative.","url":"https://crawlcheck.io/glossary/verified-crawler","inDefinedTermSet":"https://crawlcheck.io/glossary"},{"@type":"DefinedTerm","@id":"https://crawlcheck.io/glossary#e-e-a-t-proxies","name":"E-E-A-T proxies","description":"The machine-readable statements a site makes that a reader could use as evidence of experience, expertise, authoritativeness and trust: a named person and what qualifies them, corroborating profiles, typed authors and dates on articles, who runs the organisation, how to reach it, and whether the about, contact and policy pages are linked. Each is measurable; none of them IS the quality it stands in for.","url":"https://crawlcheck.io/glossary/e-e-a-t-proxies","inDefinedTermSet":"https://crawlcheck.io/glossary"}]}</script>


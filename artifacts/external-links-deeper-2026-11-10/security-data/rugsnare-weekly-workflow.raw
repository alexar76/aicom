name: weekly-drift-audit

on:
  schedule:
    - cron: "0 12 * * 1" # Mondays 12:00 UTC
  workflow_dispatch: {}

permissions:
  contents: write

concurrency:
  group: weekly-drift-audit
  cancel-in-progress: false

jobs:
  audit:
    runs-on: ubuntu-latest
    timeout-minutes: 45
    steps:
      - uses: actions/checkout@v4

      - uses: actions/setup-node@v4
        with:
          node-version: 22

      - name: Install rugsnare
        run: npm install -g rugsnare

      - name: Native deps for keytar-based servers (best effort)
        run: sudo apt-get update -qq && sudo apt-get install -y -qq libsecret-1-dev || true

      - name: Run drift audit
        run: node audits/run-weekly-audit.mjs

      - name: Commit WEEKLY.md
        run: |
          git config user.name "rugsnare-bot"
          git config user.email "actions@users.noreply.github.com"
          git add audits/WEEKLY.md
          if git diff --cached --quiet; then
            echo "no report changes"
          else
            git commit -m "audit: weekly MCP drift report [skip ci]"
            git push
          fi

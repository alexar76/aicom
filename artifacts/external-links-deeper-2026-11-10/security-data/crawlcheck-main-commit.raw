/ops/deny-mcp-receipt-reuse\n\nKeep refused MCP receipts out of the connection cache","verified_at":"2026-11-09T19:53:41Z"}},"url":"https://api.github.com/repos/emmanuelorta/crawlcheck-core/commits/6103cac17a0821d99fdd1acabca7ee56092e2a26","html_url":"https://github.com/emmanuelorta/crawlcheck-core/commit/6103cac17a0821d99fdd1acabca7ee56092e2a26","comments_url":"https://api.github.com/repos/emmanuelorta/crawlcheck-core/commits/6103cac17a0821d99fdd1acabca7ee56092e2a26/comments","author":{"login":"emmanuelorta","id":253105980,"node_id":"U_kgDODxYXPA","avatar_url":"https://avatars.githubusercontent.com/u/253105980?v=4","gravatar_id":"","url":"https://api.github.com/users/emmanuelorta","html_url":"https://github.com/emmanuelorta","followers_url":"https://api.github.com/users/emmanuelorta/followers","following_url":"https://api.github.com/users/emmanuelorta/following{/other_user}","gists_url":"https://api.github.com/users/emmanuelorta/gists{/gist_id}","starred_url":"https://api.github.com/users/emmanuelorta/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/emmanuelorta/subscriptions","organizations_url":"https://api.github.com/users/emmanuelorta/orgs","repos_url":"https://api.github.com/users/emmanuelorta/repos","events_url":"https://api.github.com/users/emmanuelorta/events{/privacy}","received_events_url":"https://api.github.com/users/emmanuelorta/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"web-flow","id":19864447,"node_id":"MDQ6VXNlcjE5ODY0NDQ3","avatar_url":"https://avatars.githubusercontent.com/u/19864447?v=4","gravatar_id":"","url":"https://api.github.com/users/web-flow","html_url":"https://github.com/web-flow","followers_url":"https://api.github.com/users/web-flow/followers","following_url":"https://api.github.com/users/web-flow/following{/other_user}","gists_url":"https://api.github.com/users/web-flow/gists{/gist_id}","starred_url":"https://api.github.com/users/web-flow/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/web-flow/subscriptions","organizations_url":"https://api.github.com/users/web-flow/orgs","repos_url":"https://api.github.com/users/web-flow/repos","events_url":"https://api.github.com/users/web-flow/events{/privacy}","received_events_url":"https://api.github.com/users/web-flow/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"a250490573cc48abdb95c70d2b514c356b3bc61b","url":"https://api.github.com/repos/emmanuelorta/crawlcheck-core/commits/a250490573cc48abdb95c70d2b514c356b3bc61b","html_url":"https://github.com/emmanuelorta/crawlcheck-core/commit/a250490573cc48abdb95c70d2b514c356b3bc61b"},{"sha":"9784841fa5eed882bf387ebcdcaaaee20ae175b7","url":"https://api.github.com/repos/emmanuelorta/crawlcheck-core/commits/9784841fa5eed882bf387ebcdcaaaee20ae175b7","html_url":"https://github.com/emmanuelorta/crawlcheck-core/commit/9784841fa5eed882bf387ebcdcaaaee20ae175b7"}],"stats":{"total":87,"additions":75,"deletions":12},"files":[{"sha":"8d04f140a38382ac44f81853a4dd3829e049739b","filename":"sdk-python/crawlcheck/client.py","status":"modified","additions":1,"deletions":1,"changes":2,"blob_url":"https://github.com/emmanuelorta/crawlcheck-core/blob/6103cac17a0821d99fdd1acabca7ee56092e2a26/sdk-python%2Fcrawlcheck%2Fclient.py","raw_url":"https://github.com/emmanuelorta/crawlcheck-core/raw/6103cac17a0821d99fdd1acabca7ee56092e2a26/sdk-python%2Fcrawlcheck%2Fclient.py","contents_url":"https://api.github.com/repos/emmanuelorta/crawlcheck-core/contents/sdk-python%2Fcrawlcheck%2Fclient.py?ref=6103cac17a0821d99fdd1acabca7ee56092e2a26","patch":"@@ -14,7 +14,7 @@\n from .staple import staple_check, staple_from_headers\n from .revocations import new_revocation_store, apply_revocations, revoked_for\n \n-VERSION = \"1.14.0\"\n+VERSION = \"1.14.1\"\n ACTIONS = (\"read\", \"cite\", \"connect\", \"transact\", \"administer\")\n \n "},{"sha":"8e8b5b3983636fefebc059d19d76e16656339f94","filename":"sdk-python/crawlcheck/mcp.py","status":"modified","additions":12,"deletions":3,"changes":15,"blob_url":"https://github.com/emmanuelorta/crawlcheck-core/blob/6103cac17a0821d99fdd1acabca7ee56092e2a26/sdk-python%2Fcrawlcheck%2Fmcp.py","raw_url":"https://github.com/emmanuelorta/crawlcheck-core/raw/6103cac17a0821d99fdd1acabca7ee56092e2a26/sdk-python%2Fcrawlcheck%2Fmcp.py","contents_url":"https://api.github.com/repos/emmanuelorta/crawlcheck-core/contents/sdk-python%2Fcrawlcheck%2Fmcp.py?ref=6103cac17a0821d99fdd1acabca7ee56092e2a26","patch":"@@ -133,6 +133,16 @@ def _fresh(self):\n         return True\n \n     async def _decide(self, host):\n+        url = self.url\n+        self.receipt = None\n+        receipt = await self._check_connect(host)\n+        if self.url != url:\n+            raise McpPreflightRefused(\"connect\", \"the server URL changed during preflight\")\n+        # A refusal may include a valid-looking receipt. Only a completed gate can cache it.\n+        self.receipt, self.decided_at = receipt, time.time()\n+        return receipt\n+\n+    async def _check_connect(self, host):\n         # tscope1: name the server and, with a lockfile, its approved tools_sha256, so the signed receipt covers that tool state\n         scope = None\n         if self.url and str(self.url).lower().startswith(\"https:\"):\n@@ -146,7 +156,6 @@ async def _decide(self, host):\n                 rc = self.cc.preflight(host, \"connect\", agent=self.agent, template=self.template, policy=self.policy)\n         else:\n             rc = self.cc.preflight(host, \"connect\", agent=self.agent, template=self.template, policy=self.policy)\n-        self.receipt, self.decided_at = rc, time.time()\n         if not self.co:\n             return await self._judge(rc, host, \"connect\")\n         try:\n@@ -199,12 +208,12 @@ async def before_connect(self, url):\n         if not url:\n             if self.local == \"refuse\":\n                 raise McpPreflightRefused(\"connect\", \"a local (stdio) server cannot be resolved and local='refuse'\")\n-            self.url = self.host = None\n+            self.url = self.host = self.receipt = None\n             return None\n         host = _host(url)\n         if not host:\n             raise McpPreflightRefused(\"connect\", \"not a server URL: %s\" % url)\n-        if self.host == host and self._fresh():   # already decided (before the transport was opened): not asked twice\n+        if self.url == url and self._fresh():   # already decided (before the transport was opened): not asked twice\n             return self.receipt\n         self.url, self.host = url, host\n         return await self._decide(host)"},{"sha":"6e92fd86ba54388cfbe29c337c45c302607293c2","filename":"sdk-python/pyproject.toml","status":"modified","additions":1,"deletions":1,"changes":2,"blob_url":"https://github.com/emmanuelorta/crawlcheck-core/blob/6103cac17a0821d99fdd1acabca7ee56092e2a26/sdk-python%2Fpyproject.toml","raw_url":"https://github.com/emmanuelorta/crawlcheck-core/raw/6103cac17a0821d99fdd1acabca7ee56092e2a26/sdk-python%2Fpyproject.toml","contents_url":"https://api.github.com/repos/emmanuelorta/crawlcheck-core/contents/sdk-python%2Fpyproject.toml?ref=6103cac17a0821d99fdd1acabca7ee56092e2a26","patch":"@@ -4,7 +4,7 @@ build-backend = \"setuptools.build_meta\"\n \n [project]\n name = \"crawlcheck\"\n-version = \"1.14.0\"\n+version = \"1.14.1\"\n description = \"CrawlCheck client: resolve a domain, get a signed decision for an agent action, verify CrawlCheck evidence offline. No dependencies.\"\n readme = \"README.md\"\n requires-python = \">=3.8\""},{"sha":"99817906af3ca187339cf130d6664a659f9cd586","filename":"sdk-python/tests/test_mcp.py","status":"modified","additions":21,"deletions":0,"changes":21,"blob_url":"https://github.com/emmanuelorta/crawlcheck-core/blob/6103cac17a0821d99fdd1acabca7ee56092e2a26/sdk-python%2Ftests%2Ftest_mcp.py","raw_url":"https://github.com/emmanuelorta/crawlcheck-core/raw/6103cac17a0821d99fdd1acabca7ee56092e2a26/sdk-python%2Ftests%2Ftest_mcp.py","contents_url":"https://api.github.com/repos/emmanuelorta/crawlcheck-core/contents/sdk-python%2Ftests%2Ftest_mcp.py?ref=6103cac17a0821d99fdd1acabca7ee56092e2a26","patch":"@@ -79,6 +79,27 @@ def test_hooks(self):\n         h = McpPreflight(cc({\"good.example\": \"allow\"}))\n         self.assertEqual(run(h.before_connect(\"https://good.example/mcp\"))[\"decision\"], \"allow\")\n         self.assertEqual(run(h.before_tool_call(\"search\"))[\"decision\"], \"allow\")\n+    def test_denied_refresh_cannot_authorize_tool_or_reconnect(self):\n+        policies = {\"good.example\": \"allow\"}\n+        k = cc(policies)\n+        s = Session(TOOLS)\n+        w = with_preflight(s, k, server_url=\"https://good.example/mcp\", tool_receipts=\"none\")\n+        run(w.initialize())\n+        w.preflight.receipt[\"expires_at\"] = \"2000-01-01T00:00:00Z\"\n+        policies[\"good.example\"] = \"block\"\n+        for attempt in (lambda: w.call_tool(\"search\"), lambda: w.call_tool(\"search\"), w.initialize):\n+            with self.assertRaises(McpPreflightRefused):\n+                run(attempt())\n+        self.assertEqual(s.sent, [\"initialize\"])\n+        self.assertEqual(len(k.calls), 4)\n+\n+    def test_connect_receipt_does_not_follow_same_host_to_another_path(self):\n+        k = cc({\"good.example\": \"allow\"})\n+        gate = McpPreflight(k)\n+        run(gate.before_connect(\"https://good.example/mcp\"))\n+        run(gate.before_connect(\"https://good.example/other\"))\n+        self.assertEqual([s[\"url\"] for s in k.scopes], [\"https://good.example/mcp\", \"https://good.example/other\"])\n+\n     def test_decide_first_not_twice(self):\n         k = cc({\"good.example\": \"allow\"}); pf = McpPreflight(k)\n         run(pf.before_connect(\"https://good.example/mcp\"))"},{"sha":"9ddb81a8a138ef4b0a96437230f72f14b80621d5","filename":"sdk/dist/mcp.js","status":"modified","additions":13,"deletions":4,"changes":17,"blob_url":"https://github.com/emmanuelorta/crawlcheck-core/blob/6103cac17a0821d99fdd1acabca7ee56092e2a26/sdk%2Fdist%2Fmcp.js","raw_url":"https://github.com/emmanuelorta/crawlcheck-core/raw/6103cac17a0821d99fdd1acabca7ee56092e2a26/sdk%2Fdist%2Fmcp.js","contents_url":"https://api.github.com/repos/emmanuelorta/crawlcheck-core/contents/sdk%2Fdist%2Fmcp.js?ref=6103cac17a0821d99fdd1acabca7ee56092e2a26","patch":"@@ -106,11 +106,8 @@ export function mcpPreflight(cc, opts = {}) {\n     // vantage and the signed receipt names the endpoint and tool state it covered (a changed list comes back as block).\n     const mcpScope = function () { if (!state.url || !/^https:/i.test(state.url))\n         return undefined; const h = opts.lock && typeof opts.lock.tools_sha256 === \"string\" ? opts.lock.tools_sha256 : null; return h ? { url: state.url, tools_sha256: h } : { url: state.url }; };\n-    const decide = async function (host) {\n+    const checkConnect = async function (host) {\n         const g = await cc.guard(host, \"connect\", { template, policy: opts.policy, agent: opts.agent, confirm: opts.confirm, allowWarn: !!opts.allowWarn, onlineKeys: opts.onlineKeys, mcp: mcpScope() });\n-        state.receipt = g.receipt;\n-        state.verification = g.verification;\n-        state.decidedAt = Date.now();\n         if (!g.proceed && CO) {\n             const rec = await keep(await continuityFailure(continuityClassOf(g), coOpts({ detail: (g.why || []).join(\"; \").slice(0, 300) })));\n             if (rec.outcome === \"proceed\")\n@@ -136,6 +133,18 @@ export function mcpPreflight(cc, opts = {}) {\n         }\n         return g;\n     };\n+    const decide = async function (host) {\n+      const url = state.url;\n+      state.receipt = null;\n+      state.verification = null;\n+      const result = await checkConnect(host);\n+      if (state.url !== url) throw new McpPreflightRefused(\"connect\", \"the server URL changed during preflight\");\n+      // A refusal may include a valid-looking receipt. Only a completed gate can cache it.\n+      state.receipt = result.receipt;\n+      state.verification = result.verification;\n+      state.decidedAt = Date.now();\n+      return result;\n+    };\n     return {\n         state,\n         /** Before initialize. url: the server URL (a stdio/local server has none and is not decided; pass opts.local = \"allow\" | \"refuse\", default allow). */"},{"sha":"9015f8cab796a8591ee2c996f457e28782f23024","filename":"sdk/package.json","status":"modified","additions":1,"deletions":1,"changes":2,"blob_url":"https://github.com/emmanuelorta/crawlcheck-core/blob/6103cac17a0821d99fdd1acabca7ee56092e2a26/sdk%2Fpackage.json","raw_url":"https://github.com/emmanuelorta/crawlcheck-core/raw/6103cac17a0821d99fdd1acabca7ee56092e2a26/sdk%2Fpackage.json","contents_url":"https://api.github.com/repos/emmanuelorta/crawlcheck-core/contents/sdk%2Fpackage.json?ref=6103cac17a0821d99fdd1acabca7ee56092e2a26","patch":"@@ -1,6 +1,6 @@\n {\n   \"name\": \"@crawlcheck/sdk\",\n-  \"version\": \"1.13.0\",\n+  \"version\": \"1.13.1\",\n   \"description\": \"Typed client for the CrawlCheck API (generated from its OpenAPI document) and the zero-dependency offline verifier for evidence bundles and remediation receipts.\",\n   \"type\": \"module\",\n   \"main\": \"./dist/index.js\","},{"sha":"b1de7d37ad1f5943d2d60060f8cc513e0b8bb04c","filename":"sdk/src/mcp.js","status":"modified","additions":13,"deletions":2,"changes":15,"blob_url":"https://github.com/emmanuelorta/crawlcheck-core/blob/6103cac17a0821d99fdd1acabca7ee56092e2a26/sdk%2Fsrc%2Fmcp.js","raw_url":"https://github.com/emmanuelorta/crawlcheck-core/raw/6103cac17a0821d99fdd1acabca7ee56092e2a26/sdk%2Fsrc%2Fmcp.js","contents_url":"https://api.github.com/repos/emmanuelorta/crawlcheck-core/contents/sdk%2Fsrc%2Fmcp.js?ref=6103cac17a0821d99fdd1acabca7ee56092e2a26","patch":"@@ -74,9 +74,8 @@ export function mcpPreflight(cc, opts = {}) {\n   // tscope1: send the server URL and, with a lockfile, its approved tools_sha256, so CrawlCheck reads the live tools from its own\n   // vantage and the signed receipt names the endpoint and tool state it covered (a changed list comes back as block).\n   const mcpScope = function () { if (!state.url || !/^https:/i.test(state.url)) return undefined; const h = opts.lock && typeof opts.lock.tools_sha256 === \"string\" ? opts.lock.tools_sha256 : null; return h ? { url: state.url, tools_sha256: h } : { url: state.url }; };\n-  const decide = async function (host) {\n+  const checkConnect = async function (host) {\n     const g = await cc.guard(host, \"connect\", { template, policy: opts.policy, agent: opts.agent, confirm: opts.confirm, allowWarn: !!opts.allowWarn, onlineKeys: opts.onlineKeys, mcp: mcpScope() });\n-    state.receipt = g.receipt; state.verification = g.verification; state.decidedAt = Date.now();\n     if (!g.proceed && CO) {\n       const rec = await keep(await continuityFailure(continuityClassOf(g), coOpts({ detail: (g.why || []).join(\"; \").slice(0, 300) })));\n       if (rec.outcome === \"proceed\") return g;   // observe mode: recorded, not enforced\n@@ -91,6 +90,18 @@ export function mcpPreflight(cc, opts = {}) {\n     }\n     return g;\n   };\n+  const decide = async function (host) {\n+    const url = state.url;\n+    state.receipt = null;\n+    state.verification = null;\n+    const result = await checkConnect(host);\n+    if (state.url !== url) throw new McpPreflightRefused(\"connect\", \"the server URL changed during preflight\");\n+    // A refusal may include a valid-looking receipt. Only a completed gate can cache it.\n+    state.receipt = result.receipt;\n+    state.verification = result.verification;\n+    state.decidedAt = Date.now();\n+    return result;\n+  };\n   return {\n     state,\n     /** Before initialize. url: the server URL (a stdio/local server has none and is not decided; pass opts.local = \"allow\" | \"refuse\", default allow). */"},{"sha":"53d093d3aee0ca05bb5ee4f8811c38b93c4db0f2","filename":"sdk/test/mcp.test.js","status":"modified","additions":13,"deletions":0,"changes":13,"blob_url":"https://github.com/emmanuelorta/crawlcheck-core/blob/6103cac17a0821d99fdd1acabca7ee56092e2a26/sdk%2Ftest%2Fmcp.test.js","raw_url":"https://github.com/emmanuelorta/crawlcheck-core/raw/6103cac17a0821d99fdd1acabca7ee56092e2a26/sdk%2Ftest%2Fmcp.test.js","contents_url":"https://api.github.com/repos/emmanuelorta/crawlcheck-core/contents/sdk%2Ftest%2Fmcp.test.js?ref=6103cac17a0821d99fdd1acabca7ee56092e2a26","patch":"@@ -106,3 +106,16 @@ test(\"1.4.0: a refused tool receipt stops tools/call; toolReceipts none skips it\n   await c2.connect(T(\"https://good.example/mcp\")); await c2.callTool({ name: \"delete_repo\" });\n   assert.equal(k2.calls.filter((x) => x.tool).length, 0);\n });\n+\n+test(\"a denied refresh cannot authorize a subsequent tool call\", async () => {\n+  const policies = { \"good.example\": \"allow\" };\n+  const k = cc(policies);\n+  const client = withPreflight(mcpClient(TOOLS), k, { toolReceipts: \"none\" });\n+  await client.connect(T(\"https://good.example/mcp\"));\n+  client.preflight.state.receipt.expires_at = new Date(0).toISOString();\n+  policies[\"good.example\"] = \"block\";\n+  await assert.rejects(() => client.callTool({ name: \"search\" }), McpPreflightRefused);\n+  await assert.rejects(() => client.callTool({ name: \"search\" }), McpPreflightRefused);\n+  assert.deepEqual(client.sent, [\"initialize https://good.example/mcp\"]);\n+  assert.equal(k.calls.length, 3);\n+});"}]}
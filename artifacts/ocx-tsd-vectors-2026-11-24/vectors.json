        "canonical": "{\"tools\":{\"delete_file\":{\"_meta\":{\"com.example/price\":\"0.01\"},\"annotations\":{\"destructiveHint\":true,\"readOnlyHint\":false},\"icons\":[{\"src\":\"https://example.com/i.png\"}],\"title\":\"Delete file\",\"x-vendor\":{\"tier\":2}}}}"
      }
    },

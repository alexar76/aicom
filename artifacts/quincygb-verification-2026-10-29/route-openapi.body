{"openapi":"3.1.0","info":{"title":"route-verdict","version":"1.0.0"},"paths":{"/":{"get":{"summary":"Landing","operationId":"landing__get","responses":{"200":{"description":"Successful Response","content":{"text/html":{"schema":{"type":"string"}}}}}}},"/health":{"get":{"summary":"Health","operationId":"health_health_get","responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{}}}}}}},"/quote":{"get":{"summary":"Quote","description":"Free: what the paid endpoint costs and where it settles.","operationId":"quote_quote_get","responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{}}}}}}},"/.well-known/x402":{"get":{"summary":"Well Known","operationId":"well_known__well_known_x402_get","responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{}}}}}}},"/skill.md":{"get":{"summary":"Skill","operationId":"skill_skill_md_get","responses":{"200":{"description":"Successful Response","content":{"text/plain":{"schema":{"type":"string"}}}}}}},"/llms.txt":{"get":{"summary":"Llms","operationId":"llms_llms_txt_get","responses":{"200":{"description":"Successful Response","content":{"text/plain":{"schema":{"type":"string"}}}}}}},"/v1/internal/check":{"post":{"summary":"Check Internal","description":"Fleet-internal unpaid path for StallRow's /v1/orchestrate.\nSecret discipline mirrors Token Verdict's RapidAPI route:\nFLEET_INTERNAL_SECRET unset = 404, wrong secret = 403. Absent\nfrom the x402 routes dict and every discovery surface.","operationId":"check_internal_v1_internal_check_post","requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/CheckRequest"}}},"required":true},"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}}},"/v1/nudge":{"post":{"summary":"Nudge Inbox","description":"Receive one fleet-health nudge (or opt-out). The message is\nvalidated structurally, then its signature must recover to the\nclaimed sender wallet, then — for nudges — the per-sender rate\nlimit applies. Verified nudges are stored deduped; opt-outs\nmust be signed by the payTo the named stall's own discovery\ndoc publishes, and are recorded for the sender engine.","operationId":"nudge_inbox_v1_nudge_post","responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{}}}}}}},"/v1/internal/nudges":{"post":{"summary":"Nudge Inbox Read","description":"Owner read of the nudge inbox: stored nudges (newest first)\nplus the opt-out registry. Fleet-internal secret gate, mirroring\n/v1/internal/check exactly.","operationId":"nudge_inbox_read_v1_internal_nudges_post","requestBody":{"content":{"application/json":{"schema":{"anyOf":[{"$ref":"#/components/schemas/NudgeInboxReadRequest"},{"type":"null"}],"title":"Req"}}}},"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}}},"/v1/check":{"post":{"summary":"Check","description":"Paid endpoint — unreachable until the x402 middleware verifies payment.","operationId":"check_v1_check_post","requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/CheckRequest"}}},"required":true},"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}}}},"components":{"schemas":{"CheckRequest":{"properties":{"resource_url":{"type":"string","title":"Resource Url","description":"Full URL of the x402 resource to audit"}},"type":"object","required":["resource_url"],"title":"CheckRequest"},"HTTPValidationError":{"properties":{"detail":{"items":{"$ref":"#/components/schemas/ValidationError"},"type":"array","title":"Detail"}},"type":"object","title":"HTTPValidationError"},"NudgeInboxReadRequest":{"properties":{"limit":{"type":"integer","maximum":500.0,"minimum":1.0,"title":"Limit","default":50}},"type":"object","title":"NudgeInboxReadRequest"},"ValidationError":{"properties":{"loc":{"items":{"anyOf":[{"type":"string"},{"type":"integer"}]},"type":"array","title":"Location"},"msg":{"type":"string","title":"Message"},"type":{"type":"string","title":"Error Type"}},"type":"object","required":["loc","msg","type"],"title":"ValidationError"}}},"x-discovery":{"ownershipProofs":["0x8c2ed7029c8144956320b45dc4deb1ad0eccbd23cb7ee02ce0851b8ebea592386af46d9687b85f62424f96374763d3419b48a3107f0a54f4c70c36ba19ba518c1c"]},"x-agentcash-provenance":{"ownershipProofs":["0x8c2ed7029c8144956320b45dc4deb1ad0eccbd23cb7ee02ce0851b8ebea592386af46d9687b85f62424f96374763d3419b48a3107f0a54f4c70c36ba19ba518c1c"]}}
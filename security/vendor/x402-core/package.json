{
  "name": "@x402/core",
  "version": "2.28.0+aimarket.zod4.1",
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/cjs/index.d.ts",
  "scripts": {
    "build": "tsup && node mirror-cjs-dts.mjs"
  },
  "keywords": [],
  "license": "Apache-2.0",
  "author": "x402 Foundation",

    "@types/node": "22.19.19",
    "tsup": "9.0.0",
    "typescript": "5.9.3"
  },
  "dependencies": {
    "zod": "4.6.7"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/esm/index.d.mts",
        "default": "./dist/esm/index.mjs"
      },

+package service
+
+import (
+	"context"
+	"encoding/json"
+	"fmt"
+	"strings"
+	"testing"
+
+	"github.com/jackc/pgx/v5"
+	"github.com/multica-ai/multica/server/internal/events"
+	db "github.com/multica-ai/multica/server/pkg/db/generated"
+)
+
+type aicomResultDB struct {
+	mockDBTX
+	token  string
+	saw    bool
+	leaked bool
+}
+
+func (m *aicomResultDB) QueryRow(ctx context.Context, sql string, args ...interface{}) pgx.Row {
+	if strings.Contains(sql, "SET status =") {
+		m.saw = true
+		for _, arg := range args {
+			value := fmt.Sprint(arg)
+			if raw, ok := arg.([]byte); ok {
+				value = string(raw)
+			}
+			if strings.Contains(value, m.token) {
+				m.leaked = true
+			}
+		}
+	}
+	return m.mockDBTX.QueryRow(ctx, sql, args...)
+}
+
+func TestAicomResultStorageBoundary(t *testing.T) {
+	token := "ghp_" + strings.Repeat("aB3x", 10)
+	for _, completed := range []bool{true, false} {
+		capture := &aicomResultDB{mockDBTX: mockDBTX{task: db.AgentTaskQueue{ID: testUUID(1), Status: "completed"}}, token: token}
+		svc := &TaskService{Queries: db.New(capture), Bus: events.New()}
+		var err error
+		if completed {
+			result, _ := json.Marshal(map[string]any{"output": token, "output_summary": token})
+			_, _, err = svc.CompleteTaskWithTransition(context.Background(), testUUID(1), result, "", "", "", false, "", "")
+		} else {
+			_, _, err = svc.FailTaskWithTransition(context.Background(), testUUID(1), token, "", "", "", "cancelled", false, "", "")
+		}
+		if err != nil || !capture.saw || capture.leaked {
+			t.Fatal("database query boundary received raw output or was not exercised")
+		}
+	}
+	// Invalid JSON must be rejected before touching an unconfigured database.
+	svc := &TaskService{}
+	if _, _, err := svc.CompleteTaskWithTransition(context.Background(), testUUID(1), []byte("{"), "", "", "", false, "", ""); err == nil {
+		t.Fatal("invalid result was allowed to reach storage")
+	}
+}

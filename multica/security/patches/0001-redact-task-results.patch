+func TestAicomOutputCallbacks(t *testing.T) {
+	token := "ghp_" + strings.Repeat("aB3x", 10)
+	requests := 0
+	server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		body, _ := io.ReadAll(r.Body)
+		if strings.Contains(string(body), token) || !strings.Contains(string(body), "REDACTED") {
+			t.Error("callback contains raw token or lost the redaction marker")
+		}
+		requests++
+		w.WriteHeader(http.StatusOK)
+	}))
+	defer server.Close()
+	client := NewClient(server.URL)
+	ctx := context.Background()
+	if err := client.completeTaskWithRetrySchedule(ctx, "task", token, "", "", "", false, "", "", nil); err != nil {
+		t.Fatal(err)
+	}
+	if err := client.failTaskWithRetrySchedule(ctx, "task", token, "", "", "", "", false, "", "", nil); err != nil {
+		t.Fatal(err)
+	}
+	if err := client.ReportProgress(ctx, "task", token, 1, 1); err != nil {
+		t.Fatal(err)
+	}
+	messages := []TaskMessageData{{Content: token, Output: token, Input: map[string]any{"nested": []any{map[string]any{"value": token}}}}}
+	if err := client.ReportTaskMessages(ctx, "task", messages); err != nil {
+		t.Fatal(err)
+	}
+	if messages[0].Content != token {
+		t.Fatal("caller batch was mutated")
+	}
+	if requests != 4 {
+		t.Fatal("not every result callback was exercised")
+	}
+}
+
+func TestAicomOutputOutbox(t *testing.T) {
+	token := "ghp_" + strings.Repeat("aB3x", 10)
+	for _, kind := range []terminalTaskReportKind{terminalTaskReportComplete, terminalTaskReportFail} {
+		store := newTerminalReportStore(Config{WorkspacesRoot: t.TempDir(), ServerBaseURL: "https://multica.invalid"})
+		report := terminalTaskReport{kind: kind, taskID: "task", output: token, errorMessage: token}
+		if err := store.enqueue(report); err != nil {
+			t.Fatal(err)
+		}
+		body, err := os.ReadFile(filepath.Join(store.dir, terminalReportFileName("task")))
+		if err != nil || strings.Contains(string(body), token) || !strings.Contains(string(body), "REDACTED") {
+			t.Fatal("outbox stored raw result")
+		}
+		// Legacy queue entries must also be scrubbed before replay.
+		record, err := persistedTerminalReport(report, time.Now())
+		if err != nil {
+			t.Fatal(err)
+		}
+		record.Output, record.ErrorMessage = token, token
+		replayed, err := record.terminalReport()
+		if err != nil || strings.Contains(replayed.output+replayed.errorMessage, token) {
+			t.Fatal("legacy outbox replay leaked result")
+		}
+	}
+}

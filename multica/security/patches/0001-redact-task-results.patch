+package redact
+
+import (
+	"bytes"
+	"encoding/json"
+	"errors"
+	"io"
+)
+
+// JSON scrubs terminal-result JSON before storage, preserving numeric precision.
+// Invalid or trailing data is rejected without quoting untrusted content.
+func JSON(data []byte) ([]byte, error) {
+	decoder := json.NewDecoder(bytes.NewReader(data))
+	decoder.UseNumber()
+	var value any
+	if decoder.Decode(&value) != nil {
+		return nil, errors.New("invalid result JSON")
+	}
+	var trailing any
+	if decoder.Decode(&trailing) != io.EOF {
+		return nil, errors.New("invalid trailing result JSON")
+	}
+	return json.Marshal(redactValue(value, 0))
+}

+package redact
+
+import (
+	"encoding/json"
+	"strings"
+	"testing"
+)
+
+func TestAicomResultJSON(t *testing.T) {
+	token := "ghp_" + strings.Repeat("aB3x", 10)
+	raw, _ := json.Marshal(map[string]any{"output": token, "output_summary": token, "nested": []any{map[string]any{"text": token}}, "count": json.Number("9007199254740993")})
+	safe, err := JSON(raw)
+	if err != nil || strings.Contains(string(safe), token) || !strings.Contains(string(safe), "9007199254740993") || !strings.Contains(string(safe), "REDACTED") {
+		t.Fatal("result fields must be scrubbed with numbers preserved")
+	}
+	for _, raw := range []string{`{`, `{} {}`, `{"output": "` + token} {
+		if safe, err := JSON([]byte(raw)); err == nil || safe != nil {
+			t.Fatal("malformed result must not return an unchecked payload")
+		}
+	}
+	deep := strings.Repeat("[", 40) + `"` + token + `"` + strings.Repeat("]", 40)
+	safe, err = JSON([]byte(deep))
+	if err != nil || strings.Contains(string(safe), token) || !strings.Contains(string(safe), "DEPTH LIMIT") {
+		t.Fatal("deep results must fail closed at the redactor depth limit")
+	}
+}

# ── Admin → Outreach (SMTP / webhook / Telegram) ───────────────────────────
# AIFACTORY_OUTREACH_DIR=/app/data/outreach
#
# SMTP (enable channel "smtp-newsletter" in Admin → Outreach after setting):
# OUTREACH_SMTP_HOST=smtp.example.com
# OUTREACH_SMTP_PORT=587
# OUTREACH_SMTP_USER=
# OUTREACH_SMTP_PASSWORD=
# OUTREACH_SMTP_FROM=noreply@example.com
# OUTREACH_SMTP_TO=team@example.com,archive@example.com
#
# Webhook (Slack / Zapier / Make):
# OUTREACH_WEBHOOK_URL=https://hooks.slack.com/services/...
#
# Telegram:
# OUTREACH_TELEGRAM_BOT_TOKEN=
# OUTREACH_TELEGRAM_CHAT_ID=

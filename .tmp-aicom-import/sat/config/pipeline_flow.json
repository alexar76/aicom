{
  "version": 1,
  "description": "Single source of truth for pipeline agent flow, UI stage order, and product states. Sync: orchestrator/pipeline_flow.py, web/frontend/lib/pipelineFlow.ts",
  "agent_flow": {
    "IDEA_RECEIVED": ["analyst", "MARKET_RESEARCHED"],
    "MARKET_RESEARCHED": ["pm", "SPEC_WRITTEN"],

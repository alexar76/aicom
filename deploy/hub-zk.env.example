# Hub ZK interlock for modelmarket.dev — real PLONK (universal setup, no ceremony).
# Copy to deploy/hub-zk.env on the host (gitignored). Loaded by scripts/deploy_hub.sh
# AFTER the shared .env and deploy/hub-payment.env so these values win.
#
# Artifacts are baked into the hub image (contracts/zk/build/* at docker build time).
# Runbook: contracts/zk/README.md

AIMARKET_ZK_BACKEND=plonk
AIMARKET_ZK_SIMULATED=0

AIMARKET_ZK_WASM=/app/contracts/zk/build/input_validity_js/input_validity.wasm
AIMARKET_ZK_ZKEY=/app/contracts/zk/build/input_validity_plonk.zkey
AIMARKET_ZK_VKEY_JSON=/app/contracts/zk/verifier/verification_key.json
AIMARKET_ZK_VERIFIER_SOL=/app/contracts/zk/verifier/Verifier.sol
AIMARKET_ZK_NULLIFIER_DB=/app/data/zk_nullifiers.db

# Optional: on-chain PlonkVerifier after Base deploy (contracts/zk/verifier/Verifier.sol)
# AIMARKET_ZK_VERIFIER_CONTRACT=0x...

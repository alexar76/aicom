# Hub-only payment interlock for modelmarket.dev (Base mainnet).
# Copy to deploy/hub-payment.env on the host (gitignored) — never put private keys here.
# Loaded by scripts/deploy_hub.sh AFTER the shared .env so these values win.
#
# Addresses: docs/onchain-journal.md §2c LIVE set 2026-07-26
# Runbook:   docs/payment-enable-runbook.md

AIFACTORY_PROD=1
AIFACTORY_CRYPTO_ENABLED=1
AIFACTORY_PAYMENT_VERIFY_STUB=0
AIFACTORY_PAYMENT_TESTNET=0

# School / landing browser demos. Prefer the same-origin /hub nginx bridge
# (deploy/nginx/snippets/school-hub-bridge.conf). CORS is a belt-and-suspenders
# allowlist for edu + the modeldev /school/ mirror — never use *.
AIMARKET_CORS_ORIGINS=https://edu.modelmarket.dev,https://modeldev.modelmarket.dev

# Treasury / hub wallet (escrow settle pays here). NOT an Anvil address.
AIMARKET_PAYMENT_RECIPIENT=0x1218ff36C5d2e3B6A565CdB1A8B1AcCFc606Ad0a

# Current AIMarketEscrow on Base (supersedes June 0x3Df85a…)
AIFACTORY_AI_MARKET_CONTRACT=0x12Db8FAC81E5999D2f2087B79e38951571562CF2
AIMARKET_ESCROW_EVM_ADDRESS=0x12Db8FAC81E5999D2f2087B79e38951571562CF2

# Escrow bridge — verify funding on-chain; plan mode (no auto broadcast). KI-11.
AIMARKET_ESCROW_BRIDGE_ENABLED=1
AIMARKET_ESCROW_NETWORK=base
AIMARKET_ESCROW_CONTRACT=0x12Db8FAC81E5999D2f2087B79e38951571562CF2
AIMARKET_ESCROW_HUB_ADDRESS=0x1218ff36C5d2e3B6A565CdB1A8B1AcCFc606Ad0a

# Factory products often lack provider_pubkey — required for first paid path.
AIMARKET_SUPPLY_REQUIRE_RESPONSE_SIG=0

# Pay-on-Verified → live Metis (default localhost makes every verdict indeterminate → refund).
AIMARKET_VERIFY_METIS_URL=https://metis.modelmarket.dev

# Seller-of-record for federated peers. Without this, priced federated caps
# (Platon/oracles/GAIA) return 200 unpaid while advertising a price — the hub
# only 402s when it is declared seller for that peer URL (prefix match).
# Covers /family aggregate (42 oracles incl. Platon) + GAIA IoT gateway.
#
# ATLAS was missing here until 2026-08-16 and its six capabilities ($0.01–$0.05)
# were served free for as long as they had been listed. Every satellite added to
# the catalogue needs a line here on the same day, because the failure is silent:
# the capability keeps working, it just stops being paid for. The test in
# tests/test_hub_payment_env.py exists to make the omission loud instead.
#
# Only for peers that do NOT bill on their own — declaring a peer that invoices
# out of band would charge the buyer twice (see HubConfig.sells_on_behalf_of).
# Verified for atlas: an unpaid invoke direct to atlas.modelmarket.dev answers 200.
AIMARKET_SELLS_FOR=https://oracles.modelmarket.dev/family,https://iot.modelmarket.dev,https://atlas.modelmarket.dev,https://basanos.modelmarket.dev,https://momus.modelmarket.dev,https://themis.modelmarket.dev
# Each entry must be exactly `well_known_url.rsplit("/.well-known/", 1)[0]` — that string
# becomes `source_hub` on every catalogue row and the match is a scheme+host+path prefix
# compare, so a trailing slash or a missing /family is a silent miss.
#
# WARDEN is not here and must not be added: it is a library with no server, so there is no
# peer to be seller of record for, and tests/test_hub_payment_env.py fails on any entry that
# is not in its verified non-billing set.

# Do NOT set AIMARKET_ALLOW_DEMO_CREDIT=1.

    "jcs",
    "did-key",
    "ed25519",
    "mcp",
    "ai-agent",
    "audit",
    "zero-dependency"
  ],
  "type": "module",
  "main": "awr-emit.mjs",
  "exports": {
    ".": "./awr-emit.mjs",
    "./mcp": "./mcp-middleware.mjs"
  },
  "files": ["awr-emit.mjs", "mcp-middleware.mjs", "README.md", "LICENSE"],

    <!-- JS Init. -->
    <script>
        var strSearchBoxSiteToken = 'ERC';

        (function () {
            // INITIALIZATION OF CLIPBOARD
            HSCore.components.HSClipboard.init('.js-clipboard');

            let searchAttributes = {
                'name': 'title',
                'img': 'img',
                'rate': 'rate',
                'address': 'address',
                'link': 'link',
                'group': 'group',
                'groupid': 'groupid',
                'website': 'website',
                'is_verified': 'is_checked',
                'ps': 'ps',
                'desc': 'desc',
                'reputation' : 'reputation',
                'icon': 'icon'
            }

            blockChainSearchInit({
                id: 'search-panel',
                attributes: searchAttributes
            });
        })();


    </script>
    <!-- JS Plugins Init. -->
    <script>
        $(window).on('load', function () {
            myfn_subscribeNewsletter.startFn("#btnSubscribeNewsletter", "#signupSrEmail")
        });

        $(document).on('ready', function () {

            // Get offset timezone of enduser and set to cookie
            const date = new Date();
            const offsetMinutes = date.getTimezoneOffset();
            const offsetHours = Math.abs(offsetMinutes / 60);
            const sign = offsetMinutes > 0 ? '-' : '+';
            offsetHoursFinal = sign + offsetHours;
            writeCookie(strSiteName + "_offset_datetime", offsetHoursFinal, 365);

            const clipboard = new ClipboardJS('.js-clipboard');
            clipboard.on('success', function (e) {
                let toolTip = bootstrap.Tooltip.getInstance(e.trigger);
                var oriTooltip = toolTip._config.originalTitle

                toolTip._config.title = 'Copied!';
                toolTip.setContent();
                toolTip.update();

                setTimeout(function () {
                    toolTip._config.title = oriTooltip;
                }, 1000);
            });
        });

    </script>
    
    <script type="text/javascript">
        var strSiteName = 'basescan';
        var sid = '882858be31ed638804f03f6b5976ac12';
        var strGlobal = getCookie(strSiteName + "_switch_age_datetime");
        var strGlobalFee = sessionStorage.getItem("ShowFee");
        var cookieconsent = getCookie(strSiteName + "_cookieconsent");
        var ignoreCopyConfirmation = getCopyAddressConfirmationSetting();
        var lookalikeAddressRules = [[3,2],[2,3]];
        var colorHyperLink = '#7342DC';

        
        if (cookieconsent !== "True" && document.getElementById("divcookie")) {
            document.getElementById("divcookie").style.display = "block";
        };
        

        var ace_editor_theme = 'ace/theme/dawn';
        var ace_editor_theme_dim = 'ace/theme/tomorrow_night_blue';
        var ace_editor_theme_dark = 'ace/theme/tomorrow_night';

        var chart_linear_gradient = "{ x1: 0, y1: 0, x2: 0, y2: 1 }";
        var chart_stops = "[ [0, Highcharts.getOptions().colors[0]], [1, Highcharts.color(Highcharts.getOptions().colors[0]).setOpacity(0).get('rgba')] ]";
        var chart_tooltip_color = "";
        var chart_point_color = "";
        var chart_series_color = "";

        function getCookie(cname) {
            var name = cname + "=";
            var ca = document.cookie.split(';');
            for (var i = 0; i < ca.length; i++) {
                var c = ca[i];
                while (c.charAt(0) === ' ') {
                    c = c.substring(1);
                }
                if (c.indexOf(name) === 0) {
                    return c.substring(name.length, c.length);
                }
            }
            return "";
        }

        $("#btnCookie").click(function () {
            $("#divcookie").fadeOut("slow", function () {
                var d = new Date();
                d.setTime(d.getTime() + (1095 * 24 * 60 * 60 * 1000));
                var expires = "expires=" + d.toUTCString();
                document.cookie = strSiteName + "_cookieconsent=True" + ";" + expires + ";path=/";;
            });
        });

        function handleSearchText(data) {
            searchAddress = false;
            if ($("search-panel").val() == "") {
                $("#hdnSearchText").val("");
                $("#hdnSearchLabel").val("");
            }
        }

        function writeCookie(key, value, days) {
            var date = new Date();
            days = days || 365;
            date.setTime(+ date + (days * 86400000));
            window.document.cookie = key + "=" + value + "; expires=" + date.toGMTString() + "; path=/";
            return value;
        }

        function setThemeMode(mode) {
            writeCookie('displaymode', mode);
        }

        // Note: this function will be called from where need to init the "Copy Address Confirm Modal".
        function openCopyAddressConfirmModal(address, message, hideDontShowAgain) {
            $("#addressToCopy").text(address);
            $("#copyAddressConfirmMessage").text(message);
            $("#popupDontShowAgain").closest(".form-check").toggleClass("d-none", hideDontShowAgain === true);

            const clipboard = new ClipboardJS("#btnConfirmCopyAddress");
            document.getElementById('copyAddressConfirmModal').addEventListener('hidden.bs.modal', event => {
                clipboard.destroy();
            });

            const copyAddressConfirmModal = new bootstrap.Modal('#copyAddressConfirmModal', {
                backdrop: true
            })
            copyAddressConfirmModal.show();
        }

        // Note: flags table addresses that share the first N + last M hex chars with another address on the page,
        // for each [N, M] rule in chainsettings Lookalike_Address_Rules, e.g. 3+2,2+3.
        // Addresses shown as a public/private name tag or domain still count for matching but get no warning. A cell is warned when
        // its text starts with 0x + 8 hex chars, except a domain such as 0x12345678.eth; a tag that itself starts that way is warned too.
        // Iframe pages pass their own document: window.parent.flagLookalikeAddresses(document). Only documents that have called it are
        // compared together: on the address page that is the page and its loaded tab iframes, so a pair split across tabs is found;
        // the token page itself never calls it, so its Transfers iframe is checked on its own.
        function flagLookalikeAddresses(doc) {
            if (!lookalikeAddressRules.length) return;

            doc?.documentElement.setAttribute("data-lookalike-scan", "");
            const docs = new Set(doc ? [doc] : []);
            if (document.documentElement.hasAttribute("data-lookalike-scan")) docs.add(document);
            document.querySelectorAll("iframe").forEach(frame => {
                if (!frame.contentDocument?.documentElement?.hasAttribute("data-lookalike-scan")) return;
                docs.add(frame.contentDocument);
                // The tab's next page may fail before calling this; re-check on its load so icons that relied on the old page clear.
                frame.addEventListener("load", onLookalikeFrameLoad);
            });

            // Start over each run: an iframe tab may have moved to another page since the last one.
            docs.forEach(d => {
                d.querySelectorAll(".js-lookalike-address-icon").forEach(icon => {
                    d.defaultView.bootstrap.Tooltip.getInstance(icon)?.dispose();
                    icon.remove();
                });
                d.querySelectorAll("[data-lookalike-address]").forEach(el => el.removeAttribute("data-lookalike-address"));
            });

            const elements = Array.from(docs).flatMap(d => Array.from(d.querySelectorAll("td [data-highlight-target], td [data-clipboard-text], td .btn-show-copy-confirmation")));
            const addressOf = el => (el.getAttribute("data-highlight-target") || el.getAttribute("data-clipboard-text") || el.getAttribute("data-address") || "").toLowerCase();

            const groups = new Map();
            elements.forEach(el => {
                const address = addressOf(el);
                if (/^0x[0-9a-f]{40}$/.test(address)) {
                    lookalikeAddressRules.forEach(([first, last], i) => {
                        const key = i + ":" + address.slice(2, 2 + first) + "+" + address.slice(42 - last);
                        groups.set(key, (groups.get(key) || new Set()).add(address));
                    });
                }
            });

            const lookalikes = new Set();
            groups.forEach(addresses => {
                if (addresses.size > 1) addresses.forEach(address => lookalikes.add(address));
            });

            elements.forEach(el => {
                if (!lookalikes.has(addressOf(el))) return;
                const td = el.closest("td");
                const text = td.textContent.trim();
                if (!/^0x[0-9a-f]{8}/i.test(text) || /^0x[0-9a-f]+\.[a-z]/i.test(text)) return;
                if (el.matches("[data-clipboard-text], .btn-show-copy-confirmation")) el.setAttribute("data-lookalike-address", "");

                if (td.querySelector(".js-lookalike-address-icon")) return;
                const container = getLookalikeIconContainer(td, addressOf(el));
                container.insertAdjacentHTML("afterbegin", `<i class="js-lookalike-address-icon fas fa-exclamation-triangle text-warning" role="img" title="This address looks similar to another address on this page, which may indicate an address poisoning attack. Verify the full address before interacting with it."></i>`);
                new el.ownerDocument.defaultView.bootstrap.Tooltip(container.firstElementChild);
            });

            docs.forEach(d => d.addEventListener("click", onLookalikeAddressCopy, true));
        }

        // Note: puts the icon inside the address hover highlight box (text-highlighter.js), like the zero-value icon.
        // The highlighter only boxes icons that are already before the address when it runs, so when its box is just the address
        // element, wrap both the same way it does and point its hover at the wrapper. Highlight off: icon goes first in the cell.
        function getLookalikeIconContainer(td, address) {
            const boxes = td.ownerDocument.defaultView.TextHighlight?.contentMap[address] || [];
            const i = boxes.findIndex(box => td.contains(box));
            if (i < 0) return td.querySelector(".d-flex") || td;

            // What the highlighter outlines on hover: the registered element, or its [data-highlight-target] ancestor.
            const box = boxes[i].closest("[data-highlight-target]") || boxes[i];
            if (box.classList.contains("dom-texthighlight")) return box;

            let wrapper = box.parentElement;
            if (!wrapper.classList.contains("dom-texthighlight")) {
                wrapper = td.ownerDocument.createElement("div");
                wrapper.className = "d-inline-flex align-items-center gap-1 dom-texthighlight border border-white px-1 mx-n1";
                wrapper.style.setProperty("--bs-border-opacity", "0");
                box.before(wrapper);
                wrapper.append(box);
            }
            boxes[i].classList.remove("border", "border-white", "px-1", "mx-n1");
            // Also in cacheEL (keyed by the element's uid): a later TextHighlight.init, e.g. from switchMethodColumn, rebuilds contentMap from it.
            td.ownerDocument.defaultView.TextHighlight.cacheEL[boxes[i].dataset.uid] = wrapper;
            boxes[i] = wrapper;
            return wrapper;
        }

        // Skip when the tab's new page already ran the check itself; otherwise re-check so icons that relied on the old page clear.
        function onLookalikeFrameLoad(e) {
            if (!e.currentTarget.contentDocument?.documentElement?.hasAttribute("data-lookalike-scan")) flagLookalikeAddresses(null);
        }

        // Note: capture phase runs before the copy button's own handlers (ClipboardJS, #4921 copy confirmation), so only this modal opens.
        // The 30-day "Don't show" opt-out belongs to #4921; lookalike is turned off in Site Settings, so the checkbox is hidden here.
        function onLookalikeAddressCopy(e) {
            const button = e.target.closest("[data-lookalike-address]");
            if (!button) return;

            e.preventDefault();
            e.stopPropagation();
            openCopyAddressConfirmModal(button.getAttribute("data-clipboard-text") || button.getAttribute("data-address"), "This address looks similar to another address on this page, which may indicate an address poisoning attack. Verify that this is the address you intend to interact with.", true);
        }

        function saveCopyAddressConfirmationSetting(ignoreCopyConfirmation) {
            const copyAddressConfirmationSetting = {
                ignoreCopyConfirmation: ignoreCopyConfirmation,
                expiresOn: Date.now() + 1000 * 60 * 60 * 24 * 30
            };
            localStorage.setItem(strSiteName + "_copyAddressConfirmationSetting", JSON.stringify(copyAddressConfirmationSetting));
        }

        function getCopyAddressConfirmationSetting() {
            try {
                const settings = localStorage.getItem(strSiteName + "_copyAddressConfirmationSetting");
                if (settings) {
                    const copyAddressConfirmationSetting = JSON.parse(settings);

                    return copyAddressConfirmationSetting.ignoreCopyConfirmation && copyAddressConfirmationSetting.expiresOn > Date.now();
                }
                else {
                    return false;
                }
            } catch (e) {
                return false;
            }
        }
    </script>

    

    <script src="/assets/js/custom/web3.min.js?v=0.5.2.3"></script>
    <script src="/assets/js/custom/web3-utils.min.js"></script>
    
    <script src="/assets/js/custom/web3-providers-http.min.js"></script>    

    <script src="/assets/vendor/web3modal-1.9.8.min.js?v=26.10.4.0"></script>
    <script src="/assets/vendor/walletlink_bundle.js?v=26.10.4.0"></script>

            const quickExportTokentxnsTitle = 'Transaction Hash,Status,Method,BlockNo,"DateTime (UTC)",From,From_Nametag,To,To_Nametag,Amount,Value (USD),Token';
            let isExportFinish = true;
            if ($("#btnExportQuickTokentxnsCSV").length > 0 && quickExportTokentxnsData) {
                $("#btnExportQuickTokentxnsCSV").click(function () {
                    if (isExportFinish == true) {
                        isExportFinish = false;
                        $("#btnExportQuickTokentxnsCSV").append('<i class="fa fa-spinner fa-spin ms-1"></i>');
                        let lstTxsObj = JSON.parse(quickExportTokentxnsData);
                        if (lstTxsObj.length > 0) {
                            let csvRows = [];
                            csvRows.push(quickExportTokentxnsTitle.replace(/"/g, ""));
                            for (let i = 0; i < lstTxsObj.length; i++) {
                                let values = Object.values(lstTxsObj[i]).join('2SL'); // 2SL : separate line
                                values = values.replace(/2SL/g, '","');
                                csvRows.push('"' + values + '"');
                            }
                            let data = csvRows.join('\n');
                            let fileName = "export-tokentxns-" + new Date().getTime().toString();
                            const blob = new Blob(["\ufeff", data], { type: 'text/csv' });
                            const url = window.URL.createObjectURL(blob)
                            const a = document.createElement('a')
                            a.setAttribute('href', url)
                            a.setAttribute('download', fileName + '.csv');
                            a.click();
                            setTimeout(function () {
                                $("#btnExportQuickTokentxnsCSV").find(".fa-spinner").remove();
                                isExportFinish = true;
                            }, 200);
                        }
                    }
                });
            }

        });


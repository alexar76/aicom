                                        <th scope="col">Validity <i class="method-tooltip far fa-question-circle text-muted" data-bs-toggle="popover" data-bs-trigger="hover" data-bs-content="Shows whether the EOA’s signed EIP-7702 envelope passes all validity checks (sig, nonce, chain-id, etc.). If true, the account immediately delegates execution to the specified delegated contract."></i></th>
                                        <th scope="col">yParity</th>
                                        <th scope="col">r</th>
                                        <th scope="col">s</th>
                                    </tr>
                                </thead>
                                <tbody class="align-middle text-nowrap">
                                    
                                </tbody>
                            </table>
                        </div>
                        <!-- End Table -->

                    </div>

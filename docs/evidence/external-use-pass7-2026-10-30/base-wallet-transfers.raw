    <script src="/assets/js/custom/wallet-handling-connect.js?v=26.10.4.0"></script>

    <script type="text/javascript">
        var eth;
        var objProvider
        var isTestnet = 'false';
        var SiteNetID = '8453';
        var SiteNetChainID = '0x2105';
        var SiteNetName = 'Base';
        var allowErc1155 = 'True';

        ListenProviderList();
        async function addNetwork(type) {

            if (type === 'web3') {
                if (typeof ethereum !== 'undefined') {
                    objProvider = await initweb3walletProvider("MetaMask");
                    eth = new Web3(objProvider.provider);
                } else if (typeof web3 !== 'undefined') {
                    eth = new Web3(web3.givenProvider);
                } else {
                    eth = new Web3(ethereum);
                }
            }

            if (typeof eth !== 'undefined') {
                var network = 0;
                network = await eth.eth.getChainId(); //await eth.eth.net.getId();
                netID = network.toString();
                var params;
                if (netID == SiteNetID) {
                    alert("Base Network has already been added to Metamask.");
                    return;
                } else {
                    params = [{
                        chainId: SiteNetChainID,
                        chainName: 'Base',
                        nativeCurrency: {
                            name: 'ETH',
                            symbol: 'ETH',
                            decimals: 18
                        },
                        rpcUrls: ['https://mainnet.base.org/'],
                        blockExplorerUrls: ['https://basescan.org']
                    }]
                }

                GeneralRequestWithProvider('wallet_addEthereumChain', params, eth.currentProvider)
                    .then(() => console.log('Success'))
                    .catch((error) => console.log("Error", error.message));
            } else {
                alert('Unable to locate a compatible web3 browser!');
            }
        }
    </script>

    
    <script type="text/javascript" src="/assets/js/custom/nativesearch.js?v=26.10.4.0"></script>
    <script type="text/javascript" src="/assets/js/custom/commonjs.js?v=26.10.4.0"></script><script type="text/javascript" src="/assets/js/custom/text-highlighter.js?v=26.10.4.0"></script>

    <script type="text/javascript">
        // INITIALIZATION OF HIGHLIGHT
        TextHighlight.init('basescan');

        $(document).ready(function () {
            switchAmountToValue(document.getElementById("headerAmountValue"), 'Value (USD)', 'Amount', true);
             
                switchMethodColumn(document.getElementById("headerMethod"), 'Method', 'Action', true);
             

            initDateTimeTooltip();

            initPopover();
            registerPreviewButtonEvent();

            //check display UTC or Local datetime//
            convertUtcToLocalDateTime();

            if (ignoreCopyConfirmation) {
                HSCore.components.HSClipboard.init('.js-clipboard-required-confirmation');
                const clipboardIgnoreConfirmation = new ClipboardJS('.js-clipboard-required-confirmation');
                clipboardIgnoreConfirmation.on('success', function (e) {
                    $('.tooltip-inner').html('Copied!');
                    $(e.trigger).tooltip('update');
                });
            } else {
                $(".btn-show-copy-confirmation").on("click", function (event) {
                    openCopyAddressConfirmModal($(this).data("address"), $(this).data("message"));
                });
                $("#popupDontShowAgain").on("click", function (e) {
                    ignoreCopyConfirmation = e.currentTarget.checked;
                    saveCopyAddressConfirmationSetting(ignoreCopyConfirmation);
                    let clipboardIgnoreConfirmation = null;
                    if (ignoreCopyConfirmation) {
                        HSCore.components.HSClipboard.init('.js-clipboard-required-confirmation');
                        clipboardIgnoreConfirmation = new ClipboardJS('.js-clipboard-required-confirmation');
                        clipboardIgnoreConfirmation.on('success', function (e) {
                            $('.tooltip-inner').html('Copied!');
                            $(e.trigger).tooltip('update');
                        });
                        $(".btn-show-copy-confirmation").off("click");
                    } else {
                        if (clipboardIgnoreConfirmation) {
                            clipboardIgnoreConfirmation.destroy();
                        }
                        $(".btn-show-copy-confirmation").on("click", function (event) {
                            openCopyAddressConfirmModal($(this).data("address"), $(this).data("message"));
                        });
                    }
                });
            }

            $(`[data-bs-toggle="tooltip"]`).tooltip();
            applyNativeBrowserSearch("[data-truncate='address']");
            flagLookalikeAddresses(document);


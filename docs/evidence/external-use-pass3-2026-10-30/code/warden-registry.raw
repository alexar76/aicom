/build-macos.mjs","test:redteam":"node scripts/redteam/flow-redteam.mjs --check","check:quality":"node scripts/check-quality-gate.mjs","check:ruleset":"node scripts/check-published-ruleset.mjs","test:coverage":"vitest run --coverage","prepublishOnly":"npm run build && npm test && npm run test:redteam && npm run check:ruleset && npm run check:quality"},"_npmUser":{"name":"alexar76","email":"alexar76@rambler.ru"},"repository":{"url":"git+https://github.com/alexar76/warden.git","type":"git"},"_npmVersion":"10.9.4","description":"WARDEN — MCP security firewall. Stdio wrap proxy, inspection tools and library. Vets definitions before model exposure. Zero runtime dependencies.","directories":{},"sideEffects":false,"_nodeVersion":"22.22.1","publishConfig":{"access":"public"},"_hasShrinkwrap":false,"devDependencies":{"vitest":"^4.1.12","typescript":"^5.7.2","@types/node":"^26.6.4","@vitest/coverage-v8":"^4.1.12"},"_npmOperationalInternal":{"tmp":"tmp/warden_0.22.0_1792955651915_0.7524884291088545","host":"s3://npm-registry-packages-npm-production"}},"0.22.1":{"name":"@aimarket/warden","version":"0.22.1","keywords":["mcp","mcp-server","mcp-security","model-context-protocol","prompt-injection","tool-poisoning","warden","firewall","security","ai-agent","llm","aimarket","aicom"],"author":{"url":"alexar76","name":"AICOM"},"license":"MIT","_id":"@aimarket/warden@0.22.1","maintainers":[{"name":"alexar76","email":"alexar76@rambler.ru"}],"homepage":"https://warden.modelmarket.dev/","bugs":{"url":"https://github.com/alexar76/warden/issues"},"bin":{"warden-mcp":"dist/mcp-server.js"},"dist":{"shasum":"4b8f46fc96310a1a3dc32c54179ce131b022090c","tarball":"https://registry.npmjs.org/@aimarket/warden/-/warden-0.22.1.tgz","fileCount":340,"integrity":"sha512-2Yt0WiEb6cHZTMgddLGALv43VrVOKjjHdYtJ9YPDM6PaThyQdpYVowV+hXOl3cg074y9ZypUKaOEMPHNogs4Ig==","signatures":[{"sig":"MEUCICl5OxZT1eop/RANBFIYhAbY1v36/p8vc1LhU5Zu9zwaAiEAyEFRZhOBmPvR8bXcHsJV+380ArP5TEZDynTkWTFKgSs=","keyid":"SHA256:DhQ8wR5APBvF
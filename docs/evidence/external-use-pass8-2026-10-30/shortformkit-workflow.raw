name: Weekly test of all remote MCP servers

on:
  schedule:
    - cron: "17 3 * * 1"   # Mondays 03:17 UTC
  workflow_dispatch:

permissions:
  contents: write

jobs:
  probe:
    runs-on: ubuntu-latest
    timeout-minutes: 120
    steps:
      - uses: actions/checkout@v5
      - uses: actions/setup-python@v6
        with:
          python-version: "3.12"
      - name: Fetch the registry
        run: python3 scripts/fetch_registry.py
      - name: Test every remote endpoint (initialize + tools/list only)
        run: python3 scripts/probe.py 32
      - name: Build data and README
        run: python3 scripts/make_directory.py
      - name: Commit
        run: |
          git config user.name "github-actions[bot]"
          git config user.email "41898282+github-actions[bot]@users.noreply.github.com"
          git add data README.md
          git diff --cached --quiet || git commit -m "Weekly test $(date -u +%Y-%m-%d)"
          git push

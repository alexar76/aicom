earch=\"https://www.hubwiz.com/blog/\" data-locale=\"zh\" crossorigin=\"anonymous\"></script>\n    \n    <link href=\"https://www.hubwiz.com/blog/webmentions/receive/\" rel=\"webmention\">\n    <script defer src=\"/blog/public/cards.min.js?v=ShRHxgy4po8zN-Wf\"></script>\n    <link rel=\"stylesheet\" type=\"text/css\" href=\"/blog/public/cards.min.css?v=WwnU9jw5ancNC8Gc\">\n    <script defer src=\"/blog/public/member-attribution.min.js?v=AKG4hWena9j3yX3I\"></script><style>:root {--ghost-accent-color: #4666a4;}</style>\n\n</head>\n<body class=\"post-template tag-mcp tag-agent-an-quan tag-gong-ying-lian tag-gong-ju-shen-ji has-sans-title has-sans-body\">\n\n<div class=\"gh-viewport\">\n    \n    <header id=\"gh-navigation\" class=\"gh-navigation is-middle-logo gh-outer\">\n    <div class=\"gh-navigation-inner gh-inner\">\n\n        <div class=\"gh-navigation-brand\">\n            <a class=\"gh-navigation-logo is-title\" href=\"https://www.hubwiz.com/blog\">\n                    Software 2.0\n            </a>\n            <button class=\"gh-search gh-icon-button\" aria-label=\"搜索本站内容\" data-ghost-search>\n    <svg xmlns=\"http://www.w3.org/2000/svg\" fill=\"none\" viewBox=\"0 0 24 24\" stroke=\"currentColor\" stroke-width=\"2\" width=\"20\" height=\"20\"><path stroke-linecap=\"round\" stroke-linejoin=\"round\" d=\"M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z\"></path></svg></button>            <button class=\"gh-burger gh-icon-button\" aria-label=\"Menu\">\n                <svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" fill=\"currentColor\" viewBox=\"0 0 256 256\"><path d=\"M224,128a8,8,0,0,1-8,8H40a8,8,0,0,1,0-16H216A8,8,0,0,1,224,128ZM40,72H216a8,8,0,0,0,0-16H40a8,8,0,0,0,0,16ZM216,184H40a8,8,0,0,0,0,16H216a8,8,0,0,0,0-16Z\"></path></svg>                <svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" fill=\"currentColor\" viewBox=\"0 0 256 256\"><path d=\"M205.66,194.34a8,8,0,0,1-11.32,11.32L128,139.31,61.66,205.66a8,8,0,0,1-11.32-11.32L116.69,128,50.34,61.66A8,8,0,0,1,61.66,50.34L128,116.69l66.34-66.35a8,8,0,0,1,11.32,11.32L139.31,128Z\"></path></svg>            </button>\n        </div>\n\n        <nav class=\"gh-navigation-menu\">\n            <ul class=\"nav\">\n    <li class=\"nav-shou-ye\"><a href=\"https://www.hubwiz.com/blog/\">首页</a></li>\n    <li class=\"nav-aibian-cheng\"><a href=\"https://www.hubwiz.com/blog/vibe-coding-stack/\">AI编程</a></li>\n    <li class=\"nav-agent-mcp\"><a href=\"https://www.hubwiz.com/blog/agent-stack/\">Agent/MCP</a></li>\n    <li class=\"nav-ben-di-da-mo-xing\"><a href=\"https://www.hubwiz.com/blog/local-llm-stack/\">本地大模型</a></li>\n    <li class=\"nav-gong-ye-ai\"><a href=\"https://www.hubwiz.com/blog/ai-industrial-stack/\">工业AI</a></li>\n</ul>\n\n        </nav>\n\n        <div class=\"gh-navigation-actions\">\n                <button class=\"gh-search gh-icon-button\" aria-label=\"搜索本站内容\" data-ghost-search>\n    <svg xmlns=\"http://www.w3.org/2000/svg\" fill=\"none\" viewBox=\"0 0 24 24\" stroke=\"currentColor\" stroke-width=\"2\" width=\"20\" height=\"20\"><path stroke-linecap=\"round\" stroke-linejoin=\"round\" d=\"M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z\"></path></svg></button>                <div class=\"gh-navigation-members\">\n                            <a href=\"#/portal/signin\" data-portal=\"signin\">登录</a>\n                                <a class=\"gh-button\" href=\"#/portal/signup\" data-portal=\"signup\">订阅</a>\n                </div>\n        </div>\n\n    </div>\n</header>\n\n    \n\n<main class=\"gh-main\">\n\n    <article class=\"gh-article post tag-mcp tag-agent-an-quan tag-gong-ying-lian tag-gong-ju-shen-ji\">\n\n        <header class=\"gh-article-header gh-canvas\">\n\n                <a class=\"gh-article-tag\" href=\"https://www.hubwiz.com/blog/tag/mcp/\">MCP</a>\n            <h1 class=\"gh-article-title is-title\">MCP 供应链体检：15,341 个服务器扫描与上线前 8 项检查</h1>\n                <p class=\"gh-article-excerpt is-body\">15,341 个 MCP 服务器里 64.8% 能联网、21.1% 能开 shell、7.4% 装的时候就跑代码。附 npx 之前必须做的 8 项检查。</p>\n\n                <div class=\"gh-meta-share\">\n                    <div class=\"gh-article-meta\">\n                        <div class=\"gh-article-author-image instapaper_ignore\">\n                                    <a href=\"/blog/author/admin/\"><svg viewBox=\"0 0 24 24\" xmlns=\"http://www.w3.org/2000/svg\"><g fill=\"none\" fill-rule=\"evenodd\"><path d=\"M3.513 18.998C4.749 15.504 8.082 13 12 13s7.251 2.504 8.487 5.998C18.47 21.442 15.417 23 12 23s-6.47-1.558-8.487-4.002zM12 12c2.21 0 4-2.79 4-5s-1.79-4-4-4-4 1.79-4 4 1.79 5 4 5z\" fill=\"#FFF\"/></g></svg>\n</a>\n                        </div>\n                        <div class=\"gh-article-meta-wrapper\">\n                            <h4 class=\"gh-article-author-name\"><a href=\"/blog/author/admin/\">admin</a></h4>\n                            <div class=\"gh-article-meta-content\">\n                                <time class=\"gh-article-meta-date\" datetime=\"2026-10-17\">17 10月 2026</time>\n                                    <span class=\"gh-article-meta-length\"><span class=\"bull\">—</span> 阅读时间 15 分钟</span>\n                            </div>\n                        </div>\n                    </div>\n                    <a href=\"#/share\" class=\"gh-button gh-button-share\">\n                        分享\n                    </a>\n                </div>\n\n                <figure class=\"gh-article-image\">\n        <img\n            class=\"gh-feature-image\"\n            srcset=\"/blog/content/images/size/w320/2026/10/mcp-registry-supply-chain-audit-cover-pe.jpg 320w,\n                    /blog/content/images/size/w600/2026/10/mcp-registry-supply-chain-audit-cover-pe.jpg 600w,\n                    /blog/content/images/size/w960/2026/10/mcp-registry-supply-chain-audit-cover-pe.jpg 960w,\n                    /blog/content/images/size/w1200/2026/10/mcp-registry-supply-chain-audit-cover-pe.jpg 1200w,\n                    /blog/content/images/size/w2000/2026/10/mcp-registry-supply-chain-audit-cover-pe.jpg 2000w\"\n            sizes=\"(max-width: 1200px) 100vw, 1120px\"\n            src=\"/blog/content/images/size/w1200/2026/10/mcp-registry-supply-chain-audit-cover-pe.jpg\"\n            alt=\"MCP 供应链体检：15,341 个服务器扫描与上线前 8 项检查\"\n        >\n    </figure>\n\n        </header>\n\n        <section class=\"gh-content gh-canvas is-body\">\n            <p><strong>一句话结论</strong>：给 Agent 加一个 MCP 服务器，等于把那个服务器<strong>能做的事</strong>原样交给它——包括联网、读文件、开 shell、在安装时执行代码。2026 年 10 月，两件事把这个问题摆到了台面上：一个假冒 REA 的仓库用复制来的 README 分发带木马的 Windows 程序；同一周，一份对<strong>官方 MCP 注册表 15,341 个组件</strong>的静态扫描给出了整体画像——<strong>64.8% 能发起网络请求，25.0% 能读文件系统，21.1% 能执行 shell，7.4% 在安装时就运行代码</strong>。本文把这两份材料合成一套可执行的验收流程：先看群体数据，再走 8 项上线前检查。</p><p><strong>披露</strong>：扫描报告作者是 SkillTotal（Apache-2.0 开源扫描器）的开发者，方法与聚合数据公开、可复现，文中数字以其公开报告为准；8 项检查的作者是 Hermes IDE 的开发者，检查方法本身与具体产品无关，可在任意终端复现。两篇源文都发布于 2026-10-16。</p><hr><h2 id=\"%E4%B8%80%E3%80%81%E5%85%88%E7%9C%8B%E4%BA%8B%E6%95%85%EF%BC%9A%E5%81%87-rea-%E4%BB%93%E5%BA%93%E6%98%AF%E6%80%8E%E4%B9%88%E8%A2%AB%E5%8F%91%E7%8E%B0%E7%9A%84\">一、先看事故：假 REA 仓库是怎么被发现的</h2><p>2026-10-13，REA（一个让 coding agent 逆向二进制、Electron 应用、APK 的开源 MCP 服务器与 CLI）的仓库收到 issue #2424，标题很直接：「一个假仓库 <code>rea-tools/rea</code> 在分发带木马的 Windows exe」。</p><p>按该 issue 的描述：</p>\n<!--kg-card-begin: html-->\n<table>\n<thead>\n<tr>\n<th>项</th>\n<th>细节</th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td>手法</td>\n<td>复制 REA 的 README，加一节「Windows Standalone .exe」，指向一个 <strong>82.6 MB</strong> 压缩包</td>\n</tr>\n<tr>\n<td>检测</td>\n<td>Microsoft Defender 把压缩包标为 <code>Trojan:Script/Wacatac.B!ml</code>，解压出的 <code>rea-x64.exe</code> 标为 <code>Trojan:Win32/Wacatac.B!ml</code></td>\n</tr>\n<tr>\n<td>多引擎</td>\n<td>VirusTotal 上 <strong>8/45</strong> 个引擎报毒</td>\n</tr>\n<tr>\n<td>传播量</td>\n<td><strong>172 次下载</strong></td>\n</tr>\n<tr>\n<td>仓库背景</td>\n<td><code>rea-tools</code> 组织创建于 <strong>2026-10-10</strong>，名下只有这一个仓库；名字在模仿 REA 的真实站点 <code>rea.tools</code></td>\n</tr>\n<tr>\n<td>处置</td>\n<td>维护者当天关闭 issue，并通过 PR #2429 更新 README：只从 <code>morluto/rea</code>、<code>rea.tools</code> 或 npm 包 <code>rea-agents</code> 获取</td>\n</tr>\n</tbody>\n</table>\n<!--kg-card-end: html-->\n<p>REA 当时的热度正是攻击者选择的理由：走红几天内约 <strong>14.5 万 star</strong>，目前仓库已超过 <strong>28 万</strong>。README 现在多了一句关键的话——<strong>「相似的仓库名或复制的 README，不能证明下载是官方的。」</strong></p><p>这句话就是 MCP 生态的核心问题：你从一条推文或一个列表里看到服务器名，把一行配置粘进 agent，agent 就用<strong>你的权限</strong>把它跑起来。</p><h2 id=\"%E4%BA%8C%E3%80%81%E7%BE%A4%E4%BD%93%E7%94%BB%E5%83%8F%EF%BC%9A15341-%E4%B8%AA%E6%9C%8D%E5%8A%A1%E5%99%A8%E8%83%BD%E5%81%9A%E4%BB%80%E4%B9%88\">二、群体画像：15,341 个服务器能做什么</h2><p>扫描对象是官方注册表 <code>registry.modelcontextprotocol.io/v0/servers</code>。它按\"发布版本\"计数，所以原始条目会高估生态规模：<strong>2026-08-16 快照的 73,460 条记录，按来源去重后是 17,535 个组件</strong>。其中 <strong>15,341 个（87.5%）</strong>完成扫描，其余 2,194 个按原因计数：</p>\n<!--kg-card-begin: html-->\n<table>\n<thead>\n<tr>\n<th>未扫描原因</th>\n<th>组件数</th>\n<th>占比</th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td>仓库或包已不可访问</td>\n<td>1,637</td>\n<td>9.3%</td>\n</tr>\n<tr>\n<td>超过 60 秒时限</td>\n<td>302</td>\n<td>1.7%</td>\n</tr>\n<tr>\n<td>超过 50 MB 体积上限</td>\n<td>188</td>\n<td>1.1%</td>\n</tr>\n<tr>\n<td>其他</td>\n<td>65</td>\n<td>0.4%</td>\n</tr>\n<tr>\n<td>访问被拒绝</td>\n<td>2</td>\n<td>0.0%</td>\n</tr>\n</tbody>\n</table>\n<!--kg-card-end: html-->\n<p>按托管位置看，覆盖率差异很大：</p>\n<!--kg-card-begin: html-->\n<table>\n<thead>\n<tr>\n<th>生态</th>\n<th>已扫描</th>\n<th>已列出</th>\n<th>覆盖率</th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td>npm</td>\n<td>6,967</td>\n<td>7,152</td>\n<td>97.4%</td>\n</tr>\n<tr>\n<td>PyPI</td>\n<td>2,985</td>\n<td>3,071</td>\n<td>97.2%</td>\n</tr>\n<tr>\n<td>git</td>\n<td>5,389</td>\n<td>7,312</td>\n<td>73.7%</td>\n</tr>\n</tbody>\n</table>\n<!--kg-card-end: html-->\n<p><strong>近十分之一（9.3%）的组件指向一个已经消失或私有的仓库/包。</strong> 这本身就是一条供应链事实：你抄下来的 npx 行，可能指向一个已经不由原作者控制的东西。</p><p>方法是确定性的静态分析：正则规则 + Python AST，代码只下载阅读、<strong>从不执行</strong>，也不调用 LLM。同一份代码、同一个引擎、同一个 Python 版本，结果可复现。运行参数：SkillTotal 0.49.0、规则集 56–59、单组件 50 MB / 60 秒上限，读取每个组件在运行时的最新 release 或默认分支。</p><h3 id=\"%E8%83%BD%E5%8A%9B%E8%A1%A8%EF%BC%9A%E4%B8%8D%E6%98%AF%E6%BC%8F%E6%B4%9E%EF%BC%8C%E6%98%AFagent-%E4%BC%9A%E7%BB%A7%E6%89%BF%E7%9A%84%E8%A7%A6%E8%BE%BE%E9%9D%A2\">能力表：不是漏洞，是\"Agent 会继承的触达面\"</h3>\n<!--kg-card-begin: html-->\n<table>\n<thead>\n<tr>\n<th>能力</th>\n<th>组件数</th>\n<th>占 15,341</th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td>暴露 MCP 工具</td>\n<td>13,524</td>\n<td>88.2%</td>\n</tr>\n<tr>\n<td>能访问网络</td>\n<td>9,938</td>\n<td>64.8%</td>\n</tr>\n<tr>\n<td>读文件系统</td>\n<td>3,828</td>\n<td>25.0%</td>\n</tr>\n<tr>\n<td>执行 shell 命令</td>\n<td>3,230</td>\n<td>21.1%</td>\n</tr>\n<tr>\n<td>写文件系统</td>\n<td>3,206</td>\n<td>20.9%</td>\n</tr>\n<tr>\n<td>安装时运行代码</td>\n<td>1,134</td>\n<td>7.4%</td>\n</tr>\n<tr>\n<td>使用委托式（OAuth/OIDC）认证</td>\n<td>895</td>\n<td>5.8%</td>\n</tr>\n<tr>\n<td>动态求值代码</td>\n<td>475</td>\n<td>3.1%</td>\n</tr>\n<tr>\n<td>使用受限、短时效身份</td>\n<td>81</td>\n<td>0.5%</td>\n</tr>\n</tbody>\n</table>\n<!--kg-card-end: html-->\n<p>几个必须记住的读法：</p><ol><li><strong>三分之二的服务器能对外发请求。</strong> 如果你担心数据外流，默认假设\"它发得出去\"。</li><li><strong>五分之一能开 shell，五分之一能写盘。</strong> 对构建工具、文件管理器、开发环境服务器来说这很合理；但这也正是<strong>把提示注入升级成代码执行或持久化</strong>的两个条件。审一个服务器时，这两个数字应该出现在审批单上。</li><li><strong>1,134 个（7.4%）在安装时跑代码</strong>：npm 的 <code>install</code>/<code>prepare</code> 脚本，或 Python 安装钩子。这段代码在你调用任何工具、阅读任何工具描述<strong>之前</strong>就已经运行。</li><li><strong>只有 81 个（0.5%）呈现\"受限、短时效身份\"模式</strong>，而 895 个（5.8%）使用委托式 OAuth/OIDC。两个数字都只覆盖规则能识别的写法。</li></ol><h3 id=\"%E9%A3%8E%E9%99%A9%E5%88%86%E7%BA%A7%E7%9A%84%E8%AF%BB%E6%B3%95%EF%BC%9A993-low-%E4%B8%8D%E7%AD%89%E4%BA%8E%E5%AE%89%E5%85%A8\">风险分级的读法：99.3% low 不等于安全</h3>\n<!--kg-card-begin: html-->\n<table>\n<thead>\n<tr>\n<th>风险等级</th>\n<th>组件数</th>\n<th>占比</th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td>low</td>\n<td>15,225</td>\n<td>99.3%</td>\n</tr>\n<tr>\n<td>medium</td>\n<td>90</td>\n<td>0.6%</td>\n</tr>\n<tr>\n<td>high</td>\n<td>22</td>\n<td>0.1%</td>\n</tr>\n<tr>\n<td>critical</td>\n<td>4</td>\n<td>&lt;0.1%</td>\n</tr>\n</tbody>\n</table>\n<!--kg-card-end: html-->\n<p>在这套规则集下，<strong>没有任何组件命中\"攻击形状\"规则</strong>。作者自己给了三条限制：规则先在这批人群上调过；静态扫描看不到运行时才拉取的代码；也看不到还没有规则描述的攻击。而且更新的规则集（当前为 76）会读 MCP 启动命令和嵌套工具 schema 字段，所以\"零命中\"只对这一轮成立，<strong>不是\"某个组件安全\"的结论</strong>。</p><p>按 OWASP Agentic Skills Top 10 归类，出现最多的是：</p><ul><li><strong>AST03 过度授权技能</strong>：1,905 个（12.4%）</li><li><strong>AST02 供应链劫持</strong>：1,216 个（7.9%）</li></ul><p>git 侧还呈现集中度：7,312 个 GitHub 组件分布在 4,325 个 owner 手上，<strong>单个 owner 占 18.0%</strong>，前十大 owner 占 29.1%。</p><h2 id=\"%E4%B8%89%E3%80%81%E4%B8%8A%E7%BA%BF%E5%89%8D-8-%E9%A1%B9%E6%A3%80%E6%9F%A5%EF%BC%88%E4%BB%A5-rea-%E4%B8%BA%E4%BE%8B%EF%BC%89\">三、上线前 8 项检查（以 REA 为例）</h2><p>第 1、2 项就能挡住 <code>rea-tools</code> 这个复制品；其余 6 项覆盖它没走、但下一个可能会走的路径——<strong>你配置里 npx 拉下来的那个 npm 包</strong>。</p><h3 id=\"1-%E5%90%8D%E5%AD%97%E4%BB%8E%E9%A1%B9%E7%9B%AE%E6%9C%AC%E8%BA%AB%E5%8F%96%EF%BC%8C%E4%B8%8D%E4%BB%8E%E6%90%9C%E7%B4%A2%E7%BB%93%E6%9E%9C%E5%8F%96\">1. 名字从项目本身取，不从搜索结果取</h3><p>从项目自己的 README 或官网取包名与仓库，然后与配置里的字符串<strong>逐字符</strong>比对。REA 的 README 只列三个来源：<code>morluto/rea</code>、<code>rea.tools</code>、npm 包 <code>rea-agents</code>。其他都不算，包括 README 一模一样的仓库。仿冒品通常只差一个字符：用域名当组织名、一个连字符、一个复数。</p><h3 id=\"2-%E6%9F%A5%E4%BB%93%E5%BA%93%E5%BD%92%E5%B1%9E%EF%BC%8C%E4%BB%A5%E5%8F%8A%E5%AE%83%E6%98%AF%E4%BB%80%E4%B9%88%E6%97%B6%E5%80%99%E5%BB%BA%E7%9A%84\">2. 查仓库归属，以及它是什么时候建的</h3><p>GitHub REST API 会返回仓库创建时间、是否为 fork、以及父仓库。用 <code>gh api --jq</code> 一次打印：</p><pre><code class=\"language-bash\">gh api repos/morluto/rea \\\n  --jq '.created_at, .fork, .parent.full_name'\n</code></pre><p>如果 owner 是组织，也查组织：</p><pre><code class=\"language-bash\">gh api orgs/&lt;org&gt; --jq '.created_at, .public_repos'\n</code></pre><p>一个三天前创建、名下只有一个仓库的组织，却在分发一个六位数 star 的工具——这就是 REA issue 里描述的形状。复制品通常以全新仓库推送，<code>fork: false</code>，所以<strong>日期比 fork 标志更有信息量</strong>。</p><h3 id=\"3-%E7%A1%AE%E8%AE%A4-npm-%E6%8C%87%E5%9B%9E%E5%90%8C%E4%B8%80%E4%B8%AA%E4%BB%93%E5%BA%93\">3. 确认 npm 指回同一个仓库</h3><p><code>npm view</code> 只读注册表元数据，不安装，一次取多个字段：</p><pre><code class=\"language-bash\">npm view rea-agents repository.url maintainers time.created\n</code></pre><p><code>rea-agents</code> 的注册表记录指向 <code>git+https://github.com/morluto/rea.git</code>，维护者账号与仓库 owner 一致——这是你要的匹配。但 <code>repository</code> 是发布者自己写进 <code>package.json</code> 的字段，<strong>谁都能声称自己对应任何仓库</strong>，单独看它证明不了什么。用第 4 项兜底。</p><h3 id=\"4-%E6%9F%A5-provenance%EF%BC%8C%E5%86%8D%E9%AA%8C%E7%AD%BE%E5%90%8D\">4. 查 provenance，再验签名</h3><p>npm provenance 公开声明\"这个包在哪里构建、由谁发布\"。<code>rea-agents@6.5.0</code>（2026-10-16 的 latest）带有 provenance 证明（<code>https://slsa.dev/provenance/v1</code>），由 GitHub Actions 通过 trusted publishing 发布。直接读证明类型：</p><pre><code class=\"language-bash\">npm view rea-agents@6.5.0 \\\n  dist.attestations.provenance.predicateType\n</code></pre><p>要验证包和它拉进来的所有依赖，先装进一个临时目录并<strong>禁止运行脚本</strong>，再验签：</p><pre><code class=\"language-bash\">mkdir mcp-check &amp;&amp; cd mcp-check\nnpm init -y\nnpm install --ignore-scripts rea-agents@6.5.0\nnpm audit signatures\n</code></pre><p>npm 的输出会给出\"签名已验证\"和\"证明已验证\"的包数量。它的边界也写在文档里：provenance <strong>不保证包里没有恶意代码</strong>，它只告诉你 tarball 是哪个仓库、哪条工作流构建的。代码安不安全，仍然要你判断。</p><h3 id=\"5-%E5%9C%A8%E5%AE%89%E8%A3%85%E8%84%9A%E6%9C%AC%E8%BF%90%E8%A1%8C%E4%B9%8B%E5%89%8D%E5%85%88%E8%AF%BB%E5%AE%83\">5. 在安装脚本运行之前先读它</h3><p>npm 文档列出的 <code>preinstall</code>、<code>install</code>、<code>postinstall</code>、<code>prepare</code> 会在 <code>npm install -g &lt;pkg&gt;</code> 时运行（<code>prepare</code> 仅对 git 和本地目录安装）。带 <code>binding.gyp</code> 又没有 <code>install</code>/<code>preinstall</code> 的包，会把 <code>node-gyp rebuild</code> 当作安装步骤。一次问清：</p><pre><code class=\"language-bash\">npm view rea-agents@6.5.0 scripts.preinstall \\\n  scripts.install scripts.postinstall scripts.prepare\n</code></pre><p>REA 6.5.0 没有 <code>preinstall</code>/<code>install</code>/<code>postinstall</code>；它有 <code>\"prepare\": \"node scripts/prepare.mjs\"</code>，但按 npm 文档，<strong>按包名从注册表安装时 <code>prepare</code> 不会运行</strong>。所以从 npm 装，安装期什么都不跑。如果你查的服务器确实有安装钩子，去读它指向的那个文件——第 8 项教你怎么拿到它。</p><h3 id=\"6-%E6%90%9E%E6%B8%85%E4%BD%A0%E7%9A%84-npm-%E4%BC%9A%E6%80%8E%E4%B9%88%E5%A4%84%E7%90%86%E8%84%9A%E6%9C%AC\">6. 搞清你的 npm 会怎么处理脚本</h3><p>先跑 <code>npm --version</code>，因为规则今年变了。<strong>npm 12 默认跳过依赖的安装脚本</strong>，除非你显式允许。对 <code>npx</code> 和全局安装（没有项目 <code>package.json</code> 可放 allowlist），npm 12 文档要求传 <code>--allow-scripts=&lt;pkg&gt;</code>，或用 <code>npm config set allow-scripts=&lt;pkg&gt; --location=user</code> 持久化。</p><p>npm 11 及更早版本默认运行脚本，所以要在 MCP 配置的 <code>npx</code> 参数里加 <code>--ignore-scripts</code>。npm 文档说明它会覆盖 <code>allow-scripts</code>，因此在 12 上也无害。如果某个服务器离开安装步骤就坏，那它<strong>需要</strong>安装期代码——读完那段代码再决定。</p><h3 id=\"7-%E9%94%81%E5%AE%9A%E7%A1%AE%E5%88%87%E7%89%88%E6%9C%AC%EF%BC%8C%E4%B8%8D%E8%A6%81%E7%94%A8-latest\">7. 锁定确切版本，不要用 <code>@latest</code></h3><p>REA 的 README 用 <code>npx -y rea-agents@latest</code> 做一次性 CLI 运行，很多 MCP 安装片段也这么写。但在 MCP 配置里，这一行<strong>每次 agent 启动都会执行</strong>。<code>latest</code> 是移动标签：下一个版本由谁发布，它就指向谁；<code>-y</code> 跳过 npx 的确认提示。</p><p>把检查过的版本钉死：<code>rea-agents@6.5.0</code>。等你要升级那天，npm 的 <code>min-release-age</code> 只安装\"已经发布超过 N 天\"的版本：</p><pre><code class=\"language-ini\"># ~/.npmrc\nmin-release-age=7\n</code></pre><p>一周时间足够让一个被劫持的 release 先被举报，再到达你的 agent。</p><h3 id=\"8-%E6%8A%8A-tarball-%E5%92%8C%E6%BA%90%E7%A0%81%E5%81%9A-diff\">8. 把 tarball 和源码做 diff</h3><p>你的 agent 运行的是注册表上的 tarball，不是你在 GitHub 上读的仓库。用 <code>npm pack</code> 拉下来、解压、和 release tag 对比：</p><pre><code class=\"language-bash\">npm pack rea-agents@6.5.0\ntar -xzf rea-agents-6.5.0.tgz\ngit clone https://github.com/morluto/rea\ngit -C rea checkout &lt;release-tag-or-commit&gt;\ndiff -rq package rea | grep -v '^Only in rea'\n</code></pre><p>checkout 到 release tag，或 provenance 证明里写的那个 commit。过滤掉只在仓库里存在的文件（比如测试），剩下的两类行都要读：<strong>只在 tarball 里的文件</strong>，以及<strong>与 tag 不一致的文件</strong>。未提交的构建产物会出现，这是预期；其余每一项都要看，从 <code>bin</code> 和生命周期脚本指向的文件开始——<strong>这些文件没有人在 GitHub 上审过</strong>。</p><h2 id=\"%E5%9B%9B%E3%80%81%E9%94%81%E5%AE%9A%E7%89%88%E6%9C%AC%E8%A6%81%E8%90%BD%E5%88%B0%E6%AF%8F%E4%B8%AA-agent-%E7%9A%84%E9%85%8D%E7%BD%AE%E9%87%8C\">四、锁定版本要落到每个 agent 的配置里</h2><p>每个 agent CLI 有自己的 MCP 配置，在一个文件里钉版本，对下一个 agent 无效：</p>\n<!--kg-card-begin: html-->\n<table>\n<thead>\n<tr>\n<th>Agent</th>\n<th>项目文件</th>\n<th>用户文件</th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td>Claude Code</td>\n<td><code>.mcp.json</code></td>\n<td><code>~/.claude.json</code></td>\n</tr>\n<tr>\n<td>Codex</td>\n<td><code>.codex/config.toml</code></td>\n<td><code>~/.codex/config.toml</code></td>\n</tr>\n<tr>\n<td>Antigravity CLI</td>\n<td><code>.agents/mcp_config.json</code></td>\n<td><code>~/.gemini/config/mcp_config.json</code></td>\n</tr>\n<tr>\n<td>Copilot CLI</td>\n<td>见官方文档</td>\n<td><code>~/.copilot/mcp-config.json</code></td>\n</tr>\n<tr>\n<td>OpenCode</td>\n<td><code>opencode.json</code>（<code>mcp</code> 键）</td>\n<td>见官方文档</td>\n</tr>\n</tbody>\n</table>\n<!--kg-card-end: html-->\n<p>Claude Code 与 Codex 的钉版本写法（包名占位）：</p><pre><code class=\"language-bash\">claude mcp add --scope project your-server \\\n  -- npx --ignore-scripts -y your-mcp-server@1.4.2\n</code></pre><pre><code class=\"language-toml\">[mcp_servers.your-server]\ncommand = \"npx\"\nargs = [\"--ignore-scripts\", \"-y\", \"your-mcp-server@1.4.2\"]\n</code></pre><p>OpenCode 把同样的参数放进 <code>\"type\": \"local\"</code> 下的 <code>command</code> 数组。</p><p><strong>把 <code>.mcp.json</code> 当代码审。</strong> Claude Code 在交互会话里会先问是否使用项目级服务器，但在 <code>claude -p</code>、Agent SDK 和云运行里，按官方文档它\"不询问就加载项目级服务器\"。如果你的 CI 在 PR 分支上跑 <code>claude -p</code>，那么 PR 里改一行这个文件，下一次任务启动就会执行它。</p><h2 id=\"%E4%BA%94%E3%80%81%E6%8A%8A%E4%B8%A4%E4%BB%B6%E4%BA%8B%E5%90%88%E6%88%90%E4%B8%80%E4%B8%AA%E5%8D%A1%E7%82%B9\">五、把两件事合成一个卡点</h2><p>群体数据回答\"这类东西平均能做什么\"，8 项检查回答\"这一个能不能进我的配置\"。落到流程上，建议在采购/引入环节加一张表：</p>\n<!--kg-card-begin: html-->\n<table>\n<thead>\n<tr>\n<th>检查</th>\n<th>命令/证据</th>\n<th>通过标准</th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td>名称来源</td>\n<td>项目 README / 官网</td>\n<td>与配置逐字符一致</td>\n</tr>\n<tr>\n<td>仓库年龄</td>\n<td><code>gh api repos/&lt;o&gt;/&lt;r&gt; --jq '.created_at,.fork'</code></td>\n<td>不是新近创建的单仓库组织</td>\n</tr>\n<tr>\n<td>npm 回指</td>\n<td><code>npm view &lt;pkg&gt; repository.url</code></td>\n<td>与仓库一致（仅作辅助）</td>\n</tr>\n<tr>\n<td>provenance</td>\n<td><code>npm view &lt;pkg&gt;@&lt;ver&gt; dist.attestations...</code></td>\n<td>有证明且发布者可信</td>\n</tr>\n<tr>\n<td>安装脚本</td>\n<td><code>npm view &lt;pkg&gt;@&lt;ver&gt; scripts.*</code></td>\n<td>无脚本，或脚本已读且可解释</td>\n</tr>\n<tr>\n<td>版本</td>\n<td>配置文件</td>\n<td>钉死 <code>@x.y.z</code>，不用 <code>latest</code></td>\n</tr>\n<tr>\n<td>tarball</td>\n<td><code>npm pack</code> + <code>diff -rq</code></td>\n<td>差异项全部读过</td>\n</tr>\n<tr>\n<td>能力清单</td>\n<td>扫描/人工阅读</td>\n<td>联网、shell、写盘、读取范围有明确理由</td>\n</tr>\n</tbody>\n</table>\n<!--kg-card-end: html-->\n<p>三个典型场景的侧重点不同：</p><ul><li><strong>企业采购</strong>：能力清单 + 数据流向 + 身份模型（是否有短时效身份）优先；没有审计日志的服务器不进生产。</li><li><strong>个人 <code>npx</code> 尝鲜</strong>：至少做第 1、2、7 项，并把 <code>--ignore-scripts</code> 写进配置；不要用 <code>@latest</code>。</li><li><strong>CI / 自动化</strong>：把 <code>.mcp.json</code> 纳入 code review，限制 <code>claude -p</code> 在不可信分支上的运行权限。</li></ul><h2 id=\"%E5%85%AD%E3%80%81%E8%BE%B9%E7%95%8C%EF%BC%9A%E8%BF%99%E4%BB%BD%E4%BD%93%E6%A3%80%E4%B8%8D%E8%83%BD%E8%AF%81%E6%98%8E%E4%BB%80%E4%B9%88\">六、边界：这份体检不能证明什么</h2><ul><li><strong>静态扫描看不到运行时拉取的代码。</strong> 服务器可以在启动后再下载并执行逻辑。</li><li><strong>\"零命中\"只对这一轮规则集成立。</strong> 规则在人群上调过，且更新的规则集会读更多字段。</li><li><strong>能力不是漏洞。</strong> 一个能开 shell 的服务器可能就是为了开 shell；数字描述的是\"Agent 接手后会继承的触达面\"。</li><li><strong>扫描器作者自建了 125 个攻击样本 + 89 个良性样本的基准</strong>，在规则集 76 上全部命中、无误报；但这只能防回归，不能证明它能识别语料之外的攻击。</li><li><strong>单次测量有时点。</strong> 组件会更新，重跑会得到不同数字。</li></ul><h2 id=\"%E4%B8%83%E3%80%81%E7%BB%99%E5%9B%A2%E9%98%9F%E7%9A%84%E4%B8%89%E6%9D%A1%E8%90%BD%E5%9C%B0%E5%BB%BA%E8%AE%AE\">七、给团队的三条落地建议</h2><ol><li><strong>把\"能联网/能开 shell/能写盘/安装期执行\"作为审批字段</strong>，而不是让每个工程师凭感觉判断。</li><li><strong>把版本钉死与 <code>--ignore-scripts</code> 变成默认模板</strong>，在 MCP 配置生成器里写死，减少手工失误。</li><li><strong>给 Agent 的 MCP 配置加一道 diff 门</strong>：配置变更必须出现在 PR diff 里，用户级配置（<code>~/.claude.json</code>、<code>~/.codex/config.toml</code>）单独抽查，因为它们不在仓库里、不会出现在 diff 中。</li></ol><p>如果你正在给团队搭 Agent 工具链，这两份材料值得放在同一页：一张告诉你<strong>风险面有多大</strong>，一张告诉你<strong>单个服务器怎么过关</strong>。前者用于定策略，后者用于做验收。</p><hr><p><strong>Sources</strong></p><ul><li>SkillTotal, <em>What 15,341 MCP servers can do: a static scan of the official registry</em>, dev.to, 2026-10-16：<a href=\"https://dev.to/dmitrii_p_762d68551e7b37f/what-15341-mcp-servers-can-do-a-static-scan-of-the-official-registry-1a93?ref=hubwiz.com\">https://dev.to/dmitrii_p_762d68551e7b37f/what-15341-mcp-servers-can-do-a-static-scan-of-the-official-registry-1a93</a>（报告与聚合数据：<a href=\"https://github.com/pezhik/skilltotal?ref=hubwiz.com\">https://github.com/pezhik/skilltotal</a>）</li><li>Gabriel Anhaia, <em>Before You npx an MCP Server: 8 Checks That Would Have Caught the Fake REA Repo</em>, dev.to, 2026-10-16：<a href=\"https://dev.to/gabrielanhaia/before-you-npx-an-mcp-server-8-checks-that-would-have-caught-the-fake-rea-repo-300o?ref=hubwiz.com\">https://dev.to/gabrielanhaia/before-you-npx-an-mcp-server-8-checks-that-would-have-caught-the-fake-rea-repo-300o</a></li><li>REA issue #2424 / PR #2429：<a href=\"https://github.com/morluto/rea/issues/2424?ref=hubwiz.com\">https://github.com/morluto/rea/issues/2424</a></li></ul><p><strong>相关阅读</strong>：<a href=\"https://www.hubwiz.com/blog/agent-stack/\">Agent / MCP / 自动化完全指南</a> ｜ <a href=\"https://www.hubwiz.com/blog/agent-security-nine-incidents-six-controls/\">Agent 安全九起事故与六项控制</a> ｜ <a href=\"https://www.hubwiz.com/blog/mcp-tool-count-1932-runs-measured/\">192 次运行实测：MCP 工具数量的真实成本</a></p><p>本文由汇智网编译整理，转载请注明出处。文中数字均来自上述 2026-10-16 的公开材料；扫描器与 IDE 作者的商业立场已在文首披露。</p><blockquote><strong>这是「Agent / MCP」专题的一部分。</strong>完整地图见：<a href=\"https://www.hubwiz.com/blog/agent-stack/\">Agent / MCP / 自动化完全指南</a></blockquote>\n        </section>\n\n    </article>\n\n\n</main>\n\n\n            <section class=\"gh-container is-grid gh-outer\">\n                <div class=\"gh-container-inner gh-inner\">\n                    <h2 class=\"gh-container-title\">阅读更多</h2>\n                    <div class=\"gh-feed\">\n                            <article class=\"gh-card post\">\n    <a class=\"gh-card-link\" href=\"/blog/claude-code-tia-portal-mcp/\">\n            <figure class=\"gh-card-image\">\n                <img\n                    srcset=\"/blog/content/images/size/w160/format/webp/2026/10/claude-code-tia-portal-mcp-cover-800.jpg 160w,\n                            /blog/content/images/size/w320/format/webp/2026/10/claude-code-tia-portal-mcp-cover-800.jpg 320w,\n                            /blog/content/images/size/w600/format/webp/2026/10/claude-code-tia-portal-mcp-cover-800.jpg 600w,\n                            /blog/content/images/size/w960/format/webp/2026/10/claude-code-tia-portal-mcp-cover-800.jpg 960w,\n                            /blog/content/images/size/w1200/format/webp/2026/10/claude-code-tia-portal-mcp-cover-800.jpg 1200w,\n                            /blog/content/images/size/w2000/format/webp/2026/10/claude-code-tia-portal-mcp-cover-800.jpg 2000w\"\n                    sizes=\"auto, (max-width: 1199px) 100vw, 980px\"\n                    src=\"/blog/content/images/size/w600/2026/10/claude-code-tia-portal-mcp-cover-800.jpg\"\n                    alt=\"Claude Code 接博途：从空工程到跑通仿真的全链路\"\n                    loading=\"lazy\"\n                >\n            </figure>\n        <div class=\"gh-card-wrapper\">\n            <h3 class=\"gh-card-title is-title\">Claude Code 接博途：从空工程到跑通仿真的全链路</h3>\n                <p class=\"gh-card-excerpt is-body\">一句话需求 → 它自己写 FB → 编译 0 错 0 警 → 下载进仿真器 → 三个场景全部对上。</p>\n            <footer class=\"gh-card-meta\">\n<!--\n             -->\n                    <span class=\"gh-card-author\">By admin</span>\n                    <time class=\"gh-card-date\" datetime=\"2026-10-27\">27 10月 2026</time>\n                <!--\n         --></footer>\n        </div>\n    </a>\n</article>\n                            <article class=\"gh-card post\">\n    <a class=\"gh-card-link\" href=\"/blog/mixed-brand-plc-lines-ai-integration/\">\n            <figure class=\"gh-card-image\">\n                <img\n                    srcset=\"/blog/content/images/size/w160/format/webp/2026/10/mixed-brand-plc-lines-ai-integration-cover-800.jpg 160w,\n                            /blog/content/images/size/w320/format/webp/2026/10/mixed-brand-plc-lines-ai-integration-cover-800.jpg 320w,\n                            /blog/content/images/size/w600/format/webp/2026/10/mixed-brand-plc-lines-ai-integration-cover-800.jpg 600w,\n                            /blog/content/images/size/w960/format/webp/2026/10/mixed-brand-plc-lines-ai-integration-cover-800.jpg 960w,\n                            /blog/content/images/size/w1200/format/webp/2026/10/mixed-brand-plc-lines-ai-integration-cover-800.jpg 1200w,\n                            /blog/content/images/size/w2000/format/webp/2026/10/mixed-brand-plc-lines-ai-integration-cover-800.jpg 2000w\"\n                    sizes=\"auto, (max-width: 1199px) 100vw, 980px\"\n                    src=\"/blog/content/images/size/w600/2026/10/mixed-brand-plc-lines-ai-integration-cover-800.jpg\"\n                    alt=\"一条产线四种 PLC：AI 接入能走到哪一步\"\n                    loading=\"lazy\"\n                >\n            </figure>\n        <div class=\"gh-card-wrapper\">\n            <h3 class=\"gh-card-title is-title\">一条产线四种 PLC：AI 接入能走到哪一步</h3>\n                <p class=\"gh-card-excerpt is-body\">混合产线接 AI 卡住的从来不是模型：能&quot;改工程&quot;的只有三类接口，其余只能读运行时。六家逐一拆开看。</p>\n            <footer class=\"gh-card-meta\">\n<!--\n             -->\n                    <span class=\"gh-card-author\">By admin</span>\n                    <time class=\"gh-card-date\" datetime=\"2026-10-27\">27 10月 2026</time>\n                <!--\n         --></footer>\n        </div>\n    </a>\n</article>\n                            <article class=\"gh-card post\">\n    <a class=\"gh-card-link\" href=\"/blog/siemens-eigen-engineering-agent/\">\n            <figure class=\"gh-card-image\">\n                <img\n                    srcset=\"/blog/content/images/size/w160/format/webp/2026/10/siemens-eigen-engineering-agent-cover-800.jpg 160w,\n                            /blog/content/images/size/w320/format/webp/2026/10/siemens-eigen-engineering-agent-cover-800.jpg 320w,\n                            /blog/content/images/size/w600/format/webp/2026/10/siemens-eigen-engineering-agent-cover-800.jpg 600w,\n                            /blog/content/images/size/w960/format/webp/2026/10/siemens-eigen-engineering-agent-cover-800.jpg 960w,\n                            /blog/content/images/size/w1200/format/webp/2026/10/siemens-eigen-engineering-agent-cover-800.jpg 1200w,\n                            /blog/content/images/size/w2000/format/webp/2026/10/siemens-eigen-engineering-agent-cover-800.jpg 2000w\"\n                    sizes=\"auto, (max-width: 1199px) 100vw, 980px\"\n                    src=\"/blog/content/images/size/w600/2026/10/siemens-eigen-engineering-agent-cover-800.jpg\"\n                    alt=\"西门子 Eigen：官方 AI Agent 能替工程师做到哪一步\"\n                    loading=\"lazy\"\n                >\n            </figure>\n        <div class=\"gh-card-wrapper\">\n            <h3 class=\"gh-card-title is-title\">西门子 Eigen：官方 AI Agent 能替工程师做到哪一步</h3>\n                <p class=\"gh-card-excerpt is-body\">西门子官方 AI agent 已经进 TIA Portal：它读工程上下文、按目标执行、自己纠错，但云、锁生态、工具面固定这三条决定了它适合谁。</p>\n            <footer class=\"gh-card-meta\">\n<!--\n             -->\n                    <span class=\"gh-card-author\">By admin</span>\n                    <time class=\"gh-card-date\" datetime=\"2026-10-27\">27 10月 2026</time>\n                <!--\n         --></footer>\n        </div>\n    </a>\n</article>\n                            <article class=\"gh-card post\">\n    <a class=\"gh-card-link\" href=\"/blog/tia-portal-openness-mcp-write-guards/\">\n            <figure class=\"gh-card-image\">\n                <img\n                    srcset=\"/blog/content/images/size/w160/format/webp/2026/10/tia-portal-openness-mcp-write-guards-cover-800.jpg 160w,\n                            /blog/content/images/size/w320/format/webp/2026/10/tia-portal-openness-mcp-write-guards-cover-800.jpg 320w,\n                            /blog/content/images/size/w600/format/webp/2026/10/tia-portal-openness-mcp-write-guards-cover-800.jpg 600w,\n                            /blog/content/images/size/w960/format/webp/2026/10/tia-portal-openness-mcp-write-guards-cover-800.jpg 960w,\n                            /blog/content/images/size/w1200/format/webp/2026/10/tia-portal-openness-mcp-write-guards-cover-800.jpg 1200w,\n                            /blog/content/images/size/w2000/format/webp/2026/10/tia-portal-openness-mcp-write-guards-cover-800.jpg 2000w\"\n                    sizes=\"auto, (max-width: 1199px) 100vw, 980px\"\n                    src=\"/blog/content/images/size/w600/2026/10/tia-portal-openness-mcp-write-guards-cover-800.jpg\"\n                    alt=\"AI 改博途程序：TIA Openness MCP 的写保护与边界\"\n                    loading=\"lazy\"\n                >\n            </figure>\n        <div class=\"gh-card-wrapper\">\n            <h3 class=\"gh-card-title is-title\">AI 改博途程序：TIA Openness MCP 的写保护与边界</h3>\n                <p class=\"gh-card-excerpt is-body\">让 AI 改博途程序已经能跑通，但关键不是&quot;能不能写&quot;，而是写完怎么证明没写坏。拆四个近期项目里的写保护设计。</p>\n            <footer class=\"gh-card-meta\">\n<!--\n             -->\n                    <span class=\"gh-card-author\">By admin</span>\n                    <time class=\"gh-card-date\" datetime=\"2026-10-27\">27 10月 2026</time>\n                <!--\n         --></footer>\n        </div>\n    </a>\n</article>\n                    </div>\n                </div>\n            </section>\n\n    \n    <footer class=\"gh-footer gh-outer\">\n    <div class=\"gh-footer-inner gh-inner\">\n\n                <section class=\"gh-footer-signup\">\n                    <h2 class=\"gh-footer-signup-header is-title\">\n                        Software 2.0\n                    </h2>\n                    <p class=\"gh-footer-signup-subhead is-body\">\n                        Curated AI &amp; engineering insights.\n                    </p>\n                    <form class=\"gh-form\" data-members-form>\n    <input class=\"gh-form-input\" id=\"footer-email\" name=\"email\" type=\"email\" placeholder=\"张伟@示例.com\" required data-members-email>\n    <button class=\"gh-button\" type=\"submit\" aria-label=\"订阅\">\n        <span><span>订阅</span> <svg xmlns=\"http://www.w3.org/2000/svg\" width=\"32\" height=\"32\" fill=\"currentColor\" viewBox=\"0 0 256 256\"><path d=\"M224.49,136.49l-72,72a12,12,0,0,1-17-17L187,140H40a12,12,0,0,1,0-24H187L135.51,64.48a12,12,0,0,1,17-17l72,72A12,12,0,0,1,224.49,136.49Z\"></path></svg></span>\n        <svg xmlns=\"http://www.w3.org/2000/svg\" height=\"24\" width=\"24\" viewBox=\"0 0 24 24\">\n    <g stroke-linecap=\"round\" stroke-width=\"2\" fill=\"currentColor\" stroke=\"none\" stroke-linejoin=\"round\" class=\"nc-icon-wrapper\">\n        <g class=\"nc-loop-dots-4-24-icon-o\">\n            <circle cx=\"4\" cy=\"12\" r=\"3\"></circle>\n            <circle cx=\"12\" cy=\"12\" r=\"3\"></circle>\n            <circle cx=\"20\" cy=\"12\" r=\"3\"></circle>\n        </g>\n        <style data-cap=\"butt\">\n            .nc-loop-dots-4-24-icon-o{--animation-duration:0.8s}\n            .nc-loop-dots-4-24-icon-o *{opacity:.4;transform:scale(.75);animation:nc-loop-dots-4-anim var(--animation-duration) infinite}\n            .nc-loop-dots-4-24-icon-o :nth-child(1){transform-origin:4px 12px;animation-delay:-.3s;animation-delay:calc(var(--animation-duration)/-2.666)}\n            .nc-loop-dots-4-24-icon-o :nth-child(2){transform-origin:12px 12px;animation-delay:-.15s;animation-delay:calc(var(--animation-duration)/-5.333)}\n            .nc
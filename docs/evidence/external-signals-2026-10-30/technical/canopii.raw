r]:hidden\",\"children\":[[\"$\",\"div\",null,{\"className\":\"min-w-0\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"font-heading text-lg font-semibold\",\"children\":\"Security controls\"}],[\"$\",\"p\",null,{\"className\":\"mt-1 text-sm text-pretty text-muted-foreground\",\"children\":\"Deterministic, evidence-backed. Score earned from passing controls; a failed guard caps it.\"}]]}],\"$L22\"]}],\"$L23\"]}],\"$L24\"]}]]}]\n"])</script><script>self.__next_f.push([1,"22:[\"$\",\"$L1a\",null,{\"ref\":\"$undefined\",\"iconNode\":[[\"path\",{\"d\":\"m6 9 6 6 6-6\",\"key\":\"qrunsl\"}]],\"className\":\"lucide-chevron-down mt-1 size-5 shrink-0 text-muted-foreground transition-transform group-open:rotate-180\"}]\n"])</script><script>self.__next_f.push([1,"23:[\"$\",\"div\",null,{\"className\":\"mt-6\",\"children\":[\"$\",\"div\",null,{\"className\":\"flex flex-col gap-7\",\"children\":[[\"$\",\"section\",\"runtime_guardrails\",{\"children\":[[\"$\",\"h3\",null,{\"className\":\"font-heading text-sm font-semibold tracking-wide text-muted-foreground uppercase\",\"children\":\"Model–MCP Runtime Guardrails\"}],[\"$\",\"ul\",null,{\"className\":\"mt-1 divide-y divide-border/50\",\"children\":[[\"$\",\"li\",\"tool.schemas_strict\",{\"className\":\"flex gap-3 py-3\",\"children\":[[\"$\",\"span\",null,{\"className\":\"inline-flex h-6 w-28 shrink-0 items-center justify-center gap-1 rounded-full text-xs font-semibold ring-1 bg-ochre/15 text-ochre ring-ochre/30\",\"children\":[[\"$\",\"$L1a\",null,{\"ref\":\"$undefined\",\"iconNode\":[[\"path\",{\"d\":\"m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3\",\"key\":\"wmoenq\"}],[\"path\",{\"d\":\"M12 9v4\",\"key\":\"juzpu7\"}],[\"path\",{\"d\":\"M12 17h.01\",\"key\":\"p32p05\"}]],\"className\":\"lucide-triangle-alert size-3.5\"}],\"Warn\"]}],[\"$\",\"div\",null,{\"className\":\"min-w-0 flex-1\",\"children\":[[\"$\",\"div\",null,{\"className\":\"flex flex-wrap items-baseline gap-x-2\",\"children\":[[\"$\",\"span\",null,{\"className\":\"font-medium break-words\",\"children\":\"Strict JSON Schema Enforcement\"}],false,[\"$\",\"span\",null,{\"className\":\"min-w-0 break-words text-xs text-muted-foreground\",\"children\":\"schemas not strict\"}]]}],[\"$\",\"p\",null,{\"className\":\"mt-0.5 text-sm text-pretty text-muted-foreground\",\"children\":[\"Tool inputs are constrained (additionalProperties:false), so unexpected arguments can't be smuggled in.\",false]}],false,[\"$\",\"p\",null,{\"className\":\"mt-1 text-xs text-jungle\",\"children\":[\"Fix: \",\"Set additionalProperties:false and require explicit parameters on every tool.\"]}]]}]]}],[\"$\",\"li\",\"tool.no_injection_markers\",{\"className\":\"flex gap-3 py-3\",\"children\":[[\"$\",\"span\",null,{\"className\":\"inline-flex h-6 w-28 shrink-0 items-center justify-center gap-1 rounded-full text-xs font-semibold ring-1 bg-jungle/10 text-jungle ring-jungle/20\",\"children\":[[\"$\",\"$L1a\",null,{\"ref\":\"$undefined\",\"iconNode\":[[\"path\",{\"d\":\"M20 6 9 17l-5-5\",\"key\":\"1gmf2c\"}]],\"className\":\"lucide-check size-3.5\"}],\"Pass\"]}],[\"$\",\"div\",null,{\"className\":\"min-w-0 flex-1\",\"children\":[[\"$\",\"div\",null,{\"className\":\"flex flex-wrap items-baseline gap-x-2\",\"children\":[[\"$\",\"span\",null,{\"className\":\"font-medium break-words\",\"children\":\"Indirect Prompt Injection (IPI) Defenses\"}],[\"$\",\"span\",null,{\"className\":\"rounded bg-secondary px-1 py-0.5 text-[0.6rem] font-medium tracking-wide text-muted-foreground uppercase\",\"children\":\"guard\"}],[\"$\",\"span\",null,{\"className\":\"min-w-0 break-words text-xs text-muted-foreground\",\"children\":\"no injection markers\"}]]}],[\"$\",\"p\",null,{\"className\":\"mt-0.5 text-sm text-pretty text-muted-foreground\",\"children\":[\"Tool/prompt/resource text is free of hidden instructions that could hijack the agent.\",false]}],false,false]}]]}],[\"$\",\"li\",\"tool.no_rug_pull\",{\"className\":\"flex gap-3 py-3\",\"children\":[[\"$\",
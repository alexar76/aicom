league\"}],[\"$\",\"meta\",\"4\",{\"name\":\"mobile-web-app-capable\",\"content\":\"yes\"}],[\"$\",\"meta\",\"5\",{\"name\":\"apple-mobile-web-app-title\",\"content\":\"FPL Cat\"}],[\"$\",\"meta\",\"6\",{\"name\":\"apple-mobile-web-app-status-bar-style\",\"content\":\"black-translucent\"}],[\"$\",\"meta\",\"7\",{\"property\":\"og:title\",\"content\":\"Bot user agents could be a surprisingly good way to advertise to developers\"}],[\"$\",\"meta\",\"8\",{\"property\":\"og:description\",\"content\":\"I built an MCP server for FPL. Then 145 user-agent strings showed up: assistants, crawlers, uptime bots, and a surprisingly effective way to advertise to developers.\"}],[\"$\",\"meta\",\"9\",{\"property\":\"og:url\",\"content\":\"https://fplcat.com/blog/ai-agents-playing-fantasy-premier-league\"}],[\"$\",\"meta\",\"10\",{\"property\":\"og:site_name\",\"content\":\"FPL Cat\"}],[\"$\",\"meta\",\"11\",{\"property\":\"og:image\",\"content\":\"https://fplcat.com/blog/ai-agents-playing-fantasy-premier-league/opengraph-image?6973afa434b95d0b\"}],[\"$\",\"meta\",\"12\",{\"property\":\"og:image:type\",\"content\":\"image/png\"}],[\"$\",\"meta\",\"13\",{\"property\":\"og:image:width\",\"content\":\"1200\"}],[\"$\",\"meta\",\"14\",{\"property\":\"og:image:height\",\"content\":\"630\"}],[\"$\",\"meta\",\"15\",{\"property\":\"og:image:alt\",\"content\":\"FPL Cat blog post\"}],[\"$\",\"meta\",\"16\",{\"property\":\"og:type\",\"content\":\"article\"}],[\"$\",\"meta\",\"17\",{\"property\":\"article:published_time\",\"content\":\"2026-10-13\"}],[\"$\",\"meta\",\"18\",{\"property\":\"article:modified_time\",\"content\":\"2026-10-13\"}],[\"$\",\"meta\",\"19\",{\"name\":\"twitter:card\",\"content\":\"summary_large_image\"}],[\"$\",\"meta\",\"20\",{\"name\":\"twitter:title\",\"content\":\"Bot user agents could be a surprisingly good way to advertise to developers\"}],[\"$\",\"meta\",\"21\",{\"name\":\"twitter:description\",\"content\":\"I built an MCP server for FPL. Then 145 user-agent strings showed up: assistants, crawlers, uptime bots, and a surprisingly effective way to advertise to developers.\"}],[\"$\",\"meta\",\"22\",{\"name\":\"twitter:image\",\"content\":\"https://fplcat.com/blog/ai-agents-playing-fantasy-premier-league/twitter-image?6973afa434b95d0b\"}],[\"$\",\"meta\",\"23\",{\"name\":\"twitter:image:alt\",\"content\":\"FPL Cat blog post\"}],[\"$\",\"meta\",\"24\",{\"name\":\"twitter:image:type\",\"content\":\"image/png\"}],[\"$\",\"meta\",\"25\",{\"name\":\"twitter:image:width\",\"content\":\"1200\"}],[\"$\",\"meta\",\"26\",{\"name\":\"twitter:image:height\",\"content\":\"630\"}],[\"$\",\"link\",\"27\",{\"rel\":\"icon\",\"href\":\"/favicon.ico?6b14a0819a4f0b6c\",\"type\":\"image/x-icon\",\"sizes\":\"16x16\"}],[\"$\",\"link\",\"28\",{\"rel\":\"icon\",\"href\":\"/icon.png?bdea7e2865e67f13\",\"type\":\"image/png\",\"sizes\":\"64x64\"}],[\"$\",\"link\",\"29\",{\"rel\":\"apple-touch-icon\",\"href\":\"/apple-icon.png?ee9d5b3c90f12520\",\"type\":\"image/png\",\"sizes\":\"180x180\"}],[\"$\",\"$L29\",\"30\",{}]]\n"])</script><script>(function(){function c(){var b=a.contentDocument||(a.contentWindow&&a.contentWindow.document);if(b){var d=b.createElement('script');d.innerHTML="window.__CF$cv$params={r:'a5277ff169c54f9d',t:'MTc5MzMzMjY4Nw=='};var l=window.parent.location,o;try{o=new URL(l.origin).origin}catch(e){try{o=new URL(new URL(l.href).origin).origin}catch(e){o=''}}var u='/cdn-cgi/challenge-platform/scripts/jsd/main.js?ray=a5277ff169c54f9d',a=document.createElement('script');a.src=o?new URL(u,o).href:u;document.getElementsByTagName('head')[0].appendChild(a);";b.getElementsByTagName('head')[0].appendChild(d)}}if(document.body){var a=document.createElement('iframe');a.height=1;a.width=1;a.style.position='absolute';a.style.top=0;a.style.left=0;a.style.border='none';a.style.visibility='hidden';document.body.appendChild(a);if('loading'!==document.readyState)c();else if(window.addEventListener)document.addEventListener('DOMContentLoaded',c);else{var e=document.onreadystatechange||function(){};document.onreadystatechange=function(b){e(b);'loading'!==document.readyState&&(document.onreadystatechange=e,c())}}}})();</script></body></html>
[{"url":"https://api.github.com/repos/GenAI-Security-Project/GenAI-Red-Team-Lab/issues/comments/6374599458","html_url":"https://github.com/GenAI-Security-Project/GenAI-Red-Team-Lab/issues/105#issuecomment-6374599458","issue_url":"https://api.github.com/repos/GenAI-Security-Project/GenAI-Red-Team-Lab/issues/105","id":6374599458,"node_id":"IC_kwDOQymAkc8AAAABe_SrIg","user":{"login":"alexar76","id":86793359,"node_id":"MDQ6VXNlcjg2NzkzMzU5","avatar_url":"https://avatars.githubusercontent.com/u/86793359?v=4","gravatar_id":"","url":"https://api.github.com/users/alexar76","html_url":"https://github.com/alexar76","followers_url":"https://api.github.com/users/alexar76/followers","following_url":"https://api.github.com/users/alexar76/following{/other_user}","gists_url":"https://api.github.com/users/alexar76/gists{/gist_id}","starred_url":"https://api.github.com/users/alexar76/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/alexar76/subscriptions","organizations_url":"https://api.github.com/users/alexar76/orgs","repos_url":"https://api.github.com/users/alexar76/repos","events_url":"https://api.github.com/users/alexar76/events{/privacy}","received_events_url":"https://api.github.com/users/alexar76/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-10-23T20:57:53Z","updated_at":"2026-10-23T20:57:53Z","body":"For realistic fixtures: the rug-pull case does not need invented edits. HISTOR, a public log of MCP tool definitions, has 23,821 recorded changes from 24 Sep to 20 Oct 2026 (CC BY 4.0, https://histor.modelmarket.dev/datasets/), field by field, including description rewrites on servers that were already approved. A scenario could replay a real change set against the client under test, which keeps the benign/malicious ratio honest: about half of real changes are ordinary description edits. Happy to pull a sample if the lab wants one.\n","author_association":"NONE","pin":null,"reactions":{"url":"https://api.
er action={mockAction}>\n+\t\t\t\t<input type=\"text\" placeholder=\"名前\" />\n+\t\t\t\t<button type=\"submit\">保存</button>\n+\t\t\t</FormContainer>\n+\t\t);\n+\t\texpect(screen.getByPlaceholderText(\"名前\")).toBeInTheDocument();\n+\t\texpect(screen.getByText(\"保存\")).toBeInTheDocument();\n+\t});","path":"__tests__/components/form/FormContainer.test.tsx","commit_id":"f27220ad6e86838597f6c40637e4d585ffc8afe6","original_commit_id":"7ea909a45600d9bca8eac77d3d32be6a00081e24","user":{"login":"myoshi2891","id":96483039,"node_id":"U_kgDOBcA23w","avatar_url":"https://avatars.githubusercontent.com/u/96483039?v=4","gravatar_id":"","url":"https://api.github.com/users/myoshi2891","html_url":"https://github.com/myoshi2891","followers_url":"https://api.github.com/users/myoshi2891/followers","following_url":"https://api.github.com/users/myoshi2891/following{/other_user}","gists_url":"https://api.github.com/users/myoshi2891/gists{/gist_id}","starred_url":"https://api.github.com/users/myoshi2891/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/myoshi2891/subscriptions","organizations_url":"https://api.github.com/users/myoshi2891/orgs","repos_url":"https://api.github.com/users/myoshi2891/repos","events_url":"https://api.github.com/users/myoshi2891/events{/privacy}","received_events_url":"https://api.github.com/users/myoshi2891/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"make it as an issue","created_at":"2026-05-22T16:39:20Z","updated_at":"2026-05-22T16:39:20Z","html_url":"https://github.com/myoshi2891/Next-Store/pull/28#discussion_r3289882471","pull_request_url":"https://api.github.com/repos/myoshi2891/Next-Store/pulls/28","_links":{"self":{"href":"https://api.github.com/repos/myoshi2891/Next-Store/pulls/comments/3289882471"},"html":{"href":"https://github.com/myoshi2891/Next-Store/pull/28#discussion_r3289882471"},"pull_request":{"href":"https://api.github.com/repos/myoshi2891/Next-Store/pulls/28"}},"reactions":{"url":"
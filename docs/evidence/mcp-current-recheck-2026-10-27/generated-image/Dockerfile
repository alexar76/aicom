# MCP Server: aifactory/audit-echo
FROM python:3.12-slim
WORKDIR /app
RUN pip install --no-cache-dir 'aimarket-mcp>=0.6.3,<0.7' 'jsonschema>=4.23,<5'
RUN python -c "import base64,pathlib; pathlib.Path('/app/mcp_server.py').write_bytes(base64.b64decode(''))"
ENV MCP_SERVER_NAME=audit-echo
ENV HOME=/tmp PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1
USER 10001:10001
ENTRYPOINT ["python", "/app/mcp_server.py"]

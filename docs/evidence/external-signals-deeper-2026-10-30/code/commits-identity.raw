dditive field_changes array\n  ({path, op, before, after, severity, category}) derived from the\n  comparables and the stored field->type contract maps: a field\n  flipping string -> number at an unchanged score now yields a named\n  type_changed entry (alexar76/aicom#13). Legacy changes[],\n  schema_score_stability and contract_stability keep their meanings.\n- Docs: README, skill.md, llms.txt describe the new read.\nTests: 85 -> 93 passed.","tree":{"url":"https://api.github.com/repos/QuincyGB/route-verdict/git/trees/18b1ef04d7f7bc5cce4a1914538e551d79c897fc","sha":"18b1ef04d7f7bc5cce4a1914538e551d79c897fc"},"comment_count":0},"author":null,"committer":null,"parents":[{"url":"https://api.github.com/repos/QuincyGB/route-verdict/commits/15aec9f488494efeaa981fb80cc5800cd5dd7f40","html_url":"https://github.com/QuincyGB/route-verdict/commit/15aec9f488494efeaa981fb80cc5800cd5dd7f40","sha":"15aec9f488494efeaa981fb80cc5800cd5dd7f40"}],"repository":{"id":1428909708,"node_id":"R_kgDOVStujA","name":"route-verdict","full_name":"QuincyGB/route-verdict","private":false,"owner":{"login":"QuincyGB","id":46060784,"node_id":"MDQ6VXNlcjQ2MDYwNzg0","avatar_url":"https://avatars.githubusercontent.com/u/46060784?v=4","gravatar_id":"","url":"https://api.github.com/users/QuincyGB","html_url":"https://github.com/QuincyGB","followers_url":"https://api.github.com/users/QuincyGB/followers","following_url":"https://api.github.com/users/QuincyGB/following{/other_user}","gists_url":"https://api.github.com/users/QuincyGB/gists{/gist_id}","starred_url":"https://api.github.com/users/QuincyGB/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/QuincyGB/subscriptions","organizations_url":"https://api.github.com/users/QuincyGB/orgs","repos_url":"https://api.github.com/users/QuincyGB/repos","events_url":"https://api.github.com/users/QuincyGB/events{/privacy}","received_events_url":"https://api.github.com/users/QuincyGB/received_events","type":"User","user_view_type":"public","site_
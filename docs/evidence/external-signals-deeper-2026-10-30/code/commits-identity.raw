ts_url":"https://api.github.com/repos/QuincyGB/route-verdict/commits{/sha}","git_commits_url":"https://api.github.com/repos/QuincyGB/route-verdict/git/commits{/sha}","comments_url":"https://api.github.com/repos/QuincyGB/route-verdict/comments{/number}","issue_comment_url":"https://api.github.com/repos/QuincyGB/route-verdict/issues/comments{/number}","contents_url":"https://api.github.com/repos/QuincyGB/route-verdict/contents/{+path}","compare_url":"https://api.github.com/repos/QuincyGB/route-verdict/compare/{base}...{head}","merges_url":"https://api.github.com/repos/QuincyGB/route-verdict/merges","archive_url":"https://api.github.com/repos/QuincyGB/route-verdict/{archive_format}{/ref}","downloads_url":"https://api.github.com/repos/QuincyGB/route-verdict/downloads","issues_url":"https://api.github.com/repos/QuincyGB/route-verdict/issues{/number}","pulls_url":"https://api.github.com/repos/QuincyGB/route-verdict/pulls{/number}","milestones_url":"https://api.github.com/repos/QuincyGB/route-verdict/milestones{/number}","notifications_url":"https://api.github.com/repos/QuincyGB/route-verdict/notifications{?since,all,participating}","labels_url":"https://api.github.com/repos/QuincyGB/route-verdict/labels{/name}","releases_url":"https://api.github.com/repos/QuincyGB/route-verdict/releases{/id}","deployments_url":"https://api.github.com/repos/QuincyGB/route-verdict/deployments"},"score":1.0},{"url":"https://api.github.com/repos/QuincyGB/stall-row/commits/9303c9d6e9862c599711e979a8acba342dc634d7","sha":"9303c9d6e9862c599711e979a8acba342dc634d7","node_id":"MDY6Q29tbWl0MTQyODk3MzcxNjo5MzAzYzlkNmU5ODYyYzU5OTcxMWU5NzlhOGFjYmEzNDJkYzYzNGQ3","html_url":"https://github.com/QuincyGB/stall-row/commit/9303c9d6e9862c599711e979a8acba342dc634d7","comments_url":"https://api.github.com/repos/QuincyGB/stall-row/commits/9303c9d6e9862c599711e979a8acba342dc634d7/comments","commit":{"url":"https://api.github.com/repos/QuincyGB/stall-row/git/commits/9303c9d6e9862c599711e979a8acba342dc634d7","author":{"date":"2026-10-30T01:42:39.000Z","name":"Ren","email":"ren@agentworld.me"},"committer":{"date":"2026-10-30T01:42:39.000Z","name":"Ren","email":"ren@agentworld.me"},"message":"Recheck feed: free public JSONL of recent check responses at GET /v1/recheck/feed\n\nEvery completed check now appends its exact response object to a\nrecheck_history table in the watch store (recorded inside recheck()\nitself, so per-call, pack-spent, and scheduled checks are all\nrecorded once). The feed serves the last 100, newest first, as\napplication/x-ndjson — the observatory surface promised to the\naicom survey (alexar76/aicom#13).\n\nWatches that pre-date the history are seeded with one record built\nonly from the stored watch state (watch id, URL, kind, fingerprint\nas current, checked_at); their per-check status/changes/summary\nwere never stored and are omitted, never reconstructed.","tree":{"url":"https://api.github.com/repos/QuincyGB/stall-row/git/trees/f35cbd34e9638ba3d7acd87fbc3032ac2bd1caef","sha":"f35cbd34e9638ba3d7acd87fbc3032ac2bd1caef"},"comment_count":0},"author":null,"committer":null,"parents":[{"url":"https://api.github.com/repos/QuincyGB/stall-row/commits/850dda8a5230dee80b5af69b87a3086a21173d17","html_url":"https://github.com/QuincyGB/stall-row/commit/850dda8a5230dee80b5af69b87a3086a21173d17","sha":"850dda8a5230dee80b5af69b87a3086a21173d17"}],"repository":{"id":1428973716,"node_id":"R_kgDOVSxolA","name":"stall-row","full_name":"QuincyGB/stall-row","private":false,"owner":{"login":"QuincyGB","id":46060784,"node_id":"MDQ6VXNlcjQ2MDYwNzg0","avatar_url":"https://avatars.githubusercontent.com/u/46060784?v=4","gravatar_id":"","url":"https://api.github.com/users/QuincyGB","html_url":"https://github.com/QuincyGB","followers_url":"https://api.github.com/users/QuincyGB/followers","following_url":"https://api.github.com/users/QuincyGB/following{/other_user}","gists_url":"https://api.github.com/users/QuincyGB/gists{/gist_id}","starred_url":"https://api.github.com/users/Quin
{"sha":"15aec9f488494efeaa981fb80cc5800cd5dd7f40","node_id":"C_kwDOVStujNoAKDE1YWVjOWY0ODg0OTRlZmVhYTk4MWZiODBjYzU4MDBjZDVkZDdmNDA","commit":{"author":{"name":"Ren","email":"ren@agentworld.me","date":"2026-10-30T01:38:01Z"},"committer":{"name":"Ren","email":"ren@agentworld.me","date":"2026-10-30T01:38:01Z"},"message":"Check-store persistence: resolve DB onto a mounted volume, report storage in /health\n\nThe diff memory (prior-check sqlite) lived on the container's\nephemeral disk, so every redeploy silently wiped it — a buyer's\nround-2 diff came back 'no prior check on record' after the\n2026-10-29 price-fix deploy (alexar76/aicom#13).\n\nMirror StallRow's pattern: resolve_db_path() picks\nROUTE_VERDICT_DB if set, else /data/route-verdict.db when a\nvolume is mounted at /data, else the plain relative filename;\ndurability is measured (nearest existing ancestor is a mount\npoint), never assumed from the path. Settings gains\ndb_persistent, and /health reports storage.check_store /\nstorage.check_db_path so a reset is visible from outside.\n\nTests: health storage assertion + resolver unit tests (85 pass).","tree":{"sha":"2a0869437e38519c6fde738021dbfd3a576ac33e","url":"https://api.github.com/repos/QuincyGB/route-verdict/git/trees/2a0869437e38519c6fde738021dbfd3a576ac33e"},"url":"https://api.github.com/repos/QuincyGB/route-verdict/git/commits/15aec9f488494efeaa981fb80cc5800cd5dd7f40","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/QuincyGB/route-verdict/commits/15aec9f488494efeaa981fb80cc5800cd5dd7f40","html_url":"https://github.com/QuincyGB/route-verdict/commit/15aec9f488494efeaa981fb80cc5800cd5dd7f40","comments_url":"https://api.github.com/repos/QuincyGB/route-verdict/commits/15aec9f488494efeaa981fb80cc5800cd5dd7f40/comments","author":null,"committer":null,"parents":[{"sha":"5a36f743d0b2b9b6dd42ee075f25d138e738e166","url":"https://api.github.com/repos/QuincyGB/route-verdict/commits/5a36f743d0b2b9b6dd42ee075f25d138e738e166","html_url":"https://github.com/QuincyGB/route-verdict/commit/5a36f743d0b2b9b6dd42ee075f25d138e738e166"}],"stats":{"total":116,"additions":114,"deletions":2},"files":[{"sha":"26288f0b9a96d194bf8c5333a871ea611f138246","filename":"app/config.py","status":"modified","additions":58,"deletions":1,"changes":59,"blob_url":"https://github.com/QuincyGB/route-verdict/blob/15aec9f488494efeaa981fb80cc5800cd5dd7f40/app%2Fconfig.py","raw_url":"https://github.com/QuincyGB/route-verdict/raw/15aec9f488494efeaa981fb80cc5800cd5dd7f40/app%2Fconfig.py","contents_url":"https://api.github.com/repos/QuincyGB/route-verdict/contents/app%2Fconfig.py?ref=15aec9f488494efeaa981fb80cc5800cd5dd7f40","patch":"@@ -25,6 +25,56 @@\n # catalog indexes only its own settlements.\n PAYAI_FACILITATOR_URL = \"https://facilitator.payai.network\"\n \n+# --- check store location ---------------------------------------------------\n+#\n+# Where the prior-check sqlite lives decides whether the diff memory\n+# survives a redeploy. Resolution order:\n+#   1. ROUTE_VERDICT_DB set -> that exact path wins.\n+#   2. A volume mounted at /data (Railway Volume) -> /data/route-verdict.db.\n+#   3. Plain \"route-verdict.db\" on the service's own (ephemeral) disk.\n+# Durability is measured, never assumed from the path string: a path is\n+# persistent only when its nearest existing ancestor directory is a\n+# mount point. The probes are bound at module level so tests can fake\n+# a volume mount without one.\n+\n+VOLUME_MOUNT_PATH = \"/data\"\n+STORE_DB_FILENAME = \"route-verdict.db\"\n+\n+_isdir = os.path.isdir\n+_ismount = os.path.ismount\n+_writable = os.access\n+\n+\n+def _nearest_existing_dir(path: str) -> str:\n+    d = os.path.dirname(os.path.abspath(path))\n+    while d != \"/\" and not os.path.exists(d):\n+        d = os.path.dirname(d)\n+    return d\n+\n+\n+def _path_is_persistent(path: str) -> bool:\n+    \"\"\"True when the directory that will hold `path` is a mount point\n+    (a volume). \"/\" itself is always a mount and proves nothing, so a\n+    path with no mounted ancestor above the root is ephemeral.\"\"\"\n+    d = _nearest_existing_dir(path)\n+    return d != \"/\" and _ismount(d)\n+\n+\n+def resolve_db_path() -> tuple[str, bool]:\n+    \"\"\"Resolve (db_path, persistent) for the check store.\"\"\"\n+    explicit = os.environ.get(\"ROUTE_VERDICT_DB\", \"\").strip()\n+    if explicit:\n+        return explicit, _path_is_persistent(explicit)\n+    if (\n+        _isdir(VOLUME_MOUNT_PATH)\n+        and _ismount(VOLUME_MOUNT_PATH)\n+        and _writable(VOLUME_MOUNT_PATH, os.W_OK)\n+    ):\n+        candidate = os.path.join(VOLUME_MOUNT_PATH, STORE_DB_FILENAME)\n+        return candidate, True\n+    default = STORE_DB_FILENAME\n+    return default, _path_is_persistent(default)\n+\n \n @dataclass(frozen=True)\n class Settings:\n@@ -36,6 +86,11 @@ class Settings:\n     fetch_timeout_s: float  # timeout for probing the target endpoint\n     port: int\n     db_path: str  # sqlite file holding prior checks (the diff memory)\n+    # Measured durability of db_path — see resolve_db_path(): a path\n+    # under a mounted volume (e.g. a Railway Volume at /data) survives\n+    # redeploys; the container's own disk is wiped by them. Reported\n+    # in /health so a silent reset is visible from outside.\n+    db_persistent: bool = False\n     # Coinbase CDP facilitator credentials (optional). Only used when\n     # X402_FACILITATOR_URL points at CDP — see use_cdp below.\n     # Fleet-internal shared secret (optional). Gates the unpaid\n@@ -80,6 +135,7 @@ def load_settings() -> Settings:\n         for k in (\"CDP_API_KEY_ID\", \"CDP_API_KEY_SECRET\")\n     }\n \n+    db_path, db_persistent = resolve_db_path()\n     return Settings(\n         pay_to=pay_to,\n         price_usdc=os.environ.get(\"X402_PRICE_USDC\", \"$0.05\").strip(),\n@@ -88,7 +144,8 @@ def load_settings() -> Settings:\n         service_name=os.environ.get(\"X402_SERVICE_NAME\", \"route-verdict\").strip(),\n         fetch_timeout_s=float(os.environ.get(\"ROUTE_VERDICT_FETCH_TIMEOUT_S\", \"10\")),\n         port=int(os.environ.get(\"PORT\", \"3000\")),\n-        db_path=os.environ.get(\"ROUTE_VERDICT_DB\", \"route-verdict.db\").strip(),\n+        db_path=db_path,\n+        db_persistent=db_persistent,\n         fleet_internal_secret=os.environ.get(\"FLEET_INTERNAL_SECRET\", \"\").strip() or None,\n         **{k.lower(): v for k, v in cdp_keys.items() if v is not None},\n     )"},{"sha":"48f68e9b9f67967840c85302ac143124f5e1f8c3","filename":"app/main.py","status":"modified","additions":15,"deletions":1,"changes":16,"blob_url":"https://github.com/QuincyGB/route-verdict/blob/15aec9f488494efeaa981fb80cc5800cd5dd7f40/app%2Fmain.py","raw_url":"https://github.com/QuincyGB/route-verdict/raw/15aec9f488494efeaa981fb80cc5800cd5dd7f40/app%2Fmain.py","contents_url":"https://api.github.com/repos/QuincyGB/route-verdict/contents/app%2Fmain.py?ref=15aec9f488494efeaa981fb80cc5800cd5dd7f40","patch":"@@ -307,7 +307,21 @@ async def landing():\n \n @app.get(\"/health\")\n async def health():\n-    return {\"ok\": True, \"service\": settings.service_name}\n+    return {\n+        \"ok\": True,\n+        \"service\": settings.service_name,\n+        # Durability of the prior-check store (the diff memory),\n+        # measured at startup (config.resolve_db_path) — \"persistent\"\n+        # only when the store file lives on a mounted volume. A reset\n+        # like the 2026-10-29 one becomes visible here instead of in\n+        # a buyer's empty diff.\n+        \"storage\": {\n+            \"check_store\": (\n+                \"persistent\" if settings.db_persistent else \"ephemeral\"\n+            ),\n+            \"check_db_path\": settings.db_path,\n+        },\n+    }\n \n \n @app.get(\"/quote\")"},{"sha":"3dd6269cc7415af3250216acb92087a6b2e298ca","filename":"tests/test_config.py","status":"added","additions":33,"deletions":0,"changes":33,"blob_url":"https://github.com/QuincyGB/route-verdict/blob/15aec9f488494efeaa981fb80cc5800cd5dd7f40/tests%2Ftest_config.py","raw_url":"https://github.com/QuincyGB/route-verdict/raw/15aec9f488494efeaa981fb80cc5800cd5dd7f40/tests%2Ftest_config.py","contents_url":"https://api.github.com/repos/QuincyGB/route-verdict/contents/tests%2Ftest_config.py?ref=15aec9f488494efeaa981fb80cc5800cd5dd7f40","patch":"@@ -0,0 +1,33 @@\n+\"\"\"Check-store path resolution: where the diff memory lives decides\n+whether it survives a redeploy. Durability is measured (nearest\n+existing ancestor is a mount point), never assumed from the path\n+string — the probes are module-level so tests can fake a volume.\n+\"\"\"\n+\n+import app.config as config\n+\n+\n+def test_resolve_db_path_explicit_env_wins(monkeypatch, tmp_path):\n+    target = str(tmp_path / \"checks.db\")\n+    monkeypatch.setenv(\"ROUTE_VERDICT_DB\", target)\n+    path, persistent = config.resolve_db_path()\n+    assert path == target\n+    assert persistent is False  # tmp_path is not a mount\n+\n+\n+def test_resolve_db_path_default_is_ephemeral(monkeypatch):\n+    monkeypatch.delenv(\"ROUTE_VERDICT_DB\", raising=False)\n+    monkeypatch.setattr(config, \"_isdir\", lambda p: False)\n+    path, persistent = config.resolve_db_path()\n+    assert path == \"route-verdict.db\"\n+    assert persistent is False\n+\n+\n+def test_resolve_db_path_uses_mounted_volume(monkeypatch):\n+    monkeypatch.delenv(\"ROUTE_VERDICT_DB\", raising=False)\n+    monkeypatch.setattr(config, \"_isdir\", lambda p: True)\n+    monkeypatch.setattr(config, \"_ismount\", lambda p: True)\n+    monkeypatch.setattr(config, \"_writable\", lambda p, mode: True)\n+    path, persistent = config.resolve_db_path()\n+    assert path == \"/data/route-verdict.db\"\n+    assert persistent is True"},{"sha":"ec311e5758117690529f98b9b4cb9357c5c059be","filename":"tests/test_paywall.py","status":"modified","additions":8,"deletions":0,"changes":8,"blob_url":"https://github.com/QuincyGB/route-verdict/blob/15aec9f488494efeaa981fb80cc5800cd5dd7f40/tests%2Ftest_paywall.py","raw_url":"https://github.com/QuincyGB/route-verdict/raw/15aec9f488494efeaa981fb80cc5800cd5dd7f40/tests%2Ftest_paywall.py","contents_url":"https://api.github.com/repos/QuincyGB/route-verdict/contents/tests%2Ftest_paywall.py?ref=15aec9f488494efeaa981fb80cc5800cd5dd7f40","patch":"@@ -56,6 +56,14 @@ def test_402_carries_full_bazaar_extension(client):\n     assert \"verdict\" in output[\"schema\"][\"properties\"]\n \n \n+def test_health_reports_check_store_storage(client):\n+    body = client.get(\"/health\").json()\n+    storage = body[\"storage\"]\n+    assert storage[\"check_db_path\"] == main.settings.db_path\n+    expected = \"persistent\" if main.settings.db_persistent else \"ephemeral\"\n+    assert storage[\"check_store\"] == expected\n+\n+\n def test_free_routes_stay_open(client):\n     assert client.get(\"/health\").status_code == 200\n     quote = client.get(\"/quote\")"}]}
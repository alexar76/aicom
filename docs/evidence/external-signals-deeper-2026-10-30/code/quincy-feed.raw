{"sha":"9303c9d6e9862c599711e979a8acba342dc634d7","node_id":"C_kwDOVSxolNoAKDkzMDNjOWQ2ZTk4NjJjNTk5NzExZTk3OWE4YWNiYTM0MmRjNjM0ZDc","commit":{"author":{"name":"Ren","email":"ren@agentworld.me","date":"2026-10-30T01:42:39Z"},"committer":{"name":"Ren","email":"ren@agentworld.me","date":"2026-10-30T01:42:39Z"},"message":"Recheck feed: free public JSONL of recent check responses at GET /v1/recheck/feed\n\nEvery completed check now appends its exact response object to a\nrecheck_history table in the watch store (recorded inside recheck()\nitself, so per-call, pack-spent, and scheduled checks are all\nrecorded once). The feed serves the last 100, newest first, as\napplication/x-ndjson — the observatory surface promised to the\naicom survey (alexar76/aicom#13).\n\nWatches that pre-date the history are seeded with one record built\nonly from the stored watch state (watch id, URL, kind, fingerprint\nas current, checked_at); their per-check status/changes/summary\nwere never stored and are omitted, never reconstructed.","tree":{"sha":"f35cbd34e9638ba3d7acd87fbc3032ac2bd1caef","url":"https://api.github.com/repos/QuincyGB/stall-row/git/trees/f35cbd34e9638ba3d7acd87fbc3032ac2bd1caef"},"url":"https://api.github.com/repos/QuincyGB/stall-row/git/commits/9303c9d6e9862c599711e979a8acba342dc634d7","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/QuincyGB/stall-row/commits/9303c9d6e9862c599711e979a8acba342dc634d7","html_url":"https://github.com/QuincyGB/stall-row/commit/9303c9d6e9862c599711e979a8acba342dc634d7","comments_url":"https://api.github.com/repos/QuincyGB/stall-row/commits/9303c9d6e9862c599711e979a8acba342dc634d7/comments","author":null,"committer":null,"parents":[{"sha":"850dda8a5230dee80b5af69b87a3086a21173d17","url":"https://api.github.com/repos/QuincyGB/stall-row/commits/850dda8a5230dee80b5af69b87a3086a21173d17","html_url":"https://github.com/QuincyGB/stall-row/commit/850dda8a5230dee80b5af69b87a3086a21173d17"}],"stats":{"total":378,"additions":364,"deletions":14},"files":[{"sha":"b1160117ad411aef23bbf1da16ab37097e2a5863","filename":"README.md","status":"modified","additions":7,"deletions":2,"changes":9,"blob_url":"https://github.com/QuincyGB/stall-row/blob/9303c9d6e9862c599711e979a8acba342dc634d7/README.md","raw_url":"https://github.com/QuincyGB/stall-row/raw/9303c9d6e9862c599711e979a8acba342dc634d7/README.md","contents_url":"https://api.github.com/repos/QuincyGB/stall-row/contents/README.md?ref=9303c9d6e9862c599711e979a8acba342dc634d7","patch":"@@ -49,8 +49,13 @@ credit buys a whole sweep, never one route. Every probe is unpaid:\n the checker never pays, signs, or settles any route it checks.\n \n Free: `GET /`, `/health`, `/quote`, `/.well-known/x402`, `/skill.md`,\n-`/llms.txt`, and `POST /v1/recheck/pack-balance` (credits + expiry for\n-a pack id; spends nothing). Pack semantics: minting is idempotent on\n+`/llms.txt`, `POST /v1/recheck/pack-balance` (credits + expiry for\n+a pack id; spends nothing), and `GET /v1/recheck/feed` — the recent\n+Recheck responses as JSONL (one object per line, newest first, last\n+100), a public observatory feed: every completed check's exact\n+response object, recorded in the store at check time. Checks from\n+before the history existed are seeded from the stored watch state\n+and carry only the fields that state persisted. Pack semantics: minting is idempotent on\n the payment's EIP-3009 authorization nonce, so a re-presented payment\n returns the pack it already bought; a credit is reserved atomically\n before each check and refunded when the check itself fails (our"},{"sha":"4ff49f2374ec32f268080050c0cdb5b5f20b3ce4","filename":"app/discovery.py","status":"modified","additions":2,"deletions":0,"changes":2,"blob_url":"https://github.com/QuincyGB/stall-row/blob/9303c9d6e9862c599711e979a8acba342dc634d7/app%2Fdiscovery.py","raw_url":"https://github.com/QuincyGB/stall-row/raw/9303c9d6e9862c599711e979a8acba342dc634d7/app%2Fdiscovery.py","contents_url":"https://api.github.com/repos/QuincyGB/stall-row/contents/app%2Fdiscovery.py?ref=9303c9d6e9862c599711e979a8acba342dc634d7","patch":"@@ -1706,6 +1706,7 @@ def skill_md(settings: Settings, base_url: str) -> str:\n         f\"- `GET {base_url}/health` — liveness\",\n         f\"- `GET {base_url}/.well-known/x402` — machine-readable manifest\",\n         f\"- `POST {base_url}/v1/recheck/pack-balance` — a pack's credits + expiry (pack id required)\",\n+        f\"- `GET {base_url}/v1/recheck/feed` — recent Recheck results as JSONL, newest first (public observatory feed)\",\n     ]\n     return \"\\n\".join(lines) + \"\\n\"\n \n@@ -1734,5 +1735,6 @@ def llms_txt(settings: Settings, base_url: str) -> str:\n         f\"- GET {base_url}/health — free liveness check\",\n         f\"- GET {base_url}/.well-known/x402 — manifest\",\n         f\"- POST {base_url}/v1/recheck/pack-balance — free pack balance (pack id required)\",\n+        f\"- GET {base_url}/v1/recheck/feed — free Recheck results feed (JSONL, newest first)\",\n     ]\n     return \"\\n\".join(lines) + \"\\n\""},{"sha":"f4de3584363e93c6889bf54a0146fe7a00dce399","filename":"app/main.py","status":"modified","additions":20,"deletions":0,"changes":20,"blob_url":"https://github.com/QuincyGB/stall-row/blob/9303c9d6e9862c599711e979a8acba342dc634d7/app%2Fmain.py","raw_url":"https://github.com/QuincyGB/stall-row/raw/9303c9d6e9862c599711e979a8acba342dc634d7/app%2Fmain.py","contents_url":"https://api.github.com/repos/QuincyGB/stall-row/contents/app%2Fmain.py?ref=9303c9d6e9862c599711e979a8acba342dc634d7","patch":"@@ -7,6 +7,8 @@\n Paid:   POST /v1/* routes (see app/discovery.py ROUTES)\n Free:   GET  /, /health, /quote, /.well-known/x402, /skill.md, /llms.txt\n         POST /v1/recheck/pack-balance (pack id is the credential)\n+        GET  /v1/recheck/feed (public JSONL feed of recent recheck\n+             responses — see services/recheck.py)\n         POST /v1/nudge (signed fleet-health mail — see services/nudge.py)\n         POST /v1/probe (one-link checker — see services/probe.py)\n         POST /v1/claim/start, POST /v1/claim/verify (stall claim\n@@ -1117,6 +1119,24 @@ async def recheck_pack_balance(req: RecheckPackBalanceRequest):\n     return pack\n \n \n+@app.get(\"/v1/recheck/feed\")\n+async def recheck_feed():\n+    \"\"\"Free public feed of recent Recheck results: one JSON object\n+    per line (JSONL), newest first, bounded to the last\n+    recheck_svc.FEED_LIMIT recorded checks. This is the observatory\n+    surface promised to the aicom survey (alexar76/aicom#13): other\n+    graders read our own check responses next to their results.\n+    Records are the exact response objects POST /v1/recheck\n+    returned, recorded by the store at check time; checks from\n+    before the history existed are seeded from the stored watch\n+    state and carry only the fields that state persisted (no\n+    status/changes/summary — see services/recheck.py). Empty\n+    history returns an empty body with 200.\"\"\"\n+    records = _recheck_store.recent_checks()\n+    body = \"\".join(json.dumps(r, sort_keys=True) + \"\\n\" for r in records)\n+    return PlainTextResponse(body, media_type=\"application/x-ndjson\")\n+\n+\n # --- Fleet Pass ---------------------------------------------------------------\n # The pass ledger lives in the recheck store. Buy is a paid route\n # (minting idempotent on the payment identity, like packs); balance,"},{"sha":"cc8c97d995c8d93ff5a8036fc99dc7659d2e03a9","filename":"app/services/recheck.py","status":"modified","additions":133,"deletions":12,"changes":145,"blob_url":"https://github.com/QuincyGB/stall-row/blob/9303c9d6e9862c599711e979a8acba342dc634d7/app%2Fservices%2Frecheck.py","raw_url":"https://github.com/QuincyGB/stall-row/raw/9303c9d6e9862c599711e979a8acba342dc634d7/app%2Fservices%2Frecheck.py","contents_url":"https://api.github.com/repos/QuincyGB/stall-row/contents/app%2Fservices%2Frecheck.py?ref=9303c9d6e9862c599711e979a8acba342dc634d7","patch":"@@ -28,6 +28,18 @@\n handler returns 502, no payment settles, and the stored fingerprint\n is NOT overwritten — the next good probe still diffs against the\n last good state.\n+\n+Feed: every COMPLETED check's response is also appended to a\n+history table in the same store, and GET /v1/recheck/feed serves\n+the recent ones as JSONL, free — the observatory surface promised\n+to the aicom survey (alexar76/aicom#13), so other graders can read\n+our own check responses next to their results. History begins when\n+the table does: watches that already existed are seeded with ONE\n+record built only from what the watches table persisted (watch id,\n+URL, kind, the stored fingerprint as `current`, checked_at). The\n+per-check status/changes/summary of those earlier checks were\n+never stored, so seeded records omit them — the feed serves what\n+the store holds, never a reconstruction.\n \"\"\"\n \n from __future__ import annotations\n@@ -89,6 +101,10 @@ def _iso_of(epoch_seconds: float) -> str:\n PACK_TTL_DAYS = 90\n _PACK_ID_PREFIX = \"pack_\"\n \n+# The public feed's window: GET /v1/recheck/feed serves at most\n+# this many of the most recent recorded check responses.\n+FEED_LIMIT = 100\n+\n # --- fleet check packs -----------------------------------------------------------\n #\n # The standing form of Fleet Check (services/fleetcheck.py): one\n@@ -467,7 +483,18 @@ def __init__(self, path: str, persistent: bool | None = None):\n                 )\n                 \"\"\"\n             )\n+            self._conn.execute(\n+                \"\"\"\n+                CREATE TABLE IF NOT EXISTS recheck_history (\n+                    id INTEGER PRIMARY KEY AUTOINCREMENT,\n+                    watch_key TEXT NOT NULL,\n+                    checked_at TEXT NOT NULL,\n+                    response_json TEXT NOT NULL\n+                )\n+                \"\"\"\n+            )\n             self._conn.commit()\n+        self._seed_history_from_watches()\n \n     @property\n     def path(self) -> str:\n@@ -506,6 +533,95 @@ def count(self) -> int:\n             row = self._conn.execute(\"SELECT COUNT(*) FROM watches\").fetchone()\n         return int(row[0]) if row else 0\n \n+    # --- check history (the public JSONL feed) ------------------------\n+    # Every completed check appends its exact response object here;\n+    # GET /v1/recheck/feed serves the recent window as JSONL. The\n+    # watches table above keeps only the LAST fingerprint per watch,\n+    # so without this table the responses themselves were lost the\n+    # moment the next check overwrote the baseline.\n+\n+    def _seed_history_from_watches(self) -> None:\n+        \"\"\"One history record per pre-existing watch, built ONLY\n+        from what the watches table persisted — the per-check\n+        status/changes/summary of those earlier checks were never\n+        stored, so seeded records omit them rather than reconstruct\n+        them. Idempotent: a watch that already has history rows is\n+        never re-seeded, so restarts add nothing.\"\"\"\n+        with self._lock:\n+            rows = self._conn.execute(\n+                \"SELECT watch_key, kind, fingerprint_json, checked_at \"\n+                \"FROM watches\"\n+            ).fetchall()\n+            for watch_key, kind, fingerprint_json, checked_at in rows:\n+                (existing,) = self._conn.execute(\n+                    \"SELECT COUNT(*) FROM recheck_history \"\n+                    \"WHERE watch_key = ?\",\n+                    (watch_key,),\n+                ).fetchone()\n+                if existing:\n+                    continue\n+                try:\n+                    fingerprint = json.loads(fingerprint_json)\n+                except ValueError:\n+                    continue\n+                watch_id, _, url = watch_key.partition(\"\\n\")\n+                record = {\n+                    \"watch_id\": watch_id,\n+                    \"url\": url,\n+                    \"kind\": kind,\n+                    \"current\": fingerprint,\n+                    \"checked_at\": checked_at,\n+                }\n+                self._conn.execute(\n+                    \"INSERT INTO recheck_history \"\n+                    \"(watch_key, checked_at, response_json) \"\n+                    \"VALUES (?, ?, ?)\",\n+                    (watch_key, checked_at, json.dumps(record, sort_keys=True)),\n+                )\n+            self._conn.commit()\n+\n+    def record_check(self, response: dict) -> None:\n+        \"\"\"Append one COMPLETED check's response to the history.\n+        Called by recheck() itself, so per-call, pack-spent, and\n+        scheduled-watch checks are all recorded exactly once, with\n+        the exact object the caller was answered with.\"\"\"\n+        key = f\"{response['watch_id']}\\n{response['url']}\"\n+        with self._lock:\n+            self._conn.execute(\n+                \"INSERT INTO recheck_history \"\n+                \"(watch_key, checked_at, response_json) VALUES (?, ?, ?)\",\n+                (\n+                    key,\n+                    response[\"checked_at\"],\n+                    json.dumps(response, sort_keys=True),\n+                ),\n+            )\n+            self._conn.commit()\n+\n+    def recent_checks(self, limit: int = FEED_LIMIT) -> list[dict]:\n+        \"\"\"The feed window: the most recent recorded check\n+        responses, newest first.\"\"\"\n+        with self._lock:\n+            rows = self._conn.execute(\n+                \"SELECT response_json FROM recheck_history \"\n+                \"ORDER BY id DESC LIMIT ?\",\n+                (max(1, min(int(limit), 500)),),\n+            ).fetchall()\n+        out = []\n+        for (raw,) in rows:\n+            try:\n+                out.append(json.loads(raw))\n+            except ValueError:\n+                continue\n+        return out\n+\n+    def check_history_count(self) -> int:\n+        with self._lock:\n+            row = self._conn.execute(\n+                \"SELECT COUNT(*) FROM recheck_history\"\n+            ).fetchone()\n+        return int(row[0]) if row else 0\n+\n     # --- watch packs ---------------------------------------------------\n     # Every pack mutation runs under the same lock as the watch state\n     # and commits before returning, so a spend is atomic in-process:\n@@ -2323,7 +2439,7 @@ async def recheck(\n     prior = store.get(key)\n     if prior is None:\n         store.save(key, kind, fingerprint, checked_at)\n-        return {\n+        result = {\n             \"watch_id\": wid,\n             \"url\": url,\n             \"kind\": kind,\n@@ -2336,6 +2452,8 @@ async def recheck(\n                 \"for this watch reports what changed against it.\"\n             ),\n         }\n+        store.record_check(result)\n+        return result\n     changes = _diff(prior[\"fingerprint\"], fingerprint)\n     if prior[\"kind\"] != kind:\n         changes.insert(\n@@ -2344,7 +2462,7 @@ async def recheck(\n     store.save(key, kind, fingerprint, checked_at)\n     if changes:\n         fields = \", \".join(c[\"field\"] for c in changes)\n-        return {\n+        result = {\n             \"watch_id\": wid,\n             \"url\": url,\n             \"kind\": kind,\n@@ -2354,16 +2472,19 @@ async def recheck(\n             \"checked_at\": checked_at,\n             \"summary\": f\"Changed since the previous check: {fields}.\",\n         }\n-    return {\n-        \"watch_id\": wid,\n-        \"url\": url,\n-        \"kind\": kind,\n-        \"status\": \"UNCHANGED\",\n-        \"changes\": [],\n-        \"current\": fingerprint,\n-        \"checked_at\": checked_at,\n-        \"summary\": \"No material change since the previous check.\",\n-    }\n+    else:\n+        result = {\n+            \"watch_id\": wid,\n+            \"url\": url,\n+            \"kind\": kind,\n+            \"status\": \"UNCHANGED\",\n+            \"changes\": [],\n+            \"current\": fingerprint,\n+            \"checked_at\": checked_at,\n+            \"summary\": \"No material change since the previous check.\",\n+        }\n+    store.record_check(result)\n+    return result\n \n \n async def recheck_with_pack("},{"sha":"cb1583941b7cf09f4aefcf73202ad173eb857265","filename":"tests/test_recheck_feed.py","status":"added","additions":202,"deletions":0,"changes":202,"blob_url":"https://github.com/QuincyGB/stall-row/blob/9303c9d6e9862c599711e979a8acba342dc634d7/tests%2Ftest_recheck_feed.py","raw_url":"https://github.com/QuincyGB/stall-row/raw/9303c9d6e9862c599711e979a8acba342dc634d7/tests%2Ftest_recheck_feed.py","contents_url":"https://api.github.com/repos/QuincyGB/stall-row/contents/tests%2Ftest_recheck_feed.py?ref=9303c9d6e9862c599711e979a8acba342dc634d7","patch":"@@ -0,0 +1,202 @@\n+\"\"\"The Recheck JSONL feed: GET /v1/recheck/feed serves the recent\n+recorded check responses — one JSON object per line, newest first,\n+bounded to recheck.FEED_LIMIT — free, no paywall. Recording happens\n+inside recheck() itself, so per-call, pack-spent, and scheduled\n+checks all land in the history exactly once with the exact object\n+the caller was answered with.\n+\n+The honesty edges pinned here: an empty store serves an empty body\n+with 200 (not an error, not a fabricated record); watches that\n+pre-date the history are seeded with only the fields the watches\n+table persisted (no invented status/changes/summary), exactly once.\n+Fully offline: MockTransport plays the target, IP-literal URLs keep\n+the SSRF guard's DNS lookup local.\"\"\"\n+\n+import json\n+\n+import httpx\n+import pytest\n+from fastapi.testclient import TestClient\n+\n+import app.main as main\n+from app.services import recheck\n+\n+WEB_URL = \"https://93.184.216.34/story\"\n+\n+\n+@pytest.fixture(autouse=True)\n+def _no_backoff(monkeypatch):\n+    monkeypatch.setattr(recheck, \"_BACKOFF_S\", (0, 0))\n+\n+\n+@pytest.fixture()\n+def store(tmp_path):\n+    return recheck.WatchStore(str(tmp_path / \"watches.db\"))\n+\n+\n+def _client(handler) -> httpx.AsyncClient:\n+    return httpx.AsyncClient(transport=httpx.MockTransport(handler))\n+\n+\n+def _page(body: str):\n+    def handler(request):\n+        return httpx.Response(\n+            200, text=body, headers={\"content-type\": \"text/html\"}\n+        )\n+\n+    return handler\n+\n+\n+# --- recording ------------------------------------------------------------------\n+\n+\n+@pytest.mark.asyncio\n+async def test_completed_checks_are_recorded_newest_first(store):\n+    state = {\"body\": \"<html><body>v1</body></html>\"}\n+\n+    def handler(request):\n+        return httpx.Response(\n+            200, text=state[\"body\"], headers={\"content-type\": \"text/html\"}\n+        )\n+\n+    async with _client(handler) as client:\n+        first = await recheck.recheck(client, store, WEB_URL)\n+        second = await recheck.recheck(client, store, WEB_URL)\n+        state[\"body\"] = \"<html><body>v2</body></html>\"\n+        third = await recheck.recheck(client, store, WEB_URL)\n+\n+    records = store.recent_checks()\n+    assert [r[\"status\"] for r in records] == [\"CHANGED\", \"UNCHANGED\", \"BASELINE\"]\n+    # The recorded objects are the exact responses the caller got.\n+    assert records[0] == third\n+    assert records[1] == second\n+    assert records[2] == first\n+    assert store.check_history_count() == 3\n+\n+\n+@pytest.mark.asyncio\n+async def test_failed_checks_are_not_recorded(store):\n+    def handler(request):\n+        return httpx.Response(500, text=\"boom\")\n+\n+    async with _client(handler) as client:\n+        with pytest.raises(Exception):\n+            await recheck.recheck(client, store, WEB_URL)\n+    assert store.recent_checks() == []\n+    assert store.check_history_count() == 0\n+\n+\n+def test_recorded_lines_are_one_parseable_object_each(store):\n+    for i in range(3):\n+        store.record_check(\n+            {\n+                \"watch_id\": \"w\",\n+                \"url\": WEB_URL,\n+                \"kind\": \"web\",\n+                \"status\": \"UNCHANGED\",\n+                \"changes\": [],\n+                \"current\": {\"status_code\": 200, \"body_sha256\": \"x\" * 64},\n+                \"checked_at\": f\"2026-10-29T00:00:0{i}Z\",\n+                \"summary\": \"No material change since the previous check.\",\n+            }\n+        )\n+    records = store.recent_checks()\n+    lines = [json.dumps(r, sort_keys=True) for r in records]\n+    assert [json.loads(line)[\"checked_at\"] for line in lines] == [\n+        \"2026-10-29T00:00:02Z\",\n+        \"2026-10-29T00:00:01Z\",\n+        \"2026-10-29T00:00:00Z\",\n+    ]\n+\n+\n+def test_feed_window_is_bounded(store):\n+    for i in range(recheck.FEED_LIMIT + 5):\n+        store.record_check(\n+            {\n+                \"watch_id\": \"w\",\n+                \"url\": WEB_URL,\n+                \"kind\": \"web\",\n+                \"status\": \"UNCHANGED\",\n+                \"changes\": [],\n+                \"current\": {\"status_code\": 200, \"body_sha256\": \"y\" * 64},\n+                \"checked_at\": f\"2026-10-29T00:{i // 60:02d}:{i % 60:02d}Z\",\n+                \"summary\": \"No material change since the previous check.\",\n+            }\n+        )\n+    records = store.recent_checks()\n+    assert len(records) == recheck.FEED_LIMIT\n+    assert store.check_history_count() == recheck.FEED_LIMIT + 5\n+\n+\n+# --- seeding from pre-existing watches --------------------------------------------\n+\n+\n+def test_existing_watch_is_seeded_from_stored_state_only(tmp_path):\n+    path = str(tmp_path / \"watches.db\")\n+    first = recheck.WatchStore(path)\n+    fingerprint = {\"status_code\": 200, \"body_sha256\": \"z\" * 64}\n+    first.save(\"wid\\n\" + WEB_URL, \"web\", fingerprint, \"2026-10-25T17:51:58Z\")\n+    # The save happened AFTER this store opened (its history seed ran\n+    # at open, over an empty watches table) — simulate the production\n+    # upgrade by reopening: the new code seeds from the stored state.\n+    assert first.check_history_count() == 0\n+    first.close()\n+\n+    reopened = recheck.WatchStore(path)\n+    records = reopened.recent_checks()\n+    assert len(records) == 1\n+    seed = records[0]\n+    assert seed[\"watch_id\"] == \"wid\"\n+    assert seed[\"url\"] == WEB_URL\n+    assert seed[\"kind\"] == \"web\"\n+    assert seed[\"current\"] == fingerprint\n+    assert seed[\"checked_at\"] == \"2026-10-25T17:51:58Z\"\n+    # The per-check fields were never stored — never reconstructed.\n+    assert \"status\" not in seed\n+    assert \"changes\" not in seed\n+    assert \"summary\" not in seed\n+    reopened.close()\n+\n+    # Idempotent: a second reopen seeds nothing new.\n+    again = recheck.WatchStore(path)\n+    assert again.check_history_count() == 1\n+    again.close()\n+\n+\n+# --- HTTP surface -------------------------------------------------------------------\n+\n+\n+@pytest.fixture()\n+def http(store, monkeypatch):\n+    monkeypatch.setattr(main, \"_recheck_store\", store)\n+    return TestClient(main.app, raise_server_exceptions=False)\n+\n+\n+def test_feed_empty_store_is_empty_body_200(http):\n+    r = http.get(\"/v1/recheck/feed\")\n+    assert r.status_code == 200\n+    assert r.text == \"\"\n+\n+\n+def test_feed_serves_jsonl_newest_first(http, store):\n+    for i, status in enumerate([\"BASELINE\", \"UNCHANGED\"]):\n+        store.record_check(\n+            {\n+                \"watch_id\": \"modelmarket-survey\",\n+                \"url\": \"https://93.184.216.34/x402/histor-check\",\n+                \"kind\": \"x402\",\n+                \"status\": status,\n+                \"changes\": [],\n+                \"current\": {\"status_code\": 402, \"amount\": \"1000\"},\n+                \"checked_at\": f\"2026-10-29T19:04:4{i}Z\",\n+                \"summary\": \"recorded\",\n+            }\n+        )\n+    r = http.get(\"/v1/recheck/feed\")\n+    assert r.status_code == 200\n+    assert \"application/x-ndjson\" in r.headers[\"content-type\"]\n+    lines = r.text.splitlines()\n+    assert len(lines) == 2\n+    parsed = [json.loads(line) for line in lines]\n+    assert [p[\"status\"] for p in parsed] == [\"UNCHANGED\", \"BASELINE\"]\n+    assert all(p[\"watch_id\"] == \"modelmarket-survey\" for p in parsed)"}]}
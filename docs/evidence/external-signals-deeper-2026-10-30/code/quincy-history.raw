{"sha":"8750385243aa1aa89e71dbf5fff72f041e7b8286","node_id":"C_kwDOVStujNoAKDg3NTAzODUyNDNhYTFhYTg5ZTcxZGJmNWZmZjcyZjA0MWU3YjgyODY","commit":{"author":{"name":"Ren","email":"ren@agentworld.me","date":"2026-10-30T02:17:20Z"},"committer":{"name":"Ren","email":"ren@agentworld.me","date":"2026-10-30T02:17:20Z"},"message":"Per-resource check history read + structured field_changes in diffs\n\n- GET /v1/history?resource_url= (free): every stored check for one\n  resource, oldest first — the read StallRow's unified timeline\n  aggregates. Pure read over the existing checks table.\n- compute_diff gains an additive field_changes array\n  ({path, op, before, after, severity, category}) derived from the\n  comparables and the stored field->type contract maps: a field\n  flipping string -> number at an unchanged score now yields a named\n  type_changed entry (alexar76/aicom#13). Legacy changes[],\n  schema_score_stability and contract_stability keep their meanings.\n- Docs: README, skill.md, llms.txt describe the new read.\nTests: 85 -> 93 passed.","tree":{"sha":"18b1ef04d7f7bc5cce4a1914538e551d79c897fc","url":"https://api.github.com/repos/QuincyGB/route-verdict/git/trees/18b1ef04d7f7bc5cce4a1914538e551d79c897fc"},"url":"https://api.github.com/repos/QuincyGB/route-verdict/git/commits/8750385243aa1aa89e71dbf5fff72f041e7b8286","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/QuincyGB/route-verdict/commits/8750385243aa1aa89e71dbf5fff72f041e7b8286","html_url":"https://github.com/QuincyGB/route-verdict/commit/8750385243aa1aa89e71dbf5fff72f041e7b8286","comments_url":"https://api.github.com/repos/QuincyGB/route-verdict/commits/8750385243aa1aa89e71dbf5fff72f041e7b8286/comments","author":null,"committer":null,"parents":[{"sha":"15aec9f488494efeaa981fb80cc5800cd5dd7f40","url":"https://api.github.com/repos/QuincyGB/route-verdict/commits/15aec9f488494efeaa981fb80cc5800cd5dd7f40","html_url":"https://github.com/QuincyGB/route-verdict/commit/15aec9f488494efeaa981fb80cc5800cd5dd7f40"}],"stats":{"total":340,"additions":339,"deletions":1},"files":[{"sha":"df4cfa262966f17b1283bb22c02ebee1d922c111","filename":"README.md","status":"modified","additions":1,"deletions":0,"changes":1,"blob_url":"https://github.com/QuincyGB/route-verdict/blob/8750385243aa1aa89e71dbf5fff72f041e7b8286/README.md","raw_url":"https://github.com/QuincyGB/route-verdict/raw/8750385243aa1aa89e71dbf5fff72f041e7b8286/README.md","contents_url":"https://api.github.com/repos/QuincyGB/route-verdict/contents/README.md?ref=8750385243aa1aa89e71dbf5fff72f041e7b8286","patch":"@@ -48,6 +48,7 @@ payout wallet.\n | `GET /skill.md` | free | Documentation written for agents |\n | `GET /llms.txt` | free | Compact agent index |\n | `GET /health` | free | Liveness |\n+| `GET /v1/history?resource_url=…` | free | Every stored check for one resource, oldest first (the read StallRow's unified timeline aggregates) |\n \n Request body: `{\"resource_url\": \"https://service.example.com/v1/endpoint\"}`\n "},{"sha":"dda6571ff83aaaaf60d2308d30ab496561c1ca12","filename":"app/checker.py","status":"modified","additions":134,"deletions":0,"changes":134,"blob_url":"https://github.com/QuincyGB/route-verdict/blob/8750385243aa1aa89e71dbf5fff72f041e7b8286/app%2Fchecker.py","raw_url":"https://github.com/QuincyGB/route-verdict/raw/8750385243aa1aa89e71dbf5fff72f041e7b8286/app%2Fchecker.py","contents_url":"https://api.github.com/repos/QuincyGB/route-verdict/contents/app%2Fchecker.py?ref=8750385243aa1aa89e71dbf5fff72f041e7b8286","patch":"@@ -236,6 +236,120 @@ def _contract_change_entries(\n     return entries, overflow\n \n \n+# --- structured field-level changes -------------------------------------\n+# Alongside the legacy prose `changes[]`, every diff carries a\n+# machine-readable `field_changes` array:\n+#   {path, op, before, after, severity, category}\n+# op ∈ added | removed | type_changed | value_changed |\n+#      required_changed | enum_changed\n+# category ∈ contract | schema | payment | listing\n+# Legacy fields keep their exact meanings; this array is additive.\n+\n+_COMPARABLE_FIELD_CHANGES = {\n+    # field -> (category, severity)\n+    \"liveness\": (\"listing\", \"high\"),\n+    \"price\": (\"payment\", \"medium\"),\n+    \"asset\": (\"payment\", \"medium\"),\n+    \"pay_to\": (\"payment\", \"high\"),\n+    \"network\": (\"payment\", \"medium\"),\n+    \"schema_score\": (\"schema\", \"medium\"),\n+    \"cdp_listing\": (\"listing\", \"low\"),\n+    \"payai_listing\": (\"listing\", \"low\"),\n+}\n+\n+\n+def _base_type(signature: str) -> str:\n+    \"\"\"The type word of a contract signature ('string enum=[a,b]' ->\n+    'string'); signatures without qualifiers return themselves.\"\"\"\n+    return signature.split(\" \", 1)[0] if signature else signature\n+\n+\n+def _contract_field_changes(\n+    before_contract: dict, after_contract: dict\n+) -> list[dict]:\n+    \"\"\"Field-level entries from two stored field->type contract\n+    maps. A field flipping string -> number at an unchanged quality\n+    score produces a named type_changed entry here (Alex's case,\n+    alexar76/aicom#13) — the score never has to move for the change\n+    to be spelled out.\"\"\"\n+    out: list[dict] = []\n+    for section in sorted(set(before_contract) | set(after_contract)):\n+        before_fields = before_contract.get(section) or {}\n+        after_fields = after_contract.get(section) or {}\n+        for path in sorted(set(before_fields) | set(after_fields)):\n+            before_sig, after_sig = before_fields.get(path), after_fields.get(path)\n+            if before_sig == after_sig:\n+                continue\n+            full_path = f\"{section}.{path}\"\n+            if path.endswith(\" (required)\"):\n+                out.append(\n+                    {\n+                        \"path\": full_path[: -len(\" (required)\")],\n+                        \"op\": \"required_changed\",\n+                        \"before\": before_sig,\n+                        \"after\": after_sig,\n+                        \"severity\": \"medium\",\n+                        \"category\": \"contract\",\n+                    }\n+                )\n+            elif before_sig is None:\n+                out.append(\n+                    {\n+                        \"path\": full_path,\n+                        \"op\": \"added\",\n+                        \"before\": None,\n+                        \"after\": after_sig,\n+                        \"severity\": \"medium\",\n+                        \"category\": \"contract\",\n+                    }\n+                )\n+            elif after_sig is None:\n+                out.append(\n+                    {\n+                        \"path\": full_path,\n+                        \"op\": \"removed\",\n+                        \"before\": before_sig,\n+                        \"after\": None,\n+                        \"severity\": \"high\",\n+                        \"category\": \"contract\",\n+                    }\n+                )\n+            elif _base_type(before_sig) != _base_type(after_sig):\n+                out.append(\n+                    {\n+                        \"path\": full_path,\n+                        \"op\": \"type_changed\",\n+                        \"before\": before_sig,\n+                        \"after\": after_sig,\n+                        \"severity\": \"medium\",\n+                        \"category\": \"contract\",\n+                    }\n+                )\n+            elif \"enum\" in before_sig or \"enum\" in after_sig:\n+                out.append(\n+                    {\n+                        \"path\": full_path,\n+                        \"op\": \"enum_changed\",\n+                        \"before\": before_sig,\n+                        \"after\": after_sig,\n+                        \"severity\": \"medium\",\n+                        \"category\": \"contract\",\n+                    }\n+                )\n+            else:\n+                out.append(\n+                    {\n+                        \"path\": full_path,\n+                        \"op\": \"value_changed\",\n+                        \"before\": before_sig,\n+                        \"after\": after_sig,\n+                        \"severity\": \"low\",\n+                        \"category\": \"contract\",\n+                    }\n+                )\n+    return out\n+\n+\n def compute_diff(prior: dict | None, current: dict) -> dict:\n     \"\"\"What changed about this resource since its previous check.\n \n@@ -253,12 +367,14 @@ def compute_diff(prior: dict | None, current: dict) -> dict:\n             \"prior_check\": False,\n             \"prior_checked_at\": None,\n             \"changes\": [],\n+            \"field_changes\": [],\n             \"schema_score_stability\": \"unknown\",\n             \"contract_stability\": \"unknown\",\n             \"summary\": \"no prior check on record\",\n         }\n     before, after = _comparables(prior), _comparables(current)\n     changes = []\n+    field_changes: list[dict] = []\n     for field in before:\n         if before[field] != after[field]:\n             changes.append(\n@@ -269,6 +385,19 @@ def compute_diff(prior: dict | None, current: dict) -> dict:\n                     \"detail\": f\"{field} changed: {before[field]} -> {after[field]}.\",\n                 }\n             )\n+            category, severity = _COMPARABLE_FIELD_CHANGES.get(\n+                field, (\"schema\", \"low\")\n+            )\n+            field_changes.append(\n+                {\n+                    \"path\": field,\n+                    \"op\": \"value_changed\",\n+                    \"before\": before[field],\n+                    \"after\": after[field],\n+                    \"severity\": severity,\n+                    \"category\": category,\n+                }\n+            )\n     score_stability = (\n         \"unknown\"\n         if before[\"schema_score\"] == after[\"schema_score\"] == \"unknown\"\n@@ -280,6 +409,9 @@ def compute_diff(prior: dict | None, current: dict) -> dict:\n     elif before_contract == after_contract:\n         contract_stability = \"stable\"\n     else:\n+        field_changes.extend(\n+            _contract_field_changes(before_contract, after_contract)\n+        )\n         contract_stability = \"changed\"\n         entries, overflow = _contract_change_entries(\n             before_contract, after_contract, before[\"schema_score\"], after[\"schema_score\"]\n@@ -302,6 +434,7 @@ def compute_diff(prior: dict | None, current: dict) -> dict:\n             \"prior_check\": True,\n             \"prior_checked_at\": prior_at,\n             \"changes\": [],\n+            \"field_changes\": field_changes,\n             \"schema_score_stability\": score_stability,\n             \"contract_stability\": contract_stability,\n             \"summary\": f\"no changes since {prior_at}\",\n@@ -317,6 +450,7 @@ def _label(c: dict) -> str:\n         \"prior_check\": True,\n         \"prior_checked_at\": prior_at,\n         \"changes\": changes,\n+        \"field_changes\": field_changes,\n         \"schema_score_stability\": score_stability,\n         \"contract_stability\": contract_stability,\n         \"summary\": f\"{len(changes)} change(s) since {prior_at}: {summary}\","},{"sha":"812b8931a09f58614d58ce4f622c099431a3e8e9","filename":"app/discovery.py","status":"modified","additions":6,"deletions":1,"changes":7,"blob_url":"https://github.com/QuincyGB/route-verdict/blob/8750385243aa1aa89e71dbf5fff72f041e7b8286/app%2Fdiscovery.py","raw_url":"https://github.com/QuincyGB/route-verdict/raw/8750385243aa1aa89e71dbf5fff72f041e7b8286/app%2Fdiscovery.py","contents_url":"https://api.github.com/repos/QuincyGB/route-verdict/contents/app%2Fdiscovery.py?ref=8750385243aa1aa89e71dbf5fff72f041e7b8286","patch":"@@ -388,7 +388,11 @@ def skill_md(settings: Settings, base_url: str) -> str:\n ## Free endpoints\n \n - `GET {base_url}/quote` — price, network, payTo\n-- `GET {base_url}/health` — liveness\n+- `GET {base_url}/health` — liveness (includes check-store durability)\n+- `GET {base_url}/v1/history?resource_url=<url>` — every stored check\n+  for one resource, oldest first; each diff also carries a structured\n+  `field_changes` array (path, op, before, after, severity, category)\n+  beside the legacy prose `changes[]`\n - `GET {base_url}/.well-known/x402` — machine-readable manifest\n \n ## Honest limits\n@@ -410,5 +414,6 @@ def llms_txt(settings: Settings, base_url: str) -> str:\n - POST {base_url}/v1/check — paid. Body: {{\"resource_url\": str}}\n - GET {base_url}/quote — free price quote\n - GET {base_url}/health — free liveness check\n+- GET {base_url}/v1/history?resource_url=<url> — free; stored check history for one resource\n - GET {base_url}/.well-known/x402 — manifest\n \"\"\""},{"sha":"89db2b752e666416b6daa510421394a4d7dce8b7","filename":"app/main.py","status":"modified","additions":23,"deletions":0,"changes":23,"blob_url":"https://github.com/QuincyGB/route-verdict/blob/8750385243aa1aa89e71dbf5fff72f041e7b8286/app%2Fmain.py","raw_url":"https://github.com/QuincyGB/route-verdict/raw/8750385243aa1aa89e71dbf5fff72f041e7b8286/app%2Fmain.py","contents_url":"https://api.github.com/repos/QuincyGB/route-verdict/contents/app%2Fmain.py?ref=8750385243aa1aa89e71dbf5fff72f041e7b8286","patch":"@@ -489,6 +489,29 @@ async def nudge_inbox_read(\n     }\n \n \n+@app.get(\"/v1/history\")\n+async def history(resource_url: str):\n+    \"\"\"Free read: every stored check for one resource_url, oldest\n+    first — the per-resource history the fleet's unified timeline\n+    (StallRow GET /v1/resource/timeline) aggregates next to Recheck\n+    events and catalogue state. Pure read over the same store the\n+    paid check writes; absent from the x402 routes dict, so the\n+    priced route count does not move. Checks stored before diff\n+    field_changes shipped simply lack that key — history serves\n+    what the store holds, never a reconstruction.\"\"\"\n+    resource_url = resource_url.strip()\n+    if not resource_url:\n+        return JSONResponse(\n+            {\"error\": \"resource_url is required\"}, status_code=422\n+        )\n+    checks = get_store().history(resource_url)\n+    return {\n+        \"resource_url\": resource_url,\n+        \"count\": len(checks),\n+        \"checks\": checks,\n+    }\n+\n+\n @app.post(\"/v1/check\")\n async def check(req: CheckRequest):\n     \"\"\"Paid endpoint — unreachable until the x402 middleware verifies payment.\"\"\""},{"sha":"bab6d37f927e9be4e70c8c6057964add8731aa8f","filename":"app/store.py","status":"modified","additions":19,"deletions":0,"changes":19,"blob_url":"https://github.com/QuincyGB/route-verdict/blob/8750385243aa1aa89e71dbf5fff72f041e7b8286/app%2Fstore.py","raw_url":"https://github.com/QuincyGB/route-verdict/raw/8750385243aa1aa89e71dbf5fff72f041e7b8286/app%2Fstore.py","contents_url":"https://api.github.com/repos/QuincyGB/route-verdict/contents/app%2Fstore.py?ref=8750385243aa1aa89e71dbf5fff72f041e7b8286","patch":"@@ -90,6 +90,25 @@ def save(self, result: dict) -> None:\n             )\n             self._conn.commit()\n \n+    def history(self, resource_url: str, limit: int = 200) -> list[dict]:\n+        \"\"\"Every stored check for this URL, oldest first — the read\n+        the fleet timeline aggregates (GET /v1/history). The checks\n+        table already holds the full result JSON per check; this is\n+        a pure read, it changes nothing.\"\"\"\n+        with self._lock:\n+            rows = self._conn.execute(\n+                \"SELECT result_json FROM checks WHERE resource_url = ? \"\n+                \"ORDER BY id ASC LIMIT ?\",\n+                (resource_url, max(1, min(int(limit), 1000))),\n+            ).fetchall()\n+        out = []\n+        for (raw,) in rows:\n+            try:\n+                out.append(json.loads(raw))\n+            except ValueError:\n+                continue\n+        return out\n+\n     def count(self, resource_url: str) -> int:\n         with self._lock:\n             row = self._conn.execute("},{"sha":"4a7b266bc04ceb213177b1b6ff13224b680509f2","filename":"tests/test_diff.py","status":"modified","additions":91,"deletions":0,"changes":91,"blob_url":"https://github.com/QuincyGB/route-verdict/blob/8750385243aa1aa89e71dbf5fff72f041e7b8286/tests%2Ftest_diff.py","raw_url":"https://github.com/QuincyGB/route-verdict/raw/8750385243aa1aa89e71dbf5fff72f041e7b8286/tests%2Ftest_diff.py","contents_url":"https://api.github.com/repos/QuincyGB/route-verdict/contents/tests%2Ftest_diff.py?ref=8750385243aa1aa89e71dbf5fff72f041e7b8286","patch":"@@ -114,3 +114,94 @@ def test_score_change_without_contract_change():\n     assert d[\"schema_score_stability\"] == \"changed\"\n     assert d[\"contract_stability\"] == \"stable\"\n     assert [c[\"field\"] for c in d[\"changes\"]] == [\"schema_score\"]\n+\n+\n+# --- field_changes (structured, additive to legacy changes[]) -------------\n+\n+\n+def _with_contract_map(result, contract):\n+    result[\"schema_quality\"] = {\n+        **result[\"schema_quality\"],\n+        \"contract\": contract,\n+    }\n+    return result\n+\n+\n+def test_field_changes_empty_without_prior():\n+    d = compute_diff(None, _result())\n+    assert d[\"field_changes\"] == []\n+\n+\n+def test_field_changes_empty_when_identical():\n+    d = compute_diff(_result(), _result())\n+    assert d[\"field_changes\"] == []\n+\n+\n+def test_field_changes_name_payment_moves():\n+    prior = _result()\n+    current = _result(\n+        terms={\n+            \"amount_units\": \"99000\",\n+            \"pay_to\": \"0x2222222222222222222222222222222222222222\",\n+        }\n+    )\n+    d = compute_diff(prior, current)\n+    by_path = {fc[\"path\"]: fc for fc in d[\"field_changes\"]}\n+    assert by_path[\"price\"][\"op\"] == \"value_changed\"\n+    assert by_path[\"price\"][\"category\"] == \"payment\"\n+    assert by_path[\"price\"][\"before\"] == \"20000\"\n+    assert by_path[\"price\"][\"after\"] == \"99000\"\n+    assert by_path[\"pay_to\"][\"severity\"] == \"high\"\n+    # legacy shape untouched\n+    assert {c[\"field\"] for c in d[\"changes\"]} == {\"price\", \"pay_to\"}\n+\n+\n+def test_contract_type_flip_named_at_unchanged_score():\n+    \"\"\"Alex's case: an output field flips string -> number while the\n+    schema-quality score stays 100 — field_changes must name it.\"\"\"\n+    contract_a = {\"output\": {\"$\": \"object\", \"$.amount\": \"string\"}}\n+    contract_b = {\"output\": {\"$\": \"object\", \"$.amount\": \"number\"}}\n+    prior = _with_contract_map(_result(), contract_a)\n+    current = _with_contract_map(_result(), contract_b)\n+    d = compute_diff(prior, current)\n+    assert d[\"contract_stability\"] == \"changed\"\n+    assert d[\"schema_score_stability\"] == \"stable\"\n+    entries = [fc for fc in d[\"field_changes\"] if fc[\"category\"] == \"contract\"]\n+    assert entries == [\n+        {\n+            \"path\": \"output.$.amount\",\n+            \"op\": \"type_changed\",\n+            \"before\": \"string\",\n+            \"after\": \"number\",\n+            \"severity\": \"medium\",\n+            \"category\": \"contract\",\n+        }\n+    ]\n+\n+\n+def test_contract_added_removed_required_and_enum_ops():\n+    contract_a = {\n+        \"output\": {\n+            \"$\": \"object\",\n+            \"$ (required)\": \"amount\",\n+            \"$.gone\": \"string\",\n+            \"$.mode\": 'string enum=[\"a\"]',\n+        }\n+    }\n+    contract_b = {\n+        \"output\": {\n+            \"$\": \"object\",\n+            \"$ (required)\": \"amount,mode\",\n+            \"$.mode\": 'string enum=[\"a\",\"b\"]',\n+            \"$.new\": \"boolean\",\n+        }\n+    }\n+    d = compute_diff(\n+        _with_contract_map(_result(), contract_a),\n+        _with_contract_map(_result(), contract_b),\n+    )\n+    ops = {(fc[\"path\"], fc[\"op\"]) for fc in d[\"field_changes\"]}\n+    assert (\"output.$.new\", \"added\") in ops\n+    assert (\"output.$.gone\", \"removed\") in ops\n+    assert (\"output.$\", \"required_changed\") in ops\n+    assert (\"output.$.mode\", \"enum_changed\") in ops"},{"sha":"19a0d847431efbf45ef84d1540e36c876363496b","filename":"tests/test_history.py","status":"added","additions":65,"deletions":0,"changes":65,"blob_url":"https://github.com/QuincyGB/route-verdict/blob/8750385243aa1aa89e71dbf5fff72f041e7b8286/tests%2Ftest_history.py","raw_url":"https://github.com/QuincyGB/route-verdict/raw/8750385243aa1aa89e71dbf5fff72f041e7b8286/tests%2Ftest_history.py","contents_url":"https://api.github.com/repos/QuincyGB/route-verdict/contents/tests%2Ftest_history.py?ref=8750385243aa1aa89e71dbf5fff72f041e7b8286","patch":"@@ -0,0 +1,65 @@\n+\"\"\"GET /v1/history — the free per-resource check-history read the\n+fleet timeline aggregates. Offline: the store is seeded directly,\n+no probe ever runs.\"\"\"\n+\n+import pytest\n+from fastapi.testclient import TestClient\n+\n+from app import main\n+from app.store import CheckStore\n+\n+URL = \"https://seller.example.com/x402/thing\"\n+\n+\n+@pytest.fixture()\n+def client(tmp_path, monkeypatch):\n+    store = CheckStore(str(tmp_path / \"checks.db\"))\n+    monkeypatch.setattr(main, \"_store\", store)\n+    for i in range(3):\n+        store.save(\n+            {\n+                \"resource_url\": URL,\n+                \"checked_at\": f\"2026-10-2{i}T00:00:00Z\",\n+                \"verdict\": \"TRUSTED\",\n+                \"score\": 95.0,\n+            }\n+        )\n+    store.save(\n+        {\n+            \"resource_url\": \"https://other.example.com/x\",\n+            \"checked_at\": \"2026-10-20T00:00:00Z\",\n+            \"verdict\": \"CAUTION\",\n+            \"score\": 50.0,\n+        }\n+    )\n+    return TestClient(main.app, raise_server_exceptions=False)\n+\n+\n+def test_history_returns_only_that_url_oldest_first(client):\n+    resp = client.get(\"/v1/history\", params={\"resource_url\": URL})\n+    assert resp.status_code == 200\n+    body = resp.json()\n+    assert body[\"resource_url\"] == URL\n+    assert body[\"count\"] == 3\n+    assert [c[\"checked_at\"] for c in body[\"checks\"]] == [\n+        \"2026-10-20T00:00:00Z\",\n+        \"2026-10-21T00:00:00Z\",\n+        \"2026-10-22T00:00:00Z\",\n+    ]\n+\n+\n+def test_history_unknown_url_is_empty_not_an_error(client):\n+    resp = client.get(\n+        \"/v1/history\", params={\"resource_url\": \"https://nope.example.com/x\"}\n+    )\n+    assert resp.status_code == 200\n+    assert resp.json() == {\n+        \"resource_url\": \"https://nope.example.com/x\",\n+        \"count\": 0,\n+        \"checks\": [],\n+    }\n+\n+\n+def test_history_requires_a_url(client):\n+    resp = client.get(\"/v1/history\", params={\"resource_url\": \"  \"})\n+    assert resp.status_code == 422"}]}
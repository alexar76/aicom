github-actions%5Bbot%5D/received_events","type":"Bot","user_view_type":"public","site_admin":false},"labels":[{"id":10984408281,"node_id":"LA_kwDOQOlNmM8AAAACjrjE2Q","url":"https://api.github.com/repos/DanWahlin/github-azure-agentic-journeys/labels/agentic-workflows","name":"agentic-workflows","color":"ededed","default":false,"description":null,"archived_at":null,"archived_by":null}],"state":"closed","locked":false,"assignees":[],"milestone":null,"comments":1,"created_at":"2026-05-25T09:21:15Z","updated_at":"2026-07-20T20:50:25Z","closed_at":"2026-07-20T20:50:25Z","assignee":null,"author_association":"NONE","active_lock_reason":null,"sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"This issue tracks all no-op runs from agentic workflows in this repository. Each workflow run that completes with a no-op message (indicating no action was needed) posts a comment here.\n\n<details>\n<summary><b>What is a No-Op?</b></summary>\n\nA no-op (no operation) occurs when an agentic workflow runs successfully but determines that no action is required. For example:\n- A security scanner that finds no issues\n- An update checker that finds nothing to update\n- A monitoring workflow that finds everything is healthy\n\nThese are successful outcomes, not failures, and help provide transparency into workflow behavior.\n\n</details>\n\n<details>\n<summary><b>How This Helps</b></summary>\n\nThis issue helps you:\n- Track workflows that ran but determined no action was needed\n- Distinguish between failures and intentional no-ops\n- Monitor workflow health by seeing when workflows decide not to act\n\n</details>\n\n<details>\n<summary><b>Resources</b></summary>\n\n- [GitHub Agentic Workflows Documentation](https://github.com/github/gh-aw)\n\n</details>\n\n> [!TIP]\n> To stop a workflow from posting here, set `report-as-issue: false` in its frontmatter:\n> ```yaml\n> safe-outputs:\n>   noop:\n>     report-as-issue: false\n> ```\n\n---\n\n> This issue is automatically managed by GitHub Agentic Workflows. Do not close this issue manually.\n> \n> **No action to take** - Do not assign to an agent.\n\n<!-- gh-aw-noop-runs -->\n\n> - [x] expires <!-- gh-aw-expires: 2026-06-24T09:21:14.670Z --> on Jun 24, 2026, 9:21 AM UTC","reactions":{"url":"https://api.github.com/repos/DanWahlin/github-azure-agentic-journeys/issues/6/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/DanWahlin/github-azure-agentic-journeys/issues/6/timeline","performed_via_github_app":null,"state_reason":"not_planned","pinned_comment":null,"score":1.0},{"url":"https://api.github.com/repos/sev7n4/aimarket/issues/283","repository_url":"https://api.github.com/repos/sev7n4/aimarket","labels_url":"https://api.github.com/repos/sev7n4/aimarket/issues/283/labels{/name}","comments_url":"https://api.github.com/repos/sev7n4/aimarket/issues/283/comments","events_url":"https://api.github.com/repos/sev7n4/aimarket/issues/283/events","html_url":"https://github.com/sev7n4/aimarket/pull/283","id":4813219891,"node_id":"PR_kwDOSmkpxc7uDbqT","number":283,"title":"feat(web): agent 双栏下 Dock 对齐到左对话栏底部","user":{"login":"sev7n4","id":130808187,"node_id":"U_kgDOB8v5ew","avatar_url":"https://avatars.githubusercontent.com/u/130808187?v=4","gravatar_id":"","url":"https://api.github.com/users/sev7n4","html_url":"https://github.com/sev7n4","followers_url":"https://api.github.com/users/sev7n4/followers","following_url":"https://api.github.com/users/sev7n4/following{/other_user}","gists_url":"https://api.github.com/users/sev7n4/gists{/gist_id}","starred_url":"https://api.github.com/users/sev7n4/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/sev7n4/subscriptions","organizations_url":"https://api.github.com/users/sev7n4/orgs","repos_url":"https://api.github.com/users/sev7n4/repos","events_url":"https://api.github.com/users/sev7n4/events{/privacy}","received_events_url":"https://api.github.com/users/sev7n4/received_events","type":"User","user_view_type":"public","site_admin":false},"labels":[],"state":"closed","locked":false,"assignees":[],"milestone":null,"comments":0,"created_at":"2026-07-05T14:33:46Z","updated_at":"2026-07-05T14:57:55Z","closed_at":"2026-07-05T14:57:50Z","assignee":null,"author_association":"OWNER","active_lock_reason":null,"draft":false,"pull_request":{"url":"https://api.github.com/repos/sev7n4/aimarket/pulls/283","html_url":"https://github.com/sev7n4/aimarket/pull/283","diff_url":"https://github.com/sev7n4/aimarket/pull/283.diff","patch_url":"https://github.com/sev7n4/aimarket/pull/283.patch","merged_at":"2026-07-05T14:57:50Z"},"body":"## 背景\n承接 #282（agent 车道双栏外壳）。让底部创作 Dock 在 agent 双栏时对齐到左对话栏,形成\"左侧对话式输入 + 右侧纯产物\"的观感。\n\n## 实现（低风险,不重排布局归属）\n- `design-canvas.tsx`:新增 `onConversationPaneActiveChange`,在双栏实际渲染(agent+桌面+scroll)时上报激活状态;右产物栏底部内边距改为 `pb-6`,避免与浮动 Dock 无关的空白。\n- `studio-workspace.tsx`:接收该状态,给 `StudioDock` 传 `alignLeft`。\n- `studio-dock.tsx`:新增 `alignLeft` —— 浮动 Dock 由整宽居中改为对齐左栏宽度(`lg:w-[340px] xl:w-[380px]`,`justify-start`),focus 收起态同样左对齐。\n\n保持 Dock 由 studio-workspace 单一挂载(浮层),不重复渲染、无 lane 状态下沉;移动端 / 图片视频 / infinite 维持整宽居中,零回归。\n\n## 行为\n- agent 车道 + 桌面 + scroll -> Dock 浮于左对话栏底部,右产物栏满高滚动。\n- 其他场景 -> Dock 整宽居中(现状)。\n\n## 不在本 PR\n- 将 Dock 真正内嵌进左栏(非浮动、挤压内容)。\n- 图片/视频车道的对话式 agent。\n\n## 测试\n- `pnpm --filter @aimarket/web typecheck` 全绿;lint 无新增告警。\n- Dock 仍单一 `aria-label=创作 Dock`,E2E 选择器不受影响;CI 跑 Integration + E2E。\n\nMade with [Cursor](https://cursor.com)","reactions":{"url":"https://api.github.com/repos/sev7n4/aimarket/issues/283/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/sev7n4/aimarket/issues/283/timeline","performed_via_github_app":null,"state_reason":null,"score":1.0},{"url":"https://api.github.com/r
# WARDEN 0.22.3 for HISTOR: the running HISTOR image (wpp-20261101) with its vendored WARDEN replaced
# by the verified npm archive, and the WARDEN source of the same commit where the trusted recipe
# (warden/deploy/Dockerfile.histor) puts it. Nothing of HISTOR's own code changes. Modes are set in
# the staging tree (dirs 0755, files 0644), so COPY needs no --chmod. BuildKit resolves a bare
# image id as a Docker Hub name, so the base is named by its tag; stage-candidate.py checks that the
# tag is sha256:07b33b835aef… (the running HISTOR image) before building.
FROM aicom-security:histor-histor-1-wpp-20261101
USER 0:0
RUN rm -rf /app/scanner/node_modules/@aimarket/warden
COPY package/ /app/scanner/node_modules/@aimarket/warden/
COPY src/ /opt/warden-source/src/
LABEL skopos.source.commit="213d1f9426031afd62ed68ef579ddc770070c60b" \
      aicom.histor.overlay="warden-0223-20261101" \
      org.aimarket.release.candidate="warden-0.22.3" \
      org.aimarket.release.warden-build="d7cc677ef85fb4c274b5247779dfd0362509cfb00913f4c3a7e385af4a3c6f83"
USER 65532:65532
RUN node --input-type=module -e "import {readFileSync} from 'node:fs'; const p=JSON.parse(readFileSync('/app/scanner/node_modules/@aimarket/warden/package.json','utf8')); if(p.name!=='@aimarket/warden'||p.version!=='0.22.3') process.exit(1)"
